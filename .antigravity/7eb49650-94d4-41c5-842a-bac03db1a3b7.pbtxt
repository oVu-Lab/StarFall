nst frame1Rev = fc.yawVelocity;\n  fc.update(dt60, makeInput(-25, 0), settings, tel, 1280, 720);\n  const frame2Rev = fc.yawVelocity;\n  console.log({ beforeRev: +beforeRev.toFixed(4), frame1AfterReversal: +frame1Rev.toFixed(4), frame2AfterReversal: +frame2Rev.toFixed(4), reversedOnFrame1: frame1Rev > 0 });\n  if (!(beforeRev < 0 && frame1Rev > 0)) throw new Error(\'Failed immediate reversal!\');\n}\n\nconsole.log(\'\\n=== 5. IMMEDIATE STOP AFTER FULL TURN (ZERO DRIFT CHECK) ===\');\n{\n  const fc = new FlightController(ship);\n  const tel = createInitialTelemetry(ship);\n  for (let i = 0; i < 10; i++) fc.update(dt60, makeInput(35, 25), settings, tel, 1280, 720);\n  const turningYaw = fc.yawVelocity;\n  const turningPitch = fc.pitchVelocity;\n  // Stop mouse immediately\n  fc.update(dt60, makeInput(0, 0), settings, tel, 1280, 720);\n  const stopF1 = { yaw: +fc.yawVelocity.toFixed(6), pitch: +fc.pitchVelocity.toFixed(6) };\n  fc.update(dt60, makeInput(0, 0), settings, tel, 1280, 720);\n  const stopF2 = { yaw: +fc.yawVelocity.toFixed(6), pitch: +fc.pitchVelocity.toFixed(6) };\n  // Run 20 more zero-input frames and check total drift angle\n  const qAfterStop = fc.quaternion.clone();\n  for (let i = 0; i < 20; i++) fc.update(dt60, makeInput(0, 0), settings, tel, 1280, 720);\n  const driftDeg = THREE.MathUtils.radToDeg(qAfterStop.angleTo(fc.quaternion));\n  console.log({ turningYaw: +turningYaw.toFixed(3), turningPitch: +turningPitch.toFixed(3), stopF1, stopF2, driftOver20FramesDeg: +driftDeg.toFixed(6), reticleCentered: { x: +fc.aimCursorX.toFixed(4), y: +fc.aimCursorY.toFixed(4) } });\n  if (driftDeg > 0.001) throw new Error(\'Unwanted drift detected: \' + driftDeg);\n}\n\nconsole.log(\'\\n=== 6. PARAMETER INDEPENDENCE & AIM BOUNDARY DECOUPLING ===\');\n{\n  const runOnce = (patch: Partial<typeof settings>, dx: number, dy: number) => {\n    const fc = new FlightController(ship);\n    const tel = createInitialTelemetry(ship);\n    const s = { ...settings, inputSmoothing: 0, ...patch };\n    fc.update(dt60, makeInput(dx, dy), s, tel, 1280, 720);\n    return { yaw: fc.yawVelocity, pitch: fc.pitchVelocity, boundaryW: fc.aimBoundary.widthPx };\n  };\n  const base = runOnce({}, 15, 15);\n  const diffBoundary = runOnce({ joystickRadius: 1.45 }, 15, 15);\n  const diffMaxYaw = runOnce({ maxYawRate: 5.0 }, 15, 15);\n  const diffMaxPitch = runOnce({ maxPitchRate: 4.5 }, 15, 15);\n  const diffYawBal = runOnce({ yawSensitivity: 1.5 }, 15, 15);\n  const diffPitchBal = runOnce({ pitchSensitivity: 1.4 }, 15, 15);\n  console.log({\n    aimBoundaryChangedPx: diffBoundary.boundaryW !== base.boundaryW,\n    yawUnchangedByAimBoundary: Math.abs(diffBoundary.yaw - base.yaw) < 1e-12,\n    pitchUnchangedByAimBoundary: Math.abs(diffBoundary.pitch - base.pitch) < 1e-12,\n    pitchUnchangedByMaxYaw: Math.abs(diffMaxYaw.pitch - base.pitch) < 1e-12,\n    yawChangedByMaxYaw: Math.abs(diffMaxYaw.yaw) > Math.abs(base.yaw),\n    yawUnchangedByMaxPitch: Math.abs(diffMaxPitch.yaw - base.yaw) < 1e-12,\n    pitchChangedByMaxPitch: Math.abs(diffMaxPitch.pitch) > Math.abs(base.pitch),\n    pitchUnchangedByYawBalance: Math.abs(diffYawBal.pitch - base.pitch) < 1e-12,\n    yawUnchangedByPitchBalance: Math.abs(diffPitchBal.yaw - base.yaw) < 1e-12,\n  });\n  if (Math.abs(diffBoundary.yaw - base.yaw) > 1e-12 || Math.abs(diffBoundary.pitch - base.pitch) > 1e-12) {\n    throw new Error(\'Aim boundary leaked into steering response!\');\n  }\n}\n\nconsole.log(\'\\n=== 7. PRESERVED BASELINE ROLLBACK CHECK ===\');\n{\n  const fc = new FlightController(ship);\n  fc.steeringMode = \'virtual-joystick-baseline\';\n  const tel = createInitialTelemetry(ship);\n  fc.update(dt60, makeInput(40, 0), settings, tel, 1280, 720);\n  console.log({ baselineModeActive: fc.steeringMode, baselineSteerX: +fc.joystickEval.steerX.toFixed(4), baselineYawVel: +fc.yawVelocity.toFixed(4) });\n}\nconsole.log(\'\\nALL ENGINE VERIFICATION CHECKS PASSED!\');\n\""
