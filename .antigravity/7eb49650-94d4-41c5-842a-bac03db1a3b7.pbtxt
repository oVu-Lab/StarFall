              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      const lpy = padY + plotH - (linOut / maxY) * plotH;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      curvePts.push(`${i === 0 ? \'M\' : \'L\'}${px.toFixed(1)},${py.toFixed(1)}`);"
