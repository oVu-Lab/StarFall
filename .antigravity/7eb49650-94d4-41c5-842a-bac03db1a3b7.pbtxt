      thinking_signature: "\022\231\r\n\226\r\001i\024}\023\034@9\330\374$\000B\325\364\336\024\353\330\363\351\241\tv\274{\313@\343;\363\323\a\322Ka\037m\304\231\324\245\352&\210-\355~\201\342\363>\252\323n\r\262\336\304r\b\200\262\022X\237\331\376\344\312\301r\031\215\261Y\264\212]\035\033\270\322\231\244O \006\340\366\346\360|~\325\365\020\337\"\331\331\235\201A;\304\2748\027XD\242\303F\326Mo\300\231-\235\021\222\263bA\224\232j\033\357\2343\r4\275\350\216\326\356\017\315^\215\n\3170Z\334\207I6\221\301\324\307\223\017\262\366{Py\266\177\264\217\317\311\025)\307\351$\000\372\035N}\343\266\314mG@\322\340`7M,\3470:x\251\212\303\f\0252\006\223\3626\"\311o\001h\2427\214\243\362\210\004n\270NjL\266\200\311\316\344|\352\313\304\276\001\357\346\350&\211\326\334\215R$\334:`\312\024$\315\343\304\241\026.\332 \324\033x\234\264\037\271\316\216D\364\345\230\256\036\301[\0327r\346\254\247\271\345\006\357\364M\224\266\037\3023}b\261\263]\332\205\260\025e\367\274*|\326\373\r\024\232\225\344 ,\270G\027+\275%\340\313G\332\364\216\210 \250\231#d\371\221^:\271\315\001H\032Fx\313\2706\376\326\000\347d\002\346Q::\354\277\253\375\004\224\275\"\267q3ih\224S\037\226\274a\031\304\222\201KYeW\223\310\340\211\264\004Vo\342\366\005\216\251\337\003\023\231y\020\377X\300e\236\275\350\201@\252\2141@\233W\336]c\311\271!w \032\344\262\347#N~\b\242\342\026\317\306\rK%F5P\305XJS\026\312\030\023\275\2659\367\020\2410\274.~Y\236\257+\357\r\033\242\204\225\204\312\332\333\276jE\375g\203\342g\002;\377h@\314\221FS2\243\016\203f\215\303\315\005\323\004\342v:\305; }\311\020\035f%\237_]{\360t\337\227\223\374z;\315\021\2556oH\251X\307\256\326^U\354L\017\232\026\3521\224\377\3221\325\201\337\372\303FL\266\002\236(nd\256\244\330\307\310\355:\316@\356\262\244q\326\004,\224\035nr\317\3776\335\002\315\303\324*\003\365\327L\260\202{\302\t{\235,\034\225+G~\311\037)$\300\250\tq2\250\317\353\367\377\2414\226}\232s\352\316\017J\002\331\230X\370\021}\340\003)<5{\366*\350\373\370\021^\350n\3149>\274(\241\242W\210\322\304m\216I0\254\317\332X\263:Ke\223\360T\324\3529\326\030\330\354q#\367G\305\307\327k\261\025Y\v\361\245\bI\2057~8g\324\261|C\240\254\317\306\341Q*6\317\354\0030_\373\213(\224\214\305\315\250j\256\207\346Q\201\365\305\a\322\353\360\0367\2206\303\004\244\274\036\351\335Z\244\362\364\270\304W\254\276\370\265\226Z\265,tjZ\275\324\306\327~\f\326\251+\206K\0325\366\222\247\252\345<\225\340\033|\202{X\375\231\266*\347\\\200\371\232\037\333\207\310\313\220\330\334\231\212\366\367\032\307A\360\332\326\345f]\364\023o\355Yi`AT\333\227\354\016o\177\\M\3533h\325A\357\032\215z\341\343a\300v\302\212\275\366\3757)\244\243\222*\227Y\250\204\036\317\202\214\254\223\'\v\241\022\016\270{\025|\325 2\241/k2g~s\343\001%\034\251\372\272\021+\251\312\247\304\306\242{\036\354\'%\037\221*\241\331/\030\367^&\324\032\304\203(uE\257s\261\317\307\353\027\330T\320ba\215sP\"\215\377\037t\265\272\333z\234S\231?\034b\0341 \347a:\370\330\202\263\331h\365Lt\304j\2119\213|\003;\255\2276\210\200\224\263Z<\344\313\363{\230\221>\"0\254\251\227\023\220\270\217\306a\252Qw\344\005.\3411\311\352\210\033\203>\245koY\304 e\345\302g:\226_\225\v\016h\251\216-\363\373b\275\023\304\274!`\200\321\313\242\252\340e\270-\214\016\360\021J\320\025\340\312\375\336\215\310f8\243\340s5\346Y\316\226\337[2\232U\225\r\211G\016E\032\334Y\324+\276_j\023;\005\032\006\235\201`\321\223\313\335m\241\253\250\244\020R\255\225d\300U\303\276P\233a\370\327\210u \253\025\323\026\001DXf\031\240\v\"\241\334_\026\360H\b\204\310\3756=\032x\224\3225\373u\030\234m`W\016\030W\005\204DK\3518E\v\325U\376\333\335\353\261\030\251\373o}\351\r3S4\245\017\302\226\227\022\346\337A\3316R\031\331* \304\207\342dJ\255\214\210\3749\322\357\004\237\364\203\341;\317\321\357FQ* \'\235w*\'g^K!\f\367O\262\220\'\001d\"\371\343#\035S\275\221\374\225\341\325\302>\362\301\330\324D\306_U\361\315\347\301\247\230)\375j\300\340\b\036\342\344_\021j\351\201O\205H\253qq\v\022~4kp\214xW\345\323\222*y\t\300\254\356ri#r\003_\217F)E\303`\263\240yO\207\375\214\274vn\321\030\321\272