            }
            lines {
              text: "      if (aimBoundarySvgRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const b = computeRoundedRectBoundary("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
