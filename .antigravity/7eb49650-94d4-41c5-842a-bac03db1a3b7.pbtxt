            }
            lines {
              text: "      const linOut = Math.min(1, u);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const px = padX + frac * plotW;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const py = padY + plotH - (out / maxY) * plotH;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
