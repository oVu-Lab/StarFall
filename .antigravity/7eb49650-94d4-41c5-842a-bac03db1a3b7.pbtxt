            lines {
              text: "function SteeringCurvePreview({ settings }: { settings: GameSettings }) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const { pathD, deadzoneXPos, boundaryXPos } = useMemo(() => {"
