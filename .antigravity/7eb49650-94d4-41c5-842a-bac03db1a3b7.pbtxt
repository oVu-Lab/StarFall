    tool_calls {
      id: "call_13993372121013675531"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Expose independent direct mouse steering curve parameters and live nonlinear curve visualization in SettingsPanel\", \"Instruction\":\"Update SteeringCurvePreview and Flight Settings controls to expose independent sensitivity, curve exponent, max yaw/pitch rates, axis balance, input smoothing, and aim boundary size\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":120, \"ReplacementContent\":\"import { STEERING_BOUNDS, STEERING_CONFIG } from \'../config/steering\';\\nimport { evaluateDirectMouseCurveScalar } from \'../engine/MouseResponseCurve\';\\nimport type {\\n  EffectQuality,\\n  GameSettings,\\n  GraphicsQuality,\\n  ShadowQuality,\\n} from \'../types/game\';\\n\\ninterface SettingsPanelProps {\\n  settings: GameSettings;\\n  onUpdateSettings: (patch: Partial<GameSettings>) => void;\\n  onClose: () => void;\\n  closeLabel?: string;\\n}\\n\\nconst QUALITY_OPTIONS: Array<{ value: GraphicsQuality; label: string }> = [\\n  { value: \'low\', label: \'Low\' },\\n  { value: \'medium\', label: \'Medium\' },\\n  { value: \'high\', label: \'High\' },\\n  { value: \'ultra\', label: \'Ultra\' },\\n];\\n\\nconst SHADOW_OPTIONS: Array<{ value: ShadowQuality; label: string }> = [\\n  { value: \'off\', label: \'Off\' },\\n  { value: \'low\', label: \'Low\' },\\n  { value: \'medium\', label: \'Med\' },\\n  { value: \'high\', label: \'High\' },\\n];\\n\\nconst EFFECT_OPTIONS: Array<{ value: EffectQuality; label: string }> = [\\n  { value: \'low\', label: \'Low\' },\\n  { value: \'medium\', label: \'Med\' },\\n  { value: \'high\', label: \'High\' },\\n];\\n\\nfunction SteeringCurvePreview({ settings }: { settings: GameSettings }) {\\n  const { curvePath, linearPath, refSpeedXPos } = useMemo(() => {\\n    const W = 240;\\n    const H = 64;\\n    const padX = 8;\\n    const padY = 8;\\n    const plotW = W - padX * 2;\\n    const plotH = H - padY * 2;\\n    // Plot normalized mouse input speed u in [0, 1.35] vs soft-saturated normalized turn rate [0, 1]\\n    const maxU = 1.35;\\n    const maxY = 1.05;\\n\\n    const curvePts: string[] = [];\\n    const linearPts: string[] = [];\\n    const steps = 64;\\n    for (let i = 0; i <= steps; i++) {\\n      const frac = i / steps;\\n      const u = frac * maxU;\\n      const out = evaluateDirectMouseCurveScalar(\\n        u,\\n        settings.responseCurve,\\n        STEERING_CONFIG.precisionLinearBlend,\\n        STEERING_CONFIG.softSaturationKnee,\\n      );\\n      const linOut = Math.min(1, u);\\n      const px = padX + frac * plotW;\\n      const py = padY + plotH - (out / maxY) * plotH;\\n      const lpy = padY + plotH - (linOut / maxY) * plotH;\\n      curvePts.push(`${i === 0 ? \'M\' : \'L\'}${px.toFixed(1)},${py.toFixed(1)}`);\\n      linearPts.push(`${i === 0 ? \'M\' : \'L\'}${px.toFixed(1)},${lpy.toFixed(1)}`);\\n    }\\n\\n    const refX = padX + (1.0 / maxU) * plotW;\\n    return {\\n      curvePath: curvePts.join(\' \'),\\n      linearPath: linearPts.join(\' \'),\\n      refSpeedXPos: refX,\\n    };\\n  }, [settings.responseCurve]);\\n\\n  return (\\n    <div className=\\\"border border-slate-800 bg-[#060f21] px-2.5 py-2\\\">\\n      <div className=\\\"mb-1 flex items-center justify-between font-mono text-[10px] text-slate-400\\\">\\n        <span>MOUSE CURVE \302\267 PRECISION \342\206\222 FAST TURN</span>\\n        <span className=\\\"text-cyan-300\\\">p={settings.responseCurve.toFixed(2)}</span>\\n      </div>\\n      <svg\\n        viewBox=\\\"0 0 240 64\\\"\\n        className=\\\"h-14 w-full\\\"\\n        aria-label=\\\"Nonlinear mouse steering response curve\\\"\\n      >\\n        {/* Max rate 1.0 reference line */}\\n        <line\\n          x1=\\\"8\\\"\\n          y1=\\\"10.3\\\"\\n          x2=\\\"232\\\"\\n          y2=\\\"10.3\\\"\\n          stroke=\\\"rgba(148,163,184,0.2)\\\"\\n          strokeDasharray=\\\"3 3\\\"\\n          strokeWidth=\\\"1\\\"\\n        />\\n        {/* Normalized reference input speed marker (u = 1.0, 1600 px/s) */}\\n        <line\\n          x1={refSpeedXPos.toFixed(1)}\\n          y1=\\\"6\\\"\\n          x2={refSpeedXPos.toFixed(1)}\\n          y2=\\\"58\\\"\\n          stroke=\\\"rgba(56,189,248,0.45)\\\"\\n          strokeDasharray=\\\"2 2\\\"\\n          strokeWidth=\\\"1\\\"\\n        />\\n        {/* Linear reference curve */}\\n        <path\\n          d={linearPath}\\n          fill=\\\"none\\\"\\n          stroke=\\\"rgba(148,163,184,0.32)\\\"\\n          strokeDasharray=\\\"3 3\\\"\\n          strokeWidth=\\\"1.2\\\"\\n        />\\n        {/* Active nonlinear response curve */}\\n        <path d={curvePath} fill=\\\"none\\\" stroke=\\\"#38bdf8\\\" strokeWidth=\\\"2\\\" />\\n      </svg>\\n    </div>\\n  );\\n}\", \"StartLine\":6, \"TargetContent\":\"import { STEERING_BOUNDS, STEERING_CONFIG } from \'../config/steering\';\\nimport { evaluateResponseCurveScalar } from \'../engine/AimBoundary\';\\nimport type {\\n  EffectQuality,\\n  GameSettings,\\n  GraphicsQuality,\\n  ShadowQuality,\\n} from \'../types/game\';\\n\\ninterface SettingsPanelProps {\\n  settings: GameSettings;\\n  onUpdateSettings: (patch: Partial<GameSettings>) => void;\\n  onClose: () => void;\\n  closeLabel?: string;\\n}\\n\\nconst QUALITY_OPTIONS: Array<{ value: GraphicsQuality; label: string }> = [\\n  { value: \'low\', label: \'Low\' },\\n  { value: \'medium\', label: \'Medium\' },\\n  { value: \'high\', label: \'High\' },\\n  { value: \'ultra\', label: \'Ultra\' },\\n];\\n\\nconst SHADOW_OPTIONS: Array<{ value: ShadowQuality; label: string }> = [\\n  { value: \'off\', label: \'Off\' },\\n  { value: \'low\', label: \'Low\' },\\n  { value: \'medium\', label: \'Med\' },\\n  { value: \'high\', label: \'High\' },\\n];\\n\\nconst EFFECT_OPTIONS: Array<{ value: EffectQuality; label: string }> = [\\n  { value: \'low\', label: \'Low\' },\\n  { value: \'medium\', label: \'Med\' },\\n  { value: \'high\', label: \'High\' },\\n];\\n\\nfunction SteeringCurvePreview({ settings }: { settings: GameSettings }) {\\n  const { pathD, deadzoneXPos, boundaryXPos } = useMemo(() => {\\n    const W = 240;\\n    const H = 64;\\n    const padX = 8;\\n    const padY = 8;\\n    const plotW = W - padX * 2;\\n    const plotH = H - padY * 2;\\n    // Plot normalized radial displacement r in [0, 1.25] to show deadzone, active ramp, and flat max clamp\\n    const maxR = 1.25;\\n    const maxY = 1.05;\\n\\n    const pts: string[] = [];\\n    const steps = 60;\\n    for (let i = 0; i <= steps; i++) {\\n      const frac = i / steps;\\n      const r = frac * maxR;\\n      const out = evaluateResponseCurveScalar(\\n        r,\\n        settings.deadzone,\\n        settings.responseCurve,\\n        STEERING_CONFIG.precisionSensitivity,\\n        STEERING_CONFIG.maxSteeringInput,\\n      );\\n      const px = padX + frac * plotW;\\n      const py = padY + plotH - (out / maxY) * plotH;\\n      pts.push(`${i === 0 ? \'M\' : \'L\'}${px.toFixed(1)},${py.toFixed(1)}`);\\n    }\\n\\n    const dzX = padX + (settings.deadzone / maxR) * plotW;\\n    const bX = padX + (1.0 / maxR) * plotW;\\n    return { pathD: pts.join(\' \'), deadzoneXPos: dzX, boundaryXPos: bX };\\n  }, [settings.deadzone, settings.responseCurve]);\\n\\n  return (\\n    <div className=\\\"border border-slate-800 bg-[#060f21] px-2.5 py-2\\\">\\n      <div className=\\\"mb-1 flex items-center justify-between font-mono text-[10px] text-slate-400\\\">\\n        <span>JOYSTICK CURVE \302\267 DEADZONE / ACTIVE / CAP</span>\\n        <span className=\\\"text-cyan-300\\\">p={settings.responseCurve.toFixed(2)}</span>\\n      </div>\\n      <svg\\n        viewBox=\\\"0 0 240 64\\\"\\n        className=\\\"h-14 w-full\\\"\\n        aria-label=\\\"Virtual joystick radial steering response curve\\\"\\n      >\\n        {/* Deadzone shaded region */}\\n        <rect\\n          x=\\\"8\\\"\\n          y=\\\"6\\\"\\n          width={Math.max(0, deadzoneXPos - 8).toFixed(1)}\\n          height=\\\"52\\\"\\n          fill=\\\"rgba(148,163,184,0.12)\\\"\\n        />\\n        {/* Max output 1.0 reference line */}\\n        <line\\n          x1=\\\"8\\\"\\n          y1=\\\"10.3\\\"\\n          x2=\\\"232\\\"\\n          y2=\\\"10.3\\\"\\n          stroke=\\\"rgba(148,163,184,0.2)\\\"\\n          strokeDasharray=\\\"3 3\\\"\\n          strokeWidth=\\\"1\\\"\\n        />\\n        {/* Joystick Radius boundary marker (r = 1.0) */}\\n        <line\\n          x1={boundaryXPos.toFixed(1)}\\n          y1=\\\"6\\\"\\n          x2={boundaryXPos.toFixed(1)}\\n          y2=\\\"58\\\"\\n          stroke=\\\"rgba(56,189,248,0.55)\\\"\\n          strokeDasharray=\\\"2 2\\\"\\n          strokeWidth=\\\"1\\\"\\n        />\\n        <path d={pathD} fill=\\\"none\\\" stroke=\\\"#38bdf8\\\" strokeWidth=\\\"2\\\" />\\n      </svg>\\n    </div>\\n  );\\n}\"}, {\"AllowMultiple\":false, \"EndLine\":305, \"ReplacementContent\":\"          <p className=\\\"mt-0.5 text-xs text-slate-400\\\">\\n            All direct mouse steering, graphics, and audio settings apply immediately and persist locally.\\n          </p>\\n        </div>\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => {\\n            AudioManager.playUiClick(\'secondary\');\\n            onUpdateSettings({ ...DEFAULT_SETTINGS });\\n          }}\\n          className=\\\"border border-slate-700 px-3 py-1.5 text-xs font-medium text-slate-300 transition-colors hover:border-cyan-400/60 hover:text-cyan-200 whitespace-nowrap shrink-0\\\"\\n        >\\n          Restore Defaults\\n        </button>\\n      </div>\\n\\n      <div className=\\\"mt-5 grid grid-cols-1 gap-6 md:grid-cols-2\\\">\\n        {/* Left Column: Direct Arcade Mouse Steering, Camera & Audio */}\\n        <div className=\\\"space-y-3.5\\\">\\n          <h3 className=\\\"font-mono text-[11px] tracking-widest text-cyan-300\\\">\\n            DIRECT MOUSE STEERING\\n          </h3>\\n\\n          <SteeringCurvePreview settings={settings} />\\n\\n          <div className=\\\"grid grid-cols-2 gap-3\\\">\\n            <div>\\n              <div className=\\\"flex items-center justify-between text-xs\\\">\\n                <label htmlFor=\\\"setting-mouse-sens\\\" className=\\\"font-medium text-slate-200\\\">\\n                  Base Sensitivity\\n                </label>\\n                <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                  {settings.mouseSensitivity.toFixed(2)}x\\n                </span>\\n              </div>\\n              <input\\n                id=\\\"setting-mouse-sens\\\"\\n                type=\\\"range\\\"\\n                min={STEERING_BOUNDS.mouseSensitivity.min}\\n                max={STEERING_BOUNDS.mouseSensitivity.max}\\n                step={0.05}\\n                value={settings.mouseSensitivity}\\n                onChange={(e) =>\\n                  onUpdateSettings({ mouseSensitivity: parseFloat(e.target.value) })\\n                }\\n                className=\\\"starfall-slider mt-1 w-full\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <div className=\\\"flex items-center justify-between text-xs\\\">\\n                <label htmlFor=\\\"setting-response-curve\\\" className=\\\"font-medium text-slate-200\\\">\\n                  Response Curve\\n                </label>\\n                <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                  {settings.responseCurve.toFixed(2)}\\n                </span>\\n              </div>\\n              <input\\n                id=\\\"setting-response-curve\\\"\\n                type=\\\"range\\\"\\n                min={STEERING_BOUNDS.responseCurve.min}\\n                max={STEERING_BOUNDS.responseCurve.max}\\n                step={0.05}\\n                value={settings.responseCurve}\\n                onChange={(e) => onUpdateSettings({ responseCurve: parseFloat(e.target.value) })}\\n                className=\\\"starfall-slider mt-1 w-full\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-2 gap-3\\\">\\n            <div>\\n              <div className=\\\"flex items-center justify-between text-xs\\\">\\n                <label htmlFor=\\\"setting-max-yaw\\\" className=\\\"font-medium text-slate-200\\\">\\n                  Max Yaw Rate\\n                </label>\\n                <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                  {settings.maxYawRate.toFixed(1)} r/s\\n                </span>\\n              </div>\\n              <input\\n                id=\\\"setting-max-yaw\\\"\\n                type=\\\"range\\\"\\n                min={STEERING_BOUNDS.maxYawRate.min}\\n                max={STEERING_BOUNDS.maxYawRate.max}\\n                step={0.1}\\n                value={settings.maxYawRate}\\n                onChange={(e) => onUpdateSettings({ maxYawRate: parseFloat(e.target.value) })}\\n                className=\\\"starfall-slider mt-1 w-full\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <div className=\\\"flex items-center justify-between text-xs\\\">\\n                <label htmlFor=\\\"setting-max-pitch\\\" className=\\\"font-medium text-slate-200\\\">\\n                  Max Pitch Rate\\n                </label>\\n                <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                  {settings.maxPitchRate.toFixed(1)} r/s\\n                </span>\\n              </div>\\n              <input\\n                id=\\\"setting-max-pitch\\\"\\n                type=\\\"range\\\"\\n                min={STEERING_BOUNDS.maxPitchRate.min}\\n                max={STEERING_BOUNDS.maxPitchRate.max}\\n                step={0.1}\\n                value={settings.maxPitchRate}\\n                onChange={(e) => onUpdateSettings({ maxPitchRate: parseFloat(e.target.value) })}\\n                className=\\\"starfall-slider mt-1 w-full\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-2 gap-3\\\">\\n            <div>\\n              <div className=\\\"flex items-center justify-between text-xs\\\">\\n                <label htmlFor=\\\"setting-yaw-sens\\\" className=\\\"font-medium text-slate-200\\\">\\n                  Yaw Balance\\n                </label>\\n                <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                  {settings.yawSensitivity.toFixed(2)}x\\n                </span>\\n              </div>\\n              <input\\n                id=\\\"setting-yaw-sens\\\"\\n                type=\\\"range\\\"\\n                min={STEERING_BOUNDS.yawSensitivity.min}\\n                max={STEERING_BOUNDS.yawSensitivity.max}\\n                step={0.05}\\n                value={settings.yawSensitivity}\\n                onChange={(e) =>\\n                  onUpdateSettings({ yawSensitivity: parseFloat(e.target.value) })\\n                }\\n                className=\\\"starfall-slider mt-1 w-full\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <div className=\\\"flex items-center justify-between text-xs\\\">\\n                <label htmlFor=\\\"setting-pitch-sens\\\" className=\\\"font-medium text-slate-200\\\">\\n                  Pitch Balance\\n                </label>\\n                <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                  {settings.pitchSensitivity.toFixed(2)}x\\n                </span>\\n              </div>\\n              <input\\n                id=\\\"setting-pitch-sens\\\"\\n                type=\\\"range\\\"\\n                min={STEERING_BOUNDS.pitchSensitivity.min}\\n                max={STEERING_BOUNDS.pitchSensitivity.max}\\n                step={0.05}\\n                value={settings.pitchSensitivity}\\n                onChange={(e) =>\\n                  onUpdateSettings({ pitchSensitivity: parseFloat(e.target.value) })\\n                }\\n                className=\\\"starfall-slider mt-1 w-full\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-2 gap-3\\\">\\n            <div>\\n              <div className=\\\"flex items-center justify-between text-xs\\\">\\n                <label htmlFor=\\\"setting-input-smoothing\\\" className=\\\"font-medium text-slate-200\\\">\\n                  Input Smoothing\\n                </label>\\n                <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                  {settings.inputSmoothing <= 0.001\\n                    ? \'Off\'\\n                    : `${Math.round(settings.inputSmoothing * 100)}%`}\\n                </span>\\n              </div>\\n              <input\\n                id=\\\"setting-input-smoothing\\\"\\n                type=\\\"range\\\"\\n                min={STEERING_BOUNDS.inputSmoothing.min}\\n                max={STEERING_BOUNDS.inputSmoothing.max}\\n                step={0.02}\\n                value={settings.inputSmoothing}\\n                onChange={(e) =>\\n                  onUpdateSettings({ inputSmoothing: parseFloat(e.target.value) })\\n                }\\n                className=\\\"starfall-slider mt-1 w-full\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <div className=\\\"flex items-center justify-between text-xs\\\">\\n                <label htmlFor=\\\"setting-joystick-radius\\\" className=\\\"font-medium text-slate-200\\\">\\n                  Aim Boundary\\n                </label>\\n                <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                  {effectiveBoundaryW}%\303\227{effectiveBoundaryH}%\\n                </span>\\n              </div>\\n              <input\\n                id=\\\"setting-joystick-radius\\\"\\n                type=\\\"range\\\"\\n                min={STEERING_BOUNDS.joystickRadius.min}\\n                max={STEERING_BOUNDS.joystickRadius.max}\\n                step={0.05}\\n                value={settings.joystickRadius}\\n                onChange={(e) =>\\n                  onUpdateSettings({ joystickRadius: parseFloat(e.target.value) })\\n                }\\n                className=\\\"starfall-slider mt-1 w-full\\\"\\n              />\\n            </div>\\n          </div>\", \"StartLine\":141, \"TargetContent\":\"          <p className=\\\"mt-0.5 text-xs text-slate-400\\\">\\n            All virtual joystick flight, graphics, and audio settings apply immediately and persist locally.\\n          </p>\\n        </div>\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => {\\n            AudioManager.playUiClick(\'secondary\');\\n            onUpdateSettings({ ...DEFAULT_SETTINGS });\\n          }}\\n          className=\\\"border border-slate-700 px-3 py-1.5 text-xs font-medium text-slate-300 transition-colors hover:border-cyan-400/60 hover:text-cyan-200 whitespace-nowrap shrink-0\\\"\\n        >\\n          Restore Defaults\\n        </button>\\n      </div>\\n\\n      <div className=\\\"mt-5 grid grid-cols-1 gap-6 md:grid-cols-2\\\">\\n        {/* Left Column: Virtual Joystick Flight, Camera & Audio */}\\n        <div className=\\\"space-y-3.5\\\">\\n          <h3 className=\\\"font-mono text-[11px] tracking-widest text-cyan-300\\\">\\n            VIRTUAL JOYSTICK FLIGHT\\n          </h3>\\n\\n          <SteeringCurvePreview settings={settings} />\\n\\n          <div>\\n            <div className=\\\"flex items-center justify-between text-xs\\\">\\n              <label htmlFor=\\\"setting-mouse-sens\\\" className=\\\"font-medium text-slate-200\\\">\\n                Mouse Sensitivity\\n              </label>\\n              <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                {settings.mouseSensitivity.toFixed(2)}x\\n              </span>\\n            </div>\\n            <input\\n              id=\\\"setting-mouse-sens\\\"\\n              type=\\\"range\\\"\\n              min={STEERING_BOUNDS.mouseSensitivity.min}\\n              max={STEERING_BOUNDS.mouseSensitivity.max}\\n              step={0.05}\\n              value={settings.mouseSensitivity}\\n              onChange={(e) =>\\n                onUpdateSettings({ mouseSensitivity: parseFloat(e.target.value) })\\n              }\\n              className=\\\"starfall-slider mt-1 w-full\\\"\\n            />\\n          </div>\\n\\n          <div>\\n            <div className=\\\"flex items-center justify-between text-xs\\\">\\n              <label htmlFor=\\\"setting-joystick-radius\\\" className=\\\"font-medium text-slate-200\\\">\\n                Joystick Radius\\n              </label>\\n              <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                {Math.round(settings.joystickRadius * 100)}% ({effectiveBoundaryW}%\303\227{effectiveBoundaryH}%)\\n              </span>\\n            </div>\\n            <input\\n              id=\\\"setting-joystick-radius\\\"\\n              type=\\\"range\\\"\\n              min={STEERING_BOUNDS.joystickRadius.min}\\n              max={STEERING_BOUNDS.joystickRadius.max}\\n              step={0.05}\\n              value={settings.joystickRadius}\\n              onChange={(e) =>\\n                onUpdateSettings({ joystickRadius: parseFloat(e.target.value) })\\n              }\\n              className=\\\"starfall-slider mt-1 w-full\\\"\\n            />\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-2 gap-3\\\">\\n            <div>\\n              <div className=\\\"flex items-center justify-between text-xs\\\">\\n                <label htmlFor=\\\"setting-deadzone\\\" className=\\\"font-medium text-slate-200\\\">\\n                  Deadzone\\n                </label>\\n                <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                  {Math.round(settings.deadzone * 100)}%\\n                </span>\\n              </div>\\n              <input\\n                id=\\\"setting-deadzone\\\"\\n                type=\\\"range\\\"\\n                min={STEERING_BOUNDS.deadzone.min}\\n                max={STEERING_BOUNDS.deadzone.max}\\n                step={0.01}\\n                value={settings.deadzone}\\n                onChange={(e) => onUpdateSettings({ deadzone: parseFloat(e.target.value) })}\\n                className=\\\"starfall-slider mt-1 w-full\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <div className=\\\"flex items-center justify-between text-xs\\\">\\n                <label htmlFor=\\\"setting-response-curve\\\" className=\\\"font-medium text-slate-200\\\">\\n                  Response Curve\\n                </label>\\n                <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                  {settings.responseCurve.toFixed(2)}\\n                </span>\\n              </div>\\n              <input\\n                id=\\\"setting-response-curve\\\"\\n                type=\\\"range\\\"\\n                min={STEERING_BOUNDS.responseCurve.min}\\n                max={STEERING_BOUNDS.responseCurve.max}\\n                step={0.05}\\n                value={settings.responseCurve}\\n                onChange={(e) => onUpdateSettings({ responseCurve: parseFloat(e.target.value) })}\\n                className=\\\"starfall-slider mt-1 w-full\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-2 gap-3\\\">\\n            <div>\\n              <div className=\\\"flex items-center justify-between text-xs\\\">\\n                <label htmlFor=\\\"setting-yaw-sens\\\" className=\\\"font-medium text-slate-200\\\">\\n                  Yaw Sensitivity\\n                </label>\\n                <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                  {settings.yawSensitivity.toFixed(2)}x\\n                </span>\\n              </div>\\n              <input\\n                id=\\\"setting-yaw-sens\\\"\\n                type=\\\"range\\\"\\n                min={STEERING_BOUNDS.yawSensitivity.min}\\n                max={STEERING_BOUNDS.yawSensitivity.max}\\n                step={0.05}\\n                value={settings.yawSensitivity}\\n                onChange={(e) =>\\n                  onUpdateSettings({ yawSensitivity: parseFloat(e.target.value) })\\n                }\\n                className=\\\"starfall-slider mt-1 w-full\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <div className=\\\"flex items-center justify-between text-xs\\\">\\n                <label htmlFor=\\\"setting-pitch-sens\\\" className=\\\"font-medium text-slate-200\\\">\\n                  Pitch Sensitivity\\n                </label>\\n                <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                  {settings.pitchSensitivity.toFixed(2)}x\\n                </span>\\n              </div>\\n              <input\\n                id=\\\"setting-pitch-sens\\\"\\n                type=\\\"range\\\"\\n                min={STEERING_BOUNDS.pitchSensitivity.min}\\n                max={STEERING_BOUNDS.pitchSensitivity.max}\\n                step={0.05}\\n                value={settings.pitchSensitivity}\\n                onChange={(e) =>\\n                  onUpdateSettings({ pitchSensitivity: parseFloat(e.target.value) })\\n                }\\n                className=\\\"starfall-slider mt-1 w-full\\\"\\n              />\\n            </div>\\n          </div>\"}], \"TargetFile\":\"/src/components/SettingsPanel.tsx\", \"toolAction\":\"Updating SettingsPanel steering controls\", \"toolSummary\":\"Update SettingsPanel controls\"}"
