            lines {
              text: "        perfLine1Ref.current.textContent = `${t.fps} FPS \302\267 ${t.frameTimeMs.toFixed(1)} ms \302\267 ${t.drawCalls} draws \302\267 ${(t.triangles / 1000).toFixed(1)}k tris`;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        perfLine2Ref.current.textContent = `E:${t.activeEnemies} \302\267 P:${t.activeProjectiles} \302\267 VFX:${t.activeParticles} \302\267 Assets:${t.cachedAssetCount} (${t.lastAssetLoadMs.toFixed(0)}ms)`;"
