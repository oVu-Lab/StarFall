            }
            lines {
              text: "              deadzoneRectRef.current.setAttribute(\'width\', dzW.toFixed(1));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              deadzoneRectRef.current.setAttribute(\'height\', dzH.toFixed(1));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              deadzoneRectRef.current.setAttribute(\'rx\', dzR.toFixed(1));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              deadzoneRectRef.current.setAttribute(\'ry\', dzR.toFixed(1));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              deadzoneRectRef.current.style.visibility = \'visible\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            } else {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              deadzoneRectRef.current.style.visibility = \'hidden\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          }"
