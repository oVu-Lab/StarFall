            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      // Subtle sci-fi rounded-rectangle corner markings (30% x 35% base viewport geometry scaled by joystickRadius)"
