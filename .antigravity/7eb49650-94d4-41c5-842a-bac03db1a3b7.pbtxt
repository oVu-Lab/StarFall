            lines {
              text: "      const u = frac * maxU;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const out = evaluateDirectMouseCurveScalar("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        u,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
