              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  softSaturationKnee: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /** Reference mouse speed (px/s) where normalized input u = 1.0 at sensitivity 1.0 */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  inputNormalizationRange: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /** Independent horizontal yaw sensitivity balance */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  yawSensitivity: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /** Independent vertical pitch sensitivity balance */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  pitchSensitivity: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /** Independent maximum yaw angular rate ceiling (rad/s) */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  maxYawRate: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /** Independent maximum pitch angular rate ceiling (rad/s) */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  maxPitchRate: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /** Invert vertical pitch axis */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  invertY: boolean;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Zero-allocation output structure for per-frame direct mouse steering evaluation."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export interface DirectMouseEvaluation {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /** Instantaneous frame-rate-independent mouse speed magnitude in CSS px/s */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  speedPxPerSec: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /** Normalized mouse speed `u = (speedPxPerSec * mouseSensitivity) / inputNormalizationRange` */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  normalizedInput: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /** Unbounded nonlinear gain `g(u)` prior to axis balance & soft saturation */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  curveGain: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /** Soft-saturated normalized horizontal steering demand in [-1, 1] */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  steerYaw: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /** Soft-saturated normalized vertical steering demand in [-1, 1] */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  steerPitch: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /** Target yaw angular rate in rad/s (capped smoothly at \302\261maxYawRate) */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  targetYawRate: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /** Target pitch angular rate in rad/s (capped smoothly at \302\261maxPitchRate) */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  targetPitchRate: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function createDirectMouseEvaluation(): DirectMouseEvaluation {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    speedPxPerSec: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    normalizedInput: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    curveGain: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    steerYaw: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    steerPitch: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    targetYawRate: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    targetPitchRate: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * C2-continuous signed soft saturation into (-1, +1)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - For `|x| <= knee`: exact identity `x` (zero distortion in precision & medium ranges)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - For `|x| > knee`: `sign(x) * (knee + (1 - knee) * tanh((|x| - knee) / (1 - knee)))`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   Matches value (knee), first derivative (1.0), and second derivative (0.0) at `|x| = knee`,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   eliminating any abrupt clipping corner or sudden spike as turn rate approaches ceiling."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function softSaturateSigned("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  value: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  knee: number = DIRECT_MOUSE_STEERING_CONFIG.softSaturationKnee,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): number {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (!Number.isFinite(value) || value === 0) return 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const k = THREE.MathUtils.clamp(knee, 0.5, 0.98);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const absVal = Math.abs(value);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (absVal <= k) return value;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const headroom = 1 - k;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const excess = (absVal - k) / headroom;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const saturated = k + headroom * Math.tanh(excess);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return value < 0 ? -saturated : saturated;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Continuous monotonic nonlinear gain function `g(u)` for normalized input speed `u >= 0`:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   `g(u) = a * u + (1 - a) * u^p`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Properties:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - `g(0) = 0`, `g\'(0) = a`: Small mouse movements produce subtle, predictable precision"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   rotation rather than dropping into a deadzone."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - Strictly smooth (`C\342\210\236` for `u > 0`), monotonically increasing derivative for `p > 1`:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   Medium movements progressively accelerate steering response with zero jumps or knees."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - Anchored at `g(1) = 1` for all `p` and `a`: Changing curve exponent reshapes the"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   precision-to-fast-turn progression cleanly without shifting the reference anchor."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - Reduces exactly to linear `g(u) = u` when `p = 1.0`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function evaluateNonlinearGain("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  normalizedInput: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  responseCurve: number = DIRECT_MOUSE_STEERING_CONFIG.responseCurve,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  precisionLinearBlend: number = DIRECT_MOUSE_STEERING_CONFIG.precisionLinearBlend,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): number {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (!Number.isFinite(normalizedInput) || normalizedInput <= 0) return 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const p = THREE.MathUtils.clamp("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    responseCurve,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    STEERING_BOUNDS.responseCurve.min,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    STEERING_BOUNDS.responseCurve.max,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const a = THREE.MathUtils.clamp(precisionLinearBlend, 0.05, 0.95);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (Math.abs(p - 1.0) < 1e-4) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return normalizedInput;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return a * normalizedInput + (1 - a) * Math.pow(normalizedInput, p);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Scalar convenience evaluator combining `evaluateNonlinearGain` and `softSaturateSigned`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Used for both verification and the Settings Panel live curve visualization."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function evaluateDirectMouseCurveScalar("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  normalizedInput: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  responseCurve: number = DIRECT_MOUSE_STEERING_CONFIG.responseCurve,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  precisionLinearBlend: number = DIRECT_MOUSE_STEERING_CONFIG.precisionLinearBlend,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  softSaturationKnee: number = DIRECT_MOUSE_STEERING_CONFIG.softSaturationKnee,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): number {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (!Number.isFinite(normalizedInput) || normalizedInput <= 0) return 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const gain = evaluateNonlinearGain(normalizedInput, responseCurve, precisionLinearBlend);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return softSaturateSigned(gain, softSaturationKnee);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Evaluates raw Pointer Lock mouse deltas (`movementX`, `movementY`) over frame delta `dt`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * into frame-rate-independent target yaw and pitch angular rates (rad/s)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Frame-Rate Independence:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   Converts per-frame pixel deltas to instantaneous mouse speed `px/s` using clamped"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   `velDt = max(dt, 1/240)` before applying the nonlinear curve, ensuring consistent"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   angular response across 30, 60, 120, and 144+ FPS displays."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Zero-Input Guarantee:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   When `mouseDeltaX === 0 && mouseDeltaY === 0`, outputs exact zeros across all fields."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function evaluateDirectMouseSteering("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  mouseDeltaX: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  mouseDeltaY: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  dt: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  params: DirectMouseCurveParams,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  out: DirectMouseEvaluation = createDirectMouseEvaluation(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): DirectMouseEvaluation {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const dx = Number.isFinite(mouseDeltaX) ? mouseDeltaX : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const dy = Number.isFinite(mouseDeltaY) ? mouseDeltaY : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (dx === 0 && dy === 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    out.speedPxPerSec = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    out.normalizedInput = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    out.curveGain = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    out.steerYaw = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    out.steerPitch = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    out.targetYawRate = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    out.targetPitchRate = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return out;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Guard against sub-4ms synthetic dt spikes while staying exact at 30-240 FPS"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const velDt = Math.max(dt, 1 / 240);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const ySign = params.invertY ? -1 : 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const vx = dx / velDt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const vy = (dy * ySign) / velDt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const vMag = Math.hypot(vx, vy);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (vMag <= 1e-6) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    out.speedPxPerSec = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    out.normalizedInput = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    out.curveGain = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    out.steerYaw = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    out.steerPitch = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    out.targetYawRate = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    out.targetPitchRate = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return out;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const ux = vx / vMag;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const uy = vy / vMag;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const baseSens = THREE.MathUtils.clamp("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    params.mouseSensitivity,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    STEERING_BOUNDS.mouseSensitivity.min,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    STEERING_BOUNDS.mouseSensitivity.max,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const normRange = Math.max(100, params.inputNormalizationRange);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const u = (vMag * baseSens) / normRange;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const gain = evaluateNonlinearGain(u, params.responseCurve, params.precisionLinearBlend);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const yawSens = THREE.MathUtils.clamp("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    params.yawSensitivity,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    STEERING_BOUNDS.yawSensitivity.min,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    STEERING_BOUNDS.yawSensitivity.max,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const pitchSens = THREE.MathUtils.clamp("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    params.pitchSensitivity,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
