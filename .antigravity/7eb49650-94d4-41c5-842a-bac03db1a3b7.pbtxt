            }
            lines {
              text: "    const padY = 8;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const plotW = W - padX * 2;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const plotH = H - padY * 2;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // Plot normalized radial displacement r in [0, 1.25] to show deadzone, active ramp, and flat max clamp"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const maxR = 1.25;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // Plot normalized mouse input speed u in [0, 1.35] vs soft-saturated normalized turn rate [0, 1]"
