            lines {
              text: "          boundaryScratchRef.current,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        );"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const key = `${vw.toFixed(1)}:${vh.toFixed(1)}:${b.widthPx.toFixed(1)}:${b.heightPx.toFixed(1)}:${b.cornerRadiusPx.toFixed(1)}:${s.deadzone.toFixed(3)}`;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        if (key !== lastBoundaryKeyRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          lastBoundaryKeyRef.current = key;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const x0 = cx - b.halfW;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const x1 = cx + b.halfW;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const y0 = cy - b.halfH;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const y1 = cy + b.halfH;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const r = b.cornerRadiusPx;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const arm = Math.max(8, Math.min(18, Math.min(b.innerHalfW, b.innerHalfH) * 0.24));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const paths = ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            // Top-left rounded corner bracket"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            `M ${x0.toFixed(1)} ${(y0 + r + arm).toFixed(1)} L ${x0.toFixed(1)} ${(y0 + r).toFixed(1)} A ${r.toFixed(1)} ${r.toFixed(1)} 0 0 1 ${(x0 + r).toFixed(1)} ${y0.toFixed(1)} L ${(x0 + r + arm).toFixed(1)} ${y0.toFixed(1)}`,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            // Top-right rounded corner bracket"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            `M ${(x1 - r - arm).toFixed(1)} ${y0.toFixed(1)} L ${(x1 - r).toFixed(1)} ${y0.toFixed(1)} A ${r.toFixed(1)} ${r.toFixed(1)} 0 0 1 ${x1.toFixed(1)} ${(y0 + r).toFixed(1)} L ${x1.toFixed(1)} ${(y0 + r + arm).toFixed(1)}`,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            // Bottom-right rounded corner bracket"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            `M ${x1.toFixed(1)} ${(y1 - r - arm).toFixed(1)} L ${x1.toFixed(1)} ${(y1 - r).toFixed(1)} A ${r.toFixed(1)} ${r.toFixed(1)} 0 0 1 ${(x1 - r).toFixed(1)} ${y1.toFixed(1)} L ${(x1 - r - arm).toFixed(1)} ${y1.toFixed(1)}`,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            // Bottom-left rounded corner bracket"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            `M ${(x0 + r + arm).toFixed(1)} ${y1.toFixed(1)} L ${(x0 + r).toFixed(1)} ${y1.toFixed(1)} A ${r.toFixed(1)} ${r.toFixed(1)} 0 0 1 ${x0.toFixed(1)} ${(y1 - r).toFixed(1)} L ${x0.toFixed(1)} ${(y1 - r - arm).toFixed(1)}`,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          ];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          for (let i = 0; i < 4; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            cornerPathRefs.current[i]?.setAttribute(\'d\', paths[i]);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          if (deadzoneRectRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            if (s.deadzone > 0.005) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            if (STEERING_CONFIG.steeringMode === \'virtual-joystick-baseline\' && s.deadzone > 0.005) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const dzW = b.widthPx * s.deadzone;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              const dzH = b.heightPx * s.deadzone;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              const dzR = b.cornerRadiusPx * s.deadzone;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              deadzoneRectRef.current.setAttribute(\'x\', (cx - dzW * 0.5).toFixed(1));"
