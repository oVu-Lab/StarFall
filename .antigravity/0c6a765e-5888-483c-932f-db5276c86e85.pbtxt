    command_line: "node -e \'\nconst dz = 0.06;\nfunction evalCurve(fn, r) {\n  const eps = 0.001;\n  const v = fn(r);\n  const dv = (fn(Math.min(1, r+eps)) - fn(Math.max(0, r-eps))) / (Math.min(1, r+eps) - Math.max(0, r-eps));\n  return { v, dv };\n}\nfunction oldCurve(r) {\n  if (r <= dz) return 0; if (r >= 1) return 1;\n  const u = (r - dz) / (1 - dz);\n  const s = u*u*(3-2*u);\n  return Math.pow(u, 1.35) * (0.85 + 0.15 * s);\n}\nfunction newCurve(r, p=1.35, k=0.85) {\n  if (r <= dz) return 0; if (r >= 1) return 1;\n  const u = (r - dz) / (1 - dz);\n  const t = Math.pow(u, p);\n  const s = t * t * (3 - 2 * t);\n  return s * (k + (1 - k) * s);\n}\nconst pts = [0, 0.06, 0.15, 0.25, 0.35, 0.50, 0.65, 0.75, 0.85, 0.95, 1.00];\nconsole.log(\"r    | OLD (1.35,0.85)  | NEW(p=1.20,k=0.85) | NEW(p=1.35,k=0.85) | NEW(p=1.00,k=0.85) | NEW(p=1.25,k=0.80)\");\nfor (const r of pts) {\n  const a = evalCurve(oldCurve, r);\n  const b = evalCurve((x)=>newCurve(x, 1.20, 0.85), r);\n  const c = evalCurve((x)=>newCurve(x, 1.35, 0.85), r);\n  const d = evalCurve((x)=>newCurve(x, 1.00, 0.85), r);\n  const e = evalCurve((x)=>newCurve(x, 1.25, 0.80), r);\n  console.log(\n    r.toFixed(2).padEnd(5) + \"| \" +\n    `${a.v.toFixed(4)} (${a.dv.toFixed(2)})`.padEnd(17) + \"| \" +\n    `${b.v.toFixed(4)} (${b.dv.toFixed(2)})`.padEnd(19) + \"| \" +\n    `${c.v.toFixed(4)} (${c.dv.toFixed(2)})`.padEnd(19) + \"| \" +\n    `${d.v.toFixed(4)} (${d.dv.toFixed(2)})`.padEnd(19) + \"| \" +\n    `${e.v.toFixed(4)} (${e.dv.toFixed(2)})`\n  );\n}\n\'"
    proposed_command_line: "node -e \'\nconst dz = 0.06;\nfunction evalCurve(fn, r) {\n  const eps = 0.001;\n  const v = fn(r);\n  const dv = (fn(Math.min(1, r+eps)) - fn(Math.max(0, r-eps))) / (Math.min(1, r+eps) - Math.max(0, r-eps));\n  return { v, dv };\n}\nfunction oldCurve(r) {\n  if (r <= dz) return 0; if (r >= 1) return 1;\n  const u = (r - dz) / (1 - dz);\n  const s = u*u*(3-2*u);\n  return Math.pow(u, 1.35) * (0.85 + 0.15 * s);\n}\nfunction newCurve(r, p=1.35, k=0.85) {\n  if (r <= dz) return 0; if (r >= 1) return 1;\n  const u = (r - dz) / (1 - dz);\n  const t = Math.pow(u, p);\n  const s = t * t * (3 - 2 * t);\n  return s * (k + (1 - k) * s);\n}\nconst pts = [0, 0.06, 0.15, 0.25, 0.35, 0.50, 0.65, 0.75, 0.85, 0.95, 1.00];\nconsole.log(\"r    | OLD (1.35,0.85)  | NEW(p=1.20,k=0.85) | NEW(p=1.35,k=0.85) | NEW(p=1.00,k=0.85) | NEW(p=1.25,k=0.80)\");\nfor (const r of pts) {\n  const a = evalCurve(oldCurve, r);\n  const b = evalCurve((x)=>newCurve(x, 1.20, 0.85), r);\n  const c = evalCurve((x)=>newCurve(x, 1.35, 0.85), r);\n  const d = evalCurve((x)=>newCurve(x, 1.00, 0.85), r);\n  const e = evalCurve((x)=>newCurve(x, 1.25, 0.80), r);\n  console.log(\n    r.toFixed(2).padEnd(5) + \"| \" +\n    `${a.v.toFixed(4)} (${a.dv.toFixed(2)})`.padEnd(17) + \"| \" +\n    `${b.v.toFixed(4)} (${b.dv.toFixed(2)})`.padEnd(19) + \"| \" +\n    `${c.v.toFixed(4)} (${c.dv.toFixed(2)})`.padEnd(19) + \"| \" +\n    `${d.v.toFixed(4)} (${d.dv.toFixed(2)})`.padEnd(19) + \"| \" +\n    `${e.v.toFixed(4)} (${e.dv.toFixed(2)})`\n  );\n}\n\'"
