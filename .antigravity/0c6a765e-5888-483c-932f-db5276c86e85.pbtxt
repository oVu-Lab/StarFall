    command_line: "node -e \'\nconst dz = 0.06;\nfunction evalCurve(fn, r) {\n  const eps = 0.001;\n  const v = fn(r);\n  const dv = (fn(Math.min(1, r+eps)) - fn(Math.max(0, r-eps))) / (Math.min(1, r+eps) - Math.max(0, r-eps));\n  return { v, dv };\n}\nfunction oldCurve(r) {\n  if (r <= dz) return 0; if (r >= 1) return 1;\n  const u = (r - dz) / (1 - dz);\n  const s = u*u*(3-2*u);\n  return Math.pow(u, 1.35) * (0.85 + 0.15 * s);\n}\n// Candidate 1: smoothstep(u^p) with p=1.35\nfunction smPow(r, p=1.35) {\n  if (r <= dz) return 0; if (r >= 1) return 1;\n  const u = (r - dz) / (1 - dz);\n  const t = Math.pow(u, p);\n  return t * t * (3 - 2 * t);\n}\n// Candidate 2: smoothstep(u) weighted with power curve? No, smoothstep(t) where t = u^p * (k + (1-k)*u)\n// Wait: what if we use a C1-continuous blend of inner low-sensitivity curve and outer boundary-easing curve?\n// E.g. t = Math.pow(u, p); h = t * t * (3 - 2 * t); blend = lerp(t, h, w) or similar?\n// Notice: if w < 1, slope at u=1 is (1-w)*p > 0; if w = 1, slope at u=1 is 0!\n// Let us check w = 0.75 or w = 1.0, or t = u^(1 + (p-1)*...) or Hermite!\nfunction smPowBlend(r, p=1.35, w=0.80) {\n  if (r <= dz) return 0; if (r >= 1) return 1;\n  const u = (r - dz) / (1 - dz);\n  const t = Math.pow(u, p);\n  const h = t * t * (3 - 2 * t);\n  return t * (1 - w) + h * w;\n}\n// Candidate 3: C1 cubic/power S-curve with inner precision k:\n// f(u) = (k * u^p) blended? Wait: what if f(u) = smoothstep(u) * (k + (1-k)*u^p)? No, at u=1 f(1)=1, f_prime(1)=0 + (1-k)*p!\n// What if f(u) = u^p * (3 - 2*u) * (k + (1-k)*...)? Wait: u^p * (3 - 2*u) has:\n// at u=0: 0, deriv 0 (if p>1). Wait: at u=1: 1*(3-2)=1! Deriv at u=1: p*1*(1) + 1*(-2) = p - 2!\n// For p=2: f(u) = u^2*(3-2u) IS smoothstep(u)!\n// For p > 2 (say p = 2 + (responseCurve - 1)): Wait: at p=2.35, deriv at u=1 is 0.35! Wait: is it monotonic on [0,1]?\n// Let us check deriv of u^p*(3-2u): u^(p-1)*(3p - 2(p+1)u). At u=1, 3p - 2p - 2 = p - 2!\n// So for ANY p >= 2, u^p*(3-2u) is STRICTLY MONOTONIC on [0,1], has f(0)=0, f_prime(0)=0, f(1)=1, and f_prime(1) = p - 2!\n// Wait: what about 3*u^(2p) - 2*u^(3p)? There f_prime(1) = 0 ALWAYS, and peak slope is around u = ((2p-1)/(3p-1))^(1/p)!\n// Let us compare smPow(1.35), smPow(1.25), and u^p*(3-2u) style, and also check k (precisionSensitivity)!\nconst pts = [0, 0.06, 0.15, 0.25, 0.50, 0.75, 0.85, 0.95, 1.00];\nconsole.log(\"r    | OLD (val / slope) | smPow1.35 (val / slope) | smPow1.25 (val / slope) | smPowBlend0.85 (val / slope)\");\nfor (const r of pts) {\n  const a = evalCurve(oldCurve, r);\n  const b = evalCurve((x)=>smPow(x, 1.35), r);\n  const c = evalCurve((x)=>smPow(x, 1.25), r);\n  const d = evalCurve((x)=>smPowBlend(x, 1.35, 0.85), r);\n  console.log(\n    r.toFixed(2).padEnd(5) + \"| \" +\n    `${a.v.toFixed(4)} / ${a.dv.toFixed(2)}`.padEnd(18) + \"| \" +\n    `${b.v.toFixed(4)} / ${b.dv.toFixed(2)}`.padEnd(24) + \"| \" +\n    `${c.v.toFixed(4)} / ${c.dv.toFixed(2)}`.padEnd(24) + \"| \" +\n    `${d.v.toFixed(4)} / ${d.dv.toFixed(2)}`\n  );\n}\n\'"
    proposed_command_line: "node -e \'\nconst dz = 0.06;\nfunction evalCurve(fn, r) {\n  const eps = 0.001;\n  const v = fn(r);\n  const dv = (fn(Math.min(1, r+eps)) - fn(Math.max(0, r-eps))) / (Math.min(1, r+eps) - Math.max(0, r-eps));\n  return { v, dv };\n}\nfunction oldCurve(r) {\n  if (r <= dz) return 0; if (r >= 1) return 1;\n  const u = (r - dz) / (1 - dz);\n  const s = u*u*(3-2*u);\n  return Math.pow(u, 1.35) * (0.85 + 0.15 * s);\n}\n// Candidate 1: smoothstep(u^p) with p=1.35\nfunction smPow(r, p=1.35) {\n  if (r <= dz) return 0; if (r >= 1) return 1;\n  const u = (r - dz) / (1 - dz);\n  const t = Math.pow(u, p);\n  return t * t * (3 - 2 * t);\n}\n// Candidate 2: smoothstep(u) weighted with power curve? No, smoothstep(t) where t = u^p * (k + (1-k)*u)\n// Wait: what if we use a C1-continuous blend of inner low-sensitivity curve and outer boundary-easing curve?\n// E.g. t = Math.pow(u, p); h = t * t * (3 - 2 * t); blend = lerp(t, h, w) or similar?\n// Notice: if w < 1, slope at u=1 is (1-w)*p > 0; if w = 1, slope at u=1 is 0!\n// Let us check w = 0.75 or w = 1.0, or t = u^(1 + (p-1)*...) or Hermite!\nfunction smPowBlend(r, p=1.35, w=0.80) {\n  if (r <= dz) return 0; if (r >= 1) return 1;\n  const u = (r - dz) / (1 - dz);\n  const t = Math.pow(u, p);\n  const h = t * t * (3 - 2 * t);\n  return t * (1 - w) + h * w;\n}\n// Candidate 3: C1 cubic/power S-curve with inner precision k:\n// f(u) = (k * u^p) blended? Wait: what if f(u) = smoothstep(u) * (k + (1-k)*u^p)? No, at u=1 f(1)=1, f_prime(1)=0 + (1-k)*p!\n// What if f(u) = u^p * (3 - 2*u) * (k + (1-k)*...)? Wait: u^p * (3 - 2*u) has:\n// at u=0: 0, deriv 0 (if p>1). Wait: at u=1: 1*(3-2)=1! Deriv at u=1: p*1*(1) + 1*(-2) = p - 2!\n// For p=2: f(u) = u^2*(3-2u) IS smoothstep(u)!\n// For p > 2 (say p = 2 + (responseCurve - 1)): Wait: at p=2.35, deriv at u=1 is 0.35! Wait: is it monotonic on [0,1]?\n// Let us check deriv of u^p*(3-2u): u^(p-1)*(3p - 2(p+1)u). At u=1, 3p - 2p - 2 = p - 2!\n// So for ANY p >= 2, u^