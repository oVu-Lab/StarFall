    combined_output {
      full: "r    | smPow(1.35)      | invPow(p=2.2,q=2)| invPow(p=2.4,q=2)| invPow(p=2.5,q=2.2)0.00 | 0.0000 (0.00)    | 0.0000 (0.00)    | 0.0000 (0.00)    | 0.0000 (0.00)0.06 | 0.0000 (0.00)    | 0.0000 (0.00)    | 0.0000 (0.00)    | 0.0000 (0.00)0.15 | 0.0044 (0.13)    | 0.0097 (0.24)    | 0.0061 (0.16)    | 0.0053 (0.15)0.25 | 0.0316 (0.43)    | 0.0502 (0.58)    | 0.0365 (0.46)    | 0.0342 (0.45)0.35 | 0.0938 (0.82)    | 0.1262 (0.94)    | 0.1001 (0.82)    | 0.0976 (0.83)0.50 | 0.2628 (1.43)    | 0.3073 (1.46)    | 0.2660 (1.39)    | 0.2689 (1.45)0.65 | 0.5127 (1.85)    | 0.5527 (1.76)    | 0.5099 (1.82)    | 0.5240 (1.89)0.75 | 0.7006 (1.86)    | 0.7288 (1.72)    | 0.6957 (1.85)    | 0.7154 (1.88)0.85 | 0.8720 (1.50)    | 0.8854 (1.35)    | 0.8682 (1.52)    | 0.8855 (1.44)0.95 | 0.9834 (0.64)    | 0.9853 (0.57)    | 0.9827 (0.67)    | 0.9876 (0.52)1.00 | 1.0000 (0.01)    | 1.0000 (0.01)    | 1.0000 (0.01)    | 1.0000 (0.00)"
    }
    command_line: "node -e \'\nconst dz = 0.06;\nfunction evalCurve(fn, r) {\n  const eps = 0.001;\n  const v = fn(r);\n  const dv = (fn(Math.min(1, r+eps)) - fn(Math.max(0, r-eps))) / (Math.min(1, r+eps) - Math.max(0, r-eps));\n  return { v, dv };\n}\nfunction newCurve(r, p=1.35, k=0.85) {\n  if (r <= dz) return 0; if (r >= 1) return 1;\n  const u = (r - dz) / (1 - dz);\n  const t = Math.pow(u, p);\n  const s = t * t * (3 - 2 * t);\n  return s * (k + (1 - k) * s);\n}\n// Compare with p=1.0, p=1.35, p=1.8, p=2.4\n// Also compare with a gentler S-curve: e.g. s = smoothstep(u), and blend? No, what about u^p * (1 - (1-u)^2)? No, that has non-zero slope at 1? Wait:\n// Let g(u) = 1 - (1 - u^p)^q? Check g_prime(1): if q > 1, (1 - u^p)^(q-1) -> 0 at u=1!\n// Wait! Let us check g(u) = 1 - Math.pow(1 - Math.pow(u, p), q) with q = 2.0!\n// At u near 0: 1 - (1 - u^p)^2 \342\211\210 2 * u^p! So near 0 it behaves like u^p (not u^(2p))!\n// At u=1: g(1) = 1, g_prime(1) = 2 * p * u^(p-1) * (1 - u^p) = 0!!\n// WAIT A SECOND! Check that!\nfunction invPow(r, p=2.2, q=2.0, k=0.85) {\n  if (r <= dz) return 0; if (r >= 1) return 1;\n  const u = (r - dz) / (1 - dz);\n  const s = 1 - Math.pow(1 - Math.pow(u, p), q);\n  return s * (k + (1 - k) * s);\n}\nconst pts = [0, 0.06, 0.15, 0.25, 0.35, 0.50, 0.65, 0.75, 0.85, 0.95, 1.00];\nconsole.log(\"r    | smPow(1.35)      | invPow(p=2.2,q=2)| invPow(p=2.4,q=2)| invPow(p=2.5,q=2.2)\");\nfor (const r of pts) {\n  const a = evalCurve((x)=>newCurve(x, 1.35, 0.85), r);\n  const b = evalCurve((x)=>invPow(x, 2.2, 2.0, 0.85), r);\n  const c = evalCurve((x)=>invPow(x, 2.4, 2.0, 0.85), r);\n  const d = evalCurve((x)=>invPow(x, 2.5, 2.2, 0.85), r);\n  console.log(\n    r.toFixed(2).padEnd(5) + \"| \" +\n    `${a.v.toFixed(4)} (${a.dv.toFixed(2)})`.padEnd(17) + \"| \" +\n    `${b.v.toFixed(4)} (${b.dv.toFixed(2)})`.padEnd(17) + \"| \" +\n    `${c.v.toFixed(4)} (${c.dv.toFixed(2)})`.padEnd(17) + \"| \" +\n    `${d.v.toFixed(4)} (${d.dv.toFixed(2)})`\n  );\n}\n\'"
    proposed_command_line: "node -e \'\nconst dz = 0.06;\nfunction evalCurve(fn, r) {\n  const eps = 0.001;\n  const v = fn(r);\n  const dv = (fn(Math.min(1, r+eps)) - fn(Math.max(0, r-eps))) / (Math.min(1, r+eps) - Math.max(0, r-eps));\n  return { v, dv };\n}\nfunction newCurve(r, p=1.35, k=0.85) {\n  if (r <= dz) return 0; if (r >= 1) return 1;\n  const u = (r - dz) / (1 - dz);\n  const t = Math.pow(u, p);\n  const s = t * t * (3 - 2 * t);\n  return s * (k + (1 - k) * s);\n}\n// Compare with p=1.0, p=1.35, p=1.8, p=2.4\n// Also compare with a gentler S-curve: e.g. s = smoothstep(u), and blend? No, what about u^p * (1 - (1-u)^2)? No, that has non-zero slope at 1? Wait:\n// Let g(u) = 1 - (1 - u^p)^q? Check g_prime(1): if q > 1, (1 - u^p)^(q-1) -> 0 at u=1!\n// Wait! Let us check g(u) = 1 - Math.pow(1 - Math.pow(u, p), q) with q = 2.0!\n// At u near 0: 1 - (1 - u^p)^2 \342\211\210 2 * u^p! So near 0 it behaves like u^p (not u^(2p))!\n// At u=1: g(1) = 1, g_prime(1) = 2 * p * u^(p-1) * (1 - u^p) = 0!!\n// WAIT A SECOND! Check that!\nfunction invPow(r, p=2.2, q=2.0, k=0.85) {\n  if (r <= dz) return 0; if (r >= 1) return 1;\n  const u = (r - dz) / (1 - dz);\n  const s = 1 - Math.pow(1 - Math.pow(u, p), q);\n  return s * (k + (1 - k) * s);\n}\nconst pts = [0, 0.06, 0.15, 0.25, 0.35, 0.50, 0.65, 0.75, 0.85, 0.95, 1.00];\nconsole.log(\"r    | smPow(1.35)      | invPow(p=2.2,q=2)| invPow(p=2.4,q=2)| invPow(p=2.5,q=2.2)\");\nfor (const r of pts) {\n  const a = evalCurve((x)=>newCurve(x, 1.35, 0.85), r);\n  const b = evalCurve((x)=>invPow(x, 2.2, 2.0, 0.85), r);\n  const c = evalCurve((x)=>invPow(x, 2.4, 2.0, 0.85), r);\n  const d = evalCurve((x)=>invPow(x, 2.5, 2.2, 0.85), r);\n  console.log(\n    r.toFixed(2).padEnd(5) + \"| \" +\n    `${a.v.toFixed(4)} (${a.dv.toFixed(2)})`.padEnd(17) + \"| \" +\n    `${b.v.toFixed(4)} (${b.dv.toFixed(2)})`.padEnd(17) + \"| \" +\n    `${c.v.toFixed(4)} (${c.dv.toFixed(2)})`.padEnd(17) + \"| \" +\n    `${d.v.toFixed(4)} (${d.dv.toFixed(2)})`\n  );\n}\n\'"
