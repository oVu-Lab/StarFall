      thinking_signature: "\022\232\a\n\227\a\001i\024}\023\206\307\v\367\315c)\340U\247\2204k\374*rsm\017\023\315dk\356\324y\003m\354,\355y\t\371\324}\242\206\355\f\356\362\265\2545\257\334\253\330X\206\360\276\0035T\f\027\242\354\231\372\331\261{\001\r\234G\331\277\241\325\351\327pJ*\330A\211\307fHP8\223\341\227/\f\325\000\f\nO\\\342\360\\\342\304\016\252d5a\033\271\372\3776aZ\235V\321\267\2100\214\177w\021 U\t\362\\\016kC\334\376\034\214\353\031\3536=5\325\330%\300\f\024I3\246\353]\240\332#\215\241\270\3753\253-\226\275\270\246\363]\243\344\024\323\036(C\272n\366\017\361~/3\226\345x<H\367\302\003\3472q3\b\227h\'\355\216F6\021(;U\001,\273.\251\004\b\340\034^;\"\243d\330\220i\236r;\267\275\231\b\207S\330\234d\273\340\241p\345\327\341\275v}\272\r\'\217\276\373D\027\205\3628r\205\273\352e\301\331\024\306Q\273\036\237\310\305m\256\376\341*:\223\203\234B[\324\245\263\263\1778\rJ\371\307\\ >\264\373\372j\334\336Vz\024\316\037\343\322e\r6\370\200_\016\002;\264\036\244\334\034\224;\244\031C\t\362\270\247Zs)W\267H\323\343\005\025\334E\260T\323\341\333\004V\304\232\262x\333\026=\3448\243}\006\341\"\361\264$\b\'+\274e;\227\"\021\251E\021\243\336]\236R\a\021\314N\267r\224x\252\035\237g^\305\304\006V\321\r\366\350\211d\035\034\315\022+\353\n\026\2523R_\036\266\305\252\251T\270\236\273\211Z\006\"\274\365d]\222n\206\272=\230\bx\264\341\341\205\216!\343\202\271\361D\033\302\323\335\326\253\321\362\021[\264k\371\342\362-e\260=\"\210\310!8\033\034Qd\336\a\361\005\340x\005\306O\313\a\247\n\020\004\2648\v\224\'\323\036!^U\222\'8\360\330_\\\330G+\302\220\257\01756B\327\320\364\017=\270\275\003\374&7\030\020\0302\346\246\n\302\336D\326\257\0019\200\006\335\310g\262N\210\207\035\206\r\303i\346\240\016\f\300\022\"^\352:\344\253]\327\027f\272`\251F3\222b+\210\022^\227\362k-\337\225\204R\222RzY\234\344\350r\304\211\346q\t\225i\361Sb\273\310\n\260\330\371G\355J,\272(_;%\b\261x\247\270\365\016\v<\301\333=\312\205m<.\310\205\316^\245\313\247\365\273`\304\307\246;\344Z\253\313\243\326\224:W\27