      thinking_signature: "\022\206\004\n\203\004\001i\024}\023\237*\251BH,\230\277\251O\261\220\tH1\357\304~p\003Y\365wo\351\2717A\225\225\267\254\275^\313\350\032\362a\235\376\253(\355\241.0\213PI\351\237\337L\372\355_\320\241\244v\3616\326\374,\307\223\003\362N\300D\277A\210\241l\234\205c\210 \036\030i\361\212\027n\003%\304\307Ez\265\200\020[MA\332\301?\307\211\374\016\215\367\240M\001=\177x\376\227\334\212x?\343[\325\272\022;\032D\360\246\243\006\0008n_\246_\320\235\207\236\250\253 i\323\366\a\371\367\336\032\373@\241\004\302$;\320\\0\225,\327b\325\020g\251\313\337x\005\226\345\005\252\037\301;\316P\243\215\323H\223\326&\376\241\220\332\334\342\376)\027]\352\266b\362\340\213\346U\361\303E\341BL\373\301\340\204\253\205N\a\321CK\255/\203\224v\353\264\035\267E\261P\356\017jQ\327]\316\312\254\332\214\320\210P\026\b$$\223r{\210\204\213G\371\nz\3533Bg\321\037?\256\030Z\304\'\370\207~G\201\335\356\371t\351\337%t9\361\'\256XF\272\237%@\366q\254\022J\361\327_(\266\251\200\355\327\\;]v\240koG\001\373\224@\213\026y~4OB\253\273\204\357Y\353\344,\224D\355/\357]\017\252+\017\323\362o\016\222\233\326\v+\345\325\2162\355\273\006DPC\365\003\223HT\201\320:\226S\313\v\263q\366i\326]\317\036!0/\372\300\020\334\226 \360\302\375\221|\361\033N\232\0231\251\221\263\303\367\274\037\343\035\'\022\337\231\220\240\223\025S\234\274\'\255\001\274\327\276\215P\346\224br\025\tS\312\202h\r\206\357\344\333\372\207\"\r\356\344\034.\205,#\313\302j%\277\034\203\232\000\371\251\275t\277\020\207\263\301*\245\245\222a\276\256n#]\021\362\344\222\024o\214\235\005\201I\320D\346"
