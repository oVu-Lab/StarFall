    command_line: "npx tsx -e \"\nimport {\n  evaluateResponseCurveScalar,\n  evaluateVirtualJoystick,\n  computeRoundedRectBoundary,\n  clampToRoundedRect,\n} from \'./src/engine/AimBoundary.ts\';\nimport { STEERING_CONFIG } from \'./src/config/steering.ts\';\n\nconst pts = [0, 0.06, 0.15, 0.25, 0.50, 0.75, 0.85, 0.95, 0.999, 1.0, 1.2];\nconsole.log(\'=== evaluateResponseCurveScalar (default config) ===\');\nfor (const r of pts) {\n  const out = evaluateResponseCurveScalar(r);\n  console.log(\\`r=\\${r.toFixed(3)} -> \\${out.toFixed(6)}\\`);\n}\n\n// Monotonicity & C1 continuity check across 10000 samples\nlet prev = -1;\nlet maxJump = 0;\nfor (let i = 0; i <= 10000; i++) {\n  const r = (i / 10000) * 1.25;\n  const val = evaluateResponseCurveScalar(r);\n  if (val < prev - 1e-12) throw new Error(\\`Non-monotonic at r=\\${r}: \\${val} < \\${prev}\\`);\n  if (i > 0) maxJump = Math.max(maxJump, Math.abs(val - prev));\n  prev = val;\n}\nconsole.log(\'Monotonicity check passed. Max step across dr=0.000125:\', maxJump.toFixed(6));\n\n// Verify rounded-rect boundary clamping + evaluateVirtualJoystick continuity at boundary crossing\nconst b = computeRoundedRectBoundary(1280, 720, STEERING_CONFIG.joystickRadius);\nfor (const angleDeg of [0, 22.5, 45, 67.5, 90]) {\n  const rad = (angleDeg * Math.PI) / 180;\n  const ux = Math.cos(rad);\n  const uy = Math.sin(rad);\n  // Step across boundary r=0.95 -> 0.99 -> 1.00 -> 1.15\n  const outs = [0.95, 0.99, 1.00, 1.15].map((scale) => {\n    const c = clampToRoundedRect(ux * b.halfW * scale * 1.2, uy * b.halfH * scale * 1.2, b);\n    const ev = evaluateVirtualJoystick(c.clampedX, c.clampedY, b);\n    return \\`r=\\${ev.radialMagnitude.toFixed(3)}->mag=\\${ev.steeringMagnitude.toFixed(4)}\\`;\n  });\n  console.log(\\`angle=\\${angleDeg}\302\260: \\${outs.join(\', \')}\\`);\n}\n\" && which chromium google-chrome playwright 2>&1 || true"
