    command_line: "NODE_PATH=/usr/local/share/bun-global/node_modules bun -e \'\nimport { chromium } from \"playwright\";\n\nconst browser = await chromium.launch({\n  executablePath: \"/ms-playwright/chromium_headless_shell-1247/chrome-headless-shell-linux64/chrome-headless-shell\",\n  args: [\n    \"--use-gl=angle\",\n    \"--use-angle=swiftshader\",\n    \"--enable-webgl\",\n    \"--ignore-gpu-blocklist\",\n    \"--no-sandbox\",\n  ],\n});\n\nconst page = await browser.newPage({ viewport: { width: 1280, height: 720 } });\nawait page.goto(\"http://localhost:3000\", { waitUntil: \"networkidle\" });\n\nawait page.click(\"button:has-text(\\\"Campaign Missions\\\")\");\nawait page.waitForSelector(\"button:has-text(\\\"Launch\\\")\", { timeout: 10000 });\nawait page.click(\"button:has-text(\\\"Launch\\\")\");\nawait page.waitForSelector(\"canvas\", { timeout: 10000 });\nawait page.waitForTimeout(800);\n\nawait page.evaluate(() => {\n  const canvas = document.querySelector(\"canvas\");\n  Object.defineProperty(document, \"pointerLockElement\", {\n    configurable: true,\n    get: () => canvas,\n  });\n  document.dispatchEvent(new Event(\"pointerlockchange\"));\n});\nawait page.waitForTimeout(150);\n\nconst results = await page.evaluate(async () => {\n  const debug = (window as any).__STARFALL_DEBUG__;\n  const fc = debug.flightController;\n  const tel = debug.telemetry;\n\n  const waitFrame = () => new Promise<void>((r) => requestAnimationFrame(() => r()));\n  const sendMove = (dx: number, dy: number) => {\n    window.dispatchEvent(\n      new MouseEvent(\"mousemove\", {\n        movementX: dx,\n        movementY: dy,\n        bubbles: true,\n      })\n    );\n  };\n\n  fc.reset();\n  await waitFrame();\n\n  // Acceptance Tests 1, 2, 3: Hold continuous mouse movement right (+7 px/frame = ~420 px/s sustainable hand glide)\n  // for 120 frames (~2.0 seconds). Reticle reaches 192px boundary at frame ~28 and stays clamped for 92+ more frames.\n  let frameReachedRightBoundary = -1;\n  let yawAtBoundary = 0;\n  let minAbsYawRateBeforeBoundary = Infinity;\n  let minAbsYawRateAfterBoundary = Infinity;\n  let maxReticleNormX = 0;\n  let stalledFramesAfterBoundary = 0;\n\n  for (let i = 1; i <= 120; i++) {\n    sendMove(7, 0);\n    await waitFrame();\n    const normX = fc.reticlePosition.normalizedX;\n    if (normX > maxReticleNormX) maxReticleNormX = normX;\n    const absYawVel = Math.abs(fc.yawVelocity);\n\n    if (frameReachedRightBoundary === -1 && normX >= 0.999) {\n      frameReachedRightBoundary = i;\n      yawAtBoundary = tel.headingDeg;\n    }\n\n    if (frameReachedRightBoundary === -1) {\n      if (i > 2 && absYawVel < minAbsYawRateBeforeBoundary) minAbsYawRateBeforeBoundary = absYawVel;\n    } else {\n      if (absYawVel < minAbsYawRateAfterBoundary) minAbsYawRateAfterBoundary = absYawVel;\n      if (absYawVel < 0.05) stalledFramesAfterBoundary++;\n    }\n  }\n\n  const stateAfterContinuousRight = {\n    frameReachedRightBoundary,\n    yawAtBoundary: Number(yawAtBoundary.toFixed(2)),\n    headingAfter120Frames: Number(tel.headingDeg.toFixed(2)),\n    yawVelocityAtFrame120: Number(fc.yawVelocity.toFixed(4)),\n    steeringDemandYawAtFrame120: Number(fc.steeringDemand.yaw.toFixed(4)),\n    reticleNormXAtFrame120: Number(fc.reticlePosition.normalizedX.toFixed(4)),\n    maxReticleNormX: Number(maxReticleNormX.toFixed(4)),\n    minAbsYawRateBeforeBoundary: Number(minAbsYawRateBeforeBoundary.toFixed(4)),\n    minAbsYawRateAfterBoundary: Number(minAbsYawRateAfterBoundary.toFixed(4)),\n    stalledFramesAfterBoundary,\n  };\n\n  // Acceptance Tests 4 & 5: Reverse mouse direction (-7 px/frame left) without lifting or repositioning\n  sendMove(-7, 0);\n  await waitFrame();\n  const firstReverseFrame = {\n    yawVelocityFrame1: Number(fc.yawVelocity.toFixed(4)),\n    steeringDemandYawFrame1: Number(fc.steeringDemand.yaw.toFixed(4)),\n    reticleNormXFrame1: Number(fc.reticlePosition.normalizedX.toFixed(4)),\n  };\n\n  for (let i = 0; i < 45; i++) {\n    sendMove(-7, 0);\n    await waitFrame();\n  }\n  const afterContinuousLeft = {\n    headingAfterLeft: Number(tel.headingDeg.toFixed(2)),\n    yawVelocity: Number(fc.yawVelocity.toFixed(4)),\n    reticleNormX: Number(fc.reticlePosition.normalizedX.toFixed(4)),\n  };\n\n  // Acceptance Test 6 & 7: Repeat vertically for pitch (hold continuous upward mouse movement -7 px/frame for 90 frames,\n  // reach top boundary, continue turning beyond boundary, then reverse downward +7 px/frame)\n  fc.reset();\n  await waitFrame();\n  let frameReachedTopBoundary = -1;\n  let pitchDegAtTopBoundary = 0;\n  let minAbsPitchRateAfterBoundary = Infinity;\n  let pitchStalledFramesAfterBoundary = 0;\n\n  for (let i = 1; i <= 90; i++) {\n    sendMove(0, -7);\n    await waitFrame();\n    const normY = fc.reticlePosition.normalizedY;\n    const absPitchVel = Math.abs(fc.pitchVelocity);\n    if (frameReachedTopBoundary === -1 && normY <= -0.999) {\n      frameReachedTopBoundary = i;\n      pitchDegAtTopBoundary = tel.pitchDeg;\n    } else if (frameReachedTopBoundary !== -1) {\n      if (absPitchVel < minAbsPitchRateAfterBoundary) minAbsPitchRateAfterBoundary = absPitchVel;\n      if (absPitchVel < 0.05) pitchStalledFramesAfterBoundary++;\n    }\n  }\n\n  const stateAfterContinuousPitchUp = {\n    frameReachedTopBoundary,\n    pitchDegAtTopBoundary: Number(pitchDegAtTopBoundary.toFixed(2)),\n    pitchDegAfter90Frames: Number(tel.pitchDeg.toFixed(2)),\n    pitchVelocityAtFrame90: Number(fc.pitchVelocity.toFixed(4)),\n    steeringDemandPitchAtFrame90: Number(fc.steeringDemand.pitch.toFixed(4)),\n    reticleNormYAtFrame90: Number(fc.reticlePosition.normalizedY.toFixed(4)),\n    minAbsPitchRateAfterBoundary: Number(minAbsPitchRateAfterBoundary.toFixed(4)),\n    pitchStalledFramesAfterBoundary,\n  };\n\n  // Reverse pitch direction downward (+7 px/frame) immediately\n  sendMove(0, 7);\n  await waitFrame();\n  const firstPitchReverseFrame = {\n    pitchVelocityFrame1: Number(fc.pitchVelocity.toFixed(4)),\n    steeringDemandPitchFrame1: Number(fc.steeringDemand.pitch.toFixed(4)),\n    reticleNormYFrame1: Number(fc.reticlePosition.normalizedY.toFixed(4)),\n  };\n\n  // Stop mouse completely and verify zero drift after 4 frames\n  for (let i = 0; i < 4; i++) {\n    await waitFrame();\n  }\n  const afterMouseStop = {\n    yawVelocity: Number(fc.yawVelocity.toFixed(4)),\n    pitchVelocity: Number(fc.pitchVelocity.toFixed(4)),\n    steeringDemandYaw: Number(fc.steeringDemand.yaw.toFixed(4)),\n    steeringDemandPitch: Number(fc.steeringDemand.pitch.toFixed(4)),\n    reticleNormYHeld: Number(fc.reticlePosition.normalizedY.toFixed(4)),\n  };\n\n  return {\n    stateAfterContinuousRight,\n    firstReverseFrame,\n    afterContinuousLeft,\n    stateAfterContinuousPitchUp,\n    firstPitchReverseFrame,\n    afterMouseStop,\n  };\n});\n\nconsole.log(JSON.stringify(results, null, 2));\nawait browser.close();\n\'"
