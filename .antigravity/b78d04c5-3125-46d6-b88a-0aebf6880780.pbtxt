        use_fast_apply: true
        replacement_chunks {
          target_content: "  /**\n   * Returns unit world-space firing direction with subtle forward gimbal convergence\n   * toward the active bounded virtual joystick offset.\n   */\n  public getAimDirectionWorld(out: THREE.Vector3): THREE.Vector3 {\n    const gimbalYaw = THREE.MathUtils.clamp(this.aimCursorX, -1, 1) * GIMBAL_MAX_YAW_RAD;\n    const gimbalPitch = THREE.MathUtils.clamp(-this.aimCursorY, -1, 1) * GIMBAL_MAX_PITCH_RAD;\n    _gimbalDirLocal.set(Math.sin(gimbalYaw), Math.sin(gimbalPitch), -1).normalize();\n    out.copy(_gimbalDirLocal).applyQuaternion(this.quaternion).normalize();\n    return out;\n  }"
          replacement_content: "  /**\n   * Returns unit world-space firing direction.\n   * In `direct-nonlinear` mode, aligns directly with the ship\'s true forward boresight so stopping\n   * mouse movement never produces velocity-gimbal snap-back off the target.\n   * In `virtual-joystick-baseline` mode, preserves the baseline gimbal convergence offset.\n   */\n  public getAimDirectionWorld(out: THREE.Vector3): THREE.Vector3 {\n    if (this.steeringMode === \'direct-nonlinear\') {\n      out.copy(_FORWARD_LOCAL).applyQuaternion(this.quaternion).normalize();\n      return out;\n    }\n    const gimbalYaw = THREE.MathUtils.clamp(this.aimCursorX, -1, 1) * GIMBAL_MAX_YAW_RAD;\n    const gimbalPitch = THREE.MathUtils.clamp(-this.aimCursorY, -1, 1) * GIMBAL_MAX_PITCH_RAD;\n    _gimbalDirLocal.set(Math.sin(gimbalYaw), Math.sin(gimbalPitch), -1).normalize();\n    out.copy(_gimbalDirLocal).applyQuaternion(this.quaternion).normalize();\n    return out;\n  }"
          start_line: 329
          end_line: 341
        }
        replacement_chunks {
          target_content: "      const reticleAlpha = 1 - Math.exp(-18.0 * safeDt);\n      this.joystickX += (desiredReticleX - this.joystickX) * reticleAlpha;\n      this.joystickY += (desiredReticleY - this.joystickY) * reticleAlpha;\n      if (desiredReticleX === 0 && Math.abs(this.joystickX) < 0.25) this.joystickX = 0;\n      if (desiredReticleY === 0 && Math.abs(this.joystickY) < 0.25) this.joystickY = 0;"
          replacement_content: "      const isReticleStopping = desiredReticleX === 0 && desiredReticleY === 0;\n      const reticleRate = isReticleStopping ? 42.0 : 22.0;\n      const reticleAlpha = 1 - Math.exp(-reticleRate * safeDt);\n      this.joystickX += (desiredReticleX - this.joystickX) * reticleAlpha;\n      this.joystickY += (desiredReticleY - this.joystickY) * reticleAlpha;\n      if (desiredReticleX === 0 && Math.abs(this.joystickX) < 0.5) this.joystickX = 0;\n      if (desiredReticleY === 0 && Math.abs(this.joystickY) < 0.5) this.joystickY = 0;"
          start_line: 482
          end_line: 490
        }
      }
    }
