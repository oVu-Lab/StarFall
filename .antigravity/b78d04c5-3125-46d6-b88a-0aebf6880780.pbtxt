yawVelocity.toFixed(4));\n  stepFrame(8, 0);\n  const yawRateAfterSingleFrameCoalesceGap = Number(fc.yawVelocity.toFixed(4));\n\n  // Mouse stop test (4 frames of zero input -> exact 0 rotation)\n  for (let i = 0; i < 4; i++) stepFrame(0, 0);\n  const afterMouseStop = {\n    yawVelocityRadS: Number(fc.yawVelocity.toFixed(4)),\n    pitchVelocityRadS: Number(fc.pitchVelocity.toFixed(4)),\n    steeringDemandYaw: Number(fc.steeringDemand.yaw.toFixed(4)),\n    steeringDemandPitch: Number(fc.steeringDemand.pitch.toFixed(4)),\n    reticleNormXHeld: Number(fc.reticlePosition.normalizedX.toFixed(4)),\n  };\n\n  return {\n    continuousRight,\n    firstYawReverseFrame,\n    afterContinuousLeft,\n    continuousPitchUp,\n    firstPitchReverseFrame,\n    coalescingTest: {\n      yawRateDuringSingleFrameCoalesceGap,\n      yawRateAfterSingleFrameCoalesceGap,\n    },\n    afterMouseStop,\n  };\n});\n\nconsole.log(JSON.stringify(results, null, 2));\nawait browser.close();\n\'"
