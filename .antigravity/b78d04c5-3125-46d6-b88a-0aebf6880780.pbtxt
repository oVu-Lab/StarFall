      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Remove automatic exponential self-centering decay while Pointer Lock is active in InputManager.ts\", \"EndLine\":326, \"Instruction\":\"Remove stickX/stickY halfDecay multiplication while lockOwned is true in src/engine/InputManager.ts\", \"ReplacementContent\":\"    const halfDecay = Math.exp(-recentreRate * safeDt * 0.5);\\n    const effectiveSensitivity = STEERING_CONFIG.baseMouseSensitivity * mouseSens;\\n\\n    if (lockOwned) {\\n      this.stickX = clamp(\\n        this.stickX + rawDeltaX * effectiveSensitivity,\\n        -maxDeflection,\\n        maxDeflection,\\n      );\\n      this.stickY = clamp(\\n        this.stickY + rawDeltaY * effectiveSensitivity,\\n        -maxDeflection,\\n        maxDeflection,\\n      );\\n    } else {\\n      // Decay cleanly back to center if Pointer Lock is not held\\n      const fullDecay = halfDecay * halfDecay;\\n      this.stickX *= fullDecay;\\n      this.stickY *= fullDecay;\\n    }\", \"StartLine\":297, \"TargetContent\":\"    // Symmetric half-step exponential self-centering around relative mouse input\\n    // ensures frame-rate-independent deflection & decay from 30 FPS to 240 FPS.\\n    const halfDecay = Math.exp(-recentreRate * safeDt * 0.5);\\n    const effectiveSensitivity = STEERING_CONFIG.baseMouseSensitivity * mouseSens;\\n\\n    if (lockOwned) {\\n      this.stickX *= halfDecay;\\n      this.stickY *= halfDecay;\\n\\n      this.stickX = clamp(\\n        this.stickX + rawDeltaX * effectiveSensitivity,\\n        -maxDeflection,\\n        maxDeflection,\\n      );\\n      this.stickY = clamp(\\n        this.stickY + rawDeltaY * effectiveSensitivity,\\n        -maxDeflection,\\n        maxDeflection,\\n      );\\n\\n      this.stickX *= halfDecay;\\n      this.stickY *= halfDecay;\\n    } else {\\n      // Decay cleanly back to center if Pointer Lock is not held\\n      const fullDecay = halfDecay * halfDecay;\\n      this.stickX *= fullDecay;\\n      this.stickY *= fullDecay;\\n    }\", \"TargetFile\":\"/src/engine/InputManager.ts\", \"toolAction\":\"Removing active-lock self-centering decay in InputManager.ts\", \"toolSummary\":\"Update InputManager.ts\"}"
      original_name: "replace_file_content"
    }
