      text: "Here is the full initial file tree for the application:\n/.aistudio/artifacts/brain/49f9382e-a5a8-4ac9-ad38-8127f285cebb/.tempmediaStorage/media_1795108809832_4236b7d6.jpg\n/.aistudio/artifacts/brain/49f9382e-a5a8-4ac9-ad38-8127f285cebb/.tempmediaStorage/media_1795108810634_725d0a57.jpg\n/.aistudio/artifacts/brain/49f9382e-a5a8-4ac9-ad38-8127f285cebb/.tempmediaStorage/media_1795108810965_5b04f9fc.jpg\n/.env.example\n/.gitignore\n/bun.lock\n/index.html\n/metadata.json\n/package.json\n/src/App.tsx\n/src/audio/AudioManager.ts\n/src/components/FlightHUD.tsx\n/src/components/HangarView.tsx\n/src/components/LoadingScreen.tsx\n/src/components/MainMenu.tsx\n/src/components/MissionResultsOverlay.tsx\n/src/components/MissionSelectView.tsx\n/src/components/PauseOverlay.tsx\n/src/components/SettingsPanel.tsx\n/src/config/botPersonalities.ts\n/src/config/difficulty.ts\n/src/config/graphics.ts\n/src/config/missions.ts\n/src/config/ships.ts\n/src/config/steering.ts\n/src/config/weapons.ts\n/src/engine/AimBoundary.ts\n/src/engine/AssetManager.ts\n/src/engine/CameraController.ts\n/src/engine/FlightController.ts\n/src/engine/InputManager.ts\n/src/engine/MouseResponseCurve.ts\n/src/engine/combat/CollisionSystem.ts\n/src/engine/combat/CombatManager.ts\n/src/engine/combat/EnemyAIController.ts\n/src/engine/combat/HealthSystem.ts\n/src/engine/combat/ProjectilePool.ts\n/src/engine/mission/CampaignProgressStore.ts\n/src/engine/mission/MissionManager.ts\n/src/engine/mission/RankCalculator.ts\n/src/engine/threeCompat.js\n/src/index.css\n/src/main.tsx\n/src/scene/CombatVFX.tsx\n/src/scene/EnemyShipRenderer.tsx\n/src/scene/FlightCanvas.tsx\n/src/scene/GameScene.tsx\n/src/scene/SpaceEnvironment.tsx\n/src/scene/SpeedLinesVFX.tsx\n/src/scene/shipGeometry.ts\n/src/types/combat.ts\n/src/types/game.ts\n/src/types/mission.ts\n/tsconfig.json\n/vite.config.ts"
