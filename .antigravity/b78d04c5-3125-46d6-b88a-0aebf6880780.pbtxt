              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  /**"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   * Returns unit world-space firing direction with subtle forward gimbal convergence"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "   * toward the active bounded virtual joystick offset."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "   * Returns unit world-space firing direction."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   * In `direct-nonlinear` mode, aligns directly with the ship\'s true forward boresight so stopping"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   * mouse movement never produces velocity-gimbal snap-back off the target."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   * In `virtual-joystick-baseline` mode, preserves the baseline gimbal convergence offset."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  public getAimDirectionWorld(out: THREE.Vector3): THREE.Vector3 {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (this.steeringMode === \'direct-nonlinear\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      out.copy(_FORWARD_LOCAL).applyQuaternion(this.quaternion).normalize();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return out;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const gimbalYaw = THREE.MathUtils.clamp(this.aimCursorX, -1, 1) * GIMBAL_MAX_YAW_RAD;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const gimbalPitch = THREE.MathUtils.clamp(-this.aimCursorY, -1, 1) * GIMBAL_MAX_PITCH_RAD;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    _gimbalDirLocal.set(Math.sin(gimbalYaw), Math.sin(gimbalPitch), -1).normalize();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    out.copy(_gimbalDirLocal).applyQuaternion(this.quaternion).normalize();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    return out;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  /**"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   * Computes the 3D world-space convergence point along the player\'s firing ray."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  public getAimTargetPoint(out: THREE.Vector3, distance: number): THREE.Vector3 {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    this.getAimDirectionWorld(out);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    out.multiplyScalar(distance).add(this.position);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    return out;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  /**"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   * Advances arcade flight simulation by delta time `dt` (seconds) and writes live telemetry."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   * Uses live game viewport dimensions (viewportWidth x viewportHeight) for joystick boundary geometry."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  public update("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    dt: number,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    input: InputSnapshot,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    settings: GameSettings,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    telemetry: FlightTelemetry,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    viewportWidth = typeof window !== \'undefined\' ? window.innerWidth : 1280,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    viewportHeight = typeof window !== \'undefined\' ? window.innerHeight : 720,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
