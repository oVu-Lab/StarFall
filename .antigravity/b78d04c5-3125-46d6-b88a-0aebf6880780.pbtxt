            }
            lines {
              text: "      //    - Zero virtual-joystick accumulation: stopping mouse input immediately sets"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      //      target turn rates to zero and halts ship rotation with zero drift."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const yawClassScale = profile.yawSpeed / STEERING_CONFIG.referenceInterceptorYawSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const pitchClassScale = profile.pitchSpeed / STEERING_CONFIG.referenceInterceptorPitchSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const effectiveMaxYaw ="
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        THREE.MathUtils.clamp("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          settings.maxYawRate,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
