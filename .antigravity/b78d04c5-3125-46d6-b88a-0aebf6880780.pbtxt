ursor\\\\\\\"]\\\") as HTMLElement;\\n\\n    for (let i = 0; i < frames; i++) {\\n      if (dx !== 0 || dy !== 0) {\\n        window.dispatchEvent(new MouseEvent(\\\"mousemove\\\", { movementX: dx, movementY: dy }));\\n      }\\n      await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));\\n      await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));\\n      const f = diag.getFlight();\\n      const t = diag.getTelemetry();\\n      samples.push({\\n        frame: i + 1,\\n        joystickX: Number(f.joystickX.toFixed(2)),\\n        aimScreenX: Number(t.aimScreenX.toFixed(4)),\\n        domScreenX: Number(cursorEl?.dataset.screenX ?? 0),\\n        domZone: String(cursorEl?.dataset.steeringZone ?? \\\"\\\"),\\n        yawVelocity: Number(f.yawVelocity.toFixed(4)),\\n        headingDeg: Number(t.headingDeg.toFixed(3)),\\n      });\\n    }\\n    return samples;\\n  }, { dx, dy, frames });\\n}\\n\\n// 1. Slowly move the reticle toward the right aim boundary (halfW = 192px on 1280x720)\\n// Move +16px per step for 12 steps (total 192px)\\nconst test1 = await moveMouseFrames(16, 0, 12);\\nconsole.log(\\\"TEST 1 (Slowly move reticle to boundary):\\\", {\\n  start: test1[0],\\n  mid: test1[5],\\n  atBoundary: test1[test1.length - 1],\\n});\\n\\n// 2 & 3. Continue moving outward AFTER reaching the boundary (+20px per step for 10 steps)\\n// Verify reticle stays clamped at boundary (192px / screenX = 0.65) AND ship turning continues uninterrupted!\\nconst test2And3 = await moveMouseFrames(20, 0, 10);\\nconsole.log(\\\"TEST 2 & 3 (Continue moving outward past boundary):\\\", {\\n  firstFramePastBoundary: test2And3[0],\\n  fifthFramePastBoundary: test2And3[4],\\n  tenthFramePastBoundary: test2And3[9],\\n  uninterruptedTurningEveryFrame: test2And3.every((s) => s.yawVelocity < -0.05),\\n  clampedAtBoundaryEveryFrame: test2And3.every((s) => s.joystickX === 192 && s.aimScreenX === 0.65),\\n});\\n\\n// 4. Reverse mouse direction (-18px per step for 6 steps) and verify immediate smooth inward movement & turn reversal\\nconst test4 = await moveMouseFrames(-18, 0, 6);\\nconsole.log(\\\"TEST 4 (Reverse mouse direction from boundary):\\\", {\\n  frame1AfterReverse: test4[0],\\n  frame3AfterReverse: test4[2],\\n  frame6AfterReverse: test4[5],\\n  reticleMovedInwardImmediatelyOnFrame1: test4[0].joystickX < 192,\\n  yawReversedImmediatelyOnFrame1: test4[0].yawVelocity > 0,\\n});\\n\\n// 5. Perform a large directional turn (+32px per step for 20 steps)\\nconst test5 = await moveMouseFrames(32, 0, 20);\\nconsole.log(\\\"TEST 5 (Large directional turn):\\\", {\\n  startHeading: test5[0].headingDeg,\\n  endHeading: test5[test5.length - 1].headingDeg,\\n  peakYawVelocityRadSec: Math.min(...test5.map((s) => s.yawVelocity)),\\n  reticleClampedAtBoundary: test5[test5.length - 1].joystickX,\\n});\\n\\n// 6. Stop moving the mouse (0px for 10 steps) and verify:\\n//    - NO unwanted ship rotation drift (yawVelocity === 0, headingDeg constant)\\n//    - NO forced reticle snap/rebound back to center (joystickX stays at 192px / aimScreenX = 0.65)\\nconst test6 = await moveMouseFrames(0, 0, 10);\\nconsole.log(\\\"TEST 6 (Stop moving mouse at boundary):\\\", {\\n  frame1AfterStop: test6[0],\\n  frame10AfterStop: test6[9],\\n  zeroHeadingDrift: test6[0].headingDeg === test6[9].headingDeg,\\n  zeroYawVelocity: test6.every((s) => s.yawVelocity === 0),\\n  reticleStayedAtBoundaryWithoutRecenter: test6.every((s) => s.joystickX === 192 && s.aimScreenX === 0.65),\\n});\\n\\nawait browser.close();\\n\'\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Running live Chromium browser validation tests\", \"toolSummary\":\"Run live Chromium browser tests\"}"
            thinking_signature: "\022\311\a\n\306\a\001i\024}\023\225\302Y\340\351Q|\262\212?xP\206\231\263\337\324^\226\247\213\332\032\211\004\233\n\300\240\317\352\177\340\222Om$u\272e\373\353\274\022r\n\213\233\241\367HJX\217\223\310#\001L\373G\n\177\242\220\375V\r\b0\001/\305\236\205N\311\202\002jM\234\005h\337z\342\'\363\217xp\362\214\017t\216\006?\332\001(b\355\315\362\031\351\224KC\241Xu\253\272 \354\323.\021e\307\005}\243\374\332\354\n\2368\362a\325d\276^\306\226\351gd\357\367Y\3053\200\317\336\373h\215N%\364\325\224S\216\367\321\377\262M.1&i-\003\023\200yYW\265\b\024\316\"\200Od\207\256\364\212/L\n6/\023\304`\234\360\235\030FT\232\262/D\316uG0\3211\331\302\303*\0273\311+5\367\004\311\321n/R\377\r\203P\030MY\277^\334kz\224\035\313\342E\035\221\206L\223\273{7\317\311,\274\246\366\n\220\035\027@\222\3726b\241\276\305\234\346\f\224D\342i\201\346~\204&\205L\\\254\276&\246\200\354\301\375\236\260\336D\307\306\320\273H\023v\230\271a\303\312\236\201\311\332\354\024kf\347q\326\317\327v\270\033\342\3553D\372\200\031\027\250\231\236\031\300V\004\302v\035\276\n9\223\262\033\000nA2E\345\004\340\306\353\031\244\263\352\241\300\267\032u%\266\f-\001\236g\032\306\352\262\"\375\233\257aX\326\005\211?\267\261J\314\231\311\325\034&F8t\001\301$\352\221\235W\212\324\344G\365\351|R_\001\262sO\275\030\303\363#\336\303\246\353\215\037o\246LH\246\nB\311,<4\234\211\341\226Jjln\354\np\352X*\213\241\300X\031\373F\301\206x\326\270\277\203\303\273\253R\305Zm\377\271\"fP\034\242&E{c\021]\322J\274\365\352\326\246#2\a:\220\345\231!\333q<\215\207\257J\033\0319\2435\177k\252\031\335\326s\270\371\025\263j\277\024\372!\313m\221\006\366\245\035_\201\277\275\207\321\374\017\375\035\235\253\r\304x8%G.\002\357\222\r?\343\313\272\221\2426pK\373\037\301\353\344e\314:7\002\2633\021\022\222\214\2556<\371 XA-F\3612!\314\211@\222#,Q\223U\023\241#(\203\337\253\202,\363\201\003\203\201\0270\251\304)mF;2(f\243\2351\320W\327\020\224\231&\256I\021\376\276\325\217\263\303\310\021\213\372n\221\253\307\311\313\