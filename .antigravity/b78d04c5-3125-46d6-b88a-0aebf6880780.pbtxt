.toFixed(4)),\n    steeringDemandPitchFrame1: Number(fc.steeringDemand.pitch.toFixed(4)),\n    reticleNormYFrame1: Number(fc.reticlePosition.normalizedY.toFixed(4)),\n  };\n\n  // Test single-frame browser event-coalescing gap during continuous movement at boundary\n  fc.reset();\n  await waitFrame();\n  for (let i = 0; i < 40; i++) {\n    sendMove(8, 0);\n    await waitFrame();\n  }\n  // 1 frame without a mousemove event (coalescing gap)\n  await waitFrame();\n  const yawRateDuringSingleFrameCoalesceGap = Number(fc.yawVelocity.toFixed(4));\n  // Next frame with mousemove\n  sendMove(8, 0);\n  await waitFrame();\n  const yawRateAfterSingleFrameCoalesceGap = Number(fc.yawVelocity.toFixed(4));\n\n  // Stop mouse completely and verify zero drift after 4 frames\n  for (let i = 0; i < 4; i++) {\n    await waitFrame();\n  }\n  const afterMouseStop = {\n    yawVelocity: Number(fc.yawVelocity.toFixed(4)),\n    pitchVelocity: Number(fc.pitchVelocity.toFixed(4)),\n    steeringDemandYaw: Number(fc.steeringDemand.yaw.toFixed(4)),\n    steeringDemandPitch: Number(fc.steeringDemand.pitch.toFixed(4)),\n    reticleNormXHeld: Number(fc.reticlePosition.normalizedX.toFixed(4)),\n  };\n\n  return {\n    stateAfterContinuousRight,\n    firstReverseFrame,\n    afterContinuousLeft,\n    stateAfterContinuousPitchUp,\n    firstPitchReverseFrame,\n    coalescingTest: {\n      yawRateDuringSingleFrameCoalesceGap,\n      yawRateAfterSingleFrameCoalesceGap,\n    },\n    afterMouseStop,\n  };\n});\n\nconsole.log(JSON.stringify(results, null, 2));\nawait browser.close();\n\'"
    title: "Run Playwright acceptance tests"
    moved_to_background_at {
