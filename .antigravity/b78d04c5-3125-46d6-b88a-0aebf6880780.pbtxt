      command {
        instruction: "Update DIRECT_MOUSE_STEERING_CONFIG, BASELINE_STEERING_CONFIG, STEERING_CONFIG, and STEERING_BOUNDS in src/config/steering.ts"
        is_edit: true
        file {
          absolute_uri: "file:///src/config/steering.ts"
