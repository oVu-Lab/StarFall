            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  // Live viewport-relative rounded-rectangle boundary, clamp, and response state (zero per-frame allocs)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  public readonly aimBoundary: RoundedRectBoundary = createRoundedRectBoundary();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
