    }
    command_line: "NODE_PATH=/usr/local/share/bun-global/node_modules bun -e \'\nimport { chromium } from \"playwright\";\n\nconst browser = await chromium.launch({\n  executablePath: \"/ms-playwright/chromium_headless_shell-1247/chrome-headless-shell-linux64/chrome-headless-shell\",\n  args: [\n    \"--use-gl=angle\",\n    \"--use-angle=swiftshader\",\n    \"--enable-webgl\",\n    \"--ignore-gpu-blocklist\",\n    \"--no-sandbox\",\n  ],\n});\n\nconst page = await browser.newPage({ viewport: { width: 1280, height: 720 } });\nawait page.goto(\"http://localhost:3000\", { waitUntil: \"domcontentloaded\" });\nawait page.waitForFunction(() => Boolean((window as any).__STARFALL_DIAG__), { timeout: 8000 });\n\nconst results = await page.evaluate(() => {\n  const canvas = document.querySelector(\"canvas\");\n  const diag = (window as any).__STARFALL_DIAG__;\n  const fc = diag.getFlight();\n  const input = diag.getInput();\n  const tel = diag.getTelemetry();\n  const settings = diag.getSettings();\n\n  input.setLockTarget(canvas);\n  input.setActive(true);\n  Object.defineProperty(document, \"pointerLockElement\", {\n    configurable: true,\n    get: () => canvas,\n  });\n  document.dispatchEvent(new Event(\"pointerlockchange\"));\n\n  const stepFrame = (dx: number, dy: number, dt = 1 / 60) => {\n    if (dx !== 0 || dy !== 0) {\n      window.dispatchEvent(\n        new MouseEvent(\"mousemove\", {\n          movementX: dx,\n          movementY: dy,\n          bubbles: true,\n        })\n      );\n    }\n    const snap = input.consumeSnapshot(dt, {\n      mouseSensitivity: settings.mouseSensitivity,\n      deadzone: settings.deadzone,\n      invertY: settings.invertY,\n    });\n    fc.update(dt, snap, settings, tel, 1280, 720);\n  };\n\n  fc.reset();\n\n  // Acceptance Tests 1, 2, 3: Hold continuous rightward mouse movement (+7 px/frame = 420 px/s) for 180 frames (3.0 seconds)\n  let frameReachedRightBoundary = -1;\n  let headingAtBoundary = 0;\n  let minAbsYawRateBeforeBoundary = Infinity;\n  let minAbsYawRateAfterBoundary = Infinity;\n  let stalledFramesAfterBoundary = 0;\n\n  for (let i = 1; i <= 180; i++) {\n    stepFrame(7, 0);\n    const normX = fc.reticlePosition.normalizedX;\n    const absYawVel = Math.abs(fc.yawVelocity);\n\n    if (frameReachedRightBoundary === -1 && normX >= 0.999) {\n      frameReachedRightBoundary = i;\n      headingAtBoundary = tel.headingDeg;\n    }\n\n    if (frameReachedRightBoundary === -1) {\n      if (i > 2 && absYawVel < minAbsYawRateBeforeBoundary) minAbsYawRateBeforeBoundary = absYawVel;\n    } else {\n      if (absYawVel < minAbsYawRateAfterBoundary) minAbsYawRateAfterBoundary = absYawVel;\n      if (absYawVel < 0.05) stalledFramesAfterBoundary++;\n    }\n  }\n\n  const continuousRight = {\n    frameReachedRightBoundary,\n    headingAtBoundaryDeg: Number(headingAtBoundary.toFixed(2)),\n    headingAfter180FramesDeg: Number(tel.headingDeg.toFixed(2)),\n    yawVelocityAtFrame180RadS: Number(fc.yawVelocity.toFixed(4)),\n    steeringDemandYawAtFrame180: Number(fc.steeringDemand.yaw.toFixed(4)),\n    reticleNormXAtFrame180: Number(fc.reticlePosition.normalizedX.toFixed(4)),\n    minAbsYawRateBeforeBoundaryRadS: Number(minAbsYawRateBeforeBoundary.toFixed(4)),\n    minAbsYawRateAfterBoundaryRadS: Number(minAbsYawRateAfterBoundary.toFixed(4)),\n    stalledFramesAfterBoundary,\n  };\n\n  // Acceptance Tests 4 & 5: Reverse mouse direction (-7 px/frame left) without lifting or repositioning\n  stepFrame(-7, 0);\n  const firstYawReverseFrame = {\n    yawVelocityFrame1RadS: Number(fc.yawVelocity.toFixed(4)),\n    steeringDemandYawFrame1: Number(fc.steeringDemand.yaw.toFixed(4)),\n    reticleNormXFrame1: Number(fc.reticlePosition.normalizedX.toFixed(4)),\n  };\n\n  for (let i = 0; i < 60; i++) {\n    stepFrame(-7, 0);\n  }\n  const afterContinuousLeft = {\n    headingAfterLeftDeg: Number(tel.headingDeg.toFixed(2)),\n    yawVelocityRadS: Number(fc.yawVelocity.toFixed(4)),\n    reticleNormX: Number(fc.reticlePosition.normalizedX.toFixed(4)),\n  };\n\n  // Acceptance Tests 6 & 7: Repeat vertically for pitch (-7 px/frame up for 120 frames, reach top boundary, continue turning, then reverse +7 px/frame down)\n  fc.reset();\n  let frameReachedTopBoundary = -1;\n  let pitchAtTopBoundary = 0;\n  let minAbsPitchRateAfterBoundary = Infinity;\n  let pitchStalledFramesAfterBoundary = 0;\n\n  for (let i = 1; i <= 120; i++) {\n    stepFrame(0, -7);\n    const normY = fc.reticlePosition.normalizedY;\n    const absPitchVel = Math.abs(fc.pitchVelocity);\n    if (frameReachedTopBoundary === -1 && normY <= -0.999) {\n      frameReachedTopBoundary = i;\n      pitchAtTopBoundary = tel.pitchDeg;\n    } else if (frameReachedTopBoundary !== -1) {\n      if (absPitchVel < minAbsPitchRateAfterBoundary) minAbsPitchRateAfterBoundary = absPitchVel;\n      if (absPitchVel < 0.05) pitchStalledFramesAfterBoundary++;\n    }\n  }\n\n  const continuousPitchUp = {\n    frameReachedTopBoundary,\n    pitchAtTopBoundaryDeg: Number(pitchAtTopBoundary.toFixed(2)),\n    pitchAfter120FramesDeg: Number(tel.pitchDeg.toFixed(2)),\n    pitchVelocityAtFrame120RadS: Number(fc.pitchVelocity.toFixed(4)),\n    steeringDemandPitchAtFrame120: Number(fc.steeringDemand.pitch.toFixed(4)),\n    reticleNormYAtFrame120: Number(fc.reticlePosition.normalizedY.toFixed(4)),\n    minAbsPitchRateAfterBoundaryRadS: Number(minAbsPitchRateAfterBoundary.toFixed(4)),\n    pitchStalledFramesAfterBoundary,\n  };\n\n  stepFrame(0, 7);\n  const firstPitchReverseFrame = {\n    pitchVelocityFrame1RadS: Number(fc.pitchVelocity.toFixed(4)),\n    steeringDemandPitchFrame1: Number(fc.steeringDemand.pitch.toFixed(4)),\n    reticleNormYFrame1: Number(fc.reticlePosition.normalizedY.toFixed(4)),\n  };\n\n  // Single-frame browser event-coalescing gap test at boundary\n  fc.reset();\n  for (let i = 0; i < 40; i++) stepFrame(8, 0);\n  stepFrame(0, 0); // 1 render tick with no mousemove packet\n  const yawRateDuringSingleFrameCoalesceGap = Number(fc.yawVelocity.toFixed(4));\n  stepFrame(8, 0);\n  const yawRateAfterSingleFrameCoalesceGap = Number(fc.yawVelocity.toFixed(4));\n\n  // Mouse stop test (4 frames of zero input -> exact 0 rotation)\n  for (let i = 0; i < 4; i++) stepFrame(0, 0);\n  const afterMouseStop = {\n    yawVelocityRadS: Number(fc.yawVelocity.toFixed(4)),\n    pitchVelocityRadS: Number(fc.pitchVelocity.toFixed(4)),\n    steeringDemandYaw: Number(fc.steeringDemand.yaw.toFixed(4)),\n    steeringDemandPitch: Number(fc.steeringDemand.pitch.toFixed(4)),\n    reticleNormXHeld: Number(fc.reticlePosition.normalizedX.toFixed(4)),\n  };\n\n  return {\n    continuousRight,\n    firstYawReverseFrame,\n    afterContinuousLeft,\n    continuousPitchUp,\n    firstPitchReverseFrame,\n    coalescingTest: {\n      yawRateDuringSingleFrameCoalesceGap,\n      yawRateAfterSingleFrameCoalesceGap,\n    },\n    afterMouseStop,\n  };\n});\n\nconsole.log(JSON.stringify(results, null, 2));\nawait browser.close();\n\'"
    proposed_command_line: "NODE_PATH=/usr/local/share/bun-global/node_modules bun -e \'\nimport { chromium } from \"playwright\";\n\nconst browser = await chromium.launch({\n  executablePath: \"/ms-playwright/chromium_headless_shell-1247/chrome-headless-shell-linux64/chrome-headless-shell\",\n  args: [\n    \"--use-gl=angle\",\n    \"--use-angle=swiftshader\",\n    \"--enable-webgl\",\n    \"--ignore-gpu-blocklist\",\n    \"--no-sandbox\",\n  ],\n});\n\nconst page = await browser.newPage({ viewport: { width: 1280, height: 720 } });\nawait page.goto(\"http://localhost:3000\", { waitUntil: \"domcontentloaded\" });\nawait page.waitForFunction(() => Boolean((window as any).__STARFALL_DIAG__), { timeout: 8000 });\n\nconst results = await page.evaluate(() => {\n  const canvas = document.querySelector(\"canvas\");\n  const diag = (window as any).__STARFALL_DIAG__;\n  const fc = diag.getFlight();\n  const input = diag.getInput();\n  const tel = diag.getTelemetry();\n  const settings = diag.getSettings();\n\n  input.setLockTarget(canvas);\n  input.setActive(true);\n  Object.defineProperty(document, \"pointerLockElement\", {\n    configurable: true,\n    get: () => canvas,\n  });\n  document.dispatchEvent(new Event(\"pointerlockchange\"));\n\n  const stepFrame = (dx: number, dy: number, dt = 1 / 60) => {\n    if (dx !== 0 || dy !== 0) {\n      window.dispatchEvent(\n        new MouseEvent(\"mousemove\", {\n          movementX: dx,\n          movementY: dy,\n          bubbles: true,\n        })\n      );\n    }\n    const snap = input.consumeSnapshot(dt, {\n      mouseSensitivity: settings.mouseSensitivity,\n      deadzone: settings.deadzone,\n      invertY: settings.invertY,\n    });\n    fc.update(dt, snap, settings, tel, 1280, 720);\n  };\n\n  fc.reset();\n\n  // Acceptance Tests 1, 2, 3: Hold continuous rightward mouse movement (+7 px/frame = 420 px/s) for 180 frames (3.0 seconds)\n  let frameReachedRightBoundary = -1;\n  let headingAtBoundary = 0;\n  let minAbsYawRateBeforeBoundary = Infinity;\n  let minAbsYawRateAfterBoundary = Infinity;\n  let stalledFramesAfterBoundary = 0;\n\n  for (let i = 1; i <= 180; i++) {\n    stepFrame(7, 0);\n    const normX = fc.reticlePosition.normalizedX;\n    const absYawVel = Math.abs(fc.yawVelocity);\n\n    if (frameReachedRightBoundary === -1 && normX >= 0.999) {\n      frameReachedRightBoundary = i;\n      headingAtBoundary = tel.headingDeg;\n    }\n\n    if (frameReachedRightBoundary === -1) {\n      if (i > 2 && absYawVel < minAbsYawRateBeforeBoundary) minAbsYawRateBeforeBoundary = absYawVel;\n    } else {\n      if (absYawVel < minAbsYawRateAfterBoundary) minAbsYawRateAfterBoundary = absYawVel;\n      if (absYawVel < 0.05) stalledFramesAfterBoundary++;\n    }\n  }\n\n  const continuousRight = {\n    frameReachedRightBoundary,\n    headingAtBoundaryDeg: Number(headingAtBoundary.toFixed(2)),\n    headingAfter180FramesDeg: Number(tel.headingDeg.toFixed(2)),\n    yawVelocityAtFrame180RadS: Number(fc.yawVelocity.toFixed(4)),\n    steeringDemandYawAtFrame180: Number(fc.steeringDemand.yaw.toFixed(4)),\n    reticleNormXAtFrame180: Number(fc.reticlePosition.normalizedX.toFixed(4)),\n    minAbsYawRateBeforeBoundaryRadS: Number(minAbsYawRateBeforeBoundary.toFixed(4)),\n    minAbsYawRateAfterBoundaryRadS: Number(minAbsYawRateAfterBoundary.toFixed(4)),\n    stalledFramesAfterBoundary,\n  };\n\n  // Acceptance Tests 4 & 5: Reverse mouse direction (-7 px/frame left) without lifting or repositioning\n  stepFrame(-7, 0);\n  const firstYawReverseFrame = {\n    yawVelocityFrame1RadS: Number(fc.yawVelocity.toFixed(4)),\n    steeringDemandYawFrame1: Number(fc.steeringDemand.yaw.toFixed(4)),\n    reticleNormXFrame1: Number(fc.reticlePosition.normalizedX.toFixed(4)),\n  };\n\n  for (let i = 0; i < 60; i++) {\n    stepFrame(-7, 0);\n  }\n  const afterContinuousLeft = {\n    headingAfterLeftDeg: Number(tel.headingDeg.toFixed(2)),\n    yawVelocityRadS: Number(fc.yawVelocity.toFixed(4)),\n    reticleNormX: Number(fc.ret