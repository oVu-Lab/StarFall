            lines {
              text: " * Virtual Joystick Pipeline:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * 1. Relative Pointer Lock deltas from InputManager displace the logical virtual joystick"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *    vector `(joystickX, joystickY)` scaled by `mouseSensitivity` and normalized for viewport size."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * 2. `clampToRoundedRect` keeps `(joystickX, joystickY)` strictly bounded on the centered"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *    rounded-rectangle boundary (30% W x 35% H default, scaled by `joystickRadius`), allowing"
