            }
            lines {
              text: "  const excess = (absVal - k) / headroom;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const saturated = k + headroom * Math.tanh(excess);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  return value < 0 ? -saturated : saturated;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Continuous monotonic nonlinear gain function `g(u)` for normalized input speed `u >= 0`:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *   `g(u) = a * u + (1 - a) * u^p`"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Properties:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * - `g(0) = 0`, `g\'(0) = a`: Small mouse movements produce subtle, predictable precision"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *   rotation rather than dropping into a deadzone."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * - Strictly smooth (`C\342\210\236` for `u > 0`), monotonically increasing derivative for `p > 1`:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *   Medium movements progressively accelerate steering response with zero jumps or knees."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * - Anchored at `g(1) = 1` for all `p` and `a`: Changing curve exponent reshapes the"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *   precision-to-fast-turn progression cleanly without shifting the reference anchor."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * - Reduces exactly to linear `g(u) = u` when `p = 1.0`."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "export function evaluateNonlinearGain("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  normalizedInput: number,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  responseCurve: number = DIRECT_MOUSE_STEERING_CONFIG.responseCurve,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  precisionLinearBlend: number = DIRECT_MOUSE_STEERING_CONFIG.precisionLinearBlend,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "): number {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  if (!Number.isFinite(normalizedInput) || normalizedInput <= 0) return 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const p = THREE.MathUtils.clamp("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    responseCurve,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    STEERING_BOUNDS.responseCurve.min,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    STEERING_BOUNDS.responseCurve.max,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  );"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const a = THREE.MathUtils.clamp(precisionLinearBlend, 0.05, 0.95);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  if (Math.abs(p - 1.0) < 1e-4) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    return normalizedInput;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  return a * normalizedInput + (1 - a) * Math.pow(normalizedInput, p);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Scalar convenience evaluator combining `evaluateNonlinearGain` and `softSaturateSigned`."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Used for both verification and the Settings Panel live curve visualization."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "export function evaluateDirectMouseCurveScalar("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  normalizedInput: number,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  responseCurve: number = DIRECT_MOUSE_STEERING_CONFIG.responseCurve,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  precisionLinearBlend: number = DIRECT_MOUSE_STEERING_CONFIG.precisionLinearBlend,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  softSaturationKnee: number = DIRECT_MOUSE_STEERING_CONFIG.softSaturationKnee,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "): number {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  if (!Number.isFinite(normalizedInput) || normalizedInput <= 0) return 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const gain = evaluateNonlinearGain(normalizedInput, responseCurve, precisionLinearBlend);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  return softSaturateSigned(gain, softSaturationKnee);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Evaluates raw Pointer Lock mouse deltas (`movementX`, `movementY`) over frame delta `dt`"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * into frame-rate-independent target yaw and pitch angular rates (rad/s)."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Frame-Rate Independence:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *   Converts per-frame pixel deltas to instantaneous mouse speed `px/s` using clamped"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *   `velDt = max(dt, 1/240)` before applying the nonlinear curve, ensuring consistent"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *   angular response across 30, 60, 120, and 144+ FPS displays."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Zero-Input Guarantee:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *   When `mouseDeltaX === 0 && mouseDeltaY === 0`, outputs exact zeros across all fields."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "export function evaluateDirectMouseSteering("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  mouseDeltaX: number,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  mouseDeltaY: number,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  dt: number,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  params: DirectMouseCurveParams,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  out: DirectMouseEvaluation = createDirectMouseEvaluation(),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "): DirectMouseEvaluation {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const dx = Number.isFinite(mouseDeltaX) ? mouseDeltaX : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const dy = Number.isFinite(mouseDeltaY) ? mouseDeltaY : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  if (dx === 0 && dy === 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    out.speedPxPerSec = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    out.normalizedInput = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    out.curveGain = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    out.steerYaw = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    out.steerPitch = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    out.targetYawRate = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    out.targetPitchRate = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    return out;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  // Guard against sub-4ms synthetic dt spikes while staying exact at 30-240 FPS"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const velDt = Math.max(dt, 1 / 240);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const ySign = params.invertY ? -1 : 1;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const vx = dx / velDt;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const vy = (dy * ySign) / velDt;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const vMag = Math.hypot(vx, vy);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  if (vMag <= 1e-6) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    out.speedPxPerSec = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    out.normalizedInput = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    out.curveGain = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    out.steerYaw = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    out.steerPitch = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    out.targetYawRate = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    out.targetPitchRate = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    return out;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const ux = vx / vMag;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const uy = vy / vMag;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const baseSens = THREE.MathUtils.clamp("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    params.mouseSensitivity,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    STEERING_BOUNDS.mouseSensitivity.min,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    STEERING_BOUNDS.mouseSensitivity.max,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  );"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const normRange = Math.max(100, params.inputNormalizationRange);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const u = (vMag * baseSens) / normRange;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const gain = evaluateNonlinearGain(u, params.responseCurve, params.precisionLinearBlend);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const yawSens = THREE.MathUtils.clamp("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    params.yawSensitivity,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    STEERING_BOUNDS.yawSensitivity.min,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    STEERING_BOUNDS.yawSensitivity.max,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  );"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const pitchSens = THREE.MathUtils.clamp("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    params.pitchSensitivity,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    STEERING_BOUNDS.pitchSensitivity.min,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    STEERING_BOUNDS.pitchSensitivity.max,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  );"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  // Moving mouse right (+vx) yaws ship right (-Y rotation); moving mouse up (-vy) pitches nose up (+X rotation)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const rawYaw = -ux * gain * yawSens;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const rawPitch = -uy * gain * pitchSens;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const steerYaw = softSaturateSigned(rawYaw, params.softSaturationKnee);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const steerPitch = softSaturateSigned(rawPitch, params.softSaturationKnee);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const maxYaw = Math.max(0.1, params.maxYawRate);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const maxPitch = Math.max(0.1, params.maxPitchRate);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  out.speedPxPerSec = vMag;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  out.normalizedInput = u;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  out.curveGain = gain;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  out.steerYaw = steerYaw;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  out.steerPitch = steerPitch;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  out.targetYawRate = steerYaw * maxYaw;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  out.targetPitchRate = steerPitch * maxPitch;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  return out;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Optional minimal exponential input smoothing with crisp stop-settling and zero reversal lag."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * - `inputSmoothing <= 0.001`: Zero lag, direct pass-through (`return targetRate`)."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * Optional minimal exponential input smoothing with crisp stop-settling, zero reversal lag,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * and single-frame browser event-coalescing continuity."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - `inputSmoothing <= 0.001` (when not bridging an intra-drag coalescing tick):"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   Zero lag, direct pass-through (`return targetRate`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - `inputSmoothing > 0.001`: Ultra-light exponential filter (`tau = inputSmoothing * 0.05s`)."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *   At default `0.04`, `tau = 2ms`."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * - When `targetRate === 0` (mouse input stopped), applies `stopDecayMultiplier` (4.5x faster"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " *   decay) and snaps residual rates `< 0.02 rad/s` immediately to exact `0` so stopping the"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " *   mouse never accumulates unwanted drift or angular momentum."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * - Single-frame event-coalescing bridge (`isCoalescingGap === true`):"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   When a high-refresh render frame fires between two physical `mousemove` packets during"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   continuous mouse movement (`< 18ms` since the last non-zero delta), uses a short 22ms"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   continuity decay instead of slamming angular velocity to `0` on that single frame."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - When `targetRate === 0` and `isCoalescingGap === false` (mouse input actually stopped),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   applies `stopDecayMultiplier` (4.5x faster decay) and snaps residual rates `< 0.02 rad/s`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   immediately to exact `0` so stopping the mouse never accumulates unwanted drift or inertia."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - When reversing direction (`targetRate * currentRate < 0`), clears opposite-sign velocity"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *   immediately so counter-corrections never fight leftover momentum from the prior direction."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "export function stepDirectAngularRate("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  currentRate: number,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  targetRate: number,"
