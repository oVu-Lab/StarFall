  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * Centralized configuration for STARFALL\'s aiming boundary & progressive mouse steering.\n *\n * Confirmed Design Decisions:\n * - Aim boundary width: 45% of game viewport width (half-extent = 0.225 * W)\n * - Aim boundary height: 45% of game viewport height (half-extent = 0.225 * H)\n * - Boundary shape: Centered rounded rectangle with configurable corner radius\n * - Progressive three-zone steering curve:\n *     f(e) = e^p / (1 + e^p)\n *     sensitivity(e) = boundarySensitivity + (maxSensitivity - boundarySensitivity) * f(e)\n */\nexport const STEERING_CONFIG = {\n  /** Full aim boundary width as a fraction of the game viewport width (45%) */\n  aimBoundaryWidth: 0.45,\n  /** Full aim boundary height as a fraction of the game viewport height (45%) */\n  aimBoundaryHeight: 0.45,\n  /** Corner radius as a fraction of min(halfWidth, halfHeight) of the rounded rectangle */\n  aimBoundaryCornerRadius: 0.25,\n\n  /** Normal precision-zone sensitivity multiplier inside the rounded-rectangle boundary */\n  normalSensitivity: 1.0,\n  /** Initial sensitivity multiplier when crossing the aiming boundary (Zone B entry) */\n  boundarySensitivity: 0.35,\n  /** Asymptotic maximum sensitivity multiplier in Zone C accelerated turning */\n  maxSensitivity: 2.5,\n  /** Outward virtual-pixel displacement scale S for normalized excess e = excess / S */\n  accelerationDistance: 240,\n  /** Nonlinear response curve exponent p in f(e) = e^p / (1 + e^p) */\n  responseCurveExponent: 2.0,\n  /** Smooth delta-time recovery time constant (seconds) for zone transitions & return to precision */\n  recoverySmoothingSec: 0.12,\n\n  /** Tiny center deadzone (fraction of boundary half-extent) for drift-free straight flight */\n  deadzone: 0.03,\n  /** Mild inner precision-zone shaping exponent for crisp fine aiming near center */\n  precisionExponent: 1.15,\n  /**\n   * Normalized boundary fraction [0..1] where C1 smoothstep easing toward boundarySensitivity begins.\n   * Keeps the inner 85% of the precision zone at flat 1.0x sensitivity while ensuring zero jump at the edge.\n   */\n  boundaryBlendStart: 0.85,\n  /**\n   * Normalized excess scale beyond which further outward movement applies gentle soft compression.\n   * Never introduces a hard mouse input cutoff: indefinite mouse travel remains active and responsive.\n   */\n  softOutwardCompressionStart: 4.0,\n  /** Smooth inward unwind assist factor when returning from deep overdrive excess */\n  inwardExcessReturnFactor: 0.65,\n  /** Safety angular velocity ceilings (multiples of base ship yawSpeed / pitchSpeed) */\n  maxSafeYawMultiplier: 3.2,\n  maxSafePitchMultiplier: 3.0,\n} as const;\n\nexport const STEERING_BOUNDS = {\n  aimBoundaryWidth: { min: 0.25, max: 0.7 },\n  aimBoundaryHeight: { min: 0.25, max: 0.7 },\n  aimBoundaryCornerRadius: { min: 0.05, max: 0.9 },\n  mouseSensitivity: { min: 0.3, max: 2.5 },\n  boundarySensitivity: { min: 0.15, max: 1.0 },\n  maxSensitivity: { min: 1.2, max: 3.5 },\n  accelerationDistance: { min: 80, max: 500 },\n  responseCurve: { min: 1.0, max: 3.5 },\n  recoverySmoothing: { min: 0.04, max: 0.35 },\n} as const;\n"
        path {
          absolute_uri: "file:///src/config/steering.ts"
        }
        overwrite: true
      }
    }
