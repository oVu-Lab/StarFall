            }
            lines {
              text: "          t.steeringZone === \'acceleration\'"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            ? \'rgba(125, 211, 252, 0.85)\'"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            : t.steeringZone === \'transition\'"
