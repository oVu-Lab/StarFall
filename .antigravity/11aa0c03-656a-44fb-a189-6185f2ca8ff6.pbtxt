  code_action {
    action_spec {
      create_file {
        instruction: "import * as THREE from \'three\';\nimport { STEERING_BOUNDS, STEERING_CONFIG } from \'../config/steering\';\nimport type { SteeringZone } from \'../types/game\';\n\n/**\n * Exact viewport-relative rounded-rectangle aiming boundary geometry.\n * Centered at (0, 0) in viewport CSS pixel offset coordinates.\n */\nexport interface RoundedRectBoundary {\n  viewportWidth: number;\n  viewportHeight: number;\n  widthFraction: number;\n  heightFraction: number;\n  cornerRadiusRatio: number;\n  widthPx: number;\n  heightPx: number;\n  halfW: number;\n  halfH: number;\n  cornerRadiusPx: number;\n  innerHalfW: number;\n  innerHalfH: number;\n}\n\n/**\n * Result of clamping an unconstrained relative virtual displacement (rawX, rawY)\n * onto the rounded-rectangle precision boundary while preserving outward excess.\n */\nexport interface RoundedRectClampResult {\n  /** Clamped reticle offset from viewport center in CSS pixels (strictly inside/on boundary) */\n  clampedX: number;\n  clampedY: number;\n  /** True when the raw displacement lies inside or on the rounded-rectangle boundary */\n  inside: boolean;\n  /** Exact Euclidean signed distance to the rounded-rectangle perimeter in px (<= 0 inside, > 0 outside) */\n  signedDistance: number;\n  /** Independent horizontal outward displacement past the rounded-rectangle perimeter (>= 0 px) */\n  excessX: number;\n  /** Independent vertical outward displacement past the rounded-rectangle perimeter (>= 0 px) */\n  excessY: number;\n  /** Effective horizontal boundary half-extent at clampedY (curves smoothly along corners) */\n  axisBoundaryX: number;\n  /** Effective vertical boundary half-extent at clampedX (curves smoothly along corners) */\n  axisBoundaryY: number;\n  /** Clamped normalized deflection relative to halfW / halfH in [-1, 1] */\n  normalizedX: number;\n  normalizedY: number;\n  /** Viewport-normalized [0..1] screen position of the clamped virtual reticle */\n  screenX: number;\n  screenY: number;\n}\n\nexport interface AxisSteeringEvaluation {\n  targetSensitivity: number;\n  excess: number;\n  curveFactor: number;\n  zone: SteeringZone;\n}\n\nexport function createRoundedRectBoundary(): RoundedRectBoundary {\n  return {\n    viewportWidth: 1280,\n    viewportHeight: 720,\n    widthFraction: STEERING_CONFIG.aimBoundaryWidth,\n    heightFraction: STEERING_CONFIG.aimBoundaryHeight,\n    cornerRadiusRatio: STEERING_CONFIG.aimBoundaryCornerRadius,\n    widthPx: 1280 * STEERING_CONFIG.aimBoundaryWidth,\n    heightPx: 720 * STEERING_CONFIG.aimBoundaryHeight,\n    halfW: 1280 * STEERING_CONFIG.aimBoundaryWidth * 0.5,\n    halfH: 720 * STEERING_CONFIG.aimBoundaryHeight * 0.5,\n    cornerRadiusPx: 720 * STEERING_CONFIG.aimBoundaryHeight * 0.5 * STEERING_CONFIG.aimBoundaryCornerRadius,\n    innerHalfW: 0,\n    innerHalfH: 0,\n  };\n}\n\nexport function createRoundedRectClampResult(): RoundedRectClampResult {\n  return {\n    clampedX: 0,\n    clampedY: 0,\n    inside: true,\n    signedDistance: 0,\n    excessX: 0,\n    excessY: 0,\n    axisBoundaryX: 288,\n    axisBoundaryY: 162,\n    normalizedX: 0,\n    normalizedY: 0,\n    screenX: 0.5,\n    screenY: 0.5,\n  };\n}\n\n/**\n * Computes exact rounded-rectangle boundary dimensions for the current game viewport (W x H).\n * For default 45% x 45%:\n *   halfW = 0.225 * W\n *   halfH = 0.225 * H\n *   cornerRadius = cornerRadiusRatio * min(halfW, halfH)\n */\nexport function computeRoundedRectBoundary(\n  viewportWidth: number,\n  viewportHeight: number,\n  widthFraction: number,\n  heightFraction: number,\n  cornerRadiusRatio: number,\n  out: RoundedRectBoundary = createRoundedRectBoundary(),\n): RoundedRectBoundary {\n  const vw = Math.max(1, Number.isFinite(viewportWidth) ? viewportWidth : 1280);\n  const vh = Math.max(1, Number.isFinite(viewportHeight) ? viewportHeight : 720);\n\n  const wf = THREE.MathUtils.clamp(\n    widthFraction,\n    STEERING_BOUNDS.aimBoundaryWidth.min,\n    STEERING_BOUNDS.aimBoundaryWidth.max,\n  );\n  const hf = THREE.MathUtils.clamp(\n    heightFraction,\n    STEERING_BOUNDS.aimBoundaryHeight.min,\n    STEERING_BOUNDS.aimBoundaryHeight.max,\n  );\n  const rRatio = THREE.MathUtils.clamp(\n    cornerRadiusRatio,\n    STEERING_BOUNDS.aimBoundaryCornerRadius.min,\n    STEERING_BOUNDS.aimBoundaryCornerRadius.max,\n  );\n\n  const widthPx = vw * wf;\n  const heightPx = vh * hf;\n  const halfW = widthPx * 0.5;\n  const halfH = heightPx * 0.5;\n  const cornerRadiusPx = Math.min(halfW, halfH) * rRatio;\n\n  out.viewportWidth = vw;\n  out.viewportHeight = vh;\n  out.widthFraction = wf;\n  out.heightFraction = hf;\n  out.cornerRadiusRatio = rRatio;\n  out.widthPx = widthPx;\n  out.heightPx = heightPx;\n  out.halfW = halfW;\n  out.halfH = halfH;\n  out.cornerRadiusPx = cornerRadiusPx;\n  out.innerHalfW = Math.max(0, halfW - cornerRadiusPx);\n  out.innerHalfH = Math.max(0, halfH - cornerRadiusPx);\n  return out;\n}\n\n/**\n * C1-continuous closest-point projection of an unconstrained virtual displacement (rawX, rawY)\n * onto the centered rounded-rectangle boundary.\n *\n * - Inside the rounded rectangle: reticle tracks (rawX, rawY) directly; excessX = excessY = 0.\n * - Outside straight edges: clamps perpendicularly to the edge without affecting the parallel axis.\n * - Outside rounded corners: projects orthogonally onto the circular corner arc (zero abrupt snapping).\n * - Preserves independent outward excess (excessX, excessY) for progressive steering acceleration.\n */\nexport function clampToRoundedRect(\n  rawX: number,\n  rawY: number,\n  boundary: RoundedRectBoundary,\n  out: RoundedRectClampResult = createRoundedRectClampResult(),\n): RoundedRectClampResult {\n  const {\n    halfW,\n    halfH,\n    cornerRadiusPx: r,\n    innerHalfW,\n    innerHalfH,\n    viewportWidth,\n    viewportHeight,\n  } = boundary;\n\n  const ax = Math.abs(rawX);\n  const ay = Math.abs(rawY);\n  const sx = rawX < 0 ? -1 : 1;\n  const sy = rawY < 0 ? -1 : 1;\n\n  const qx = ax - innerHalfW;\n  const qy = ay - innerHalfH;\n\n  // Exact Euclidean rounded-rectangle signed distance field (<= 0 inside, > 0 outside)\n  const outX = qx > 0 ? qx : 0;\n  const outY = qy > 0 ? qy : 0;\n  const outLen = Math.hypot(outX, outY);\n  const inDist = Math.min(Math.max(qx, qy), 0);\n  const sdf = outLen + inDist - r;\n\n  let clampedX = rawX;\n  let clampedY = rawY;\n  let inside = true;\n\n  if (sdf > 0) {\n    inside = false;\n    if (qx > 0 && qy > 0) {\n      // Corner quadrant: orthogonal projection onto circular corner arc of radius r\n      const invD = outLen > 1e-6 ? 1 / outLen : 0;\n      clampedX = sx * (innerHalfW + qx * invD * r);\n      clampedY = sy * (innerHalfH + qy * invD * r);\n    } else if (qx > 0) {\n      // Left / right straight edge\n      clampedX = sx * halfW;\n      clampedY = rawY;\n    } else {\n      // Top / bottom straight edge\n      clampedX = rawX;\n      clampedY = sy * halfH;\n    }\n  }\n\n  // Compute effective per-axis boundary coordinate at the clamped cross-axis position\n  const absClampedX = Math.abs(clampedX);\n  const absClampedY = Math.abs(clampedY);\n\n  const dyCorner = Math.max(0, absClampedY - innerHalfH);\n  const axisBoundaryX =\n    dyCorner > 0\n      ? innerHalfW + Math.sqrt(Math.max(0, r * r - dyCorner * dyCorner))\n      : halfW;\n\n  const dxCorner = Math.max(0, absClampedX - innerHalfW);\n  const axisBoundaryY =\n    dxCorner > 0\n      ? innerHalfH + Math.sqrt(Math.max(0, r * r - dxCorner * dxCorner))\n      : halfH;\n\n  out.clampedX = clampedX;\n  out.clampedY = clampedY;\n  out.inside = inside;\n  out.signedDistance = sdf;\n  out.excessX = Math.abs(rawX - clampedX);\n  out.excessY = Math.abs(rawY - clampedY);\n  out.axisBoundaryX = Math.max(1, axisBoundaryX);\n  out.axisBoundaryY = Math.max(1, axisBoundaryY);\n  out.normalizedX = halfW > 0 ? THREE.MathUtils.clamp(clampedX / halfW, -1, 1) : 0;\n  out.normalizedY = halfH > 0 ? THREE.MathUtils.clamp(clampedY / halfH, -1, 1) : 0;\n  out.screenX = 0.5 + clampedX / viewportWidth;\n  out.screenY = 0.5 + clampedY / viewportHeight;\n  return out;\n}\n\n/**\n * Pure per-axis progressive steering sensitivity evaluation.\n *\n * Inside the boundary (excessPx == 0):\n *   - Core precision region [0 .. boundaryBlendStart * axisBoundary]: flat normalSensitivity (1.0x).\n *   - Boundary approach [boundaryBlendStart * axisBoundary .. axisBoundary]: C1 smoothstep easing\n *     down to boundarySensitivity (0.35x) so there is zero sensitivity jump when crossing the edge.\n *\n * Beyond the boundary (excessPx > 0):\n *   e = excessPx / accelDistance\n *   f(e) = e^p / (1 + e^p)\n *   sensitivity(e) = boundarySensitivity + (maxSensitivity - boundarySensitivity) * f(e)\n *   - Zone B (transition): sensitivity < normalSensitivity (slower initial boundary crossing)\n *   - Zone C (acceleration): sensitivity >= normalSensitivity (progressive turn acceleration)\n */\nexport function evaluateProgressiveAxisSensitivity(\n  absCoordPx: number,\n  axisBoundaryPx: number,\n  excessPx: number,\n  accelDistancePx: number,\n  normalSensitivity: number,\n  boundarySensitivity: number,\n  maxSensitivity: number,\n  exponent: number,\n  out: AxisSteeringEvaluation = {\n    targetSensitivity: 1,\n    excess: 0,\n    curveFactor: 0,\n    zone: \'precision\',\n  },\n): AxisSteeringEvaluation {\n  const B = Math.max(10, axisBoundaryPx);\n  const S = Math.max(20, accelDistancePx);\n  const nSens = THREE.MathUtils.clamp(normalSensitivity, 0.5, 2.0);\n  const bSens = THREE.MathUtils.clamp(boundarySensitivity, 0.1, nSens);\n  const mSens = Math.max(nSens, maxSensitivity);\n  const p = THREE.MathUtils.clamp(exponent, 0.5, 5.0);\n\n  if (excessPx <= 1e-4) {\n    const blendStart = B * STEERING_CONFIG.boundaryBlendStart;\n    if (absCoordPx <= blendStart) {\n      out.targetSensitivity = nSens;\n    } else {\n      const t = THREE.MathUtils.clamp((absCoordPx - blendStart) / Math.max(1, B - blendStart), 0, 1);\n      const smooth = t * t * (3 - 2 * t);\n      out.targetSensitivity = nSens + (bSens - nSens) * smooth;\n    }\n    out.excess = 0;\n    out.curveFactor = 0;\n    out.zone = \'precision\';\n    return out;\n  }\n\n  const e = excessPx / S;\n  const ep = Math.pow(e, p);\n  const f = ep / (1 + ep);\n  const targetSens = bSens + (mSens - bSens) * f;\n\n  out.targetSensitivity = targetSens;\n  out.excess = e;\n  out.curveFactor = f;\n  out.zone = targetSens < nSens ? \'transition\' : \'acceleration\';\n  return out;\n}\n"
