            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const deflection = Math.max(Math.abs(t.aimNormalizedX), Math.abs(t.aimNormalizedY));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const edgeOp ="
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          t.steeringZone === \'acceleration\'"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ? 0.28 + t.steeringAccelRatio * 0.22"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            : t.steeringZone === \'transition\'"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              ? 0.28"
