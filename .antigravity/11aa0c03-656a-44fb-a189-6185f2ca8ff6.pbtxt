            }
            lines {
              text: "              : deflection > 0.15"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                ? 0.07 + Math.min(1, deflection) * 0.16"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                : 0.06;"
