  code_action {
    action_spec {
      create_file {
        instruction: "import * as THREE from \'three\';\nimport { STEERING_BOUNDS, STEERING_CONFIG } from \'../config/steering\';\nimport type { ProjectedEnemyMarker } from \'../types/combat\';\nimport type {\n  FlightStatus,\n  FlightTelemetry,\n  GameSettings,\n  ShipConfig,\n  SteeringZone,\n} from \'../types/game\';\nimport {\n  clampToRoundedRect,\n  computeRoundedRectBoundary,\n  createRoundedRectBoundary,\n  createRoundedRectClampResult,\n  evaluateProgressiveAxisSensitivity,\n  type AxisSteeringEvaluation,\n  type RoundedRectBoundary,\n  type RoundedRectClampResult,\n} from \'./AimBoundary\';\nimport type { InputSnapshot } from \'./InputManager\';\n\n// Re-export progressive steering evaluator for UI curve preview & diagnostics\nexport { evaluateProgressiveAxisSensitivity } from \'./AimBoundary\';\nexport type { AxisSteeringEvaluation, RoundedRectBoundary, RoundedRectClampResult } from \'./AimBoundary\';\n\n// Reusable scratch objects (zero per-frame GC allocations)\nconst _AXIS_X = new THREE.Vector3(1, 0, 0);\nconst _AXIS_Y = new THREE.Vector3(0, 1, 0);\nconst _AXIS_Z = new THREE.Vector3(0, 0, 1);\nconst _FORWARD_LOCAL = new THREE.Vector3(0, 0, -1);\n\nconst _qYaw = new THREE.Quaternion();\nconst _qPitch = new THREE.Quaternion();\nconst _qRoll = new THREE.Quaternion();\nconst _forwardWorld = new THREE.Vector3();\nconst _rightWorld = new THREE.Vector3();\nconst _upWorld = new THREE.Vector3();\nconst _desiredVel = new THREE.Vector3();\nconst _euler = new THREE.Euler(0, 0, 0, \'YXZ\');\n\nfunction createEmptyEnemyMarkers(count = 6): ProjectedEnemyMarker[] {\n  const list: ProjectedEnemyMarker[] = [];\n  for (let i = 0; i < count; i++) {\n    list.push({\n      active: false,\n      entityId: \'\',\n      callsign: \'\',\n      personalityLabel: \'\',\n      aiState: \'patrol\',\n      screenX: 0.5,\n      screenY: 0.5,\n      inFront: false,\n      onScreen: false,\n      distance: 0,\n      healthRatio: 1,\n      isPrimaryTarget: false,\n      isPriorityTarget: false,\n      leadX: 0.5,\n      leadY: 0.5,\n      leadVisible: false,\n    });\n  }\n  return list;\n}\n\nexport function createInitialTelemetry(ship: ShipConfig): FlightTelemetry {\n  return {\n    speed: 0,\n    signedSpeed: 0,\n    maxSpeed: ship.flight.maxSpeed,\n    effectiveMaxSpeed: ship.flight.maxSpeed,\n    throttle: 0,\n    boostEnergy: ship.flight.maxBoostEnergy,\n    maxBoostEnergy: ship.flight.maxBoostEnergy,\n    isBoosting: false,\n    boostDepleted: false,\n    boostIntensity: 0,\n    hull: ship.maxHull,\n    maxHull: ship.maxHull,\n    yawRate: 0,\n    pitchRate: 0,\n    rollRate: 0,\n    aimNormalizedX: 0,\n    aimNormalizedY: 0,\n    aimScreenX: 0.5,\n    aimScreenY: 0.5,\n    aimBoundaryWidthPx: 1280 * STEERING_CONFIG.aimBoundaryWidth,\n    aimBoundaryHeightPx: 720 * STEERING_CONFIG.aimBoundaryHeight,\n    aimBoundaryCornerRadiusPx:\n      720 * STEERING_CONFIG.aimBoundaryHeight * 0.5 * STEERING_CONFIG.aimBoundaryCornerRadius,\n    aimExcessX: 0,\n    aimExcessY: 0,\n    boresightScreenX: 0.5,\n    boresightScreenY: 0.5,\n    steeringZone: \'precision\',\n    steeringSensitivityX: STEERING_CONFIG.normalSensitivity,\n    steeringSensitivityY: STEERING_CONFIG.normalSensitivity,\n    steeringAccelRatio: 0,\n    headingDeg: 0,\n    pitchDeg: 0,\n    rollDeg: 0,\n    altitude: 0,\n    status: \'STANDBY\',\n    pointerLocked: false,\n    isFiring: false,\n    weaponName: ship.weapons.primaryName,\n    weaponCooldownRatio: 0,\n    hitMarkerTimer: 0,\n    killMarkerTimer: 0,\n    damageFlashTimer: 0,\n    muzzleFlashLeft: 0,\n    muzzleFlashRight: 0,\n    playerDestroyed: false,\n    combatStats: {\n      kills: 0,\n      shotsFired: 0,\n      shotsHit: 0,\n      damageDealt: 0,\n      damageTaken: 0,\n      score: 0,\n      wave: 1,\n      activeEnemies: 0,\n    },\n    enemyMarkers: createEmptyEnemyMarkers(6),\n    fps: 60,\n    frameTimeMs: 16.6,\n    drawCalls: 0,\n    triangles: 0,\n    activeProjectiles: 0,\n    activeParticles: 0,\n    activeEnemies: 0,\n    lastAssetLoadMs: 0,\n    cachedAssetCount: 0,\n  };\n}\n\nconst GIMBAL_MAX_YAW_RAD = 0.24;\nconst GIMBAL_MAX_PITCH_RAD = 0.17;\n\nconst _gimbalDirLocal = new THREE.Vector3();\nconst _evalX: AxisSteeringEvaluation = {\n  targetSensitivity: 1,\n  excess: 0,\n  curveFactor: 0,\n  zone: \'precision\',\n};\nconst _evalY: AxisSteeringEvaluation = {\n  targetSensitivity: 1,\n  excess: 0,\n  curveFactor: 0,\n  zone: \'precision\',\n};\n\n/**\n * Integrates relative mouse delta onto an unconstrained virtual axis coordinate.\n *\n * - Inside the rounded-rectangle boundary (excessPx == 0): pure 1:1 relative displacement.\n * - Pushing outward beyond the boundary: continuous with zero hard mouse input cutoff.\n *   Past `softOutwardCompressionStart * S` (where f(e) > 0.94), applies smooth soft compression\n *   so indefinite mouse movement stays responsive without accumulating runaway unwind lag.\n * - Pulling inward from overdrive excess: smoothly accelerates excess retraction back to the\n *   boundary edge while applying any remaining inward travel 1:1 inside the precision zone.\n */\nfunction accumulateAxisDisplacement(\n  rawCoord: number,\n  clampedCoord: number,\n  excessPx: number,\n  stepPx: number,\n  accelDist: number,\n): number {\n  if (stepPx === 0) return rawCoord;\n\n  if (excessPx <= 1e-4) {\n    return rawCoord + stepPx;\n  }\n\n  const movingOutward = stepPx * rawCoord > 0;\n  if (movingOutward) {\n    const excessRatio = excessPx / accelDist;\n    const compressStart = STEERING_CONFIG.softOutwardCompressionStart;\n    if (excessRatio <= compressStart) {\n      return rawCoord + stepPx;\n    }\n    const softScale = 1 / (1 + (excessRatio - compressStart) * 0.35);\n    return rawCoord + stepPx * softScale;\n  }\n\n  // Pulling back inward while outside the boundary: smooth excess unwind without sticking\n  const excessRatio = excessPx / accelDist;\n  const inwardGain = 1 + Math.min(2.2, excessRatio * STEERING_CONFIG.inwardExcessReturnFactor);\n  const inwardMag = Math.abs(stepPx);\n  const neededToReachBoundary = excessPx / inwardGain;\n\n  if (inwardMag <= neededToReachBoundary) {\n    return rawCoord + stepPx * inwardGain;\n  }\n\n  const remainingInward = inwardMag - neededToReachBoundary;\n  return clampedCoord + Math.sign(stepPx) * remainingInward;\n}\n\n/**\n * Arcade 6DOF space flight controller.\n * Ship coordinate system: Forward = -Z, Right = +X, Up = +Y.\n *\n * Decoupled Steering Pipeline:\n * 1. Relative Pointer Lock deltas from InputManager accumulate unconstrained virtual aim\n *    displacement `(virtualAimX, virtualAimY)` in game-viewport pixel space.\n * 2. `AimBoundary` clamps the virtual reticle strictly inside the centered 45% x 45%\n *    rounded-rectangle viewport region while preserving independent `(excessX, excessY)`.\n * 3. `evaluateProgressiveAxisSensitivity` maps per-axis precision, transition, and\n *    accelerated turning via f(e) = e^p / (1 + e^p) with ~0.12s recovery smoothing.\n * 4. FlightController owns ship yaw, pitch, roll, thrust, inertia, and boost simulation.\n */\nexport class FlightController {\n  public readonly position = new THREE.Vector3(0, 12, 40);\n  public readonly quaternion = new THREE.Quaternion();\n  public readonly velocity = new THREE.Vector3(0, 0, -24);\n\n  // Smoothed angular rates (rad/s) in ship local space\n  public yawVelocity = 0;\n  public pitchVelocity = 0;\n  public rollVelocity = 0;\n\n  // Unconstrained relative virtual aim displacement in viewport CSS pixel space (centered at 0,0)\n  public virtualAimX = 0;\n  public virtualAimY = 0;\n\n  // Clamped normalized reticle deflection [-1..1] inside rounded-rectangle boundary (for HUD & gimbal)\n  public aimCursorX = 0;\n  public aimCursorY = 0;\n\n  // Delta-time smoothed effective sensitivity multipliers per axis (recovery smoothing ~0.12s)\n  public smoothedSensX: number = STEERING_CONFIG.normalSensitivity;\n  public smoothedSensY: number = STEERING_CONFIG.normalSensitivity;\n\n  // Visual banking angle layered on the ship mesh for tactile feel\n  public visualBankAngle = 0;\n\n  // Live viewport-relative rounded-rectangle boundary & clamp state (zero per-frame allocations)\n  public readonly aimBoundary: RoundedRectBoundary = createRoundedRectBoundary();\n  public readonly aimClamp: RoundedRectClampResult = createRoundedRectClampResult();\n\n  private lastViewportWidth = 0;\n  private lastViewportHeight = 0;\n\n  private ship: ShipConfig;\n  private boostEnergy: number;\n  private boostCooldownTimer = 0;\n  private boostLockedOut = false;\n  private boostIntensity = 0;\n  private wasBoosting = false;\n  private hull: number;\n  private boostJustEngaged = false;\n\n  public constructor(ship: ShipConfig) {\n    this.ship = ship;\n    this.boostEnergy = ship.flight.maxBoostEnergy;\n    this.hull = ship.maxHull;\n  }\n\n  public setShipConfig(ship: ShipConfig): void {\n    this.ship = ship;\n    this.boostEnergy = Math.min(this.boostEnergy, ship.flight.maxBoostEnergy);\n    this.hull = ship.maxHull;\n  }\n\n  public centerAimCursor(): void {\n    this.virtualAimX = 0;\n    this.virtualAimY = 0;\n    this.aimCursorX = 0;\n    this.aimCursorY = 0;\n    this.smoothedSensX = STEERING_CONFIG.normalSensitivity;\n    this.smoothedSensY = STEERING_CONFIG.normalSensitivity;\n    clampToRoundedRect(0, 0, this.aimBoundary, this.aimClamp);\n  }\n\n  public reset(startPosition?: THREE.Vector3): void {\n    if (startPosition) {\n      this.position.copy(startPosition);\n    } else {\n      this.position.set(0, 12, 40);\n    }\n    this.quaternion.identity();\n    this.velocity.set(0, 0, -28);\n    this.yawVelocity = 0;\n    this.pitchVelocity = 0;\n    this.rollVelocity = 0;\n    this.virtualAimX = 0;\n    this.virtualAimY = 0;\n    this.aimCursorX = 0;\n    this.aimCursorY = 0;\n    this.smoothedSensX = STEERING_CONFIG.normalSensitivity;\n    this.smoothedSensY = STEERING_CONFIG.normalSensitivity;\n    clampToRoundedRect(0, 0, this.aimBoundary, this.aimClamp);\n    this.visualBankAngle = 0;\n    this.boostEnergy = this.ship.flight.maxBoostEnergy;\n    this.boostCooldownTimer = 0;\n    this.boostLockedOut = false;\n    this.boostIntensity = 0;\n    this.wasBoosting = false;\n    this.hull = this.ship.maxHull;\n  }\n\n  public getBoostJustEngaged(): boolean {\n    return this.boostJustEngaged;\n  }\n\n  /**\n   * Returns unit world-space firing direction with forward gimbal convergence\n   * toward the active bounded virtual aim offset.\n   */\n  public getAimDirectionWorld(out: THREE.Vector3): THREE.Vector3 {\n    const gimbalYaw = THREE.MathUtils.clamp(this.aimCursorX, -1, 1) * GIMBAL_MAX_YAW_RAD;\n    const gimbalPitch = THREE.MathUtils.clamp(-this.aimCursorY, -1, 1) * GIMBAL_MAX_PITCH_RAD;\n    _gimbalDirLocal.set(Math.sin(gimbalYaw), Math.sin(gimbalPitch), -1).normalize();\n    out.copy(_gimbalDirLocal).applyQuaternion(this.quaternion).normalize();\n    return out;\n  }\n\n  /**\n   * Computes the 3D world-space convergence point along the player\'s firing ray.\n   */\n  public getAimTargetPoint(out: THREE.Vector3, distance: number): THREE.Vector3 {\n    this.getAimDirectionWorld(out);\n    out.multiplyScalar(distance).add(this.position);\n    return out;\n  }\n\n  /**\n   * Advances arcade flight simulation by delta time `dt` (seconds) and writes live telemetry.\n   * Uses the current game viewport dimensions (viewportWidth x viewportHeight) for boundary geometry.\n   */\n  public update(\n    dt: number,\n    input: InputSnapshot,\n    settings: GameSettings,\n    telemetry: FlightTelemetry,\n    viewportWidth = typeof window !== \'undefined\' ? window.innerWidth : 1280,\n    viewportHeight = typeof window !== \'undefined\' ? window.innerHeight : 720,\n  ): void {\n    const profile = this.ship.flight;\n    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);\n    const vw = Math.max(1, viewportWidth);\n    const vh = Math.max(1, viewportHeight);\n\n    // Preserve proportional virtual aim offset across viewport resizes\n    if (this.lastViewportWidth > 0 && this.lastViewportHeight > 0) {\n      if (vw !== this.lastViewportWidth) {\n        this.virtualAimX *= vw / this.lastViewportWidth;\n      }\n      if (vh !== this.lastViewportHeight) {\n        this.virtualAimY *= vh / this.lastViewportHeight;\n      }\n    }\n    this.lastViewportWidth = vw;\n    this.lastViewportHeight = vh;\n\n    // 1. Recompute viewport-relative rounded-rectangle boundary (45% W x 45% H default)\n    computeRoundedRectBoundary(\n      vw,\n      vh,\n      settings.aimBoundaryWidth,\n      settings.aimBoundaryHeight,\n      settings.aimBoundaryCornerRadius,\n      this.aimBoundary,\n    );\n\n    // Evaluate pre-step clamp so we know current excess along each axis before integrating deltas\n    clampToRoundedRect(this.virtualAimX, this.virtualAimY, this.aimBoundary, this.aimClamp);\n\n    // 2. Accumulate unconstrained relative mouse displacement (zero hard input cutoff)\n    const baseSens = THREE.MathUtils.clamp(\n      settings.mouseSensitivity,\n      STEERING_BOUNDS.mouseSensitivity.min,\n      STEERING_BOUNDS.mouseSensitivity.max,\n    );\n    const accelDist = THREE.MathUtils.clamp(\n      settings.accelerationDistance,\n      STEERING_BOUNDS.accelerationDistance.min,\n      STEERING_BOUNDS.accelerationDistance.max,\n    );\n    const boundarySens = THREE.MathUtils.clamp(\n      settings.boundarySensitivity,\n      STEERING_BOUNDS.boundarySensitivity.min,\n      STEERING_BOUNDS.boundarySensitivity.max,\n    );\n    const maxSens = Math.max(\n      boundarySens + 0.1,\n      THREE.MathUtils.clamp(\n        settings.maxSensitivity,\n        STEERING_BOUNDS.maxSensitivity.min,\n        STEERING_BOUNDS.maxSensitivity.max,\n      ),\n    );\n    const curveExp = THREE.MathUtils.clamp(\n      settings.responseCurve,\n      STEERING_BOUNDS.responseCurve.min,\n      STEERING_BOUNDS.responseCurve.max,\n    );\n    const recoverySec = THREE.MathUtils.clamp(\n      settings.recoverySmoothing,\n      STEERING_BOUNDS.recoverySmoothing.min,\n      STEERING_BOUNDS.recoverySmoothing.max,\n    );\n    const ySign = settings.invertY ? -1 : 1;\n\n    if (input.mouseDeltaX !== 0) {\n      this.virtualAimX = accumulateAxisDisplacement(\n        this.virtualAimX,\n        this.aimClamp.clampedX,\n        this.aimClamp.excessX,\n        input.mouseDeltaX * baseSens,\n        accelDist,\n      );\n    }\n    if (input.mouseDeltaY !== 0) {\n      this.virtualAimY = accumulateAxisDisplacement(\n        this.virtualAimY,\n        this.aimClamp.clampedY,\n        this.aimClamp.excessY,\n        input.mouseDeltaY * baseSens * ySign,\n        accelDist,\n      );\n    }\n\n    // 3. Clamp virtual reticle strictly onto the rounded-rectangle boundary while preserving excess\n    clampToRoundedRect(this.virtualAimX, this.virtualAimY, this.aimBoundary, this.aimClamp);\n    this.aimCursorX = this.aimClamp.normalizedX;\n    this.aimCursorY = this.aimClamp.normalizedY;\n\n    // 4. Evaluate progressive sensitivity independently for horizontal (yaw) and vertical (pitch)\n    evaluateProgressiveAxisSensitivity(\n      Math.abs(this.aimClamp.clampedX),\n      this.aimClamp.axisBoundaryX,\n      this.aimClamp.excessX,\n      accelDist,\n      STEERING_CONFIG.normalSensitivity,\n      boundarySens,\n      maxSens,\n      curveExp,\n      _evalX,\n    );\n    evaluateProgressiveAxisSensitivity(\n      Math.abs(this.aimClamp.clampedY),\n      this.aimClamp.axisBoundaryY,\n      this.aimClamp.excessY,\n      accelDist,\n      STEERING_CONFIG.normalSensitivity,\n      boundarySens,\n      maxSens,\n      curveExp,\n      _evalY,\n    );\n\n    // Frame-rate independent smooth recovery (~0.12s) eliminates sudden sensitivity jumps\n    const recoveryAlpha = 1 - Math.exp(-safeDt / recoverySec);\n    this.smoothedSensX = THREE.MathUtils.lerp(\n      this.smoothedSensX,\n      _evalX.targetSensitivity,\n      recoveryAlpha,\n    );\n    this.smoothedSensY = THREE.MathUtils.lerp(\n      this.smoothedSensY,\n      _evalY.targetSensitivity,\n      recoveryAlpha,\n    );\n\n    // 5. Compute ship yaw and pitch rates from clamped deflection + progressive sensitivity\n    const deadzone = STEERING_CONFIG.deadzone;\n    const precExp = STEERING_CONFIG.precisionExponent;\n\n    let steerX = 0;\n    const absNormX = Math.abs(this.aimCursorX);\n    if (absNormX > deadzone) {\n      const uX = (absNormX - deadzone) / (1 - deadzone);\n      const baseSteerX = Math.sign(this.aimCursorX) * Math.pow(uX, precExp);\n      steerX = baseSteerX * this.smoothedSensX;\n    }\n\n    let steerY = 0;\n    const absNormY = Math.abs(this.aimCursorY);\n    if (absNormY > deadzone) {\n      const uY = (absNormY - deadzone) / (1 - deadzone);\n      const baseSteerY = Math.sign(this.aimCursorY) * Math.pow(uY, precExp);\n      steerY = baseSteerY * this.smoothedSensY;\n    }\n\n    // Optional arrow-key steering blends smoothly alongside mouse steering\n    let keyYaw = 0;\n    if (input.keyYawLeft) keyYaw += 0.85;\n    if (input.keyYawRight) keyYaw -= 0.85;\n    let keyPitch = 0;\n    if (input.keyPitchUp) keyPitch += 0.85;\n    if (input.keyPitchDown) keyPitch -= 0.85;\n\n    const targetYawRate =\n      THREE.MathUtils.clamp(\n        -steerX + keyYaw,\n        -STEERING_CONFIG.maxSafeYawMultiplier,\n        STEERING_CONFIG.maxSafeYawMultiplier,\n      ) * profile.yawSpeed;\n    const targetPitchRate =\n      THREE.MathUtils.clamp(\n        -steerY + keyPitch,\n        -STEERING_CONFIG.maxSafePitchMultiplier,\n        STEERING_CONFIG.maxSafePitchMultiplier,\n      ) * profile.pitchSpeed;\n\n    // Preserved Phase 1 snappy arcade turn response with controlled inertia (frame-rate independent)\n    const isSteering = Math.abs(targetYawRate) > 0.01 || Math.abs(targetPitchRate) > 0.01;\n    const responseLambda = profile.angularDamping * (isSteering ? 2.1 : 1.8);\n    const turnAlpha = 1 - Math.exp(-responseLambda * safeDt);\n    this.yawVelocity = THREE.MathUtils.lerp(this.yawVelocity, targetYawRate, turnAlpha);\n    this.pitchVelocity = THREE.MathUtils.lerp(this.pitchVelocity, targetPitchRate, turnAlpha);\n\n    const stepYaw = this.yawVelocity * safeDt;\n    const stepPitch = this.pitchVelocity * safeDt;\n\n    // 6. Independent Roll via A / D (exact Phase 1 roll feel preserved)\n    let rollDir = 0;\n    if (input.rollLeft) rollDir += 1;\n    if (input.rollRight) rollDir -= 1;\n    const targetRollRate = rollDir * profile.rollSpeed;\n    const rollAlpha = 1 - Math.exp(-(profile.angularDamping * 1.25) * safeDt);\n    this.rollVelocity = THREE.MathUtils.lerp(this.rollVelocity, targetRollRate, rollAlpha);\n    const stepRoll = this.rollVelocity * safeDt;\n\n    // 7. Apply Pure Local-Space Quaternion Rotations (Zero Gimbal Lock at any pitch/yaw)\n    _qYaw.setFromAxisAngle(_AXIS_Y, stepYaw);\n    _qPitch.setFromAxisAngle(_AXIS_X, stepPitch);\n    _qRoll.setFromAxisAngle(_AXIS_Z, stepRoll);\n\n    this.quaternion.multiply(_qYaw);\n    this.quaternion.multiply(_qPitch);\n    this.quaternion.multiply(_qRoll);\n    this.quaternion.normalize();\n\n    // Subtle visual bank when yawing without overriding deliberate A/D roll\n    const targetBank = THREE.MathUtils.clamp(\n      (this.yawVelocity / profile.yawSpeed) * profile.visualBankStrength,\n      -0.44,\n      0.44,\n    );\n    this.visualBankAngle = THREE.MathUtils.damp(this.visualBankAngle, targetBank, 6.5, safeDt);\n\n    // 8. Boost energy management (exact Phase 1 behavior preserved)\n    if (this.boostLockedOut && this.boostEnergy >= 18) {\n      this.boostLockedOut = false;\n    }\n\n    const wantsBoost = input.boost && !input.backward && !this.boostLockedOut && this.boostEnergy > 0.5;\n    const isBoosting = wantsBoost;\n    this.boostJustEngaged = isBoosting && !this.wasBoosting;\n    this.wasBoosting = isBoosting;\n\n    if (isBoosting) {\n      this.boostEnergy = Math.max(0, this.boostEnergy - profile.boostDrainRate * safeDt);\n      this.boostCooldownTimer = profile.boostRegenDelay;\n      if (this.boostEnergy <= 0.1) {\n        this.boostEnergy = 0;\n        this.boostLockedOut = true;\n      }\n    } else {\n      if (this.boostCooldownTimer > 0) {\n        this.boostCooldownTimer = Math.max(0, this.boostCooldownTimer - safeDt);\n      } else if (this.boostEnergy < profile.maxBoostEnergy) {\n        this.boostEnergy = Math.min(\n          profile.maxBoostEnergy,\n          this.boostEnergy + profile.boostRegenRate * safeDt,\n        );\n      }\n    }\n\n    this.boostIntensity = THREE.MathUtils.damp(\n      this.boostIntensity,\n      isBoosting ? 1 : 0,\n      isBoosting ? 9.0 : 5.5,\n      safeDt,\n    );\n\n    // 9. Linear thrust, controlled arcade inertia, and lateral redirection (exact Phase 1 physics)\n    _forwardWorld.copy(_FORWARD_LOCAL).applyQuaternion(this.quaternion).normalize();\n    _rightWorld.copy(_AXIS_X).applyQuaternion(this.quaternion).normalize();\n    _upWorld.copy(_AXIS_Y).applyQuaternion(this.quaternion).normalize();\n\n    const currentForwardSpeed = this.velocity.dot(_forwardWorld);\n    const effectiveMaxSpeed = isBoosting\n      ? profile.maxSpeed * profile.boostMultiplier\n      : profile.maxSpeed;\n\n    let nextForwardSpeed = currentForwardSpeed;\n    let throttle = 0;\n\n    if (isBoosting) {\n      throttle = 1;\n      const boostAccel = profile.acceleration * profile.boostAccelMultiplier;\n      nextForwardSpeed = Math.min(effectiveMaxSpeed, currentForwardSpeed + boostAccel * safeDt);\n    } else if (input.forward && !input.backward) {\n      throttle = 1;\n      if (currentForwardSpeed > profile.maxSpeed) {\n        nextForwardSpeed = THREE.MathUtils.damp(currentForwardSpeed, profile.maxSpeed, 2.2, safeDt);\n      } else {\n        nextForwardSpeed = Math.min(\n          profile.maxSpeed,\n          currentForwardSpeed + profile.acceleration * safeDt,\n        );\n      }\n    } else if (input.backward && !input.forward) {\n      throttle = -1;\n      nextForwardSpeed = Math.max(\n        -profile.maxReverseSpeed,\n        currentForwardSpeed - profile.deceleration * safeDt,\n      );\n    } else {\n      const dragFactor = Math.exp(-profile.passiveDrag * safeDt);\n      nextForwardSpeed = currentForwardSpeed * dragFactor;\n      if (Math.abs(nextForwardSpeed) < 0.15) nextForwardSpeed = 0;\n    }\n\n    _desiredVel.copy(_forwardWorld).multiplyScalar(nextForwardSpeed);\n    const gripLambda = isBoosting ? profile.lateralGrip * 1.45 : profile.lateralGrip;\n    const gripAlpha = 1 - Math.exp(-gripLambda * safeDt);\n    this.velocity.lerp(_desiredVel, gripAlpha);\n\n    const updatedForward = this.velocity.dot(_forwardWorld);\n    this.velocity.addScaledVector(_forwardWorld, nextForwardSpeed - updatedForward);\n\n    this.position.addScaledVector(this.velocity, safeDt);\n\n    // 10. Populate live HUD telemetry (in-place mutation, zero allocations)\n    const speedMag = this.velocity.length();\n    const signedSpeed = this.velocity.dot(_forwardWorld);\n\n    _euler.setFromQuaternion(this.quaternion, \'YXZ\');\n    let headingDeg = THREE.MathUtils.radToDeg(-_euler.y) % 360;\n    if (headingDeg < 0) headingDeg += 360;\n\n    let status: FlightStatus = \'DRIFTING\';\n    if (this.boostLockedOut && input.boost) {\n      status = \'BOOST DEPLETED\';\n    } else if (isBoosting) {\n      status = \'BOOSTING\';\n    } else if (signedSpeed < -2.5) {\n      status = \'REVERSING\';\n    } else if (input.forward) {\n      status = speedMag > profile.maxSpeed * 0.9 ? \'CRUISING\' : \'ACCELERATING\';\n    } else if (speedMag < 2) {\n      status = \'STANDBY\';\n    } else {\n      status = \'DRIFTING\';\n    }\n\n    telemetry.speed = speedMag;\n    telemetry.signedSpeed = signedSpeed;\n    telemetry.maxSpeed = profile.maxSpeed;\n    telemetry.effectiveMaxSpeed = effectiveMaxSpeed;\n    telemetry.throttle = throttle;\n    telemetry.boostEnergy = this.boostEnergy;\n    telemetry.maxBoostEnergy = profile.maxBoostEnergy;\n    telemetry.isBoosting = isBoosting;\n    telemetry.boostDepleted = this.boostLockedOut;\n    telemetry.boostIntensity = this.boostIntensity;\n    telemetry.hull = this.hull;\n    telemetry.maxHull = this.ship.maxHull;\n    telemetry.yawRate = THREE.MathUtils.clamp(this.yawVelocity / profile.yawSpeed, -1, 1);\n    telemetry.pitchRate = THREE.MathUtils.clamp(this.pitchVelocity / profile.pitchSpeed, -1, 1);\n    telemetry.rollRate = THREE.MathUtils.clamp(this.rollVelocity / profile.rollSpeed, -1, 1);\n    telemetry.aimNormalizedX = this.aimCursorX;\n    telemetry.aimNormalizedY = this.aimCursorY;\n\n    // Strictly bounded virtual reticle coordinates inside the rounded-rectangle precision region\n    telemetry.aimScreenX = this.aimClamp.screenX;\n    telemetry.aimScreenY = this.aimClamp.screenY;\n    telemetry.aimBoundaryWidthPx = this.aimBoundary.widthPx;\n    telemetry.aimBoundaryHeightPx = this.aimBoundary.heightPx;\n    telemetry.aimBoundaryCornerRadiusPx = this.aimBoundary.cornerRadiusPx;\n    telemetry.aimExcessX = this.aimClamp.excessX;\n    telemetry.aimExcessY = this.aimClamp.excessY;\n\n    const activeZone: SteeringZone =\n      _evalX.zone === \'acceleration\' || _evalY.zone === \'acceleration\'\n        ? \'acceleration\'\n        : _evalX.zone === \'transition\' || _evalY.zone === \'transition\'\n          ? \'transition\'\n          : \'precision\';\n    telemetry.steeringZone = activeZone;\n    telemetry.steeringSensitivityX = this.smoothedSensX;\n    telemetry.steeringSensitivityY = this.smoothedSensY;\n    telemetry.steeringAccelRatio = Math.max(_evalX.curveFactor, _evalY.curveFactor);\n\n    telemetry.headingDeg = headingDeg;\n    telemetry.pitchDeg = THREE.MathUtils.radToDeg(_euler.x);\n    telemetry.rollDeg = THREE.MathUtils.radToDeg(_euler.z);\n    telemetry.altitude = this.position.y;\n    telemetry.status = status;\n    telemetry.pointerLocked = input.pointerLocked;\n  }\n}\n"
