    end_line: 257
    content: "import type { GameSettings, ShipConfig, ShipId } from \'../types/game\';\n\nexport const SHIP_CONFIGS: Record<ShipId, ShipConfig> = {\n  interceptor: {\n    id: \'interceptor\',\n    callsign: \'VX-9 VANGUARD\',\n    name: \'Interceptor\',\n    role: \'High-Speed Recon & Dogfighter\',\n    description:\n      \'Needle-profile space superiority fighter built around twin vector plasma thrusters. Unmatched acceleration, snap roll authority, and aggressive turn rate.\',\n    playableInPhase1: true,\n    unlockNote: \'Active Flight Prototype\',\n    maxHull: 100,\n    ratings: {\n      speed: 96,\n      maneuverability: 94,\n      hull: 52,\n      firepower: 68,\n    },\n    colors: {\n      hullPrimary: \'#1e293b\',\n      hullSecondary: \'#0f172a\',\n      hullTrim: \'#38bdf8\',\n      canopy: \'#071426\',\n      engineCore: \'#e0f2fe\',\n      engineGlow: \'#06b6d4\',\n    },\n    flight: {\n      maxSpeed: 135,\n      maxReverseSpeed: 42,\n      acceleration: 95,\n      deceleration: 120,\n      passiveDrag: 0.72,\n      lateralGrip: 4.8,\n      boostMultiplier: 1.85,\n      boostAccelMultiplier: 2.35,\n      maxBoostEnergy: 100,\n      boostDrainRate: 26,\n      boostRegenRate: 18,\n      boostRegenDelay: 0.65,\n      yawSpeed: 2.1,\n      pitchSpeed: 1.95,\n      rollSpeed: 3.1,\n      angularDamping: 7.5,\n      visualBankStrength: 0.34,\n    },\n    weapons: {\n      primaryName: \'Twin Pulse Cannons\',\n      damageRating: 68,\n      fireRateRating: 92,\n    },\n  },\n  striker: {\n    id: \'striker\',\n    callsign: \'SR-4 VALKYRIE\',\n    name: \'Striker\',\n    role: \'Multi-Role Assault Fighter\',\n    description:\n      \'Balanced forward-wing strike craft engineered for sustained dogfights. Combines reliable hull plating with versatile weapon hardpoints.\',\n    playableInPhase1: false,\n    unlockNote: \'Coming Soon \342\200\224 Unlockable in Combat Campaign\',\n    maxHull: 150,\n    ratings: {\n      speed: 78,\n      maneuverability: 79,\n      hull: 76,\n      firepower: 80,\n    },\n    colors: {\n      hullPrimary: \'#273549\',\n      hullSecondary: \'#111827\',\n      hullTrim: \'#60a5fa\',\n      canopy: \'#0b192c\',\n      engineCore: \'#dbeafe\',\n      engineGlow: \'#3b82f6\',\n    },\n    flight: {\n      maxSpeed: 118,\n      maxReverseSpeed: 36,\n      acceleration: 82,\n      deceleration: 105,\n      passiveDrag: 0.8,\n      lateralGrip: 4.2,\n      boostMultiplier: 1.72,\n      boostAccelMultiplier: 2.1,\n      maxBoostEnergy: 100,\n      boostDrainRate: 28,\n      boostRegenRate: 16,\n      boostRegenDelay: 0.75,\n      yawSpeed: 1.8,\n      pitchSpeed: 1.7,\n      rollSpeed: 2.55,\n      angularDamping: 6.8,\n      visualBankStrength: 0.28,\n    },\n    weapons: {\n      primaryName: \'Quad Plasma Repeaters\',\n      damageRating: 80,\n      fireRateRating: 78,\n    },\n  },\n  destroyer: {\n    id: \'destroyer\',\n    callsign: \'HX-12 AEGIS\',\n    name: \'Destroyer\',\n    role: \'Heavy Gunship & Breaker\',\n    description:\n      \'Armored heavy assault hull outfitted with twin rail-accelerators and triple drive cores. Built to absorb punishment and dominate fleet engagements.\',\n    playableInPhase1: false,\n    unlockNote: \'Coming Soon \342\200\224 Unlockable via Mission Rank Progression\',\n    maxHull: 230,\n    ratings: {\n      speed: 62,\n      maneuverability: 58,\n      hull: 98,\n      firepower: 96,\n    },\n    colors: {\n      hullPrimary: \'#1f2937\',\n      hullSecondary: \'#0c1220\',\n      hullTrim: \'#0ea5e9\',\n      canopy: \'#061322\',\n      engineCore: \'#cffafe\',\n      engineGlow: \'#0284c7\',\n    },\n    flight: {\n      maxSpeed: 98,\n      maxReverseSpeed: 30,\n      acceleration: 65,\n      deceleration: 88,\n      passiveDrag: 0.85,\n      lateralGrip: 3.5,\n      boostMultiplier: 1.62,\n      boostAccelMultiplier: 1.9,\n      maxBoostEnergy: 100,\n      boostDrainRate: 30,\n      boostRegenRate: 15,\n      boostRegenDelay: 0.85,\n      yawSpeed: 1.4,\n      pitchSpeed: 1.32,\n      rollSpeed: 1.95,\n      angularDamping: 5.8,\n      visualBankStrength: 0.2,\n    },\n    weapons: {\n      primaryName: \'Dual Heavy Rail Cannons\',\n      damageRating: 96,\n      fireRateRating: 58,\n    },\n  },\n};\n\nexport const SHIP_ORDER: ShipId[] = [\'interceptor\', \'striker\', \'destroyer\'];\n\nexport const DEFAULT_SETTINGS: GameSettings = {\n  mouseSensitivity: 1.0,\n  boundarySensitivity: 0.35,\n  maxSensitivity: 2.5,\n  accelerationDistance: 240,\n  responseCurve: 2.0,\n  aimBoundarySize: 0.25,\n  invertY: false,\n  cameraDistance: 9.8,\n  cameraSensitivity: 1.0,\n  masterVolume: 0.65,\n  graphicsQuality: \'high\',\n  resolutionScale: 1.0,\n  shadowQuality: \'medium\',\n  particleQuality: \'high\',\n  environmentDetail: \'high\',\n  drawDistance: 4200,\n  antialias: true,\n  postGlowEnabled: true,\n  showPerfOverlay: false,\n};\n\nconst SETTINGS_STORAGE_KEY = \'starfall.settings.v2\';\nconst LEGACY_SETTINGS_KEY = \'starfall.settings.v1\';\n\nfunction clampNumber(value: unknown, min: number, max: number, fallback: number): number {\n  return typeof value === \'number\' && Number.isFinite(value)\n    ? Math.max(min, Math.min(max, value))\n    : fallback;\n}\n\nexport function loadSavedSettings(): GameSettings {\n  try {\n    const raw =\n      window.localStorage.getItem(SETTINGS_STORAGE_KEY) ??\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY);\n    if (!raw) return { ...DEFAULT_SETTINGS };\n    const parsed = JSON.parse(raw) as Partial<GameSettings>;\n    const validQuality =\n      parsed.graphicsQuality === \'low\' ||\n      parsed.graphicsQuality === \'medium\' ||\n      parsed.graphicsQuality === \'high\' ||\n      parsed.graphicsQuality === \'ultra\'\n        ? parsed.graphicsQuality\n        : DEFAULT_SETTINGS.graphicsQuality;\n\n    const boundarySensitivity = clampNumber(\n      parsed.boundarySensitivity,\n      0.15,\n      1.0,\n      DEFAULT_SETTINGS.boundarySensitivity,\n    );\n    const maxSensitivity = Math.max(\n      boundarySensitivity + 0.2,\n      clampNumber(parsed.maxSensitivity, 1.2, 3.5, DEFAULT_SETTINGS.maxSensitivity),\n    );\n\n    return {\n      ...DEFAULT_SETTINGS,\n      ...parsed,\n      mouseSensitivity: clampNumber(\n        parsed.mouseSensitivity,\n        0.3,\n        2.5,\n        DEFAULT_SETTINGS.mouseSensitivity,\n      ),\n      boundarySensitivity,\n      maxSensitivity,\n      accelerationDistance: clampNumber(\n        parsed.accelerationDistance,\n        80,\n        500,\n        DEFAULT_SETTINGS.accelerationDistance,\n      ),\n      responseCurve: clampNumber(parsed.responseCurve, 1.0, 3.5, DEFAULT_SETTINGS.responseCurve),\n      aimBoundarySize: clampNumber(\n        parsed.aimBoundarySize,\n        0.15,\n        0.38,\n        DEFAULT_SETTINGS.aimBoundarySize,\n      ),\n      graphicsQuality: validQuality,\n      resolutionScale: clampNumber(\n        parsed.resolutionScale,\n        0.65,\n        1.0,\n        DEFAULT_SETTINGS.resolutionScale,\n      ),\n      drawDistance: clampNumber(parsed.drawDistance, 2000, 5200, DEFAULT_SETTINGS.drawDistance),\n      showPerfOverlay: import.meta.env.DEV ? Boolean(parsed.showPerfOverlay) : false,\n    };\n  } catch {\n    return { ...DEFAULT_SETTINGS };\n  }\n}\n\nexport function saveSettings(settings: GameSettings): void {\n  try {\n    window.localStorage.setItem(SETTINGS_STORAGE_KEY, JSON.stringify(settings));\n  } catch {\n    // Ignore storage quota / privacy mode errors\n  }\n}\n"
