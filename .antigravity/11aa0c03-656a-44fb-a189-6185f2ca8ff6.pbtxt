              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (input.mouseDeltaY !== 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      this.virtualAimY = accumulateAxisDisplacement("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
