      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Preserve 40:45 width-to-height ratio when adjusting the Aim Boundary slider in SettingsPanel\", \"EndLine\":297, \"Instruction\":\"Scale aimBoundaryHeight proportionally with aimBoundaryWidth using the configured 45:40 ratio\", \"ReplacementContent\":\"                onChange={(e) => {\\n                  const w = parseFloat(e.target.value);\\n                  const h = Math.min(\\n                    STEERING_BOUNDS.aimBoundaryHeight.max,\\n                    Math.max(\\n                      STEERING_BOUNDS.aimBoundaryHeight.min,\\n                      Number(\\n                        (\\n                          w *\\n                          (STEERING_CONFIG.aimBoundaryHeight / STEERING_CONFIG.aimBoundaryWidth)\\n                        ).toFixed(2),\\n                      ),\\n                    ),\\n                  );\\n                  onUpdateSettings({ aimBoundaryWidth: w, aimBoundaryHeight: h });\\n                }}\", \"StartLine\":289, \"TargetContent\":\"                onChange={(e) => {\\n                  const v = parseFloat(e.target.value);\\n                  onUpdateSettings({ aimBoundaryWidth: v, aimBoundaryHeight: v });\\n                }}\", \"TargetFile\":\"/src/components/SettingsPanel.tsx\", \"toolAction\":\"Updating SettingsPanel.tsx boundary slider\", \"toolSummary\":\"Update SettingsPanel.tsx boundary slider\"}"
      original_name: "replace_file_content"
    }
