    command_line: "node --input-type=module -e \'\nimport { createRequire } from \"module\";\nconst require = createRequire(import.meta.url);\nconst { chromium } = require(\"/usr/local/share/bun-global/node_modules/playwright\");\n\nconst results = [];\nfunction assert(name, condition, detail = \"\") {\n  results.push({ name, pass: Boolean(condition), detail });\n  if (!condition) console.error(\"FAIL:\", name, detail);\n  else console.log(\"PASS:\", name, detail);\n}\n\nconst browser = await chromium.launch({\n  headless: true,\n  args: [\n    \"--use-gl=angle\",\n    \"--use-angle=swiftshader\",\n    \"--enable-unsafe-swiftshader\",\n    \"--ignore-gpu-blocklist\",\n    \"--no-sandbox\",\n  ],\n});\n\nconst context = await browser.newContext({ viewport: { width: 1280, height: 720 } });\nconst page = await context.newPage();\n\nconst consoleErrors = [];\nconst pageErrors = [];\npage.on(\"console\", (msg) => {\n  if (msg.type() === \"error\") consoleErrors.push(msg.text());\n});\npage.on(\"pageerror\", (err) => pageErrors.push(String(err)));\n\nawait page.goto(\"http://localhost:3000\", { waitUntil: \"networkidle\" });\nawait page.waitForSelector(\"canvas\", { timeout: 15000 });\n\n// Check Settings UI displays 40% x 45% and switch graphics to Low for fast SwiftShader test\nawait page.getByRole(\"button\", { name: /Settings/i }).click();\nawait page.waitForTimeout(200);\nconst settingsBody = await page.locator(\"body\").innerText();\nassert(\"Settings panel displays 40% \303\227 45% Aim Boundary (defaults)\", settingsBody.includes(\"40% \303\227 45%\") && settingsBody.includes(\"0.35x\") && settingsBody.includes(\"2.50x\") && settingsBody.includes(\"240 px\") && settingsBody.includes(\"p=2.0\"), \"Defaults verified in Settings UI\");\nawait page.getByRole(\"button\", { name: /^Low$/i }).first().click();\nawait page.getByRole(\"button\", { name: /Return to Menu/i }).click();\nawait page.waitForTimeout(200);\n\n// Launch Mission 01\nawait page.getByRole(\"button\", { name: /Campaign Missions/i }).click();\nawait page.waitForTimeout(200);\nawait page.getByRole(\"button\", { name: /^Launch /i }).click();\n\nfor (let i = 0; i < 60; i++) {\n  const phase = await page.evaluate(() => window.__STARFALL_DIAG__?.getPhase?.());\n  if (phase === \"playing\") break;\n  await page.waitForTimeout(200);\n}\n\nasync function waitRaf(count = 4) {\n  await page.evaluate(\n    (n) =>\n      new Promise((resolve) => {\n        let i = 0;\n        const step = () => {\n          i += 1;\n          if (i >= n) resolve();\n          else requestAnimationFrame(step);\n        };\n        requestAnimationFrame(step);\n      }),\n    count,\n  );\n}\n\nawait waitRaf(4);\n\n// Engage Pointer Lock via HUD button or canvas click\nconst lockBtn = page.getByRole(\"button\", { name: /Pointer Lock|Engage/i });\nif (await lockBtn.isVisible().catch(() => false)) {\n  await lockBtn.click();\n} else {\n  await page.locator(\"canvas\").click();\n}\nawait waitRaf(3);\n\nconst lockState = await page.evaluate(() => ({\n  nativePointerLockElementTag: document.pointerLockElement?.tagName ?? null,\n  lockOwned: window.__STARFALL_DIAG__.getInput().isPointerLocked(),\n}));\nassert(\"Pointer Lock engaged natively on WebGL canvas\", lockState.lockOwned && lockState.nativePointerLockElementTag === \"CANVAS\", JSON.stringify(lockState));\n\nasync function moveMouseRelative(dx, dy, steps = 4, edgeX = 640, edgeY = 360) {\n  const stepX = dx / steps;\n  const stepY = dy / steps;\n  for (let i = 0; i < steps; i++) {\n    await page.evaluate(({ sx, sy, ex, ey }) => {\n      const ev = new MouseEvent(\"mousemove\", {\n        bubbles: true,\n        cancelable: true,\n        clientX: ex,\n        clientY: ey,\n      });\n      Object.defineProperty(ev, \"movementX\", { value: sx });\n      Object.defineProperty(ev, \"movementY\", { value: sy });\n      window.dispatchEvent(ev);\n    }, { sx: stepX, sy: stepY, ex: edgeX, ey: edgeY });\n    await waitRaf(2);\n  }\n}\n\n// 1, 2, 3. Verify 1280x720 boundary geometry (40% x 45% rounded rectangle)\nconst b1280 = await page.evaluate(() => {\n  const el = document.querySelector(\"[data-testid=\\\"aim-boundary-frame\\\"]\");\n  const paths = Array.from(el?.querySelectorAll(\"path\") ?? []).map((p) => p.getAttribute(\"d\") || \"\");\n  const f = window.__STARFALL_DIAG__.getFlight();\n  return {\n    shape: el?.dataset.shape,\n    hudW: Number(el?.dataset.widthPx),\n    hudH: Number(el?.dataset.heightPx),\n    hudR: Number(el?.dataset.cornerRadiusPx),\n    pathCount: paths.length,\n    allHaveArcs: paths.length === 4 && paths.every((d) => d.includes(\" A \")),\n    engineW: f.aimBoundary.widthPx,\n    engineH: f.aimBoundary.heightPx,\n    engineHalfW: f.aimBoundary.halfW,\n    engineHalfH: f.aimBoundary.halfH,\n    engineR: f.aimBoundary.cornerRadiusPx,\n  };\n});\nassert(\"1280x720 aim boundary width = 40% (512px, half 256px)\", Math.abs(b1280.engineW - 512) < 0.5 && Math.abs(b1280.hudW - 512) < 0.5 && Math.abs(b1280.engineHalfW - 256) < 0.5, JSON.stringify(b1280));\nassert(\"1280x720 aim boundary height = 45% (324px, half 162px)\", Math.abs(b1280.engineH - 324) < 0.5 && Math.abs(b1280.hudH - 324) < 0.5 && Math.abs(b1280.engineHalfH - 162) < 0.5, JSON.stringify(b1280));\nassert(\"Rounded-rectangle subtle 4-corner SVG markings\", b1280.shape === \"rounded-rect\" && b1280.allHaveArcs && Math.abs(b1280.engineR - 40.5) < 0.5, `r=${b1280.engineR}, paths=${b1280.pathCount}`);\n\n// 5. Zone A - Precision steering inside 40% x 45% boundary\nawait page.evaluate(() => window.__STARFALL_DIAG__.getFlight().centerAimCursor());\nawait waitRaf(2);\nawait moveMouseRelative(140, 0, 4, 640, 360);\nawait waitRaf(6);\nconst zoneA = await page.evaluate(() => {\n  const t = window.__STARFALL_DIAG__.getTelemetry();\n  const f = window.__STARFALL_DIAG__.getFlight();\n  return {\n    zone: t.steeringZone,\n    sensX: t.steeringSensitivityX,\n    sensY: t.steeringSensitivityY,\n    screenX: t.aimScreenX,\n    excessX: t.aimExcessX,\n    rawX: f.virtualAimX,\n    yawVel: f.yawVelocity,\n  };\n});\nassert(\"Zone A precision inside boundary (sens=1.0, zero excess, active yaw)\", zoneA.zone === \"precision\" && Math.abs(zoneA.sensX - 1.0) < 0.02 && zoneA.excessX === 0 && Math.abs(zoneA.yawVel) > 0.2, JSON.stringify(zoneA));\n\n// 6. Zone B - Reaching & crossing 40% width boundary (halfW = 256px) slows sensitivity & clamps reticle to 0.700\n// rawX = 140px; add +138px -> rawX = 278px (excess = 22px)\nawait moveMouseRelative(138, 0, 4, 1279, 360);\nawait waitRaf(10);\nconst zoneB = await page.evaluate(() => {\n  const t = window.__STARFALL_DIAG__.getTelemetry();\n  const f = window.__STARFALL_DIAG__.getFlight();\n  return {\n    zone: t.steeringZone,\n    sensX: t.steeringSensitivityX,\n    sensY: t.steeringSensitivityY,\n    screenX: t.aimScreenX,\n    excessX: t.aimExcessX,\n    rawX: f.virtualAimX,\n    yawVel: f.yawVelocity,\n    heading1: t.headingDeg,\n  };\n});\nassert(\"Zone B transition slows sensitivity at boundary & clamps reticle strictly to 0.700\", zoneB.zone === \"transition\" && zoneB.sensX < 0.55 && zoneB.sensX >= 0.34 && Math.abs(zoneB.screenX - 0.7) < 0.001 && zoneB.excessX > 15, JSON.stringify(zoneB));\nassert(\"Independent axes: Y stays precision 1.0 while X is in transition\", Math.abs(zoneB.sensY - 1.0) < 0.02, `sensY=${zoneB.sensY}`);\n\n// 10. Ship continues turning while reticle stays at boundary\nawait waitRaf(8);\nconst headingAfterHold = await page.evaluate(() => window.__STARFALL_DIAG__.getTelemetry().headingDeg);\nlet headingDeltaHold = Math.abs(headingAfterHold - zoneB.heading1);\nif (headingDeltaHold > 180) headingDeltaHold = 360 - headingDeltaHold;\nassert(\"Ship does NOT stop turning when reticle is held at boundary\", headingDeltaHold > 5.0, `h1=${zoneB.heading1.toFixed(1)}, h2=${headingAfterHold.toFixed(1)}, delta=${headingDeltaHold.toFixed(1)} deg`);\n\n// 7 & 9. Zone C - Continued outward movement at physical screen edge progressively accelerates turning\nawait moveMouseRelative(240, 0, 4, 1279, 360);\nawait waitRaf(12);\nconst zoneC1 = await page.evaluate(() => {\n  const t = window.__STARFALL_DIAG__.getTelemetry();\n  const f = window.__STARFALL_DIAG__.getFlight();\n  return { zone: t.steeringZone, sensX: t.steeringSensitivityX, screenX: t.aimScreenX, excessX: t.aimExcessX, absYaw: Math.abs(f.yawVelocity) };\n});\n\nawait moveMouseRelative(480, 0, 6, 1279, 360);\nawait waitRaf(12);\nconst zoneC2 = await page.evaluate(() => {\n  const t = window.__STARFALL_DIAG__.getTelemetry();\n  const f = window.__STARFALL_DIAG__.getFlight();\n  return { zone: t.steeringZone, sensX: t.steeringSensitivityX, screenX: t.aimScreenX, excessX: t.aimExcessX, absYaw: Math.abs(f.yawVelocity) };\n});\n\nassert(\"Zone C progressive acceleration increases sensitivity & yaw monotonically\", zoneC1.zone === \"acceleration\" && zoneC2.zone === \"acceleration\" && zoneC1.sensX > 1.3 && zoneC2.sensX > zoneC1.sensX + 0.5 && zoneC2.absYaw > zoneC1.absYaw + 0.8 && zoneC2.sensX <= 2.5, JSON.stringify({ zoneC1, zoneC2 }));\nassert(\"Reticle NEVER escapes right boundary (0.700) during deep Zone C overdrive\", Math.abs(zoneC1.screenX - 0.7) < 0.001 && Math.abs(zoneC2.screenX - 0.7) < 0.001, `c1=${zoneC1.screenX}, c2=${zoneC2.screenX}`);\n\n// 3b & 4. Rounded-rectangle corner clamping test\nawait page.evaluate(() => window.__STARFALL_DIAG__.getFlight().centerAimCursor());\nawait waitRaf(2);\nawait moveMouseRelative(700, 700, 5, 1279, 719);\nawait waitRaf(4);\nconst cornerRes = await page.evaluate(() => {\n  const f = window.__STARFALL_DIAG__.getFlight();\n  const b = f.aimBoundary;\n  const c = f.aimClamp;\n  const distFromCornerCenter = Math.hypot(Math.abs(c.clampedX) - b.innerHalfW, Math.abs(c.clampedY) - b.innerHalfH);\n  return {\n    clampedX: c.clampedX,\n    clampedY: c.clampedY,\n    halfW: b.halfW,\n    halfH: b.halfH,\n    r: b.cornerRadiusPx,\n    distFromCornerCenter,\n    strictlyInsideBoxCorner: Math.abs(c.clampedX) < b.halfW - 5 && Math.abs(c.clampedY) < b.halfH - 5,\n    onCornerArc: Math.abs(distFromCornerCenter - b.cornerRadiusPx) < 0.5,\n    excessX: c.excessX,\n    excessY: c.excessY,\n  };\n});\nassert(\"Rounded-rectangle corner clamps onto circular arc (not square corner) & preserves X/Y excess\", cornerRes.strictlyInsideBoxCorner && cornerRes.onCornerArc && cornerRes.excessX > 100 && cornerRes.excessY > 100, JSON.stringify(cornerRes));\n\n// 8. Returning inward smoothly restores precision steering\nawait page.evaluate(() => window.__STARFALL_DIAG__.getFlight().centerAimCursor());\nawait waitRaf(2);\nawait moveMouseRelative(500, 0, 5, 1279, 360);\nawait waitRaf(10);\nconst beforeReturn = await page.evaluate(() => window.__STARFALL_DIAG__.getTelemetry().steeringZone);\nawait moveMouseRelative(-380, 0, 5, 0, 360);\nawait waitRaf(12);\nconst afterReturn = await page.evaluate(() => {\n  const t = window.__STARFALL_DIAG__.getTelemetry();\n  return { zone: t.steeringZone, sensX: t.steeringSensitivityX, excessX: t.aimExcessX, screenX: t.aimScreenX };\n});\nassert(\"Returning inward smoothly restores precision steering (~1.0x)\", beforeReturn === \"acceleration\" && afterReturn.zone === \"precision\" && Math.abs(afterReturn.sensX - 1.0) < 0.05 && afterReturn.excessX === 0, JSON.stringify({ beforeReturn, afterReturn }));\n\n// 13. Resize viewport across multiple aspect ratios (4:3 1024x768 and 21:9 1440x600)\nawait page.setViewportSize({ width: 1024, height: 768 });\nawait waitRaf(6);\nawait moveMouseRelative(400, 400, 4, 1023, 767);\nawait waitRaf(4);\nconst b1024 = await page.evaluate(() => {\n  const el = document.querySelector(\"[data-testid=\\\"aim-boundary-frame\\\"]\");\n  const f = window.__STARFALL_DIAG__.getFlight();\n  const c = f.aimClamp;\n  const b = f.aimBoundary;\n  return {\n    hudW: Number(el?.dataset.widthPx),\n    hudH: Number(el?.dataset.heightPx),\n    engineW: b.widthPx,\n    engineH: b.heightPx,\n    r: b.cornerRadiusPx,\n    insideRoundedRect: Math.abs(c.clampedX) <= b.halfW + 0.01 && Math.abs(c.clampedY) <= b.halfH + 0.01,\n  };\n});\nassert(\"Resize to 1024x768 (4:3) updates boundary to 409.6x345.6 & keeps reticle clamped\", Math.abs(b1024.engineW - 409.6) < 0.6 && Math.abs(b1024.engineH - 345.6) < 0.6 && Math.abs(b1024.hudW - 409.6) < 0.6 && Math.abs(b1024.hudH - 345.6) < 0.6 && b1024.insideRoundedRect, JSON.stringify(b1024));\n\nawait page.setViewportSize({ width: 1440, height: 600 });\nawait waitRaf(8);\nconst b1440 = await page.evaluate(() => {\n  const el = document.querySelector(\"[data-testid=\\\"aim-boundary-frame\\\"]\");\n  const f = window.__STARFALL_DIAG__.getFlight();\n  const c = f.aimClamp;\n  const b = f.aimBoundary;\n  return {\n    hudW: Number(el?.dataset.widthPx),\n    hudH: Number(el?.dataset.heightPx),\n    engineW: b.widthPx,\n    engineH: b.heightPx,\n    r: b.cornerRadiusPx,\n    insideRoundedRect: Math.abs(c.clampedX) <= b.halfW + 0.01 && Math.abs(c.clampedY) <= b.halfH + 0.01,\n  };\n});\nassert(\"Resize to 1440x600 (21:9) updates boundary to 576x270 & keeps reticle clamped\", Math.abs(b1440.engineW - 576) < 0.6 && Math.abs(b1440.engineH - 270) < 0.6 && Math.abs(b1440.hudW - 576) < 0.6 && Math.abs(b1440.hudH - 270) < 0.6 && b1440.insideRoundedRect, JSON.stringify(b1440));\n\nassert(\"Zero runtime console or page errors\", consoleErrors.length === 0 && pageErrors.length === 0, JSON.stringify({ consoleErrors, pageErrors }));\n\nawait browser.close();\n\nconst failed = results.filter((r) => !r.pass);\nconsole.log(`\\nSUMMARY: ${results.length - failed.length}/${results.length} passed`);\nif (failed.length > 0) process.exit(1);\n\'"
    proposed_command_line: "node --input-type=module -e \'\nimport { createRequire } from \"module\";\nconst require = createRequire(import.meta.url);\nconst { chromium } = require(\"/usr/local/share/bun-global/node_modules/playwright\");\n\nconst results = [];\nfunction assert(name, condition, detail = \"\") {\n  results.push({ name, pass: Boolean(condition), detail });\n  if (!condition) console.error(\"FAIL:\", name, detail);\n  else console.log(\"PASS:\", name, detail);\n}\n\nconst browser = await chromium.launch({\n  headless: true,\n  args: [\n    \"--use-gl=angle\",\n    \"--use-angle=swiftshader\",\n    \"--enable-unsafe-swiftshader\",\n    \"--ignore-gpu-blocklist\",\n    \"--no-sandbox\",\n  ],\n});\n\nconst context = await browser.newContext({ viewport: { width: 1280, height: 720 } });\nconst page = await context.newPage();\n\nconst consoleErrors = [];\nconst pageErrors = [];\npage.on(\"console\", (msg) => {\n  if (msg.type() === \"error\") consoleErrors.push(msg.text());\n});\npage.on(\"pageerror\", (err) => pageErrors.push(String(err)));\n\nawait page.goto(\"http://localhost:3000\", { waitUntil: \"networkidle\" });\nawait page.waitForSelector(\"canvas\", { timeout: 15000 });\n\n// Check Settings UI displays 40% x 45% and switch graphics to Low for fast SwiftShader test\nawait page.getByRole(\"button\", { name: /Settings/i }).click();\nawait page.waitForTimeout(200);\nconst settingsBody = await page.locator(\"body\").innerText();\nassert(\"Settings panel displays 40% \303\227 45% Aim Boundary (defaults)\", settingsBody.includes(\"40% \303\227 45%\") && settingsBody.includes(\"0.35x\") && settingsBody.includes(\"2.50x\") && settingsBody.includes(\"240 px\") && settingsBody.includes(\"p=2.0\"), \"Defaults verified in Settings UI\");\nawait page.getByRole(\"button\", { name: /^Low$/i }).first().click();\nawait page.getByRole(\"button\", { name: /Return to Menu/i }).click();\nawait page.waitForTimeout(200);\n\n// Launch Mission 01\nawait page.getByRole(\"button\", { name: /Campaign Missions/i }).click();\nawait page.waitForTimeout(200);\nawait page.getByRole(\"button\", { name: /^Launch /i }).click();\n\nfor (let i = 0; i < 60; i++) {\n  const phase = await page.evaluate(() => window.__STARFALL_DIAG__?.getPhase?.());\n  if (phase === \"playing\") break;\n  await page.waitForTimeout(200);\n}\n\nasync function waitRaf(count = 4) {\n  await page.evaluate(\n    (n) =>\n      new Promise((resolve) => {\n        let i = 0;\n        const step = () => {\n          i += 1;\n          if (i >= n) resolve();\n          else requestAnimationFrame(step);\n        };\n        requestAnimationFrame(step);\n      }),\n    count,\n  );\n}\n\nawait waitRaf(4);\n\n// Engage Pointer Lock via HUD button or canvas click\nconst lockBtn = page.getByRole(\"button\", { name: /Pointer Lock|Engage/i });\nif (await lockBtn.isVisible().catch(() => false)) {\n  await lockBtn.click();\n} else {\n  await page.locator(\"canvas\").click();\n}\nawait waitRaf(3);\n\nconst lockState = await page.evaluate(() => ({\n  nativePointerLockElementTag: document.pointerLockElement?.tagName ?? null,\n  lockOwned: window.__STARFALL_DIAG__.getInput().isPointerLocked(),\n}));\nassert(\"Pointer Lock engaged natively on WebGL canvas\", lockState.lockOwned && lockState.nativePointerLockElementTag === \"CANVAS\", JSON.stringify(lockState));\n\nasync function moveMouseRelative(dx, dy, steps = 4, edgeX = 640, edgeY = 360) {\n  const stepX = dx / steps;\n  const stepY = dy / steps;\n  for (let i = 0; i < steps; i++) {\n    await page.evaluate(({ sx, sy, ex, ey }) => {\n      const ev = new MouseEvent(\"mousemove\", {\n        bubbles: true,\n        cancelable: true,\n        clientX: ex,\n        clientY: ey,\n      });\n      Object.defineProperty(ev, \"movementX\", { value: sx });\n      Object.defineProperty(ev, \"movementY\", { value: sy });\n      window.dispatchEvent(ev);\n    }, { sx: stepX, sy: stepY, ex: edgeX, ey: edgeY });\n    await waitRaf(2);\n  }\n}\n\n// 1, 2, 3. Verify 1280x720 boundary geometry (40% x 45% rounded rectangle)\nconst b1280 = await page.evaluate(() => {\n  const el = document.querySelector(\"[data-testid=\\\"aim-boundary-frame\\\"]\");\n  const paths = Array.from(el?.querySelectorAll(\"path\") ?? []).map((p) => p.getAttribute(\"d\") || \"\");\n  const f = window.__STARFALL_DIAG__.getFlight();\n  return {\n    shape: el?.dataset.shape,\n    hudW: Number(el?.dataset.widthPx),\n    hudH: Number(el?.dataset.heightPx),\n    hudR: Number(el?.dataset.cornerRadiusPx),\n    pathCount: paths.length,\n    allHaveArcs: paths.length === 4 && paths.every((d) => d.includes(\" A \")),\n    engineW: f.aimBoundary.widthPx,\n    engineH: f.aimBoundary.heightPx,\n    engineHalfW: f.aimBoundary.halfW,\n    engineHalfH: f.aimBoundary.halfH,\n    engineR: f.aimBoundary.cornerRadiusPx,\n  };\n});\nassert(\"1280x720 aim boundary width = 40% (512px, half 256px)\", Math.abs(b1280.engineW - 512) < 0.5 && Math.abs(b1280.hudW - 512) < 0.5 && Math.abs(b1280.engineHalfW - 256) < 0.5, JSON.stringify(b1280));\nassert(\"1280x720 aim boundary height = 45% (324px, half 162px)\", Math.abs(b1280.engineH - 324) < 0.5 && Math.abs(b1280.hudH - 324) < 0.5 && Math.abs(b1280.engineHalfH - 162) < 0.5, JSON.stringify(b1280));\nassert(\"Rounded-rectangle subtle 4-corner SVG markings\", b1280.shape === \"rounded-rect\" && b1280.allHaveArcs && Math.abs(b1280.engineR - 40.5) < 0.5, `r=${b1280.engineR}, paths=${b1280.pathCount}`);\n\n// 5. Zone A - Precision steering inside 40% x 45% boundary\nawait page.evaluate(() => window.__STARFALL_DIAG__.getFlight().centerAimCursor());\nawait waitRaf(2);\nawait moveMouseRelative(140, 0, 4, 640, 360);\nawait waitRaf(6);\nconst zoneA = await page.evaluate(() => {\n  const t = window.__STARFALL_DIAG__.getTelemetry();\n  const f = window.__STARFALL_DIAG__.getFlight();\n  return {\n    zone: t.steeringZone,\n    sensX: t.steeringSensitivityX,\n    sensY: t.steeringSensitivityY,\n    screenX: t.aimScreenX,\n    excessX: t.aimExcessX,\n    rawX: f.virtualAimX,\n    yawVel: f.yawVelocity,\n  };\n});\nassert(\"Zone A precision inside boundary (sens=1.0, zero excess, active yaw)\", zoneA.zone === \"precision\" && Math.abs(zoneA.sensX - 1.0) < 0.02 && zoneA.excessX === 0 && Math.abs(zoneA.yawVel) > 0.2, JSON.stringify(zoneA));\n\n// 6. Zone B - Reaching & crossing 40% width boundary (halfW = 256px) slows sensitivity & clamps reticle to 0.700\n// rawX = 140px; add +138px -> rawX = 278px (excess = 22px)\nawait moveMouseRelative(138, 0, 4, 1279, 360);\nawait waitRaf(10);\nconst zoneB = await page.evaluate(() => {\n  const t = window.__STARFALL_DIAG__.getTelemetry();\n  const f = window.__STARFALL_DIAG__.getFlight();\n  return {\n    zone: t.steeringZone,\n    sensX: t.steeringSensitivityX,\n    sensY: t.steeringSensitivityY,\n    screenX: t.aimScreenX,\n    excessX: t.aimExcessX,\n    rawX: f.virtualAimX,\n    yawVel: f.yawVelocity,\n    heading1: t.headingDeg,\n  };\n});\nassert(\"Zone B transition slows sensitivity at boundary & clamps reticle strictly to 0.700\", zoneB.zone === \"transition\" && zoneB.sensX < 0.55 && zoneB.sensX >= 0.34 && Math.abs(zoneB.screenX - 0.7) < 0.001 && zoneB.excessX > 15, JSON.stringify(zoneB));\nassert(\"Independent axes: Y stays precision 1.0 while X is in transition\", Math.abs(zoneB.sensY - 1.0) < 0.02, `sensY=${zoneB.sensY}`);\n\n// 10. Ship continues turning while reticle stays at boundary\nawait waitRaf(8);\nconst headingAfterHold = await page.evaluate(() => window.__STARFALL_DIAG__.getTelemetry().headingDeg);\nlet headingDeltaHold = Math.abs(headingAfterHold - zoneB.heading1);\nif (headingDeltaHold > 180) headingDeltaHold = 360 - headingDeltaHold;\nassert(\"Ship does NOT stop turning when reticle is held at boundary\", headingDeltaHold > 5.0, `h1=${zoneB.heading1.toFixed(1)}, h2=${headingAfterHold.toFixed(1)}, delta=${headingDeltaHold.toFixed(1)} deg`);\n\n// 7 & 9. Zone C - Continued outward movement at physical screen edge progressively accelerates turning\nawait moveMouseRelative(240, 0, 4, 1279, 360);\nawait waitRaf(12);\nconst zoneC1 = await page.evaluate(() => {\n  const t = window.__STARFALL_DIAG__.getTelemetry();\n  const f = window.__STARFALL_DIAG__.getFlight();\n  return { zone: t.steeringZone, sensX: t.steeringSensitivityX, screenX: t.aimScreenX, excessX: t.aimExcessX, absYaw: Math.abs(f.yawVelocity) };\n});\n\nawait moveMouseRelative(480, 0, 6, 1279, 360);\nawait waitRaf(12);\nconst zoneC2 = await page.evaluate(() => {\n  const t = window.__STARFALL_DIAG__.getTelemetry();\n  const f = window.__STARFALL_DIAG__.getFlight();\n  return { zone: t.steeringZone, sensX: t.steeringSensitivityX, screenX: t.aimScreenX, excessX: t.aimExcessX, absYaw: Math.abs(f.yawVelocity) };\n});\n\nassert(\"Zone C progressive acceleration increases sensitivity & yaw monotonically\", zoneC1.zone === \"acceleration\" && zoneC2.zone === \"acceleration\" && zoneC1.sensX > 1.3 && zoneC2.sensX > zoneC1.sensX + 0.5 && zoneC2.absYaw > zoneC1.absYaw + 0.8 && zoneC2.sensX <= 2.5, JSON.stringify({ zoneC1, zoneC2 }));\nassert(\"Reticle NEVER escapes right boundary (0.700) during deep Zone C overdrive\", Math.abs(zoneC1.screenX - 0.7) < 0.001 && Math.abs(zoneC2.screenX - 0.7) < 0.001, `c1=${zoneC1.screenX}, c2=${zoneC2.screenX}`);\n\n// 3b & 4. Rounded-rectangle corner clamping test\nawait page.evaluate(() => window.__STARFALL_DIAG__.getFlight().centerAimCursor());\nawait waitRaf(2);\nawait moveMouseRelative(700, 700, 5, 1279, 719);\nawait waitRaf(4);\nconst cornerRes = await page.evaluate(() => {\n  const f = window.__STARFALL_DIAG__.getFlight();\n  const b = f.aimBoundary;\n  const c = f.aimClamp;\n  const distFromCornerCenter = Math.hypot(Math.abs(c.clampedX) - b.innerHalfW, Math.abs(c.clampedY) - b.innerHalfH);\n  return {\n    clampedX: c.clampedX,\n    clampedY: c.clampedY,\n    halfW: b.halfW,\n    halfH: b.halfH,\n    r: b.cornerRadiusPx,\n    distFromCornerCenter,\n    strictlyInsideBoxCorner: Math.abs(c.clampedX) < b.halfW - 5 && Math.abs(c.clampedY) < b.halfH - 5,\n    onCornerArc: Math.abs(distFromCornerCenter - b.cornerRadiusPx) < 0.5,\n    excessX: c.excessX,\n    excessY: c.excessY,\n  };\n});\nassert(\"Rounded-rectangle corner clamps onto circular arc (not square corner) & preserves X/Y excess\", cornerRes.strictlyInsideBoxCorner && cornerRes.onCornerArc && cornerRes.excessX > 100 && cornerRes.excessY > 100, JSON.stringify(cornerRes));\n\n// 8. Returning inward smoothly restores precision steering\nawait page.evaluate(() => window.__STARFALL_DIAG__.getFlight().centerAimCursor());\nawait waitRaf(2);\nawait moveMouseRelative(500, 0, 5, 1279, 360);\nawait waitRaf(10);\nconst beforeReturn = await page.evaluate(() => window.__STARFALL_DIAG__.getTelemetry().steeringZone);\nawait moveMouseRelative(-380, 0, 5, 0, 360);\nawait waitRaf(12);\nconst afterReturn = await page.evaluate(() => {\n  const t = window.__STARFALL_DIAG__.getTelemetry();\n  return { zone: t.steeringZone, sensX: t.steeringSensitivityX, excessX: t.aimExcessX, screenX: t.aimScreenX };\n});\nassert(\"Returning inward smoothly restores precision steering (~1.0x)\", beforeReturn === \"acceleration\" && afterReturn.zone === \"precision\" && Math.abs(afterReturn.sensX - 1.0) < 0.05 && afterReturn.excessX === 0, JSON.stringify({ beforeReturn, afterReturn }));\n\n// 13. Resize viewport across multiple aspect ratios (4:3 1024x768 and 21:9 1440x600)\nawait page.setViewportSize({ width: 1024, height: 768 });\nawait waitRaf(6);\nawait moveMouseRelative(400, 400, 4, 1023, 767);\nawait waitRaf(4);\nconst b1024 = await page.evaluate(() => {\n  const el = document.querySelector(\"[data-testid=\\\"aim-boundary-frame\\\"]\");\n  const f = window.__STARFALL_DIAG__.getFlight();\n  const c = f.aimClamp;\n  const b = f.aimBoundary;\n  return {\n    hudW: Number(el?.dataset.widthPx),\n    hudH: Number(el?.dataset.heightPx),\n    engineW: b.widthPx,\n    engineH: b.heightPx,\n    r: b.cornerRadiusPx,\n    insideRoundedRect: Math.abs(c.clampedX) <= b.halfW + 0.01 && Math.abs(c.clampedY) <= b.halfH + 0.01,\n  };\n});\nassert(\"Resize to 1024x768 (4:3) updates boundary to 409.6x345.6 & keeps reticle clamped\", Math.abs(b1024.engineW - 409.6) < 0.6 && Math.abs(b1024.engineH - 345.6) < 0.6 && Math.abs(b1024.hudW - 409.6) < 0.6 && Math.abs(b1024.hudH - 345.6) < 0.6 && b1024.insideRoundedRect, JSON.stringify(b1024));\n\nawait page.setViewportSize({ width: 1440, height: 600 });\nawait waitRaf(8);\nconst b1440 = await page.evaluate(() => {\n  const el = document.querySelector(\"[data-testid=\\\"aim-boundary-frame\\\"]\");\n  const f = window.__STARFALL_DIAG__.getFlight();\n  const c = f.aimClamp;\n  const b = f.aimBoundary;\n  return {\n    hudW: Number(el?.dataset.widthPx),\n    hudH: Number(el?.dataset.heightPx),\n    engineW: b.widthPx,\n    engineH: b.heightPx,\n    r: b.cornerRadiusPx,\n    insideRoundedRect: Math.abs(c.clampedX) <= b.halfW + 0.01 && Math.abs(c.clampedY) <= b.halfH + 0.01,\n  };\n});\nassert(\"Resize to 1440x600 (21:9) updates boundary to 576x270 & keeps reticle clamped\", Math.abs(b1440.engineW - 576) < 0.6 && Math.abs(b1440.engineH - 270) < 0.6 && Math.abs(b1440.hudW - 576) < 0.6 && Math.abs(b1440.hudH - 270) < 0.6 && b1440.insideRoundedRect, JSON.stringify(b1440));\n\nassert(\"Zero runtime console or page errors\", consoleErrors.length === 0 && pageErrors.length === 0, JSON.stringify({ consoleErrors, pageErrors }));\n\nawait browser.close();\n\nconst failed = results.filter((r) => !r.pass);\nconsole.log(`\\nSUMMARY: ${results.length - failed.length}/${results.length} passed`);\nif (failed.length > 0) process.exit(1);\n\'"
