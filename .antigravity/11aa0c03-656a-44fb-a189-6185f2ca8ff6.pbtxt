            }
            lines {
              text: "          s.aimBoundaryWidth,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          s.aimBoundaryHeight,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
