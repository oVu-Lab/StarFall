            lines {
              text: "          boundaryScratchRef.current,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        );"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const key = `${vw.toFixed(1)}:${vh.toFixed(1)}:${b.widthPx.toFixed(1)}:${b.heightPx.toFixed(1)}:${b.cornerRadiusPx.toFixed(1)}`;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        if (key !== lastBoundaryKeyRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          lastBoundaryKeyRef.current = key;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const x0 = cx - b.halfW;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const x1 = cx + b.halfW;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const y0 = cy - b.halfH;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const y1 = cy + b.halfH;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const r = b.cornerRadiusPx;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const arm = Math.max(8, Math.min(20, Math.min(b.innerHalfW, b.innerHalfH) * 0.22));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const paths = ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            // Top-left rounded corner bracket"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            `M ${x0.toFixed(1)} ${(y0 + r + arm).toFixed(1)} L ${x0.toFixed(1)} ${(y0 + r).toFixed(1)} A ${r.toFixed(1)} ${r.toFixed(1)} 0 0 1 ${(x0 + r).toFixed(1)} ${y0.toFixed(1)} L ${(x0 + r + arm).toFixed(1)} ${y0.toFixed(1)}`,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            // Top-right rounded corner bracket"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            `M ${(x1 - r - arm).toFixed(1)} ${y0.toFixed(1)} L ${(x1 - r).toFixed(1)} ${y0.toFixed(1)} A ${r.toFixed(1)} ${r.toFixed(1)} 0 0 1 ${x1.toFixed(1)} ${(y0 + r).toFixed(1)} L ${x1.toFixed(1)} ${(y0 + r + arm).toFixed(1)}`,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            // Bottom-right rounded corner bracket"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            `M ${x1.toFixed(1)} ${(y1 - r - arm).toFixed(1)} L ${x1.toFixed(1)} ${(y1 - r).toFixed(1)} A ${r.toFixed(1)} ${r.toFixed(1)} 0 0 1 ${(x1 - r).toFixed(1)} ${y1.toFixed(1)} L ${(x1 - r - arm).toFixed(1)} ${y1.toFixed(1)}`,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            // Bottom-left rounded corner bracket"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            `M ${(x0 + r + arm).toFixed(1)} ${y1.toFixed(1)} L ${(x0 + r).toFixed(1)} ${y1.toFixed(1)} A ${r.toFixed(1)} ${r.toFixed(1)} 0 0 1 ${x0.toFixed(1)} ${(y1 - r).toFixed(1)} L ${x0.toFixed(1)} ${(y1 - r - arm).toFixed(1)}`,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          ];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          for (let i = 0; i < 4; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            cornerPathRefs.current[i]?.setAttribute(\'d\', paths[i]);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          aimBoundarySvgRef.current.dataset.shape = \'rounded-rect\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          aimBoundarySvgRef.current.dataset.viewportWidth = vw.toFixed(1);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          aimBoundarySvgRef.current.dataset.viewportHeight = vh.toFixed(1);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          aimBoundarySvgRef.current.dataset.widthPx = b.widthPx.toFixed(2);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          aimBoundarySvgRef.current.dataset.heightPx = b.heightPx.toFixed(2);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          aimBoundarySvgRef.current.dataset.cornerRadiusPx = b.cornerRadiusPx.toFixed(2);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          aimBoundarySvgRef.current.dataset.widthFraction = b.widthFraction.toFixed(4);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          aimBoundarySvgRef.current.dataset.heightFraction = b.heightFraction.toFixed(4);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const deflection = Math.max(Math.abs(t.aimNormalizedX), Math.abs(t.aimNormalizedY));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const edgeOp ="
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          t.steeringZone === \'acceleration\'"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ? 0.3 + t.steeringAccelRatio * 0.24"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            : t.steeringZone === \'transition\'"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              ? 0.32"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              : deflection > 0.25"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                ? 0.08 + Math.min(1, (deflection - 0.25) / 0.75) * 0.18"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                : 0.08;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        aimBoundarySvgRef.current.style.opacity = edgeOp.toFixed(2);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        aimBoundarySvgRef.current.style.color ="
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          t.steeringZone === \'acceleration\'"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ? \'rgba(186, 230, 253, 0.92)\'"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            : t.steeringZone === \'transition\'"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              ? \'rgba(251, 191, 36, 0.85)\'"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              : \'rgba(103, 232, 249, 0.75)\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (steerLineRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const dx = aimPxX - cx;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const dy = aimPxY - cy;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const distPx = Math.hypot(dx, dy);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        if (distPx > 14) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const ux = dx / distPx;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const uy = dy / distPx;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          steerLineRef.current.setAttribute(\'x1\', (cx + ux * 10).toFixed(1));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          steerLineRef.current.setAttribute(\'y1\', (cy + uy * 10).toFixed(1));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          steerLineRef.current.setAttribute(\'x2\', (aimPxX - ux * 18).toFixed(1));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          steerLineRef.current.setAttribute(\'y2\', (aimPxY - uy * 18).toFixed(1));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
