            }
            lines {
              text: "      : halfW;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const dxCorner = Math.max(0, absClampedX - innerHalfW);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
