          target_content: "      if (aimReticleRef.current) {\n        aimReticleRef.current.style.transform = `translate3d(${aimPxX.toFixed(1)}px, ${aimPxY.toFixed(1)}px, 0) translate(-50%, -50%)`;\n        aimReticleRef.current.dataset.steeringZone = t.steeringZone;\n        aimReticleRef.current.dataset.sensX = t.steeringSensitivityX.toFixed(3);\n        aimReticleRef.current.dataset.sensY = t.steeringSensitivityY.toFixed(3);\n        aimReticleRef.current.style.color =\n          t.steeringZone === \'acceleration\'\n            ? \'#e0f2fe\'\n            : t.steeringZone === \'transition\'\n              ? \'#fcd34d\'\n              : \'rgba(165, 243, 252, 0.95)\';\n      }\n\n      if (boresightRef.current) {\n        const recoilScale = t.isFiring ? 1 + t.weaponCooldownRatio * 0.14 : 1;\n        boresightRef.current.style.transform = `translate3d(${borePxX.toFixed(1)}px, ${borePxY.toFixed(1)}px, 0) translate(-50%, -50%) scale(${recoilScale.toFixed(3)})`;\n      }\n\n      if (aimRingRef.current) {\n        const ringScale = 1 + t.boostIntensity * 0.24 + (t.isFiring ? 0.08 : 0);\n        aimRingRef.current.style.transform = `scale(${ringScale.toFixed(3)})`;\n        aimRingRef.current.style.opacity = String(\n          (0.24 + t.boostIntensity * 0.45 + (t.isFiring ? 0.22 : 0)).toFixed(2),\n        );\n      }\n\n      if (aimBoundaryRef.current) {\n        const deflection = Math.max(Math.abs(t.aimNormalizedX), Math.abs(t.aimNormalizedY));\n        const edgeOp =\n          t.steeringZone === \'acceleration\'\n            ? 0.28 + t.steeringAccelRatio * 0.22\n            : t.steeringZone === \'transition\'\n              ? 0.28\n              : deflection > 0.15\n                ? 0.07 + Math.min(1, deflection) * 0.16\n                : 0.06;\n        aimBoundaryRef.current.style.opacity = edgeOp.toFixed(2);\n        aimBoundaryRef.current.style.borderColor =\n          t.steeringZone === \'acceleration\'\n            ? \'rgba(125, 211, 252, 0.85)\'\n          