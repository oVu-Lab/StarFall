      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Update aimBoundaryWidth doc comment to 40% default in types/game.ts\", \"EndLine\":116, \"Instruction\":\"Update aimBoundaryWidth JSDoc comment from 0.45 (45%) to 0.40 (40%)\", \"ReplacementContent\":\"  /** Aiming boundary full width as a fraction of game viewport width (default 0.40 = 40%) */\\n  aimBoundaryWidth: number;\\n  /** Aiming boundary full height as a fraction of game viewport height (default 0.45 = 45%) */\\n  aimBoundaryHeight: number;\", \"StartLine\":109, \"TargetContent\":\"  /** Aiming boundary full width as a fraction of game viewport width (default 0.45 = 45%) */\\n  aimBoundaryWidth: number;\\n  /** Aiming boundary full height as a fraction of game viewport height (default 0.45 = 45%) */\\n  aimBoundaryHeight: number;\", \"TargetFile\":\"/src/types/game.ts\", \"toolAction\":\"Updating types/game.ts comment\", \"toolSummary\":\"Update types/game.ts comment\"}"
      original_name: "replace_file_content"
