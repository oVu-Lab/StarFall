            lines {
              text: "              ? \'rgba(251, 191, 36, 0.98)\'"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              : m.isPrimaryTarget"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                ? \'rgba(249, 115, 22, 0.95)\'"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                : \'rgba(251, 146, 60, 0.65)\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            box.style.width = m.isPriorityTarget ? \'44px\' : m.isPrimaryTarget ? \'38px\' : \'28px\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            box.style.height = m.isPriorityTarget ? \'44px\' : m.isPrimaryTarget ? \'38px\' : \'28px\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            box.style.transform ="
