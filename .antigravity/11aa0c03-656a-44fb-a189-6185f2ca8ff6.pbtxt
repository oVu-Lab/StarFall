      arguments_json: "{\"CodeContent\":\"import * as THREE from \'three\';\\nimport { STEERING_BOUNDS, STEERING_CONFIG } from \'../config/steering\';\\nimport type { SteeringZone } from \'../types/game\';\\n\\n/**\\n * Exact viewport-relative rounded-rectangle aiming boundary geometry.\\n * Centered at (0, 0) in viewport CSS pixel offset coordinates.\\n */\\nexport interface RoundedRectBoundary {\\n  viewportWidth: number;\\n  viewportHeight: number;\\n  widthFraction: number;\\n  heightFraction: number;\\n  cornerRadiusRatio: number;\\n  widthPx: number;\\n  heightPx: number;\\n  halfW: number;\\n  halfH: number;\\n  cornerRadiusPx: number;\\n  innerHalfW: number;\\n  innerHalfH: number;\\n}\\n\\n/**\\n * Result of clamping an unconstrained relative virtual displacement (rawX, rawY)\\n * onto the rounded-rectangle precision boundary while preserving outward excess.\\n */\\nexport interface RoundedRectClampResult {\\n  /** Clamped reticle offset from viewport center in CSS pixels (strictly inside/on boundary) */\\n  clampedX: number;\\n  clampedY: number;\\n  /** True when the raw displacement lies inside or on the rounded-rectangle boundary */\\n  inside: boolean;\\n  /** Exact Euclidean signed distance to the rounded-rectangle perimeter in px (<= 0 inside, > 0 outside) */\\n  signedDistance: number;\\n  /** Independent horizontal outward displacement past the rounded-rectangle perimeter (>= 0 px) */\\n  excessX: number;\\n  /** Independent vertical outward displacement past the rounded-rectangle perimeter (>= 0 px) */\\n  excessY: number;\\n  /** Effective horizontal boundary half-extent at clampedY (curves smoothly along corners) */\\n  axisBoundaryX: number;\\n  /** Effective vertical boundary half-extent at clampedX (curves smoothly along corners) */\\n  axisBoundaryY: number;\\n  /** Clamped normalized deflection relative to halfW / halfH in [-1, 1] */\\n  normalizedX: number;\\n  normalizedY: number;\\n  /** Viewport-normalized [0..1] screen position of the clamped virtual reticle */\\n  screenX: number;\\n  screenY: number;\\n}\\n\\nexport interface AxisSteeringEvaluation {\\n  targetSensitivity: number;\\n  excess: number;\\n  curveFactor: number;\\n  zone: SteeringZone;\\n}\\n\\nexport function createRoundedRectBoundary(): RoundedRectBoundary {\\n  return {\\n    viewportWidth: 1280,\\n    viewportHeight: 720,\\n    widthFraction: STEERING_CONFIG.aimBoundaryWidth,\\n    heightFraction: STEERING_CONFIG.aimBoundaryHeight,\\n    cornerRadiusRatio: STEERING_CONFIG.aimBoundaryCornerRadius,\\n    widthPx: 1280 * STEERING_CONFIG.aimBoundaryWidth,\\n    heightPx: 720 * STEERING_CONFIG.aimBoundaryHeight,\\n    halfW: 1280 * STEERING_CONFIG.aimBoundaryWidth * 0.5,\\n    halfH: 720 * STEERING_CONFIG.aimBoundaryHeight * 0.5,\\n    cornerRadiusPx: 720 * STEERING_CONFIG.aimBoundaryHeight * 0.5 * STEERING_CONFIG.aimBoundaryCornerRadius,\\n    innerHalfW: 0,\\n    innerHalfH: 0,\\n  };\\n}\\n\\nexport function createRoundedRectClampResult(): RoundedRectClampResult {\\n  return {\\n    clampedX: 0,\\n    clampedY: 0,\\n    inside: true,\\n    signedDistance: 0,\\n    excessX: 0,\\n    excessY: 0,\\n    axisBoundaryX: 288,\\n    axisBoundaryY: 162,\\n    normalizedX: 0,\\n    normalizedY: 0,\\n    screenX: 0.5,\\n    screenY: 0.5,\\n  };\\n}\\n\\n/**\\n * Computes exact rounded-rectangle boundary dimensions for the current game viewport (W x H).\\n * For default 45% x 45%:\\n *   halfW = 0.225 * W\\n *   halfH = 0.225 * H\\n *   cornerRadius = cornerRadiusRatio * min(halfW, halfH)\\n */\\nexport function computeRoundedRectBoundary(\\n  viewportWidth: number,\\n  viewportHeight: number,\\n  widthFraction: number,\\n  heightFraction: number,\\n  cornerRadiusRatio: number,\\n  out: RoundedRectBoundary = createRoundedRectBoundary(),\\n): RoundedRectBoundary {\\n  const vw = Math.max(1, Number.isFinite(viewportWidth) ? viewportWidth : 1280);\\n  const vh = Math.max(1, Number.isFinite(viewportHeight) ? viewportHeight : 720);\\n\\n  const wf = THREE.MathUtils.clamp(\\n    widthFraction,\\n    STEERING_BOUNDS.aimBoundaryWidth.min,\\n    STEERING_BOUNDS.aimBoundaryWidth.max,\\n  );\\n  const hf = THREE.MathUtils.clamp(\\n    heightFraction,\\n    STEERING_BOUNDS.aimBoundaryHeight.min,\\n    STEERING_BOUNDS.aimBoundaryHeight.max,\\n  );\\n  const rRatio = THREE.MathUtils.clamp(\\n    cornerRadiusRatio,\\n    STEERING_BOUNDS.aimBoundaryCornerRadius.min,\\n    STEERING_BOUNDS.aimBoundaryCornerRadius.max,\\n  );\\n\\n  const widthPx = vw * wf;\\n  const heightPx = vh * hf;\\n  const halfW = widthPx * 0.5;\\n  const halfH = heightPx * 0.5;\\n  const cornerRadiusPx = Math.min(halfW, halfH) * rRatio;\\n\\n  out.viewportWidth = vw;\\n  out.viewportHeight = vh;\\n  out.widthFraction = wf;\\n  out.heightFraction = hf;\\n  out.cornerRadiusRatio = rRatio;\\n  out.widthPx = widthPx;\\n  out.heightPx = heightPx;\\n  out.halfW = halfW;\\n  out.halfH = halfH;\\n  out.cornerRadiusPx = cornerRadiusPx;\\n  out.innerHalfW = Math.max(0, halfW - cornerRadiusPx);\\n  out.innerHalfH = Math.max(0, halfH - cornerRadiusPx);\\n  return out;\\n}\\n\\n/**\\n * C1-continuous closest-point projection of an unconstrained virtual displacement (rawX, rawY)\\n * onto the centered rounded-rectangle boundary.\\n *\\n * - Inside the rounded rectangle: reticle tracks (rawX, rawY) directly; excessX = excessY = 0.\\n * - Outside straight edges: clamps perpendicularly to the edge without affecting the parallel axis.\\n * - Outside rounded corners: projects orthogonally onto the circular corner arc (zero abrupt snapping).\\n * - Preserves independent outward excess (excessX, excessY) for progressive steering acceleration.\\n */\\nexport function clampToRoundedRect(\\n  rawX: number,\\n  rawY: number,\\n  boundary: RoundedRectBoundary,\\n  out: RoundedRectClampResult = createRoundedRectClampResult(),\\n): RoundedRectClampResult {\\n  const {\\n    halfW,\\n    halfH,\\n    cornerRadiusPx: r,\\n    innerHalfW,\\n    innerHalfH,\\n    viewportWidth,\\n    viewportHeight,\\n  } = boundary;\\n\\n  const ax = Math.abs(rawX);\\n  const ay = Math.abs(rawY);\\n  const sx = rawX < 0 ? -1 : 1;\\n  const sy = rawY < 0 ? -1 : 1;\\n\\n  const qx = ax - innerHalfW;\\n  const qy = ay - innerHalfH;\\n\\n  // Exact Euclidean rounded-rectangle signed distance field (<= 0 inside, > 0 outside)\\n  const outX = qx > 0 ? qx : 0;\\n  const outY = qy > 0 ? qy : 0;\\n  const outLen = Math.hypot(outX, outY);\\n  const inDist = Math.min(Math.max(qx, qy), 0);\\n  const sdf = outLen + inDist - r;\\n\\n  let clampedX = rawX;\\n  let clampedY = rawY;\\n  let inside = true;\\n\\n  if (sdf > 0) {\\n    inside = false;\\n    if (qx > 0 && qy > 0) {\\n      // Corner quadrant: orthogonal projection onto circular corner arc of radius r\\n      const invD = outLen > 1e-6 ? 1 / outLen : 0;\\n      clampedX = sx * (innerHalfW + qx * invD * r);\\n      clampedY = sy * (innerHalfH + qy * invD * r);\\n    } else if (qx > 0) {\\n      // Left / right straight edge\\n      clampedX = sx * halfW;\\n      clampedY = rawY;\\n    } else {\\n      // Top / bottom straight edge\\n      clampedX = rawX;\\n      clampedY = sy * halfH;\\n    }\\n  }\\n\\n  // Compute effective per-axis boundary coordinate at the clamped cross-axis position\\n  const absClampedX = Math.abs(clampedX);\\n  const absClampedY = Math.abs(clampedY);\\n\\n  const dyCorner = Math.max(0, absClampedY - innerHalfH);\\n  const axisBoundaryX =\\n    dyCorner > 0\\n      ? innerHalfW + Math.sqrt(Math.max(0, r * r - dyCorner * dyCorner))\\n      : halfW;\\n\\n  const dxCorner = Math.max(0, absClampedX - innerHalfW);\\n  const axisBoundaryY =\\n    dxCorner > 0\\n      ? innerHalfH + Math.sqrt(Math.max(0, r * r - dxCorner * dxCorner))\\n      : halfH;\\n\\n  out.clampedX = clampedX;\\n  out.clampedY = clampedY;\\n  out.inside = inside;\\n  out.signedDistance = sdf;\\n  out.excessX = Math.abs(rawX - clampedX);\\n  out.excessY = Math.abs(rawY - clampedY);\\n  out.axisBoundaryX = Math.max(1, axisBoundaryX);\\n  out.axisBoundaryY = Math.max(1, axisBoundaryY);\\n  out.normalizedX = halfW > 0 ? THREE.MathUtils.clamp(clampedX / halfW, -1, 1) : 0;\\n  out.normalizedY = halfH > 0 ? THREE.MathUtils.clamp(clampedY / halfH, -1, 1) : 0;\\n  out.screenX = 0.5 + clampedX / viewportWidth;\\n  out.screenY = 0.5 + clampedY / viewportHeight;\\n  return out;\\n}\\n\\n/**\\n * Pure per-axis progressive steering sensitivity evaluation.\\n *\\n * Inside the boundary (excessPx == 0):\\n *   - Core precision region [0 .. boundaryBlendStart * axisBoundary]: flat normalSensitivity (1.0x).\\n *   - Boundary approach [boundaryBlendStart * axisBoundary .. axisBoundary]: C1 smoothstep easing\\n *     down to boundarySensitivity (0.35x) so there is zero sensitivity jump when crossing the edge.\\n *\\n * Beyond the boundary (excessPx > 0):\\n *   e = excessPx / accelDistance\\n *   f(e) = e^p / (1 + e^p)\\n *   sensitivity(e) = boundarySensitivity + (maxSensitivity - boundarySensitivity) * f(e)\\n *   - Zone B (transition): sensitivity < normalSensitivity (slower initial boundary crossing)\\n *   - Zone C (acceleration): sensitivity >= normalSensitivity (progressive turn acceleration)\\n */\\nexport function evaluateProgressiveAxisSensitivity(\\n  absCoordPx: number,\\n  axisBoundaryPx: number,\\n  excessPx: number,\\n  accelDistancePx: number,\\n  normalSensitivity: number,\\n  boundarySensitivity: number,\\n  maxSensitivity: number,\\n  exponent: number,\\n  out: AxisSteeringEvaluation = {\\n    targetSensitivity: 1,\\n    excess: 0,\\n    curveFactor: 0,\\n    zone: \'precision\',\\n  },\\n): AxisSteeringEvaluation {\\n  const B = Math.max(10, axisBoundaryPx);\\n  const S = Math.max(20, accelDistancePx);\\n  const nSens = THREE.MathUtils.clamp(normalSensitivity, 0.5, 2.0);\\n  const bSens = THREE.MathUtils.clamp(boundarySensitivity, 0.1, nSens);\\n  const mSens = Math.max(nSens, maxSensitivity);\\n  const p = THREE.MathUtils.clamp(exponent, 0.5, 5.0);\\n\\n  if (excessPx <= 1e-4) {\\n    const blendStart = B * STEERING_CONFIG.boundaryBlendStart;\\n    if (absCoordPx <= blendStart) {\\n      out.targetSensitivity = nSens;\\n    } else {\\n      const t = THREE.MathUtils.clamp((absCoordPx - blendStart) / Math.max(1, B - blendStart), 0, 1);\\n      const smooth = t * t * (3 - 2 * t);\\n      out.targetSensitivity = nSens + (bSens - nSens) * smooth;\\n    }\\n    out.excess = 0;\\n    out.curveFactor = 0;\\n    out.zone = \'precision\';\\n    return out;\\n  }\\n\\n  const e = excessPx / S;\\n  const ep = Math.pow(e, p);\\n  const f = ep / (1 + ep);\\n  const targetSens = bSens + (mSens - bSens) * f;\\n\\n  out.targetSensitivity = targetSens;\\n  out.excess = e;\\n  out.curveFactor = f;\\n  out.zone = targetSens < nSens ? \'transition\' : \'acceleration\';\\n  return out;\\n}\\n\", \"Description\":\"Create pure rounded-rectangle aiming boundary clamping and progressive sensitivity module\", \"Overwrite\":true, \"TargetFile\":\"/src/engine/AimBoundary.ts\", \"toolAction\":\"Creating AimBoundary.ts\", \"toolSummary\":\"Create AimBoundary.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_17079567127750748777"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Update GameSettings and FlightTelemetry with viewport-relative rounded-rectangle aim boundary parameters and telemetry fields\", \"EndLine\":170, \"Instruction\":\"Replace aimBoundarySize with aimBoundaryWidth, aimBoundaryHeight, aimBoundaryCornerRadius, recoverySmoothing in GameSettings and add boundary geometry telemetry fields in FlightTelemetry\", \"ReplacementContent\":\"export interface GameSettings {\\n  /** Base Sensitivity multiplier for relative mouse movement (0.3 to 2.5) */\\n  mouseSensitivity: number;\\n  /** Sensitivity multiplier immediately upon crossing the aiming boundary (0.15 to 1.0) */\\n  boundarySensitivity: number;\\n  /** Asymptotic maximum sensitivity multiplier in the acceleration zone (1.2 to 3.5) */\\n  maxSensitivity: number;\\n  /** Distance scale S (in virtual px) over which acceleration ramps outside the boundary (80 to 500) */\\n  accelerationDistance: number;\\n  /** Nonlinear response curve exponent p in f(e) = e^p / (1 + e^p) (1.0 to 3.5) */\\n  responseCurve: number;\\n  /** Aiming boundary full width as a fraction of game viewport width (default 0.45 = 45%) */\\n  aimBoundaryWidth: number;\\n  /** Aiming boundary full height as a fraction of game viewport height (default 0.45 = 45%) */\\n  aimBoundaryHeight: number;\\n  /** Rounded-rectangle corner radius as a fraction of min(halfW, halfH) (default 0.25) */\\n  aimBoundaryCornerRadius: number;\\n  /** Smooth delta-time recovery time constant in seconds (default 0.12) */\\n  recoverySmoothing: number;\\n  invertY: boolean;\\n  cameraDistance: number; // 7.2 to 13.5\\n  cameraSensitivity: number; // 0.6 to 1.6\\n  masterVolume: number; // 0 to 1\\n  graphicsQuality: GraphicsQuality;\\n  resolutionScale: number; // 0.65 to 1.0\\n  shadowQuality: ShadowQuality;\\n  particleQuality: EffectQuality;\\n  environmentDetail: EffectQuality;\\n  drawDistance: number; // 2000 to 5200\\n  antialias: boolean;\\n  postGlowEnabled: boolean;\\n  /** Development-only performance monitor toggle (hidden in production builds) */\\n  showPerfOverlay: boolean;\\n}\\n\\n/**\\n * High-frequency mutable telemetry updated every simulation frame.\\n * Read directly via refs inside HUD animation loops to guarantee zero React re-renders per frame.\\n */\\nexport interface FlightTelemetry {\\n  speed: number;\\n  signedSpeed: number;\\n  maxSpeed: number;\\n  effectiveMaxSpeed: number;\\n  throttle: number; // -1 to 1\\n  boostEnergy: number; // 0 to 100\\n  maxBoostEnergy: number;\\n  isBoosting: boolean;\\n  boostDepleted: boolean;\\n  boostIntensity: number; // 0 to 1 smoothly damped\\n  hull: number;\\n  maxHull: number;\\n  yawRate: number; // normalized angular velocity relative to base yawSpeed\\n  pitchRate: number; // normalized angular velocity relative to base pitchSpeed\\n  rollRate: number; // normalized -1..1\\n  /** Normalized virtual aim offset (-1..1 inside rounded-rectangle precision boundary) */\\n  aimNormalizedX: number;\\n  aimNormalizedY: number;\\n  /** Screen-space [0..1] position of clamped virtual mouse steering reticle (strictly inside boundary) */\\n  aimScreenX: number;\\n  aimScreenY: number;\\n  /** Live rounded-rectangle boundary geometry in game viewport CSS pixels */\\n  aimBoundaryWidthPx: number;\\n  aimBoundaryHeightPx: number;\\n  aimBoundaryCornerRadiusPx: number;\\n  /** Outward virtual displacement excess past the rounded-rectangle boundary (px) */\\n  aimExcessX: number;\\n  aimExcessY: number;\\n  /** Screen-space [0..1] position of ship boresight */\\n  boresightScreenX: number;\\n  boresightScreenY: number;\\n  /** Active progressive steering zone & smoothed per-axis sensitivity multipliers */\\n  steeringZone: SteeringZone;\\n  steeringSensitivityX: number;\\n  steeringSensitivityY: number;\\n  steeringAccelRatio: number; // 0..1 overdrive intensity beyond boundary\\n  headingDeg: number; // 0..359\\n  pitchDeg: number; // -90..90\\n  rollDeg: number; // -180..180\\n  altitude: number;\\n  status: FlightStatus;\\n  pointerLocked: boolean;\", \"StartLine\":99, \"TargetContent\":\"export interface GameSettings {\\n  /** Base Sensitivity multiplier for relative mouse movement (0.3 to 2.5) */\\n  mouseSensitivity: number;\\n  /** Sensitivity multiplier immediately upon crossing the aiming boundary (0.15 to 1.0) */\\n  boundarySensitivity: number;\\n  /** Asymptotic maximum sensitivity multiplier in the acceleration zone (1.2 to 3.5) */\\n  maxSensitivity: number;\\n  /** Distance scale S (in virtual px) over which acceleration ramps outside the boundary (80 to 500) */\\n  accelerationDistance: number;\\n  /** Nonlinear response curve exponent p in f(e) = e^p / (1 + e^p) (1.0 to 3.5) */\\n  responseCurve: number;\\n  /** Half-width screen fraction of the precision aiming boundary (0.15 to 0.38) */\\n  aimBoundarySize: number;\\n  invertY: boolean;\\n  cameraDistance: number; // 7.2 to 13.5\\n  cameraSensitivity: number; // 0.6 to 1.6\\n  masterVolume: number; // 0 to 1\\n  graphicsQuality: GraphicsQuality;\\n  resolutionScale: number; // 0.65 to 1.0\\n  shadowQuality: ShadowQuality;\\n  particleQuality: EffectQuality;\\n  environmentDetail: EffectQuality;\\n  drawDistance: number; // 2000 to 5200\\n  antialias: boolean;\\n  postGlowEnabled: boolean;\\n  /** Development-only performance monitor toggle (hidden in production builds) */\\n  showPerfOverlay: boolean;\\n}\\n\\n/**\\n * High-frequency mutable telemetry updated every simulation frame.\\n * Read directly via refs inside HUD animation loops to guarantee zero React re-renders per frame.\\n */\\nexport interface FlightTelemetry {\\n  speed: number;\\n  signedSpeed: number;\\n  maxSpeed: number;\\n  effectiveMaxSpeed: number;\\n  throttle: number; // -1 to 1\\n  boostEnergy: number; // 0 to 100\\n  maxBoostEnergy: number;\\n  isBoosting: boolean;\\n  boostDepleted: boolean;\\n  boostIntensity: number; // 0 to 1 smoothly damped\\n  hull: number;\\n  maxHull: number;\\n  yawRate: number; // normalized angular velocity relative to base yawSpeed\\n  pitchRate: number; // normalized angular velocity relative to base pitchSpeed\\n  rollRate: number; // normalized -1..1\\n  /** Normalized virtual aim offset (-1..1 inside precision boundary) */\\n  aimNormalizedX: number;\\n  aimNormalizedY: number;\\n  /** Screen-space [0..1] position of virtual mouse steering reticle */\\n  aimScreenX: number;\\n  aimScreenY: number;\\n  /** Screen-space [0..1] position of ship boresight */\\n  boresightScreenX: number;\\n  boresightScreenY: number;\\n  /** Active progressive steering zone & smoothed per-axis sensitivity multipliers */\\n  steeringZone: SteeringZone;\\n  steeringSensitivityX: number;\\n  steeringSensitivityY: number;\\n  steeringAccelRatio: number; // 0..1 overdrive intensity beyond boundary\\n  headingDeg: number; // 0..359\\n  pitchDeg: number; // -90..90\\n  rollDeg: number; // -180..180\\n  altitude: number;\\n  status: FlightStatus;\\n  pointerLocked: boolean;\", \"TargetFile\":\"/src/types/game.ts\", \"toolAction\":\"Updating types/game.ts\", \"toolSummary\":\"Update types/game.ts\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_17079567127750749358"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Wire DEFAULT_SETTINGS and loadSavedSettings to centralized STEERING_CONFIG with confirmed 45% x 45% rounded-rectangle defaults\", \"Instruction\":\"Import STEERING_CONFIG and STEERING_BOUNDS, update DEFAULT_SETTINGS and settings persistence migration to v3\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":3, \"ReplacementContent\":\"import type { GameSettings, ShipConfig, ShipId } from \'../types/game\';\\nimport { STEERING_BOUNDS, STEERING_CONFIG } from \'./steering\';\", \"StartLine\":1, \"TargetContent\":\"import type { GameSettings, ShipConfig, ShipId } from \'../types/game\';\"}, {\"AllowMultiple\":false, \"EndLine\":258, \"ReplacementContent\":\"export const DEFAULT_SETTINGS: GameSettings = {\\n  mouseSensitivity: STEERING_CONFIG.normalSensitivity,\\n  boundarySensitivity: STEERING_CONFIG.boundarySensitivity,\\n  maxSensitivity: STEERING_CONFIG.maxSensitivity,\\n  accelerationDistance: STEERING_CONFIG.accelerationDistance,\\n  responseCurve: STEERING_CONFIG.responseCurveExponent,\\n  aimBoundaryWidth: STEERING_CONFIG.aimBoundaryWidth,\\n  aimBoundaryHeight: STEERING_CONFIG.aimBoundaryHeight,\\n  aimBoundaryCornerRadius: STEERING_CONFIG.aimBoundaryCornerRadius,\\n  recoverySmoothing: STEERING_CONFIG.recoverySmoothingSec,\\n  invertY: false,\\n  cameraDistance: 9.8,\\n  cameraSensitivity: 1.0,\\n  masterVolume: 0.65,\\n  graphicsQuality: \'high\',\\n  resolutionScale: 1.0,\\n  shadowQuality: \'medium\',\\n  particleQuality: \'high\',\\n  environmentDetail: \'high\',\\n  drawDistance: 4200,\\n  antialias: true,\\n  postGlowEnabled: true,\\n  showPerfOverlay: false,\\n};\\n\\nconst SETTINGS_STORAGE_KEY = \'starfall.settings.v3\';\\nconst LEGACY_SETTINGS_KEY_V2 = \'starfall.settings.v2\';\\nconst LEGACY_SETTINGS_KEY_V1 = \'starfall.settings.v1\';\\n\\nfunction clampNumber(value: unknown, min: number, max: number, fallback: number): number {\\n  return typeof value === \'number\' && Number.isFinite(value)\\n    ? Math.max(min, Math.min(max, value))\\n    : fallback;\\n}\\n\\nexport function loadSavedSettings(): GameSettings {\\n  try {\\n    const rawV3 = window.localStorage.getItem(SETTINGS_STORAGE_KEY);\\n    const raw =\\n      rawV3 ??\\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY_V2) ??\\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY_V1);\\n    if (!raw) return { ...DEFAULT_SETTINGS };\\n    const parsed = JSON.parse(raw) as Partial<GameSettings>;\\n    const validQuality =\\n      parsed.graphicsQuality === \'low\' ||\\n      parsed.graphicsQuality === \'medium\' ||\\n      parsed.graphicsQuality === \'high\' ||\\n      parsed.graphicsQuality === \'ultra\'\\n        ? parsed.graphicsQuality\\n        : DEFAULT_SETTINGS.graphicsQuality;\\n\\n    const boundarySensitivity = clampNumber(\\n      parsed.boundarySensitivity,\\n      STEERING_BOUNDS.boundarySensitivity.min,\\n      STEERING_BOUNDS.boundarySensitivity.max,\\n      DEFAULT_SETTINGS.boundarySensitivity,\\n    );\\n    const maxSensitivity = Math.max(\\n      boundarySensitivity + 0.2,\\n      clampNumber(\\n        parsed.maxSensitivity,\\n        STEERING_BOUNDS.maxSensitivity.min,\\n        STEERING_BOUNDS.maxSensitivity.max,\\n        DEFAULT_SETTINGS.maxSensitivity,\\n      ),\\n    );\\n\\n    // When migrating from v1/v2, apply the confirmed 45% x 45% rounded-rectangle boundary defaults\\n    const aimBoundaryWidth = rawV3\\n      ? clampNumber(\\n          parsed.aimBoundaryWidth,\\n          STEERING_BOUNDS.aimBoundaryWidth.min,\\n          STEERING_BOUNDS.aimBoundaryWidth.max,\\n          DEFAULT_SETTINGS.aimBoundaryWidth,\\n        )\\n      : DEFAULT_SETTINGS.aimBoundaryWidth;\\n\\n    const aimBoundaryHeight = rawV3\\n      ? clampNumber(\\n          parsed.aimBoundaryHeight,\\n          STEERING_BOUNDS.aimBoundaryHeight.min,\\n          STEERING_BOUNDS.aimBoundaryHeight.max,\\n          DEFAULT_SETTINGS.aimBoundaryHeight,\\n        )\\n      : DEFAULT_SETTINGS.aimBoundaryHeight;\\n\\n    const aimBoundaryCornerRadius = rawV3\\n      ? clampNumber(\\n          parsed.aimBoundaryCornerRadius,\\n          STEERING_BOUNDS.aimBoundaryCornerRadius.min,\\n          STEERING_BOUNDS.aimBoundaryCornerRadius.max,\\n          DEFAULT_SETTINGS.aimBoundaryCornerRadius,\\n        )\\n      : DEFAULT_SETTINGS.aimBoundaryCornerRadius;\\n\\n    const recoverySmoothing = rawV3\\n      ? clampNumber(\\n          parsed.recoverySmoothing,\\n          STEERING_BOUNDS.recoverySmoothing.min,\\n          STEERING_BOUNDS.recoverySmoothing.max,\\n          DEFAULT_SETTINGS.recoverySmoothing,\\n        )\\n      : DEFAULT_SETTINGS.recoverySmoothing;\\n\\n    return {\\n      ...DEFAULT_SETTINGS,\\n      ...parsed,\\n      mouseSensitivity: clampNumber(\\n        parsed.mouseSensitivity,\\n        STEERING_BOUNDS.mouseSensitivity.min,\\n        STEERING_BOUNDS.mouseSensitivity.max,\\n        DEFAULT_SETTINGS.mouseSensitivity,\\n      ),\\n      boundarySensitivity,\\n      maxSensitivity,\\n      accelerationDistance: clampNumber(\\n        parsed.accelerationDistance,\\n        STEERING_BOUNDS.accelerationDistance.min,\\n        STEERING_BOUNDS.accelerationDistance.max,\\n        DEFAULT_SETTINGS.accelerationDistance,\\n      ),\\n      responseCurve: clampNumber(\\n        parsed.responseCurve,\\n        STEERING_BOUNDS.responseCurve.min,\\n        STEERING_BOUNDS.responseCurve.max,\\n        DEFAULT_SETTINGS.responseCurve,\\n      ),\\n      aimBoundaryWidth,\\n      aimBoundaryHeight,\\n      aimBoundaryCornerRadius,\\n      recoverySmoothing,\\n      graphicsQuality: validQuality,\\n      resolutionScale: clampNumber(\\n        parsed.resolutionScale,\\n        0.65,\\n        1.0,\\n        DEFAULT_SETTINGS.resolutionScale,\\n      ),\\n      drawDistance: clampNumber(parsed.drawDistance, 2000, 5200, DEFAULT_SETTINGS.drawDistance),\\n      showPerfOverlay: import.meta.env.DEV ? Boolean(parsed.showPerfOverlay) : false,\\n    };\\n  } catch {\\n    return { ...DEFAULT_SETTINGS };\\n  }\\n}\\n\\nexport function saveSettings(settings: GameSettings): void {\\n  try {\\n    window.localStorage.setItem(SETTINGS_STORAGE_KEY, JSON.stringify(settings));\\n  } catch {\\n    // Ignore storage quota / privacy mode errors\\n  }\\n}\", \"StartLine\":155, \"TargetContent\":\"export const DEFAULT_SETTINGS: GameSettings = {\\n  mouseSensitivity: 1.0,\\n  boundarySensitivity: 0.35,\\n  maxSensitivity: 2.5,\\n  accelerationDistance: 240,\\n  responseCurve: 2.0,\\n  aimBoundarySize: 0.25,\\n  invertY: false,\\n  cameraDistance: 9.8,\\n  cameraSensitivity: 1.0,\\n  masterVolume: 0.65,\\n  graphicsQuality: \'high\',\\n  resolutionScale: 1.0,\\n  shadowQuality: \'medium\',\\n  particleQuality: \'high\',\\n  environmentDetail: \'high\',\\n  drawDistance: 4200,\\n  antialias: true,\\n  postGlowEnabled: true,\\n  showPerfOverlay: false,\\n};\\n\\nconst SETTINGS_STORAGE_KEY = \'starfall.settings.v2\';\\nconst LEGACY_SETTINGS_KEY = \'starfall.settings.v1\';\\n\\nfunction clampNumber(value: unknown, min: number, max: number, fallback: number): number {\\n  return typeof value === \'number\' && Number.isFinite(value)\\n    ? Math.max(min, Math.min(max, value))\\n    : fallback;\\n}\\n\\nexport function loadSavedSettings(): GameSettings {\\n  try {\\n    const raw =\\n      window.localStorage.getItem(SETTINGS_STORAGE_KEY) ??\\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY);\\n    if (!raw) return { ...DEFAULT_SETTINGS };\\n    const parsed = JSON.parse(raw) as Partial<GameSettings>;\\n    const validQuality =\\n      parsed.graphicsQuality === \'low\' ||\\n      parsed.graphicsQuality === \'medium\' ||\\n      parsed.graphicsQuality === \'high\' ||\\n      parsed.graphicsQuality === \'ultra\'\\n        ? parsed.graphicsQuality\\n        : DEFAULT_SETTINGS.graphicsQuality;\\n\\n    const boundarySensitivity = clampNumber(\\n      parsed.boundarySensitivity,\\n      0.15,\\n      1.0,\\n      DEFAULT_SETTINGS.boundarySensitivity,\\n    );\\n    const maxSensitivity = Math.max(\\n      boundarySensitivity + 0.2,\\n      clampNumber(parsed.maxSensitivity, 1.2, 3.5, DEFAULT_SETTINGS.maxSensitivity),\\n    );\\n\\n    return {\\n      ...DEFAULT_SETTINGS,\\n      ...parsed,\\n      mouseSensitivity: clampNumber(\\n        parsed.mouseSensitivity,\\n        0.3,\\n        2.5,\\n        DEFAULT_SETTINGS.mouseSensitivity,\\n      ),\\n      boundarySensitivity,\\n      maxSensitivity,\\n      accelerationDistance: clampNumber(\\n        parsed.accelerationDistance,\\n        80,\\n        500,\\n        DEFAULT_SETTINGS.accelerationDistance,\\n      ),\\n      responseCurve: clampNumber(parsed.responseCurve, 1.0, 3.5, DEFAULT_SETTINGS.responseCurve),\\n      aimBoundarySize: clampNumber(\\n        parsed.aimBoundarySize,\\n        0.15,\\n        0.38,\\n        DEFAULT_SETTINGS.aimBoundarySize,\\n      ),\\n      graphicsQuality: validQuality,\\n      resolutionScale: clampNumber(\\n        parsed.resolutionScale,\\n        0.65,\\n        1.0,\\n        DEFAULT_SETTINGS.resolutionScale,\\n      ),\\n      drawDistance: clampNumber(parsed.drawDistance, 2000, 5200, DEFAULT_SETTINGS.drawDistance),\\n      showPerfOverlay: import.meta.env.DEV ? Boolean(parsed.showPerfOverlay) : false,\\n    };\\n  } catch {\\n    return { ...DEFAULT_SETTINGS };\\n  }\\n}\\n\\nexport function saveSettings(settings: GameSettings): void {\\n  try {\\n    window.localStorage.setItem(SETTINGS_STORAGE_KEY, JSON.stringify(settings));\\n  } catch {\\n    // Ignore storage quota / privacy mode errors\\n  }\\n}\"}], \"TargetFile\":\"/src/config/ships.ts\", \"toolAction\":\"Updating config/ships.ts\", \"toolSummary\":\"Update config/ships.ts\"}"
