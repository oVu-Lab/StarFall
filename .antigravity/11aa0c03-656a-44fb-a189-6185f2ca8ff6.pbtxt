            }
            lines {
              text: "        const rect = root.getBoundingClientRect();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        viewportSizeRef.current.width = Math.max(1, rect.width);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        viewportSizeRef.current.height = Math.max(1, rect.height);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        viewportSizeRef.current.width = Math.max(1, window.innerWidth);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        viewportSizeRef.current.height = Math.max(1, window.innerHeight);"
