      thinking_signature: "\022\375\a\n\372\a\001i\024}\023K\264\304\275\2312\337\210\344\241\003\214\"\032\342\326\376H\363\377\223\224\302\220\022\227\331)-[M\321}^\342\245`1\f\321|DZ\222\367g\004\212}\221\032\311\304\213Q\242\325\2033/J\362\210\201z=K\020d\201\341\v\340\337K\200\306k\271\006\276V\337y\315\017\307)\352wt\377e\335\325\340\274\206\354h}\232W\254\207\362B\a\317;\303\242\371\f\270q\322e\001\355\341\224\200}\211U~\333\365\a\316%\343=.\352\2521\364\241\264\233T[TV\213\225\237\002\201\320\n)\354\356\b\351:0\330\310\317\243\377\234\000\031wI`\346\302S\250\2132r\3242\253\366\341\210__nH\207sm\353\326\005\350\277\275\271\201np\207\242>\362T`};\000Hx\315{\036`\023\274;k\216E\0064\a\216a\221d\276\257\210f\334\234E\t\301\321\275\344\305\305\002>\316cH\321\267\337\245T#\353\361\355\262\270\263\b\032\3458\v\363\270\315+\330\332L\211o\216\342\274?\316}\301{\364)F\301\216\326\226\365\276\217U\373\326\201[k\301\240\341\242$\373\326\211iB\224\033\230\264h(\252\v\211\031\212$\330\362\370f\002\020\333\036h\232\006\203\364\353\307\263\361\240\035\261\364$\221\234AL\262\251\257\317(\376\201\216(i?U\300\226\340\353\245\214\201\254\202\342m\315\202\243\253G\245J\335\345\243\334\313\3632\227\361~\t\235\357=\277\205\356\002\2611 \235\030\336\003\337I\"\353\216\230YP\177Vn\325\322\t\033\371g\237d\242\200\'M\3603\347x\353o\226\250,\321t}8\177.\334\250@?\263`\266S0\207\t\004\221\234\237\030\352\365\026\241\264\233g\363 \322z\266\030\256P=R\370\225\226\035b\234\034\250\237\nN\001I\n~\372Ws6a\325\303\245h?\021\226\236-\032B\236\273[\n=\036\373\305W\230\372g\323\344\346\203k\023\360\344\035\b\235L\336\030\314j.*\207\224)\037\341\025\210i<\355~\342\2212\351\272\002u&\266Kp\002\256\365\v\r\267\3570\250.\002k\3046\304\237Q\\0\t\227L}k\346/\b\336\005%\255[K\316a\267\b\316\234/1\334\375n\344\327\241\310\342\307\031]\r#\375L\354!\243\270=Z\261\233-Q8|3@C6\322\262\a\326\312\360\334\210\215\307\370\372;t\356\027\035!\374vj\311]\v1\fm,\202*\222\3616\375\034\351\237\020\267\022\256\310y\226\362\245E\301\036e\036\324\257\256\001+ \022\367\"g\t\233L\310y\353\'cm\365\025z\021\235zs\016\371\343U\326\363\344\357\024}N\311\244\005\256\240\346\t9\006\226\360\b<\367\220\003\221y\2758\302\204~\257\017j\356eNw\025L\360\fa0\213\213E\303Tm\203\026n\241\233\222M\v\256^\273\347\261_\\>m8\365#=\321\f\272\272h\003\006^\215\261]a\265\216\225Z\3725\222;b\367\021\332V\300\235\2020\023\256K\304\343\026\222\330U\323\f\343\300\362g\017\v@\236\313\335\352\300\277F\2072\201\\\240~U\274\211\307\004\272\277@r\371\333\2051\221\256\017\035\036Aa\335!<\016\266?8w\377\363\364\206\367c\326]\213\241\310G\307Q\217\325,3ZA\030\307\336E\203\235\251LjM\214\2132\352\027\f\256\327Y\367\303\352\361!\024\246\3433\344\344\306~>CF?\033\263b\'><\354\372\342BuL%\201x\\4{\022\234+\273\217\205\343H\373\2152\247\320-\032\332gq\306\354\210\336\375\354t\263\026\355\023\000f\026\215\f\210\025X\234\343\260\226\373X\020\003i.\004\232\275\313\301\2433\224]\025M\004\244\337\313\017\024\203@\242\222\321~\354\276\223"
