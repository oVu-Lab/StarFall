            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      // Subtle sci-fi rounded-rectangle corner markings (exact 45% x 45% viewport geometry, zero solid box)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      // Subtle sci-fi rounded-rectangle corner markings (exact 40% x 45% viewport geometry, zero solid box)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (aimBoundarySvgRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const b = computeRoundedRectBoundary("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          vw,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          vh,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          s.aimBoundaryWidth,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          s.aimBoundaryHeight,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          s.aimBoundaryCornerRadius,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
