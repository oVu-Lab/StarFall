        target_content: "export const DEFAULT_SETTINGS: GameSettings = {\n  mouseSensitivity: 1.0,\n  boundarySensitivity: 0.35,\n  maxSensitivity: 2.5,\n  accelerationDistance: 240,\n  responseCurve: 2.0,\n  aimBoundarySize: 0.25,\n  invertY: false,\n  cameraDistance: 9.8,\n  cameraSensitivity: 1.0,\n  masterVolume: 0.65,\n  graphicsQuality: \'high\',\n  resolutionScale: 1.0,\n  shadowQuality: \'medium\',\n  particleQuality: \'high\',\n  environmentDetail: \'high\',\n  drawDistance: 4200,\n  antialias: true,\n  postGlowEnabled: true,\n  showPerfOverlay: false,\n};\n\nconst SETTINGS_STORAGE_KEY = \'starfall.settings.v2\';\nconst LEGACY_SETTINGS_KEY = \'starfall.settings.v1\';\n\nfunction clampNumber(value: unknown, min: number, max: number, fallback: number): number {\n  return typeof value === \'number\' && Number.isFinite(value)\n    ? Math.max(min, Math.min(max, value))\n    : fallback;\n}\n\nexport function loadSavedSettings(): GameSettings {\n  try {\n    const raw =\n      window.localStorage.getItem(SETTINGS_STORAGE_KEY) ??\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY);\n    if (!raw) return { ...DEFAULT_SETTINGS };\n    const parsed = JSON.parse(raw) as Partial<GameSettings>;\n    const validQuality =\n      parsed.graphicsQuality === \'low\' ||\n      parsed.graphicsQuality === \'medium\' ||\n      parsed.graphicsQuality === \'high\' ||\n      parsed.graphicsQuality === \'ultra\'\n        ? parsed.graphicsQuality\n        : DEFAULT_SETTINGS.graphicsQuality;\n\n    const boundarySensitivity = clampNumber(\n      parsed.boundarySensitivity,\n      0.15,\n      1.0,\n      DEFAULT_SETTINGS.boundarySensitivity,\n    );\n    const maxSensitivity = Math.max(\n      boundarySensitivity + 0.2,\n      clampNumber(parsed.maxSensitivity, 1.2, 3.5, DEFAULT_SETTINGS.maxSensitivity),\n    );\n\n    return {\n      ...DEFAULT_SETTINGS,\n      ...parsed,\n      mouseSensitivity: clampNumber(\n        parsed.mouseSensitivity,\n        0.3,\n        2.5,\n        DEFAULT_SETTINGS.mouseSensitivity,\n      ),\n      boundarySensitivity,\n      maxSensitivity,\n      accelerationDistance: clampNumber(\n        parsed.accelerationDistance,\n        80,\n        500,\n        DEFAULT_SETTINGS.accelerationDistance,\n      ),\n      responseCurve: clampNumber(parsed.responseCurve, 1.0, 3.5, DEFAULT_SETTINGS.responseCurve),\n      aimBoundarySize: clampNumber(\n        parsed.aimBoundarySize,\n        0.15,\n        0.38,\n        DEFAULT_SETTINGS.aimBoundarySize,\n      ),\n      graphicsQuality: validQuality,\n      resolutionScale: clampNumber(\n        parsed.resolutionScale,\n        0.65,\n        1.0,\n        DEFAULT_SETTINGS.resolutionScale,\n      ),\n      drawDistance: clampNumber(parsed.drawDistance, 2000, 5200, DEFAULT_SETTINGS.drawDistance),\n      showPerfOverlay: import.meta.env.DEV ? Boolean(parsed.showPerfOverlay) : false,\n    };\n  } catch {\n    return { ...DEFAULT_SETTINGS };\n  }\n}\n\nexport function saveSettings(settings: GameSettings): void {\n  try {\n    window.localStorage.setItem(SETTINGS_STORAGE_KEY, JSON.stringify(settings));\n  } catch {\n    // Ignore storage quota / privacy mode errors\n  }\n}"
        replacement_content: "export const DEFAULT_SETTINGS: GameSettings = {\n  mouseSensitivity: STEERING_CONFIG.normalSensitivity,\n  boundarySensitivity: STEERING_CONFIG.boundarySensitivity,\n  maxSensitivity: STEERING_CONFIG.maxSensitivity,\n  accelerationDistance: STEERING_CONFIG.accelerationDistance,\n  responseCurve: STEERING_CONFIG.responseCurveExponent,\n  aimBoundaryWidth: STEERING_CONFIG.aimBoundaryWidth,\n  aimBoundaryHeight: STEERING_CONFIG.aimBoundaryHeight,\n  aimBoundaryCornerRadius: STEERING_CONFIG.aimBoundaryCornerRadius,\n  recoverySmoothing: STEERING_CONFIG.recoverySmoothingSec,\n  invertY: false,\n  cameraDistance: 9.8,\n  cameraSensitivity: 1.0,\n  masterVolume: 0.65,\n  graphicsQuality: \'high\',\n  resolutionScale: 1.0,\n  shadowQuality: \'medium\',\n  particleQuality: \'high\',\n  environmentDetail: \'high\',\n  drawDistance: 4200,\n  antialias: true,\n  postGlowEnabled: true,\n  showPerfOverlay: false,\n};\n\nconst SETTINGS_STORAGE_KEY = \'starfall.settings.v3\';\nconst LEGACY_SETTINGS_KEY_V2 = \'starfall.settings.v2\';\nconst LEGACY_SETTINGS_KEY_V1 = \'starfall.settings.v1\';\n\nfunction clampNumber(value: unknown, min: number, max: number, fallback: number): number {\n  return typeof value === \'number\' && Number.isFinite(value)\n    ? Math.max(min, Math.min(max, value))\n    : fallback;\n}\n\nexport function loadSavedSettings(): GameSettings {\n  try {\n    const rawV3 = window.localStorage.getItem(SETTINGS_STORAGE_KEY);\n    const raw =\n      rawV3 ??\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY_V2) ??\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY_V1);\n    if (!raw) return { ...DEFAULT_SETTINGS };\n    const parsed = JSON.parse(raw) as Partial<GameSettings>;\n    const validQuality =\n      parsed.graphicsQuality === \'low\' ||\n      parsed.graphicsQuality === \'medium\' ||\n      parsed.graphicsQuality === \'high\' ||\n      parsed.graphicsQuality === \'ultra\'\n        ? parsed.graphicsQuality\n        : DEFAULT_SETTINGS.graphicsQuality;\n\n    const boundarySensitivity = clampNumber(\n      parsed.boundarySensitivity,\n      STEERING_BOUNDS.boundarySensitivity.min,\n      STEERING_BOUNDS.boundarySensitivity.max,\n      DEFAULT_SETTINGS.boundarySensitivity,\n    );\n    const maxSensitivity = Math.max(\n      boundarySensitivity + 0.2,\n      clampNumber(\n        parsed.maxSensitivity,\n        STEERING_BOUNDS.maxSensitivity.min,\n        STEERING_BOUNDS.maxSensitivity.max,\n        DEFAULT_SETTINGS.maxSensitivity,\n      ),\n    );\n\n    // When migrating from v1/v2, apply the confirmed 45% x 45% rounded-rectangle boundary defaults\n    const aimBoundaryWidth = rawV3\n      ? clampNumber(\n          parsed.aimBoundaryWidth,\n          STEERING_BOUNDS.aimBoundaryWidth.min,\n          STEERING_BOUNDS.aimBoundaryWidth.max,\n          DEFAULT_SETTINGS.aimBoundaryWidth,\n        )\n      : DEFAULT_SETTINGS.aimBoundaryWidth;\n\n    const aimBoundaryHeight = rawV3\n      ? clampNumber(\n          parsed.aimBoundaryHeight,\n          STEERING_BOUNDS.aimBoundaryHeight.min,\n          STEERING_BOUNDS.aimBoundaryHeight.max,\n          DEFAULT_SETTINGS.aimBoundaryHeight,\n        )\n      : DEFAULT_SETTINGS.aimBoundaryHeight;\n\n    const aimBoundaryCornerRadius = rawV3\n      ? clampNumber(\n          parsed.aimBoundaryCornerRadius,\n          STEERING_BOUNDS.aimBoundaryCornerRadius.min,\n          STEERING_BOUNDS.aimBoundaryCornerRadius.max,\n          DEFAULT_SETTINGS.aimBoundaryCornerRadius,\n        )\n      : DEFAULT_SETTINGS.aimBoundaryCornerRadius;\n\n    const recoverySmoothing = rawV3\n      ? clampNumber(\n          parsed.recoverySmoothing,\n          STEERING_BOUNDS.recoverySmoothing.min,\n          STEERING_BOUNDS.recoverySmoothing.max,\n          DEFAULT_SETTINGS.recoverySmoothing,\n        )\n      : DEFAULT_SETTINGS.recoverySmoothing;\n\n    return {\n      ...DEFAULT_SETTINGS,\n      ...parsed,\n      mouseSensitivity: clampNumber(\n        parsed.mouseSensitivity,\n        STEERING_BOUNDS.mouseSensitivity.min,\n        STEERING_BOUNDS.mouseSensitivity.max,\n        DEFAULT_SETTINGS.mouseSensitivity,\n      ),\n      boundarySensitivity,\n      maxSensitivity,\n      accelerationDistance: clampNumber(\n        parsed.accelerationDistance,\n        STEERING_BOUNDS.accelerationDistance.min,\n        STEERING_BOUNDS.accelerationDistance.max,\n        DEFAULT_SETTINGS.accelerationDistance,\n      ),\n      responseCurve: clampNumber(\n        parsed.responseCurve,\n        STEERING_BOUNDS.responseCurve.min,\n        STEERING_BOUNDS.responseCurve.max,\n        DEFAULT_SETTINGS.responseCurve,\n      ),\n      aimBoundaryWidth,\n      aimBoundaryHeight,\n      aimBoundaryCornerRadius,\n      recoverySmoothing,\n      graphicsQuality: validQuality,\n      resolutionScale: clampNumber(\n        parsed.resolutionScale,\n        0.65,\n        1.0,\n        DEFAULT_SETTINGS.resolutionScale,\n      ),\n      drawDistance: clampNumber(parsed.drawDistance, 2000, 5200, DEFAULT_SETTINGS.drawDistance),\n      showPerfOverlay: import.meta.env.DEV ? Boolean(parsed.showPerfOverlay) : false,\n    };\n  } catch {\n    return { ...DEFAULT_SETTINGS };\n  }\n}\n\nexport function saveSettings(settings: GameSettings): void {\n  try {\n    window.localStorage.setItem(SETTINGS_STORAGE_KEY, JSON.stringify(settings));\n  } catch {\n    // Ignore storage quota / privacy mode errors\n  }\n}"
