            }
            lines {
              text: "export interface AxisSteeringEvaluation {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  targetSensitivity: number;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  excess: number;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  curveFactor: number;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  zone: SteeringZone;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * Pure per-axis progressive steering response evaluation."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * Let x = virtual aim displacement, B = boundary, S = accelerationDistance, p = responseCurve:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " *   e = max(0, (|x| - B) / S)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " *   f(e) = e^p / (1 + e^p)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " *   sensitivity(e) = boundarySensitivity + (maxSensitivity - boundarySensitivity) * f(e)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * Inside |x| <= B: preserves 1.0x sensitivity across [0 .. 0.80B], then smoothstep-blends"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * over [0.80B .. 1.00B] down to boundarySensitivity so the derivative is 0 at |x| = B (C1 continuous)."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "export function evaluateProgressiveAxisSensitivity("
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  absDisplacement: number,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  boundary: number,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  accelDistance: number,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  boundarySensitivity: number,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  maxSensitivity: number,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  exponent: number,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  out: AxisSteeringEvaluation = {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    targetSensitivity: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    excess: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    curveFactor: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    zone: \'precision\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "): AxisSteeringEvaluation {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  const B = Math.max(20, boundary);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  const S = Math.max(20, accelDistance);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  const bSens = THREE.MathUtils.clamp(boundarySensitivity, 0.1, 1.5);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  const mSens = Math.max(bSens, maxSensitivity);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  const p = THREE.MathUtils.clamp(exponent, 0.5, 5.0);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  if (absDisplacement <= B) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const blendStart = B * PROGRESSIVE_STEERING_CONFIG.boundaryBlendStart;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    if (absDisplacement <= blendStart) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      out.targetSensitivity = 1.0;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    } else {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      const t = (absDisplacement - blendStart) / (B - blendStart);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      const smooth = t * t * (3 - 2 * t);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      out.targetSensitivity = 1.0 + (bSens - 1.0) * smooth;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    out.excess = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    out.curveFactor = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    out.zone = \'precision\';"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    return out;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  const e = (absDisplacement - B) / S;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  const ep = Math.pow(e, p);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  const f = ep / (1 + ep);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  const targetSens = bSens + (mSens - bSens) * f;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  out.targetSensitivity = targetSens;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  out.excess = e;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  out.curveFactor = f;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  out.zone = targetSens < 1.0 ? \'transition\' : \'acceleration\';"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  return out;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "const GIMBAL_MAX_YAW_RAD = 0.24;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "const GIMBAL_MAX_PITCH_RAD = 0.17;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "const _gimbalDirLocal = new THREE.Vector3();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "const _evalX: AxisSteeringEvaluation = {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  targetSensitivity: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  excess: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  curveFactor: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  zone: \'precision\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "};"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "const _evalY: AxisSteeringEvaluation = {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  targetSensitivity: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  excess: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  curveFactor: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  zone: \'precision\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "};"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Integrates relative mouse delta onto an unconstrained virtual axis coordinate."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - Inside the rounded-rectangle boundary (excessPx == 0): pure 1:1 relative displacement."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - Pushing outward beyond the boundary: continuous with zero hard mouse input cutoff."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   Past `softOutwardCompressionStart * S` (where f(e) > 0.94), applies smooth soft compression"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   so indefinite mouse movement stays responsive without accumulating runaway unwind lag."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - Pulling inward from overdrive excess: smoothly accelerates excess retraction back to the"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   boundary edge while applying any remaining inward travel 1:1 inside the precision zone."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "function accumulateAxisDisplacement("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  rawCoord: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  clampedCoord: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  excessPx: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  stepPx: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  accelDist: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): number {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (stepPx === 0) return rawCoord;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (excessPx <= 1e-4) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return rawCoord + stepPx;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const movingOutward = stepPx * rawCoord > 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (movingOutward) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const excessRatio = excessPx / accelDist;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const compressStart = STEERING_CONFIG.softOutwardCompressionStart;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (excessRatio <= compressStart) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return rawCoord + stepPx;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const softScale = 1 / (1 + (excessRatio - compressStart) * 0.35);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return rawCoord + stepPx * softScale;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Pulling back inward while outside the boundary: smooth excess unwind without sticking"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const excessRatio = excessPx / accelDist;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const inwardGain = 1 + Math.min(2.2, excessRatio * STEERING_CONFIG.inwardExcessReturnFactor);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const inwardMag = Math.abs(stepPx);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const neededToReachBoundary = excessPx / inwardGain;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (inwardMag <= neededToReachBoundary) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return rawCoord + stepPx * inwardGain;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const remainingInward = inwardMag - neededToReachBoundary;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return clampedCoord + Math.sign(stepPx) * remainingInward;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Arcade 6DOF space flight controller."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
