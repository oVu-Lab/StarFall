              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): AxisSteeringEvaluation {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const B = Math.max(10, axisBoundaryPx);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const S = Math.max(20, accelDistancePx);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const nSens = THREE.MathUtils.clamp(normalSensitivity, 0.5, 2.0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const bSens = THREE.MathUtils.clamp(boundarySensitivity, 0.1, nSens);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const mSens = Math.max(nSens, maxSensitivity);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const p = THREE.MathUtils.clamp(exponent, 0.5, 5.0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (excessPx <= 1e-4) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const blendStart = B * STEERING_CONFIG.boundaryBlendStart;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (absCoordPx <= blendStart) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      out.targetSensitivity = nSens;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const t = THREE.MathUtils.clamp((absCoordPx - blendStart) / Math.max(1, B - blendStart), 0, 1);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const smooth = t * t * (3 - 2 * t);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      out.targetSensitivity = nSens + (bSens - nSens) * smooth;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
