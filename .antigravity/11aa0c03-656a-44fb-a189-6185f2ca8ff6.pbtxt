            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Progressive Three-Zone Virtual-Aim Steering:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * - Relative Pointer Lock `movementX` / `movementY` independently accumulates per-axis virtual"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " *   aim displacement (`virtualAimX`, `virtualAimY`)."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * - Never auto-recenters or rolls back while flying; works continuously at physical screen edges."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * - Precision Zone (|x| <= B), Transition Zone (slower initial boundary crossing), and"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " *   Acceleration Zone (smooth asymptotic turn speedup) with 0.12s delta-time recovery smoothing."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
