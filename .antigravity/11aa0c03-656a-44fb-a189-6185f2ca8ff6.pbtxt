            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Pure per-axis progressive steering sensitivity evaluation."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Inside the boundary (excessPx == 0):"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   - Core precision region [0 .. boundaryBlendStart * axisBoundary]: flat normalSensitivity (1.0x)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   - Boundary approach [boundaryBlendStart * axisBoundary .. axisBoundary]: C1 smoothstep easing"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *     down to boundarySensitivity (0.35x) so there is zero sensitivity jump when crossing the edge."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Beyond the boundary (excessPx > 0):"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   e = excessPx / accelDistance"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   f(e) = e^p / (1 + e^p)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   sensitivity(e) = boundarySensitivity + (maxSensitivity - boundarySensitivity) * f(e)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   - Zone B (transition): sensitivity < normalSensitivity (slower initial boundary crossing)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   - Zone C (acceleration): sensitivity >= normalSensitivity (progressive turn acceleration)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function evaluateProgressiveAxisSensitivity("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  absCoordPx: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
