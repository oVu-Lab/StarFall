    tool_calls {
      id: "call_13805706146423959433"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { Compass, Play, SlidersHorizontal } from \'lucide-react\';\\nimport { AudioManager } from \'../audio/AudioManager\';\\nimport { CAMPAIGN_MISSIONS } from \'../config/missions\';\\nimport type { GameSettings, MenuSection, ShipId } from \'../types/game\';\\nimport type { CampaignSaveData, MissionDefinition } from \'../types/mission\';\\nimport { HangarView } from \'./HangarView\';\\nimport { MissionSelectView } from \'./MissionSelectView\';\\nimport { SettingsPanel } from \'./SettingsPanel\';\\n\\ninterface MainMenuProps {\\n  section: MenuSection;\\n  onChangeSection: (section: MenuSection) => void;\\n  campaignSave: CampaignSaveData;\\n  selectedMissionId: string;\\n  onSelectMission: (missionId: string) => void;\\n  onLaunchMission: (mission: MissionDefinition) => void;\\n  hangarShipId: ShipId;\\n  onSelectHangarShip: (id: ShipId) => void;\\n  settings: GameSettings;\\n  onUpdateSettings: (patch: Partial<GameSettings>) => void;\\n  hangarOrbitRef: React.MutableRefObject<{ yaw: number; pitch: number }>;\\n}\\n\\nexport function MainMenu({\\n  section,\\n  onChangeSection,\\n  campaignSave,\\n  selectedMissionId,\\n  onSelectMission,\\n  onLaunchMission,\\n  hangarShipId,\\n  onSelectHangarShip,\\n  settings,\\n  onUpdateSettings,\\n  hangarOrbitRef,\\n}: MainMenuProps) {\\n  if (section === \'missions\') {\\n    return (\\n      <MissionSelectView\\n        campaignSave={campaignSave}\\n        selectedMissionId={selectedMissionId}\\n        onSelectMission={onSelectMission}\\n        onLaunchMission={onLaunchMission}\\n        onBack={() => onChangeSection(\'main\')}\\n      />\\n    );\\n  }\\n\\n  if (section === \'hangar\') {\\n    return (\\n      <HangarView\\n        selectedShipId={hangarShipId}\\n        onSelectShip={onSelectHangarShip}\\n        onLaunchFlight={() => onChangeSection(\'missions\')}\\n        onBack={() => onChangeSection(\'main\')}\\n        hangarOrbitRef={hangarOrbitRef}\\n      />\\n    );\\n  }\\n\\n  if (section === \'settings\') {\\n    return (\\n      <div className=\\\"fixed inset-0 z-20 flex items-center justify-center bg-[#030712]/65 p-6\\\">\\n        <SettingsPanel\\n          settings={settings}\\n          onUpdateSettings={onUpdateSettings}\\n          onClose={() => onChangeSection(\'main\')}\\n          closeLabel=\\\"Return to Menu\\\"\\n        />\\n      </div>\\n    );\\n  }\\n\\n  const completedCount = CAMPAIGN_MISSIONS.filter((m) => campaignSave.missions[m.id]?.completed).length;\\n\\n  return (\\n    <div className=\\\"pointer-events-none fixed inset-0 z-20 flex flex-col justify-between p-8 sm:p-12 lg:p-16\\\">\\n      {/* Subtle left-side scrim ensuring high contrast over bright nebulae while leaving 3D fighter unobstructed */}\\n      <div\\n        className=\\\"pointer-events-none fixed inset-y-0 left-0 -z-10 w-full max-w-xl bg-gradient-to-r from-[#030712]/88 via-[#030712]/55 to-transparent\\\"\\n        aria-hidden=\\\"true\\\"\\n      />\\n\\n      {/* Top Brand Wordmark */}\\n      <div className=\\\"max-w-lg\\\">\\n        <div className=\\\"flex items-center gap-3\\\">\\n          <svg\\n            width=\\\"28\\\"\\n            height=\\\"28\\\"\\n            viewBox=\\\"0 0 28 28\\\"\\n            className=\\\"shrink-0 text-cyan-400\\\"\\n            aria-hidden=\\\"true\\\"\\n          >\\n            <polygon\\n              points=\\\"14,2 25,22 14,17 3,22\\\"\\n              fill=\\\"none\\\"\\n              stroke=\\\"currentColor\\\"\\n              strokeWidth=\\\"1.8\\\"\\n            />\\n            <polygon points=\\\"14,7 19,17 14,14.5 9,17\\\" fill=\\\"currentColor\\\" />\\n          </svg>\\n          <span className=\\\"font-mono text-xs tracking-[0.26em] text-cyan-300\\\">\\n            ORBITAL COMBAT CAMPAIGN\\n          </span>\\n        </div>\\n\\n        <h1 className=\\\"mt-3 font-display text-5xl font-bold tracking-[0.14em] text-slate-50 sm:text-6xl\\\">\\n          STARFALL\\n        </h1>\\n\\n        <p className=\\\"mt-3 max-w-md text-sm leading-relaxed text-slate-300\\\">\\n          Six-degree-of-freedom arcade space combat. Command the VX-9 Vanguard across five\\n          escalating campaign operations against tactical AI fighter squadrons.\\n        </p>\\n      </div>\\n\\n      {/* Primary Action Stack */}\\n      <div className=\\\"pointer-events-auto flex w-full max-w-xs flex-col gap-3\\\">\\n        <button\\n          type=\\\"button\\\"\\n          onMouseEnter={() => AudioManager.playUiHover()}\\n          onClick={() => {\\n            AudioManager.unlock();\\n            AudioManager.playUiClick(\'primary\');\\n            onChangeSection(\'missions\');\\n          }}\\n          className=\\\"group flex items-center justify-between bg-cyan-500 px-6 py-3.5 text-sm font-semibold tracking-wide text-slate-950 transition-colors hover:bg-cyan-400 focus-visible:outline-2 focus-visible:outline-cyan-300\\\"\\n        >\\n          <span className=\\\"flex items-center gap-3\\\">\\n            <Play className=\\\"h-4 w-4 fill-current\\\" />\\n            <span>Campaign Missions</span>\\n          </span>\\n          <span className=\\\"font-mono text-xs text-slate-900/80\\\">\\n            {completedCount}/{CAMPAIGN_MISSIONS.length}\\n          </span>\\n        </button>\\n\\n        <button\\n          type=\\\"button\\\"\\n          onMouseEnter={() => AudioManager.playUiHover()}\\n          onClick={() => {\\n            AudioManager.unlock();\\n            AudioManager.playUiClick(\'secondary\');\\n            onChangeSection(\'hangar\');\\n          }}\\n          className=\\\"flex items-center justify-between border border-slate-700/90 bg-[#050c1d]/85 px-6 py-3 text-sm font-medium text-slate-100 transition-colors hover:border-cyan-400/70 hover:text-cyan-200 focus-visible:outline-2 focus-visible:outline-cyan-400\\\"\\n        >\\n          <span className=\\\"flex items-center gap-3\\\">\\n            <Compass className=\\\"h-4 w-4 text-cyan-400\\\" />\\n            <span>Hangar</span>\\n          </span>\\n          <span className=\\\"font-mono text-xs text-slate-400\\\">3 Ships</span>\\n        </button>\\n\\n        <button\\n          type=\\\"button\\\"\\n          onMouseEnter={() => AudioManager.playUiHover()}\\n          onClick={() => {\\n            AudioManager.unlock();\\n            AudioManager.playUiClick(\'secondary\');\\n            onChangeSection(\'settings\');\\n          }}\\n          className=\\\"flex items-center justify-between border border-slate-700/90 bg-[#050c1d]/85 px-6 py-3 text-sm font-medium text-slate-100 transition-colors hover:border-cyan-400/70 hover:text-cyan-200 focus-visible:outline-2 focus-visible:outline-cyan-400\\\"\\n        >\\n          <span className=\\\"flex items-center gap-3\\\">\\n            <SlidersHorizontal className=\\\"h-4 w-4 text-cyan-400\\\" />\\n            <span>Settings</span>\\n          </span>\\n          <span className=\\\"font-mono text-xs text-slate-400\\\">Graphics & Audio</span>\\n        </button>\\n      </div>\\n\\n      {/* Quiet Flight Controls Summary Footer */}\\n      <div className=\\\"flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-400\\\">\\n        <span>Mouse Continuous Steer</span>\\n        <span aria-hidden=\\\"true\\\">\302\267</span>\\n        <span>LMB Fire</span>\\n        <span aria-hidden=\\\"true\\\">\302\267</span>\\n        <span>W / S Thrust</span>\\n        <span aria-hidden=\\\"true\\\">\302\267</span>\\n        <span>A / D Roll</span>\\n        <span aria-hidden=\\\"true\\\">\302\267</span>\\n        <span>Shift Boost</span>\\n        <span aria-hidden=\\\"true\\\">\302\267</span>\\n        <span>5 Campaign Missions</span>\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Update MainMenu to route Play into Campaign Mission Select and surface campaign completion progress\", \"Overwrite\":true, \"TargetFile\":\"/src/components/MainMenu.tsx\", \"toolAction\":\"Updating MainMenu for Campaign Missions\", \"toolSummary\":\"Update MainMenu component\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_13805706146423958198"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useState } from \'react\';\\nimport { Home, List, Play, RotateCcw, SlidersHorizontal } from \'lucide-react\';\\nimport { AudioManager } from \'../audio/AudioManager\';\\nimport type { GameSettings } from \'../types/game\';\\nimport { SettingsPanel } from \'./SettingsPanel\';\\n\\ninterface PauseOverlayProps {\\n  missionLabel?: string;\\n  settings: GameSettings;\\n  onUpdateSettings: (patch: Partial<GameSettings>) => void;\\n  onResume: () => void;\\n  onRestartMission: () => void;\\n  onMissionSelect: () => void;\\n  onReturnToMenu: () => void;\\n}\\n\\nexport function PauseOverlay({\\n  missionLabel,\\n  settings,\\n  onUpdateSettings,\\n  onResume,\\n  onRestartMission,\\n  onMissionSelect,\\n  onReturnToMenu,\\n}: PauseOverlayProps) {\\n  const [showSettings, setShowSettings] = useState(false);\\n\\n  if (showSettings) {\\n    return (\\n      <div className=\\\"fixed inset-0 z-30 flex items-center justify-center bg-[#030712]/72 p-6\\\">\\n        <SettingsPanel\\n          settings={settings}\\n          onUpdateSettings={onUpdateSettings}\\n          onClose={() => setShowSettings(false)}\\n          closeLabel=\\\"Back to Pause Menu\\\"\\n        />\\n      </div>\\n    );\\n  }\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-30 flex items-center justify-center bg-[#030712]/72 p-6\\\">\\n      <div className=\\\"w-full max-w-sm border border-cyan-500/30 bg-[#050c1d]/96 p-7\\\">\\n        <div className=\\\"border-b border-slate-800 pb-4\\\">\\n          {missionLabel && (\\n            <div className=\\\"font-mono text-[11px] tracking-wider text-cyan-300\\\">\\n              {missionLabel}\\n            </div>\\n          )}\\n          <h2 className=\\\"mt-0.5 font-display text-2xl font-bold tracking-wider text-slate-100\\\">\\n            Flight Paused\\n          </h2>\\n          <p className=\\\"mt-1 text-xs text-slate-400\\\">\\n            Pointer Lock released. Resume to re-engage continuous mouse flight.\\n          </p>\\n        </div>\\n\\n        <div className=\\\"mt-5 flex flex-col gap-2.5\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onMouseEnter={() => AudioManager.playUiHover()}\\n            onClick={() => {\\n              AudioManager.unlock();\\n              AudioManager.playUiClick(\'primary\');\\n              onResume();\\n            }}\\n            className=\\\"flex items-center justify-center gap-2.5 bg-cyan-500 px-5 py-3 text-sm font-semibold text-slate-950 transition-colors hover:bg-cyan-400 focus-visible:outline-2 focus-visible:outline-cyan-300\\\"\\n          >\\n            <Play className=\\\"h-4 w-4 fill-current\\\" />\\n            <span>Resume Flight</span>\\n          </button>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onMouseEnter={() => AudioManager.playUiHover()}\\n            onClick={() => {\\n              AudioManager.playUiClick(\'secondary\');\\n              setShowSettings(true);\\n            }}\\n            className=\\\"flex items-center justify-center gap-2.5 border border-slate-700 bg-[#081226] px-5 py-2.5 text-sm font-medium text-slate-200 transition-colors hover:border-cyan-400/60 hover:text-cyan-200\\\"\\n          >\\n            <SlidersHorizontal className=\\\"h-4 w-4 text-cyan-400\\\" />\\n            <span>Settings</span>\\n          </button>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onMouseEnter={() => AudioManager.playUiHover()}\\n            onClick={() => {\\n              AudioManager.playUiClick(\'secondary\');\\n              onRestartMission();\\n            }}\\n            className=\\\"flex items-center justify-center gap-2.5 border border-slate-700 bg-[#081226] px-5 py-2.5 text-sm font-medium text-slate-200 transition-colors hover:border-cyan-400/60 hover:text-cyan-200\\\"\\n          >\\n            <RotateCcw className=\\\"h-4 w-4 text-cyan-400\\\" />\\n            <span>Restart Mission</span>\\n          </button>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onMouseEnter={() => AudioManager.playUiHover()}\\n            onClick={() => {\\n              AudioManager.playUiClick(\'secondary\');\\n              onMissionSelect();\\n            }}\\n            className=\\\"flex items-center justify-center gap-2.5 border border-slate-700 bg-[#081226] px-5 py-2.5 text-sm font-medium text-slate-200 transition-colors hover:border-cyan-400/60 hover:text-cyan-200\\\"\\n          >\\n            <List className=\\\"h-4 w-4 text-cyan-400\\\" />\\n            <span>Mission Select</span>\\n          </button>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onMouseEnter={() => AudioManager.playUiHover()}\\n            onClick={() => {\\n              AudioManager.playUiClick(\'pause\');\\n              onReturnToMenu();\\n            }}\\n            className=\\\"flex items-center justify-center gap-2.5 border border-slate-800 bg-transparent px-5 py-2.5 text-sm font-medium text-slate-400 transition-colors hover:border-slate-600 hover:text-slate-100\\\"\\n          >\\n            <Home className=\\\"h-4 w-4\\\" />\\n            <span>Main Menu</span>\\n          </button>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Update PauseOverlay with mission label, Restart Mission, and Mission Select navigation\", \"Overwrite\":true, \"TargetFile\":\"/src/components/PauseOverlay.tsx\", \"toolAction\":\"Updating PauseOverlay for campaign flow\", \"toolSummary\":\"Update PauseOverlay component\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_13805706146423956963"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useCallback, useEffect, useMemo, useRef, useState } from \'react\';\\nimport { AudioManager } from \'./audio/AudioManager\';\\nimport { FlightHUD } from \'./components/FlightHUD\';\\nimport { LoadingScreen } from \'./components/LoadingScreen\';\\nimport { MainMenu } from \'./components/MainMenu\';\\nimport { MissionResultsOverlay } from \'./components/MissionResultsOverlay\';\\nimport { PauseOverlay } from \'./components/PauseOverlay\';\\nimport { resolveEffectiveGraphics } from \'./config/graphics\';\\nimport { CAMPAIGN_MISSIONS, getMissionById, getNextMission } from \'./config/missions\';\\nimport { loadSavedSettings, saveSettings, SHIP_CONFIGS } from \'./config/ships\';\\nimport { AssetManager } from \'./engine/AssetManager\';\\nimport { CombatManager } from \'./engine/combat/CombatManager\';\\nimport { createInitialTelemetry, FlightController } from \'./engine/FlightController\';\\nimport { InputManager } from \'./engine/InputManager\';\\nimport {\\n  isMissionUnlocked,\\n  loadCampaignProgress,\\n  recordMissionOutcome,\\n} from \'./engine/mission/CampaignProgressStore\';\\nimport { MissionManager } from \'./engine/mission/MissionManager\';\\nimport { FlightCanvas } from \'./scene/FlightCanvas\';\\nimport type {\\n  GamePhase,\\n  GameSettings,\\n  LoadingProgress,\\n  MenuSection,\\n  ShipId,\\n} from \'./types/game\';\\nimport type {\\n  CampaignSaveData,\\n  MissionDefinition,\\n  MissionHudSnapshot,\\n  MissionResult,\\n} from \'./types/mission\';\\n\\nfunction getInitialSelectedMission(save: CampaignSaveData): string {\\n  // Default highlight to the latest unlocked incomplete mission, or Mission 01\\n  let latestUnlocked = CAMPAIGN_MISSIONS[0].id;\\n  for (const m of CAMPAIGN_MISSIONS) {\\n    if (isMissionUnlocked(m, save)) {\\n      latestUnlocked = m.id;\\n      if (!save.missions[m.id]?.completed) return m.id;\\n    }\\n  }\\n  return latestUnlocked;\\n}\\n\\nexport default function App() {\\n  const [phase, setPhase] = useState<GamePhase>(\'menu\');\\n  const [menuSection, setMenuSection] = useState<MenuSection>(\'main\');\\n  const [activeShipId] = useState<ShipId>(\'interceptor\');\\n  const [hangarShipId, setHangarShipId] = useState<ShipId>(\'interceptor\');\\n  const [settings, setSettings] = useState<GameSettings>(() => loadSavedSettings());\\n  const [campaignSave, setCampaignSave] = useState<CampaignSaveData>(() => loadCampaignProgress());\\n  const [selectedMissionId, setSelectedMissionId] = useState<string>(() =>\\n    getInitialSelectedMission(loadCampaignProgress()),\\n  );\\n  const [activeMissionId, setActiveMissionId] = useState<string>(CAMPAIGN_MISSIONS[0].id);\\n  const [missionHud, setMissionHud] = useState<MissionHudSnapshot | null>(null);\\n  const [missionResult, setMissionResult] = useState<MissionResult | null>(null);\\n  const [pointerLocked, setPointerLocked] = useState(false);\\n  const [playerDestroyed, setPlayerDestroyed] = useState(false);\\n  const [hintsVisible, setHintsVisible] = useState(true);\\n  const [snapCameraSignal, setSnapCameraSignal] = useState(0);\\n  const [loadingProgress, setLoadingProgress] = useState<LoadingProgress>({\\n    stage: \'Initializing flight systems\',\\n    percent: 0,\\n    shipId: \'interceptor\',\\n    error: null,\\n  });\\n\\n  // Stable engine singletons (never recreated across UI renders)\\n  const settingsRef = useRef<GameSettings>(settings);\\n  const flightRef = useRef<FlightController>(new FlightController(SHIP_CONFIGS[activeShipId]));\\n  const combatRef = useRef<CombatManager>(new CombatManager(SHIP_CONFIGS[activeShipId].maxHull));\\n  const missionManagerRef = useRef<MissionManager>(new MissionManager());\\n  const inputRef = useRef<InputManager>(new InputManager());\\n  const telemetryRef = useRef(createInitialTelemetry(SHIP_CONFIGS[activeShipId]));\\n  const hangarOrbitRef = useRef({ yaw: 0, pitch: 0 });\\n  const phaseRef = useRef<GamePhase>(phase);\\n  const campaignSaveRef = useRef<CampaignSaveData>(campaignSave);\\n  const activeAssetSessionRef = useRef<{ envKey: string | null; hullKey: string | null }>({\\n    envKey: null,\\n    hullKey: null,\\n  });\\n  const loadAbortRef = useRef<AbortController | null>(null);\\n  const pendingMissionRef = useRef<MissionDefinition | null>(null);\\n\\n  useEffect(() => {\\n    phaseRef.current = phase;\\n  }, [phase]);\\n\\n  useEffect(() => {\\n    campaignSaveRef.current = campaignSave;\\n  }, [campaignSave]);\\n\\n  useEffect(() => {\\n    settingsRef.current = settings;\\n    saveSettings(settings);\\n    AudioManager.setMasterVolume(settings.masterVolume);\\n  }, [settings]);\\n\\n  const graphics = useMemo(() => resolveEffectiveGraphics(settings), [settings]);\\n\\n  // Stage B: Background idle ship preload when opening Hangar\\n  const handleChangeMenuSection = useCallback(\\n    (next: MenuSection) => {\\n      setMenuSection(next);\\n      if (next === \'hangar\') {\\n        AssetManager.preloadShipInBackground(\'striker\', graphics.textureResolution);\\n        AssetManager.preloadShipInBackground(\'destroyer\', graphics.textureResolution);\\n      }\\n    },\\n    [graphics.textureResolution],\\n  );\\n\\n  // Stage E: Cleanly release mission-scoped GPU assets when leaving active gameplay\\n  const releaseActiveMissionAssets = useCallback(() => {\\n    const sess = activeAssetSessionRef.current;\\n    if (sess.envKey || sess.hullKey) {\\n      AssetManager.releaseMissionSession(sess.envKey, sess.hullKey);\\n      activeAssetSessionRef.current = { envKey: null, hullKey: null };\\n    }\\n  }, []);\\n\\n  // Wire MissionManager callbacks once (discrete event updates only \342\200\224 zero per-frame React state)\\n  useEffect(() => {\\n    missionManagerRef.current.setCallbacks({\\n      onHudUpdate: (snapshot) => {\\n        setMissionHud(snapshot);\\n      },\\n      onMissionEnd: (rawResult) => {\\n        inputRef.current.exitPointerLock();\\n        inputRef.current.setActive(false);\\n        AudioManager.setFlightAudioActive(false);\\n\\n        const outcome = recordMissionOutcome(\\n          campaignSaveRef.current,\\n          rawResult.missionId,\\n          rawResult.status === \'completed\',\\n          rawResult.rank,\\n          rawResult.scoreBreakdown.totalScore,\\n          rawResult.timeTakenSec,\\n        );\\n        setCampaignSave(outcome.nextSave);\\n\\n        const unlockedNew =\\n          rawResult.status === \'completed\' && !outcome.wasPreviouslyCompleted\\n            ? rawResult.unlockedNextMissionName\\n            : null;\\n\\n        setMissionResult({\\n          ...rawResult,\\n          unlockedNextMissionName: unlockedNew,\\n          isNewBestRank: outcome.isNewBestRank,\\n          isNewBestScore: outcome.isNewBestScore,\\n        });\\n        setPhase(\'results\');\\n      },\\n    });\\n  }, []);\\n\\n  // Attach global keyboard + Pointer Lock listeners once\\n  useEffect(() => {\\n    const input = inputRef.current;\\n    input.attach({\\n      onPauseRequested: () => {\\n        if (phaseRef.current === \'playing\' && !combatRef.current.playerHealth.isDestroyed) {\\n          AudioManager.playUiClick(\'pause\');\\n          AudioManager.setFlightAudioActive(false);\\n          input.setActive(false);\\n          setPhase(\'paused\');\\n        }\\n      },\\n      onPointerLockChanged: (locked) => {\\n        setPointerLocked(locked);\\n      },\\n      onToggleHudHints: () => {\\n        setHintsVisible((prev) => !prev);\\n      },\\n      onTogglePerfMonitor: () => {\\n        if (import.meta.env.DEV) {\\n          setSettings((prev) => ({ ...prev, showPerfOverlay: !prev.showPerfOverlay }));\\n        }\\n      },\\n    });\\n\\n    return () => {\\n      loadAbortRef.current?.abort();\\n      input.detach();\\n      AudioManager.dispose();\\n      AssetManager.disposeAll();\\n    };\\n  }, []);\\n\\n  // Sync InputManager & flight audio with active gameplay phase\\n  useEffect(() => {\\n    const isPlaying = phase === \'playing\' && !playerDestroyed;\\n    inputRef.current.setActive(isPlaying);\\n    AudioManager.setFlightAudioActive(isPlaying);\\n  }, [phase, playerDestroyed]);\\n\\n  const handleUpdateSettings = useCallback((patch: Partial<GameSettings>) => {\\n    setSettings((prev) => ({ ...prev, ...patch }));\\n  }, []);\\n\\n  const handleCanvasReady = useCallback((canvas: HTMLCanvasElement) => {\\n    inputRef.current.setLockTarget(canvas);\\n  }, []);\\n\\n  const handleRequestLock = useCallback(() => {\\n    AudioManager.unlock();\\n    if (!inputRef.current.isPointerLocked()) {\\n      inputRef.current.requestPointerLock();\\n    }\\n  }, []);\\n\\n  const handlePlayerDestroyed = useCallback(() => {\\n    inputRef.current.exitPointerLock();\\n    inputRef.current.setActive(false);\\n    AudioManager.setFlightAudioActive(false);\\n    setPlayerDestroyed(true);\\n  }, []);\\n\\n  const launchLoadedMission = useCallback(\\n    (mission: MissionDefinition) => {\\n      const ship = SHIP_CONFIGS[activeShipId];\\n      flightRef.current.setShipConfig(ship);\\n      flightRef.current.reset();\\n      telemetryRef.current = createInitialTelemetry(ship);\\n      setActiveMissionId(mission.id);\\n      setSelectedMissionId(mission.id);\\n      setPlayerDestroyed(false);\\n      setMissionResult(null);\\n\\n      const initialHud = missionManagerRef.current.startMission(\\n        mission,\\n        combatRef.current,\\n        ship.maxHull,\\n        flightRef.current.position,\\n      );\\n      setMissionHud(initialHud);\\n      setSnapCameraSignal((s) => s + 1);\\n      setPhase(\'playing\');\\n      inputRef.current.setActive(true);\\n      AudioManager.setFlightAudioActive(true);\\n    },\\n    [activeShipId],\\n  );\\n\\n  /**\\n   * Stage C Progressive Mission Loader with abort cancellation & error recovery.\\n   */\\n  const handleStartMission = useCallback(\\n    async (mission: MissionDefinition) => {\\n      AudioManager.unlock();\\n      loadAbortRef.current?.abort();\\n      const abortCtrl = new AbortController();\\n      loadAbortRef.current = abortCtrl;\\n      pendingMissionRef.current = mission;\\n\\n      // Release prior mission-scoped assets before loading next sector\\n      releaseActiveMissionAssets();\\n\\n      // Attempt synchronous Pointer Lock right on the Launch button gesture\\n      inputRef.current.requestPointerLock();\\n\\n      setPhase(\'loading\');\\n      setMissionResult(null);\\n      setLoadingProgress({\\n        stage: `Preparing ${mission.code} \342\200\224 ${mission.name}`,\\n        percent: 8,\\n        shipId: activeShipId,\\n        missionCode: mission.code,\\n        missionName: mission.name,\\n        sectorName: mission.environment.sectorName,\\n        error: null,\\n      });\\n\\n      try {\\n        const loaded = await AssetManager.loadMissionAssets(\\n          mission,\\n          activeShipId,\\n          graphics.textureResolution,\\n          (stage, percent) => {\\n            setLoadingProgress({\\n              stage,\\n              percent,\\n              shipId: activeShipId,\\n              missionCode: mission.code,\\n              missionName: mission.name,\\n              sectorName: mission.environment.sectorName,\\n              error: null,\\n            });\\n          },\\n          abortCtrl.signal,\\n        );\\n\\n        if (abortCtrl.signal.aborted) return;\\n        activeAssetSessionRef.current = { envKey: loaded.envKey, hullKey: loaded.hullKey };\\n        launchLoadedMission(mission);\\n      } catch (err) {\\n        if (err instanceof Error && err.message === \'ABORTED\') return;\\n        inputRef.current.exitPointerLock();\\n        setLoadingProgress((prev) => ({\\n          ...prev,\\n          error: err instanceof Error ? err.message : \'Unable to load mission sector assets.\',\\n        }));\\n      }\\n    },\\n    [activeShipId, graphics.textureResolution, launchLoadedMission, releaseActiveMissionAssets],\\n  );\\n\\n  const handleCancelLoad = useCallback(() => {\\n    loadAbortRef.current?.abort();\\n    inputRef.current.exitPointerLock();\\n    releaseActiveMissionAssets();\\n    setMenuSection(\'missions\');\\n    setPhase(\'menu\');\\n  }, [releaseActiveMissionAssets]);\\n\\n  const handleRetryLoad = useCallback(() => {\\n    const target = pendingMissionRef.current ?? getMissionById(selectedMissionId);\\n    void handleStartMission(target);\\n  }, [handleStartMission, selectedMissionId]);\\n\\n  const handlePause = useCallback(() => {\\n    if (playerDestroyed || phaseRef.current !== \'playing\') return;\\n    AudioManager.playUiClick(\'pause\');\\n    inputRef.current.exitPointerLock();\\n    inputRef.current.setActive(false);\\n    AudioManager.setFlightAudioActive(false);\\n    setPhase(\'paused\');\\n  }, [playerDestroyed]);\\n\\n  const handleResume = useCallback(() => {\\n    AudioManager.unlock();\\n    setPhase(\'playing\');\\n    inputRef.current.setActive(true);\\n    AudioManager.setFlightAudioActive(true);\\n    // Synchronous inside Resume button click gesture\\n    inputRef.current.requestPointerLock();\\n  }, []);\\n\\n  const handleRestartMission = useCallback(() => {\\n    const mission = getMissionById(activeMissionId);\\n    inputRef.current.requestPointerLock();\\n    launchLoadedMission(mission);\\n  }, [activeMissionId, launchLoadedMission]);\\n\\n  const handleGoToMissionSelect = useCallback(() => {\\n    inputRef.current.exitPointerLock();\\n    inputRef.current.setActive(false);\\n    AudioManager.setFlightAudioActive(false);\\n    missionManagerRef.current.abortMission();\\n    releaseActiveMissionAssets();\\n    setPlayerDestroyed(false);\\n    setMissionHud(null);\\n    setMissionResult(null);\\n    setMenuSection(\'missions\');\\n    setPhase(\'menu\');\\n  }, [releaseActiveMissionAssets]);\\n\\n  const handleReturnToMenu = useCallback(() => {\\n    inputRef.current.exitPointerLock();\\n    inputRef.current.setActive(false);\\n    AudioManager.setFlightAudioActive(false);\\n    missionManagerRef.current.abortMission();\\n    releaseActiveMissionAssets();\\n    setPlayerDestroyed(false);\\n    setMissionHud(null);\\n    setMissionResult(null);\\n    setMenuSection(\'main\');\\n    setPhase(\'menu\');\\n  }, [releaseActiveMissionAssets]);\\n\\n  const activeMission = useMemo(() => getMissionById(activeMissionId), [activeMissionId]);\\n  const previewMission = useMemo(() => getMissionById(selectedMissionId), [selectedMissionId]);\\n  const currentEnvironmentTheme =\\n    phase === \'menu\' && menuSection === \'missions\'\\n      ? previewMission.environment\\n      : phase === \'menu\'\\n        ? CAMPAIGN_MISSIONS[0].environment\\n        : activeMission.environment;\\n\\n  const nextMissionAfterResult = useMemo(() => {\\n    if (!missionResult || missionResult.status !== \'completed\') return null;\\n    return getNextMission(missionResult.missionId);\\n  }, [missionResult]);\\n\\n  return (\\n    <main className=\\\"relative h-screen w-screen overflow-hidden bg-[#030712]\\\">\\n      {/* Isolated Full-Viewport 3D WebGL Scene */}\\n      <FlightCanvas\\n        phase={phase}\\n        menuSection={menuSection}\\n        activeShipId={activeShipId}\\n        hangarShipId={hangarShipId}\\n        flight={flightRef.current}\\n        combat={combatRef.current}\\n        missionManager={missionManagerRef.current}\\n        missionTheme={currentEnvironmentTheme}\\n        input={inputRef.current}\\n        settingsRef={settingsRef}\\n        telemetryRef={telemetryRef}\\n        graphics={graphics}\\n        hangarOrbitRef={hangarOrbitRef}\\n        snapCameraSignal={snapCameraSignal}\\n        onCanvasReady={handleCanvasReady}\\n        onCanvasClick={handleRequestLock}\\n        onPlayerDestroyed={handlePlayerDestroyed}\\n      />\\n\\n      {/* Semantic UI Overlays */}\\n      {phase === \'menu\' && (\\n        <MainMenu\\n          section={menuSection}\\n          onChangeSection={handleChangeMenuSection}\\n          campaignSave={campaignSave}\\n          selectedMissionId={selectedMissionId}\\n          onSelectMission={setSelectedMissionId}\\n          onLaunchMission={handleStartMission}\\n          hangarShipId={hangarShipId}\\n          onSelectHangarShip={setHangarShipId}\\n          settings={settings}\\n          onUpdateSettings={handleUpdateSettings}\\n          hangarOrbitRef={hangarOrbitRef}\\n        />\\n      )}\\n\\n      {phase === \'loading\' && (\\n        <LoadingScreen\\n          progress={loadingProgress}\\n          onCancel={handleCancelLoad}\\n          onRetry={handleRetryLoad}\\n        />\\n      )}\\n\\n      {phase === \'playing\' && (\\n        <FlightHUD\\n          shipId={activeShipId}\\n          telemetryRef={telemetryRef}\\n          missionHud={missionHud}\\n          settings={settings}\\n          pointerLocked={pointerLocked}\\n          playerDestroyed={playerDestroyed}\\n          hintsVisible={hintsVisible}\\n          onToggleHints={() => setHintsVisible((v) => !v)}\\n          onRequestLock={handleRequestLock}\\n          onPause={handlePause}\\n        />\\n      )}\\n\\n      {phase === \'paused\' && (\\n        <PauseOverlay\\n          missionLabel={`${activeMission.code} \302\267 ${activeMission.name}`}\\n          settings={settings}\\n          onUpdateSettings={handleUpdateSettings}\\n          onResume={handleResume}\\n          onRestartMission={handleRestartMission}\\n          onMissionSelect={handleGoToMissionSelect}\\n          onReturnToMenu={handleReturnToMenu}\\n        />\\n      )}\\n\\n      {phase === \'results\' && missionResult && (\\n        <MissionResultsOverlay\\n          result={missionResult}\\n          onNextMission={\\n            nextMissionAfterResult\\n              ? () => {\\n                  void handleStartMission(nextMissionAfterResult);\\n                }\\n              : null\\n          }\\n          onRetryMission={handleRestartMission}\\n          onMissionSelect={handleGoToMissionSelect}\\n          onMainMenu={handleReturnToMenu}\\n        />\\n      )}\\n    </main>\\n  );\\n}\\n\", \"Description\":\"Integrate MissionManager, CampaignProgressStore, progressive Stage A-E AssetManager loading/cleanup, MissionResultsOverlay, and continuous Pointer Lock flow into App.tsx\", \"Overwrite\":true, \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Wiring Phase 3 campaign systems in App.tsx\", \"toolSummary\":\"Wire campaign systems in App.tsx\"}"
      original_name: "write_to_file"
    }
    thinking_duration {
      seconds: 113
      nanos: 672782205
    }
    stop_reason: STOP_REASON_STOP_PATTERN
    provider_assigned_message_id: "MA7_auC9MJigz7IPxJrduA4"
  }
}
