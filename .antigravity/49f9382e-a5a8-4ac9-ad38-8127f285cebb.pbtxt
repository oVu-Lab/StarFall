        target_content: "    telemetry.hull = this.hull;\n    telemetry.maxHull = this.ship.maxHull;\n    telemetry.yawRate = THREE.MathUtils.clamp(this.yawVelocity / profile.yawSpeed, -1, 1);\n    telemetry.pitchRate = THREE.MathUtils.clamp(this.pitchVelocity / profile.pitchSpeed, -1, 1);\n    telemetry.rollRate = THREE.MathUtils.clamp(this.rollVelocity / profile.rollSpeed, -1, 1);\n    telemetry.aimNormalizedX = this.aimCursorX;\n    telemetry.aimNormalizedY = this.aimCursorY;\n    telemetry.aimScreenX = 0.5 + this.aimCursorX * VIRTUAL_AIM_CONFIG.maxScreenOffsetX;\n    telemetry.aimScreenY = 0.5 + this.aimCursorY * VIRTUAL_AIM_CONFIG.maxScreenOffsetY;\n    telemetry.headingDeg = headingDeg;\n    telemetry.pitchDeg = THREE.MathUtils.radToDeg(_euler.x);\n    telemetry.rollDeg = THREE.MathUtils.radToDeg(_euler.z);\n    telemetry.altitude = this.position.y;\n    telemetry.status = status;\n    telemetry.pointerLocked = input.pointerLocked;\n  }\n}"
        replacement_content: "    telemetry.hull = this.hull;\n    telemetry.maxHull = this.ship.maxHull;\n    telemetry.yawRate = THREE.MathUtils.clamp(this.yawVelocity / profile.yawSpeed, -1, 1);\n    telemetry.pitchRate = THREE.MathUtils.clamp(this.pitchVelocity / profile.pitchSpeed, -1, 1);\n    telemetry.rollRate = THREE.MathUtils.clamp(this.rollVelocity / profile.rollSpeed, -1, 1);\n    telemetry.aimNormalizedX = this.aimCursorX;\n    telemetry.aimNormalizedY = this.aimCursorY;\n\n    const maxScreenOffsetX = boundarySize;\n    const maxScreenOffsetY = Math.min(\n      PROGRESSIVE_STEERING_CONFIG.maxVerticalScreenOffset,\n      boundarySize * PROGRESSIVE_STEERING_CONFIG.verticalScreenAspectRatio,\n    );\n    const overdriveX =\n      _evalX.excess > 0\n        ? Math.sign(this.virtualAimX) *\n          _evalX.curveFactor *\n          PROGRESSIVE_STEERING_CONFIG.overdriveReticleStretch\n        : 0;\n    const overdriveY =\n      _evalY.excess > 0\n        ? Math.sign(this.virtualAimY) *\n          _evalY.curveFactor *\n          PROGRESSIVE_STEERING_CONFIG.overdriveReticleStretch\n        : 0;\n\n    telemetry.aimScreenX = 0.5 + this.aimCursorX * maxScreenOffsetX + overdriveX;\n    telemetry.aimScreenY = 0.5 + this.aimCursorY * maxScreenOffsetY + overdriveY;\n\n    const activeZone: SteeringZone =\n      _evalX.zone === \'acceleration\' || _evalY.zone === \'acceleration\'\n        ? \'acceleration\'\n        : _evalX.zone === \'transition\' || _evalY.zone === \'transition\'\n          ? \'transition\'\n          : \'precision\';\n    telemetry.steeringZone = activeZone;\n    telemetry.steeringSensitivityX = this.smoothedSensX;\n    telemetry.steeringSensitivityY = this.smoothedSensY;\n    telemetry.steeringAccelRatio = Math.max(_evalX.curveFactor, _evalY.curveFactor);\n\n    telemetry.headingDeg = headingDeg;\n    telemetry.pitchDeg = THREE.MathUtils.radToDeg(_euler.x);\n    telemetry.rollDeg = THREE.MathUtils.radToDeg(_euler.z);\n    telemetry.altitude = this.position.y;\n    telemetry.status = status;\n    telemetry.pointerLocked = input.pointerLocked;\n  }\n}"
