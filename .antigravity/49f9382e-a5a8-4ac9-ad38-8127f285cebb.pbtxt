            }
            lines {
              text: "  /**"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   * Advances arcade flight simulation by delta time `dt` (seconds) and writes live telemetry."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  public update("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    dt: number,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    input: InputSnapshot,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    settings: GameSettings,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    telemetry: FlightTelemetry,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  ): void {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const profile = this.ship.flight;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // 1. Expanded Gimbaled Mouse Aiming Envelope + Precision Response Curve"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // 1. Unbounded Continuous Relative Mouse Turning (Zero Clamp, Zero Auto-Recenter Snap-Back)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const sens = settings.mouseSensitivity;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const baseRadPerPx = 0.0024 * sens;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const radPerPx = 0.00235 * sens;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const ySign = settings.invertY ? 1 : -1;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const shapedDx = shapeMouseDelta(input.mouseDeltaX);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const shapedDy = shapeMouseDelta(input.mouseDeltaY);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    this.aimYawOffset += -shapedDx * baseRadPerPx;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    this.aimPitchOffset += shapedDy * baseRadPerPx * ySign;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // Optional arrow key steering pushes the aim envelope smoothly"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    if (input.keyYawLeft) this.aimYawOffset += profile.yawSpeed * 0.65 * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    if (input.keyYawRight) this.aimYawOffset -= profile.yawSpeed * 0.65 * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    if (input.keyPitchUp) this.aimPitchOffset += profile.pitchSpeed * 0.65 * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    if (input.keyPitchDown) this.aimPitchOffset -= profile.pitchSpeed * 0.65 * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // Softly constrain aim offset to a spacious elliptical envelope (no harsh box clipping)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const normX = this.aimYawOffset / MAX_AIM_YAW_RAD;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const normY = this.aimPitchOffset / MAX_AIM_PITCH_RAD;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const radial = Math.hypot(normX, normY);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    if (radial > 1.0) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      this.aimYawOffset /= radial;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      this.aimPitchOffset /= radial;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // 2. Smooth Chase-the-Aim-Vector Angular Authority (non-linear: ultra-precise near center, strong sweeps at rim)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const absYawRatio = Math.min(1, Math.abs(this.aimYawOffset) / MAX_AIM_YAW_RAD);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const absPitchRatio = Math.min(1, Math.abs(this.aimPitchOffset) / MAX_AIM_PITCH_RAD);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // Progressive authority curve keeps tiny corrections silky while allowing rapid full-range turns"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const yawCurve = 0.55 * absYawRatio + 0.72 * Math.pow(absYawRatio, 1.45);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const pitchCurve = 0.55 * absPitchRatio + 0.72 * Math.pow(absPitchRatio, 1.45);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const targetYawVel ="
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      Math.sign(this.aimYawOffset) * yawCurve * profile.yawSpeed * 1.45;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const targetPitchVel ="
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      Math.sign(this.aimPitchOffset) * pitchCurve * profile.pitchSpeed * 1.45;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const angularAlpha = 1 - Math.exp(-(profile.angularDamping * 1.55) * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    this.yawVelocity = THREE.MathUtils.lerp(this.yawVelocity, targetYawVel, angularAlpha);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    this.pitchVelocity = THREE.MathUtils.lerp(this.pitchVelocity, targetPitchVel, angularAlpha);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // Prevent overshoot: ship rotation step eats the remaining aim offset cleanly"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    let stepYaw = this.yawVelocity * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    let stepPitch = this.pitchVelocity * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    if (Math.sign(stepYaw) === Math.sign(this.aimYawOffset) && Math.abs(stepYaw) > Math.abs(this.aimYawOffset)) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      stepYaw = this.aimYawOffset;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    if (Math.sign(stepPitch) === Math.sign(this.aimPitchOffset) && Math.abs(stepPitch) > Math.abs(this.aimPitchOffset)) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      stepPitch = this.aimPitchOffset;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    this.aimYawOffset -= stepYaw;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    this.aimPitchOffset -= stepPitch;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // Tiny deadzone snap only when essentially centered so ship holds rock-steady aim"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    if (Math.abs(this.aimYawOffset) < 1e-4 && Math.abs(input.mouseDeltaX) < 0.01) {"
