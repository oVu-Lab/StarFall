      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Center virtual aim cursor cleanly when resuming from the pause menu in App.tsx\", \"EndLine\":345, \"Instruction\":\"Call flightRef.current.centerAimCursor() in handleResume in App.tsx so unpausing starts straight flight until the player moves the mouse.\", \"ReplacementContent\":\"  const handleResume = useCallback(() => {\\n    AudioManager.unlock();\\n    flightRef.current.centerAimCursor();\\n    setPhase(\'playing\');\\n    inputRef.current.setActive(true);\\n    AudioManager.setFlightAudioActive(true);\\n    // Synchronous inside Resume button click gesture\\n    inputRef.current.requestPointerLock();\\n  }, []);\", \"StartLine\":335, \"TargetContent\":\"  const handleResume = useCallback(() => {\\n    AudioManager.unlock();\\n    setPhase(\'playing\');\\n    inputRef.current.setActive(true);\\n    AudioManager.setFlightAudioActive(true);\\n    // Synchronous inside Resume button click gesture\\n    inputRef.current.requestPointerLock();\\n  }, []);\", \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Centering virtual cursor on pause resume in App.tsx\", \"toolSummary\":\"Update App.tsx handleResume\"}"
