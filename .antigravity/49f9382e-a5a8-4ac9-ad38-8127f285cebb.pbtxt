    command_line: "NODE_PATH=/usr/local/share/bun-global/node_modules node -e \'\nconst { chromium } = require(\"playwright\");\n(async () => {\n  const browser = await chromium.launch({\n    headless: true,\n    args: [\"--no-sandbox\", \"--use-gl=angle\", \"--use-angle=swiftshader\"]\n  });\n  const page = await browser.newPage({ viewport: { width: 1280, height: 720 } });\n  await page.addInitScript(() => {\n    localStorage.setItem(\"starfall.settings.v2\", JSON.stringify({\n      graphicsQuality: \"low\", resolutionScale: 0.65, shadowQuality: \"off\",\n      particleQuality: \"low\", environmentDetail: \"low\", drawDistance: 2400,\n      antialias: false, postGlowEnabled: false\n    }));\n  });\n\n  await page.goto(\"http://localhost:3000/\", { waitUntil: \"domcontentloaded\" });\n  await page.waitForSelector(\"button\");\n  await page.getByRole(\"button\", { name: /Campaign Missions/i }).click({ force: true });\n  await page.getByRole(\"button\", { name: /Launch M-01/i }).click({ force: true });\n  await page.waitForFunction(() => document.body.innerText.includes(\"Hull Integrity\"), null, { timeout: 25000 });\n\n  // Measure reticle pixel position & ship heading during and AFTER moving mouse right\n  const samples = await page.evaluate(async () => {\n    const out = [];\n    const getReticle = () => {\n      // Find the aiming reticle div containing the 46x46 svg\n      const svg = document.querySelector(\"svg[width=\\\"46\\\"][height=\\\"46\\\"]\");\n      const rect = svg ? svg.parentElement.getBoundingClientRect() : null;\n      const hdg = document.body.innerText.match(/HDG\\s+(\\d+)\302\260/)?.[1];\n      return {\n        pl: document.pointerLockElement?.tagName || null,\n        reticleX: rect ? Math.round(rect.left + rect.width / 2) : null,\n        reticleY: rect ? Math.round(rect.top + rect.height / 2) : null,\n        hdg: Number(hdg)\n      };\n    };\n    const waitFrame = () => new Promise(r => requestAnimationFrame(r));\n\n    out.push({ phase: \"start\", ...getReticle() });\n    // Move mouse right for 15 frames (reaching edge)\n    for (let i = 0; i < 15; i++) {\n      window.dispatchEvent(new MouseEvent(\"mousemove\", { movementX: 35, movementY: 0, bubbles: true }));\n      await waitFrame();\n      if (i === 5 || i === 14) out.push({ phase: \"moving_\" + i, ...getReticle() });\n    }\n    // Now HOLD mouse stationary at the edge for 30 frames (0.5s)\n    for (let i = 1; i <= 30; i++) {\n      await waitFrame();\n      if (i === 5 || i === 15 || i === 30) out.push({ phase: \"held_at_edge_\" + i, ...getReticle() });\n    }\n    return out;\n  });\n  console.log(\"CURRENT_BEHAVIOR_TRACE:\", JSON.stringify(samples, null, 2));\n  await browser.close();\n  process.exit(0);\n})().catch(e => { console.error(e); process.exit(1); });\n\'"
    proposed_command_line: "NODE_PATH=/usr/local/share/bun-global/node_modules node -e \'\nconst { chromium } = require(\"playwright\");\n(async () => {\n  const browser = await chromium.launch({\n    headless: true,\n    args: [\"--no-sandbox\", \"--use-gl=angle\", \"--use-angle=swiftshader\"]\n  });\n  const page = await browser.newPage({ viewport: { width: 1280, height: 720 } });\n  await page.addInitScript(() => {\n    localStorage.setItem(\"starfall.settings.v2\", JSON.stringify({\n      graphicsQuality: \"low\", resolutionScale: 0.65, shadowQuality: \"off\",\n      particleQuality: \"low\", environmentDetail: \"low\", drawDistance: 2400,\n      antialias: false, postGlowEnabled: false\n    }));\n  });\n\n  await page.goto(\"http://localhost:3000/\", { waitUntil: \"domcontentloaded\" });\n  await page.waitForSelector(\"button\");\n  await page.getByRole(\"button\", { name: /Campaign Missions/i }).click({ force: true });\n  await page.getByRole(\"button\", { name: /Launch M-01/i }).click({ force: true });\n  await page.waitForFunction(() => document.body.innerText.includes(\"Hull Integrity\"), null, { timeout: 25000 });\n\n  // Measure reticle pixel position & ship heading during and AFTER moving mouse right\n  const samples = await page.evaluate(async () => {\n    const out = [];\n    const getReticle = () => {\n      // Find the aiming reticle div containing the 46x46 svg\n      const svg = document.querySelector(\"svg[width=\\\"46\\\"][height=\\\"46\\\"]\");\n      const rect = svg ? svg.parentElement.getBoundingClientRect() : null;\n      const hdg = document.body.innerText.match(/HDG\\s+(\\d+)\302\260/)?.[1];\n      return {\n        pl: document.pointerLockElement?.tagName || null,\n        reticleX: rect ? Math.round(rect.left + rect.width / 2) : null,\n        reticleY: rect ? Math.round(rect.top + rect.height / 2) : null,\n        hdg: Number(hdg)\n      };\n    };\n    const waitFrame = () => new Promise(r => requestAnimationFrame(r));\n\n    out.push({ phase: \"start\", ...getReticle() });\n    // Move mouse right for 15 frames (reaching edge)\n    for (let i = 0; i < 15; i++) {\n      window.dispatchEvent(new MouseEvent(\"mousemove\", { movementX: 35, movementY: 0, bubbles: true }));\n      await waitFrame();\n      if (i === 5 || i === 14) out.push({ phase: \"moving_\" + i, ...getReticle() });\n    }\n    // Now HOLD mouse stationary at the edge for 30 frames (0.5s)\n    for (let i = 1; i <= 30; i++) {\n      await waitFrame();\n      if (i === 5 || i === 15 || i === 30) out.push({ phase: \"held_at_edge_\" + i, ...getReticle() });\n    }\n    return out;\n  });\n  console.log(\"CURRENT_BEHAVIOR_TRACE:\", JSON.stringify(samples, null, 2));\n  await browser.close();\n  process.exit(0);\n})().catch(e => { console.error(e); process.exit(1); });\n\'"
