            lines {
              text: " * Configurable Virtual Aiming Region (independent of physical monitor/cursor edges)."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * - Keeps the virtual aiming reticle inside a comfortable central combat envelope"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " *   well clear of HUD instruments and extreme screen edges."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * - Uses a smooth elliptical clamp so reaching or gliding along the boundary never snaps"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " *   and reversing direction inward responds on the very first pixel of mouse movement."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "export interface VirtualAimConfig {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  /** Max horizontal reticle offset from screen center (fraction of viewport width, 0..0.5) */"
