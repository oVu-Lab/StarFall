            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    vec3 col = uVoidCol;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
