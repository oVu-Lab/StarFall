    command_line: "NODE_PATH=/usr/local/share/bun-global/node_modules node -e \'\nconst { chromium } = require(\"playwright\");\n\n(async () => {\n  const browser = await chromium.launch({\n    headless: true,\n    args: [\"--no-sandbox\", \"--use-gl=angle\", \"--use-angle=swiftshader\"],\n  });\n  const context = await browser.newContext({ viewport: { width: 1280, height: 720 } });\n  const page = await context.newPage();\n\n  const pageErrors = [];\n  const consoleErrors = [];\n  page.on(\"pageerror\", (e) => pageErrors.push(e.message));\n  page.on(\"console\", (msg) => {\n    if (msg.type() === \"error\") consoleErrors.push(msg.text());\n  });\n\n  await page.addInitScript(() => {\n    localStorage.setItem(\"starfall.settings.v2\", JSON.stringify({\n      mouseSensitivity: 1.0,\n      invertY: false,\n      cameraSensitivity: 1.0,\n      masterVolume: 0.4,\n      sfxVolume: 0.5,\n      musicVolume: 0.3,\n      graphicsPreset: \"low\",\n      fov: 62,\n      showPerfOverlay: false,\n    }));\n    window.__plErrors = 0;\n    document.addEventListener(\"pointerlockerror\", () => { window.__plErrors++; });\n  });\n\n  const waitFrames = async (count) => {\n    await page.evaluate((n) => new Promise((resolve) => {\n      let left = n;\n      const tick = () => {\n        if (--left <= 0) resolve();\n        else requestAnimationFrame(tick);\n      };\n      requestAnimationFrame(tick);\n    }), count);\n  };\n\n  const dispatchRel = async (dx, dy) => {\n    await page.evaluate(([mx, my]) => {\n      const evt = new MouseEvent(\"mousemove\", { bubbles: true, cancelable: true, movementX: mx, movementY: my });\n      Object.defineProperty(evt, \"movementX\", { value: mx });\n      Object.defineProperty(evt, \"movementY\", { value: my });\n      window.dispatchEvent(evt);\n    }, [dx, dy]);\n  };\n\n  const readHud = async () => {\n    return await page.evaluate(() => {\n      const cursor = document.querySelector(\"[data-testid=\\\"virtual-mouse-cursor\\\"]\");\n      const rect = cursor ? cursor.getBoundingClientRect() : null;\n      const cx = rect ? rect.left + rect.width / 2 : null;\n      const cy = rect ? rect.top + rect.height / 2 : null;\n\n      const text = document.body.innerText;\n      const hdgMatch = text.match(/HDG\\s+([0-9.\\-]+)/);\n      const pitchMatch = text.match(/PITCH\\s+([0-9.\\-+]+)/);\n      const speedMatch = text.match(/([0-9]+)\\s*m\\/s/);\n      const isBoosting = /BOOSTING/i.test(text);\n      const plTag = document.pointerLockElement ? document.pointerLockElement.tagName : null;\n\n      return {\n        plTag,\n        plErrors: window.__plErrors || 0,\n        cursorX: cx !== null ? Number(cx.toFixed(1)) : null,\n        cursorY: cy !== null ? Number(cy.toFixed(1)) : null,\n        hdg: hdgMatch ? Number(hdgMatch[1]) : null,\n        pitch: pitchMatch ? Number(pitchMatch[1]) : null,\n        speed: speedMatch ? Number(speedMatch[1]) : null,\n        isBoosting,\n      };\n    });\n  };\n\n  await page.goto(\"http://localhost:3000/\", { waitUntil: \"domcontentloaded\", timeout: 30000 });\n  await page.waitForSelector(\"text=Campaign Missions\", { timeout: 30000 });\n  await page.click(\"text=Campaign Missions\");\n  await page.waitForSelector(\"text=Launch M-01\", { timeout: 20000 });\n  await page.click(\"text=Launch M-01\");\n  await page.waitForFunction(() => !!document.querySelector(\"[data-testid=\\\"virtual-mouse-cursor\\\"]\"), { timeout: 45000 });\n  await waitFrames(2);\n\n  // 1. Acquire Pointer Lock on CANVAS\n  await page.mouse.click(640, 360);\n  await waitFrames(2);\n  const init = await readHud();\n  console.log(\"1. INIT:\", init);\n\n  // 2. Push strongly right (+400px) -> clamps cleanly at X=960 (75% of 1280), stays pinned, HDG turns continuously\n  await dispatchRel(200, 0);\n  await dispatchRel(200, 0);\n  await waitFrames(2);\n  const right0 = await readHud();\n  await waitFrames(4);\n  const right1 = await readHud();\n  console.log(\"2. RIGHT_F0:\", right0);\n  console.log(\"   RIGHT_F+4:\", right1);\n\n  // 3. Immediate reversal (-25px left) -> moves inward from 960 on the very next frame (zero dead-travel)\n  await dispatchRel(-25, 0);\n  await waitFrames(2);\n  const rightRev = await readHud();\n  console.log(\"3. RIGHT_REVERSE_-25PX:\", rightRev);\n\n  // 4. Push strongly left (-600px) -> clamps cleanly at X=320 (25%), stays pinned, HDG turns left continuously\n  await dispatchRel(-300, 0);\n  await dispatchRel(-300, 0);\n  await waitFrames(2);\n  const left0 = await readHud();\n  await waitFrames(4);\n  const left1 = await readHud();\n  console.log(\"4. LEFT_F0:\", left0);\n  console.log(\"   LEFT_F+4:\", left1);\n\n  // 5. Center X (+210px), push strongly up (-600px) -> clamps cleanly at Y=172.8 (24%), continuous pitch up\n  await dispatchRel(210, 0);\n  await dispatchRel(0, -300);\n  await dispatchRel(0, -300);\n  await waitFrames(2);\n  const top0 = await readHud();\n  await waitFrames(4);\n  const top1 = await readHud();\n  console.log(\"5. TOP_F0:\", top0);\n  console.log(\"   TOP_F+4:\", top1);\n\n  // 6. Push strongly down (+600px) -> clamps cleanly at Y=547.2 (76%), continuous pitch down\n  await dispatchRel(0, 300);\n  await dispatchRel(0, 300);\n  await waitFrames(2);\n  const bot0 = await readHud();\n  await waitFrames(4);\n  const bot1 = await readHud();\n  console.log(\"6. BOTTOM_F0:\", bot0);\n  console.log(\"   BOTTOM_F+4:\", bot1);\n\n  // 7. Diagonal push (+300, -300) from center -> verify elliptical perimeter constraint\n  await dispatchRel(0, -210);\n  await waitFrames(2);\n  await dispatchRel(300, -300);\n  await waitFrames(2);\n  const diag = await readHud();\n  const diagEllipse = Math.pow((diag.cursorX - 640) / 320, 2) + Math.pow((diag.cursorY - 360) / 187.2, 2);\n  console.log(\"7. DIAGONAL:\", { ...diag, ellipseEq: Number(diagEllipse.toFixed(4)) });\n\n  // 8. Boost check (center cursor, hold W + ShiftLeft across 5 frames)\n  await dispatchRel(-148, 148);\n  await waitFrames(2);\n  const preBoost = await readHud();\n  await page.keyboard.down(\"KeyW\");\n  await page.keyboard.down(\"ShiftLeft\");\n  await waitFrames(5);\n  const midBoost = await readHud();\n  await page.keyboard.up(\"ShiftLeft\");\n  await page.keyboard.up(\"KeyW\");\n  console.log(\"8. BOOST_PRE:\", { speed: preBoost.speed, isBoosting: preBoost.isBoosting });\n  console.log(\"   BOOST_MID:\", { speed: midBoost.speed, isBoosting: midBoost.isBoosting });\n\n  // 9. Pause with Escape and Resume Flight re-lock check\n  await page.keyboard.press(\"Escape\");\n  await waitFrames(2);\n  const paused = await page.evaluate(() => ({\n    plTag: document.pointerLockElement ? document.pointerLockElement.tagName : null,\n    hasResume: /Resume Flight/i.test(document.body.innerText),\n  }));\n  console.log(\"9. PAUSED:\", paused);\n\n  await page.click(\"text=Resume Flight\");\n  await waitFrames(2);\n  const resumed = await readHud();\n  console.log(\"10. RESUMED:\", resumed);\n\n  console.log(\"ERRORS:\", {\n    pageErrors,\n    consoleErrors: consoleErrors.filter((e) => !e.includes(\"WebSocket\")),\n  });\n  await browser.close();\n})().catch((err) => {\n  console.error(\"TEST_FAILED:\", err);\n  process.exit(1);\n});\n\'"
