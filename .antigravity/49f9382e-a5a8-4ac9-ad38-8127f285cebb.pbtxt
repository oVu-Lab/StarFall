        use_fast_apply: true
        replacement_chunks {
          target_content: "/**\n * Precision-preserving relative mouse curve:\n * - Small micro-adjustments (<= 5px) remain ultra-fine and controllable for pinpoint gunnery.\n * - Larger continuous sweeps pass through linearly with zero clipping and zero artificial cap.\n */\nfunction shapeRelativeMouseDelta(deltaPx: number): number {\n  const abs = Math.abs(deltaPx);\n  if (abs < 0.0001) return 0;\n  const shaped = abs <= 5 ? abs * 0.84 : 4.2 + (abs - 5) * 1.04;\n  return Math.sign(deltaPx) * shaped;\n}\n\n/**\n * Arcade 6DOF space flight controller.\n * Ship coordinate system: Forward = -Z, Right = +X, Up = +Y.\n *\n * Phase 3 Continuous Mouse Turning:\n * - Directly integrates unbounded relative Pointer Lock deltas into smooth local-space\n *   quaternion rotation without any screen-edge boundary, gimbal clamp, or cursor snap-back.\n * - Supports unlimited 360-degree continuous yaw, pitch loops, and independent A/D barrel rolls.\n */\nexport class FlightController {\n  public readonly position = new THREE.Vector3(0, 12, 40);\n  public readonly quaternion = new THREE.Quaternion();\n  public readonly velocity = new THREE.Vector3(0, 0, -24);\n\n  // Smoothed angular rates (rad/s) in ship local space\n  public yawVelocity = 0;\n  public pitchVelocity = 0;\n  public rollVelocity = 0;\n\n  // Unbounded micro-smoothing buffer for crisp, lag-free relative mouse deltas (no clamp, no snap-back)\n  private pendingYawRad = 0;\n  private pendingPitchRad = 0;\n\n  // Visual banking angle layered on the ship mesh for tactile feel\n  public visualBankAngle = 0;\n\n  private ship: ShipConfig;\n  private boostEnergy: number;\n  private boostCooldownTimer = 0;\n  private boostLockedOut = false;\n  private boostIntensity = 0;\n  private wasBoosting = false;\n  private hull: number;\n  private boostJustEngaged = false;\n\n  public constructor(ship: ShipConfig) {\n    this.ship = ship;\n    this.boostEnergy = ship.flight.maxBoostEnergy;\n    this.hull = ship.maxHull;\n  }\n\n  public setShipConfig(ship: ShipConfig): void {\n    this.ship = ship;\n    this.boostEnergy = Math.min(this.boostEnergy, ship.flight.maxBoostEnergy);\n    this.hull = ship.maxHull;\n  }\n\n  public reset(startPosition?: THREE.Vector3): void {\n    if (startPosition) {\n      this.position.copy(startPosition);\n    } else {\n      this.position.set(0, 12, 40);\n    }\n    this.quaternion.identity();\n    this.velocity.set(0, 0, -28);\n    this.yawVelocity = 0;\n    this.pitchVelocity = 0;\n    this.rollVelocity = 0;\n    this.pendingYawRad = 0;\n    this.pendingPitchRad = 0;\n    this.visualBankAngle = 0;\n    this.boostEnergy = this.ship.flight.maxBoostEnergy;\n    this.boostCooldownTimer = 0;\n    this.boostLockedOut = false;\n    this.boostIntensity = 0;\n    this.wasBoosting = false;\n    this.hull = this.ship.maxHull;\n  }\n\n  public getBoostJustEngaged(): boolean {\n    return this.boostJustEngaged;\n  }\n\n  /**\n   * Returns exact unit world-space forward firing direction aligned 1:1 with the ship nose\n   * and the projected 3D aiming reticle.\n   */\n  public getAimDirectionWorld(out: THREE.Vector3): THREE.Vector3 {\n    out.copy(_FORWARD_LOCAL).applyQuaternion(this.quaternion).normalize();\n    return out;\n  }\n\n  /**\n   * Computes the 3D world-space convergence point along the player\'s true forward firing ray.\n   */\n  public getAimTargetPoint(out: THREE.Vector3, distance: number): THREE.Vector3 {\n    this.getAimDirectionWorld(out);\n    out.multiplyScalar(distance).add(this.position);\n    return out;\n  }\n\n  /**\n   * Advances arcade flight simulation by delta time `dt` (seconds) and writes live telemetry.\n   */\n  public update(\n    dt: number,\n    input: InputSnapshot,\n    settings: GameSettings,\n    telemetry: FlightTelemetry,\n  ): void {\n    const profile = this.ship.flight;\n    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);\n\n    // 1. Unbounded Continuous Relative Mouse Turning (Zero Clamp, Zero Auto-Recenter Snap-Back)\n    const sens = settings.mouseSensitivity;\n    const radPerPx = 0.00235 * sens;\n    const ySign = settings.invertY ? 1 : -1;\n\n    const shapedDx = shapeRelativeMouseDelta(input.mouseDeltaX);\n    const shapedDy = shapeRelativeMouseDelta(input.mouseDeltaY);\n\n    // Accumulate raw relative turn radians directly \342\200\224 never clamped to a screen box!\n    this.pendingYawRad += -shapedDx * radPerPx;\n    this.pendingPitchRad += shapedDy * radPerPx * ySign;\n\n    // Optional arrow-key steering adds smoothly to the same unbounded angular accumulator\n    if (input.keyYawLeft) this.pendingYawRad += profile.yawSpeed * 0.85 * safeDt;\n    if (input.keyYawRight) this.pendingYawRad -= profile.yawSpeed * 0.85 * safeDt;\n    if (input.keyPitchUp) this.pendingPitchRad += profile.pitchSpeed * 0.85 * safeDt;\n    if (input.keyPitchDown) this.pendingPitchRad -= profile.pitchSpeed * 0.85 * safeDt;\n\n    // Critically damped high-responsiveness integration consumes pending turn smoothly\n    // while preserving 100% of total cumulative mouse rotation with zero snap-back.\n    const responseRate = 24.0;\n    const consumeFraction = 1 - Math.exp(-responseRate * safeDt);\n    const stepYaw = this.pendingYawRad * consumeFraction;\n    const stepPitch = this.pendingPitchRad * consumeFraction;\n\n    this.pendingYawRad -= stepYaw;\n    this.pendingPitchRad -= stepPitch;\n\n    // Clean epsilon flush only when completely idle\n    if (Math.abs(this.pendingYawRad) < 1e-6) this.pendingYawRad = 0;\n    if (Math.abs(this.pendingPitchRad) < 1e-6) this.pendingPitchRad = 0;\n\n    // Track instantaneous smoothed angular velocity for camera turn lag & visual ship banking\n    const instYawVel = stepYaw / safeDt;\n    const instPitchVel = stepPitch / safeDt;\n    const rateAlpha = 1 - Math.exp(-12.0 * safeDt);\n    this.yawVelocity = THREE.MathUtils.lerp(\n      this.yawVelocity,\n      THREE.MathUtils.clamp(instYawVel, -profile.yawSpeed * 2.2, profile.yawSpeed * 2.2),\n      rateAlpha,\n    );\n    this.pitchVelocity = THREE.MathUtils.lerp(\n      this.pitchVelocity,\n      THREE.MathUtils.clamp(instPitchVel, -profile.pitchSpeed * 2.2, profile.pitchSpeed * 2.2),\n      rateAlpha,\n    );\n\n    // 2. Independent Roll via A / D (exact Phase 1/2 roll feel preserved)\n    let rollDir = 0;\n    if (input.rollLeft) rollDir += 1;\n    if (input.rollRight) rollDir -= 1;\n    const targetRollRate = rollDir * profile.rollSpeed;\n    const rollAlpha = 1 - Math.exp(-(profile.angularDamping * 1.25) * safeDt);\n    this.rollVelocity = THREE.MathUtils.lerp(this.rollVelocity, targetRollRate, rollAlpha);\n    const stepRoll = this.rollVelocity * safeDt;\n\n    // 3. Apply Pure Local-Space Quaternion Rotations (Zero Gimbal Lock at any pitch/yaw!)\n    _qYaw.setFromAxisAngle(_AXIS_Y, stepYaw);\n    _qPitch.setFromAxisAngle(_AXIS_X, stepPitch);\n    _qRoll.setFromAxisAngle(_AXIS_Z, stepRoll);\n\n    this.quaternion.multiply(_qYaw);\n    this.quaternion.multiply(_qPitch);\n    this.quaternion.multiply(_qRoll);\n    this.quaternion.normalize();\n\n    // Subtle visual bank when yawing without overriding deliberate A/D roll\n    const targetBank = THREE.MathUtils.clamp(\n      (this.yawVelocity / profile.yawSpeed) * profile.visualBankStrength,\n      -0.44,\n      0.44,\n    );\n    this.visualBankAngle = THREE.MathUtils.damp(this.visualBankAngle, targetBank, 6.5, safeDt);"
          replacement_content: "// Persistent virtual mouse steering limits in normalized screen space [-1..+1].\n// Cursor stays wherever the player places it (including at all 4 screen edges) with ZERO auto-recentering!\nconst CURSOR_EDGE_X = 0.96;\nconst CURSOR_EDGE_Y = 0.94;\nconst CURSOR_DEADZONE = 0.02;\nconst CURSOR_PIXELS_TO_EDGE = 420;\nconst GIMBAL_MAX_YAW_RAD = 0.14;\nconst GIMBAL_MAX_PITCH_RAD = 0.11;\n\nconst _gimbalDirLocal = new THREE.Vector3();\n\n/**\n * Arcade 6DOF space flight controller.\n * Ship coordinate system: Forward = -Z, Right = +X, Up = +Y.\n *\n * Persistent Virtual-Cursor Continuous Steering:\n * - Relative Pointer Lock mouse deltas move a persistent virtual flight cursor (`aimCursorX`, `aimCursorY`)\n *   anywhere across the viewport, all the way to all four screen edges.\n * - The cursor NEVER auto-recenters, decays, or rolls back to the middle while flying.\n * - Holding the mouse at any screen edge maintains smooth, continuous, unlimited 360\302\260+ yaw/pitch turning\n *   until the player moves the mouse back toward the center.\n */\nexport class FlightController {\n  public readonly position = new THREE.Vector3(0, 12, 40);\n  public readonly quaternion = new THREE.Quaternion();\n  public readonly velocity = new THREE.Vector3(0, 0, -24);\n\n  // Smoothed angular rates (rad/s) in ship local space\n  public yawVelocity = 0;\n  public pitchVelocity = 0;\n  public rollVelocity = 0;\n\n  // Persistent virtual mouse cursor position in normalized viewport space [-1..+1] (0,0 = center)\n  public aimCursorX = 0;\n  public aimCursorY = 0;\n\n  // Visual banking angle layered on the ship mesh for tactile feel\n  public visualBankAngle = 0;\n\n  private ship: ShipConfig;\n  private boostEnergy: number;\n  private boostCooldownTimer = 0;\n  private boostLockedOut = false;\n  private boostIntensity = 0;\n  private wasBoosting = false;\n  private hull: number;\n  private boostJustEngaged = false;\n\n  public constructor(ship: ShipConfig) {\n    this.ship = ship;\n    this.boostEnergy = ship.flight.maxBoostEnergy;\n    this.hull = ship.maxHull;\n  }\n\n  public setShipConfig(ship: ShipConfig): void {\n    this.ship = ship;\n    this.boostEnergy = Math.min(this.boostEnergy, ship.flight.maxBoostEnergy);\n    this.hull = ship.maxHull;\n  }\n\n  public centerAimCursor(): void {\n    this.aimCursorX = 0;\n    this.aimCursorY = 0;\n  }\n\n  public reset(startPosition?: THREE.Vector3): void {\n    if (startPosition) {\n      this.position.copy(startPosition);\n    } else {\n      this.position.set(0, 12, 40);\n    }\n    this.quaternion.identity();\n    this.velocity.set(0, 0, -28);\n    this.yawVelocity = 0;\n    this.pitchVelocity = 0;\n    this.rollVelocity = 0;\n    this.aimCursorX = 0;\n    this.aimCursorY = 0;\n    this.visualBankAngle = 0;\n    this.boostEnergy = this.ship.flight.maxBoostEnergy;\n    this.boostCooldownTimer = 0;\n    this.boostLockedOut = false;\n    this.boostIntensity = 0;\n    this.wasBoosting = false;\n    this.hull = this.ship.maxHull;\n  }\n\n  public getBoostJustEngaged(): boolean {\n    return this.boostJustEngaged;\n  }\n\n  /**\n   * Returns unit world-space firing direction with subtle forward gimbal convergence\n   * toward the active mouse cursor (capped within a realistic forward cannon cone).\n   */\n  public getAimDirectionWorld(out: THREE.Vector3): THREE.Vector3 {\n    const gimbalYaw = THREE.MathUtils.clamp(this.aimCursorX, -1, 1) * GIMBAL_MAX_YAW_RAD;\n    const gimbalPitch = THREE.MathUtils.clamp(-this.aimCursorY, -1, 1) * GIMBAL_MAX_PITCH_RAD;\n    _gimbalDirLocal.set(Math.sin(gimbalYaw), Math.sin(gimbalPitch), -1).normalize();\n    out.copy(_gimbalDirLocal).applyQuaternion(this.quaternion).normalize();\n    return out;\n  }\n\n  /**\n   * Computes the 3D world-space convergence point along the player\'s firing ray.\n   */\n  public getAimTargetPoint(out: THREE.Vector3, distance: number): THREE.Vector3 {\n    this.getAimDirectionWorld(out);\n    out.multiplyScalar(distance).add(this.position);\n    return out;\n  }\n\n  /**\n   * Advances arcade flight simulation by delta time `dt` (seconds) and writes live telemetry.\n   */\n  public update(\n    dt: number,\n    input: InputSnapshot,\n    settings: GameSettings,\n    telemetry: FlightTelemetry,\n  ): void {\n    const profile = this.ship.flight;\n    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);\n\n    // 1. Persistent Virtual-Cursor Mouse Steering (Stays at Edge, Zero Auto-Recenter, Zero Rollback)\n    const cursorScale = (1 / CURSOR_PIXELS_TO_EDGE) * settings.mouseSensitivity;\n    const ySign = settings.invertY ? -1 : 1;\n\n    if (input.mouseDeltaX !== 0) {\n      this.aimCursorX = THREE.MathUtils.clamp(\n        this.aimCursorX + input.mouseDeltaX * cursorScale,\n        -CURSOR_EDGE_X,\n        CURSOR_EDGE_X,\n      );\n    }\n    if (input.mouseDeltaY !== 0) {\n      this.aimCursorY = THREE.MathUtils.clamp(\n        this.aimCursorY + input.mouseDeltaY * cursorScale * ySign,\n        -CURSOR_EDGE_Y,\n        CURSOR_EDGE_Y,\n      );\n    }\n\n    // Radial deflection with tiny precision center deadzone and smooth nonlinear curve:\n    // - Small deflections near center yield fine, precise micro-turns.\n    // - Holding the cursor at any screen edge sustains full continuous yaw/pitch rotation indefinitely.\n    const cursorMag = Math.hypot(this.aimCursorX, this.aimCursorY);\n    let steerX = 0;\n    let steerY = 0;\n    if (cursorMag > CURSOR_DEADZONE) {\n      const normalized = Math.min(1, (cursorMag - CURSOR_DEADZONE) / (CURSOR_EDGE_X - CURSOR_DEADZONE));\n      const curved = normalized * (0.35 + 0.65 * normalized);\n      steerX = (this.aimCursorX / cursorMag) * curved;\n      steerY = (this.aimCursorY / cursorMag) * curved;\n    }\n\n    // Optional arrow-key steering blends smoothly alongside mouse steering\n    let keyYaw = 0;\n    if (input.keyYawLeft) keyYaw += 0.85;\n    if (input.keyYawRight) keyYaw -= 0.85;\n    let keyPitch = 0;\n    if (input.keyPitchUp) keyPitch += 0.85;\n    if (input.keyPitchDown) keyPitch -= 0.85;\n\n    const targetYawRate = THREE.MathUtils.clamp(-steerX + keyYaw, -1.15, 1.15) * profile.yawSpeed;\n    const targetPitchRate = THREE.MathUtils.clamp(-steerY + keyPitch, -1.15, 1.15) * profile.pitchSpeed;\n\n    const turnAlpha = 1 - Math.exp(-(profile.angularDamping * 1.45) * safeDt);\n    this.yawVelocity = THREE.MathUtils.lerp(this.yawVelocity, targetYawRate, turnAlpha);\n    this.pitchVelocity = THREE.MathUtils.lerp(this.pitchVelocity, targetPitchRate, turnAlpha);\n\n    const stepYaw = this.yawVelocity * safeDt;\n    const stepPitch = this.pitchVelocity * safeDt;\n\n    // 2. Independent Roll via A / D (exact Phase 1/2 roll feel preserved)\n    let rollDir = 0;\n    if (input.rollLeft) rollDir += 1;\n    if (input.rollRight) rollDir -= 1;\n    const targetRollRate = rollDir * profile.rollSpeed;\n    const rollAlpha = 1 - Math.exp(-(profile.angularDamping * 1.25) * safeDt);\n    this.rollVelocity = THREE.MathUtils.lerp(this.rollVelocity, targetRollRate, rollAlpha);\n    const stepRoll = this.rollVelocity * safeDt;\n\n    // 3. Apply Pure Local-Space Quaternion Rotations (Zero Gimbal Lock at any pitch/yaw!)\n    _qYaw.setFromAxisAngle(_AXIS_Y, stepYaw);\n    _qPitch.setFromAxisAngle(_AXIS_X, stepPitch);\n    _qRoll.setFromAxisAngle(_AXIS_Z, stepRoll);\n\n    this.quaternion.multiply(_qYaw);\n    this.quaternion.multiply(_qPitch);\n    this.quaternion.multiply(_qRoll);\n    this.quaternion.normalize();\n\n    // Subtle visual bank when yawing without overriding deliberate A/D roll\n    const targetBank = THREE.MathUtils.clamp(\n      (this.yawVelocity / profile.yawSpeed) * profile.visualBankStrength,\n      -0.44,\n      0.44,\n    );\n    this.visualBankAngle = THREE.MathUtils.damp(this.visualBankAngle, targetBank, 6.5, safeDt);"
