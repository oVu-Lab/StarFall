      arguments_json: "{\"Description\":\"Remove duplicate onMouseDown listener from FlightCanvas so InputManager is the sole owner of canvas mouse & Pointer Lock input\", \"Instruction\":\"Remove onCanvasClick prop and wrapper div onMouseDown handler from FlightCanvas.tsx\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":38, \"ReplacementContent\":\"  onCanvasReady: (canvas: HTMLCanvasElement) => void;\\n  onPlayerDestroyed: () => void;\\n}\", \"StartLine\":33, \"TargetContent\":\"  onCanvasReady: (canvas: HTMLCanvasElement) => void;\\n  onCanvasClick: () => void;\\n  onPlayerDestroyed: () => void;\\n}\"}, {\"AllowMultiple\":false, \"EndLine\":58, \"ReplacementContent\":\"  onCanvasReady,\\n  onPlayerDestroyed,\\n}: FlightCanvasProps) {\", \"StartLine\":53, \"TargetContent\":\"  onCanvasReady,\\n  onCanvasClick,\\n  onPlayerDestroyed,\\n}: FlightCanvasProps) {\"}, {\"AllowMultiple\":false, \"EndLine\":110, \"ReplacementContent\":\"  return (\\n    <div className=\\\"fixed inset-0 h-full w-full bg-[#030712]\\\">\", \"StartLine\":101, \"TargetContent\":\"  return (\\n    <div\\n      className=\\\"fixed inset-0 h-full w-full bg-[#030712]\\\"\\n      onMouseDown={(e) => {\\n        if (phase === \'playing\' && e.button === 0) {\\n          onCanvasClick();\\n        }\\n      }}\\n    >\"}], \"TargetFile\":\"/src/scene/FlightCanvas.tsx\", \"toolAction\":\"Removing duplicate mouse handler in FlightCanvas.tsx\", \"toolSummary\":\"Deduplicate FlightCanvas.tsx\"}"
      original_name: "multi_replace_file_content"
    }
