            }
            lines {
              text: "    const shapedDy = shapeRelativeMouseDelta(input.mouseDeltaY);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Accumulate raw relative turn radians directly \342\200\224 never clamped to a screen box!"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.pendingYawRad += -shapedDx * radPerPx;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.pendingPitchRad += shapedDy * radPerPx * ySign;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Optional arrow-key steering adds smoothly to the same unbounded angular accumulator"
