    tool_calls {
      id: "call_642785314080583896"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Pass CombatManager and onPlayerDestroyed handler through FlightCanvas into GameScene\", \"EndLine\":120, \"Instruction\":\"Add combat and onPlayerDestroyed props to FlightCanvas and forward them to GameScene\", \"ReplacementContent\":\"import { useCallback, useState } from \'react\';\\nimport { Canvas } from \'@react-three/fiber\';\\nimport * as THREE from \'three\';\\nimport type { GraphicsPreset } from \'../config/graphics\';\\nimport type { CombatManager } from \'../engine/combat/CombatManager\';\\nimport type { FlightController } from \'../engine/FlightController\';\\nimport type { InputManager } from \'../engine/InputManager\';\\nimport type {\\n  FlightTelemetry,\\n  GamePhase,\\n  GameSettings,\\n  MenuSection,\\n  ShipId,\\n} from \'../types/game\';\\nimport { GameScene } from \'./GameScene\';\\n\\ninterface FlightCanvasProps {\\n  phase: GamePhase;\\n  menuSection: MenuSection;\\n  activeShipId: ShipId;\\n  hangarShipId: ShipId;\\n  flight: FlightController;\\n  combat: CombatManager;\\n  input: InputManager;\\n  settingsRef: React.MutableRefObject<GameSettings>;\\n  telemetryRef: React.MutableRefObject<FlightTelemetry>;\\n  graphics: GraphicsPreset;\\n  hangarOrbitRef: React.MutableRefObject<{ yaw: number; pitch: number }>;\\n  snapCameraSignal: number;\\n  onCanvasReady: (canvas: HTMLCanvasElement) => void;\\n  onCanvasClick: () => void;\\n  onPlayerDestroyed: () => void;\\n}\\n\\nexport function FlightCanvas({\\n  phase,\\n  menuSection,\\n  activeShipId,\\n  hangarShipId,\\n  flight,\\n  combat,\\n  input,\\n  settingsRef,\\n  telemetryRef,\\n  graphics,\\n  hangarOrbitRef,\\n  snapCameraSignal,\\n  onCanvasReady,\\n  onCanvasClick,\\n  onPlayerDestroyed,\\n}: FlightCanvasProps) {\\n  const [contextLost, setContextLost] = useState(false);\\n\\n  const handleCreated = useCallback(\\n    ({ gl }: { gl: THREE.WebGLRenderer }) => {\\n      const dom = gl.domElement;\\n      onCanvasReady(dom);\\n\\n      const onLost = (e: Event) => {\\n        e.preventDefault();\\n        setContextLost(true);\\n      };\\n      const onRestored = () => {\\n        setContextLost(false);\\n      };\\n\\n      dom.addEventListener(\'webglcontextlost\', onLost, false);\\n      dom.addEventListener(\'webglcontextrestored\', onRestored, false);\\n    },\\n    [onCanvasReady],\\n  );\\n\\n  if (contextLost) {\\n    return (\\n      <div className=\\\"fixed inset-0 flex items-center justify-center bg-[#030712] text-slate-200\\\">\\n        <div className=\\\"max-w-md border border-cyan-500/30 bg-[#071124] px-8 py-6 text-center\\\">\\n          <h2 className=\\\"font-display text-xl font-semibold tracking-wider text-cyan-300\\\">\\n            Graphics Context Interrupted\\n          </h2>\\n          <p className=\\\"mt-2 text-sm text-slate-400\\\">\\n            WebGL rendering was temporarily suspended by the browser. Reload the page to restore the 3D viewport.\\n          </p>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => window.location.reload()}\\n            className=\\\"mt-5 bg-cyan-500 px-5 py-2 text-sm font-semibold text-slate-950 transition-colors hover:bg-cyan-400\\\"\\n          >\\n            Reload Simulation\\n          </button>\\n        </div>\\n      </div>\\n    );\\n  }\\n\\n  return (\\n    <div\\n      className=\\\"fixed inset-0 h-full w-full bg-[#030712]\\\"\\n      onMouseDown={(e) => {\\n        if (phase === \'playing\' && e.button === 0) {\\n          onCanvasClick();\\n        }\\n      }}\\n    >\\n      <Canvas\\n        shadows={graphics.shadows}\\n        dpr={[1, graphics.dprCap]}\\n        camera={{ fov: 62, near: 0.25, far: graphics.drawDistance, position: [0, 16, 52] }}\\n        gl={{\\n          antialias: graphics.antialias,\\n          powerPreference: \'high-performance\',\\n          toneMapping: THREE.ACESFilmicToneMapping,\\n          toneMappingExposure: 1.12,\\n          outputColorSpace: THREE.SRGBColorSpace,\\n        }}\\n        onCreated={handleCreated}\\n      >\\n        <GameScene\\n          phase={phase}\\n          menuSection={menuSection}\\n          activeShipId={activeShipId}\\n          hangarShipId={hangarShipId}\\n          flight={flight}\\n          combat={combat}\\n          input={input}\\n          settingsRef={settingsRef}\\n          telemetryRef={telemetryRef}\\n          graphics={graphics}\\n          hangarOrbitRef={hangarOrbitRef}\\n          snapCameraSignal={snapCameraSignal}\\n          onPlayerDestroyed={onPlayerDestroyed}\\n        />\\n      </Canvas>\\n    </div>\\n  );\\n}\", \"StartLine\":1, \"TargetContent\":\"import { useCallback, useState } from \'react\';\\nimport { Canvas } from \'@react-three/fiber\';\\nimport * as THREE from \'three\';\\nimport type { GraphicsPreset } from \'../config/graphics\';\\nimport type { FlightController } from \'../engine/FlightController\';\\nimport type { InputManager } from \'../engine/InputManager\';\\nimport type {\\n  FlightTelemetry,\\n  GamePhase,\\n  GameSettings,\\n  MenuSection,\\n  ShipId,\\n} from \'../types/game\';\\nimport { GameScene } from \'./GameScene\';\\n\\ninterface FlightCanvasProps {\\n  phase: GamePhase;\\n  menuSection: MenuSection;\\n  activeShipId: ShipId;\\n  hangarShipId: ShipId;\\n  flight: FlightController;\\n  input: InputManager;\\n  settingsRef: React.MutableRefObject<GameSettings>;\\n  telemetryRef: React.MutableRefObject<FlightTelemetry>;\\n  graphics: GraphicsPreset;\\n  hangarOrbitRef: React.MutableRefObject<{ yaw: number; pitch: number }>;\\n  snapCameraSignal: number;\\n  onCanvasReady: (canvas: HTMLCanvasElement) => void;\\n  onCanvasClick: () => void;\\n}\\n\\nexport function FlightCanvas({\\n  phase,\\n  menuSection,\\n  activeShipId,\\n  hangarShipId,\\n  flight,\\n  input,\\n  settingsRef,\\n  telemetryRef,\\n  graphics,\\n  hangarOrbitRef,\\n  snapCameraSignal,\\n  onCanvasReady,\\n  onCanvasClick,\\n}: FlightCanvasProps) {\\n  const [contextLost, setContextLost] = useState(false);\\n\\n  const handleCreated = useCallback(\\n    ({ gl }: { gl: THREE.WebGLRenderer }) => {\\n      const dom = gl.domElement;\\n      onCanvasReady(dom);\\n\\n      const onLost = (e: Event) => {\\n        e.preventDefault();\\n        setContextLost(true);\\n      };\\n      const onRestored = () => {\\n        setContextLost(false);\\n      };\\n\\n      dom.addEventListener(\'webglcontextlost\', onLost, false);\\n      dom.addEventListener(\'webglcontextrestored\', onRestored, false);\\n    },\\n    [onCanvasReady],\\n  );\\n\\n  if (contextLost) {\\n    return (\\n      <div className=\\\"fixed inset-0 flex items-center justify-center bg-[#030712] text-slate-200\\\">\\n        <div className=\\\"max-w-md border border-cyan-500/30 bg-[#071124] px-8 py-6 text-center\\\">\\n          <h2 className=\\\"font-display text-xl font-semibold tracking-wider text-cyan-300\\\">\\n            Graphics Context Interrupted\\n          </h2>\\n          <p className=\\\"mt-2 text-sm text-slate-400\\\">\\n            WebGL rendering was temporarily suspended by the browser. Reload the page to restore the 3D viewport.\\n          </p>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => window.location.reload()}\\n            className=\\\"mt-5 bg-cyan-500 px-5 py-2 text-sm font-semibold text-slate-950 transition-colors hover:bg-cyan-400\\\"\\n          >\\n            Reload Simulation\\n          </button>\\n        </div>\\n      </div>\\n    );\\n  }\\n\\n  return (\\n    <div\\n      className=\\\"fixed inset-0 h-full w-full bg-[#030712]\\\"\\n      onMouseDown={() => {\\n        if (phase === \'playing\') {\\n          onCanvasClick();\\n        }\\n      }}\\n    >\\n      <Canvas\\n        shadows={graphics.shadows}\\n        dpr={[1, graphics.dprCap]}\\n        camera={{ fov: 62, near: 0.25, far: graphics.drawDistance, position: [0, 16, 52] }}\\n        gl={{\\n          antialias: graphics.antialias,\\n          powerPreference: \'high-performance\',\\n          toneMapping: THREE.ACESFilmicToneMapping,\\n          toneMappingExposure: 1.12,\\n          outputColorSpace: THREE.SRGBColorSpace,\\n        }}\\n        onCreated={handleCreated}\\n      >\\n        <GameScene\\n          phase={phase}\\n          menuSection={menuSection}\\n          activeShipId={activeShipId}\\n          hangarShipId={hangarShipId}\\n          flight={flight}\\n          input={input}\\n          settingsRef={settingsRef}\\n          telemetryRef={telemetryRef}\\n          graphics={graphics}\\n          hangarOrbitRef={hangarOrbitRef}\\n          snapCameraSignal={snapCameraSignal}\\n        />\\n      </Canvas>\\n    </div>\\n  );\\n}\", \"TargetFile\":\"/src/scene/FlightCanvas.tsx\", \"toolAction\":\"Updating FlightCanvas props\", \"toolSummary\":\"Update src/scene/FlightCanvas.tsx\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_642785314080586687"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useEffect, useRef } from \'react\';\\nimport { ChevronDown, ChevronUp, Pause, RotateCcw } from \'lucide-react\';\\nimport { SHIP_CONFIGS } from \'../config/ships\';\\nimport { MAX_ENEMIES } from \'../engine/combat/CombatManager\';\\nimport type { FlightTelemetry, GameSettings, ShipId } from \'../types/game\';\\n\\ninterface FlightHUDProps {\\n  shipId: ShipId;\\n  telemetryRef: React.MutableRefObject<FlightTelemetry>;\\n  settings: GameSettings;\\n  pointerLocked: boolean;\\n  playerDestroyed: boolean;\\n  hintsVisible: boolean;\\n  onToggleHints: () => void;\\n  onRequestLock: () => void;\\n  onPause: () => void;\\n  onRelaunch: () => void;\\n  onReturnToMenu: () => void;\\n}\\n\\nconst MARKER_INDICES = Array.from({ length: MAX_ENEMIES }, (_, i) => i);\\n\\n/**\\n * Minimal, razor-sharp futuristic flight & combat HUD.\\n * Reads live FlightTelemetry directly via a requestAnimationFrame DOM-ref loop\\n * so 60 FPS telemetry, aiming reticle, and 3D enemy target brackets trigger ZERO React re-renders.\\n */\\nexport function FlightHUD({\\n  shipId,\\n  telemetryRef,\\n  settings,\\n  pointerLocked,\\n  playerDestroyed,\\n  hintsVisible,\\n  onToggleHints,\\n  onRequestLock,\\n  onPause,\\n  onRelaunch,\\n  onReturnToMenu,\\n}: FlightHUDProps) {\\n  const ship = SHIP_CONFIGS[shipId];\\n\\n  // Core flight refs\\n  const speedNumRef = useRef<HTMLSpanElement>(null);\\n  const speedBarRef = useRef<HTMLDivElement>(null);\\n  const statusTextRef = useRef<HTMLSpanElement>(null);\\n  const headingRef = useRef<HTMLSpanElement>(null);\\n  const pitchRef = useRef<HTMLSpanElement>(null);\\n  const rollRef = useRef<HTMLSpanElement>(null);\\n  const hullNumRef = useRef<HTMLSpanElement>(null);\\n  const hullBarRef = useRef<HTMLDivElement>(null);\\n  const boostNumRef = useRef<HTMLSpanElement>(null);\\n  const boostBarRef = useRef<HTMLDivElement>(null);\\n  const boostLabelRef = useRef<HTMLSpanElement>(null);\\n  const perfTextRef = useRef<HTMLDivElement>(null);\\n\\n  // Combat & expanded aiming refs\\n  const aimReticleRef = useRef<HTMLDivElement>(null);\\n  const aimRingRef = useRef<HTMLDivElement>(null);\\n  const boresightRef = useRef<HTMLDivElement>(null);\\n  const aimTetherLineRef = useRef<SVGLineElement>(null);\\n  const hitMarkerRef = useRef<HTMLDivElement>(null);\\n  const killMarkerRef = useRef<HTMLDivElement>(null);\\n  const damageVignetteRef = useRef<HTMLDivElement>(null);\\n  const weaponStatusRef = useRef<HTMLSpanElement>(null);\\n  const combatWaveRef = useRef<HTMLSpanElement>(null);\\n  const combatHostilesRef = useRef<HTMLSpanElement>(null);\\n  const combatKillsRef = useRef<HTMLSpanElement>(null);\\n  const combatAccRef = useRef<HTMLSpanElement>(null);\\n  const combatScoreRef = useRef<HTMLSpanElement>(null);\\n\\n  // Primary target summary card refs\\n  const targetCardRef = useRef<HTMLDivElement>(null);\\n  const targetNameRef = useRef<HTMLSpanElement>(null);\\n  const targetRoleRef = useRef<HTMLSpanElement>(null);\\n  const targetDistRef = useRef<HTMLSpanElement>(null);\\n  const targetHealthBarRef = useRef<HTMLDivElement>(null);\\n  const leadPipRef = useRef<HTMLDivElement>(null);\\n\\n  // Pooled 3D enemy bracket refs\\n  const enemyMarkerRefs = useRef<Array<HTMLDivElement | null>>([]);\\n  const enemyMarkerLabelRefs = useRef<Array<HTMLSpanElement | null>>([]);\\n  const enemyMarkerDistRefs = useRef<Array<HTMLSpanElement | null>>([]);\\n  const enemyMarkerBarRefs = useRef<Array<HTMLDivElement | null>>([]);\\n  const enemyMarkerBoxRefs = useRef<Array<HTMLDivElement | null>>([]);\\n\\n  useEffect(() => {\\n    let rafId = 0;\\n\\n    const syncHud = () => {\\n      const t = telemetryRef.current;\\n      const vw = window.innerWidth;\\n      const vh = window.innerHeight;\\n\\n      // 1. Speed, Attitude & Boost\\n      if (speedNumRef.current) {\\n        const displaySpeed = Math.round(t.signedSpeed);\\n        speedNumRef.current.textContent = String(displaySpeed);\\n        speedNumRef.current.style.color = t.isBoosting\\n          ? \'#67e8f9\'\\n          : t.signedSpeed < -2\\n            ? \'#fbbf24\'\\n            : \'#f8fafc\';\\n      }\\n\\n      if (speedBarRef.current) {\\n        const maxBoosted = t.maxSpeed * ship.flight.boostMultiplier;\\n        const pct = Math.min(100, (t.speed / Math.max(maxBoosted, 1)) * 100);\\n        speedBarRef.current.style.transform = `scaleX(${pct / 100})`;\\n        speedBarRef.current.style.backgroundColor = t.isBoosting ? \'#67e8f9\' : \'#06b6d4\';\\n      }\\n\\n      if (statusTextRef.current) {\\n        statusTextRef.current.textContent = t.status;\\n        statusTextRef.current.style.color =\\n          t.status === \'BOOSTING\'\\n            ? \'#67e8f9\'\\n            : t.status === \'BOOST DEPLETED\'\\n              ? \'#f59e0b\'\\n              : t.status === \'REVERSING\'\\n                ? \'#fbbf24\'\\n                : \'#94a3b8\';\\n      }\\n\\n      if (headingRef.current) {\\n        headingRef.current.textContent = `${String(Math.round(t.headingDeg)).padStart(3, \'0\')}\302\260`;\\n      }\\n      if (pitchRef.current) {\\n        const p = Math.round(t.pitchDeg);\\n        pitchRef.current.textContent = `${p >= 0 ? \'+\' : \'\'}${p}\302\260`;\\n      }\\n      if (rollRef.current) {\\n        const r = Math.round(t.rollDeg);\\n        rollRef.current.textContent = `${r >= 0 ? \'+\' : \'\'}${r}\302\260`;\\n      }\\n\\n      // 2. Player Hull Integrity & Weapon State\\n      const hullRatio = Math.max(0, Math.min(1, t.hull / Math.max(t.maxHull, 1)));\\n      if (hullNumRef.current) {\\n        const hullPct = Math.round(hullRatio * 100);\\n        hullNumRef.current.textContent = `${hullPct}%`;\\n        hullNumRef.current.style.color =\\n          hullRatio <= 0.3 ? \'#f87171\' : hullRatio <= 0.55 ? \'#fbbf24\' : \'#f1f5f9\';\\n      }\\n      if (hullBarRef.current) {\\n        hullBarRef.current.style.transform = `scaleX(${hullRatio})`;\\n        hullBarRef.current.style.backgroundColor =\\n          hullRatio <= 0.3 ? \'#ef4444\' : hullRatio <= 0.55 ? \'#f59e0b\' : \'#38bdf8\';\\n      }\\n\\n      if (weaponStatusRef.current) {\\n        weaponStatusRef.current.textContent = t.isFiring ? \'FIRING\' : \'READY\';\\n        weaponStatusRef.current.style.color = t.isFiring ? \'#67e8f9\' : \'#94a3b8\';\\n      }\\n\\n      // 3. Boost Energy\\n      if (boostNumRef.current) {\\n        boostNumRef.current.textContent = `${Math.round(t.boostEnergy)}%`;\\n      }\\n      if (boostBarRef.current) {\\n        const bRatio = Math.max(0, Math.min(1, t.boostEnergy / Math.max(t.maxBoostEnergy, 1)));\\n        boostBarRef.current.style.transform = `scaleX(${bRatio})`;\\n        boostBarRef.current.style.backgroundColor = t.boostDepleted\\n          ? \'#f59e0b\'\\n          : t.isBoosting\\n            ? \'#a5f3fc\'\\n            : \'#22d3ee\';\\n      }\\n      if (boostLabelRef.current) {\\n        boostLabelRef.current.textContent = t.boostDepleted\\n          ? \'Recharging\'\\n          : t.isBoosting\\n            ? \'Afterburner Active\'\\n            : \'Boost Energy\';\\n      }\\n\\n      // 4. True 3D-Projected Expanded Aiming Reticle & Boresight Reference\\n      const aimPxX = t.aimScreenX * vw;\\n      const aimPxY = t.aimScreenY * vh;\\n      const borePxX = t.boresightScreenX * vw;\\n      const borePxY = t.boresightScreenY * vh;\\n\\n      if (aimReticleRef.current) {\\n        const recoilScale = t.isFiring ? 1 + t.weaponCooldownRatio * 0.14 : 1;\\n        aimReticleRef.current.style.transform = `translate3d(${aimPxX.toFixed(1)}px, ${aimPxY.toFixed(1)}px, 0) translate(-50%, -50%) scale(${recoilScale.toFixed(3)})`;\\n      }\\n\\n      if (aimRingRef.current) {\\n        const ringScale = 1 + t.boostIntensity * 0.28 + (t.isFiring ? 0.08 : 0);\\n        aimRingRef.current.style.transform = `scale(${ringScale.toFixed(3)})`;\\n        aimRingRef.current.style.opacity = String(\\n          (0.24 + t.boostIntensity * 0.5 + (t.isFiring ? 0.22 : 0)).toFixed(2),\\n        );\\n      }\\n\\n      if (boresightRef.current) {\\n        boresightRef.current.style.transform = `translate3d(${borePxX.toFixed(1)}px, ${borePxY.toFixed(1)}px, 0) translate(-50%, -50%)`;\\n      }\\n\\n      if (aimTetherLineRef.current) {\\n        const sepPx = Math.hypot(aimPxX - borePxX, aimPxY - borePxY);\\n        if (sepPx > 14) {\\n          aimTetherLineRef.current.setAttribute(\'x1\', borePxX.toFixed(1));\\n          aimTetherLineRef.current.setAttribute(\'y1\', borePxY.toFixed(1));\\n          aimTetherLineRef.current.setAttribute(\'x2\', aimPxX.toFixed(1));\\n          aimTetherLineRef.current.setAttribute(\'y2\', aimPxY.toFixed(1));\\n          aimTetherLineRef.current.style.opacity = String(Math.min(0.42, (sepPx - 14) / 140).toFixed(2));\\n        } else {\\n          aimTetherLineRef.current.style.opacity = \'0\';\\n        }\\n      }\\n\\n      // 5. Hit Confirmation & Kill Confirmation Crosshairs + Damage Vignette\\n      if (hitMarkerRef.current) {\\n        const hitOp = Math.min(1, t.hitMarkerTimer / 0.14);\\n        hitMarkerRef.current.style.opacity = hitOp.toFixed(2);\\n      }\\n      if (killMarkerRef.current) {\\n        const killOp = Math.min(1, t.killMarkerTimer / 0.28);\\n        killMarkerRef.current.style.opacity = killOp.toFixed(2);\\n      }\\n      if (damageVignetteRef.current) {\\n        const dmgOp = Math.min(0.72, (t.damageFlashTimer / 0.32) * 0.72);\\n        damageVignetteRef.current.style.opacity = dmgOp.toFixed(2);\\n      }\\n\\n      // 6. Combat Statistics Readout\\n      const stats = t.combatStats;\\n      if (combatWaveRef.current) combatWaveRef.current.textContent = String(stats.wave);\\n      if (combatHostilesRef.current) combatHostilesRef.current.textContent = String(stats.activeEnemies);\\n      if (combatKillsRef.current) combatKillsRef.current.textContent = String(stats.kills);\\n      if (combatScoreRef.current) combatScoreRef.current.textContent = String(stats.score);\\n      if (combatAccRef.current) {\\n        const acc =\\n          stats.shotsFired > 0 ? Math.round((stats.shotsHit / stats.shotsFired) * 100) : 0;\\n        combatAccRef.current.textContent = `${acc}%`;\\n      }\\n\\n      // 7. Projected 3D Enemy Brackets, Off-Screen Edge Indicators & Primary Lead Pip\\n      let primaryMarker = null;\\n      const markers = t.enemyMarkers;\\n\\n      for (let i = 0; i < MARKER_INDICES.length; i++) {\\n        const el = enemyMarkerRefs.current[i];\\n        const m = markers[i];\\n        if (!el) continue;\\n\\n        if (!m || !m.active) {\\n          el.style.opacity = \'0\';\\n          el.style.visibility = \'hidden\';\\n          continue;\\n        }\\n\\n        if (m.isPrimaryTarget) {\\n          primaryMarker = m;\\n        }\\n\\n        const mx = m.screenX * vw;\\n        const my = m.screenY * vh;\\n        el.style.visibility = \'visible\';\\n        el.style.opacity = m.onScreen ? \'1\' : \'0.78\';\\n        el.style.transform = `translate3d(${mx.toFixed(1)}px, ${my.toFixed(1)}px, 0) translate(-50%, -50%)`;\\n\\n        const box = enemyMarkerBoxRefs.current[i];\\n        if (box) {\\n          if (m.onScreen) {\\n            box.style.borderColor = m.isPrimaryTarget\\n              ? \'rgba(249, 115, 22, 0.95)\'\\n              : \'rgba(251, 146, 60, 0.65)\';\\n            box.style.width = m.isPrimaryTarget ? \'38px\' : \'28px\';\\n            box.style.height = m.isPrimaryTarget ? \'38px\' : \'28px\';\\n            box.style.transform = m.isPrimaryTarget ? \'rotate(45deg)\' : \'rotate(0deg)\';\\n          } else {\\n            box.style.borderColor = \'rgba(248, 113, 113, 0.85)\';\\n            box.style.width = \'14px\';\\n            box.style.height = \'14px\';\\n            box.style.transform = \'rotate(45deg)\';\\n          }\\n        }\\n\\n        const lbl = enemyMarkerLabelRefs.current[i];\\n        if (lbl) {\\n          lbl.textContent = m.onScreen ? m.callsign : \'\';\\n        }\\n        const dst = enemyMarkerDistRefs.current[i];\\n        if (dst) {\\n          dst.textContent = `${Math.round(m.distance)}m`;\\n        }\\n        const bar = enemyMarkerBarRefs.current[i];\\n        if (bar) {\\n          bar.style.transform = `scaleX(${Math.max(0, Math.min(1, m.healthRatio)).toFixed(3)})`;\\n        }\\n      }\\n\\n      // Primary Target Info Panel + Predictive Lead Pip\\n      if (targetCardRef.current) {\\n        if (primaryMarker) {\\n          targetCardRef.current.style.opacity = \'1\';\\n          if (targetNameRef.current) targetNameRef.current.textContent = primaryMarker.callsign;\\n          if (targetRoleRef.current) {\\n            targetRoleRef.current.textContent = `${primaryMarker.personalityLabel} \302\267 ${primaryMarker.aiState.toUpperCase()}`;\\n          }\\n          if (targetDistRef.current) {\\n            targetDistRef.current.textContent = `${Math.round(primaryMarker.distance)} m`;\\n          }\\n          if (targetHealthBarRef.current) {\\n            targetHealthBarRef.current.style.transform = `scaleX(${primaryMarker.healthRatio.toFixed(3)})`;\\n          }\\n        } else {\\n          targetCardRef.current.style.opacity = \'0\';\\n        }\\n      }\\n\\n      if (leadPipRef.current) {\\n        if (primaryMarker && primaryMarker.leadVisible && primaryMarker.onScreen) {\\n          const lx = primaryMarker.leadX * vw;\\n          const ly = primaryMarker.leadY * vh;\\n          leadPipRef.current.style.visibility = \'visible\';\\n          leadPipRef.current.style.transform = `translate3d(${lx.toFixed(1)}px, ${ly.toFixed(1)}px, 0) translate(-50%, -50%)`;\\n        } else {\\n          leadPipRef.current.style.visibility = \'hidden\';\\n        }\\n      }\\n\\n      // 8. Optional Performance Stats\\n      if (perfTextRef.current) {\\n        perfTextRef.current.textContent = `${t.fps} FPS \302\267 ${t.frameTimeMs.toFixed(1)} ms \302\267 ${t.drawCalls} draws \302\267 ${(t.triangles / 1000).toFixed(1)}k tris`;\\n      }\\n\\n      rafId = window.requestAnimationFrame(syncHud);\\n    };\\n\\n    rafId = window.requestAnimationFrame(syncHud);\\n    return () => window.cancelAnimationFrame(rafId);\\n  }, [ship.flight.boostMultiplier, telemetryRef]);\\n\\n  return (\\n    <div className=\\\"pointer-events-none fixed inset-0 z-20 flex flex-col justify-between p-5 sm:p-6\\\">\\n      {/* Peripheral Damage Vignette Flash */}\\n      <div\\n        ref={damageVignetteRef}\\n        className=\\\"pointer-events-none fixed inset-0 z-10 opacity-0\\\"\\n        style={{\\n          boxShadow: \'inset 0 0 110px 24px rgba(239, 68, 68, 0.72)\',\\n          willChange: \'opacity\',\\n        }}\\n        aria-hidden=\\\"true\\\"\\n      />\\n\\n      {/* Full-Viewport Vector Tether (connects Ship Boresight to Expanded Aiming Reticle) */}\\n      <svg className=\\\"pointer-events-none fixed inset-0 h-full w-full\\\" aria-hidden=\\\"true\\\">\\n        <line\\n          ref={aimTetherLineRef}\\n          x1=\\\"0\\\"\\n          y1=\\\"0\\\"\\n          x2=\\\"0\\\"\\n          y2=\\\"0\\\"\\n          stroke=\\\"#38bdf8\\\"\\n          strokeWidth=\\\"1\\\"\\n          strokeDasharray=\\\"4 4\\\"\\n          opacity=\\\"0\\\"\\n        />\\n      </svg>\\n\\n      {/* Pooled 3D Enemy Target Brackets & Health Bars */}\\n      {MARKER_INDICES.map((idx) => (\\n        <div\\n          key={idx}\\n          ref={(el) => {\\n            enemyMarkerRefs.current[idx] = el;\\n          }}\\n          className=\\\"pointer-events-none fixed left-0 top-0 flex flex-col items-center\\\"\\n          style={{ visibility: \'hidden\', willChange: \'transform, opacity\' }}\\n        >\\n          <span\\n            ref={(el) => {\\n              enemyMarkerLabelRefs.current[idx] = el;\\n            }}\\n            className=\\\"mb-1 font-mono text-[10px] font-semibold tracking-wider text-orange-300\\\"\\n          />\\n          <div\\n            ref={(el) => {\\n              enemyMarkerBoxRefs.current[idx] = el;\\n            }}\\n            className=\\\"border border-orange-400/80 transition-[width,height] duration-100\\\"\\n            style={{ width: 28, height: 28 }}\\n          />\\n          <div className=\\\"mt-1.5 h-1 w-9 overflow-hidden bg-slate-900/90\\\">\\n            <div\\n              ref={(el) => {\\n                enemyMarkerBarRefs.current[idx] = el;\\n              }}\\n              className=\\\"h-full w-full origin-left bg-orange-400\\\"\\n              style={{ transform: \'scaleX(1)\', willChange: \'transform\' }}\\n            />\\n          </div>\\n          <span\\n            ref={(el) => {\\n              enemyMarkerDistRefs.current[idx] = el;\\n            }}\\n            className=\\\"mt-0.5 font-mono text-[10px] tabular-nums text-slate-300\\\"\\n          />\\n        </div>\\n      ))}\\n\\n      {/* Predictive Weapon Lead Pip for Primary Locked Target */}\\n      <div\\n        ref={leadPipRef}\\n        className=\\\"pointer-events-none fixed left-0 top-0\\\"\\n        style={{ visibility: \'hidden\', willChange: \'transform\' }}\\n        aria-hidden=\\\"true\\\"\\n      >\\n        <div className=\\\"h-4 w-4 rounded-full border border-dashed border-cyan-300/90\\\" />\\n      </div>\\n\\n      {/* Fixed Ship Nose Boresight Reference Chevron */}\\n      <div\\n        ref={boresightRef}\\n        className=\\\"pointer-events-none fixed left-0 top-0\\\"\\n        style={{ willChange: \'transform\' }}\\n        aria-hidden=\\\"true\\\"\\n      >\\n        <svg width=\\\"20\\\" height=\\\"14\\\" viewBox=\\\"0 0 20 14\\\" className=\\\"text-slate-400/65\\\">\\n          <path d=\\\"M 3 11 L 10 4 L 17 11\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.3\\\" />\\n        </svg>\\n      </div>\\n\\n      {/* True 3D-Matched Weapon Aiming Reticle (moves freely across the expanded aiming envelope) */}\\n      <div\\n        ref={aimReticleRef}\\n        className=\\\"pointer-events-none fixed left-0 top-0 flex items-center justify-center\\\"\\n        style={{ willChange: \'transform\' }}\\n      >\\n        <div\\n          ref={aimRingRef}\\n          className=\\\"absolute h-16 w-16 rounded-full border border-cyan-300/60 opacity-25\\\"\\n          style={{ willChange: \'transform, opacity\' }}\\n        />\\n\\n        <svg width=\\\"46\\\" height=\\\"46\\\" viewBox=\\\"0 0 46 46\\\" className=\\\"text-cyan-300/90\\\">\\n          <line x1=\\\"23\\\" y1=\\\"3\\\" x2=\\\"23\\\" y2=\\\"12\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.5\\\" />\\n          <line x1=\\\"23\\\" y1=\\\"34\\\" x2=\\\"23\\\" y2=\\\"43\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.5\\\" />\\n          <line x1=\\\"3\\\" y1=\\\"23\\\" x2=\\\"12\\\" y2=\\\"23\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.5\\\" />\\n          <line x1=\\\"34\\\" y1=\\\"23\\\" x2=\\\"43\\\" y2=\\\"23\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.5\\\" />\\n          <circle cx=\\\"23\\\" cy=\\\"23\\\" r=\\\"2.2\\\" fill=\\\"#e0f2fe\\\" />\\n        </svg>\\n\\n        {/* Crisp Hit Confirmation X */}\\n        <div\\n          ref={hitMarkerRef}\\n          className=\\\"absolute opacity-0\\\"\\n          style={{ willChange: \'opacity\' }}\\n        >\\n          <svg width=\\\"34\\\" height=\\\"34\\\" viewBox=\\\"0 0 34 34\\\" className=\\\"text-cyan-200\\\">\\n            <line x1=\\\"7\\\" y1=\\\"7\\\" x2=\\\"13\\\" y2=\\\"13\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.2\\\" />\\n            <line x1=\\\"27\\\" y1=\\\"7\\\" x2=\\\"21\\\" y2=\\\"13\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.2\\\" />\\n            <line x1=\\\"7\\\" y1=\\\"27\\\" x2=\\\"13\\\" y2=\\\"21\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.2\\\" />\\n            <line x1=\\\"27\\\" y1=\\\"27\\\" x2=\\\"21\\\" y2=\\\"21\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.2\\\" />\\n          </svg>\\n        </div>\\n\\n        {/* Kill Confirmation Burst Ring */}\\n        <div\\n          ref={killMarkerRef}\\n          className=\\\"absolute opacity-0\\\"\\n          style={{ willChange: \'opacity\' }}\\n        >\\n          <svg width=\\\"52\\\" height=\\\"52\\\" viewBox=\\\"0 0 52 52\\\" className=\\\"text-orange-400\\\">\\n            <line x1=\\\"10\\\" y1=\\\"10\\\" x2=\\\"19\\\" y2=\\\"19\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.5\\\" />\\n            <line x1=\\\"42\\\" y1=\\\"10\\\" x2=\\\"33\\\" y2=\\\"19\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.5\\\" />\\n            <line x1=\\\"10\\\" y1=\\\"42\\\" x2=\\\"19\\\" y2=\\\"33\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.5\\\" />\\n            <line x1=\\\"42\\\" y1=\\\"42\\\" x2=\\\"33\\\" y2=\\\"33\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.5\\\" />\\n          </svg>\\n        </div>\\n      </div>\\n\\n      {/* Top Row: Attitude Telemetry + Combat Stats + Active Target Card + Pause */}\\n      <div className=\\\"flex items-start justify-between gap-4\\\">\\n        <div className=\\\"flex flex-col gap-2\\\">\\n          <div className=\\\"border border-cyan-400/20 bg-[#040a18]/82 px-4 py-2\\\">\\n            <div className=\\\"flex items-center gap-3.5 font-mono text-xs tabular-nums text-slate-300\\\">\\n              <span>\\n                HDG <strong ref={headingRef} className=\\\"font-semibold text-cyan-300\\\">000\302\260</strong>\\n              </span>\\n              <span className=\\\"text-slate-600\\\" aria-hidden=\\\"true\\\">\302\267</span>\\n              <span>\\n                PITCH <strong ref={pitchRef} className=\\\"font-semibold text-slate-100\\\">+0\302\260</strong>\\n              </span>\\n              <span className=\\\"text-slate-600\\\" aria-hidden=\\\"true\\\">\302\267</span>\\n              <span>\\n                ROLL <strong ref={rollRef} className=\\\"font-semibold text-slate-100\\\">+0\302\260</strong>\\n              </span>\\n            </div>\\n            <div className=\\\"mt-1.5 flex flex-wrap items-center gap-3 border-t border-slate-800/80 pt-1.5 font-mono text-[11px] tabular-nums text-slate-400\\\">\\n              <span>\\n                Wave <strong ref={combatWaveRef} className=\\\"text-slate-200\\\">1</strong>\\n              </span>\\n              <span aria-hidden=\\\"true\\\">\302\267</span>\\n              <span>\\n                Hostiles <strong ref={combatHostilesRef} className=\\\"text-orange-300\\\">0</strong>\\n              </span>\\n              <span aria-hidden=\\\"true\\\">\302\267</span>\\n              <span>\\n                Kills <strong ref={combatKillsRef} className=\\\"text-cyan-300\\\">0</strong>\\n              </span>\\n              <span aria-hidden=\\\"true\\\">\302\267</span>\\n              <span>\\n                Acc <strong ref={combatAccRef} className=\\\"text-slate-200\\\">0%</strong>\\n              </span>\\n              <span aria-hidden=\\\"true\\\">\302\267</span>\\n              <span>\\n                Score <strong ref={combatScoreRef} className=\\\"text-slate-100\\\">0</strong>\\n              </span>\\n            </div>\\n            {settings.showPerfOverlay && (\\n              <div\\n                ref={perfTextRef}\\n                className=\\\"mt-1 border-t border-slate-800/80 pt-1 font-mono text-[11px] tabular-nums text-slate-400\\\"\\n              >\\n                60 FPS \302\267 16.6 ms\\n              </div>\\n            )}\\n          </div>\\n        </div>\\n\\n        {/* Top-Center Active Target Readout (appears smoothly when an enemy is acquired) */}\\n        <div\\n          ref={targetCardRef}\\n          className=\\\"hidden border border-orange-400/35 bg-[#040a18]/85 px-4 py-2 transition-opacity duration-150 md:block\\\"\\n          style={{ opacity: 0, minWidth: 210 }}\\n        >\\n          <div className=\\\"flex items-baseline justify-between gap-4\\\">\\n            <span ref={targetNameRef} className=\\\"font-display text-sm font-semibold text-orange-300\\\">\\n              VEX-01\\n            </span>\\n            <span ref={targetDistRef} className=\\\"font-mono text-xs tabular-nums text-slate-300\\\">\\n              0 m\\n            </span>\\n          </div>\\n          <div className=\\\"mt-1 h-1.5 w-full overflow-hidden bg-slate-800\\\">\\n            <div\\n              ref={targetHealthBarRef}\\n              className=\\\"h-full w-full origin-left bg-orange-400\\\"\\n              style={{ transform: \'scaleX(1)\', willChange: \'transform\' }}\\n            />\\n          </div>\\n          <div ref={targetRoleRef} className=\\\"mt-1 font-mono text-[10px] text-slate-400\\\">\\n            AGGRESSOR \302\267 ENGAGE\\n          </div>\\n        </div>\\n\\n        <button\\n          type=\\\"button\\\"\\n          onClick={onPause}\\n          className=\\\"pointer-events-auto flex items-center gap-2 border border-slate-700/80 bg-[#040a18]/82 px-3.5 py-2 text-xs font-medium text-slate-200 transition-colors hover:border-cyan-400/60 hover:text-cyan-200 focus-visible:outline-2 focus-visible:outline-cyan-400 whitespace-nowrap shrink-0\\\"\\n          aria-label=\\\"Pause Flight\\\"\\n        >\\n          <Pause className=\\\"h-3.5 w-3.5 text-cyan-400\\\" />\\n          <span>Pause</span>\\n          <span className=\\\"font-mono text-[11px] text-slate-400\\\">ESC</span>\\n        </button>\\n      </div>\\n\\n      {/* Click-to-Lock Mouse Flight Notice (only shown when unlocked & alive) */}\\n      {!pointerLocked && !playerDestroyed && (\\n        <div className=\\\"pointer-events-auto fixed left-1/2 top-[64%] -translate-x-1/2\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onRequestLock}\\n            className=\\\"border border-cyan-400/50 bg-[#040a18]/90 px-5 py-2.5 text-xs font-medium tracking-wide text-cyan-200 transition-colors hover:border-cyan-300 hover:bg-[#081631] focus-visible:outline-2 focus-visible:outline-cyan-400\\\"\\n          >\\n            Click viewport to engage Mouse Steering & Firing (Pointer Lock)\\n          </button>\\n        </div>\\n      )}\\n\\n      {/* Player Hull Destroyed Overlay */}\\n      {playerDestroyed && (\\n        <div className=\\\"pointer-events-auto fixed inset-0 z-30 flex items-center justify-center bg-[#030712]/78 p-6\\\">\\n          <div className=\\\"w-full max-w-sm border border-red-500/40 bg-[#050c1d]/95 p-7 text-center\\\">\\n            <h2 className=\\\"font-display text-2xl font-bold tracking-wider text-red-400\\\">\\n              Hull Destroyed\\n            </h2>\\n            <p className=\\\"mt-2 text-xs text-slate-300\\\">\\n              Your starfighter sustained critical damage. Relaunch to re-enter the Aurelia combat zone.\\n            </p>\\n            <div className=\\\"mt-5 flex flex-col gap-2.5\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onRelaunch}\\n                className=\\\"flex items-center justify-center gap-2 bg-cyan-500 px-5 py-3 text-sm font-semibold text-slate-950 transition-colors hover:bg-cyan-400\\\"\\n              >\\n                <RotateCcw className=\\\"h-4 w-4\\\" />\\n                <span>Relaunch Fighter</span>\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onReturnToMenu}\\n                className=\\\"border border-slate-700 bg-[#081226] px-5 py-2.5 text-sm font-medium text-slate-300 transition-colors hover:border-cyan-400/60 hover:text-cyan-200\\\"\\n              >\\n                Main Menu\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Bottom Tactical Instrument Strip + Collapsible Control Hints */}\\n      <div className=\\\"flex flex-col items-center gap-2.5\\\">\\n        <div className=\\\"grid w-full max-w-4xl grid-cols-1 gap-3 sm:grid-cols-3\\\">\\n          {/* Left: Hull Integrity & Primary Weapon Status */}\\n          <div className=\\\"border border-slate-700/70 bg-[#040a18]/84 px-4 py-3\\\">\\n            <div className=\\\"flex items-baseline justify-between\\\">\\n              <span className=\\\"text-xs font-medium text-slate-400\\\">Hull Integrity</span>\\n              <span\\n                ref={hullNumRef}\\n                className=\\\"font-mono text-sm font-semibold tabular-nums text-slate-100\\\"\\n              >\\n                100%\\n              </span>\\n            </div>\\n            <div className=\\\"mt-2 h-1.5 w-full overflow-hidden bg-slate-800\\\">\\n              <div\\n                ref={hullBarRef}\\n                className=\\\"h-full w-full origin-left bg-sky-400\\\"\\n                style={{ transform: \'scaleX(1)\', willChange: \'transform\' }}\\n              />\\n            </div>\\n            <div className=\\\"mt-1.5 flex items-center justify-between text-[11px]\\\">\\n              <span className=\\\"text-slate-400\\\">{ship.weapons.primaryName}</span>\\n              <span ref={weaponStatusRef} className=\\\"font-mono font-medium text-slate-300\\\">\\n                READY\\n              </span>\\n            </div>\\n          </div>\\n\\n          {/* Center: Boost Energy & Flight Status */}\\n          <div className=\\\"border border-cyan-500/30 bg-[#040a18]/84 px-4 py-3\\\">\\n            <div className=\\\"flex items-baseline justify-between\\\">\\n              <span ref={boostLabelRef} className=\\\"text-xs font-medium text-cyan-200\\\">\\n                Boost Energy\\n              </span>\\n              <span\\n                ref={boostNumRef}\\n                className=\\\"font-mono text-sm font-semibold tabular-nums text-cyan-300\\\"\\n              >\\n                100%\\n              </span>\\n            </div>\\n            <div className=\\\"mt-2 h-1.5 w-full overflow-hidden bg-slate-800\\\">\\n              <div\\n                ref={boostBarRef}\\n                className=\\\"h-full w-full origin-left bg-cyan-400\\\"\\n                style={{ transform: \'scaleX(1)\', willChange: \'transform\' }}\\n              />\\n            </div>\\n            <div className=\\\"mt-1.5 flex items-center justify-between text-[11px]\\\">\\n              <span className=\\\"text-slate-400\\\">Flight Status</span>\\n              <span\\n                ref={statusTextRef}\\n                className=\\\"font-mono font-medium tracking-wider text-slate-300\\\"\\n              >\\n                STANDBY\\n              </span>\\n            </div>\\n          </div>\\n\\n          {/* Right: Velocity Readout */}\\n          <div className=\\\"border border-slate-700/70 bg-[#040a18]/84 px-4 py-3\\\">\\n            <div className=\\\"flex items-baseline justify-between\\\">\\n              <span className=\\\"text-xs font-medium text-slate-400\\\">Velocity</span>\\n              <div className=\\\"flex items-baseline gap-1\\\">\\n                <span\\n                  ref={speedNumRef}\\n                  className=\\\"font-display text-xl font-bold leading-none tabular-nums text-slate-100\\\"\\n                >\\n                  0\\n                </span>\\n                <span className=\\\"font-mono text-[11px] text-slate-400\\\">m/s</span>\\n              </div>\\n            </div>\\n            <div className=\\\"mt-2 h-1.5 w-full overflow-hidden bg-slate-800\\\">\\n              <div\\n                ref={speedBarRef}\\n                className=\\\"h-full w-full origin-left bg-cyan-500\\\"\\n                style={{ transform: \'scaleX(0)\', willChange: \'transform\' }}\\n              />\\n            </div>\\n            <div className=\\\"mt-1.5 flex items-center justify-between font-mono text-[11px] tabular-nums text-slate-400\\\">\\n              <span>Cruise {ship.flight.maxSpeed}</span>\\n              <span>Boost {Math.round(ship.flight.maxSpeed * ship.flight.boostMultiplier)}</span>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Collapsible Control Hints Strip */}\\n        <div className=\\\"pointer-events-auto flex flex-col items-center\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onToggleHints}\\n            className=\\\"flex items-center gap-1.5 px-2.5 py-1 text-[11px] text-slate-400 transition-colors hover:text-cyan-300\\\"\\n          >\\n            {hintsVisible ? <ChevronDown className=\\\"h-3.5 w-3.5\\\" /> : <ChevronUp className=\\\"h-3.5 w-3.5\\\" />}\\n            <span>{hintsVisible ? \'Hide Controls (H)\' : \'Show Controls (H)\'}</span>\\n          </button>\\n\\n          {hintsVisible && (\\n            <div className=\\\"mt-1 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 border border-slate-800/90 bg-[#040a18]/85 px-4 py-1.5 text-xs text-slate-300\\\">\\n              <span>\\n                <strong className=\\\"font-mono text-cyan-300\\\">Mouse</strong> Aim / Steer\\n              </span>\\n              <span className=\\\"text-slate-600\\\" aria-hidden=\\\"true\\\">\302\267</span>\\n              <span>\\n                <strong className=\\\"font-mono text-cyan-300\\\">LMB / Space</strong> Fire\\n              </span>\\n              <span className=\\\"text-slate-600\\\" aria-hidden=\\\"true\\\">\302\267</span>\\n              <span>\\n                <strong className=\\\"font-mono text-cyan-300\\\">W / S</strong> Thrust / Reverse\\n              </span>\\n              <span className=\\\"text-slate-600\\\" aria-hidden=\\\"true\\\">\302\267</span>\\n              <span>\\n                <strong className=\\\"font-mono text-cyan-300\\\">A / D</strong> Roll\\n              </span>\\n              <span className=\\\"text-slate-600\\\" aria-hidden=\\\"true\\\">\302\267</span>\\n              <span>\\n                <strong className=\\\"font-mono text-cyan-300\\\">Shift</strong> Boost\\n              </span>\\n              <span className=\\\"text-slate-600\\\" aria-hidden=\\\"true\\\">\302\267</span>\\n              <span>\\n                <strong className=\\\"font-mono text-cyan-300\\\">Esc</strong> Pause\\n              </span>\\n            </div>\\n          )}\\n        </div>\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Upgrade FlightHUD with true 3D-matched aiming reticle, boresight tether, hit/kill markers, pooled 3D enemy brackets & health bars, lead pip, damage vignette, and combat stats\", \"Overwrite\":true, \"TargetFile\":\"/src/components/FlightHUD.tsx\", \"toolAction\":\"Upgrading FlightHUD for combat\", \"toolSummary\":\"Update src/components/FlightHUD.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_642785314080585382"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Wire CombatManager lifecycle, player destruction state, and relaunch flow in App.tsx\", \"EndLine\":213, \"Instruction\":\"Instantiate CombatManager in App, reset combat on Play/Relaunch/Reset, and pass combat props to FlightCanvas and FlightHUD\", \"ReplacementContent\":\"import { useCallback, useEffect, useMemo, useRef, useState } from \'react\';\\nimport { AudioManager } from \'./audio/AudioManager\';\\nimport { FlightHUD } from \'./components/FlightHUD\';\\nimport { LoadingScreen } from \'./components/LoadingScreen\';\\nimport { MainMenu } from \'./components/MainMenu\';\\nimport { PauseOverlay } from \'./components/PauseOverlay\';\\nimport { resolveEffectiveGraphics } from \'./config/graphics\';\\nimport { loadSavedSettings, saveSettings, SHIP_CONFIGS } from \'./config/ships\';\\nimport { AssetManager } from \'./engine/AssetManager\';\\nimport { CombatManager } from \'./engine/combat/CombatManager\';\\nimport { createInitialTelemetry, FlightController } from \'./engine/FlightController\';\\nimport { InputManager } from \'./engine/InputManager\';\\nimport { FlightCanvas } from \'./scene/FlightCanvas\';\\nimport type {\\n  GamePhase,\\n  GameSettings,\\n  LoadingProgress,\\n  MenuSection,\\n  ShipId,\\n} from \'./types/game\';\\n\\nexport default function App() {\\n  const [phase, setPhase] = useState<GamePhase>(\'menu\');\\n  const [menuSection, setMenuSection] = useState<MenuSection>(\'main\');\\n  const [activeShipId] = useState<ShipId>(\'interceptor\');\\n  const [hangarShipId, setHangarShipId] = useState<ShipId>(\'interceptor\');\\n  const [settings, setSettings] = useState<GameSettings>(() => loadSavedSettings());\\n  const [pointerLocked, setPointerLocked] = useState(false);\\n  const [playerDestroyed, setPlayerDestroyed] = useState(false);\\n  const [hintsVisible, setHintsVisible] = useState(true);\\n  const [snapCameraSignal, setSnapCameraSignal] = useState(0);\\n  const [loadingProgress, setLoadingProgress] = useState<LoadingProgress>({\\n    stage: \'Initializing flight systems\',\\n    percent: 0,\\n    shipId: \'interceptor\',\\n  });\\n\\n  // Stable engine singletons (never recreated across UI renders)\\n  const settingsRef = useRef<GameSettings>(settings);\\n  const flightRef = useRef<FlightController>(new FlightController(SHIP_CONFIGS[activeShipId]));\\n  const combatRef = useRef<CombatManager>(new CombatManager(SHIP_CONFIGS[activeShipId].maxHull));\\n  const inputRef = useRef<InputManager>(new InputManager());\\n  const telemetryRef = useRef(createInitialTelemetry(SHIP_CONFIGS[activeShipId]));\\n  const hangarOrbitRef = useRef({ yaw: 0, pitch: 0 });\\n  const phaseRef = useRef<GamePhase>(phase);\\n\\n  useEffect(() => {\\n    phaseRef.current = phase;\\n  }, [phase]);\\n\\n  useEffect(() => {\\n    settingsRef.current = settings;\\n    saveSettings(settings);\\n    AudioManager.setMasterVolume(settings.masterVolume);\\n  }, [settings]);\\n\\n  const graphics = useMemo(\\n    () => resolveEffectiveGraphics(settings.graphicsQuality),\\n    [settings.graphicsQuality],\\n  );\\n\\n  // Attach global keyboard + pointer-lock input listeners once\\n  useEffect(() => {\\n    const input = inputRef.current;\\n    input.attach({\\n      onPauseRequested: () => {\\n        if (phaseRef.current === \'playing\' && !combatRef.current.playerHealth.isDestroyed) {\\n          AudioManager.playUiClick(\'pause\');\\n          AudioManager.setFlightAudioActive(false);\\n          input.setActive(false);\\n          setPhase(\'paused\');\\n        }\\n      },\\n      onPointerLockChanged: (locked) => {\\n        setPointerLocked(locked);\\n      },\\n      onToggleHudHints: () => {\\n        setHintsVisible((prev) => !prev);\\n      },\\n    });\\n\\n    return () => {\\n      input.detach();\\n      AudioManager.dispose();\\n      AssetManager.disposeAll();\\n    };\\n  }, []);\\n\\n  // Keep InputManager and flight engine audio synced with current game phase\\n  useEffect(() => {\\n    const isPlaying = phase === \'playing\' && !playerDestroyed;\\n    inputRef.current.setActive(isPlaying);\\n    AudioManager.setFlightAudioActive(isPlaying);\\n  }, [phase, playerDestroyed]);\\n\\n  const handleUpdateSettings = useCallback((patch: Partial<GameSettings>) => {\\n    setSettings((prev) => ({ ...prev, ...patch }));\\n  }, []);\\n\\n  const handleCanvasReady = useCallback((canvas: HTMLCanvasElement) => {\\n    inputRef.current.setLockTarget(canvas);\\n  }, []);\\n\\n  const handleRequestLock = useCallback(() => {\\n    AudioManager.unlock();\\n    if (!inputRef.current.isPointerLocked()) {\\n      inputRef.current.requestPointerLock();\\n    }\\n  }, []);\\n\\n  const handlePlayerDestroyed = useCallback(() => {\\n    inputRef.current.exitPointerLock();\\n    inputRef.current.setActive(false);\\n    AudioManager.setFlightAudioActive(false);\\n    setPlayerDestroyed(true);\\n  }, []);\\n\\n  const startFreshCombatFlight = useCallback(() => {\\n    const ship = SHIP_CONFIGS[activeShipId];\\n    flightRef.current.setShipConfig(ship);\\n    flightRef.current.reset();\\n    combatRef.current.resetSession(ship.maxHull, flightRef.current.position);\\n    telemetryRef.current = createInitialTelemetry(ship);\\n    setPlayerDestroyed(false);\\n    setSnapCameraSignal((s) => s + 1);\\n    setPhase(\'playing\');\\n    inputRef.current.setActive(true);\\n    AudioManager.setFlightAudioActive(true);\\n    inputRef.current.requestPointerLock();\\n  }, [activeShipId]);\\n\\n  const handleStartPlay = useCallback(async () => {\\n    AudioManager.unlock();\\n    setPhase(\'loading\');\\n    setLoadingProgress({\\n      stage: \'Preparing VX-9 Vanguard combat systems\',\\n      percent: 10,\\n      shipId: activeShipId,\\n    });\\n\\n    await AssetManager.prepareFlightSession((stage, percent) => {\\n      setLoadingProgress({ stage, percent, shipId: activeShipId });\\n    });\\n\\n    startFreshCombatFlight();\\n  }, [activeShipId, startFreshCombatFlight]);\\n\\n  const handlePause = useCallback(() => {\\n    if (playerDestroyed) return;\\n    AudioManager.playUiClick(\'pause\');\\n    inputRef.current.exitPointerLock();\\n    inputRef.current.setActive(false);\\n    AudioManager.setFlightAudioActive(false);\\n    setPhase(\'paused\');\\n  }, [playerDestroyed]);\\n\\n  const handleResume = useCallback(() => {\\n    AudioManager.unlock();\\n    setPhase(\'playing\');\\n    inputRef.current.setActive(true);\\n    AudioManager.setFlightAudioActive(true);\\n    inputRef.current.requestPointerLock();\\n  }, []);\\n\\n  const handleResetPosition = useCallback(() => {\\n    startFreshCombatFlight();\\n  }, [startFreshCombatFlight]);\\n\\n  const handleReturnToMenu = useCallback(() => {\\n    inputRef.current.exitPointerLock();\\n    inputRef.current.setActive(false);\\n    AudioManager.setFlightAudioActive(false);\\n    setPlayerDestroyed(false);\\n    setMenuSection(\'main\');\\n    setPhase(\'menu\');\\n  }, []);\\n\\n  return (\\n    <main className=\\\"relative h-screen w-screen overflow-hidden bg-[#030712]\\\">\\n      {/* Isolated Full-Viewport 3D WebGL Scene */}\\n      <FlightCanvas\\n        phase={phase}\\n        menuSection={menuSection}\\n        activeShipId={activeShipId}\\n        hangarShipId={hangarShipId}\\n        flight={flightRef.current}\\n        combat={combatRef.current}\\n        input={inputRef.current}\\n        settingsRef={settingsRef}\\n        telemetryRef={telemetryRef}\\n        graphics={graphics}\\n        hangarOrbitRef={hangarOrbitRef}\\n        snapCameraSignal={snapCameraSignal}\\n        onCanvasReady={handleCanvasReady}\\n        onCanvasClick={handleRequestLock}\\n        onPlayerDestroyed={handlePlayerDestroyed}\\n      />\\n\\n      {/* Semantic UI Overlays */}\\n      {phase === \'menu\' && (\\n        <MainMenu\\n          section={menuSection}\\n          onChangeSection={setMenuSection}\\n          onPlay={handleStartPlay}\\n          hangarShipId={hangarShipId}\\n          onSelectHangarShip={setHangarShipId}\\n          settings={settings}\\n          onUpdateSettings={handleUpdateSettings}\\n          hangarOrbitRef={hangarOrbitRef}\\n        />\\n      )}\\n\\n      {phase === \'loading\' && <LoadingScreen progress={loadingProgress} />}\\n\\n      {phase === \'playing\' && (\\n        <FlightHUD\\n          shipId={activeShipId}\\n          telemetryRef={telemetryRef}\\n          settings={settings}\\n          pointerLocked={pointerLocked}\\n          playerDestroyed={playerDestroyed}\\n          hintsVisible={hintsVisible}\\n          onToggleHints={() => setHintsVisible((v) => !v)}\\n          onRequestLock={handleRequestLock}\\n          onPause={handlePause}\\n          onRelaunch={startFreshCombatFlight}\\n          onReturnToMenu={handleReturnToMenu}\\n        />\\n      )}\\n\\n      {phase === \'paused\' && (\\n        <PauseOverlay\\n          settings={settings}\\n          onUpdateSettings={handleUpdateSettings}\\n          onResume={handleResume}\\n          onResetPosition={handleResetPosition}\\n          onReturnToMenu={handleReturnToMenu}\\n        />\\n      )}\\n    </main>\\n  );\\n}\", \"StartLine\":1, \"TargetContent\":\"import { useCallback, useEffect, useMemo, useRef, useState } from \'react\';\\nimport { AudioManager } from \'./audio/AudioManager\';\\nimport { FlightHUD } from \'./components/FlightHUD\';\\nimport { LoadingScreen } from \'./components/LoadingScreen\';\\nimport { MainMenu } from \'./components/MainMenu\';\\nimport { PauseOverlay } from \'./components/PauseOverlay\';\\nimport { resolveEffectiveGraphics } from \'./config/graphics\';\\nimport { loadSavedSettings, saveSettings, SHIP_CONFIGS } from \'./config/ships\';\\nimport { AssetManager } from \'./engine/AssetManager\';\\nimport { createInitialTelemetry, FlightController } from \'./engine/FlightController\';\\nimport { InputManager } from \'./engine/InputManager\';\\nimport { FlightCanvas } from \'./scene/FlightCanvas\';\\nimport type {\\n  GamePhase,\\n  GameSettings,\\n  LoadingProgress,\\n  MenuSection,\\n  ShipId,\\n} from \'./types/game\';\\n\\nexport default function App() {\\n  const [phase, setPhase] = useState<GamePhase>(\'menu\');\\n  const [menuSection, setMenuSection] = useState<MenuSection>(\'main\');\\n  const [activeShipId] = useState<ShipId>(\'interceptor\');\\n  const [hangarShipId, setHangarShipId] = useState<ShipId>(\'interceptor\');\\n  const [settings, setSettings] = useState<GameSettings>(() => loadSavedSettings());\\n  const [pointerLocked, setPointerLocked] = useState(false);\\n  const [hintsVisible, setHintsVisible] = useState(true);\\n  const [snapCameraSignal, setSnapCameraSignal] = useState(0);\\n  const [loadingProgress, setLoadingProgress] = useState<LoadingProgress>({\\n    stage: \'Initializing flight systems\',\\n    percent: 0,\\n    shipId: \'interceptor\',\\n  });\\n\\n  // Stable engine singletons (never recreated across UI renders)\\n  const settingsRef = useRef<GameSettings>(settings);\\n  const flightRef = useRef<FlightController>(new FlightController(SHIP_CONFIGS[activeShipId]));\\n  const inputRef = useRef<InputManager>(new InputManager());\\n  const telemetryRef = useRef(createInitialTelemetry(SHIP_CONFIGS[activeShipId]));\\n  const hangarOrbitRef = useRef({ yaw: 0, pitch: 0 });\\n  const phaseRef = useRef<GamePhase>(phase);\\n\\n  useEffect(() => {\\n    phaseRef.current = phase;\\n  }, [phase]);\\n\\n  useEffect(() => {\\n    settingsRef.current = settings;\\n    saveSettings(settings);\\n    AudioManager.setMasterVolume(settings.masterVolume);\\n  }, [settings]);\\n\\n  const graphics = useMemo(\\n    () => resolveEffectiveGraphics(settings.graphicsQuality),\\n    [settings.graphicsQuality],\\n  );\\n\\n  // Attach global keyboard + pointer-lock input listeners once\\n  useEffect(() => {\\n    const input = inputRef.current;\\n    input.attach({\\n      onPauseRequested: () => {\\n        if (phaseRef.current === \'playing\') {\\n          AudioManager.playUiClick(\'pause\');\\n          AudioManager.setFlightAudioActive(false);\\n          input.setActive(false);\\n          setPhase(\'paused\');\\n        }\\n      },\\n      onPointerLockChanged: (locked) => {\\n        setPointerLocked(locked);\\n      },\\n      onToggleHudHints: () => {\\n        setHintsVisible((prev) => !prev);\\n      },\\n    });\\n\\n    return () => {\\n      input.detach();\\n      AudioManager.dispose();\\n      AssetManager.disposeAll();\\n    };\\n  }, []);\\n\\n  // Keep InputManager and flight engine audio synced with current game phase\\n  useEffect(() => {\\n    const isPlaying = phase === \'playing\';\\n    inputRef.current.setActive(isPlaying);\\n    AudioManager.setFlightAudioActive(isPlaying);\\n  }, [phase]);\\n\\n  const handleUpdateSettings = useCallback((patch: Partial<GameSettings>) => {\\n    setSettings((prev) => ({ ...prev, ...patch }));\\n  }, []);\\n\\n  const handleCanvasReady = useCallback((canvas: HTMLCanvasElement) => {\\n    inputRef.current.setLockTarget(canvas);\\n  }, []);\\n\\n  const handleRequestLock = useCallback(() => {\\n    AudioManager.unlock();\\n    inputRef.current.requestPointerLock();\\n  }, []);\\n\\n  const handleStartPlay = useCallback(async () => {\\n    AudioManager.unlock();\\n    setPhase(\'loading\');\\n    setLoadingProgress({\\n      stage: \'Preparing VX-9 Vanguard flight profile\',\\n      percent: 10,\\n      shipId: activeShipId,\\n    });\\n\\n    await AssetManager.prepareFlightSession((stage, percent) => {\\n      setLoadingProgress({ stage, percent, shipId: activeShipId });\\n    });\\n\\n    flightRef.current.setShipConfig(SHIP_CONFIGS[activeShipId]);\\n    flightRef.current.reset();\\n    telemetryRef.current = createInitialTelemetry(SHIP_CONFIGS[activeShipId]);\\n    setSnapCameraSignal((s) => s + 1);\\n    setPhase(\'playing\');\\n    inputRef.current.setActive(true);\\n    AudioManager.setFlightAudioActive(true);\\n    // Request pointer lock seamlessly as player enters active flight\\n    inputRef.current.requestPointerLock();\\n  }, [activeShipId]);\\n\\n  const handlePause = useCallback(() => {\\n    AudioManager.playUiClick(\'pause\');\\n    inputRef.current.exitPointerLock();\\n    inputRef.current.setActive(false);\\n    AudioManager.setFlightAudioActive(false);\\n    setPhase(\'paused\');\\n  }, []);\\n\\n  const handleResume = useCallback(() => {\\n    AudioManager.unlock();\\n    setPhase(\'playing\');\\n    inputRef.current.setActive(true);\\n    AudioManager.setFlightAudioActive(true);\\n    inputRef.current.requestPointerLock();\\n  }, []);\\n\\n  const handleResetPosition = useCallback(() => {\\n    flightRef.current.reset();\\n    setSnapCameraSignal((s) => s + 1);\\n    handleResume();\\n  }, [handleResume]);\\n\\n  const handleReturnToMenu = useCallback(() => {\\n    inputRef.current.exitPointerLock();\\n    inputRef.current.setActive(false);\\n    AudioManager.setFlightAudioActive(false);\\n    setMenuSection(\'main\');\\n    setPhase(\'menu\');\\n  }, []);\\n\\n  return (\\n    <main className=\\\"relative h-screen w-screen overflow-hidden bg-[#030712]\\\">\\n      {/* Isolated Full-Viewport 3D WebGL Scene */}\\n      <FlightCanvas\\n        phase={phase}\\n        menuSection={menuSection}\\n        activeShipId={activeShipId}\\n        hangarShipId={hangarShipId}\\n        flight={flightRef.current}\\n        input={inputRef.current}\\n        settingsRef={settingsRef}\\n        telemetryRef={telemetryRef}\\n        graphics={graphics}\\n        hangarOrbitRef={hangarOrbitRef}\\n        snapCameraSignal={snapCameraSignal}\\n        onCanvasReady={handleCanvasReady}\\n        onCanvasClick={handleRequestLock}\\n      />\\n\\n      {/* Semantic UI Overlays */}\\n      {phase === \'menu\' && (\\n        <MainMenu\\n          section={menuSection}\\n          onChangeSection={setMenuSection}\\n          onPlay={handleStartPlay}\\n          hangarShipId={hangarShipId}\\n          onSelectHangarShip={setHangarShipId}\\n          settings={settings}\\n          onUpdateSettings={handleUpdateSettings}\\n          hangarOrbitRef={hangarOrbitRef}\\n        />\\n      )}\\n\\n      {phase === \'loading\' && <LoadingScreen progress={loadingProgress} />}\\n\\n      {phase === \'playing\' && (\\n        <FlightHUD\\n          shipId={activeShipId}\\n          telemetryRef={telemetryRef}\\n          settings={settings}\\n          pointerLocked={pointerLocked}\\n          hintsVisible={hintsVisible}\\n          onToggleHints={() => setHintsVisible((v) => !v)}\\n          onRequestLock={handleRequestLock}\\n          onPause={handlePause}\\n        />\\n      )}\\n\\n      {phase === \'paused\' && (\\n        <PauseOverlay\\n          settings={settings}\\n          onUpdateSettings={handleUpdateSettings}\\n          onResume={handleResume}\\n          onResetPosition={handleResetPosition}\\n          onReturnToMenu={handleReturnToMenu}\\n        />\\n      )}\\n    </main>\\n  );\\n}\", \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Updating App with CombatManager\", \"toolSummary\":\"Update src/App.tsx\"}"
      original_name: "replace_file_content"
    }
