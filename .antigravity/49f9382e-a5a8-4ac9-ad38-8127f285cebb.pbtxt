              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      _evalX,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    evaluateProgressiveAxisSensitivity("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      Math.abs(this.virtualAimY),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      boundaryY,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      accelDist,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      boundarySens,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      maxSens,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      curveExp,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      _evalY,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Frame-rate independent recovery smoothing (~0.12s) eliminates sudden sensitivity jumps"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const recoveryAlpha ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      1 - Math.exp(-safeDt / PROGRESSIVE_STEERING_CONFIG.recoverySmoothingSec);"
