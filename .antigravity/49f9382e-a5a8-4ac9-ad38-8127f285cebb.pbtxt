            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  float hash(vec3 p) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    p = fract(p * 0.3183099 + 0.1);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
