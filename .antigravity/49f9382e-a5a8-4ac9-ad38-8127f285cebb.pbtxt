            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "function shapeMouseDelta(deltaPx: number): number {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * Precision-preserving relative mouse curve:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - Small micro-adjustments (<= 5px) remain ultra-fine and controllable for pinpoint gunnery."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - Larger continuous sweeps pass through linearly with zero clipping and zero artificial cap."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "function shapeRelativeMouseDelta(deltaPx: number): number {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const abs = Math.abs(deltaPx);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  if (abs < 0.0001) return 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  // Precision zone (< 6px): smooth fine scale; sweeping zone: progressive acceleration"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  const shaped = abs <= 6 ? abs * 0.85 : 5.1 + Math.pow(abs - 6, 1.18) * 1.18;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  const shaped = abs <= 5 ? abs * 0.84 : 4.2 + (abs - 5) * 1.04;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return Math.sign(deltaPx) * shaped;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "/**"
