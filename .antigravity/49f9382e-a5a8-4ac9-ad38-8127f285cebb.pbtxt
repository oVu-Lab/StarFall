        replacement_content: "  // Combat & aiming refs\n  const aimReticleRef = useRef<HTMLDivElement>(null);\n  const aimRingRef = useRef<HTMLDivElement>(null);\n  const aimBoundaryRef = useRef<HTMLDivElement>(null);\n  const boresightRef = useRef<HTMLDivElement>(null);\n  const steerLineRef = useRef<SVGLineElement>(null);"
        start_line: 58
        end_line: 66
      }
      num_matches: 1
    }
    replacement_infos {
      original_chunk {
        target_content: "      if (steerLineRef.current) {\n        const dx = aimPxX - cx;\n        const dy = aimPxY - cy;\n        const distPx = Math.hypot(dx, dy);\n        if (distPx > 14) {\n          const ux = dx / distPx;\n          const uy = dy / distPx;\n          steerLineRef.current.setAttribute(\'x1\', (cx + ux * 10).toFixed(1));\n          steerLineRef.current.setAttribute(\'y1\', (cy + uy * 10).toFixed(1));\n          steerLineRef.current.setAttribute(\'x2\', (aimPxX - ux * 18).toFixed(1));\n          steerLineRef.current.setAttribute(\'y2\', (aimPxY - uy * 18).toFixed(1));\n          steerLineRef.current.style.opacity = String(Math.min(0.42, (distPx / 260) * 0.42).toFixed(2));\n        } else {\n          steerLineRef.current.style.opacity = \'0\';\n        }\n      }"
        replacement_content: "      if (aimBoundaryRef.current) {\n        const deflection = Math.hypot(t.aimNormalizedX, t.aimNormalizedY);\n        const edgeOp = deflection > 0.15 ? 0.08 + Math.min(1, deflection) * 0.18 : 0.06;\n        aimBoundaryRef.current.style.opacity = edgeOp.toFixed(2);\n      }\n\n      if (steerLineRef.current) {\n        const dx = aimPxX - cx;\n        const dy = aimPxY - cy;\n        const distPx = Math.hypot(dx, dy);\n        if (distPx > 14) {\n          const ux = dx / distPx;\n          const uy = dy / distPx;\n          steerLineRef.current.setAttribute(\'x1\', (cx + ux * 10).toFixed(1));\n          steerLineRef.current.setAttribute(\'y1\', (cy + uy * 10).toFixed(1));\n          steerLineRef.current.setAttribute(\'x2\', (aimPxX - ux * 18).toFixed(1));\n          steerLineRef.current.setAttribute(\'y2\', (aimPxY - uy * 18).toFixed(1));\n          steerLineRef.current.style.opacity = String(Math.min(0.42, (distPx / 220) * 0.42).toFixed(2));\n        } else {\n          steerLineRef.current.style.opacity = \'0\';\n        }\n      }"
        start_line: 200
        end_line: 218
      }
      num_matches: 1
