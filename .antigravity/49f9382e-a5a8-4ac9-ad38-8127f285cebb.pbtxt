            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Phase 3 Continuous Mouse Turning:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * - Directly integrates unbounded relative Pointer Lock deltas into smooth local-space"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " *   quaternion rotation without any screen-edge boundary, gimbal clamp, or cursor snap-back."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * - Supports unlimited 360-degree continuous yaw, pitch loops, and independent A/D barrel rolls."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
