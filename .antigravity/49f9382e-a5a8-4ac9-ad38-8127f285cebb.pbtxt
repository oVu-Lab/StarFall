            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (input.mouseDeltaX !== 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.virtualAimX = THREE.MathUtils.clamp("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        this.virtualAimX + input.mouseDeltaX * baseSens,"
