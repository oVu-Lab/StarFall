            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Non-linear precision curve for mouse deltas:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Preserves fine 1:1 micro-aiming for small movements while expanding reach on broad sweeps"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * without simply cranking up global sensitivity."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "function shapeMouseDelta(deltaPx: number): number {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const abs = Math.abs(deltaPx);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (abs < 0.0001) return 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Precision zone (< 6px): smooth fine scale; sweeping zone: progressive acceleration"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const shaped = abs <= 6 ? abs * 0.85 : 5.1 + Math.pow(abs - 6, 1.18) * 1.18;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return Math.sign(deltaPx) * shaped;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Arcade 6DOF space flight controller."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Ship coordinate system: Forward = -Z, Right = +X, Up = +Y."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Completely independent of React UI and ship geometry implementation."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * Uses an expanded gimbaled aiming envelope (aimYawOffset, aimPitchOffset) so the player"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * can aim smoothly across a large field of view while the fighter chases the aim vector with zero gimbal lock."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
