            }
            lines {
              text: "  noseMesh.castShadow = true;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  noseMesh.receiveShadow = true;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
