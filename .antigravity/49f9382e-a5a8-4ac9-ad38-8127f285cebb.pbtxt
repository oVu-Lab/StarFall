  code_action {
    action_spec {
      create_file {
        instruction: "import * as THREE from \'three\';\n\nexport interface ProceduralTextureBundle {\n  hullAlbedo: THREE.CanvasTexture;\n  hullRoughness: THREE.CanvasTexture;\n  hullBump: THREE.CanvasTexture;\n  gasGiantMap: THREE.CanvasTexture;\n  moonMap: THREE.CanvasTexture;\n  asteroidMap: THREE.CanvasTexture;\n  glowSprite: THREE.CanvasTexture;\n}\n\ninterface CacheEntry<T> {\n  value: T;\n  refs: number;\n  dispose: () => void;\n}\n\n/**\n * Centralized progressive asset manager with caching, reference tracking,\n * deterministic procedural PBR texture synthesis (zero external 404s), and disposal.\n */\nclass AssetManagerImpl {\n  private cache = new Map<string, CacheEntry<unknown>>();\n  private maxAnisotropy = 4;\n\n  public configureRenderer(renderer: THREE.WebGLRenderer): void {\n    this.maxAnisotropy = Math.min(renderer.capabilities.getMaxAnisotropy(), 8);\n  }\n\n  public acquire<T>(key: string, factory: () => T, dispose: (val: T) => void): T {\n    const existing = this.cache.get(key) as CacheEntry<T> | undefined;\n    if (existing) {\n      existing.refs += 1;\n      return existing.value;\n    }\n    const value = factory();\n    this.cache.set(key, {\n      value,\n      refs: 1,\n      dispose: () => dispose(value),\n    });\n    return value;\n  }\n\n  public release(key: string): void {\n    const entry = this.cache.get(key);\n    if (!entry) return;\n    entry.refs -= 1;\n    if (entry.refs <= 0) {\n      entry.dispose();\n      this.cache.delete(key);\n    }\n  }\n\n  public getCoreTextures(): ProceduralTextureBundle {\n    return this.acquire<ProceduralTextureBundle>(\n      \'core-procedural-textures\',\n      () => ({\n        hullAlbedo: this.createHullAlbedoTexture(),\n        hullRoughness: this.createHullRoughnessTexture(),\n        hullBump: this.createHullBumpTexture(),\n        gasGiantMap: this.createGasGiantTexture(),\n        moonMap: this.createMoonTexture(),\n        asteroidMap: this.createAsteroidTexture(),\n        glowSprite: this.createGlowSpriteTexture(),\n      }),\n      (bundle) => {\n        bundle.hullAlbedo.dispose();\n        bundle.hullRoughness.dispose();\n        bundle.hullBump.dispose();\n        bundle.gasGiantMap.dispose();\n        bundle.moonMap.dispose();\n        bundle.asteroidMap.dispose();\n        bundle.glowSprite.dispose();\n      },\n    );\n  }\n\n  /**\n   * Progressive async preparation pipeline used when transitioning from Menu -> Gameplay.\n   * Yields between stages so the main thread stays smooth and reports accurate progress.\n   */\n  public async prepareFlightSession(\n    onProgress: (stage: string, percent: number) => void,\n  ): Promise<void> {\n    const yieldFrame = () =>\n      new Promise<void>((resolve) => {\n        window.requestAnimationFrame(() => resolve());\n      });\n\n    onProgress(\'Synthesizing hull PBR plating & panel maps\', 22);\n    await yieldFrame();\n    this.getCoreTextures();\n\n    onProgress(\'Calibrating orbital sector & planetary shaders\', 54);\n    await yieldFrame();\n    await new Promise((r) => window.setTimeout(r, 90));\n\n    onProgress(\'Initializing 6DOF flight telemetry & thrusters\', 82);\n    await yieldFrame();\n    await new Promise((r) => window.setTimeout(r, 90));\n\n    onProgress(\'Flight systems online\', 100);\n    await yieldFrame();\n  }\n\n  private configureTexture(\n    tex: THREE.CanvasTexture,\n    isColor: boolean,\n    repeatX = 1,\n    repeatY = 1,\n  ): THREE.CanvasTexture {\n    tex.wrapS = THREE.RepeatWrapping;\n    tex.wrapT = THREE.RepeatWrapping;\n    tex.repeat.set(repeatX, repeatY);\n    tex.colorSpace = isColor ? THREE.SRGBColorSpace : THREE.NoColorSpace;\n    tex.anisotropy = this.maxAnisotropy;\n    tex.needsUpdate = true;\n    return tex;\n  }\n\n  private createHullAlbedoTexture(): THREE.CanvasTexture {\n    const size = 512;\n    const canvas = document.createElement(\'canvas\');\n    canvas.width = size;\n    canvas.height = size;\n    const ctx = canvas.getContext(\'2d\')!;\n\n    ctx.fillStyle = \'#c8d4e3\';\n    ctx.fillRect(0, 0, size, size);\n\n    // Subtle brushed titanium directional micro-grain\n    for (let y = 0; y < size; y += 2) {\n      const shade = 192 + ((Math.sin(y * 0.73) * 7 + Math.cos(y * 2.1) * 5) | 0);\n      ctx.fillStyle = `rgb(${shade - 6}, ${shade}, ${shade + 8})`;\n      ctx.fillRect(0, y, size, 2);\n    }\n\n    // Precision armored hull plates\n    const panels = [\n      [16, 16, 224, 140, \'rgba(255,255,255,0.06)\'],\n      [256, 16, 240, 220, \'rgba(15,23,42,0.09)\'],\n      [16, 172, 224, 160, \'rgba(15,23,42,0.06)\'],\n      [256, 252, 240, 244, \'rgba(255,255,255,0.05)\'],\n      [16, 348, 224, 148, \'rgba(30,41,59,0.08)\'],\n    ] as const;\n\n    for (const [x, y, w, h, fill] of panels) {\n      ctx.fillStyle = fill;\n      ctx.fillRect(x, y, w, h);\n      ctx.strokeStyle = \'rgba(15, 23, 42, 0.45)\';\n      ctx.lineWidth = 2;\n      ctx.strokeRect(x, y, w, h);\n      ctx.strokeStyle = \'rgba(226, 232, 240, 0.25)\';\n      ctx.lineWidth = 1;\n      ctx.strokeRect(x + 2, y + 2, w - 4, h - 4);\n    }\n\n    // Subtle rivet accents along panel corners\n    ctx.fillStyle = \'rgba(15, 23, 42, 0.5)\';\n    for (let x = 28; x < size; x += 64) {\n      for (let y = 28; y < size; y += 64) {\n        ctx.beginPath();\n        ctx.arc(x, y, 1.8, 0, Math.PI * 2);\n        ctx.fill();\n      }\n    }\n\n    return this.configureTexture(new THREE.CanvasTexture(canvas), true, 2, 2);\n  }\n\n  private createHullRoughnessTexture(): THREE.CanvasTexture {\n    const size = 512;\n    const canvas = document.createElement(\'canvas\');\n    canvas.width = size;\n    canvas.height = size;\n    const ctx = canvas.getContext(\'2d\')!;\n\n    ctx.fillStyle = \'#585858\';\n    ctx.fillRect(0, 0, size, size);\n\n    // Varying panel sheen for realistic light break-up\n    ctx.fillStyle = \'#404040\';\n    ctx.fillRect(16, 16, 224, 140);\n    ctx.fillStyle = \'#6c6c6c\';\n    ctx.fillRect(256, 16, 240, 220);\n    ctx.fillStyle = \'#4d4d4d\';\n    ctx.fillRect(256, 252, 240, 244);\n\n    // Matte panel seams\n    ctx.strokeStyle = \'#b8b8b8\';\n    ctx.lineWidth = 3;\n    ctx.strokeRect(16, 16, 224, 140);\n    ctx.strokeRect(256, 16, 240, 220);\n    ctx.strokeRect(16, 172, 224, 160);\n    ctx.strokeRect(256, 252, 240, 244);\n\n    return this.configureTexture(new THREE.CanvasTexture(canvas), false, 2, 2);\n  }\n\n  private createHullBumpTexture(): THREE.CanvasTexture {\n    const size = 512;\n    const canvas = document.createElement(\'canvas\');\n    canvas.width = size;\n    canvas.height = size;\n    const ctx = canvas.getContext(\'2d\')!;\n\n    ctx.fillStyle = \'#808080\';\n    ctx.fillRect(0, 0, size, size);\n\n    ctx.strokeStyle = \'#202020\';\n    ctx.lineWidth = 3;\n    ctx.strokeRect(16, 16, 224, 140);\n    ctx.strokeRect(256, 16, 240, 220);\n    ctx.strokeRect(16, 172, 224, 160);\n    ctx.strokeRect(256, 252, 240, 244);\n    ctx.strokeRect(16, 348, 224, 148);\n\n    // Access hatches\n    ctx.strokeStyle = \'#383838\';\n    ctx.lineWidth = 2;\n    ctx.strokeRect(64, 56, 48, 32);\n    ctx.strokeRect(320, 310, 68, 42);\n\n    return this.configureTexture(new THREE.CanvasTexture(canvas), false, 2, 2);\n  }\n\n  private createGasGiantTexture(): THREE.CanvasTexture {\n    const w = 1024;\n    const h = 512;\n    const canvas = document.createElement(\'canvas\');\n    canvas.width = w;\n    canvas.height = h;\n    const ctx = canvas.getContext(\'2d\')!;\n\n    // Deep sapphire/slate-blue & luminous pale-cyan atmospheric bands\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0.0, \'#071024\');\n    grad.addColorStop(0.14, \'#102446\');\n    grad.addColorStop(0.28, \'#1e3a5f\');\n    grad.addColorStop(0.4, \'#38638f\');\n    grad.addColorStop(0.5, \'#6fa3c7\');\n    grad.addColorStop(0.6, \'#23466d\');\n    grad.addColorStop(0.75, \'#132a4f\');\n    grad.addColorStop(0.9, \'#0b1830\');\n    grad.addColorStop(1.0, \'#060c1b\');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n\n    // Swirling horizontal storm bands\n    for (let i = 0; i < 65; i++) {\n      const y = (i / 65) * h;\n      const bandH = 3 + ((i * 7) % 14);\n      const alpha = 0.08 + ((i * 13) % 10) * 0.015;\n      const isBright = i % 3 === 0;\n      ctx.fillStyle = isBright\n        ? `rgba(125, 211, 252, ${alpha})`\n        : `rgba(8, 18, 38, ${alpha * 1.4})`;\n\n      ctx.beginPath();\n      ctx.moveTo(0, y);\n      for (let x = 0; x <= w; x += 32) {\n        const wave = Math.sin(x * 0.012 + i * 1.3) * 5 + Math.cos(x * 0.028 - i * 0.7) * 3;\n        ctx.lineTo(x, y + wave);\n      }\n      ctx.lineTo(w, y + bandH);\n      ctx.lineTo(0, y + bandH);\n      ctx.closePath();\n      ctx.fill();\n    }\n\n    // Great cyan-indigo cyclone oval\n    const stormGrad = ctx.createRadialGradient(w * 0.62, h * 0.44, 6, w * 0.62, h * 0.44, 68);\n    stormGrad.addColorStop(0, \'rgba(186, 230, 253, 0.55)\');\n    stormGrad.addColorStop(0.45, \'rgba(56, 189, 248, 0.28)\');\n    stormGrad.addColorStop(1, \'rgba(14, 116, 144, 0)\');\n    ctx.save();\n    ctx.scale(1.6, 0.72);\n    ctx.fillStyle = stormGrad;\n    ctx.beginPath();\n    ctx.arc((w * 0.62) / 1.6, (h * 0.44) / 0.72, 68, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.restore();\n\n    return this.configureTexture(new THREE.CanvasTexture(canvas), true, 1, 1);\n  }\n\n  private createMoonTexture(): THREE.CanvasTexture {\n    const w = 512;\n    const h = 256;\n    const canvas = document.createElement(\'canvas\');\n    canvas.width = w;\n    canvas.height = h;\n    const ctx = canvas.getContext(\'2d\')!;\n\n    ctx.fillStyle = \'#475569\';\n    ctx.fillRect(0, 0, w, h);\n\n    // Subtle regolith blotches\n    for (let i = 0; i < 120; i++) {\n      const x = ((i * 97) % w);\n      const y = ((i * 53) % h);\n      const r = 8 + ((i * 19) % 34);\n      const light = i % 2 === 0;\n      ctx.fillStyle = light ? \'rgba(148, 163, 184, 0.14)\' : \'rgba(15, 23, 42, 0.22)\';\n      ctx.beginPath();\n      ctx.arc(x, y, r, 0, Math.PI * 2);\n      ctx.fill();\n    }\n\n    // Impact craters with bright rims\n    for (let i = 0; i < 42; i++) {\n      const x = ((i * 131 + 29) % w);\n      const y = 20 + ((i * 71) % (h - 40));\n      const r = 4 + ((i * 11) % 18);\n      ctx.fillStyle = \'rgba(15, 23, 42, 0.36)\';\n      ctx.beginPath();\n      ctx.arc(x, y, r, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.strokeStyle = \'rgba(203, 213, 225, 0.22)\';\n      ctx.lineWidth = 1.4;\n      ctx.beginPath();\n      ctx.arc(x - 1, y - 1, r, 0, Math.PI * 2);\n      ctx.stroke();\n    }\n\n    return this.configureTexture(new THREE.CanvasTexture(canvas), true, 1, 1);\n  }\n\n  private createAsteroidTexture(): THREE.CanvasTexture {\n    const size = 256;\n    const canvas = document.createElement(\'canvas\');\n    canvas.width = size;\n    canvas.height = size;\n    const ctx = canvas.getContext(\'2d\')!;\n\n    ctx.fillStyle = \'#334155\';\n    ctx.fillRect(0, 0, size, size);\n\n    for (let i = 0; i < 90; i++) {\n      const x = (i * 67) % size;\n      const y = (i * 41) % size;\n      const r = 4 + ((i * 13) % 20);\n      ctx.fillStyle = i % 3 === 0 ? \'rgba(100,116,139,0.22)\' : \'rgba(15,23,42,0.28)\';\n      ctx.beginPath();\n      ctx.arc(x, y, r, 0, Math.PI * 2);\n      ctx.fill();\n    }\n\n    return this.configureTexture(new THREE.CanvasTexture(canvas), true, 1, 1);\n  }\n\n  private createGlowSpriteTexture(): THREE.CanvasTexture {\n    const size = 128;\n    const canvas = document.createElement(\'canvas\');\n    canvas.width = size;\n    canvas.height = size;\n    const ctx = canvas.getContext(\'2d\')!;\n    const c = size / 2;\n    const grad = ctx.createRadialGradient(c, c, 0, c, c, c);\n    grad.addColorStop(0.0, \'rgba(255, 255, 255, 1.0)\');\n    grad.addColorStop(0.25, \'rgba(165, 243, 252, 0.78)\');\n    grad.addColorStop(0.55, \'rgba(6, 182, 212, 0.28)\');\n    grad.addColorStop(1.0, \'rgba(6, 182, 212, 0.0)\');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, size, size);\n    const tex = new THREE.CanvasTexture(canvas);\n    tex.colorSpace = THREE.SRGBColorSpace;\n    tex.needsUpdate = true;\n    return tex;\n  }\n\n  public disposeAll(): void {\n    for (const entry of this.cache.values()) {\n      entry.dispose();\n    }\n    this.cache.clear();\n  }\n}\n\nexport const AssetManager = new AssetManagerImpl();\n"
        path {
          absolute_uri: "file:///src/engine/AssetManager.ts"
        }
        overwrite: true
      }
