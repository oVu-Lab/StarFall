            lines {
              text: "    vec3 f = fract(x);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    f = f * f * (3.0 - 2.0 * f);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    return mix("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
