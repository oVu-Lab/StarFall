    command_line: "NODE_PATH=/usr/local/share/bun-global/node_modules node -e \'\nconst { chromium } = require(\"playwright\");\n(async () => {\n  const browser = await chromium.launch({\n    headless: true,\n    args: [\"--no-sandbox\", \"--use-gl=angle\", \"--use-angle=swiftshader\"]\n  });\n  const page = await browser.newPage({ viewport: { width: 1280, height: 720 } });\n  page.setDefaultTimeout(15000);\n  page.on(\"pageerror\", e => console.log(\"[pageerror]\", e.message));\n\n  await page.goto(\"http://localhost:3000/\", { waitUntil: \"domcontentloaded\" });\n  await page.waitForTimeout(1000);\n  await page.getByRole(\"button\", { name: /Campaign Missions/i }).click({ force: true });\n  await page.waitForTimeout(300);\n  await page.getByRole(\"button\", { name: /Launch M-01/i }).click({ force: true });\n\n  // Wait until Pause button appears (meaning phase === playing)\n  await page.getByRole(\"button\", { name: /Pause Flight/i }).waitFor({ state: \"visible\", timeout: 15000 });\n  console.log(\"Entered playing phase! pointerLockElement:\", await page.evaluate(() => document.pointerLockElement?.tagName || null));\n  console.log(\"Buttons:\", await page.locator(\"button\").allInnerTexts());\n\n  // Move mouse smoothly with steps in Playwright\n  await page.mouse.move(640, 360);\n  const res1 = await page.evaluate(() => ({\n    pl: document.pointerLockElement?.tagName || null,\n    innerW: window.innerWidth,\n    innerH: window.innerHeight\n  }));\n  console.log(\"State:\", JSON.stringify(res1));\n\n  // Check if in iframe\n  const page2 = await browser.newPage({ viewport: { width: 1280, height: 720 } });\n  await page2.setContent(\"<iframe src=\\\"http://localhost:3000/\\\" style=\\\"width:100vw;height:100vh;border:0\\\"></iframe>\");\n  await page2.waitForTimeout(1500);\n  const frame = page2.frames()[1];\n  await frame.getByRole(\"button\", { name: /Campaign Missions/i }).click({ force: true });\n  await page2.waitForTimeout(300);\n  await frame.getByRole(\"button\", { name: /Launch M-01/i }).click({ force: true });\n  await frame.getByRole(\"button\", { name: /Pause Flight/i }).waitFor({ state: \"visible\", timeout: 15000 });\n  const iframePl = await frame.evaluate(() => ({\n    pl: document.pointerLockElement?.tagName || null,\n    buttons: Array.from(document.querySelectorAll(\"button\")).map(b => b.innerText)\n  }));\n  console.log(\"Iframe playing:\", JSON.stringify(iframePl));\n\n  await browser.close();\n  process.exit(0);\n})().catch(e => { console.error(e); process.exit(1); });\n\'"
