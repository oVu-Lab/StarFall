      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Remove now-unused onCanvasClick prop passed to FlightCanvas in App.tsx and expose dev-only input diagnostics on window in dev mode for verification\", \"EndLine\":414, \"Instruction\":\"Update FlightCanvas prop list in App.tsx to remove onCanvasClick\", \"ReplacementContent\":\"        snapCameraSignal={snapCameraSignal}\\n        onCanvasReady={handleCanvasReady}\\n        onPlayerDestroyed={handlePlayerDestroyed}\\n      />\", \"StartLine\":408, \"TargetContent\":\"        snapCameraSignal={snapCameraSignal}\\n        onCanvasReady={handleCanvasReady}\\n        onCanvasClick={handleRequestLock}\\n        onPlayerDestroyed={handlePlayerDestroyed}\\n      />\", \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Updating FlightCanvas props in App.tsx\", \"toolSummary\":\"Update App.tsx props\"}"
