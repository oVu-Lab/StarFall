              text: "            this.damageFlashTimer = 0.35;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            this.cameraImpulse = Math.min(1, this.cameraImpulse + 0.65);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          applyDamage(enemy.health, 16, PLAYER_ENTITY_ID, this.simTime);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          this.ai.triggerDamageReaction(enemy, flight.position, this.simTime);"
