      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Write persistent virtual cursor screen coordinates into telemetry in FlightController.ts\", \"EndLine\":426, \"Instruction\":\"Update FlightController.ts telemetry output so aimNormalizedX/Y and aimScreenX/Y reflect the persistent virtual steering cursor directly.\", \"ReplacementContent\":\"    telemetry.yawRate = THREE.MathUtils.clamp(this.yawVelocity / profile.yawSpeed, -1, 1);\\n    telemetry.pitchRate = THREE.MathUtils.clamp(this.pitchVelocity / profile.pitchSpeed, -1, 1);\\n    telemetry.rollRate = THREE.MathUtils.clamp(this.rollVelocity / profile.rollSpeed, -1, 1);\\n    telemetry.aimNormalizedX = this.aimCursorX;\\n    telemetry.aimNormalizedY = this.aimCursorY;\\n    telemetry.aimScreenX = 0.5 + this.aimCursorX * 0.5;\\n    telemetry.aimScreenY = 0.5 + this.aimCursorY * 0.5;\\n    telemetry.headingDeg = headingDeg;\", \"StartLine\":405, \"TargetContent\":\"    telemetry.yawRate = THREE.MathUtils.clamp(this.yawVelocity / profile.yawSpeed, -1, 1);\\n    telemetry.pitchRate = THREE.MathUtils.clamp(this.pitchVelocity / profile.pitchSpeed, -1, 1);\\n    telemetry.rollRate = THREE.MathUtils.clamp(this.rollVelocity / profile.rollSpeed, -1, 1);\\n    telemetry.aimNormalizedX = THREE.MathUtils.clamp(-this.yawVelocity / profile.yawSpeed, -1, 1);\\n    telemetry.aimNormalizedY = THREE.MathUtils.clamp(-this.pitchVelocity / profile.pitchSpeed, -1, 1);\\n    telemetry.headingDeg = headingDeg;\", \"TargetFile\":\"/src/engine/FlightController.ts\", \"toolAction\":\"Writing persistent cursor coordinates to telemetry\", \"toolSummary\":\"Update FlightController telemetry\", \"waitForPreviousTools\":true}"
