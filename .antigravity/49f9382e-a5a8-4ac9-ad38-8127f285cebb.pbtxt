    tool_calls {
      id: "call_7988960853718431360"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import type * as THREE from \'three\';\\nimport type { BotPersonality, ShipId } from \'./game\';\\n\\nexport type EntityId = string;\\n\\nexport type Faction = \'player\' | \'enemy\' | \'neutral\';\\n\\nexport type BotAIState =\\n  | \'patrol\'\\n  | \'acquire\'\\n  | \'pursue\'\\n  | \'engage\'\\n  | \'evade\'\\n  | \'reposition\'\\n  | \'destroyed\';\\n\\nexport interface WeaponConfig {\\n  id: string;\\n  name: string;\\n  /** Shots per second */\\n  fireRate: number;\\n  /** Projectile velocity in m/s */\\n  projectileSpeed: number;\\n  /** Hull damage per hit */\\n  damage: number;\\n  /** Maximum travel lifetime in seconds */\\n  lifetime: number;\\n  /** Projectile collision radius in meters */\\n  hitRadius: number;\\n  /** Default convergence distance along aim ray in meters */\\n  convergenceDistance: number;\\n  /** Angular spread in radians (0 = pinpoint) */\\n  spreadRad: number;\\n  /** Local-space hardpoint offsets [x, y, z] relative to ship root */\\n  muzzleOffsets: Array<[number, number, number]>;\\n  /** Visual bolt dimensions */\\n  boltLength: number;\\n  boltRadius: number;\\n  color: string;\\n  coreColor: string;\\n}\\n\\nexport interface HealthState {\\n  current: number;\\n  max: number;\\n  isDestroyed: boolean;\\n  lastHitTime: number;\\n  lastAttackerId: EntityId | null;\\n}\\n\\nexport interface ProjectileState {\\n  id: number;\\n  active: boolean;\\n  ownerId: EntityId;\\n  faction: Faction;\\n  weaponId: string;\\n  position: THREE.Vector3;\\n  prevPosition: THREE.Vector3;\\n  velocity: THREE.Vector3;\\n  direction: THREE.Vector3;\\n  damage: number;\\n  age: number;\\n  maxLifetime: number;\\n  hitRadius: number;\\n  boltLength: number;\\n  boltRadius: number;\\n  isPlayerOwned: boolean;\\n}\\n\\nexport interface BotPersonalityConfig {\\n  id: BotPersonality;\\n  label: string;\\n  description: string;\\n  /** Base preferred cruise speed in m/s */\\n  cruiseSpeed: number;\\n  /** Burst speed during pursuit/evade in m/s */\\n  boostSpeed: number;\\n  /** Maximum angular turn rate in rad/s */\\n  turnRate: number;\\n  /** Detection radius in meters */\\n  detectionRange: number;\\n  /** Distance where bot starts engaging with weapons */\\n  engageRange: number;\\n  /** Minimum distance before breaking off to reposition */\\n  minSafeDistance: number;\\n  /** Ideal combat standoff range */\\n  preferredRange: number;\\n  /** Lateral flank angle offset in radians (0 for direct aggressor) */\\n  flankAngleRad: number;\\n  /** Base accuracy dispersion in radians (lower = more accurate) */\\n  aimSpreadRad: number;\\n  /** Firing cadence multiplier relative to weapon base fireRate */\\n  fireCadenceScale: number;\\n  /** Delay before reacting to target state changes (seconds) */\\n  reactionTime: number;\\n  /** Probability/tendency to break into evasive maneuver on damage (0..1) */\\n  evadeResponsiveness: number;\\n  /** Duration of evasive jink in seconds */\\n  evadeDuration: number;\\n  /** Weapon config ID used by this personality */\\n  weaponId: string;\\n  /** Base hull integrity */\\n  maxHull: number;\\n}\\n\\nexport interface EnemyEntity {\\n  id: EntityId;\\n  callsign: string;\\n  shipId: ShipId;\\n  personality: BotPersonality;\\n  difficulty: number; // 1..5\\n  active: boolean;\\n  position: THREE.Vector3;\\n  quaternion: THREE.Quaternion;\\n  velocity: THREE.Vector3;\\n  visualBankAngle: number;\\n  collisionRadius: number;\\n  health: HealthState;\\n  aiState: BotAIState;\\n  aiStateTimer: number;\\n  reactionTimer: number;\\n  weaponCooldown: number;\\n  burstTimer: number;\\n  burstActive: boolean;\\n  muzzleIndex: number;\\n  patrolAnchor: THREE.Vector3;\\n  patrolAngle: number;\\n  flankSign: 1 | -1;\\n  evadeDir: THREE.Vector3;\\n  repositionPoint: THREE.Vector3;\\n  hitFlashTimer: number;\\n  muzzleFlashTimer: number;\\n}\\n\\n/**\\n * Serializable combat event payloads structured for future host-authoritative multiplayer sync.\\n */\\nexport interface WeaponFireEvent {\\n  shooterId: EntityId;\\n  faction: Faction;\\n  weaponId: string;\\n  origin: THREE.Vector3;\\n  direction: THREE.Vector3;\\n  timestamp: number;\\n}\\n\\nexport interface DamageEvent {\\n  targetId: EntityId;\\n  attackerId: EntityId;\\n  weaponId: string;\\n  amount: number;\\n  remainingHealth: number;\\n  maxHealth: number;\\n  destroyed: boolean;\\n  hitPoint: THREE.Vector3;\\n  timestamp: number;\\n}\\n\\nexport interface DestructionEvent {\\n  entityId: EntityId;\\n  faction: Faction;\\n  killerId: EntityId;\\n  position: THREE.Vector3;\\n  timestamp: number;\\n}\\n\\nexport interface CombatStats {\\n  kills: number;\\n  shotsFired: number;\\n  shotsHit: number;\\n  damageDealt: number;\\n  damageTaken: number;\\n  score: number;\\n  wave: number;\\n  activeEnemies: number;\\n}\\n\\n/**\\n * Pre-allocated screen-space projection record for zero-allocation HUD enemy brackets.\\n */\\nexport interface ProjectedEnemyMarker {\\n  active: boolean;\\n  entityId: EntityId;\\n  callsign: string;\\n  personalityLabel: string;\\n  aiState: BotAIState;\\n  /** Normalized viewport coords [0..1] */\\n  screenX: number;\\n  screenY: number;\\n  /** Whether inside camera frustum in front of viewer */\\n  inFront: boolean;\\n  onScreen: boolean;\\n  distance: number;\\n  healthRatio: number;\\n  isPrimaryTarget: boolean;\\n  /** Screen-space lead pip [0..1] for primary target */\\n  leadX: number;\\n  leadY: number;\\n  leadVisible: boolean;\\n}\\n\", \"Description\":\"Define multiplayer-ready TypeScript interfaces for weapons, projectiles, health, damage events, bot AI personalities, and HUD target projections\", \"Overwrite\":true, \"TargetFile\":\"/src/types/combat.ts\", \"toolAction\":\"Creating combat type definitions\", \"toolSummary\":\"Create src/types/combat.ts\"}"
