              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          t.status === \'BOOSTING\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ? \'#67e8f9\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            : t.status === \'BOOST DEPLETED\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              ? \'#f59e0b\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              : t.status === \'REVERSING\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                ? \'#fbbf24\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                : \'#94a3b8\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (headingRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        headingRef.current.textContent = `${String(Math.round(t.headingDeg)).padStart(3, \'0\')}\302\260`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (pitchRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const p = Math.round(t.pitchDeg);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        pitchRef.current.textContent = `${p >= 0 ? \'+\' : \'\'}${p}\302\260`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (rollRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const r = Math.round(t.rollDeg);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        rollRef.current.textContent = `${r >= 0 ? \'+\' : \'\'}${r}\302\260`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (hullNumRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const hullPct = Math.round((t.hull / Math.max(t.maxHull, 1)) * 100);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        hullNumRef.current.textContent = `${hullPct}%`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (hullBarRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const ratio = Math.max(0, Math.min(1, t.hull / Math.max(t.maxHull, 1)));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        hullBarRef.current.style.transform = `scaleX(${ratio})`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (boostNumRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        boostNumRef.current.textContent = `${Math.round(t.boostEnergy)}%`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (boostBarRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const bRatio = Math.max(0, Math.min(1, t.boostEnergy / Math.max(t.maxBoostEnergy, 1)));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        boostBarRef.current.style.transform = `scaleX(${bRatio})`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        boostBarRef.current.style.backgroundColor = t.boostDepleted"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ? \'#f59e0b\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          : t.isBoosting"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ? \'#a5f3fc\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            : \'#22d3ee\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (boostLabelRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        boostLabelRef.current.textContent = t.boostDepleted"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ? \'Recharging\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          : t.isBoosting"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ? \'Afterburner Active\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            : \'Boost Energy\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Subtle dynamic turn-lead reticle offset"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (reticleDynamicRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const leadX = -t.yawRate * 26;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const leadY = -t.pitchRate * 20;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const bankDeg = t.rollRate * 14;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        reticleDynamicRef.current.style.transform = `translate3d(${leadX.toFixed(1)}px, ${leadY.toFixed(1)}px, 0) rotate(${bankDeg.toFixed(1)}deg)`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (reticleBoostRingRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const scale = 1 + t.boostIntensity * 0.28;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        reticleBoostRingRef.current.style.transform = `scale(${scale.toFixed(3)})`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        reticleBoostRingRef.current.style.opacity = String((0.18 + t.boostIntensity * 0.62).toFixed(2));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (perfTextRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        perfTextRef.current.textContent = `${t.fps} FPS \302\267 ${t.frameTimeMs.toFixed(1)} ms \302\267 ${t.drawCalls} draws \302\267 ${(t.triangles / 1000).toFixed(1)}k tris`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      rafId = window.requestAnimationFrame(syncHud);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    rafId = window.requestAnimationFrame(syncHud);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return () => window.cancelAnimationFrame(rafId);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }, [ship.flight.boostMultiplier, telemetryRef]);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
