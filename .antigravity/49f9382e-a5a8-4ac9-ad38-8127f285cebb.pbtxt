            }
            lines {
              text: "    settings: GameSettings,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    telemetry: FlightTelemetry,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  ): void {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const profile = this.ship.flight;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // 1. Unbounded Continuous Relative Mouse Turning (Zero Clamp, Zero Auto-Recenter Snap-Back)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const sens = settings.mouseSensitivity;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const radPerPx = 0.00235 * sens;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const ySign = settings.invertY ? 1 : -1;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const shapedDx = shapeRelativeMouseDelta(input.mouseDeltaX);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const shapedDy = shapeRelativeMouseDelta(input.mouseDeltaY);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // Accumulate raw relative turn radians directly \342\200\224 never clamped to a screen box!"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    this.pendingYawRad += -shapedDx * radPerPx;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    this.pendingPitchRad += shapedDy * radPerPx * ySign;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // Optional arrow-key steering adds smoothly to the same unbounded angular accumulator"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    if (input.keyYawLeft) this.pendingYawRad += profile.yawSpeed * 0.85 * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    if (input.keyYawRight) this.pendingYawRad -= profile.yawSpeed * 0.85 * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    if (input.keyPitchUp) this.pendingPitchRad += profile.pitchSpeed * 0.85 * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    if (input.keyPitchDown) this.pendingPitchRad -= profile.pitchSpeed * 0.85 * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // Critically damped high-responsiveness integration consumes pending turn smoothly"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // while preserving 100% of total cumulative mouse rotation with zero snap-back."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const responseRate = 24.0;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const consumeFraction = 1 - Math.exp(-responseRate * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const stepYaw = this.pendingYawRad * consumeFraction;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const stepPitch = this.pendingPitchRad * consumeFraction;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    this.pendingYawRad -= stepYaw;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    this.pendingPitchRad -= stepPitch;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // Clean epsilon flush only when completely idle"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    if (Math.abs(this.pendingYawRad) < 1e-6) this.pendingYawRad = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    if (Math.abs(this.pendingPitchRad) < 1e-6) this.pendingPitchRad = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // Track instantaneous smoothed angular velocity for camera turn lag & visual ship banking"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const instYawVel = stepYaw / safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const instPitchVel = stepPitch / safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const rateAlpha = 1 - Math.exp(-12.0 * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    this.yawVelocity = THREE.MathUtils.lerp("
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      this.yawVelocity,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      THREE.MathUtils.clamp(instYawVel, -profile.yawSpeed * 2.2, profile.yawSpeed * 2.2),"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      rateAlpha,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    );"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    this.pitchVelocity = THREE.MathUtils.lerp("
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      this.pitchVelocity,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      THREE.MathUtils.clamp(instPitchVel, -profile.pitchSpeed * 2.2, profile.pitchSpeed * 2.2),"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      rateAlpha,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    );"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // 1. Persistent Virtual-Cursor Mouse Steering (Stays at Edge, Zero Auto-Recenter, Zero Rollback)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const cursorScale = (1 / CURSOR_PIXELS_TO_EDGE) * settings.mouseSensitivity;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const ySign = settings.invertY ? -1 : 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (input.mouseDeltaX !== 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.aimCursorX = THREE.MathUtils.clamp("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        this.aimCursorX + input.mouseDeltaX * cursorScale,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        -CURSOR_EDGE_X,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        CURSOR_EDGE_X,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (input.mouseDeltaY !== 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.aimCursorY = THREE.MathUtils.clamp("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        this.aimCursorY + input.mouseDeltaY * cursorScale * ySign,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        -CURSOR_EDGE_Y,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        CURSOR_EDGE_Y,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Radial deflection with tiny precision center deadzone and smooth nonlinear curve:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // - Small deflections near center yield fine, precise micro-turns."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // - Holding the cursor at any screen edge sustains full continuous yaw/pitch rotation indefinitely."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const cursorMag = Math.hypot(this.aimCursorX, this.aimCursorY);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let steerX = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let steerY = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (cursorMag > CURSOR_DEADZONE) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const normalized = Math.min(1, (cursorMag - CURSOR_DEADZONE) / (CURSOR_EDGE_X - CURSOR_DEADZONE));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const curved = normalized * (0.35 + 0.65 * normalized);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      steerX = (this.aimCursorX / cursorMag) * curved;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      steerY = (this.aimCursorY / cursorMag) * curved;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Optional arrow-key steering blends smoothly alongside mouse steering"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let keyYaw = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (input.keyYawLeft) keyYaw += 0.85;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (input.keyYawRight) keyYaw -= 0.85;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let keyPitch = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (input.keyPitchUp) keyPitch += 0.85;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (input.keyPitchDown) keyPitch -= 0.85;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const targetYawRate = THREE.MathUtils.clamp(-steerX + keyYaw, -1.15, 1.15) * profile.yawSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const targetPitchRate = THREE.MathUtils.clamp(-steerY + keyPitch, -1.15, 1.15) * profile.pitchSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const turnAlpha = 1 - Math.exp(-(profile.angularDamping * 1.45) * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.yawVelocity = THREE.MathUtils.lerp(this.yawVelocity, targetYawRate, turnAlpha);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.pitchVelocity = THREE.MathUtils.lerp(this.pitchVelocity, targetPitchRate, turnAlpha);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const stepYaw = this.yawVelocity * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const stepPitch = this.pitchVelocity * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // 2. Independent Roll via A / D (exact Phase 1/2 roll feel preserved)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    let rollDir = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (input.rollLeft) rollDir += 1;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (input.rollRight) rollDir -= 1;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const targetRollRate = rollDir * profile.rollSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const rollAlpha = 1 - Math.exp(-(profile.angularDamping * 1.25) * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    this.rollVelocity = THREE.MathUtils.lerp(this.rollVelocity, targetRollRate, rollAlpha);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const stepRoll = this.rollVelocity * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // 3. Apply Pure Local-Space Quaternion Rotations (Zero Gimbal Lock at any pitch/yaw!)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    _qYaw.setFromAxisAngle(_AXIS_Y, stepYaw);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    _qPitch.setFromAxisAngle(_AXIS_X, stepPitch);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    _qRoll.setFromAxisAngle(_AXIS_Z, stepRoll);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    this.quaternion.multiply(_qYaw);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    this.quaternion.multiply(_qPitch);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    this.quaternion.multiply(_qRoll);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    this.quaternion.normalize();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // Subtle visual bank when yawing without overriding deliberate A/D roll"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const targetBank = THREE.MathUtils.clamp("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      (this.yawVelocity / profile.yawSpeed) * profile.visualBankStrength,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      -0.44,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      0.44,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    );"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    this.visualBankAngle = THREE.MathUtils.damp(this.visualBankAngle, targetBank, 6.5, safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // 4. Boost energy management (unchanged from Phase 1/2)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (this.boostLockedOut && this.boostEnergy >= 18) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      this.boostLockedOut = false;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const wantsBoost = input.boost && !input.backward && !this.boostLockedOut && this.boostEnergy > 0.5;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const isBoosting = wantsBoost;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    this.boostJustEngaged = isBoosting && !this.wasBoosting;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    this.wasBoosting = isBoosting;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (isBoosting) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      this.boostEnergy = Math.max(0, this.boostEnergy - profile.boostDrainRate * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      this.boostCooldownTimer = profile.boostRegenDelay;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (this.boostEnergy <= 0.1) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        this.boostEnergy = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        this.boostLockedOut = true;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    } else {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (this.boostCooldownTimer > 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        this.boostCooldownTimer = Math.max(0, this.boostCooldownTimer - safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      } else if (this.boostEnergy < profile.maxBoostEnergy) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        this.boostEnergy = Math.min("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          profile.maxBoostEnergy,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          this.boostEnergy + profile.boostRegenRate * safeDt,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        );"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    this.boostIntensity = THREE.MathUtils.damp("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      this.boostIntensity,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      isBoosting ? 1 : 0,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      isBoosting ? 9.0 : 5.5,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      safeDt,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    );"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // 5. Linear thrust, controlled arcade inertia, and lateral redirection (unchanged from Phase 1/2)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    _forwardWorld.copy(_FORWARD_LOCAL).applyQuaternion(this.quaternion).normalize();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    _rightWorld.copy(_AXIS_X).applyQuaternion(this.quaternion).normalize();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    _upWorld.copy(_AXIS_Y).applyQuaternion(this.quaternion).normalize();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const currentForwardSpeed = this.velocity.dot(_forwardWorld);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const effectiveMaxSpeed = isBoosting"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      ? profile.maxSpeed * profile.boostMultiplier"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      : profile.maxSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    let nextForwardSpeed = currentForwardSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    let throttle = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
