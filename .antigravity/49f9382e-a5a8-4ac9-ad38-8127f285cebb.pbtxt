            }
            lines {
              text: "      const markers = t.enemyMarkers;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      for (let i = 0; i < MARKER_INDICES.length; i++) {"
