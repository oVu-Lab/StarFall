    tool_calls {
      id: "call_11226406490604918053"
      name: "run_command"
      arguments_json: "{\"CommandLine\":\"npx tsx -e \'\\nimport * as THREE from \\\"three\\\";\\nimport { FlightController, VIRTUAL_AIM_CONFIG } from \\\"./src/engine/FlightController\\\";\\nimport { SHIP_CONFIGS } from \\\"./src/config/ships\\\";\\nimport { InputSnapshot } from \\\"./src/engine/InputManager\\\";\\n\\nfunction makeInput(overrides: Partial<InputSnapshot> = {}): InputSnapshot {\\n  return {\\n    throttleForward: false,\\n    throttleBackward: false,\\n    strafeLeft: false,\\n    strafeRight: false,\\n    strafeUp: false,\\n    strafeDown: false,\\n    rollLeft: false,\\n    rollRight: false,\\n    boost: false,\\n    brake: false,\\n    firePrimary: false,\\n    fireSecondary: false,\\n    mouseDeltaX: 0,\\n    mouseDeltaY: 0,\\n    pointerLocked: true,\\n    ...overrides,\\n  };\\n}\\n\\nfunction runFixedRate(hz: number): { yawDeg: number; aimX: number; aimScreenX: number } {\\n  const fc = new FlightController(SHIP_CONFIGS.interceptor);\\n  const dt = 1 / hz;\\n  // Move 105px right on frame 1 (50% of boundary), then hold stationary for 1.0s\\n  for (let i = 0; i < hz; i++) {\\n    fc.update(dt, makeInput({ mouseDeltaX: i === 0 ? 105 : 0 }), 1.0, false);\\n  }\\n  const euler = new THREE.Euler().setFromQuaternion(fc.quaternion, \\\"YXZ\\\");\\n  return {\\n    yawDeg: THREE.MathUtils.radToDeg(euler.y),\\n    aimX: fc.aimCursorX,\\n    aimScreenX: fc.telemetry.aimScreenX,\\n  };\\n}\\n\\nconst r30 = runFixedRate(30);\\nconst r60 = runFixedRate(60);\\nconst r120 = runFixedRate(120);\\nconsole.log(\\\"FPS Independence (105px right held 1.0s):\\\", { r30, r60, r120 });\\nconsole.log(\\\"Max yaw variance (deg):\\\", Math.max(Math.abs(r30.yawDeg - r60.yawDeg), Math.abs(r120.yawDeg - r60.yawDeg)).toFixed(3));\\n\\n// Test boundary clamp & zero dead-travel reversal & diagonal ellipse clamp\\nconst fc = new FlightController(SHIP_CONFIGS.interceptor);\\nfc.update(1 / 60, makeInput({ mouseDeltaX: 1000 }), 1.0, false);\\nconst atRightEdge = { aimX: fc.aimCursorX, aimY: fc.aimCursorY, sx: fc.telemetry.aimScreenX, sy: fc.telemetry.aimScreenY };\\n// Pull back 10px immediately\\nfc.update(1 / 60, makeInput({ mouseDeltaX: -10 }), 1.0, false);\\nconst afterReverse10px = { aimX: fc.aimCursorX, aimY: fc.aimCursorY, sx: fc.telemetry.aimScreenX };\\n\\n// Push strongly diagonal (+500, -500)\\nfc.reset();\\nfc.update(1 / 60, makeInput({ mouseDeltaX: 500, mouseDeltaY: -500 }), 1.0, false);\\nconst diagRadius = Math.hypot(fc.aimCursorX, fc.aimCursorY);\\nconst diagScreen = { sx: fc.telemetry.aimScreenX, sy: fc.telemetry.aimScreenY };\\nconst ellipseCheck = ((diagScreen.sx - 0.5) / VIRTUAL_AIM_CONFIG.maxScreenOffsetX) ** 2 + ((diagScreen.sy - 0.5) / VIRTUAL_AIM_CONFIG.maxScreenOffsetY) ** 2;\\n\\n// Test boost\\nfc.reset();\\nfor (let i = 0; i < 60; i++) {\\n  fc.update(1 / 60, makeInput({ throttleForward: true, boost: true }), 1.0, false);\\n}\\nconst boostTelemetry = {\\n  speed: Number(fc.telemetry.speed.toFixed(1)),\\n  boostEnergy: Number(fc.telemetry.boostEnergy.toFixed(1)),\\n  status: fc.telemetry.status,\\n};\\n\\nconsole.log(\\\"Right edge clamp:\\\", atRightEdge);\\nconsole.log(\\\"After -10px reverse:\\\", afterReverse10px);\\nconsole.log(\\\"Diagonal radius:\\\", diagRadius.toFixed(6), \\\"screen:\\\", diagScreen, \\\"ellipseEq:\\\", ellipseCheck.toFixed(6));\\nconsole.log(\\\"Boost 1.0s:\\\", boostTelemetry);\\n\'\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Running flight controller unit checks\", \"toolSummary\":\"Flight controller unit verification\"}"
      original_name: "run_command"
    }
