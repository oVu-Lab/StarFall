  code_action {
    action_spec {
      create_file {
        instruction: "import type { BotPersonalityConfig } from \'../types/combat\';\nimport type { BotPersonality } from \'../types/game\';\n\nexport const BOT_PERSONALITIES: Record<BotPersonality, BotPersonalityConfig> = {\n  aggressor: {\n    id: \'aggressor\',\n    label: \'Aggressor\',\n    description: \'Closes distance quickly and maintains steady frontal offensive pressure.\',\n    cruiseSpeed: 74,\n    boostSpeed: 108,\n    turnRate: 1.55,\n    detectionRange: 620,\n    engageRange: 270,\n    minSafeDistance: 58,\n    preferredRange: 145,\n    flankAngleRad: 0.12,\n    aimSpreadRad: 0.048,\n    fireCadenceScale: 1.0,\n    reactionTime: 0.42,\n    evadeResponsiveness: 0.48,\n    evadeDuration: 1.4,\n    weaponId: \'enemy_pulse_aggressor\',\n    maxHull: 80,\n  },\n  flanker: {\n    id: \'flanker\',\n    label: \'Flanker\',\n    description: \'Carves wide lateral approach arcs to strike from oblique angles.\',\n    cruiseSpeed: 82,\n    boostSpeed: 116,\n    turnRate: 1.85,\n    detectionRange: 640,\n    engageRange: 250,\n    minSafeDistance: 64,\n    preferredRange: 135,\n    flankAngleRad: 0.92,\n    aimSpreadRad: 0.052,\n    fireCadenceScale: 0.92,\n    reactionTime: 0.34,\n    evadeResponsiveness: 0.72,\n    evadeDuration: 1.65,\n    weaponId: \'enemy_pulse_flanker\',\n    maxHull: 70,\n  },\n  defender: {\n    id: \'defender\',\n    label: \'Defender\',\n    description: \'Holds disciplined standoff range and breaks off aggressively under fire.\',\n    cruiseSpeed: 64,\n    boostSpeed: 94,\n    turnRate: 1.35,\n    detectionRange: 660,\n    engageRange: 310,\n    minSafeDistance: 105,\n    preferredRange: 215,\n    flankAngleRad: 0.55,\n    aimSpreadRad: 0.04,\n    fireCadenceScale: 0.85,\n    reactionTime: 0.45,\n    evadeResponsiveness: 0.82,\n    evadeDuration: 1.85,\n    weaponId: \'enemy_pulse_defender\',\n    maxHull: 105,\n  },\n  ace: {\n    id: \'ace\',\n    label: \'Ace\',\n    description: \'Elite dogfighter with tight reactions, smart evasion, and sharp lead accuracy.\',\n    cruiseSpeed: 88,\n    boostSpeed: 126,\n    turnRate: 2.1,\n    detectionRange: 720,\n    engageRange: 290,\n    minSafeDistance: 62,\n    preferredRange: 155,\n    flankAngleRad: 0.65,\n    aimSpreadRad: 0.026,\n    fireCadenceScale: 1.15,\n    reactionTime: 0.2,\n    evadeResponsiveness: 0.92,\n    evadeDuration: 1.5,\n    weaponId: \'enemy_pulse_ace\',\n    maxHull: 95,\n  },\n};\n\nexport interface ScaledBotTuning {\n  cruiseSpeed: number;\n  boostSpeed: number;\n  turnRate: number;\n  aimSpreadRad: number;\n  fireCadenceScale: number;\n  reactionTime: number;\n  evadeResponsiveness: number;\n}\n\n/**\n * Scales bot tactical performance cleanly by difficulty (1..5)\n * without giving enemies unfair bullet-sponge health or arbitrary damage multipliers.\n */\nexport function resolveBotDifficultyTuning(\n  personality: BotPersonalityConfig,\n  difficulty: number,\n): ScaledBotTuning {\n  const d = Math.max(1, Math.min(5, difficulty)) - 1; // 0..4\n  return {\n    cruiseSpeed: personality.cruiseSpeed * (1 + d * 0.05),\n    boostSpeed: personality.boostSpeed * (1 + d * 0.05),\n    turnRate: personality.turnRate * (1 + d * 0.07),\n    aimSpreadRad: personality.aimSpreadRad * Math.max(0.45, 1 - d * 0.13),\n    fireCadenceScale: personality.fireCadenceScale * (1 + d * 0.08),\n    reactionTime: Math.max(0.12, personality.reactionTime * (1 - d * 0.14)),\n    evadeResponsiveness: Math.min(0.96, personality.evadeResponsiveness + d * 0.07),\n  };\n}\n"
        path {
          absolute_uri: "file:///src/config/botPersonalities.ts"
        }
        overwrite: true
      }
    }
