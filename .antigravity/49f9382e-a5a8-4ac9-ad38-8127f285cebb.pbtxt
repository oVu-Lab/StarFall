      thinking_signature: "\022\323\f\n\320\f\001i\024}\023y\335\272\375\3411C\037\276\005kT\311\243\201\311\000\035\325\021v\2463\020\247\332\321l+n\266\217\250 9\205\312\217\005\273(\346G\306\b\334\343H\265\241\324\214MaV\276\206NH\272\263\205I\324\370\315\372N,\267\373S\372\333\343\275}\304\376\351\346\214\346\224\320\t\345\\f\314\330\347o\343@SK\326\232\265\\A\264}\322,=\2125\244\350L\315\344*2\260k\332\333x\345\024!\373\002\000\215\372\243\001\033\005\230\301\3423\177\2202!\t\'\342\226\206V\277\313\'\027\3173\031~D\204x\217\340\242\372\215\022X\306}\324%\321\315\377\001\020\300\202\025\273\341\245S\004\315\356\313\367\"\233\312\306\321\336\321\217+\324\245\t\374f\242W\3609W\204\334%g].\251\322{6Yv\254Abzv\231\265\222>k\303C\223\016s\363\342W\275\317\346B\326\326\362.\345Nf\233u\261\336\022\203\237c5N\304\256\332\000\023\200|\361\025\363\272b7\331\315\000\321\025\333\n\261\214\260\0173+b\002\303H\213wN\264W\221\214S8wm\332\000\001\254\213\252\211\254M\264\031w\272\336\256xV\260p\rt\v&\032u\2405\321\276\212\214\213\2273\307\274\200t\374\342\305x\314C\226\213Wl1Z\201\334\334?&\376\343\024\261\362\206\374\274\337\355a\037c\253\315\377\035\025\275\314xG\232$NEz\242\000\250\277\376\211Y\336\026vJ\267\261i\217\3431\2259\311\324Ohv\351\327\0048\262\024\fDb\313\323\253r\016\231Y\t=\340\322\326,\n\037\242\363\367\374\366\266\237\031A\251\021<\303\376\t1\243\273l\364\237tO\363\246T\277U\326\270}\267l\231+\243+\323\337\272\036|\366 \301\366\234[\222\271\253\224.V\bv\241\226NsvU?p\333\213\260\0218\304\237]G\216\335$m|\004Q\352U\3031\r\347\314\375S\035\337#\374j\0202q]\3666~Ei\376\246\222\275\027\257\037\247\027RO+1\262\253{\307\276\215\355\317t\351\224\017\375oq\032hQIM\230\275F\247\266-\304\213ZAc\330#\372f\316\342py\303\370!\275*9\376\001:z\314`.\362\340\032\313\317\227@A\247\201\r\303\215\347K\240\362V\311[5\306\372S\006\310\327\002\242\002\256\265\301e\365z\352\272\003)\211\233\337\355T\351\325a\323\301n\207\242\305HS\au\fCV5%\334\252\230\f\3350L4Q\312a\333\266\n\336\315c\344aw\221\322\'\211\345z\203\225\237\243\306\347\203\320\304\n\311\242\312\005P\356\033\320\211\205\230\331\227~\340\373\263\263\033\233\241\240\n5\222~\221\240\376\200\035\354\241.e,\373k\365\017\036la\371\277\021\237 \033-Ti\337\365Y.XZ\004o\034x\035]\343\370\203\243%\032\211OR\344\026\301\000E\345$\343\347\'\246\266\026\310jV\270\343%\356\356\006:\224\203\'?\224\221\315z\322\325\035\312\225^9\272{88\270\367\231\254u\340\245\254\251\301\033\347\304\020*/\r\220\344g\v\316\345>\202\200w\256\242B\ru\231\032\3666\331y\025\215\254R\374uw\276\236\\\342\nlb\222\375\006\321\206a\2341\3478\224\324\037J\003\357\301\303F=\360\336\233\206\a\v\'\002s\316\aG\362\225C\225\304\317\036\315\266d\021\355\320\201\002\261OZ\226\221\224\207*.R\210H\352\200\216\235=\353\002\001\246\030\364\242\027\212\272\375\266l\305\301Uv\262\267\313\006\356E)\372\312\226Sk8,\300\027\217\330\260/\204j`\240W(FN\365\220\247\020/\326\266\356\225k_Z\b\247J\\\020s\337\332\206\2217\320[\243\275I\357qPN\340n\241\264C\323\311\277\303\001\026\322\260\225\305\025j\350\251\f\377pO\361dS\327{\242v\322\371\0209\362\301EkOa\005\210O\243\254k\374m\327I\327\250\0167Z\016~c\230hi\222\353#\211g\220\330v\213[\301\333\257w\273g\244k\232\267\326\b0W\034\210c\301L\237\351\320\271\343k\206\016\311\304!\020-\232!\001\337S5\357\227WY\214\341\361\360@\025\"\266^\244\317\323s\367\275\b\263s\t\'m\314\273\231\351MlHF\346\203\261(\220\3139)\2661\305\025\242\340\201]\226b\375\031\f\000HU\200\270\356\0018\246h\\\376T\031L\331\274sW\256\310]\324\035oz\020\221o\201\240\270E\205\231T\345\241\350~E8\201\263\'\247\033!\034@AQ:\223\374bH\316\205\033\017\375\332\\\217\026\3174\2244\226\275\0018,\333\216\327\022\203\361<\025+y\371\304\375>n\352}N\376\342\301\252nM\0244\262\033\374\037\0260\266\252\035_R\200\250\355^\b\301t\266t\016\227\332a\2344\303\244\232\327\322\326\225\026\366j:#\372#\345\006\213\200p\rW\313s\227\002\270\254\3408\245\315\207\223W|\350\027\263\376Y\177\303\237b\3666\b\037 \271\225\332\033\253\035\364\213\343\321`\v\361H7\360`\004\032\335\211(t\023\017\262<\257C\320{\t\256\'\2036\353\210va\252\020\201\247}\266V\035\352h\000\316Yr\023\340\304@8?<@%\234\263\351\006\306\366\224X\003\342c\231eW\273\373\021\352\262\264:](\362\022\300\317]<\202\254\344Q\376i\370\307\337\026\341\306\203\275\301\337\323\353\337\031\017\0216\254\266F\364\316_4\aR\237D\355\320z\352h\337\025|\253\037\030\251U\0031\333\366\200\355\016\311C\265\353\267\207\326\354y\334\207r\361X\231\346d\341D\347b\024R\305\300>Pk\242\a\325\266\342\256X\371\034,\233\324\035\000\233\0024\v\035\346\376\272j\240\'\311\235s\252B$\236\330m\036\321\242\271~\373\272zG\254\235[\'\003-\244dY\200{\322\247i\270\223#\207:\330\263\031\350\375\t\362\262\267\375\262\306\001\355\3631\304\304\313\023{\344\240\263U~\202\201[W$\255\312\215"
