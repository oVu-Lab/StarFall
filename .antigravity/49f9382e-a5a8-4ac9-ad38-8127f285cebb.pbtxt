            }
            lines {
              text: "      mix("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        mix(hash(i + vec3(0,0,1)), hash(i + vec3(1,0,1)), f.x),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        mix(hash(i + vec3(0,1,1)), hash(i + vec3(1,1,1)), f.x),"
