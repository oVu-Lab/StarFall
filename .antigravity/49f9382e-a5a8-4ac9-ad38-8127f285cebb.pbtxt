  planner_response {
    thinking: "**Refining UI Design**\n\nI\'m now fully focused on the User Interface and Heads-Up Display components. My primary goal is visual discipline, so I\'m paying very close attention to design guidelines. I\'ve decided to avoid `backdrop-filter` or `backdrop-blur` effects over WebGL, opting instead for crisp, dark navy translucent overlays using `rgba(4, 10, 24, 0.78)`.\n\n\n**Optimizing Display Mechanics**\n\nI\'m now implementing subtle cyan hairline borders for smooth WebGL rendering, ensuring WCAG AA+ contrast. I\'m avoiding decorative elements like pulsing dots or pill boxes. Clear, concise labels are replacing jargon. I\'ve eliminated per-frame React updates for the HUD, opting for DOM refs and `requestAnimationFrame`. The **Hangar** is now interactive, allowing 3D ship inspection with spec comparisons and clear labeling of available ships.\n\n\n"
    message_id: "5gX_asGYC5ymkdUPzKrIiAI"
    tool_calls {
      id: "call_11084776239918782756"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useEffect, useRef } from \'react\';\\nimport { ChevronDown, ChevronUp, Pause } from \'lucide-react\';\\nimport { SHIP_CONFIGS } from \'../config/ships\';\\nimport type { FlightTelemetry, GameSettings, ShipId } from \'../types/game\';\\n\\ninterface FlightHUDProps {\\n  shipId: ShipId;\\n  telemetryRef: React.MutableRefObject<FlightTelemetry>;\\n  settings: GameSettings;\\n  pointerLocked: boolean;\\n  hintsVisible: boolean;\\n  onToggleHints: () => void;\\n  onRequestLock: () => void;\\n  onPause: () => void;\\n}\\n\\n/**\\n * Minimal, razor-sharp futuristic flight HUD.\\n * Reads live FlightTelemetry directly via a requestAnimationFrame DOM-ref loop\\n * so 60 FPS telemetry updates trigger ZERO React re-renders.\\n */\\nexport function FlightHUD({\\n  shipId,\\n  telemetryRef,\\n  settings,\\n  pointerLocked,\\n  hintsVisible,\\n  onToggleHints,\\n  onRequestLock,\\n  onPause,\\n}: FlightHUDProps) {\\n  const ship = SHIP_CONFIGS[shipId];\\n\\n  const speedNumRef = useRef<HTMLSpanElement>(null);\\n  const speedBarRef = useRef<HTMLDivElement>(null);\\n  const statusTextRef = useRef<HTMLSpanElement>(null);\\n  const headingRef = useRef<HTMLSpanElement>(null);\\n  const pitchRef = useRef<HTMLSpanElement>(null);\\n  const rollRef = useRef<HTMLSpanElement>(null);\\n  const hullNumRef = useRef<HTMLSpanElement>(null);\\n  const hullBarRef = useRef<HTMLDivElement>(null);\\n  const boostNumRef = useRef<HTMLSpanElement>(null);\\n  const boostBarRef = useRef<HTMLDivElement>(null);\\n  const boostLabelRef = useRef<HTMLSpanElement>(null);\\n  const reticleDynamicRef = useRef<HTMLDivElement>(null);\\n  const reticleBoostRingRef = useRef<HTMLDivElement>(null);\\n  const perfTextRef = useRef<HTMLDivElement>(null);\\n\\n  useEffect(() => {\\n    let rafId = 0;\\n\\n    const syncHud = () => {\\n      const t = telemetryRef.current;\\n\\n      if (speedNumRef.current) {\\n        const displaySpeed = Math.round(t.signedSpeed);\\n        speedNumRef.current.textContent = String(displaySpeed);\\n        speedNumRef.current.style.color = t.isBoosting\\n          ? \'#67e8f9\'\\n          : t.signedSpeed < -2\\n            ? \'#fbbf24\'\\n            : \'#f8fafc\';\\n      }\\n\\n      if (speedBarRef.current) {\\n        const maxBoosted = t.maxSpeed * ship.flight.boostMultiplier;\\n        const pct = Math.min(100, (t.speed / Math.max(maxBoosted, 1)) * 100);\\n        speedBarRef.current.style.transform = `scaleX(${pct / 100})`;\\n        speedBarRef.current.style.backgroundColor = t.isBoosting ? \'#67e8f9\' : \'#06b6d4\';\\n      }\\n\\n      if (statusTextRef.current) {\\n        statusTextRef.current.textContent = t.status;\\n        statusTextRef.current.style.color =\\n          t.status === \'BOOSTING\'\\n            ? \'#67e8f9\'\\n            : t.status === \'BOOST DEPLETED\'\\n              ? \'#f59e0b\'\\n              : t.status === \'REVERSING\'\\n                ? \'#fbbf24\'\\n                : \'#94a3b8\';\\n      }\\n\\n      if (headingRef.current) {\\n        headingRef.current.textContent = `${String(Math.round(t.headingDeg)).padStart(3, \'0\')}\302\260`;\\n      }\\n      if (pitchRef.current) {\\n        const p = Math.round(t.pitchDeg);\\n        pitchRef.current.textContent = `${p >= 0 ? \'+\' : \'\'}${p}\302\260`;\\n      }\\n      if (rollRef.current) {\\n        const r = Math.round(t.rollDeg);\\n        rollRef.current.textContent = `${r >= 0 ? \'+\' : \'\'}${r}\302\260`;\\n      }\\n\\n      if (hullNumRef.current) {\\n        const hullPct = Math.round((t.hull / Math.max(t.maxHull, 1)) * 100);\\n        hullNumRef.current.textContent = `${hullPct}%`;\\n      }\\n      if (hullBarRef.current) {\\n        const ratio = Math.max(0, Math.min(1, t.hull / Math.max(t.maxHull, 1)));\\n        hullBarRef.current.style.transform = `scaleX(${ratio})`;\\n      }\\n\\n      if (boostNumRef.current) {\\n        boostNumRef.current.textContent = `${Math.round(t.boostEnergy)}%`;\\n      }\\n      if (boostBarRef.current) {\\n        const bRatio = Math.max(0, Math.min(1, t.boostEnergy / Math.max(t.maxBoostEnergy, 1)));\\n        boostBarRef.current.style.transform = `scaleX(${bRatio})`;\\n        boostBarRef.current.style.backgroundColor = t.boostDepleted\\n          ? \'#f59e0b\'\\n          : t.isBoosting\\n            ? \'#a5f3fc\'\\n            : \'#22d3ee\';\\n      }\\n      if (boostLabelRef.current) {\\n        boostLabelRef.current.textContent = t.boostDepleted\\n          ? \'Recharging\'\\n          : t.isBoosting\\n            ? \'Afterburner Active\'\\n            : \'Boost Energy\';\\n      }\\n\\n      // Subtle dynamic turn-lead reticle offset\\n      if (reticleDynamicRef.current) {\\n        const leadX = -t.yawRate * 26;\\n        const leadY = -t.pitchRate * 20;\\n        const bankDeg = t.rollRate * 14;\\n        reticleDynamicRef.current.style.transform = `translate3d(${leadX.toFixed(1)}px, ${leadY.toFixed(1)}px, 0) rotate(${bankDeg.toFixed(1)}deg)`;\\n      }\\n\\n      if (reticleBoostRingRef.current) {\\n        const scale = 1 + t.boostIntensity * 0.28;\\n        reticleBoostRingRef.current.style.transform = `scale(${scale.toFixed(3)})`;\\n        reticleBoostRingRef.current.style.opacity = String((0.18 + t.boostIntensity * 0.62).toFixed(2));\\n      }\\n\\n      if (perfTextRef.current) {\\n        perfTextRef.current.textContent = `${t.fps} FPS \302\267 ${t.frameTimeMs.toFixed(1)} ms \302\267 ${t.drawCalls} draws \302\267 ${(t.triangles / 1000).toFixed(1)}k tris`;\\n      }\\n\\n      rafId = window.requestAnimationFrame(syncHud);\\n    };\\n\\n    rafId = window.requestAnimationFrame(syncHud);\\n    return () => window.cancelAnimationFrame(rafId);\\n  }, [ship.flight.boostMultiplier, telemetryRef]);\\n\\n  return (\\n    <div className=\\\"pointer-events-none fixed inset-0 z-20 flex flex-col justify-between p-5 sm:p-6\\\">\\n      {/* Top Bar: Minimal Heading Telemetry & Pause Button */}\\n      <div className=\\\"flex items-start justify-between\\\">\\n        <div className=\\\"border border-cyan-400/20 bg-[#040a18]/80 px-4 py-2\\\">\\n          <div className=\\\"flex items-center gap-4 font-mono text-xs tabular-nums text-slate-300\\\">\\n            <span>\\n              HDG <strong ref={headingRef} className=\\\"font-semibold text-cyan-300\\\">000\302\260</strong>\\n            </span>\\n            <span className=\\\"text-slate-600\\\" aria-hidden=\\\"true\\\">\302\267</span>\\n            <span>\\n              PITCH <strong ref={pitchRef} className=\\\"font-semibold text-slate-100\\\">+0\302\260</strong>\\n            </span>\\n            <span className=\\\"text-slate-600\\\" aria-hidden=\\\"true\\\">\302\267</span>\\n            <span>\\n              ROLL <strong ref={rollRef} className=\\\"font-semibold text-slate-100\\\">+0\302\260</strong>\\n            </span>\\n          </div>\\n          {settings.showPerfOverlay && (\\n            <div\\n              ref={perfTextRef}\\n              className=\\\"mt-1 border-t border-slate-800/80 pt-1 font-mono text-[11px] tabular-nums text-slate-400\\\"\\n            >\\n              60 FPS \302\267 16.6 ms\\n            </div>\\n          )}\\n        </div>\\n\\n        <button\\n          type=\\\"button\\\"\\n          onClick={onPause}\\n          className=\\\"pointer-events-auto flex items-center gap-2 border border-slate-700/80 bg-[#040a18]/80 px-3.5 py-2 text-xs font-medium text-slate-200 transition-colors hover:border-cyan-400/60 hover:text-cyan-200 focus-visible:outline-2 focus-visible:outline-cyan-400 whitespace-nowrap shrink-0\\\"\\n          aria-label=\\\"Pause Flight\\\"\\n        >\\n          <Pause className=\\\"h-3.5 w-3.5 text-cyan-400\\\" />\\n          <span>Pause</span>\\n          <span className=\\\"font-mono text-[11px] text-slate-400\\\">ESC</span>\\n        </button>\\n      </div>\\n\\n      {/* Center Precision Aiming Reticle */}\\n      <div className=\\\"pointer-events-none fixed inset-0 flex items-center justify-center\\\">\\n        <div className=\\\"relative flex items-center justify-center\\\">\\n          {/* Outer Boost Expansion Ring */}\\n          <div\\n            ref={reticleBoostRingRef}\\n            className=\\\"absolute h-20 w-20 rounded-full border border-cyan-300/60 opacity-20\\\"\\n            style={{ willChange: \'transform, opacity\' }}\\n          />\\n\\n          {/* Fixed Center Bore Sight */}\\n          <svg width=\\\"44\\\" height=\\\"44\\\" viewBox=\\\"0 0 44 44\\\" className=\\\"text-cyan-300/85\\\">\\n            <line x1=\\\"22\\\" y1=\\\"4\\\" x2=\\\"22\\\" y2=\\\"12\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.4\\\" />\\n            <line x1=\\\"22\\\" y1=\\\"32\\\" x2=\\\"22\\\" y2=\\\"40\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.4\\\" />\\n            <line x1=\\\"4\\\" y1=\\\"22\\\" x2=\\\"12\\\" y2=\\\"22\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.4\\\" />\\n            <line x1=\\\"32\\\" y1=\\\"22\\\" x2=\\\"40\\\" y2=\\\"22\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.4\\\" />\\n            <circle cx=\\\"22\\\" cy=\\\"22\\\" r=\\\"2\\\" fill=\\\"#e0f2fe\\\" />\\n          </svg>\\n\\n          {/* Dynamic Flight Vector / Turn-Lead Bracket */}\\n          <div\\n            ref={reticleDynamicRef}\\n            className=\\\"absolute flex items-center justify-center\\\"\\n            style={{ willChange: \'transform\' }}\\n          >\\n            <svg width=\\\"72\\\" height=\\\"72\\\" viewBox=\\\"0 0 72 72\\\" className=\\\"text-cyan-400/75\\\">\\n              <path d=\\\"M 14 24 L 10 24 L 10 48 L 14 48\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.5\\\" />\\n              <path d=\\\"M 58 24 L 62 24 L 62 48 L 58 48\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.5\\\" />\\n            </svg>\\n          </div>\\n        </div>\\n\\n        {/* Click-to-Lock Mouse Flight Notice (only shown when pointer lock is inactive) */}\\n        {!pointerLocked && (\\n          <div className=\\\"pointer-events-auto absolute top-[62%]\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onRequestLock}\\n              className=\\\"border border-cyan-400/50 bg-[#040a18]/90 px-5 py-2.5 text-xs font-medium tracking-wide text-cyan-200 transition-colors hover:border-cyan-300 hover:bg-[#081631] focus-visible:outline-2 focus-visible:outline-cyan-400\\\"\\n            >\\n              Click viewport to engage Mouse Steering (Pointer Lock)\\n            </button>\\n          </div>\\n        )}\\n      </div>\\n\\n      {/* Bottom Tactical Instrument Strip + Collapsible Control Hints */}\\n      <div className=\\\"flex flex-col items-center gap-2.5\\\">\\n        <div className=\\\"grid w-full max-w-4xl grid-cols-1 gap-3 sm:grid-cols-3\\\">\\n          {/* Left: Hull Integrity */}\\n          <div className=\\\"border border-slate-700/70 bg-[#040a18]/82 px-4 py-3\\\">\\n            <div className=\\\"flex items-baseline justify-between\\\">\\n              <span className=\\\"text-xs font-medium text-slate-400\\\">Hull Integrity</span>\\n              <span\\n                ref={hullNumRef}\\n                className=\\\"font-mono text-sm font-semibold tabular-nums text-slate-100\\\"\\n              >\\n                100%\\n              </span>\\n            </div>\\n            <div className=\\\"mt-2 h-1.5 w-full overflow-hidden bg-slate-800\\\">\\n              <div\\n                ref={hullBarRef}\\n                className=\\\"h-full w-full origin-left bg-sky-400\\\"\\n                style={{ transform: \'scaleX(1)\', willChange: \'transform\' }}\\n              />\\n            </div>\\n            <div className=\\\"mt-1.5 flex items-center justify-between text-[11px] text-slate-400\\\">\\n              <span>{ship.callsign}</span>\\n              <span>{ship.name}</span>\\n            </div>\\n          </div>\\n\\n          {/* Center: Boost Energy & Flight Status */}\\n          <div className=\\\"border border-cyan-500/30 bg-[#040a18]/82 px-4 py-3\\\">\\n            <div className=\\\"flex items-baseline justify-between\\\">\\n              <span ref={boostLabelRef} className=\\\"text-xs font-medium text-cyan-200\\\">\\n                Boost Energy\\n              </span>\\n              <span\\n                ref={boostNumRef}\\n                className=\\\"font-mono text-sm font-semibold tabular-nums text-cyan-300\\\"\\n              >\\n                100%\\n              </span>\\n            </div>\\n            <div className=\\\"mt-2 h-1.5 w-full overflow-hidden bg-slate-800\\\">\\n              <div\\n                ref={boostBarRef}\\n                className=\\\"h-full w-full origin-left bg-cyan-400\\\"\\n                style={{ transform: \'scaleX(1)\', willChange: \'transform\' }}\\n              />\\n            </div>\\n            <div className=\\\"mt-1.5 flex items-center justify-between text-[11px]\\\">\\n              <span className=\\\"text-slate-400\\\">Flight Status</span>\\n              <span\\n                ref={statusTextRef}\\n                className=\\\"font-mono font-medium tracking-wider text-slate-300\\\"\\n              >\\n                STANDBY\\n              </span>\\n            </div>\\n          </div>\\n\\n          {/* Right: Velocity Readout */}\\n          <div className=\\\"border border-slate-700/70 bg-[#040a18]/82 px-4 py-3\\\">\\n            <div className=\\\"flex items-baseline justify-between\\\">\\n              <span className=\\\"text-xs font-medium text-slate-400\\\">Velocity</span>\\n              <div className=\\\"flex items-baseline gap-1\\\">\\n                <span\\n                  ref={speedNumRef}\\n                  className=\\\"font-display text-xl font-bold leading-none tabular-nums text-slate-100\\\"\\n                >\\n                  0\\n                </span>\\n                <span className=\\\"font-mono text-[11px] text-slate-400\\\">m/s</span>\\n              </div>\\n            </div>\\n            <div className=\\\"mt-2 h-1.5 w-full overflow-hidden bg-slate-800\\\">\\n              <div\\n                ref={speedBarRef}\\n                className=\\\"h-full w-full origin-left bg-cyan-500\\\"\\n                style={{ transform: \'scaleX(0)\', willChange: \'transform\' }}\\n              />\\n            </div>\\n            <div className=\\\"mt-1.5 flex items-center justify-between font-mono text-[11px] tabular-nums text-slate-400\\\">\\n              <span>Cruise {ship.flight.maxSpeed}</span>\\n              <span>Boost {Math.round(ship.flight.maxSpeed * ship.flight.boostMultiplier)}</span>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Collapsible Control Hints Strip */}\\n        <div className=\\\"pointer-events-auto flex flex-col items-center\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onToggleHints}\\n            className=\\\"flex items-center gap-1.5 px-2.5 py-1 text-[11px] text-slate-400 transition-colors hover:text-cyan-300\\\"\\n          >\\n            {hintsVisible ? <ChevronDown className=\\\"h-3.5 w-3.5\\\" /> : <ChevronUp className=\\\"h-3.5 w-3.5\\\" />}\\n            <span>{hintsVisible ? \'Hide Controls (H)\' : \'Show Controls (H)\'}</span>\\n          </button>\\n\\n          {hintsVisible && (\\n            <div className=\\\"mt-1 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 border border-slate-800/90 bg-[#040a18]/85 px-4 py-1.5 text-xs text-slate-300\\\">\\n              <span>\\n                <strong className=\\\"font-mono text-cyan-300\\\">Mouse</strong> Pitch / Yaw\\n              </span>\\n              <span className=\\\"text-slate-600\\\" aria-hidden=\\\"true\\\">\302\267</span>\\n              <span>\\n                <strong className=\\\"font-mono text-cyan-300\\\">W / S</strong> Thrust / Reverse\\n              </span>\\n              <span className=\\\"text-slate-600\\\" aria-hidden=\\\"true\\\">\302\267</span>\\n              <span>\\n                <strong className=\\\"font-mono text-cyan-300\\\">A / D</strong> Roll\\n              </span>\\n              <span className=\\\"text-slate-600\\\" aria-hidden=\\\"true\\\">\302\267</span>\\n              <span>\\n                <strong className=\\\"font-mono text-cyan-300\\\">Shift</strong> Boost\\n              </span>\\n              <span className=\\\"text-slate-600\\\" aria-hidden=\\\"true\\\">\302\267</span>\\n              <span>\\n                <strong className=\\\"font-mono text-cyan-300\\\">Esc</strong> Pause\\n              </span>\\n            </div>\\n          )}\\n        </div>\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create zero-re-render FlightHUD displaying speed, hull integrity, boost energy, reticle, heading telemetry, and collapsible control hints\", \"Overwrite\":true, \"TargetFile\":\"/src/components/FlightHUD.tsx\", \"toolAction\":\"Creating FlightHUD component\", \"toolSummary\":\"Create src/components/FlightHUD.tsx\"}"
      thinking_signature: "\022\337\017\n\334\017\001i\024}\023\024\255Q1\322\203aj\314\342\241\325\247}\034R\220\251\233\272\256\341\321\226\315\033\212U\177DJ\205\215?D\366\346\350rW1\300\270\315\370\240\204\034\270\320\357\245\022B\364,^\343Lfyn\037\214\240\210\275b?\305\302\362\a\362\002\327\367\004\001\215\2646\017\263\304%9B\265P\267\274<\300\006\2412\362\202\271@\\7\207\223\347S\004l\267\017\236\221\361\027\304\031\205\201\251\3727\256\032_\302\r\000@\241\326\336\275J-H\243\210h\027a\304\3543\264\333\230M:\200\t\016j\254\265\364\240{>kH\356\304\211\200\004\221\276}\373p5E\fee\300\224\335/\004\335\035\271\214\031\036\016\326\025\317\005\265\033\005\227\301YP\227v\345\032q\331\001WQ\2340i\366m\211\363\"5\237:8HN\365\205Xjl\033)\335M\177x\215\367\337\2155&6\260\236< \265\026\304\024\336\365\360@\217{\272{W\3242\213Q\034;g9\332\256Q\300@\024\226\\\\\261\351\242\235\242\244\366\005\247\225\365\035q\222\000B\t\023\321\347\312\215\344\323QuL\220\004\214c\347@\203\025O\345\302\271\334\252EY\363\326\271\035n\257\333BG)\265O\326(5\206\221-\n\374\356b<\327d\334\366\331\232\025\271\017\231\2475}\000\340\274L\235\3734=\304(\313\266\204\245\001\004\350u\243\303\241\214\330\216\315hM\351)\304\222\024A?\302\213Y\307\207\341t\225\227|\"\242\374\2072.\342xM\027\353\246J9\034\316\351\347\351T\252Z\030\204\274/\271\337\234\306\266V\200\273\365\021dE\\\210\002\326\2501\260F]#\r\370J1i\242\'M\326 \020?a\br\252\r>\001/\\>\341\333>\367\\%\367\375\220\037,\321\177\221n\241/.I\331\025P|\211x6S\2276\344\205\363\261j\315\216C\217\f\3612\236\273br\276\205\356`/\350 u\027\003\223:,{4\3354@d\357\300\276X\323\251\261\"\254\304&I\003\305\335\245\363\211\370\363Y\177\3400\244\203\273\377\322\305\226\003\316\026\251\233~2b\272=n\233\266\3609sh\332\214Z[\025\244\372\353*\233:\b\307\370\330d\225h\341\006\025\313\217s\035\177\231v\026%\263\f\a\237\3233\270h\260$\326;\030:v\366\334l\214d\367\3253!7{\003\367!\373\207\371;\354\263Kt\320\353\201\023A\220\000\036v\fEr\364(l\216\215\232\375\370\272\312\016\207\271\034\3510qP\212\344\252\256U=\003\2272\001\236YH\n\270-\255\367P\370k\361}m\022\257{\3470\314/\310\2575\025\"\b\247\337\004&\260\327\177\300\315mP\212\027\253\220\221\304\212<[M,\257\r@\244N1\036\373\031\255\210a_k\345\311.\222\266\375.\037\206\236\002\342\r\205\317\216\354\260o+\005 Y\266\242\322\250\244Ca\224#p\332\025pN8~vzY!\234\\OKc\220n\264\257u\020\340\273\3777\365\016\n.\266\322w\256\273\373c\327c\267]\347\310\034\220<\375C}\327>\245\352\260<>\245*\231\3062q\315\226#7|\363\212\267\222\"`G\006\001\027\267\315\317\3008\027\305\022\310\221\225\236:\317\250\250\274r\237\363W\230\226\222x}\304\337\243W\310p\270-\025{Y\2162\367\217(\231\247\301\206>XU?\035v \215w\351\273\243\006\216\0232\\\t\215\266\2528WV\364\361\227\200\241\227\345\273N]+j|\223\244\270BUK\377\331+s\365\311\245\271>\2253s\2341\222\f\330k\342\231\225\271h\330D\223\347\303\022\340e#\234\022\327\311\272\373\263T\372AKZ\214\251\312\226\032\236W\360\367\003\214\316\310\016U.\034(\336\354m\230\260\255\261\033q0\263\213\256\355\023\364\362\250r|\314{\321\333\2676\360GP\350\312_l\303\027\271\302\214\326\006\230\352\r\204\030|\327N)v\320PP\343\356\006\357\340k\243\340\316\270LL\377c\242\020\243e$n\365\t\033P\370\206\311Za\301m_O\237\236I\271\243i\252\323\214\373\210\253%\247\032V\336S.\034x\217\034\262\226\205\2076\022\020\255\023\2769\240U\t\255\tL \017Yq`\207\341#\240\331\336\241\266:\020\v*v\364\240\347[\252\002W\224v\323\324\006\376\362\025\256\f\b\027\275c\321N<\337(8\334.\362\a\026%\37185\377\274Z\243\227\023\206\352\331+Gx\277\324\270~}O}\201\244\226,\002\005Le\004\376\247\342\026\2467q\245\267\352\207\031+\307\331\246lP\270\024\310\311\017J\321\215v\312\356 R)6\344R\346=\234\337\323\304\177\330I\232(\234\327X\265\353\206rt\236\257\335\207\326\200y\'\016\251!\260&J\375e\222\257\215\277r\257j\271`\260b\337\303\250]\205.\345\206\212\340p\265br\331Vrf\351\001\302\236Fx\263\224\306Ms\213\210\002\371\231~e\223\a\023\210\253/\354\317\330\226z\354\023\262&\341J,\001\346S\366~\200\222\301}O\036\373I;\345\313\366QJ\215\372D\252_\006\006\340t=\030\\\254f-\"\021\036\303\234\026X%\006\327m\006\262\273\036 \023\0300\017\355pR\271\002\275\253\244$\f\334\000\275\221\022\2103\340\324\243~\326\216\020\311\342\337~\216\301\207\362\004\251\026\365S#\276\226\005\206\225P\240\354\323\303\315\345Sk\2056F\222 r\256-\262D\326\347\241\006r\3303`\370u\'v\317NEE\220\373\275(\v\272\224p\352\235;Er\004\337\004\216}\202\230\237[\220\345)\2530\244\223\2203\324d\310\336$@A\231\307\231Ea\nM\322\326\'\247(PNP\375\nE\231\255\005,8\300$9\256\315\000\036\344k\375\225l\236\366t\215\002D\276\307\351\'\233\363\034\033\250\254\331\374\300\230 \262\350\315\353\315\344\243\220\371m\023\303\2636\334\245\364t\361!1\345\247\250\217FX\317v=\253\237s\257&,S64\017\276Z\225O\322B\367E\2510\3362\026Z\230\257~=\365\3224\371\244\346:\211u\030\263\016\036\034j\330\021\005\371!\330\313)\233\3061\212\270\b\025\341\317D\001\236\211\036dV~\021$\334]\354\255-2\016\354\265=\214\f\367\340\347*F\343)J\224?f\276W\305V\360\265\265:`5?\255e^\024\210r\264r6\265\204\023Cx{\300R\002\262\325\275w\264g%\317\374\rvF\0219u|6\203A\225\347Yqz\a\035|^\356A^\342B\237[\273\222u\370\234j\261c\260\313\037\362rfj\317\2069\217\237\273\243\237K\272Q)\024@\2614<\262\316\217\251\235\024e\344\204va\374\315&9\202\035P\334\324\325\376\203I\3705\213sI\320\314\364U\337-\020>\321&\212-)6\213\"\302\345\314wa\250\347lw\230\236I\006\321\032N(~\365\314-\365q\203\215\374C@p\320N\342\353L\200n\261\343e-wd4\vIi\242lJV\273Z\376c\244DJ\033;YU\307u\321U\370#\331\236\317\244\303\370\205\213\252\262V\356\277~}\313\244v\3177^`\037\264\314>\311\213\354\205\337g\033\305\222\374\251\272\263\034\350F:i\352\364@ b\236o\301\335H\241\273W\332\205ij\302\212O3\331e\\\000\323\340<X\317\3218\2203/CVd\244g\321Pf\203`\334\312\037Q\346\353\265}\267"
