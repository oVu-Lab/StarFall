            lines {
              text: " * Non-linear precision curve for mouse deltas:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * Preserves fine 1:1 micro-aiming for small movements while expanding reach on broad sweeps"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
