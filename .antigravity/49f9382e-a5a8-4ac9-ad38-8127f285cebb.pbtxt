              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /** Maximum vertical HUD boundary half-height fraction */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  maxVerticalScreenOffset: 0.38,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /** Tiny center deadzone (fraction of B) for drift-free straight flight */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  deadzone: 0.03,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  responseExponent: 1.25,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "};"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  /** Mild inner-zone shaping exponent for crisp precision near center */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  precisionExponent: 1.15,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /** Fraction of B where smoothstep transition toward boundarySensitivity begins */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  boundaryBlendStart: 0.8,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /** Time constant (seconds) for smooth sensitivity transitions & return to precision */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  recoverySmoothingSec: 0.12,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /** Upper displacement buffer in multiples of S past B (at e=4.0, f(4)=0.941) */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  maxExcessScales: 4.0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /** Subtle visual reticle tension stretch past boundary (fraction of viewport, keeps reticle clear of HUD) */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  overdriveReticleStretch: 0.028,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /** Safety angular velocity ceiling multipliers to prevent uncontrollable spin */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  maxSafeYawMultiplier: 3.2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  maxSafePitchMultiplier: 3.0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "} as const;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/** Kept for compatibility with HUD & diagnostics referencing boundary bounds */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export const VIRTUAL_AIM_CONFIG = {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  maxScreenOffsetX: 0.25,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  maxScreenOffsetY: 0.26,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  pixelsToBoundary: 200,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  deadzone: PROGRESSIVE_STEERING_CONFIG.deadzone,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  responseExponent: PROGRESSIVE_STEERING_CONFIG.precisionExponent,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "};"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export interface AxisSteeringEvaluation {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  targetSensitivity: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  excess: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  curveFactor: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  zone: SteeringZone;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Pure per-axis progressive steering response evaluation."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Let x = virtual aim displacement, B = boundary, S = accelerationDistance, p = responseCurve:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   e = max(0, (|x| - B) / S)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   f(e) = e^p / (1 + e^p)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   sensitivity(e) = boundarySensitivity + (maxSensitivity - boundarySensitivity) * f(e)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Inside |x| <= B: preserves 1.0x sensitivity across [0 .. 0.80B], then smoothstep-blends"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * over [0.80B .. 1.00B] down to boundarySensitivity so the derivative is 0 at |x| = B (C1 continuous)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function evaluateProgressiveAxisSensitivity("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  absDisplacement: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  boundary: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  accelDistance: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  boundarySensitivity: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  maxSensitivity: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  exponent: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  out: AxisSteeringEvaluation = {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    targetSensitivity: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    excess: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    curveFactor: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    zone: \'precision\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): AxisSteeringEvaluation {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const B = Math.max(20, boundary);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const S = Math.max(20, accelDistance);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const bSens = THREE.MathUtils.clamp(boundarySensitivity, 0.1, 1.5);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const mSens = Math.max(bSens, maxSensitivity);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const p = THREE.MathUtils.clamp(exponent, 0.5, 5.0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (absDisplacement <= B) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const blendStart = B * PROGRESSIVE_STEERING_CONFIG.boundaryBlendStart;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (absDisplacement <= blendStart) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      out.targetSensitivity = 1.0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const t = (absDisplacement - blendStart) / (B - blendStart);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const smooth = t * t * (3 - 2 * t);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      out.targetSensitivity = 1.0 + (bSens - 1.0) * smooth;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    out.excess = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    out.curveFactor = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    out.zone = \'precision\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return out;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const e = (absDisplacement - B) / S;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const ep = Math.pow(e, p);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const f = ep / (1 + ep);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const targetSens = bSens + (mSens - bSens) * f;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  out.targetSensitivity = targetSens;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  out.excess = e;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  out.curveFactor = f;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  out.zone = targetSens < 1.0 ? \'transition\' : \'acceleration\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return out;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "const GIMBAL_MAX_YAW_RAD = 0.24;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "const GIMBAL_MAX_PITCH_RAD = 0.17;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "const _gimbalDirLocal = new THREE.Vector3();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "const _evalX: AxisSteeringEvaluation = {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  targetSensitivity: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  excess: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  curveFactor: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  zone: \'precision\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "};"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "const _evalY: AxisSteeringEvaluation = {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  targetSensitivity: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  excess: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  curveFactor: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  zone: \'precision\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "};"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Arcade 6DOF space flight controller."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Ship coordinate system: Forward = -Z, Right = +X, Up = +Y."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Bounded Virtual-Aim Continuous Steering:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * - Relative Pointer Lock `movementX` / `movementY` drives a persistent virtual aiming offset"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " *   `(aimCursorX, aimCursorY)` bounded smoothly inside the unit circle (`r <= 1.0`)."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * - The aiming offset NEVER auto-recenters or rolls back while flying."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * - Holding the virtual reticle on the aiming boundary sustains full continuous 360\302\260+ yaw/pitch"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " *   rotation smoothly with restored Phase 1/2 arcade responsiveness and controlled inertia."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * Progressive Three-Zone Virtual-Aim Steering:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - Relative Pointer Lock `movementX` / `movementY` independently accumulates per-axis virtual"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   aim displacement (`virtualAimX`, `virtualAimY`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - Never auto-recenters or rolls back while flying; works continuously at physical screen edges."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - Precision Zone (|x| <= B), Transition Zone (slower initial boundary crossing), and"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   Acceleration Zone (smooth asymptotic turn speedup) with 0.12s delta-time recovery smoothing."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "export class FlightController {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  public readonly position = new THREE.Vector3(0, 12, 40);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  public readonly quaternion = new THREE.Quaternion();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  public readonly velocity = new THREE.Vector3(0, 0, -24);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  // Smoothed angular rates (rad/s) in ship local space"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  public yawVelocity = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  public pitchVelocity = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  public rollVelocity = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  // Persistent virtual aim offset in normalized unit-disk steering space (hypot <= 1.0; 0,0 = center)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  // Accumulated independent relative virtual aim displacement per axis (virtual pixels)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  public virtualAimX = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  public virtualAimY = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
