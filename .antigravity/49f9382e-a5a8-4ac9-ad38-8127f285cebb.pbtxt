    command_line: "NODE_PATH=/usr/local/share/bun-global/node_modules node -e \'\nconst { chromium } = require(\"playwright\");\n\n(async () => {\n  const browser = await chromium.launch({\n    headless: true,\n    args: [\"--no-sandbox\", \"--use-gl=angle\", \"--use-angle=swiftshader\"],\n  });\n  const context = await browser.newContext({ viewport: { width: 1280, height: 720 }, deviceScaleFactor: 1 });\n  const page = await context.newPage();\n\n  const pageErrors = [];\n  const consoleErrors = [];\n  page.on(\"pageerror\", (e) => pageErrors.push(e.message));\n  page.on(\"console\", (msg) => {\n    if (msg.type() === \"error\") consoleErrors.push(msg.text());\n  });\n\n  await page.addInitScript(() => {\n    localStorage.setItem(\"starfall.settings.v2\", JSON.stringify({\n      mouseSensitivity: 1.0,\n      boundarySensitivity: 0.35,\n      maxSensitivity: 2.5,\n      accelerationDistance: 240,\n      responseCurve: 2.0,\n      aimBoundarySize: 0.25,\n      invertY: false,\n      cameraDistance: 9.8,\n      cameraSensitivity: 1.0,\n      masterVolume: 0.4,\n      graphicsQuality: \"low\",\n      resolutionScale: 0.75,\n      shadowQuality: \"off\",\n      particleQuality: \"low\",\n      environmentDetail: \"low\",\n      drawDistance: 2400,\n      antialias: false,\n      postGlowEnabled: false,\n      showPerfOverlay: false,\n    }));\n    window.__plErrors = 0;\n    document.addEventListener(\"pointerlockerror\", () => { window.__plErrors++; });\n  });\n\n  const waitFrames = async (count) => {\n    await page.evaluate((n) => new Promise((resolve) => {\n      let left = n;\n      const tick = () => {\n        if (--left <= 0) resolve();\n        else requestAnimationFrame(tick);\n      };\n      requestAnimationFrame(tick);\n    }), count);\n  };\n\n  const dispatchRel = async (dx, dy) => {\n    await page.evaluate(([mx, my]) => {\n      const evt = new MouseEvent(\"mousemove\", { bubbles: true, cancelable: true, movementX: mx, movementY: my });\n      Object.defineProperty(evt, \"movementX\", { value: mx });\n      Object.defineProperty(evt, \"movementY\", { value: my });\n      window.dispatchEvent(evt);\n    }, [dx, dy]);\n  };\n\n  const readHud = async () => {\n    return await page.evaluate(() => {\n      const cursor = document.querySelector(\"[data-testid=\\\"virtual-mouse-cursor\\\"]\");\n      const frame = document.querySelector(\"[data-testid=\\\"aim-boundary-frame\\\"]\");\n      const rect = cursor ? cursor.getBoundingClientRect() : null;\n      const fRect = frame ? frame.getBoundingClientRect() : null;\n      const cx = rect ? rect.left + rect.width / 2 : null;\n      const cy = rect ? rect.top + rect.height / 2 : null;\n      const text = document.body.innerText;\n      const hdgMatch = text.match(/HDG\\s+([0-9.\\-]+)/);\n      const pitchMatch = text.match(/PITCH\\s+([0-9.\\-+]+)/);\n      return {\n        plTag: document.pointerLockElement ? document.pointerLockElement.tagName : null,\n        plErrors: window.__plErrors || 0,\n        cursorX: cx !== null ? Number(cx.toFixed(1)) : null,\n        cursorY: cy !== null ? Number(cy.toFixed(1)) : null,\n        zone: cursor ? cursor.getAttribute(\"data-steering-zone\") : null,\n        sensX: cursor ? Number(cursor.getAttribute(\"data-sens-x\")) : null,\n        sensY: cursor ? Number(cursor.getAttribute(\"data-sens-y\")) : null,\n        frameW: fRect ? Number(fRect.width.toFixed(0)) : null,\n        hdg: hdgMatch ? Number(hdgMatch[1]) : null,\n        pitch: pitchMatch ? Number(pitchMatch[1]) : null,\n      };\n    });\n  };\n\n  const hdgDelta = (from, to) => {\n    let d = to - from;\n    if (d > 180) d -= 360;\n    if (d < -180) d += 360;\n    return Number(d.toFixed(1));\n  };\n\n  await page.goto(\"http://localhost:3000/\", { waitUntil: \"domcontentloaded\", timeout: 30000 });\n  await page.waitForSelector(\"text=Settings\", { timeout: 30000 });\n\n  // A. Verify Settings UI exposes all 6 progressive steering sliders & curve preview\n  await page.click(\"text=Settings\");\n  await page.waitForSelector(\"#setting-boundary-sens\", { timeout: 10000 });\n  const settingsCheck = await page.evaluate(() => ({\n    baseSens: !!document.querySelector(\"#setting-mouse-sens\"),\n    boundarySens: !!document.querySelector(\"#setting-boundary-sens\"),\n    maxSens: !!document.querySelector(\"#setting-max-sens\"),\n    accelDist: !!document.querySelector(\"#setting-accel-dist\"),\n    responseCurve: !!document.querySelector(\"#setting-response-curve\"),\n    aimBoundary: !!document.querySelector(\"#setting-aim-boundary\"),\n    curveSvg: !!document.querySelector(\"svg[aria-label=\\\"Progressive mouse steering response curve\\\"]\"),\n  }));\n  console.log(\"A. SETTINGS_UI:\", settingsCheck);\n  await page.click(\"text=Back\");\n\n  // B. Launch Mission M-01\n  await page.waitForSelector(\"text=Campaign Missions\", { timeout: 15000 });\n  await page.click(\"text=Campaign Missions\");\n  await page.waitForSelector(\"text=Launch M-01\", { timeout: 15000 });\n  await page.click(\"text=Launch M-01\");\n  await page.waitForFunction(() => !!document.querySelector(\"[data-testid=\\\"virtual-mouse-cursor\\\"]\"), { timeout: 45000 });\n  await waitFrames(2);\n\n  // Engage Pointer Lock on CANVAS\n  await page.mouse.click(640, 360);\n  await waitFrames(2);\n  const init = await readHud();\n  console.log(\"B. INIT:\", init);\n\n  // 1. PRECISION ZONE (+140px right, inside B=200px)\n  await dispatchRel(140, 0);\n  await waitFrames(3);\n  const prec0 = await readHud();\n  await waitFrames(4);\n  const prec1 = await readHud();\n  console.log(\"1. PRECISION (+140px):\", {\n    zone: prec1.zone, cursorX: prec1.cursorX, sensX: prec1.sensX, sensY: prec1.sensY,\n    hdgDelta4f: hdgDelta(prec0.hdg, prec1.hdg), rollbackPx: Number((prec1.cursorX - prec0.cursorX).toFixed(1)),\n  });\n\n  // 2. TRANSITION ZONE (+80px more -> total 220px, just across B=200px) -> slower steering!\n  await dispatchRel(80, 0);\n  await waitFrames(5);\n  const trans0 = await readHud();\n  await waitFrames(4);\n  const trans1 = await readHud();\n  console.log(\"2. TRANSITION (+220px):\", {\n    zone: trans1.zone, cursorX: trans1.cursorX, sensX: trans1.sensX, sensY: trans1.sensY,\n    hdgDelta4f: hdgDelta(trans0.hdg, trans1.hdg), rollbackPx: Number((trans1.cursorX - trans0.cursorX).toFixed(1)),\n  });\n\n  // 3a. ACCELERATION ZONE (+220px more -> total 440px, e=1.0) -> faster steering!\n  await dispatchRel(220, 0);\n  await waitFrames(5);\n  const acc1_0 = await readHud();\n  await waitFrames(4);\n  const acc1_1 = await readHud();\n  console.log(\"3a. ACCEL_MID (+440px, e=1.0):\", {\n    zone: acc1_1.zone, cursorX: acc1_1.cursorX, sensX: acc1_1.sensX, sensY: acc1_1.sensY,\n    hdgDelta4f: hdgDelta(acc1_0.hdg, acc1_1.hdg),\n  });\n\n  // 3b. DEEP ACCELERATION (+240px more -> total 680px, e=2.0) + Independent Y precision (+80px)\n  await dispatchRel(240, 80);\n  await waitFrames(5);\n  const acc2_0 = await readHud();\n  await waitFrames(4);\n  const acc2_1 = await readHud();\n  console.log(\"3b. ACCEL_DEEP (+680px X, +80px Y):\", {\n    zone: acc2_1.zone, cursorX: acc2_1.cursorX, cursorY: acc2_1.cursorY,\n    sensX: acc2_1.sensX, sensY: acc2_1.sensY,\n    hdgDelta4f: hdgDelta(acc2_0.hdg, acc2_1.hdg),\n  });\n\n  // 4. SMOOTH RETURN TO PRECISION (-560px X -> back to +120px, -80px Y -> 0)\n  await dispatchRel(-560, -80);\n  await waitFrames(1);\n  const retFrame1 = await readHud();\n  await waitFrames(5);\n  const retSettled = await readHud();\n  console.log(\"4. RETURN_TO_PRECISION:\", {\n    frame1: { zone: retFrame1.zone, cursorX: retFrame1.cursorX, sensX: retFrame1.sensX },\n    settled: { zone: retSettled.zone, cursorX: retSettled.cursorX, sensX: retSettled.sensX },\n  });\n\n  console.log(\"ERRORS:\", {\n    pageErrors,\n    consoleErrors: consoleErrors.filter((e) => !e.includes(\"WebSocket\")),\n    plErrors: retSettled.plErrors,\n  });\n\n  await browser.close();\n})().catch((err) => {\n  console.error(\"TEST_FAILED:\", err);\n  process.exit(1);\n});\n\'"
    proposed_command_line: "NODE_PATH=/usr/local/share/bun-global/node_modules node -e \'\nconst { chromium } = require(\"playwright\");\n\n(async () => {\n  const browser = await chromium.launch({\n    headless: true,\n    args: [\"--no-sandbox\", \"--use-gl=angle\", \"--use-angle=swiftshader\"],\n  });\n  const context = await browser.newContext({ viewport: { width: 1280, height: 720 }, deviceScaleFactor: 1 });\n  const page = await context.newPage();\n\n  const pageErrors = [];\n  const consoleErrors = [];\n  page.on(\"pageerror\", (e) => pageErrors.push(e.message));\n  page.on(\"console\", (msg) => {\n    if (msg.type() === \"error\") consoleErrors.push(msg.text());\n  });\n\n  await page.addInitScript(() => {\n    localStorage.setItem(\"starfall.settings.v2\", JSON.stringify({\n      mouseSensitivity: 1.0,\n      boundarySensitivity: 0.35,\n      maxSensitivity: 2.5,\n      accelerationDistance: 240,\n      responseCurve: 2.0,\n      aimBoundarySize: 0.25,\n      invertY: false,\n      cameraDistance: 9.8,\n      cameraSensitivity: 1.0,\n      masterVolume: 0.4,\n      graphicsQuality: \"low\",\n      resolutionScale: 0.75,\n      shadowQuality: \"off\",\n      particleQuality: \"low\",\n      environmentDetail: \"low\",\n      drawDistance: 2400,\n      antialias: false,\n      postGlowEnabled: false,\n      showPerfOverlay: false,\n    }));\n    window.__plErrors = 0;\n    document.addEventListener(\"pointerlockerror\", () => { window.__plErrors++; });\n  });\n\n  const waitFrames = async (count) => {\n    await page.evaluate((n) => new Promise((resolve) => {\n      let left = n;\n      const tick = () => {\n        if (--left <= 0) resolve();\n        else requestAnimationFrame(tick);\n      };\n      requestAnimationFrame(tick);\n    }), count);\n  };\n\n  const dispatchRel = async (dx, dy) => {\n    await page.evaluate(([mx, my]) => {\n      const evt = new MouseEvent(\"mousemove\", { bubbles: true, cancelable: true, movementX: mx, movementY: my });\n      Object.defineProperty(evt, \"movementX\", { value: mx });\n      Object.defineProperty(evt, \"movementY\", { value: my });\n      window.dispatchEvent(evt);\n    }, [dx, dy]);\n  };\n\n  const readHud = async () => {\n    return await page.evaluate(() => {\n      const cursor = document.querySelector(\"[data-testid=\\\"virtual-mouse-cursor\\\"]\");\n      const frame = document.querySelector(\"[data-testid=\\\"aim-boundary-frame\\\"]\");\n      const rect = cursor ? cursor.getBoundingClientRect() : null;\n      const fRect = frame ? frame.getBoundingClientRect() : null;\n      const cx = rect ? rect.left + rect.width / 2 : null;\n      const cy = rect ? rect.top + rect.height / 2 : null;\n      const text = document.body.innerText;\n      const hdgMatch = text.match(/HDG\\s+([0-9.\\-]+)/);\n      const pitchMatch = text.match(/PITCH\\s+([0-9.\\-+]+)/);\n      return {\n        plTag: document.pointerLockElement ? document.pointerLockElement.tagName : null,\n        plErrors: window.__plErrors || 0,\n        cursorX: cx !== null ? Number(cx.toFixed(1)) : null,\n        cursorY: cy !== null ? Number(cy.toFixed(1)) : null,\n        zone: cursor ? cursor.getAttribute(\"data-steering-zone\") : null,\n        sensX: cursor ? Number(cursor.getAttribute(\"data-sens-x\")) : null,\n        sensY: cursor ? Number(cursor.getAttribute(\"data-sens-y\")) : null,\n        frameW: fRect ? Number(fRect.width.toFixed(0)) : null,\n        hdg: hdgMatch ? Number(hdgMatch[1]) : null,\n        pitch: pitchMatch ? Number(pitchMatch[1]) : null,\n      };\n    });\n  };\n\n  const hdgDelta = (from, to) => {\n    let d = to - from;\n    if (d > 180) d -= 360;\n    if (d < -180) d += 360;\n    return Number(d.toFixed(1));\n  };\n\n  await page.goto(\"http://localhost:3000/\", { waitUntil: \"domcontentloaded\", timeout: 30000 });\n  await page.waitForSelector(\"text=Settings\", { timeout: 30000 });\n\n  // A. Verify Settings UI exposes all 6 progressive steering sliders & curve preview\n  await page.click(\"text=Settings\");\n  await page.waitForSelector(\"#setting-boundary-sens\", { timeout: 10000 });\n  const settingsCheck = await page.evaluate(() => ({\n    baseSens: !!document.querySelector(\"#setting-mouse-sens\"),\n    boundarySens: !!document.querySelector(\"#setting-boundary-sens\"),\n    maxSens: !!document.querySelector(\"#setting-max-sens\"),\n    accelDist: !!document.querySelector(\"#setting-accel-dist\"),\n    responseCurve: !!document.querySelector(\"#setting-response-curve\"),\n    aimBoundary: !!document.querySelector(\"#setting-aim-boundary\"),\n    curveSvg: !!document.querySelector(\"svg[aria-label=\\\"Progressive mouse steering response curve\\\"]\"),\n  }));\n  console.log(\"A. SETTINGS_UI:\", settingsCheck);\n  await page.click(\"text=Back\");\n\n  // B. Launch Mission M-01\n  await page.waitForSelector(\"text=Campaign Missions\", { timeout: 15000 });\n  await page.click(\"text=Campaign Missions\");\n  await page.waitForSelector(\"text=Launch M-01\", { timeout: 15000 });\n  await page.click(\"text=Launch M-01\");\n  await page.waitForFunction(() => !!document.querySelector(\"[data-testid=\\\"virtual-mouse-cursor\\\"]\"), { timeout: 45000 });\n  await waitFrames(2);\n\n  // Engage Pointer Lock on CANVAS\n  await page.mouse.click(640, 360);\n  await waitFrames(2);\n  const init = await readHud();\n  console.log(\"B. INIT:\", init);\n\n  // 1. PRECISION ZONE (+140px right, inside B=200px)\n  await dispatchRel(140, 0);\n  await waitFrames(3);\n  const prec0 = await readHud();\n  await waitFrames(4);\n  const prec1 = await readHud();\n  console.log(\"1. PRECISION (+140px):\", {\n    zone: prec1.zone, cursorX: prec1.cursorX, sensX: prec1.sensX, sensY: prec1.sensY,\n    hdgDelta4f: hdgDelta(prec0.hdg, prec1.hdg), rollbackPx: Number((prec1.cursorX - prec0.cursorX).toFixed(1)),\n  });\n\n  // 2. TRANSITION ZONE (+80px more -> total 220px, just across B=200px) -> slower steering!\n  await dispatchRel(80, 0);\n  await waitFrames(5);\n  const trans0 = await readHud();\n  await waitFrames(4);\n  const trans1 = await readHud();\n  console.log(\"2. TRANSITION (+220px):\", {\n    zone: trans1.zone, cursorX: trans1.cursorX, sensX: trans1.sensX, sensY: trans1.sensY,\n    hdgDelta4f: hdgDelta(trans0.hdg, trans1.hdg), rollbackPx: Number((trans1.cursorX - trans0.cursorX).toFixed(1)),\n  });\n\n  // 3a. ACCELERATION ZONE (+220px more -> total 440px, e=1.0) -> faster steering!\n  await dispatchRel(220, 0);\n  await waitFrames(5);\n  const acc1_0 = await readHud();\n  await waitFrames(4);\n  const acc1_1 = await readHud();\n  console.log(\"3a. ACCEL_MID (+440px, e=1.0):\", {\n    zone: acc1_1.zone, cursorX: acc1_1.cursorX, sensX: acc1_1.sensX, sensY: acc1_1.sensY,\n    hdgDelta4f: hdgDelta(acc1_0.hdg, acc1_1.hdg),\n  });\n\n  // 3b. DEEP ACCELERATION (+240px more -> total 680px, e=2.0) + Independent Y precision (+80px)\n  await dispatchRel(240, 80);\n  await waitFrames(5);\n  const acc2_0 = await readHud();\n  await waitFrames(4);\n  const acc2_1 = await readHud();\n  console.log(\"3b. ACCEL_DEEP (+680px X, +80px Y):\", {\n    zone: acc2_1.zone, cursorX: acc2_1.cursorX, cursorY: acc2_1.cursorY,\n    sensX: acc2_1.sensX, sensY: acc2_1.sensY,\n    hdgDelta4f: hdgDelta(acc2_0.hdg, acc2_1.hdg),\n  });\n\n  // 4. SMOOTH RETURN TO PRECISION (-560px X -> back to +120px, -80px Y -> 0)\n  await dispatchRel(-560, -80);\n  await waitFrames(1);\n  const retFrame1 = await readHud();\n  await waitFrames(5);\n  const retSettled = await readHud();\n  console.log(\"4. RETURN_TO_PRECISION:\", {\n    frame1: { zone: retFrame1.zone, cursorX: retFrame1.cursorX, sensX: retFrame1.sensX },\n    settled: { zone: retSettled.zone, cursorX: retSettled.cursorX, sensX: retSettled.sensX },\n  });\n\n  console.log(\"ERRORS:\", {\n    pageErrors,\n    consoleErrors: consoleErrors.filter((e) => !e.includes(\"WebSocket\")),\n    plErrors: retSettled.plErrors,\n  });\n\n  await browser.close();\n})().catch((err) => {\n  console.error(\"TEST_FAILED:\", err);\n  process.exit(1);\n});\n\'"
