sensX: 1 },  hz120: { yawDeg: -61.41, sensX: 1 },  hz240: { yawDeg: -61.27, sensX: 1 }}  Transition (220px): {  hz30: { yawDeg: -49.73, sensX: 0.365 },  hz60: { yawDeg: -50, sensX: 0.365 },  hz120: { yawDeg: -50.14, sensX: 0.365 },  hz240: { yawDeg: -50.21, sensX: 0.365 }}  Accel      (440px): {  hz30: { yawDeg: -157.86, sensX: 1.425 },  hz60: { yawDeg: -156.22, sensX: 1.425 },  hz120: { yawDeg: -155.35, sensX: 1.425 },  hz240: { yawDeg: -154.9, sensX: 1.425 }}(node:2749) [THREE_CJS_DEPRECATED] DeprecationWarning: `require(\"three\")` is deprecated and will be removed.Replace `const THREE = require(\"three\")` with `import * as THREE from \"three\"`.(Use `node --trace-deprecation ...` to show where the warning was created)"
