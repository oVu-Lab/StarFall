    tool_calls {
      id: "call_15786545757922109596"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { ArrowRight, CheckCircle2, Home, List, RotateCcw, ShieldAlert } from \'lucide-react\';\\nimport { AudioManager } from \'../audio/AudioManager\';\\nimport { DIFFICULTY_PROFILES } from \'../config/difficulty\';\\nimport type { MissionRank } from \'../types/game\';\\nimport type { MissionResult } from \'../types/mission\';\\n\\ninterface MissionResultsOverlayProps {\\n  result: MissionResult;\\n  onNextMission: (() => void) | null;\\n  onRetryMission: () => void;\\n  onMissionSelect: () => void;\\n  onMainMenu: () => void;\\n}\\n\\nconst RANK_COLORS: Record<MissionRank, string> = {\\n  S: \'border-cyan-400 bg-cyan-500/20 text-cyan-200\',\\n  A: \'border-sky-400 bg-sky-500/15 text-sky-200\',\\n  B: \'border-slate-400 bg-slate-700/35 text-slate-100\',\\n  C: \'border-amber-400 bg-amber-500/15 text-amber-200\',\\n};\\n\\nfunction formatDuration(sec: number): string {\\n  const m = Math.floor(sec / 60);\\n  const s = Math.floor(sec % 60);\\n  const tenths = Math.floor((sec % 1) * 10);\\n  return `${String(m).padStart(2, \'0\')}:${String(s).padStart(2, \'0\')}.${tenths}`;\\n}\\n\\nexport function MissionResultsOverlay({\\n  result,\\n  onNextMission,\\n  onRetryMission,\\n  onMissionSelect,\\n  onMainMenu,\\n}: MissionResultsOverlayProps) {\\n  const isVictory = result.status === \'completed\';\\n  const breakdown = result.scoreBreakdown;\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-30 flex items-center justify-center bg-[#030712]/84 p-5 overflow-y-auto\\\">\\n      <div className=\\\"w-full max-w-2xl border border-slate-700/90 bg-[#050c1d]/96 p-6 sm:p-8\\\">\\n        {/* Header Row */}\\n        <div className=\\\"flex flex-wrap items-center justify-between gap-4 border-b border-slate-800 pb-5\\\">\\n          <div>\\n            <div className=\\\"flex items-center gap-2 font-mono text-xs tracking-wider\\\">\\n              {isVictory ? (\\n                <CheckCircle2 className=\\\"h-4 w-4 text-cyan-400\\\" />\\n              ) : (\\n                <ShieldAlert className=\\\"h-4 w-4 text-red-400\\\" />\\n              )}\\n              <span className={isVictory ? \'text-cyan-300\' : \'text-red-400\'}>\\n                {isVictory ? \'MISSION COMPLETED\' : \'MISSION FAILED\'}\\n              </span>\\n              <span className=\\\"text-slate-600\\\" aria-hidden=\\\"true\\\">\302\267</span>\\n              <span className=\\\"text-slate-400\\\">\\n                {DIFFICULTY_PROFILES[result.difficulty].label.toUpperCase()}\\n              </span>\\n            </div>\\n            <h2 className=\\\"mt-1 font-display text-3xl font-bold tracking-wide text-slate-50\\\">\\n              M-{String(result.missionNumber).padStart(2, \'0\')} \302\267 {result.missionName}\\n            </h2>\\n          </div>\\n\\n          {isVictory && result.rank ? (\\n            <div className=\\\"flex flex-col items-center\\\">\\n              <div\\n                className={`flex h-16 w-16 items-center justify-center border-2 font-display text-4xl font-bold ${RANK_COLORS[result.rank]}`}\\n              >\\n                {result.rank}\\n              </div>\\n              <span className=\\\"mt-1 font-mono text-[10px] tracking-widest text-slate-400\\\">\\n                {result.isNewBestRank ? \'NEW BEST RANK\' : \'FINAL RANK\'}\\n              </span>\\n            </div>\\n          ) : (\\n            <div className=\\\"border border-red-500/50 bg-red-950/40 px-4 py-2 font-display text-lg font-bold tracking-wider text-red-300\\\">\\n              HULL LOST\\n            </div>\\n          )}\\n        </div>\\n\\n        {/* Unlock Notification Banner */}\\n        {isVictory && result.unlockedNextMissionName && (\\n          <div className=\\\"mt-4 flex items-center justify-between border border-cyan-500/40 bg-cyan-950/35 px-4 py-2.5 text-xs text-cyan-200\\\">\\n            <span>Next Operation Unlocked: <strong>{result.unlockedNextMissionName}</strong></span>\\n            <span className=\\\"font-mono text-[11px] text-cyan-300\\\">READY</span>\\n          </div>\\n        )}\\n\\n        {/* Primary Telemetry Stats Grid */}\\n        <div className=\\\"mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4\\\">\\n          <div className=\\\"border border-slate-800 bg-[#081226] px-3.5 py-3\\\">\\n            <div className=\\\"text-[11px] text-slate-400\\\">Enemies Defeated</div>\\n            <div className=\\\"mt-1 font-mono text-base font-semibold text-slate-100\\\">\\n              {result.enemiesDefeated} / {result.totalEnemies}\\n            </div>\\n          </div>\\n          <div className=\\\"border border-slate-800 bg-[#081226] px-3.5 py-3\\\">\\n            <div className=\\\"text-[11px] text-slate-400\\\">Accuracy</div>\\n            <div className=\\\"mt-1 font-mono text-base font-semibold text-cyan-300\\\">\\n              {result.accuracyPct}%\\n            </div>\\n            <div className=\\\"font-mono text-[10px] text-slate-500\\\">\\n              {result.shotsHit} / {result.shotsFired} hits\\n            </div>\\n          </div>\\n          <div className=\\\"border border-slate-800 bg-[#081226] px-3.5 py-3\\\">\\n            <div className=\\\"text-[11px] text-slate-400\\\">Time Taken</div>\\n            <div className=\\\"mt-1 font-mono text-base font-semibold text-slate-100\\\">\\n              {formatDuration(result.timeTakenSec)}\\n            </div>\\n          </div>\\n          <div className=\\\"border border-slate-800 bg-[#081226] px-3.5 py-3\\\">\\n            <div className=\\\"text-[11px] text-slate-400\\\">Damage Received</div>\\n            <div className=\\\"mt-1 font-mono text-base font-semibold text-orange-300\\\">\\n              {result.damageReceived}\\n            </div>\\n            <div className=\\\"font-mono text-[10px] text-slate-500\\\">\\n              Hull {result.remainingHullPct}%\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Deterministic Score Breakdown */}\\n        <div className=\\\"mt-5 border border-slate-800 bg-[#071022] p-4\\\">\\n          <div className=\\\"flex items-baseline justify-between\\\">\\n            <span className=\\\"font-mono text-xs tracking-wider text-slate-400\\\">\\n              PERFORMANCE BREAKDOWN\\n            </span>\\n            <span className=\\\"font-mono text-sm font-bold text-cyan-300\\\">\\n              {breakdown.totalScore} / 1000 PTS\\n            </span>\\n          </div>\\n          <div className=\\\"mt-3 grid grid-cols-2 gap-x-6 gap-y-2.5 text-xs sm:grid-cols-4\\\">\\n            <div>\\n              <div className=\\\"flex justify-between text-slate-400\\\">\\n                <span>Combat</span>\\n                <span className=\\\"font-mono text-slate-200\\\">{breakdown.combatScore}/400</span>\\n              </div>\\n              <div className=\\\"mt-1 h-1.5 bg-slate-800\\\">\\n                <div\\n                  className=\\\"h-full bg-cyan-400\\\"\\n                  style={{ width: `${(breakdown.combatScore / 400) * 100}%` }}\\n                />\\n              </div>\\n            </div>\\n            <div>\\n              <div className=\\\"flex justify-between text-slate-400\\\">\\n                <span>Accuracy</span>\\n                <span className=\\\"font-mono text-slate-200\\\">{breakdown.accuracyScore}/250</span>\\n              </div>\\n              <div className=\\\"mt-1 h-1.5 bg-slate-800\\\">\\n                <div\\n                  className=\\\"h-full bg-sky-400\\\"\\n                  style={{ width: `${(breakdown.accuracyScore / 250) * 100}%` }}\\n                />\\n              </div>\\n            </div>\\n            <div>\\n              <div className=\\\"flex justify-between text-slate-400\\\">\\n                <span>Survival</span>\\n                <span className=\\\"font-mono text-slate-200\\\">{breakdown.survivalScore}/200</span>\\n              </div>\\n              <div className=\\\"mt-1 h-1.5 bg-slate-800\\\">\\n                <div\\n                  className=\\\"h-full bg-emerald-400\\\"\\n                  style={{ width: `${(breakdown.survivalScore / 200) * 100}%` }}\\n                />\\n              </div>\\n            </div>\\n            <div>\\n              <div className=\\\"flex justify-between text-slate-400\\\">\\n                <span>Speed</span>\\n                <span className=\\\"font-mono text-slate-200\\\">{breakdown.timeScore}/150</span>\\n              </div>\\n              <div className=\\\"mt-1 h-1.5 bg-slate-800\\\">\\n                <div\\n                  className=\\\"h-full bg-amber-400\\\"\\n                  style={{ width: `${(breakdown.timeScore / 150) * 100}%` }}\\n                />\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Action Buttons */}\\n        <div className=\\\"mt-6 grid grid-cols-1 gap-2.5 sm:grid-cols-2\\\">\\n          {isVictory && onNextMission && (\\n            <button\\n              type=\\\"button\\\"\\n              onMouseEnter={() => AudioManager.playUiHover()}\\n              onClick={() => {\\n                AudioManager.unlock();\\n                AudioManager.playUiClick(\'primary\');\\n                onNextMission();\\n              }}\\n              className=\\\"flex items-center justify-center gap-2 bg-cyan-500 px-5 py-3 text-sm font-semibold text-slate-950 transition-colors hover:bg-cyan-400 sm:col-span-2\\\"\\n            >\\n              <span>Next Mission</span>\\n              <ArrowRight className=\\\"h-4 w-4\\\" />\\n            </button>\\n          )}\\n\\n          <button\\n            type=\\\"button\\\"\\n            onMouseEnter={() => AudioManager.playUiHover()}\\n            onClick={() => {\\n              AudioManager.unlock();\\n              AudioManager.playUiClick(isVictory ? \'secondary\' : \'primary\');\\n              onRetryMission();\\n            }}\\n            className={`flex items-center justify-center gap-2 px-5 py-3 text-sm font-semibold transition-colors ${\\n              isVictory && onNextMission\\n                ? \'border border-slate-700 bg-[#081226] text-slate-100 hover:border-cyan-400/60 hover:text-cyan-200\'\\n                : \'bg-cyan-500 text-slate-950 hover:bg-cyan-400 sm:col-span-2\'\\n            }`}\\n          >\\n            <RotateCcw className=\\\"h-4 w-4\\\" />\\n            <span>Retry Mission</span>\\n          </button>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onMouseEnter={() => AudioManager.playUiHover()}\\n            onClick={() => {\\n              AudioManager.playUiClick(\'secondary\');\\n              onMissionSelect();\\n            }}\\n            className=\\\"flex items-center justify-center gap-2 border border-slate-700 bg-[#081226] px-5 py-2.5 text-sm font-medium text-slate-200 transition-colors hover:border-cyan-400/60 hover:text-cyan-200\\\"\\n          >\\n            <List className=\\\"h-4 w-4 text-cyan-400\\\" />\\n            <span>Mission Select</span>\\n          </button>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onMouseEnter={() => AudioManager.playUiHover()}\\n            onClick={() => {\\n              AudioManager.playUiClick(\'secondary\');\\n              onMainMenu();\\n            }}\\n            className=\\\"flex items-center justify-center gap-2 border border-slate-800 bg-transparent px-5 py-2.5 text-sm font-medium text-slate-400 transition-colors hover:border-slate-600 hover:text-slate-100 sm:col-span-2\\\"\\n          >\\n            <Home className=\\\"h-4 w-4\\\" />\\n            <span>Main Menu</span>\\n          </button>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create MissionResultsOverlay showing victory/failure status, deterministic S/A/B/C rank breakdown, combat metrics, unlock banner, and post-mission actions\", \"Overwrite\":true, \"TargetFile\":\"/src/components/MissionResultsOverlay.tsx\", \"toolAction\":\"Creating MissionResultsOverlay component\", \"toolSummary\":\"Create MissionResultsOverlay component\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_15786545757922111089"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { AlertTriangle, RotateCcw, X } from \'lucide-react\';\\nimport { SHIP_CONFIGS } from \'../config/ships\';\\nimport type { LoadingProgress } from \'../types/game\';\\n\\ninterface LoadingScreenProps {\\n  progress: LoadingProgress;\\n  onCancel?: () => void;\\n  onRetry?: () => void;\\n}\\n\\nexport function LoadingScreen({ progress, onCancel, onRetry }: LoadingScreenProps) {\\n  const ship = SHIP_CONFIGS[progress.shipId];\\n  const hasError = Boolean(progress.error);\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-40 flex items-center justify-center bg-[#030712]/90 p-6\\\">\\n      <div className=\\\"w-full max-w-md border border-cyan-500/30 bg-[#050c1d]/96 p-7\\\">\\n        <div className=\\\"flex items-baseline justify-between\\\">\\n          <div>\\n            <h2 className=\\\"font-display text-xl font-bold tracking-widest text-slate-100\\\">\\n              {progress.missionCode ? `${progress.missionCode} \302\267 ${progress.missionName}` : \'STARFALL\'}\\n            </h2>\\n            {progress.sectorName && (\\n              <p className=\\\"mt-0.5 font-mono text-[11px] text-slate-400\\\">\\n                {progress.sectorName}\\n              </p>\\n            )}\\n          </div>\\n          {!hasError && (\\n            <span className=\\\"font-mono text-xs tabular-nums text-cyan-300\\\">\\n              {Math.round(progress.percent)}%\\n            </span>\\n          )}\\n        </div>\\n\\n        {hasError ? (\\n          <div className=\\\"mt-5\\\">\\n            <div className=\\\"flex items-start gap-2.5 border border-red-500/40 bg-red-950/35 p-3.5 text-xs text-red-200\\\">\\n              <AlertTriangle className=\\\"mt-0.5 h-4 w-4 shrink-0 text-red-400\\\" />\\n              <div>\\n                <div className=\\\"font-semibold\\\">Mission Asset Load Failed</div>\\n                <p className=\\\"mt-1 text-red-200/80\\\">{progress.error}</p>\\n              </div>\\n            </div>\\n            <div className=\\\"mt-4 flex gap-2.5\\\">\\n              {onRetry && (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={onRetry}\\n                  className=\\\"flex flex-1 items-center justify-center gap-2 bg-cyan-500 px-4 py-2.5 text-xs font-semibold text-slate-950 transition-colors hover:bg-cyan-400\\\"\\n                >\\n                  <RotateCcw className=\\\"h-3.5 w-3.5\\\" />\\n                  <span>Retry Load</span>\\n                </button>\\n              )}\\n              {onCancel && (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={onCancel}\\n                  className=\\\"border border-slate-700 bg-[#081226] px-4 py-2.5 text-xs font-medium text-slate-200 transition-colors hover:border-cyan-400/60\\\"\\n                >\\n                  Mission Select\\n                </button>\\n              )}\\n            </div>\\n          </div>\\n        ) : (\\n          <>\\n            <div className=\\\"mt-4 h-1.5 w-full overflow-hidden bg-slate-800\\\">\\n              <div\\n                className=\\\"h-full origin-left bg-cyan-400 transition-transform duration-150\\\"\\n                style={{ transform: `scaleX(${Math.max(0.05, progress.percent / 100)})` }}\\n              />\\n            </div>\\n\\n            <div className=\\\"mt-4 flex flex-col gap-1 text-xs\\\">\\n              <div className=\\\"flex items-center justify-between text-slate-300\\\">\\n                <span>Selected Craft</span>\\n                <span className=\\\"font-mono text-slate-100\\\">\\n                  {ship.callsign} \302\267 {ship.name}\\n                </span>\\n              </div>\\n              <p className=\\\"mt-2 border-t border-slate-800 pt-2.5 font-mono text-[11px] text-cyan-300/90\\\">\\n                {progress.stage}\\n              </p>\\n            </div>\\n\\n            {onCancel && (\\n              <div className=\\\"mt-5 flex justify-end\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={onCancel}\\n                  className=\\\"flex items-center gap-1.5 border border-slate-700/80 px-3 py-1.5 text-xs text-slate-400 transition-colors hover:border-slate-500 hover:text-slate-200\\\"\\n                >\\n                  <X className=\\\"h-3.5 w-3.5\\\" />\\n                  <span>Cancel</span>\\n                </button>\\n              </div>\\n            )}\\n          </>\\n        )}\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Upgrade LoadingScreen with mission details, cancel abort button, and structured error recovery UI\", \"Overwrite\":true, \"TargetFile\":\"/src/components/LoadingScreen.tsx\", \"toolAction\":\"Upgrading LoadingScreen with cancel and error recovery\", \"toolSummary\":\"Upgrade LoadingScreen component\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_15786545757922108486"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { Volume2 } from \'lucide-react\';\\nimport { AudioManager } from \'../audio/AudioManager\';\\nimport { getGraphicsPresetPatch } from \'../config/graphics\';\\nimport { DEFAULT_SETTINGS } from \'../config/ships\';\\nimport type {\\n  EffectQuality,\\n  GameSettings,\\n  GraphicsQuality,\\n  ShadowQuality,\\n} from \'../types/game\';\\n\\ninterface SettingsPanelProps {\\n  settings: GameSettings;\\n  onUpdateSettings: (patch: Partial<GameSettings>) => void;\\n  onClose: () => void;\\n  closeLabel?: string;\\n}\\n\\nconst QUALITY_OPTIONS: Array<{ value: GraphicsQuality; label: string }> = [\\n  { value: \'low\', label: \'Low\' },\\n  { value: \'medium\', label: \'Medium\' },\\n  { value: \'high\', label: \'High\' },\\n  { value: \'ultra\', label: \'Ultra\' },\\n];\\n\\nconst SHADOW_OPTIONS: Array<{ value: ShadowQuality; label: string }> = [\\n  { value: \'off\', label: \'Off\' },\\n  { value: \'low\', label: \'Low\' },\\n  { value: \'medium\', label: \'Med\' },\\n  { value: \'high\', label: \'High\' },\\n];\\n\\nconst EFFECT_OPTIONS: Array<{ value: EffectQuality; label: string }> = [\\n  { value: \'low\', label: \'Low\' },\\n  { value: \'medium\', label: \'Med\' },\\n  { value: \'high\', label: \'High\' },\\n];\\n\\nexport function SettingsPanel({\\n  settings,\\n  onUpdateSettings,\\n  onClose,\\n  closeLabel = \'Back\',\\n}: SettingsPanelProps) {\\n  return (\\n    <div className=\\\"max-h-[90vh] w-full max-w-2xl overflow-y-auto border border-slate-700/80 bg-[#050c1d]/96 p-6 sm:p-7\\\">\\n      <div className=\\\"flex items-center justify-between border-b border-slate-800 pb-4\\\">\\n        <div>\\n          <h2 className=\\\"font-display text-2xl font-semibold tracking-wide text-slate-100\\\">\\n            Flight, Graphics & Audio Settings\\n          </h2>\\n          <p className=\\\"mt-0.5 text-xs text-slate-400\\\">\\n            All graphics and flight parameters apply immediately and persist locally.\\n          </p>\\n        </div>\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => {\\n            AudioManager.playUiClick(\'secondary\');\\n            onUpdateSettings({ ...DEFAULT_SETTINGS });\\n          }}\\n          className=\\\"border border-slate-700 px-3 py-1.5 text-xs font-medium text-slate-300 transition-colors hover:border-cyan-400/60 hover:text-cyan-200 whitespace-nowrap shrink-0\\\"\\n        >\\n          Reset Defaults\\n        </button>\\n      </div>\\n\\n      <div className=\\\"mt-5 grid grid-cols-1 gap-6 md:grid-cols-2\\\">\\n        {/* Left Column: Flight & Audio Controls */}\\n        <div className=\\\"space-y-4\\\">\\n          <h3 className=\\\"font-mono text-[11px] tracking-widest text-cyan-300\\\">\\n            FLIGHT & AUDIO\\n          </h3>\\n\\n          <div>\\n            <div className=\\\"flex items-center justify-between text-xs\\\">\\n              <label htmlFor=\\\"setting-mouse-sens\\\" className=\\\"font-medium text-slate-200\\\">\\n                Mouse Sensitivity\\n              </label>\\n              <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                {settings.mouseSensitivity.toFixed(2)}x\\n              </span>\\n            </div>\\n            <input\\n              id=\\\"setting-mouse-sens\\\"\\n              type=\\\"range\\\"\\n              min={0.3}\\n              max={2.4}\\n              step={0.05}\\n              value={settings.mouseSensitivity}\\n              onChange={(e) => onUpdateSettings({ mouseSensitivity: parseFloat(e.target.value) })}\\n              className=\\\"starfall-slider mt-1.5 w-full\\\"\\n            />\\n          </div>\\n\\n          <div>\\n            <div className=\\\"flex items-center justify-between text-xs\\\">\\n              <label htmlFor=\\\"setting-cam-dist\\\" className=\\\"font-medium text-slate-200\\\">\\n                Chase Camera Distance\\n              </label>\\n              <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                {settings.cameraDistance.toFixed(1)} m\\n              </span>\\n            </div>\\n            <input\\n              id=\\\"setting-cam-dist\\\"\\n              type=\\\"range\\\"\\n              min={7.2}\\n              max={13.5}\\n              step={0.2}\\n              value={settings.cameraDistance}\\n              onChange={(e) => onUpdateSettings({ cameraDistance: parseFloat(e.target.value) })}\\n              className=\\\"starfall-slider mt-1.5 w-full\\\"\\n            />\\n          </div>\\n\\n          <div>\\n            <div className=\\\"flex items-center justify-between text-xs\\\">\\n              <label htmlFor=\\\"setting-cam-sens\\\" className=\\\"font-medium text-slate-200\\\">\\n                Camera Responsiveness\\n              </label>\\n              <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                {settings.cameraSensitivity.toFixed(2)}x\\n              </span>\\n            </div>\\n            <input\\n              id=\\\"setting-cam-sens\\\"\\n              type=\\\"range\\\"\\n              min={0.6}\\n              max={1.6}\\n              step={0.05}\\n              value={settings.cameraSensitivity}\\n              onChange={(e) => onUpdateSettings({ cameraSensitivity: parseFloat(e.target.value) })}\\n              className=\\\"starfall-slider mt-1.5 w-full\\\"\\n            />\\n          </div>\\n\\n          <div>\\n            <div className=\\\"flex items-center justify-between text-xs\\\">\\n              <label htmlFor=\\\"setting-volume\\\" className=\\\"font-medium text-slate-200\\\">\\n                Master Volume\\n              </label>\\n              <div className=\\\"flex items-center gap-2.5\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    AudioManager.unlock();\\n                    AudioManager.playUiClick(\'primary\');\\n                  }}\\n                  className=\\\"flex items-center gap-1 text-[11px] text-cyan-300 hover:text-cyan-200\\\"\\n                >\\n                  <Volume2 className=\\\"h-3 w-3\\\" />\\n                  <span>Test</span>\\n                </button>\\n                <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                  {Math.round(settings.masterVolume * 100)}%\\n                </span>\\n              </div>\\n            </div>\\n            <input\\n              id=\\\"setting-volume\\\"\\n              type=\\\"range\\\"\\n              min={0}\\n              max={1}\\n              step={0.05}\\n              value={settings.masterVolume}\\n              onChange={(e) => {\\n                const v = parseFloat(e.target.value);\\n                onUpdateSettings({ masterVolume: v });\\n                AudioManager.setMasterVolume(v);\\n              }}\\n              className=\\\"starfall-slider mt-1.5 w-full\\\"\\n            />\\n          </div>\\n\\n          <label className=\\\"flex cursor-pointer items-center justify-between border border-slate-800 bg-[#081226] px-3 py-2 text-xs text-slate-200\\\">\\n            <span>Invert Pitch (Y-Axis)</span>\\n            <input\\n              type=\\\"checkbox\\\"\\n              checked={settings.invertY}\\n              onChange={(e) => {\\n                AudioManager.playUiClick(\'secondary\');\\n                onUpdateSettings({ invertY: e.target.checked });\\n              }}\\n              className=\\\"h-4 w-4 accent-cyan-400\\\"\\n            />\\n          </label>\\n\\n          {/* Development-only performance monitor toggle (completely omitted in production) */}\\n          {import.meta.env.DEV && (\\n            <label className=\\\"flex cursor-pointer items-center justify-between border border-cyan-500/30 bg-[#08142b] px-3 py-2 text-xs text-cyan-200\\\">\\n              <span>Dev Performance Monitor (F3)</span>\\n              <input\\n                type=\\\"checkbox\\\"\\n                checked={settings.showPerfOverlay}\\n                onChange={(e) => {\\n                  AudioManager.playUiClick(\'secondary\');\\n                  onUpdateSettings({ showPerfOverlay: e.target.checked });\\n                }}\\n                className=\\\"h-4 w-4 accent-cyan-400\\\"\\n              />\\n            </label>\\n          )}\\n        </div>\\n\\n        {/* Right Column: Adaptive Graphics Presets & Granular Controls */}\\n        <div className=\\\"space-y-4\\\">\\n          <h3 className=\\\"font-mono text-[11px] tracking-widest text-cyan-300\\\">\\n            GRAPHICS & PERFORMANCE\\n          </h3>\\n\\n          {/* Overall Quality Preset */}\\n          <div>\\n            <span className=\\\"text-xs font-medium text-slate-200\\\">Quality Preset</span>\\n            <div className=\\\"mt-1.5 grid grid-cols-4 border border-slate-700 bg-[#081226] p-1\\\">\\n              {QUALITY_OPTIONS.map((opt) => {\\n                const active = settings.graphicsQuality === opt.value;\\n                return (\\n                  <button\\n                    key={opt.value}\\n                    type=\\\"button\\\"\\n                    onClick={() => {\\n                      AudioManager.playUiClick(\'secondary\');\\n                      onUpdateSettings(getGraphicsPresetPatch(opt.value));\\n                    }}\\n                    className={`py-1.5 text-xs font-medium transition-colors ${\\n                      active ? \'bg-cyan-500 text-slate-950\' : \'text-slate-300 hover:text-cyan-200\'\\n                    }`}\\n                  >\\n                    {opt.label}\\n                  </button>\\n                );\\n              })}\\n            </div>\\n          </div>\\n\\n          {/* Resolution Scale */}\\n          <div>\\n            <div className=\\\"flex items-center justify-between text-xs\\\">\\n              <label htmlFor=\\\"setting-res-scale\\\" className=\\\"font-medium text-slate-200\\\">\\n                Resolution Scale\\n              </label>\\n              <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                {Math.round(settings.resolutionScale * 100)}%\\n              </span>\\n            </div>\\n            <input\\n              id=\\\"setting-res-scale\\\"\\n              type=\\\"range\\\"\\n              min={0.65}\\n              max={1.0}\\n              step={0.05}\\n              value={settings.resolutionScale}\\n              onChange={(e) => onUpdateSettings({ resolutionScale: parseFloat(e.target.value) })}\\n              className=\\\"starfall-slider mt-1.5 w-full\\\"\\n            />\\n          </div>\\n\\n          {/* Shadow Quality */}\\n          <div className=\\\"flex items-center justify-between gap-2\\\">\\n            <span className=\\\"text-xs font-medium text-slate-200\\\">Shadows</span>\\n            <div className=\\\"flex border border-slate-700 bg-[#081226] p-0.5\\\">\\n              {SHADOW_OPTIONS.map((opt) => (\\n                <button\\n                  key={opt.value}\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    AudioManager.playUiClick(\'secondary\');\\n                    onUpdateSettings({ shadowQuality: opt.value });\\n                  }}\\n                  className={`px-2.5 py-1 text-[11px] font-medium transition-colors ${\\n                    settings.shadowQuality === opt.value\\n                      ? \'bg-cyan-500 text-slate-950\'\\n                      : \'text-slate-300 hover:text-cyan-200\'\\n                  }`}\\n                >\\n                  {opt.label}\\n                </button>\\n              ))}\\n            </div>\\n          </div>\\n\\n          {/* Particle / Effect Quality */}\\n          <div className=\\\"flex items-center justify-between gap-2\\\">\\n            <span className=\\\"text-xs font-medium text-slate-200\\\">Particle & VFX</span>\\n            <div className=\\\"flex border border-slate-700 bg-[#081226] p-0.5\\\">\\n              {EFFECT_OPTIONS.map((opt) => (\\n                <button\\n                  key={opt.value}\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    AudioManager.playUiClick(\'secondary\');\\n                    onUpdateSettings({ particleQuality: opt.value });\\n                  }}\\n                  className={`px-2.5 py-1 text-[11px] font-medium transition-colors ${\\n                    settings.particleQuality === opt.value\\n                      ? \'bg-cyan-500 text-slate-950\'\\n                      : \'text-slate-300 hover:text-cyan-200\'\\n                  }`}\\n                >\\n                  {opt.label}\\n                </button>\\n              ))}\\n            </div>\\n          </div>\\n\\n          {/* Environment Detail */}\\n          <div className=\\\"flex items-center justify-between gap-2\\\">\\n            <span className=\\\"text-xs font-medium text-slate-200\\\">Environment Detail</span>\\n            <div className=\\\"flex border border-slate-700 bg-[#081226] p-0.5\\\">\\n              {EFFECT_OPTIONS.map((opt) => (\\n                <button\\n                  key={opt.value}\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    AudioManager.playUiClick(\'secondary\');\\n                    onUpdateSettings({ environmentDetail: opt.value });\\n                  }}\\n                  className={`px-2.5 py-1 text-[11px] font-medium transition-colors ${\\n                    settings.environmentDetail === opt.value\\n                      ? \'bg-cyan-500 text-slate-950\'\\n                      : \'text-slate-300 hover:text-cyan-200\'\\n                  }`}\\n                >\\n                  {opt.label}\\n                </button>\\n              ))}\\n            </div>\\n          </div>\\n\\n          {/* Draw Distance */}\\n          <div>\\n            <div className=\\\"flex items-center justify-between text-xs\\\">\\n              <label htmlFor=\\\"setting-draw-dist\\\" className=\\\"font-medium text-slate-200\\\">\\n                Draw Distance\\n              </label>\\n              <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                {Math.round(settings.drawDistance)} m\\n              </span>\\n            </div>\\n            <input\\n              id=\\\"setting-draw-dist\\\"\\n              type=\\\"range\\\"\\n              min={2000}\\n              max={5200}\\n              step={200}\\n              value={settings.drawDistance}\\n              onChange={(e) => onUpdateSettings({ drawDistance: parseFloat(e.target.value) })}\\n              className=\\\"starfall-slider mt-1.5 w-full\\\"\\n            />\\n          </div>\\n\\n          {/* Anti-Aliasing & Glow Toggles */}\\n          <div className=\\\"grid grid-cols-2 gap-2\\\">\\n            <label className=\\\"flex cursor-pointer items-center justify-between border border-slate-800 bg-[#081226] px-2.5 py-2 text-[11px] text-slate-200\\\">\\n              <span>Anti-Aliasing</span>\\n              <input\\n                type=\\\"checkbox\\\"\\n                checked={settings.antialias}\\n                onChange={(e) => {\\n                  AudioManager.playUiClick(\'secondary\');\\n                  onUpdateSettings({ antialias: e.target.checked });\\n                }}\\n                className=\\\"h-3.5 w-3.5 accent-cyan-400\\\"\\n              />\\n            </label>\\n            <label className=\\\"flex cursor-pointer items-center justify-between border border-slate-800 bg-[#081226] px-2.5 py-2 text-[11px] text-slate-200\\\">\\n              <span>Atmosphere Glow</span>\\n              <input\\n                type=\\\"checkbox\\\"\\n                checked={settings.postGlowEnabled}\\n                onChange={(e) => {\\n                  AudioManager.playUiClick(\'secondary\');\\n                  onUpdateSettings({ postGlowEnabled: e.target.checked });\\n                }}\\n                className=\\\"h-3.5 w-3.5 accent-cyan-400\\\"\\n              />\\n            </label>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <div className=\\\"mt-6 flex justify-end border-t border-slate-800 pt-4\\\">\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => {\\n            AudioManager.playUiClick(\'primary\');\\n            onClose();\\n          }}\\n          className=\\\"bg-cyan-500 px-6 py-2.5 text-sm font-semibold text-slate-950 transition-colors hover:bg-cyan-400 focus-visible:outline-2 focus-visible:outline-cyan-300 whitespace-nowrap shrink-0\\\"\\n        >\\n          {closeLabel}\\n        </button>\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Upgrade SettingsPanel with Low/Medium/High/Ultra presets, granular resolution/shadow/particle/environment/draw-distance/AA/glow controls, and dev-only Performance Monitor toggle\", \"Overwrite\":true, \"TargetFile\":\"/src/components/SettingsPanel.tsx\", \"toolAction\":\"Upgrading SettingsPanel graphics controls\", \"toolSummary\":\"Upgrade SettingsPanel graphics controls\"}"
      original_name: "write_to_file"
    }
