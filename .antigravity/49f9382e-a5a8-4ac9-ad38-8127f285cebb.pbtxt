        instruction: "Update CombatManager.ts projectHudTelemetry so aimScreenX/Y stays owned by FlightController\'s persistent virtual cursor while boresightScreenX/Y tracks the ship\'s 3D convergence ray."
        is_edit: true
        file {
          absolute_uri: "file:///src/engine/combat/CombatManager.ts"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "  private projectHudTelemetry(\n    flight: FlightController,\n    camera: THREE.PerspectiveCamera,\n    telemetry: FlightTelemetry,\n  ): void {\n    // 1. Project true 3D Aim Reticle point (guaranteed exact match to weapon convergence ray!)\n    flight.getAimTargetPoint(_aimTarget, this.playerWeapon.convergenceDistance);\n    _projVec.copy(_aimTarget).project(camera);\n    telemetry.aimScreenX = THREE.MathUtils.clamp((_projVec.x + 1) * 0.5, 0.05, 0.95);\n    telemetry.aimScreenY = THREE.MathUtils.clamp((1 - _projVec.y) * 0.5, 0.06, 0.94);\n\n    // 2. Project Ship Nose Boresight reference chevron\n    _forwardVec.set(0, 0, -1).applyQuaternion(flight.quaternion);\n    _projVec.copy(flight.position).addScaledVector(_forwardVec, 240).project(camera);\n    telemetry.boresightScreenX = THREE.MathUtils.clamp((_projVec.x + 1) * 0.5, 0.05, 0.95);\n    telemetry.boresightScreenY = THREE.MathUtils.clamp((1 - _projVec.y) * 0.5, 0.06, 0.94);\n\n    // 3. Project Active Enemy Markers & Identify Primary Target Closest to Aim Ray"
          replacement_content: "  private projectHudTelemetry(\n    flight: FlightController,\n    camera: THREE.PerspectiveCamera,\n    telemetry: FlightTelemetry,\n  ): void {\n    // 1. Project true 3D cannon convergence / ship boresight point onto viewport\n    //    (Do NOT overwrite telemetry.aimScreenX/Y \342\200\224 those hold the persistent virtual mouse cursor!)\n    flight.getAimTargetPoint(_aimTarget, this.playerWeapon.convergenceDistance);\n    _projVec.copy(_aimTarget).project(camera);\n    telemetry.boresightScreenX = THREE.MathUtils.clamp((_projVec.x + 1) * 0.5, 0.05, 0.95);\n    telemetry.boresightScreenY = THREE.MathUtils.clamp((1 - _projVec.y) * 0.5, 0.06, 0.94);\n\n    // 2. Project Active Enemy Markers & Identify Primary Target Closest to Boresight / Aim Ray"
          start_line: 683
          end_line: 704
        }
      }
    }
