  code_action {
    action_spec {
      create_file {
        instruction: "import { useState } from \'react\';\nimport { Home, Play, RotateCcw, SlidersHorizontal } from \'lucide-react\';\nimport { AudioManager } from \'../audio/AudioManager\';\nimport type { GameSettings } from \'../types/game\';\nimport { SettingsPanel } from \'./SettingsPanel\';\n\ninterface PauseOverlayProps {\n  settings: GameSettings;\n  onUpdateSettings: (patch: Partial<GameSettings>) => void;\n  onResume: () => void;\n  onResetPosition: () => void;\n  onReturnToMenu: () => void;\n}\n\nexport function PauseOverlay({\n  settings,\n  onUpdateSettings,\n  onResume,\n  onResetPosition,\n  onReturnToMenu,\n}: PauseOverlayProps) {\n  const [showSettings, setShowSettings] = useState(false);\n\n  if (showSettings) {\n    return (\n      <div className=\"fixed inset-0 z-30 flex items-center justify-center bg-[#030712]/72 p-6\">\n        <SettingsPanel\n          settings={settings}\n          onUpdateSettings={onUpdateSettings}\n          onClose={() => setShowSettings(false)}\n          closeLabel=\"Back to Pause Menu\"\n        />\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"fixed inset-0 z-30 flex items-center justify-center bg-[#030712]/70 p-6\">\n      <div className=\"w-full max-w-sm border border-cyan-500/30 bg-[#050c1d]/95 p-7\">\n        <div className=\"border-b border-slate-800 pb-4\">\n          <h2 className=\"font-display text-2xl font-bold tracking-wider text-slate-100\">\n            Flight Paused\n          </h2>\n          <p className=\"mt-1 text-xs text-slate-400\">\n            Cursor released. Resume to re-engage mouse steering.\n          </p>\n        </div>\n\n        <div className=\"mt-5 flex flex-col gap-2.5\">\n          <button\n            type=\"button\"\n            onMouseEnter={() => AudioManager.playUiHover()}\n            onClick={() => {\n              AudioManager.unlock();\n              AudioManager.playUiClick(\'primary\');\n              onResume();\n            }}\n            className=\"flex items-center justify-center gap-2.5 bg-cyan-500 px-5 py-3 text-sm font-semibold text-slate-950 transition-colors hover:bg-cyan-400 focus-visible:outline-2 focus-visible:outline-cyan-300\"\n          >\n            <Play className=\"h-4 w-4 fill-current\" />\n            <span>Resume Flight</span>\n          </button>\n\n          <button\n            type=\"button\"\n            onMouseEnter={() => AudioManager.playUiHover()}\n            onClick={() => {\n              AudioManager.playUiClick(\'secondary\');\n              setShowSettings(true);\n            }}\n            className=\"flex items-center justify-center gap-2.5 border border-slate-700 bg-[#081226] px-5 py-2.5 text-sm font-medium text-slate-200 transition-colors hover:border-cyan-400/60 hover:text-cyan-200\"\n          >\n            <SlidersHorizontal className=\"h-4 w-4 text-cyan-400\" />\n            <span>Settings</span>\n          </button>\n\n          <button\n            type=\"button\"\n            onMouseEnter={() => AudioManager.playUiHover()}\n            onClick={() => {\n              AudioManager.playUiClick(\'secondary\');\n              onResetPosition();\n            }}\n            className=\"flex items-center justify-center gap-2.5 border border-slate-700 bg-[#081226] px-5 py-2.5 text-sm font-medium text-slate-200 transition-colors hover:border-cyan-400/60 hover:text-cyan-200\"\n          >\n            <RotateCcw className=\"h-4 w-4 text-cyan-400\" />\n            <span>Reset Flight Position</span>\n          </button>\n\n          <button\n            type=\"button\"\n            onMouseEnter={() => AudioManager.playUiHover()}\n            onClick={() => {\n              AudioManager.playUiClick(\'pause\');\n              onReturnToMenu();\n            }}\n            className=\"flex items-center justify-center gap-2.5 border border-slate-800 bg-transparent px-5 py-2.5 text-sm font-medium text-slate-400 transition-colors hover:border-slate-600 hover:text-slate-100\"\n          >\n            <Home className=\"h-4 w-4\" />\n            <span>Main Menu</span>\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/PauseOverlay.tsx"
        }
        overwrite: true
      }
    }
