            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  void main() {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    vec3 d = normalize(vDir);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
