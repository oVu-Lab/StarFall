            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // 1. Primary sculpted fuselage spine (tapered needle nose toward -Z)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const noseGeo = trackGeo(new THREE.ConeGeometry(fuselageWidth * 0.52, fuselageLength * 0.56, 6));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  noseGeo.rotateX(-Math.PI / 2);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  noseGeo.scale(1.0, fuselageHeight / fuselageWidth, 1.0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const noseMesh = new THREE.Mesh(noseGeo, hullPrimaryMat);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
