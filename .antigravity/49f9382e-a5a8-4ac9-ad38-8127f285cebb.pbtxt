          target_content: "  public updateChase(\n    dt: number,\n    flight: FlightController,\n    camera: THREE.PerspectiveCamera,\n    settings: GameSettings,\n    boostIntensity: number,\n    elapsedTime: number,\n  ): void {\n    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);\n\n    if (!this.initialized) {\n      this.snapToShip(flight, camera, settings.cameraDistance);\n      return;\n    }\n\n    _forward.set(0, 0, -1).applyQuaternion(flight.quaternion).normalize();\n    _up.set(0, 1, 0).applyQuaternion(flight.quaternion).normalize();\n    _right.set(1, 0, 0).applyQuaternion(flight.quaternion).normalize();\n\n    // Subtle lateral & vertical turn lag so aggressive maneuvers feel dynamic\n    // Clamped strictly so the ship never leaves the center framing.\n    const camSens = settings.cameraSensitivity;\n    const lagX = THREE.MathUtils.clamp(-flight.yawVelocity * 0.72 * camSens, -1.6, 1.6);\n    const lagY = THREE.MathUtils.clamp(flight.pitchVelocity * 0.55 * camSens, -1.1, 1.1);\n\n    // Pull back slightly on boost to emphasize acceleration\n    const dynamicDist = settings.cameraDistance + boostIntensity * 1.45;\n    const heightOffset = 2.25 - boostIntensity * 0.25;\n\n    _offsetLocal.set(lagX, heightOffset + lagY, dynamicDist).applyQuaternion(flight.quaternion);\n    _desiredPos.copy(flight.position).add(_offsetLocal);\n\n    // Smooth frame-rate-independent positional follow\n    const posLambda = (10.5 + boostIntensity * 3.5) * THREE.MathUtils.clamp(camSens, 0.65, 1.5);\n    const posAlpha = 1 - Math.exp(-posLambda * safeDt);\n    this.currentPos.lerp(_desiredPos, posAlpha);\n\n    // Guardrail: never allow camera to drift far from ship during extreme turns\n    const maxAllowedDist = dynamicDist + 3.2;\n    const distFromShip = this.currentPos.distanceTo(flight.position);\n    if (distFromShip > maxAllowedDist) {\n      this.currentPos\n        .sub(flight.position)\n        .multiplyScalar(maxAllowedDist / distFromShip)\n        .add(flight.position);\n    }\n\n    // Smooth camera up-vector roll tracking (responsive yet fluid on A/D rolls)\n    const upAlpha = 1 - Math.exp(-(7.5 * camSens) * safeDt);\n    this.currentUp.lerp(_up, upAlpha).normalize();\n\n    // Look slightly ahead of the ship nose + gentle lead into turns\n    _lookTarget\n      .copy(flight.position)\n      .addScaledVector(_forward, 28)\n      .addScaledVector(_up, 0.75 + flight.pitchVelocity * 0.5)\n      .addScaledVector(_right, -flight.yawVelocity * 0.75);\n\n    _lookMatrix.lookAt(this.currentPos, _lookTarget, this.currentUp);\n    _desiredQuat.setFromRotationMatrix(_lookMatrix);\n\n    const rotAlpha = 1 - Math.exp(-(11.5 * camSens) * safeDt);\n    this.currentQuat.slerp(_desiredQuat, rotAlpha);\n\n    // Subtle high-frequency propulsion tremor strictly during active boost\n    camera.position.copy(this.currentPos);\n    if (boostIntensity > 0.02) {\n      const amp = 0.045 * boostIntensity;\n      _shakeVec\n        .set(\n          Math.sin(elapsedTime * 53.0) * amp,\n          Math.cos(elapsedTime * 61.0) * amp,\n          0,\n        )\n        .applyQuaternion(this.currentQuat);\n      camera.position.add(_shakeVec);\n    }\n\n    camera.quaternion.copy(this.currentQuat);\n\n    // Dynamic boost FOV widening\n    const targetFov = 62 + boostIntensity * 16.5;\n    const nextFov = THREE.MathUtils.damp(this.currentFov, targetFov, 7.0, safeDt);\n    if (Math.abs(nextFov - this.currentFov) > 0.01) {\n      this.currentFov = nextFov;\n      camera.fov = this.currentFov;\n      camera.updateProjectionMatrix();\n    }\n  }"
          replacement_content: "  public updateChase(\n    dt: number,\n    flight: FlightController,\n    camera: THREE.PerspectiveCamera,\n    settings: GameSettings,\n    boostIntensity: number,\n    elapsedTime: number,\n    combatImpulse = 0,\n  ): void {\n    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);\n\n    if (!this.initialized) {\n      this.snapToShip(flight, camera, settings.cameraDistance);\n      return;\n    }\n\n    _forward.set(0, 0, -1).applyQuaternion(flight.quaternion).normalize();\n    _up.set(0, 1, 0).applyQuaternion(flight.quaternion).normalize();\n    _right.set(1, 0, 0).applyQuaternion(flight.quaternion).normalize();\n\n    // Subtle lateral & vertical turn lag so aggressive maneuvers feel dynamic\n    // Clamped strictly so the ship never leaves center framing.\n    const camSens = settings.cameraSensitivity;\n    const lagX = THREE.MathUtils.clamp(-flight.yawVelocity * 0.65 * camSens, -1.65, 1.65);\n    const lagY = THREE.MathUtils.clamp(flight.pitchVelocity * 0.52 * camSens, -1.15, 1.15);\n\n    // Pull back slightly on boost to emphasize acceleration\n    const dynamicDist = settings.cameraDistance + boostIntensity * 1.45;\n    const heightOffset = 2.25 - boostIntensity * 0.25;\n\n    _offsetLocal.set(lagX, heightOffset + lagY, dynamicDist).applyQuaternion(flight.quaternion);\n    _desiredPos.copy(flight.position).add(_offsetLocal);\n\n    // Smooth frame-rate-independent positional follow\n    const posLambda = (10.5 + boostIntensity * 3.5) * THREE.MathUtils.clamp(camSens, 0.65, 1.5);\n    const posAlpha = 1 - Math.exp(-posLambda * safeDt);\n    this.currentPos.lerp(_desiredPos, posAlpha);\n\n    // Guardrail: never allow camera to drift far from ship during extreme turns\n    const maxAllowedDist = dynamicDist + 3.2;\n    const distFromShip = this.currentPos.distanceTo(flight.position);\n    if (distFromShip > maxAllowedDist) {\n      this.currentPos\n        .sub(flight.position)\n        .multiplyScalar(maxAllowedDist / distFromShip)\n        .add(flight.position);\n    }\n\n    // Smooth camera up-vector roll tracking (responsive yet fluid on A/D rolls)\n    const upAlpha = 1 - Math.exp(-(7.8 * camSens) * safeDt);\n    this.currentUp.lerp(_up, upAlpha).normalize();\n\n    // Gently blend look target toward the expanded gimbaled aim vector so wide aiming stays well framed\n    flight.getAimDirectionWorld(_lookTarget);\n    _lookTarget.lerp(_forward, 0.58).normalize();\n    _lookTarget.multiplyScalar(32).add(flight.position).addScaledVector(_up, 0.72);\n\n    _lookMatrix.lookAt(this.currentPos, _lookTarget, this.currentUp);\n    _desiredQuat.setFromRotationMatrix(_lookMatrix);\n\n    const rotAlpha = 1 - Math.exp(-(11.5 * camSens) * safeDt);\n    this.currentQuat.slerp(_desiredQuat, rotAlpha);\n\n    // Subtle high-frequency propulsion tremor during boost + brief combat impact impulse\n    camera.position.copy(this.currentPos);\n    const tremor = boostIntensity * 0.042 + combatImpulse * 0.14;\n    if (tremor > 0.004) {\n      _shakeVec\n        .set(\n          Math.sin(elapsedTime * 57.0) * tremor,\n          Math.cos(elapsedTime * 67.0) * tremor,\n          0,\n        )\n        .applyQuaternion(this.currentQuat);\n      camera.position.add(_shakeVec);\n    }\n\n    camera.quaternion.copy(this.currentQuat);\n\n    // Dynamic boost FOV widening\n    const targetFov = 62 + boostIntensity * 16.5;\n    const nextFov = THREE.MathUtils.damp(this.currentFov, targetFov, 7.0, safeDt);\n    if (Math.abs(nextFov - this.currentFov) > 0.01) {\n      this.currentFov = nextFov;\n      camera.fov = this.currentFov;\n      camera.updateProjectionMatrix();\n    }\n  }"
