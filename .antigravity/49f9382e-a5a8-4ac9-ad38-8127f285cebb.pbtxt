              text: "    const accelDist = THREE.MathUtils.clamp(settings.accelerationDistance, 80, 500);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const baseSens = THREE.MathUtils.clamp(settings.mouseSensitivity, 0.3, 2.5);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
