              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Evaluate progressive response independently for horizontal (yaw) and vertical (pitch)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    evaluateProgressiveAxisSensitivity("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      Math.abs(this.virtualAimX),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      boundaryX,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      accelDist,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      boundarySens,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
