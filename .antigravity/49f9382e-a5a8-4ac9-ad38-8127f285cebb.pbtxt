              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  private resolveProjectileCollisions(flight: FlightController, playerAlive: boolean): void {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const items = this.projectiles.items;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
