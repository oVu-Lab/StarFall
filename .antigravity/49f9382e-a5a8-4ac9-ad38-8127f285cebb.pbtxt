            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Progressive Three-Zone Mouse Steering Configuration."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Independent horizontal (yaw) & vertical (pitch) displacement model:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * - Zone 1 (Precision, |x| <= B): Normal sensitivity (1.0x) with smooth boundary approach"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *   blending over [0.80B .. 1.00B] down to `boundarySensitivity` for zero-jump C1 continuity."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * - Zone 2 (Transition, |x| > B while sensitivity(e) < 1.0): Steering initially slows to"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *   `boundarySensitivity` then climbs smoothly via f(e) = e^p / (1 + e^p)."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * - Zone 3 (Acceleration, |x| > B while sensitivity(e) >= 1.0): Continued outward mouse motion"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *   asymptotically accelerates toward `maxSensitivity` without hitting a hard steering cutoff."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * - Delta-time exponential recovery smoothing (tau = 0.12s) keeps transitions and return-to-precision"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *   free of sudden rotation spikes across any frame rate."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "export const PROGRESSIVE_STEERING_CONFIG = {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  /** Virtual mouse pixels per 1.0 screen-fraction of aimBoundarySize (0.25 -> B = 200px) */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  boundaryPixelsPerFraction: 800,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  /** Vertical boundary pixel scale relative to horizontal boundary */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  verticalBoundaryRatio: 0.92,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  /** Vertical HUD visual boundary aspect multiplier relative to aimBoundarySize */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  verticalScreenAspectRatio: 1.04,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  /** Maximum vertical HUD boundary half-height fraction */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  maxVerticalScreenOffset: 0.38,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  /** Tiny center deadzone (fraction of B) for drift-free straight flight */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  deadzone: 0.03,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  /** Mild inner-zone shaping exponent for crisp precision near center */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  precisionExponent: 1.15,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  /** Fraction of B where smoothstep transition toward boundarySensitivity begins */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  boundaryBlendStart: 0.8,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  /** Time constant (seconds) for smooth sensitivity transitions & return to precision */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  recoverySmoothingSec: 0.12,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  /** Upper displacement buffer in multiples of S past B (at e=4.0, f(4)=0.941) */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  maxExcessScales: 4.0,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  /** Subtle visual reticle tension stretch past boundary (fraction of viewport, keeps reticle clear of HUD) */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  overdriveReticleStretch: 0.028,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  /** Safety angular velocity ceiling multipliers to prevent uncontrollable spin */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  maxSafeYawMultiplier: 3.2,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  maxSafePitchMultiplier: 3.0,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "} as const;"
