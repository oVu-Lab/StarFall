            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // 1. Bounded Virtual-Aim Relative Mouse Steering (Zero Auto-Recenter, Smooth Elliptical Limit)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const cursorScale = (1 / VIRTUAL_AIM_CONFIG.pixelsToBoundary) * settings.mouseSensitivity;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // 1. Progressive Three-Zone Relative Mouse Steering (Independent X & Y Axes, Zero Auto-Recenter)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const boundarySize = THREE.MathUtils.clamp(settings.aimBoundarySize, 0.15, 0.38);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const boundaryX = boundarySize * PROGRESSIVE_STEERING_CONFIG.boundaryPixelsPerFraction;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const boundaryY = boundaryX * PROGRESSIVE_STEERING_CONFIG.verticalBoundaryRatio;"
