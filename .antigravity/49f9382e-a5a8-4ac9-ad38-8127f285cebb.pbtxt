        instruction: "import type { GraphicsQuality } from \'../types/game\';\n\nexport interface GraphicsPreset {\n  dprCap: number;\n  antialias: boolean;\n  shadows: boolean;\n  starCount: number;\n  asteroidCount: number;\n  speedLineCount: number;\n  planetSegments: number;\n  drawDistance: number;\n}\n\nexport const GRAPHICS_PRESETS: Record<GraphicsQuality, GraphicsPreset> = {\n  low: {\n    dprCap: 1.0,\n    antialias: false,\n    shadows: false,\n    starCount: 1600,\n    asteroidCount: 80,\n    speedLineCount: 120,\n    planetSegments: 32,\n    drawDistance: 2400,\n  },\n  medium: {\n    dprCap: 1.5,\n    antialias: true,\n    shadows: false,\n    starCount: 2800,\n    asteroidCount: 140,\n    speedLineCount: 200,\n    planetSegments: 48,\n    drawDistance: 3200,\n  },\n  high: {\n    dprCap: 2.0,\n    antialias: true,\n    shadows: true,\n    starCount: 4200,\n    asteroidCount: 210,\n    speedLineCount: 280,\n    planetSegments: 64,\n    drawDistance: 4200,\n  },\n};\n\nlet cachedSoftwareGl: boolean | null = null;\n\n/**\n * Detects software WebGL renderers (SwiftShader, llvmpipe, WARP) from the GPU renderer string.\n * Used strictly to scale rendering cost (DPR, antialiasing, shadows) without altering scene content.\n */\nexport function isSoftwareWebGL(): boolean {\n  if (cachedSoftwareGl !== null) return cachedSoftwareGl;\n  try {\n    const canvas = document.createElement(\'canvas\');\n    const gl = canvas.getContext(\'webgl2\') || canvas.getContext(\'webgl\');\n    if (!gl) {\n      cachedSoftwareGl = true;\n      return true;\n    }\n    const ext = gl.getExtension(\'WEBGL_debug_renderer_info\');\n    const param = ext ? ext.UNMASKED_RENDERER_WEBGL : gl.RENDERER;\n    const gpu = String(gl.getParameter(param) ?? \'\');\n    gl.getExtension(\'WEBGL_lose_context\')?.loseContext();\n    cachedSoftwareGl = /SwiftShader|llvmpipe|softpipe|Software|Basic Render/i.test(gpu);\n    return cachedSoftwareGl;\n  } catch {\n    cachedSoftwareGl = false;\n    return false;\n  }\n}\n\nexport function resolveEffectiveGraphics(quality: GraphicsQuality): GraphicsPreset {\n  const base = GRAPHICS_PRESETS[quality];\n  if (!isSoftwareWebGL()) return base;\n  // On software WebGL, preserve scene content & counts while capping pixel cost\n  return {\n    ...base,\n    dprCap: 1.0,\n    antialias: false,\n    shadows: false,\n  };\n}\n"
        path {
          absolute_uri: "file:///src/config/graphics.ts"
        }
        overwrite: true
      }
    }
