              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (aimReticleRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const recoilScale = t.isFiring ? 1 + t.weaponCooldownRatio * 0.14 : 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        aimReticleRef.current.style.transform = `translate3d(${aimPxX.toFixed(1)}px, ${aimPxY.toFixed(1)}px, 0) translate(-50%, -50%) scale(${recoilScale.toFixed(3)})`;"
