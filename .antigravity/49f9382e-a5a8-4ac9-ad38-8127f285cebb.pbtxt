            }
            lines {
              text: "      f.z"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    );"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  float fbm(vec3 p) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    float v = 0.0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    float a = 0.52;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    for (int i = 0; i < 4; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    for (int i = 0; i < 5; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (i >= uOctaves) break;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      v += a * noise(p);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      p = p * 2.04 + vec3(13.1, 7.7, 5.3);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
