            }
            lines {
              text: "    _desiredPos.copy(flight.position).add(_offsetLocal);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Smooth frame-rate-independent positional follow"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const posLambda = (10.5 + boostIntensity * 3.5) * THREE.MathUtils.clamp(camSens, 0.65, 1.5);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const posAlpha = 1 - Math.exp(-posLambda * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.currentPos.lerp(_desiredPos, posAlpha);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Guardrail: never allow camera to drift far from ship during extreme turns"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const maxAllowedDist = dynamicDist + 3.2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const distFromShip = this.currentPos.distanceTo(flight.position);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (distFromShip > maxAllowedDist) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.currentPos"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        .sub(flight.position)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        .multiplyScalar(maxAllowedDist / distFromShip)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        .add(flight.position);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Smooth camera up-vector roll tracking (responsive yet fluid on A/D rolls)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const upAlpha = 1 - Math.exp(-(7.5 * camSens) * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.currentUp.lerp(_up, upAlpha).normalize();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Look slightly ahead of the ship nose + gentle lead into turns"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    _lookTarget"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      .copy(flight.position)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      .addScaledVector(_forward, 28)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      .addScaledVector(_up, 0.75 + flight.pitchVelocity * 0.5)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      .addScaledVector(_right, -flight.yawVelocity * 0.75);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    _lookMatrix.lookAt(this.currentPos, _lookTarget, this.currentUp);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    _desiredQuat.setFromRotationMatrix(_lookMatrix);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const rotAlpha = 1 - Math.exp(-(11.5 * camSens) * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.currentQuat.slerp(_desiredQuat, rotAlpha);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Subtle high-frequency propulsion tremor strictly during active boost"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    camera.position.copy(this.currentPos);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (boostIntensity > 0.02) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const amp = 0.045 * boostIntensity;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      _shakeVec"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        .set("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          Math.sin(elapsedTime * 53.0) * amp,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          Math.cos(elapsedTime * 61.0) * amp,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        .applyQuaternion(this.currentQuat);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      camera.position.add(_shakeVec);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    camera.quaternion.copy(this.currentQuat);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Dynamic boost FOV widening"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const targetFov = 62 + boostIntensity * 16.5;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const nextFov = THREE.MathUtils.damp(this.currentFov, targetFov, 7.0, safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (Math.abs(nextFov - this.currentFov) > 0.01) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.currentFov = nextFov;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      camera.fov = this.currentFov;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      camera.updateProjectionMatrix();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   * Cinematic showcase camera used on the Main Menu and Hangar screens."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  public updateShowcase("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    dt: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    targetPos: THREE.Vector3,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    camera: THREE.PerspectiveCamera,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    mode: \'menu\' | \'hangar\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    manualYawOffset = 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    manualPitchOffset = 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ): void {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.orbitTime += safeDt * (mode === \'hangar\' ? 0.22 : 0.14);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const radius = mode === \'hangar\' ? 9.6 : 11.4;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const angle = (mode === \'hangar\' ? 0.7 : 0.55) + this.orbitTime + manualYawOffset;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const elevation ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      mode === \'hangar\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ? THREE.MathUtils.clamp(2.2 + manualPitchOffset * 4.0, -1.5, 5.2)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        : 2.8 + Math.sin(this.orbitTime * 0.7) * 0.7;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Offset slightly right on menu so the fighter frames beautifully beside left-aligned menu actions"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const framingOffsetX = mode === \'menu\' ? -2.2 : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    _desiredPos.set("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      targetPos.x + Math.sin(angle) * radius,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      targetPos.y + elevation,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      targetPos.z + Math.cos(angle) * radius,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const alpha = 1 - Math.exp(-4.5 * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.currentPos.lerp(_desiredPos, alpha);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    _lookTarget.set(targetPos.x + framingOffsetX, targetPos.y + 0.25, targetPos.z);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    _lookMatrix.lookAt(this.currentPos, _lookTarget, _up.set(0, 1, 0));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    _desiredQuat.setFromRotationMatrix(_lookMatrix);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.currentQuat.slerp(_desiredQuat, alpha);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    camera.position.copy(this.currentPos);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    camera.quaternion.copy(this.currentQuat);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const targetFov = mode === \'hangar\' ? 46 : 52;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const nextFov = THREE.MathUtils.damp(this.currentFov, targetFov, 5.0, safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (Math.abs(nextFov - this.currentFov) > 0.01) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.currentFov = nextFov;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      camera.fov = this.currentFov;"
