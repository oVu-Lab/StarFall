    tool_calls {
      id: "call_8988880064923623396"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import type { MissionRank } from \'../../types/game\';\\nimport type { MissionScoreBreakdown } from \'../../types/mission\';\\n\\nexport interface RankCalculationInput {\\n  enemiesDefeated: number;\\n  totalEnemies: number;\\n  shotsFired: number;\\n  shotsHit: number;\\n  remainingHull: number;\\n  maxHull: number;\\n  damageReceived: number;\\n  timeTakenSec: number;\\n  parTimeSec: number;\\n  completed: boolean;\\n}\\n\\nexport const RANK_THRESHOLDS: Record<MissionRank, number> = {\\n  S: 820,\\n  A: 660,\\n  B: 480,\\n  C: 0,\\n};\\n\\nconst RANK_ORDER: Record<MissionRank, number> = {\\n  S: 4,\\n  A: 3,\\n  B: 2,\\n  C: 1,\\n};\\n\\nexport function isBetterRank(candidate: MissionRank, existing: MissionRank | null): boolean {\\n  if (!existing) return true;\\n  return RANK_ORDER[candidate] > RANK_ORDER[existing];\\n}\\n\\n/**\\n * Deterministic mission scoring and rank evaluation (0 - 1000 points).\\n * Identical inputs always produce the exact same breakdown and rank.\\n *\\n * Weighting:\\n *  - Combat Completion: 0..400 pts\\n *  - Accuracy:          0..250 pts (full credit at >= 55% hit rate)\\n *  - Survival / Hull:   0..200 pts (hull integrity + low damage bonus)\\n *  - Completion Speed:  0..150 pts (full credit at or under parTimeSec)\\n */\\nexport function calculateMissionScore(input: RankCalculationInput): MissionScoreBreakdown {\\n  const enemyRatio =\\n    input.totalEnemies > 0\\n      ? Math.max(0, Math.min(1, input.enemiesDefeated / input.totalEnemies))\\n      : input.completed\\n        ? 1\\n        : 0;\\n  const combatScore = Math.round(enemyRatio * 340 + (input.completed ? 60 : 0));\\n\\n  const accuracyRatio =\\n    input.shotsFired > 0 ? Math.max(0, Math.min(1, input.shotsHit / input.shotsFired)) : 0;\\n  // 55% accuracy in 6DOF space dogfighting awards full accuracy score\\n  const normalizedAcc = Math.min(1, accuracyRatio / 0.55);\\n  const accuracyScore = Math.round(normalizedAcc * 250);\\n\\n  const hullRatio =\\n    input.maxHull > 0 ? Math.max(0, Math.min(1, input.remainingHull / input.maxHull)) : 0;\\n  const lowDamageFactor = Math.max(0, 1 - input.damageReceived / Math.max(input.maxHull * 1.2, 1));\\n  const survivalScore = input.completed\\n    ? Math.round((hullRatio * 0.65 + lowDamageFactor * 0.35) * 200)\\n    : Math.round(hullRatio * 80);\\n\\n  let timeScore = 0;\\n  if (input.completed) {\\n    const safePar = Math.max(15, input.parTimeSec);\\n    if (input.timeTakenSec <= safePar) {\\n      timeScore = 150;\\n    } else {\\n      const overtimeRatio = (input.timeTakenSec - safePar) / safePar;\\n      timeScore = Math.round(Math.max(20, 150 * Math.exp(-overtimeRatio * 1.15)));\\n    }\\n  }\\n\\n  const totalScore = combatScore + accuracyScore + survivalScore + timeScore;\\n\\n  let rank: MissionRank = \'C\';\\n  if (totalScore >= RANK_THRESHOLDS.S) {\\n    rank = \'S\';\\n  } else if (totalScore >= RANK_THRESHOLDS.A) {\\n    rank = \'A\';\\n  } else if (totalScore >= RANK_THRESHOLDS.B) {\\n    rank = \'B\';\\n  }\\n\\n  return {\\n    combatScore,\\n    accuracyScore,\\n    survivalScore,\\n    timeScore,\\n    totalScore,\\n    rank,\\n  };\\n}\\n\", \"Description\":\"Implement deterministic S/A/B/C mission scoring and rank evaluation rules\", \"Overwrite\":true, \"TargetFile\":\"/src/engine/mission/RankCalculator.ts\", \"toolAction\":\"Creating deterministic RankCalculator\", \"toolSummary\":\"Create src/engine/mission/RankCalculator.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_8988880064923622421"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { CAMPAIGN_MISSIONS } from \'../../config/missions\';\\nimport type { MissionRank } from \'../../types/game\';\\nimport type {\\n  CampaignSaveData,\\n  MissionDefinition,\\n  MissionProgressRecord,\\n} from \'../../types/mission\';\\nimport { isBetterRank } from \'./RankCalculator\';\\n\\nconst CAMPAIGN_STORAGE_KEY = \'starfall.campaign.v1\';\\nconst SAVE_SCHEMA_VERSION = 1;\\nconst VALID_RANKS = new Set<MissionRank>([\'S\', \'A\', \'B\', \'C\']);\\n\\nfunction createEmptyRecord(): MissionProgressRecord {\\n  return {\\n    completed: false,\\n    bestRank: null,\\n    bestScore: 0,\\n    bestTimeSec: null,\\n    attempts: 0,\\n  };\\n}\\n\\nexport function createDefaultCampaignSave(): CampaignSaveData {\\n  const missions: Record<string, MissionProgressRecord> = {};\\n  for (const m of CAMPAIGN_MISSIONS) {\\n    missions[m.id] = createEmptyRecord();\\n  }\\n  return {\\n    version: SAVE_SCHEMA_VERSION,\\n    missions,\\n  };\\n}\\n\\n/**\\n * Loads campaign progression safely from browser LocalStorage.\\n * Validates schema fields and gracefully recovers from corrupt, partial, or outdated data.\\n */\\nexport function loadCampaignProgress(): CampaignSaveData {\\n  const fallback = createDefaultCampaignSave();\\n  try {\\n    if (typeof window === \'undefined\' || !window.localStorage) return fallback;\\n    const raw = window.localStorage.getItem(CAMPAIGN_STORAGE_KEY);\\n    if (!raw) return fallback;\\n\\n    const parsed = JSON.parse(raw) as Partial<CampaignSaveData>;\\n    if (!parsed || typeof parsed !== \'object\' || parsed.version !== SAVE_SCHEMA_VERSION) {\\n      return fallback;\\n    }\\n\\n    const rawMissions = parsed.missions;\\n    if (!rawMissions || typeof rawMissions !== \'object\') {\\n      return fallback;\\n    }\\n\\n    const sanitized = createDefaultCampaignSave();\\n    for (const mission of CAMPAIGN_MISSIONS) {\\n      const rec = rawMissions[mission.id] as Partial<MissionProgressRecord> | undefined;\\n      if (!rec || typeof rec !== \'object\') continue;\\n      const validRank =\\n        typeof rec.bestRank === \'string\' && VALID_RANKS.has(rec.bestRank as MissionRank)\\n          ? (rec.bestRank as MissionRank)\\n          : null;\\n\\n      sanitized.missions[mission.id] = {\\n        completed: Boolean(rec.completed),\\n        bestRank: validRank,\\n        bestScore:\\n          typeof rec.bestScore === \'number\' && Number.isFinite(rec.bestScore) && rec.bestScore >= 0\\n            ? Math.round(rec.bestScore)\\n            : 0,\\n        bestTimeSec:\\n          typeof rec.bestTimeSec === \'number\' &&\\n          Number.isFinite(rec.bestTimeSec) &&\\n          rec.bestTimeSec > 0\\n            ? rec.bestTimeSec\\n            : null,\\n        attempts:\\n          typeof rec.attempts === \'number\' && Number.isFinite(rec.attempts) && rec.attempts >= 0\\n            ? Math.floor(rec.attempts)\\n            : 0,\\n      };\\n    }\\n\\n    return sanitized;\\n  } catch {\\n    return fallback;\\n  }\\n}\\n\\nexport function saveCampaignProgress(data: CampaignSaveData): void {\\n  try {\\n    if (typeof window === \'undefined\' || !window.localStorage) return;\\n    window.localStorage.setItem(CAMPAIGN_STORAGE_KEY, JSON.stringify(data));\\n  } catch {\\n    // Ignore storage quota or private-mode restriction\\n  }\\n}\\n\\nexport function isMissionUnlocked(mission: MissionDefinition, save: CampaignSaveData): boolean {\\n  if (!mission.unlockRequirementId) return true;\\n  const reqRecord = save.missions[mission.unlockRequirementId];\\n  return Boolean(reqRecord?.completed);\\n}\\n\\nexport function recordMissionOutcome(\\n  save: CampaignSaveData,\\n  missionId: string,\\n  completed: boolean,\\n  rank: MissionRank | null,\\n  score: number,\\n  timeTakenSec: number,\\n): {\\n  nextSave: CampaignSaveData;\\n  isNewBestRank: boolean;\\n  isNewBestScore: boolean;\\n  wasPreviouslyCompleted: boolean;\\n} {\\n  const prev = save.missions[missionId] ?? createEmptyRecord();\\n  const wasPreviouslyCompleted = prev.completed;\\n\\n  let nextBestRank = prev.bestRank;\\n  let isNewBestRank = false;\\n  if (completed && rank && isBetterRank(rank, prev.bestRank)) {\\n    nextBestRank = rank;\\n    isNewBestRank = true;\\n  }\\n\\n  let nextBestScore = prev.bestScore;\\n  let isNewBestScore = false;\\n  if (completed && score > prev.bestScore) {\\n    nextBestScore = score;\\n    isNewBestScore = true;\\n  }\\n\\n  const nextBestTime =\\n    completed && (prev.bestTimeSec === null || timeTakenSec < prev.bestTimeSec)\\n      ? timeTakenSec\\n      : prev.bestTimeSec;\\n\\n  const nextSave: CampaignSaveData = {\\n    version: SAVE_SCHEMA_VERSION,\\n    missions: {\\n      ...save.missions,\\n      [missionId]: {\\n        completed: prev.completed || completed,\\n        bestRank: nextBestRank,\\n        bestScore: nextBestScore,\\n        bestTimeSec: nextBestTime,\\n        attempts: prev.attempts + 1,\\n      },\\n    },\\n  };\\n\\n  saveCampaignProgress(nextSave);\\n\\n  return {\\n    nextSave,\\n    isNewBestRank,\\n    isNewBestScore,\\n    wasPreviouslyCompleted,\\n  };\\n}\\n\", \"Description\":\"Implement LocalStorage campaign progression store with schema validation, corrupt-data recovery, unlock tracking, and best rank/score persistence\", \"Overwrite\":true, \"TargetFile\":\"/src/engine/mission/CampaignProgressStore.ts\", \"toolAction\":\"Creating CampaignProgressStore\", \"toolSummary\":\"Create src/engine/mission/CampaignProgressStore.ts\"}"
      original_name: "write_to_file"
    }
