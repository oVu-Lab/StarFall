    content: "      pitchSpeed: 1.32,\n      rollSpeed: 1.95,\n      angularDamping: 5.8,\n      visualBankStrength: 0.2,\n    },\n    weapons: {\n      primaryName: \'Dual Heavy Rail Cannons\',\n      damageRating: 96,\n      fireRateRating: 58,\n    },\n  },\n};\n\nexport const SHIP_ORDER: ShipId[] = [\'interceptor\', \'striker\', \'destroyer\'];\n\nexport const DEFAULT_SETTINGS: GameSettings = {\n  mouseSensitivity: 1.0,\n  invertY: false,\n  cameraDistance: 9.8,\n  cameraSensitivity: 1.0,\n  masterVolume: 0.65,\n  graphicsQuality: \'high\',\n  resolutionScale: 1.0,\n  shadowQuality: \'medium\',\n  particleQuality: \'high\',\n  environmentDetail: \'high\',\n  drawDistance: 4200,\n  antialias: true,\n  postGlowEnabled: true,\n  showPerfOverlay: false,\n};\n\nconst SETTINGS_STORAGE_KEY = \'starfall.settings.v2\';\nconst LEGACY_SETTINGS_KEY = \'starfall.settings.v1\';\n\nexport function loadSavedSettings(): GameSettings {\n  try {\n    const raw =\n      window.localStorage.getItem(SETTINGS_STORAGE_KEY) ??\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY);\n    if (!raw) return { ...DEFAULT_SETTINGS };\n    const parsed = JSON.parse(raw) as Partial<GameSettings>;\n    const validQuality =\n      parsed.graphicsQuality === \'low\' ||\n      parsed.graphicsQuality === \'medium\' ||\n      parsed.graphicsQuality === \'high\' ||\n      parsed.graphicsQuality === \'ultra\'\n        ? parsed.graphicsQuality\n        : DEFAULT_SETTINGS.graphicsQuality;\n\n    return {\n      ...DEFAULT_SETTINGS,\n      ...parsed,\n      graphicsQuality: validQuality,\n      resolutionScale:\n        typeof parsed.resolutionScale === \'number\' && Number.isFinite(parsed.resolutionScale)\n          ? Math.max(0.65, Math.min(1.0, parsed.resolutionScale))\n          : DEFAULT_SETTINGS.resolutionScale,\n      drawDistance:\n        typeof parsed.drawDistance === \'number\' && Number.isFinite(parsed.drawDistance)\n          ? Math.max(2000, Math.min(5200, parsed.drawDistance))\n          : DEFAULT_SETTINGS.drawDistance,\n      showPerfOverlay: import.meta.env.DEV ? Boolean(parsed.showPerfOverlay) : false,\n    };\n  } catch {\n    return { ...DEFAULT_SETTINGS };\n  }\n}\n\nexport function saveSettings(settings: GameSettings): void {\n  try {\n    window.localStorage.setItem(SETTINGS_STORAGE_KEY, JSON.stringify(settings));\n  } catch {\n    // Ignore storage quota / privacy mode errors\n  }\n}\n"
