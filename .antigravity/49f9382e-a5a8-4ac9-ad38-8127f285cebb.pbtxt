            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // Galactic plane tilted softly across the sky"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    float plane = exp(-abs(d.y * 2.4 + d.x * 0.65) * 2.2);"
