    action_spec {
      command {
        instruction: "Update FlightController.ts to maintain persistent normalized aimCursorX/aimCursorY driven by relative mouse deltas with zero auto-recentering or rollback, driving continuous yaw and pitch rates while held at any screen edge, while preserving thrust, boost, roll, and flight feel."
        is_edit: true
        file {
