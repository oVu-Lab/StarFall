            }
            lines {
              text: "   */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  public update("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    dt: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
