              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        if (m.isPrimaryTarget) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          primaryMarker = m;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
