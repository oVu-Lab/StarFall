    combined_output {
      full: "ALL_4_EDGES_RESULT: {  \"start\": {    \"pl\": \"CANVAS\",    \"cursorX\": 640,    \"cursorY\": 360,    \"hdg\": 0,    \"pitch\": 0,    \"roll\": 0,    \"vel\": 24  },  \"right\": {    \"arrived\": {      \"pl\": \"CANVAS\",      \"cursorX\": 1254,      \"cursorY\": 360,      \"hdg\": 13,      \"pitch\": 0,      \"roll\": 0,      \"vel\": 18    },    \"heldMid\": {      \"pl\": \"CANVAS\",      \"cursorX\": 1254,      \"cursorY\": 360,      \"hdg\": 67,      \"pitch\": 0,      \"roll\": 0,      \"vel\": 9    },    \"heldEnd\": {      \"pl\": \"CANVAS\",      \"cursorX\": 1254,      \"cursorY\": 360,      \"hdg\": 157,      \"pitch\": 0,      \"roll\": 0,      \"vel\": 2    }  },  \"left\": {    \"arrived\": {      \"pl\": \"CANVAS\",      \"cursorX\": 26,      \"cursorY\": 360,      \"hdg\": 158,      \"pitch\": 0,      \"roll\": 0,      \"vel\": 1    },    \"heldEnd\": {      \"pl\": \"CANVAS\",      \"cursorX\": 26,      \"cursorY\": 360,      \"hdg\": 42,      \"pitch\": 0,      \"roll\": 0,      \"vel\": 0    }  },  \"recentered\": {    \"pl\": \"CANVAS\",    \"cursorX\": 635,    \"cursorY\": 360,    \"hdg\": 18,    \"pitch\": 0,    \"roll\": 0,    \"vel\": 0  },  \"top\": {    \"arrived\": {      \"pl\": \"CANVAS\",      \"cursorX\": 635,      \"cursorY\": 22,      \"hdg\": 17,      \"pitch\": 21,      \"roll\": 0,      \"vel\": 0    },    \"heldEnd\": {      \"pl\": \"CANVAS\",      \"cursorX\": 635,      \"cursorY\": 22,      \"hdg\": 199,      \"pitch\": 63,      \"roll\": 178,      \"vel\": 0    }  },  \"bottom\": {    \"arrived\": {      \"pl\": \"CANVAS\",      \"cursorX\": 635,      \"cursorY\": 698,      \"hdg\": 200,      \"pitch\": 63,      \"roll\": 178,      \"vel\": 0    },    \"heldEnd\": {      \"pl\": \"CANVAS\",      \"cursorX\": 635,      \"cursorY\": 698,      \"hdg\": 17,      \"pitch\": 21,      \"roll\": 2,      \"vel\": 0    }  },  \"centeredStop\": {    \"t1\": {      \"pl\": \"CANVAS\",      \"cursorX\": 635,      \"cursorY\": 362,      \"hdg\": 17,      \"pitch\": -1,      \"roll\": 2,      \"vel\": 0    },    \"t2\": {      \"pl\": \"CANVAS\",      \"cursorX\": 635,      \"cursorY\": 362,      \"hdg\": 17,      \"pitch\": -1,      \"roll\": 2,      \"vel\": 0    }  }}VERIFIED_ALL_4_EDGES_CONTINUOUS_TURN_ZERO_ROLLBACK"
    }
    command_line: "NODE_PATH=/usr/local/share/bun-global/node_modules node -e \'\nconst assert = require(\"node:assert/strict\");\nconst { chromium } = require(\"playwright\");\n\n(async () => {\n  const browser = await chromium.launch({\n    headless: true,\n    args: [\"--no-sandbox\", \"--use-gl=angle\", \"--use-angle=swiftshader\"]\n  });\n  const page = await browser.newPage({ viewport: { width: 1280, height: 720 } });\n  const pageErrors = [];\n  page.on(\"pageerror\", e => pageErrors.push(e.message));\n\n  await page.addInitScript(() => {\n    localStorage.setItem(\"starfall.settings.v2\", JSON.stringify({\n      graphicsQuality: \"low\", resolutionScale: 0.65, shadowQuality: \"off\",\n      particleQuality: \"low\", environmentDetail: \"low\", drawDistance: 2400,\n      antialias: false, postGlowEnabled: false\n    }));\n  });\n\n  await page.goto(\"http://localhost:3000/\", { waitUntil: \"domcontentloaded\" });\n  await page.waitForSelector(\"button\");\n  await page.getByRole(\"button\", { name: /Campaign Missions/i }).click({ force: true });\n  await page.getByRole(\"button\", { name: /Launch M-01/i }).click({ force: true });\n  await page.waitForFunction(() => document.body.innerText.includes(\"Hull Integrity\"), null, { timeout: 25000 });\n\n  const results = await page.evaluate(async () => {\n    const waitFrame = () => new Promise(r => requestAnimationFrame(r));\n    const waitFrames = async (n) => { for (let i = 0; i < n; i++) await waitFrame(); };\n    const snap = () => {\n      const el = document.querySelector(\"[data-testid=\\\"virtual-mouse-cursor\\\"]\");\n      const rect = el ? el.getBoundingClientRect() : null;\n      const txt = document.body.innerText;\n      return {\n        pl: document.pointerLockElement?.tagName || null,\n        cursorX: rect ? Math.round(rect.left + rect.width / 2) : null,\n        cursorY: rect ? Math.round(rect.top + rect.height / 2) : null,\n        hdg: Number(txt.match(/HDG\\s+(\\d+)\302\260/)?.[1]),\n        pitch: Number(txt.match(/PITCH\\s+([+-]?\\d+)\302\260/)?.[1]),\n        roll: Number(txt.match(/ROLL\\s+([+-]?\\d+)\302\260/)?.[1]),\n        vel: Number(txt.match(/Velocity\\s+(-?\\d+)\\s+m\\/s/)?.[1])\n      };\n    };\n\n    const move = async (dx, dy, steps = 10) => {\n      const sx = dx / steps;\n      const sy = dy / steps;\n      for (let i = 0; i < steps; i++) {\n        window.dispatchEvent(new MouseEvent(\"mousemove\", { movementX: sx, movementY: sy, bubbles: true }));\n        await waitFrame();\n      }\n    };\n\n    await waitFrames(4);\n    const start = snap();\n\n    // 1. RIGHT EDGE: move +450px right, then STOP moving mouse and hold for 25 frames\n    await move(450, 0, 10);\n    const rightArrived = snap();\n    await waitFrames(12);\n    const rightHeldMid = snap();\n    await waitFrames(15);\n    const rightHeldEnd = snap();\n\n    // 2. LEFT EDGE: move -900px left (across screen to left edge), hold stationary\n    await move(-900, 0, 14);\n    const leftArrived = snap();\n    await waitFrames(20);\n    const leftHeldEnd = snap();\n\n    // Return to horizontal center (+403px from -0.96 -> 0)\n    await move(403, 0, 8);\n    await waitFrames(10);\n    const recentered = snap();\n\n    // 3. TOP EDGE: move -450px up, hold stationary -> continuous pitch UP\n    await move(0, -450, 10);\n    const topArrived = snap();\n    await waitFrames(18);\n    const topHeldEnd = snap();\n\n    // 4. BOTTOM EDGE: move +900px down, hold stationary -> continuous pitch DOWN\n    await move(0, 900, 14);\n    const bottomArrived = snap();\n    await waitFrames(18);\n    const bottomHeldEnd = snap();\n\n    // 5. Return to center (0, 0) and confirm ship stops turning\n    await move(0, -395, 8);\n    await waitFrames(20);\n    const centered1 = snap();\n    await waitFrames(15);\n    const centered2 = snap();\n\n    return {\n      start,\n      right: { arrived: rightArrived, heldMid: rightHeldMid, heldEnd: rightHeldEnd },\n      left: { arrived: leftArrived, heldEnd: leftHeldEnd },\n      recentered,\n      top: { arrived: topArrived, heldEnd: topHeldEnd },\n      bottom: { arrived: bottomArrived, heldEnd: bottomHeldEnd },\n      centeredStop: { t1: centered1, t2: centered2 }\n    };\n  });\n\n  console.log(\"ALL_4_EDGES_RESULT:\", JSON.stringify(results, null, 2));\n\n  // Verify Pointer Lock active throughout\n  assert.equal(results.start.pl, \"CANVAS\");\n\n  // Verify RIGHT edge: cursor stays pinned at ~1254px (ZERO rollback toward 640!) AND heading keeps turning!\n  assert.ok(results.right.arrived.cursorX >= 1240, \"Cursor must reach right edge\");\n  assert.equal(results.right.heldMid.cursorX, results.right.arrived.cursorX, \"Cursor MUST stay pinned at right edge (mid)\");\n  assert.equal(results.right.heldEnd.cursorX, results.right.arrived.cursorX, \"Cursor MUST stay pinned at right edge (end)\");\n  const rightDelta1 = (results.right.heldMid.hdg - results.right.arrived.hdg + 360) % 360;\n  const rightDelta2 = (results.right.heldEnd.hdg - results.right.heldMid.hdg + 360) % 360;\n  assert.ok(rightDelta1 > 10 && rightDelta2 > 10, `Ship must keep turning right continuously while held at edge (${rightDelta1}\302\260, ${rightDelta2}\302\260)`);\n\n  // Verify LEFT edge: cursor stays pinned at ~26px AND heading keeps turning left!\n  assert.ok(results.left.arrived.cursorX <= 40, \"Cursor must reach left edge\");\n  assert.equal(results.left.heldEnd.cursorX, results.left.arrived.cursorX, \"Cursor MUST stay pinned at left edge\");\n  const leftDelta = (results.left.arrived.hdg - results.left.heldEnd.hdg + 360) % 360;\n  assert.ok(leftDelta > 20, `Ship must keep turning left continuously while held at edge (${leftDelta}\302\260)`);\n\n  // Verify TOP edge: cursor stays pinned at ~22px AND pitch keeps increasing!\n  assert.ok(results.top.arrived.cursorY <= 30, \"Cursor must reach top edge\");\n  assert.equal(results.top.heldEnd.cursorY, results.top.arrived.cursorY, \"Cursor MUST stay pinned at top edge\");\n  assert.notEqual(results.top.heldEnd.pitch, results.top.arrived.pitch, \"Ship must keep pitching up while held at top edge\");\n\n  // Verify BOTTOM edge: cursor stays pinned at ~698px AND pitch keeps changing downward!\n  assert.ok(results.bottom.arrived.cursorY >= 690, \"Cursor must reach bottom edge\");\n  assert.equal(results.bottom.heldEnd.cursorY, results.bottom.arrived.cursorY, \"Cursor MUST stay pinned at bottom edge\");\n  assert.notEqual(results.bottom.heldEnd.pitch, results.bottom.arrived.pitch, \"Ship must keep pitching down while held at bottom edge\");\n\n  // Verify returning to center stops turning cleanly\n  assert.ok(Math.abs(results.centeredStop.t1.cursorX - 640) < 15 && Math.abs(results.centeredStop.t1.cursorY - 360) < 15, \"Cursor returns cleanly to center\");\n  assert.equal(results.centeredStop.t2.hdg, results.centeredStop.t1.hdg, \"Ship stops turning when mouse returned to center\");\n  assert.equal(results.centeredStop.t2.pitch, results.centeredStop.t1.pitch, \"Ship stops pitching when mouse returned to center\");\n\n  // Verify ESC releases Pointer Lock + Resume re-locks cleanly\n  await page.keyboard.press(\"Escape\");\n  await page.waitForFunction(() => document.body.innerText.includes(\"Flight Paused\"), null, { timeout: 5000 });\n  const escPl = await page.evaluate(() => document.pointerLockElement?.tagName || null);\n  assert.equal(escPl, null, \"ESC must release Pointer Lock\");\n\n  await page.getByRole(\"button\", { name: /Resume Flight/i }).click({ force: true });\n  await page.waitForFunction(() => !document.body.innerText.includes(\"Flight Paused\"), null, { timeout: 5000 });\n  const resumePl = await page.evaluate(() => document.pointerLockElement?.tagName || null);\n  assert.equal(resumePl, \"CANVAS\", \"Resume must re-lock CANVAS\");\n\n  assert.equal(pageErrors.length, 0, \"Zero page errors\");\n  console.log(\"VERIFIED_ALL_4_EDGES_CONTINUOUS_TURN_ZERO_ROLLBACK\");\n  await browser.close();\n  process.exit(0);\n})().catch(e => { console.error(e); process.exit(1); });\n\'"
    proposed_command_line: "NODE_PATH=/usr/local/share/bun-global/node_modules node -e \'\nconst assert = require(\"node:assert/strict\");\nconst { chromium } = require(\"playwright\");\n\n(async () => {\n  const browser = await chromium.launch({\n    headless: true,\n    args: [\"--no-sandbox\", \"--use-gl=angle\", \"--use-angle=swiftshader\"]\n  });\n  const page = await browser.newPage({ viewport: { width: 1280, height: 720 } });\n  const pageErrors = [];\n  page.on(\"pageerror\", e => pageErrors.push(e.message));\n\n  await page.addInitScript(() => {\n    localStorage.setItem(\"starfall.settings.v2\", JSON.stringify({\n      graphicsQuality: \"low\", resolutionScale: 0.65, shadowQuality: \"off\",\n      particleQuality: \"low\", environmentDetail: \"low\", drawDistance: 2400,\n      antialias: false, postGlowEnabled: false\n    }));\n  });\n\n  await page.goto(\"http://localhost:3000/\", { waitUntil: \"domcontentloaded\" });\n  await page.waitForSelector(\"button\");\n  await page.getByRole(\"button\", { name: /Campaign Missions/i }).click({ force: true });\n  await page.getByRole(\"button\", { name: /Launch M-01/i }).click({ force: true });\n  await page.waitForFunction(() => document.body.innerText.includes(\"Hull Integrity\"), null, { timeout: 25000 });\n\n  const results = await page.evaluate(async () => {\n    const waitFrame = () => new Promise(r => requestAnimationFrame(r));\n    const waitFrames = async (n) => { for (let i = 0; i < n; i++) await waitFrame(); };\n    const snap = () => {\n      const el = document.querySelector(\"[data-testid=\\\"virtual-mouse-cursor\\\"]\");\n      const rect = el ? el.getBoundingClientRect() : null;\n      const txt = document.body.innerText;\n      return {\n        pl: document.pointerLockElement?.tagName || null,\n        cursorX: rect ? Math.round(rect.left + rect.width / 2) : null,\n        cursorY: rect ? Math.round(rect.top + rect.height / 2) : null,\n        hdg: Number(txt.match(/HDG\\s+(\\d+)\302\260/)?.[1]),\n        pitch: Number(txt.match(/PITCH\\s+([+-]?\\d+)\302\260/)?.[1]),\n        roll: Number(txt.match(/ROLL\\s+([+-]?\\d+)\302\260/)?.[1]),\n        vel: Number(txt.match(/Velocity\\s+(-?\\d+)\\s+m\\/s/)?.[1])\n      };\n    };\n\n    const move = async (dx, dy, steps = 10) => {\n      const sx = dx / steps;\n      const sy = dy / steps;\n      for (let i = 0; i < steps; i++) {\n        window.dispatchEvent(new MouseEvent(\"mousemove\", { movementX: sx, movementY: sy, bubbles: true }));\n        await waitFrame();\n      }\n    };\n\n    await waitFrames(4);\n    const start = snap();\n\n    // 1. RIGHT EDGE: move +450px right, then STOP moving mouse and hold for 25 frames\n    await move(450, 0, 10);\n    const rightArrived = snap();\n    await waitFrames(12);\n    const rightHeldMid = snap();\n    await waitFrames(15);\n    const rightHeldEnd = snap();\n\n    // 2. LEFT EDGE: move -900px left (across screen to left edge), hold stationary\n    await move(-900, 0, 14);\n    const leftArrived = snap();\n    await waitFrames(20);\n    const leftHeldEnd = snap();\n\n    // Return to horizontal center (+403px from -0.96 -> 0)\n    await move(403, 0, 8);\n    await waitFrames(10);\n    const recentered = snap();\n\n    // 3. TOP EDGE: move -450px up, hold stationary -> continuous pitch UP\n    await move(0, -450, 10);\n    const topArrived = snap();\n    await waitFrames(18);\n    const topHeldEnd = snap();\n\n    // 4. BOTTOM EDGE: move +900px down, hold stationary -> continuous pitch DOWN\n    await move(0, 900, 14);\n    const bottomArrived = snap();\n    await waitFrames(18);\n    const bottomHeldEnd = snap();\n\n    // 5. Return to center (0, 0) and confirm ship stops turning\n    await move(0, -395, 8);\n    await waitFrames(20);\n    const centered1 = snap();\n    await waitFrames(15);\n    const centered2 = snap();\n\n    return {\n      start,\n      right: { arrived: rightArrived, heldMid: rightHeldMid, heldEnd: rightHeldEnd },\n      left: { arrived: leftArrived, heldEnd: leftHeldEnd },\n      recentered,\n      top: { arrived: topArrived, heldEnd: topHeldEnd },\n      bottom: { arrived: bottomArrived, heldEnd: bottomHeldEnd },\n      centeredStop: { t1: centered1, t2: centered2 }\n    };\n  });\n\n  console.log(\"ALL_4_EDGES_RESULT:\", JSON.stringify(results, null, 2));\n\n  // Verify Pointer Lock active throughout\n  assert.equal(results.start.pl, \"CANVAS\");\n\n  // Verify RIGHT edge: cursor stays pinned at ~1254px (ZERO rollback toward 640!) AND heading keeps turning!\n  assert.ok(results.right.arrived.cursorX >= 1240, \"Cursor must reach right edge\");\n  assert.equal(results.right.heldMid.cursorX, results.right.arrived.cursorX, \"Cursor MUST stay pinned at right edge (mid)\");\n  assert.equal(results.right.heldEnd.cursorX, results.right.arrived.cursorX, \"Cursor MUST stay pinned at right edge (end)\");\n  const rightDelta1 = (results.right.heldMid.hdg - results.right.arrived.hdg + 360) % 360;\n  const rightDelta2 = (results.right.heldEnd.hdg - results.right.heldMid.hdg + 360) % 360;\n  assert.ok(rightDelta1 > 10 && rightDelta2 > 10, `Ship must keep turning right continuously while held at edge (${rightDelta1}\302\260, ${rightDelta2}\302\260)`);\n\n  // Verify LEFT edge: cursor stays pinned at ~26px AND heading keeps turning left!\n  assert.ok(results.left.arrived.cursorX <= 40, \"Cursor must reach left edge\");\n  assert.equal(results.left.heldEnd.cursorX, results.left.arrived.cursorX, \"Cursor MUST stay pinned at left edge\");\n  const leftDelta = (results.left.arrived.hdg - results.left.heldEnd.hdg + 360) % 360;\n  assert.ok(leftDelta > 20, `Ship must keep turning left continuously while held at edge (${leftDelta}\302\260)`);\n\n  // Verify TOP edge: cursor stays pinned at ~22px AND pitch keeps increasing!\n  assert.ok(results.top.arrived.cursorY <= 30, \"Cursor must reach top edge\");\n  assert.equal(results.top.heldEnd.cursorY, results.top.arrived.cursorY, \"Cursor MUST stay pinned at top edge\");\n  assert.notEqual(results.top.heldEnd.pitch, results.top.arrived.pitch, \"Ship must keep pitching up while held at top edge\");\n\n  // Verify BOTTOM edge: cursor stays pinned at ~698px AND pitch keeps changing downward!\n  assert.ok(results.bottom.arrived.cursorY >= 690, \"Cursor must reach bottom edge\");\n  assert.equal(results.bottom.heldEnd.cursorY, results.bottom.arrived.cursorY, \"Cursor MUST stay pinned at bottom edge\");\n  assert.notEqual(results.bottom.heldEnd.pitch, results.bottom.arrived.pitch, \"Ship must keep pitching down while held at bottom edge\");\n\n  // Verify returning to center stops turning cleanly\n  assert.ok(Math.abs(results.centeredStop.t1.cursorX - 640) < 15 && Math.abs(results.centeredStop.t1.cursorY - 360) < 15, \"Cursor returns cleanly to center\");\n  assert.equal(results.centeredStop.t2.hdg, results.centeredStop.t1.hdg, \"Ship stops turning when mouse returned to center\");\n  assert.equal(results.centeredStop.t2.pitch, results.centeredStop.t1.pitch, \"Ship stops pitching when mouse returned to center\");\n\n  // Verify ESC releases Pointer Lock + Resume re-locks cleanly\n  await page.keyboard.press(\"Escape\");\n  await page.waitForFunction(() => document.body.innerText.includes(\"Flight Paused\"), null, { timeout: 5000 });\n  const escPl = await page.evaluate(() => document.pointerLockElement?.tagName || null);\n  assert.equal(escPl, null, \"ESC must release Pointer Lock\");\n\n  await page.getByRole(\"button\", { name: /Resume Flight/i }).click({ force: true });\n  await page.waitForFunction(() => !document.body.innerText.includes(\"Flight Paused\"), null, { timeout: 5000 });\n  const resumePl = await page.evaluate(() => document.pointerLockElement?.tagName || null);\n  assert.equal(resumePl, \"CANVAS\", \"Resume must re-lock CANVAS\");\n\n  assert.equal(pageErrors.length, 0, \"Zero page errors\");\n  console.log(\"VERIFIED_ALL_4_EDGES_CONTINUOUS_TURN_ZERO_ROLLBACK\");\n  await browser.close();\n  process.exit(0);\n})().catch(e => { console.error(e); process.exit(1); });\n\'"
    shell_name: "bash"
  }
