    result {
      result: "Task: 49f9382e-a5a8-4ac9-ad38-8127f285cebb/task-259\nStatus: RUNNING\nLast progress: never\n"
      metadata {
        key: "task_description"
        value: "NODE_PATH=/usr/local/share/bun-global/node_modules node -e \'\nconst { chromium } = require(\"playwright\");\n(async () => {\n  const browser = await chromium.launch({\n    headless: true,\n    args: [\"--no-sandbox\", \"--use-gl=angle\", \"--use-angle=swiftshader\"]\n  });\n  const page = await browser.newPage({ viewport: { width: 1280, height: 720 } });\n  page.on(\"pageerror\", e => console.log(\"[pageerror]\", e.message));\n\n  await page.addInitScript(() => {\n    window.__moves = [];\n    window.__plEvents = [];\n    document.addEventListener(\"pointerlockchange\", () => {\n      window.__plEvents.push({ type: \"pointerlockchange\", el: document.pointerLockElement?.tagName || null });\n    });\n    document.addEventListener(\"pointerlockerror\", () => {\n      window.__plEvents.push({ type: \"pointerlockerror\", el: document.pointerLockElement?.tagName || null });\n    });\n    window.addEventListener(\"mousemove\", (e) => {\n      window.__moves.push({\n        mx: e.movementX,\n        my: e.movementY,\n        cx: e.clientX,\n        cy: e.clientY,\n        locked: Boolean(document.pointerLockElement)\n      });\n    }, { capture: true });\n  });\n\n  await page.goto(\"http://localhost:3000/\", { waitUntil: \"domcontentloaded\" });\n  await page.waitForSelector(\"button\");\n  await page.getByRole(\"button\", { name: /Campaign Missions/i }).click({ force: true });\n  await page.getByRole(\"button\", { name: /Launch M-01/i }).click({ force: true });\n\n  // Wait for playing HUD (Hull Integrity)\n  await page.waitForFunction(() => document.body.innerText.includes(\"Hull Integrity\"), null, { timeout: 25000 });\n  console.log(\"PLAYING! pointerLock:\", await page.evaluate(() => ({\n    el: document.pointerLockElement?.tagName || null,\n    events: window.__plEvents\n  })));\n\n  // Move mouse smoothly in 10px steps from center (640,360) across right edge (1280 -> 1600)\n  await page.evaluate(() => { window.__moves = []; });\n  for (let x = 640; x <= 1400; x += 20) {\n    await page.mouse.move(x, 360);\n    await page.waitForTimeout(16);\n  }\n  const sweepData = await page.evaluate(() => ({\n    moves: window.__moves,\n    hdgText: document.body.innerText.match(/HDG\\s+\\d+\302\260/)?.[0] || null\n  }));\n  console.log(\"Sweep right:\", JSON.stringify(sweepData));\n\n  await browser.close();\n  process.exit(0);\n})().catch(e => { console.error(e); process.exit(1); });\n\'"
      }
      metadata {
        key: "task_id"
        value: "49f9382e-a5a8-4ac9-ad38-8127f285cebb/task-259"
