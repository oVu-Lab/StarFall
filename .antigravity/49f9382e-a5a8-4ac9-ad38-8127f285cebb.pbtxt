      thinking_signature: "\022\355\004\n\352\004\001i\024}\023\002w\341\327\254@\367\2317\235\300\213\267\bh\215\204\"6XQ)\344\000\nq\300\375\330\250\322\322\354\001E\374\237&\225\260y;f\254\322\346\362\262ms\225\326\017\313e\f()\n\000\267\247\325;\031^O\226\023?@kDb@\274\002\207\026\023\361_\024\321#`d0\236(\023W\250a\372{\017\343\310;U\220}\365\320\316\327\0240J\3102O\276[\031\201\276\336\255`8=\371\312\206\316\213\260\202r]Tq\300X\027\235G\274h|E\231S\327v\3503\310#\254\f\272S\234\026\323\373\027~\346$\202A)m\267\321\335+;\315;p\273\224\246\032\2673\212\257\017\262\214\206)\357\027\005\3264w\017\221\237\346\177\177\304\323\212\363\322\234LZ\030\326]\"\3479\a\023\034\024\346\271h\320<\254*\rv\351&uk\021:\201A\203\226N\257y\326P\310\230\234)*\006\201\2462\246M\336\205\'\030\265T\024\227\243\006\300J\005\267AI\310P\3519\354y\022^/\022n\375G\025+qxYa\313\256\367\225\327\214\326V\300/e`\241s\223\301\001*?\227\327\215\234&lL\006\302\276\275\257e\227L\tD\366f\r\370\004\376J\372\354\357\032\303\321\217GP\262@\265\002\366\347\352i\247L\362\310\362\312\207\031\305\026\217\243\356\244(\211\370\211\356Prjk\242rX\223\'\3720\206_>\336\004\347!\347q\'\241\232\"] \207C\375\264\302\230\327\03115cDb\023\220h\000I\033^\341\034\243D\330\256e\242\273\2543\355\000\035\024\025|&\031B\320\332\221\326e\260\302\244\003\255\304KY\372\027\201u\037\231C\003<\250\364|*\342;\374\343\204O\224\205`\003N\250\347\020x\212\247\320\rj\250\333>\302x\331\022\362\202\245\252\202\225\037\332\264t.\033\274zO62#\031\023\311y\222\341N\327\241\321 P\272\352\362\2547\335\330l\035;\305\353\314\r}\321l@\277\350\262X\376]\214\035\225\021\235C\250v$\347\266\372\205\211\252\022\234R\217\310\275r\373\232\337\367ylqyE6J\366\370\222jT\242\371\207\346\361\362\307\"i\257\301\232\026!\376k\262\247\231\255+\377\373F!6S?\027\324\302\266\314\2336"
