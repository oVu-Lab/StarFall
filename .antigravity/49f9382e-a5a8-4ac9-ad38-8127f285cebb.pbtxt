              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const maxSens = Math.max(boundarySens + 0.1, THREE.MathUtils.clamp(settings.maxSensitivity, 1.2, 3.5));"
