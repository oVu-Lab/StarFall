            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "function SteeringCurvePreview({ settings }: { settings: GameSettings }) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const { pathD, boundaryXPos } = useMemo(() => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const W = 240;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const H = 64;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const padX = 8;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const padY = 8;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const plotW = W - padX * 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const plotH = H - padY * 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const B = settings.aimBoundarySize * PROGRESSIVE_STEERING_CONFIG.boundaryPixelsPerFraction;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const S = settings.accelerationDistance;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const maxDisp = B + S * 3.0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const maxY = Math.max(3.6, settings.maxSensitivity + 0.25);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const pts: string[] = [];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const steps = 48;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    for (let i = 0; i <= steps; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const frac = i / steps;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const disp = frac * maxDisp;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const res = evaluateProgressiveAxisSensitivity("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        disp,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        B,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        S,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        settings.boundarySensitivity,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        settings.maxSensitivity,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        settings.responseCurve,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const px = padX + frac * plotW;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const py = padY + plotH - (res.targetSensitivity / maxY) * plotH;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      pts.push(`${i === 0 ? \'M\' : \'L\'}${px.toFixed(1)},${py.toFixed(1)}`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const bx = padX + (B / maxDisp) * plotW;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return { pathD: pts.join(\' \'), boundaryXPos: bx };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }, ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    settings.aimBoundarySize,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    settings.accelerationDistance,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    settings.boundarySensitivity,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    settings.maxSensitivity,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    settings.responseCurve,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ]);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    <div className=\"border border-slate-800 bg-[#060f21] px-2.5 py-2\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      <div className=\"mb-1 flex items-center justify-between font-mono text-[10px] text-slate-400\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        <span>RESPONSE CURVE (PRECISION \302\267 TRANSITION \302\267 ACCEL)</span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        <span className=\"text-cyan-300\">f(e)=e^p/(1+e^p)</span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      <svg"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        viewBox=\"0 0 240 64\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        className=\"h-14 w-full\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        aria-label=\"Progressive mouse steering response curve\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      >"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        {/* 1.0x reference line */}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        <line"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          x1=\"8\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          y1=\"42.7\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
