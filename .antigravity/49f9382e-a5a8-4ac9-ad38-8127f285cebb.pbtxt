  },  \"centeredStop\": {    \"t1\": {      \"pl\": \"CANVAS\",      \"cursorX\": 635,      \"cursorY\": 362,      \"hdg\": 17,      \"pitch\": -1,      \"roll\": 2,      \"vel\": 0    },    \"t2\": {      \"pl\": \"CANVAS\",      \"cursorX\": 635,      \"cursorY\": 362,      \"hdg\": 17,      \"pitch\": -1,      \"roll\": 2,      \"vel\": 0    }  }}VERIFIED_ALL_4_EDGES_CONTINUOUS_TURN_ZERO_ROLLBACK"
      priority: MESSAGE_PRIORITY_HIGH
