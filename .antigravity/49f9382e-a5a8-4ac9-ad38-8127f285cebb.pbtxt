      arguments_json: "{\"CodeContent\":\"import * as THREE from \'three\';\\nimport type { ProjectedEnemyMarker } from \'../types/combat\';\\nimport type { FlightStatus, FlightTelemetry, GameSettings, ShipConfig } from \'../types/game\';\\nimport type { InputSnapshot } from \'./InputManager\';\\n\\n// Reusable scratch objects (zero per-frame GC allocations)\\nconst _AXIS_X = new THREE.Vector3(1, 0, 0);\\nconst _AXIS_Y = new THREE.Vector3(0, 1, 0);\\nconst _AXIS_Z = new THREE.Vector3(0, 0, 1);\\nconst _FORWARD_LOCAL = new THREE.Vector3(0, 0, -1);\\n\\nconst _qYaw = new THREE.Quaternion();\\nconst _qPitch = new THREE.Quaternion();\\nconst _qRoll = new THREE.Quaternion();\\nconst _forwardWorld = new THREE.Vector3();\\nconst _rightWorld = new THREE.Vector3();\\nconst _upWorld = new THREE.Vector3();\\nconst _desiredVel = new THREE.Vector3();\\nconst _euler = new THREE.Euler(0, 0, 0, \'YXZ\');\\n\\nfunction createEmptyEnemyMarkers(count = 6): ProjectedEnemyMarker[] {\\n  const list: ProjectedEnemyMarker[] = [];\\n  for (let i = 0; i < count; i++) {\\n    list.push({\\n      active: false,\\n      entityId: \'\',\\n      callsign: \'\',\\n      personalityLabel: \'\',\\n      aiState: \'patrol\',\\n      screenX: 0.5,\\n      screenY: 0.5,\\n      inFront: false,\\n      onScreen: false,\\n      distance: 0,\\n      healthRatio: 1,\\n      isPrimaryTarget: false,\\n      isPriorityTarget: false,\\n      leadX: 0.5,\\n      leadY: 0.5,\\n      leadVisible: false,\\n    });\\n  }\\n  return list;\\n}\\n\\nexport function createInitialTelemetry(ship: ShipConfig): FlightTelemetry {\\n  return {\\n    speed: 0,\\n    signedSpeed: 0,\\n    maxSpeed: ship.flight.maxSpeed,\\n    effectiveMaxSpeed: ship.flight.maxSpeed,\\n    throttle: 0,\\n    boostEnergy: ship.flight.maxBoostEnergy,\\n    maxBoostEnergy: ship.flight.maxBoostEnergy,\\n    isBoosting: false,\\n    boostDepleted: false,\\n    boostIntensity: 0,\\n    hull: ship.maxHull,\\n    maxHull: ship.maxHull,\\n    yawRate: 0,\\n    pitchRate: 0,\\n    rollRate: 0,\\n    aimNormalizedX: 0,\\n    aimNormalizedY: 0,\\n    aimScreenX: 0.5,\\n    aimScreenY: 0.5,\\n    boresightScreenX: 0.5,\\n    boresightScreenY: 0.5,\\n    headingDeg: 0,\\n    pitchDeg: 0,\\n    rollDeg: 0,\\n    altitude: 0,\\n    status: \'STANDBY\',\\n    pointerLocked: false,\\n    isFiring: false,\\n    weaponName: ship.weapons.primaryName,\\n    weaponCooldownRatio: 0,\\n    hitMarkerTimer: 0,\\n    killMarkerTimer: 0,\\n    damageFlashTimer: 0,\\n    muzzleFlashLeft: 0,\\n    muzzleFlashRight: 0,\\n    playerDestroyed: false,\\n    combatStats: {\\n      kills: 0,\\n      shotsFired: 0,\\n      shotsHit: 0,\\n      damageDealt: 0,\\n      damageTaken: 0,\\n      score: 0,\\n      wave: 1,\\n      activeEnemies: 0,\\n    },\\n    enemyMarkers: createEmptyEnemyMarkers(6),\\n    fps: 60,\\n    frameTimeMs: 16.6,\\n    drawCalls: 0,\\n    triangles: 0,\\n    activeProjectiles: 0,\\n    activeParticles: 0,\\n    activeEnemies: 0,\\n    lastAssetLoadMs: 0,\\n    cachedAssetCount: 0,\\n  };\\n}\\n\\n/**\\n * Precision-preserving relative mouse curve:\\n * - Small micro-adjustments (<= 5px) remain ultra-fine and controllable for pinpoint gunnery.\\n * - Larger continuous sweeps pass through linearly with zero clipping and zero artificial cap.\\n */\\nfunction shapeRelativeMouseDelta(deltaPx: number): number {\\n  const abs = Math.abs(deltaPx);\\n  if (abs < 0.0001) return 0;\\n  const shaped = abs <= 5 ? abs * 0.84 : 4.2 + (abs - 5) * 1.04;\\n  return Math.sign(deltaPx) * shaped;\\n}\\n\\n/**\\n * Arcade 6DOF space flight controller.\\n * Ship coordinate system: Forward = -Z, Right = +X, Up = +Y.\\n *\\n * Phase 3 Continuous Mouse Turning:\\n * - Directly integrates unbounded relative Pointer Lock deltas into smooth local-space\\n *   quaternion rotation without any screen-edge boundary, gimbal clamp, or cursor snap-back.\\n * - Supports unlimited 360-degree continuous yaw, pitch loops, and independent A/D barrel rolls.\\n */\\nexport class FlightController {\\n  public readonly position = new THREE.Vector3(0, 12, 40);\\n  public readonly quaternion = new THREE.Quaternion();\\n  public readonly velocity = new THREE.Vector3(0, 0, -24);\\n\\n  // Smoothed angular rates (rad/s) in ship local space\\n  public yawVelocity = 0;\\n  public pitchVelocity = 0;\\n  public rollVelocity = 0;\\n\\n  // Unbounded micro-smoothing buffer for crisp, lag-free relative mouse deltas (no clamp, no snap-back)\\n  private pendingYawRad = 0;\\n  private pendingPitchRad = 0;\\n\\n  // Visual banking angle layered on the ship mesh for tactile feel\\n  public visualBankAngle = 0;\\n\\n  private ship: ShipConfig;\\n  private boostEnergy: number;\\n  private boostCooldownTimer = 0;\\n  private boostLockedOut = false;\\n  private boostIntensity = 0;\\n  private wasBoosting = false;\\n  private hull: number;\\n  private boostJustEngaged = false;\\n\\n  public constructor(ship: ShipConfig) {\\n    this.ship = ship;\\n    this.boostEnergy = ship.flight.maxBoostEnergy;\\n    this.hull = ship.maxHull;\\n  }\\n\\n  public setShipConfig(ship: ShipConfig): void {\\n    this.ship = ship;\\n    this.boostEnergy = Math.min(this.boostEnergy, ship.flight.maxBoostEnergy);\\n    this.hull = ship.maxHull;\\n  }\\n\\n  public reset(startPosition?: THREE.Vector3): void {\\n    if (startPosition) {\\n      this.position.copy(startPosition);\\n    } else {\\n      this.position.set(0, 12, 40);\\n    }\\n    this.quaternion.identity();\\n    this.velocity.set(0, 0, -28);\\n    this.yawVelocity = 0;\\n    this.pitchVelocity = 0;\\n    this.rollVelocity = 0;\\n    this.pendingYawRad = 0;\\n    this.pendingPitchRad = 0;\\n    this.visualBankAngle = 0;\\n    this.boostEnergy = this.ship.flight.maxBoostEnergy;\\n    this.boostCooldownTimer = 0;\\n    this.boostLockedOut = false;\\n    this.boostIntensity = 0;\\n    this.wasBoosting = false;\\n    this.hull = this.ship.maxHull;\\n  }\\n\\n  public getBoostJustEngaged(): boolean {\\n    return this.boostJustEngaged;\\n  }\\n\\n  /**\\n   * Returns exact unit world-space forward firing direction aligned 1:1 with the ship nose\\n   * and the projected 3D aiming reticle.\\n   */\\n  public getAimDirectionWorld(out: THREE.Vector3): THREE.Vector3 {\\n    out.copy(_FORWARD_LOCAL).applyQuaternion(this.quaternion).normalize();\\n    return out;\\n  }\\n\\n  /**\\n   * Computes the 3D world-space convergence point along the player\'s true forward firing ray.\\n   */\\n  public getAimTargetPoint(out: THREE.Vector3, distance: number): THREE.Vector3 {\\n    this.getAimDirectionWorld(out);\\n    out.multiplyScalar(distance).add(this.position);\\n    return out;\\n  }\\n\\n  /**\\n   * Advances arcade flight simulation by delta time `dt` (seconds) and writes live telemetry.\\n   */\\n  public update(\\n    dt: number,\\n    input: InputSnapshot,\\n    settings: GameSettings,\\n    telemetry: FlightTelemetry,\\n  ): void {\\n    const profile = this.ship.flight;\\n    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);\\n\\n    // 1. Unbounded Continuous Relative Mouse Turning (Zero Clamp, Zero Auto-Recenter Snap-Back)\\n    const sens = settings.mouseSensitivity;\\n    const radPerPx = 0.00235 * sens;\\n    const ySign = settings.invertY ? 1 : -1;\\n\\n    const shapedDx = shapeRelativeMouseDelta(input.mouseDeltaX);\\n    const shapedDy = shapeRelativeMouseDelta(input.mouseDeltaY);\\n\\n    // Accumulate raw relative turn radians directly \342\200\224 never clamped to a screen box!\\n    this.pendingYawRad += -shapedDx * radPerPx;\\n    this.pendingPitchRad += shapedDy * radPerPx * ySign;\\n\\n    // Optional arrow-key steering adds smoothly to the same unbounded angular accumulator\\n    if (input.keyYawLeft) this.pendingYawRad += profile.yawSpeed * 0.85 * safeDt;\\n    if (input.keyYawRight) this.pendingYawRad -= profile.yawSpeed * 0.85 * safeDt;\\n    if (input.keyPitchUp) this.pendingPitchRad += profile.pitchSpeed * 0.85 * safeDt;\\n    if (input.keyPitchDown) this.pendingPitchRad -= profile.pitchSpeed * 0.85 * safeDt;\\n\\n    // Critically damped high-responsiveness integration consumes pending turn smoothly\\n    // while preserving 100% of total cumulative mouse rotation with zero snap-back.\\n    const responseRate = 24.0;\\n    const consumeFraction = 1 - Math.exp(-responseRate * safeDt);\\n    const stepYaw = this.pendingYawRad * consumeFraction;\\n    const stepPitch = this.pendingPitchRad * consumeFraction;\\n\\n    this.pendingYawRad -= stepYaw;\\n    this.pendingPitchRad -= stepPitch;\\n\\n    // Clean epsilon flush only when completely idle\\n    if (Math.abs(this.pendingYawRad) < 1e-6) this.pendingYawRad = 0;\\n    if (Math.abs(this.pendingPitchRad) < 1e-6) this.pendingPitchRad = 0;\\n\\n    // Track instantaneous smoothed angular velocity for camera turn lag & visual ship banking\\n    const instYawVel = stepYaw / safeDt;\\n    const instPitchVel = stepPitch / safeDt;\\n    const rateAlpha = 1 - Math.exp(-12.0 * safeDt);\\n    this.yawVelocity = THREE.MathUtils.lerp(\\n      this.yawVelocity,\\n      THREE.MathUtils.clamp(instYawVel, -profile.yawSpeed * 2.2, profile.yawSpeed * 2.2),\\n      rateAlpha,\\n    );\\n    this.pitchVelocity = THREE.MathUtils.lerp(\\n      this.pitchVelocity,\\n      THREE.MathUtils.clamp(instPitchVel, -profile.pitchSpeed * 2.2, profile.pitchSpeed * 2.2),\\n      rateAlpha,\\n    );\\n\\n    // 2. Independent Roll via A / D (exact Phase 1/2 roll feel preserved)\\n    let rollDir = 0;\\n    if (input.rollLeft) rollDir += 1;\\n    if (input.rollRight) rollDir -= 1;\\n    const targetRollRate = rollDir * profile.rollSpeed;\\n    const rollAlpha = 1 - Math.exp(-(profile.angularDamping * 1.25) * safeDt);\\n    this.rollVelocity = THREE.MathUtils.lerp(this.rollVelocity, targetRollRate, rollAlpha);\\n    const stepRoll = this.rollVelocity * safeDt;\\n\\n    // 3. Apply Pure Local-Space Quaternion Rotations (Zero Gimbal Lock at any pitch/yaw!)\\n    _qYaw.setFromAxisAngle(_AXIS_Y, stepYaw);\\n    _qPitch.setFromAxisAngle(_AXIS_X, stepPitch);\\n    _qRoll.setFromAxisAngle(_AXIS_Z, stepRoll);\\n\\n    this.quaternion.multiply(_qYaw);\\n    this.quaternion.multiply(_qPitch);\\n    this.quaternion.multiply(_qRoll);\\n    this.quaternion.normalize();\\n\\n    // Subtle visual bank when yawing without overriding deliberate A/D roll\\n    const targetBank = THREE.MathUtils.clamp(\\n      (this.yawVelocity / profile.yawSpeed) * profile.visualBankStrength,\\n      -0.44,\\n      0.44,\\n    );\\n    this.visualBankAngle = THREE.MathUtils.damp(this.visualBankAngle, targetBank, 6.5, safeDt);\\n\\n    // 4. Boost energy management (unchanged from Phase 1/2)\\n    if (this.boostLockedOut && this.boostEnergy >= 18) {\\n      this.boostLockedOut = false;\\n    }\\n\\n    const wantsBoost = input.boost && !input.backward && !this.boostLockedOut && this.boostEnergy > 0.5;\\n    const isBoosting = wantsBoost;\\n    this.boostJustEngaged = isBoosting && !this.wasBoosting;\\n    this.wasBoosting = isBoosting;\\n\\n    if (isBoosting) {\\n      this.boostEnergy = Math.max(0, this.boostEnergy - profile.boostDrainRate * safeDt);\\n      this.boostCooldownTimer = profile.boostRegenDelay;\\n      if (this.boostEnergy <= 0.1) {\\n        this.boostEnergy = 0;\\n        this.boostLockedOut = true;\\n      }\\n    } else {\\n      if (this.boostCooldownTimer > 0) {\\n        this.boostCooldownTimer = Math.max(0, this.boostCooldownTimer - safeDt);\\n      } else if (this.boostEnergy < profile.maxBoostEnergy) {\\n        this.boostEnergy = Math.min(\\n          profile.maxBoostEnergy,\\n          this.boostEnergy + profile.boostRegenRate * safeDt,\\n        );\\n      }\\n    }\\n\\n    this.boostIntensity = THREE.MathUtils.damp(\\n      this.boostIntensity,\\n      isBoosting ? 1 : 0,\\n      isBoosting ? 9.0 : 5.5,\\n      safeDt,\\n    );\\n\\n    // 5. Linear thrust, controlled arcade inertia, and lateral redirection (unchanged from Phase 1/2)\\n    _forwardWorld.copy(_FORWARD_LOCAL).applyQuaternion(this.quaternion).normalize();\\n    _rightWorld.copy(_AXIS_X).applyQuaternion(this.quaternion).normalize();\\n    _upWorld.copy(_AXIS_Y).applyQuaternion(this.quaternion).normalize();\\n\\n    const currentForwardSpeed = this.velocity.dot(_forwardWorld);\\n    const effectiveMaxSpeed = isBoosting\\n      ? profile.maxSpeed * profile.boostMultiplier\\n      : profile.maxSpeed;\\n\\n    let nextForwardSpeed = currentForwardSpeed;\\n    let throttle = 0;\\n\\n    if (isBoosting) {\\n      throttle = 1;\\n      const boostAccel = profile.acceleration * profile.boostAccelMultiplier;\\n      nextForwardSpeed = Math.min(effectiveMaxSpeed, currentForwardSpeed + boostAccel * safeDt);\\n    } else if (input.forward && !input.backward) {\\n      throttle = 1;\\n      if (currentForwardSpeed > profile.maxSpeed) {\\n        nextForwardSpeed = THREE.MathUtils.damp(currentForwardSpeed, profile.maxSpeed, 2.2, safeDt);\\n      } else {\\n        nextForwardSpeed = Math.min(\\n          profile.maxSpeed,\\n          currentForwardSpeed + profile.acceleration * safeDt,\\n        );\\n      }\\n    } else if (input.backward && !input.forward) {\\n      throttle = -1;\\n      nextForwardSpeed = Math.max(\\n        -profile.maxReverseSpeed,\\n        currentForwardSpeed - profile.deceleration * safeDt,\\n      );\\n    } else {\\n      const dragFactor = Math.exp(-profile.passiveDrag * safeDt);\\n      nextForwardSpeed = currentForwardSpeed * dragFactor;\\n      if (Math.abs(nextForwardSpeed) < 0.15) nextForwardSpeed = 0;\\n    }\\n\\n    _desiredVel.copy(_forwardWorld).multiplyScalar(nextForwardSpeed);\\n    const gripLambda = isBoosting ? profile.lateralGrip * 1.45 : profile.lateralGrip;\\n    const gripAlpha = 1 - Math.exp(-gripLambda * safeDt);\\n    this.velocity.lerp(_desiredVel, gripAlpha);\\n\\n    const updatedForward = this.velocity.dot(_forwardWorld);\\n    this.velocity.addScaledVector(_forwardWorld, nextForwardSpeed - updatedForward);\\n\\n    this.position.addScaledVector(this.velocity, safeDt);\\n\\n    // 6. Populate live HUD telemetry (in-place mutation, zero allocations)\\n    const speedMag = this.velocity.length();\\n    const signedSpeed = this.velocity.dot(_forwardWorld);\\n\\n    _euler.setFromQuaternion(this.quaternion, \'YXZ\');\\n    let headingDeg = THREE.MathUtils.radToDeg(-_euler.y) % 360;\\n    if (headingDeg < 0) headingDeg += 360;\\n\\n    let status: FlightStatus = \'DRIFTING\';\\n    if (this.boostLockedOut && input.boost) {\\n      status = \'BOOST DEPLETED\';\\n    } else if (isBoosting) {\\n      status = \'BOOSTING\';\\n    } else if (signedSpeed < -2.5) {\\n      status = \'REVERSING\';\\n    } else if (input.forward) {\\n      status = speedMag > profile.maxSpeed * 0.9 ? \'CRUISING\' : \'ACCELERATING\';\\n    } else if (speedMag < 2) {\\n      status = \'STANDBY\';\\n    } else {\\n      status = \'DRIFTING\';\\n    }\\n\\n    telemetry.speed = speedMag;\\n    telemetry.signedSpeed = signedSpeed;\\n    telemetry.maxSpeed = profile.maxSpeed;\\n    telemetry.effectiveMaxSpeed = effectiveMaxSpeed;\\n    telemetry.throttle = throttle;\\n    telemetry.boostEnergy = this.boostEnergy;\\n    telemetry.maxBoostEnergy = profile.maxBoostEnergy;\\n    telemetry.isBoosting = isBoosting;\\n    telemetry.boostDepleted = this.boostLockedOut;\\n    telemetry.boostIntensity = this.boostIntensity;\\n    telemetry.hull = this.hull;\\n    telemetry.maxHull = this.ship.maxHull;\\n    telemetry.yawRate = THREE.MathUtils.clamp(this.yawVelocity / profile.yawSpeed, -1, 1);\\n    telemetry.pitchRate = THREE.MathUtils.clamp(this.pitchVelocity / profile.pitchSpeed, -1, 1);\\n    telemetry.rollRate = THREE.MathUtils.clamp(this.rollVelocity / profile.rollSpeed, -1, 1);\\n    telemetry.aimNormalizedX = THREE.MathUtils.clamp(-this.yawVelocity / profile.yawSpeed, -1, 1);\\n    telemetry.aimNormalizedY = THREE.MathUtils.clamp(-this.pitchVelocity / profile.pitchSpeed, -1, 1);\\n    telemetry.headingDeg = headingDeg;\\n    telemetry.pitchDeg = THREE.MathUtils.radToDeg(_euler.x);\\n    telemetry.rollDeg = THREE.MathUtils.radToDeg(_euler.z);\\n    telemetry.altitude = this.position.y;\\n    telemetry.status = status;\\n    telemetry.pointerLocked = input.pointerLocked;\\n  }\\n}\\n\", \"Description\":\"Replace clamped gimbal aim offsets with unbounded continuous relative-delta quaternion turning in FlightController while preserving thrust, boost, and roll physics\", \"Overwrite\":true, \"TargetFile\":\"/src/engine/FlightController.ts\", \"toolAction\":\"Fixing FlightController continuous turning\", \"toolSummary\":\"Fix FlightController continuous turning\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_9139495820861463129"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Ensure chase camera smoothly tracks unbounded 360-degree continuous turns and loops without up-vector flip or snap-back\", \"EndLine\":112, \"Instruction\":\"Update look target and up-vector tracking in CameraController.updateChase for continuous 6DOF turning\", \"ReplacementContent\":\"    // Smooth camera up-vector roll tracking using orthonormalized projection to prevent flip during loops\\n    const upAlpha = 1 - Math.exp(-(9.2 * camSens) * safeDt);\\n    this.currentUp.lerp(_up, upAlpha);\\n    if (this.currentUp.lengthSq() < 0.001) {\\n      this.currentUp.copy(_up);\\n    } else {\\n      this.currentUp.normalize();\\n    }\\n\\n    // Look directly ahead along ship\'s true forward flight vector with crisp turn tracking\\n    _lookTarget.copy(flight.position).addScaledVector(_forward, 34).addScaledVector(_up, 0.78);\\n\\n    _lookMatrix.lookAt(this.currentPos, _lookTarget, this.currentUp);\\n    _desiredQuat.setFromRotationMatrix(_lookMatrix);\\n\\n    const rotAlpha = 1 - Math.exp(-(13.0 * camSens) * safeDt);\\n    this.currentQuat.slerp(_desiredQuat, rotAlpha);\", \"StartLine\":96, \"TargetContent\":\"    // Smooth camera up-vector roll tracking (responsive yet fluid on A/D rolls)\\n    const upAlpha = 1 - Math.exp(-(7.8 * camSens) * safeDt);\\n    this.currentUp.lerp(_up, upAlpha).normalize();\\n\\n    // Gently blend look target toward the expanded gimbaled aim vector so wide aiming stays well framed\\n    flight.getAimDirectionWorld(_lookTarget);\\n    _lookTarget.lerp(_forward, 0.58).normalize();\\n    _lookTarget.multiplyScalar(32).add(flight.position).addScaledVector(_up, 0.72);\\n\\n    _lookMatrix.lookAt(this.currentPos, _lookTarget, this.currentUp);\\n    _desiredQuat.setFromRotationMatrix(_lookMatrix);\\n\\n    const rotAlpha = 1 - Math.exp(-(11.5 * camSens) * safeDt);\\n    this.currentQuat.slerp(_desiredQuat, rotAlpha);\", \"TargetFile\":\"/src/engine/CameraController.ts\", \"toolAction\":\"Refining CameraController continuous tracking\", \"toolSummary\":\"Refine CameraController tracking\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_9139495820861463558"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import * as THREE from \'three\';\\nimport type { ShipId } from \'../types/game\';\\nimport type { MissionDefinition, MissionEnvironmentTheme } from \'../types/mission\';\\n\\nexport interface HullTextureBundle {\\n  hullAlbedo: THREE.CanvasTexture;\\n  hullRoughness: THREE.CanvasTexture;\\n  hullBump: THREE.CanvasTexture;\\n}\\n\\nexport interface EnvironmentTextureBundle {\\n  themeId: string;\\n  resolution: number;\\n  gasGiantMap: THREE.CanvasTexture;\\n  moonMap: THREE.CanvasTexture;\\n  asteroidMap: THREE.CanvasTexture;\\n}\\n\\nexport interface AssetDiagnostics {\\n  cachedResources: number;\\n  totalRefs: number;\\n  lastLoadDurationMs: number;\\n  loadedKeys: string[];\\n}\\n\\ninterface CacheEntry<T> {\\n  value: T;\\n  refs: number;\\n  scope: \'shared\' | \'ship\' | \'mission\';\\n  dispose: () => void;\\n}\\n\\nconst DEFAULT_MENU_THEME: MissionEnvironmentTheme = {\\n  id: \'aurelia-rim\',\\n  sectorName: \'Aurelia Outer Rim\',\\n  nebulaVoid: [0.012, 0.024, 0.058],\\n  nebulaMid: [0.032, 0.088, 0.215],\\n  nebulaIon: [0.045, 0.42, 0.64],\\n  fogColor: \'#040a18\',\\n  keyLightColor: \'#f8fafc\',\\n  hemiSkyColor: \'#38bdf8\',\\n  rimLightColor: \'#0ea5e9\',\\n  planetBands: [\'#071024\', \'#1e3a5f\', \'#6fa3c7\', \'#132a4f\'],\\n  atmosphereColor: \'#38bdf8\',\\n  asteroidTint: \'#94a3b8\',\\n  beaconColor: \'#22d3ee\',\\n};\\n\\nfunction yieldToMainThread(): Promise<void> {\\n  return new Promise((resolve) => {\\n    if (typeof window !== \'undefined\' && typeof window.requestAnimationFrame === \'function\') {\\n      window.requestAnimationFrame(() => resolve());\\n    } else {\\n      setTimeout(resolve, 0);\\n    }\\n  });\\n}\\n\\nfunction nowMs(): number {\\n  return typeof performance !== \'undefined\' ? performance.now() : Date.now();\\n}\\n\\n/**\\n * Centralized Progressive Asset Manager (Stages A\342\200\223E):\\n * - Stage A (Boot): Lightweight shared glow sprite only; avoids eager planetary/ship generation.\\n * - Stage B (Hangar): On-demand ship hull textures + idle background preloading.\\n * - Stage C (Mission Prep): Loads mission-specific themed planet/moon/asteroid maps, hull PBR maps,\\n *   and VFX textures with progress reporting, abort cancellation, and error recovery.\\n * - Stage D (Runtime): Reference-counted cache avoids duplicate allocations.\\n * - Stage E (Cleanup): Disposes mission-specific GPU textures on mission exit while preserving\\n *   shared resources still referenced by active scenes.\\n */\\nclass AssetManagerImpl {\\n  private cache = new Map<string, CacheEntry<unknown>>();\\n  private maxAnisotropy = 4;\\n  private lastLoadDurationMs = 0;\\n  private activeMissionEnvKeys = new Set<string>();\\n  private preloadedShips = new Set<ShipId>();\\n\\n  public configureRenderer(renderer: THREE.WebGLRenderer): void {\\n    this.maxAnisotropy = Math.min(renderer.capabilities.getMaxAnisotropy(), 8);\\n  }\\n\\n  public acquire<T>(\\n    key: string,\\n    scope: \'shared\' | \'ship\' | \'mission\',\\n    factory: () => T,\\n    dispose: (val: T) => void,\\n  ): T {\\n    const existing = this.cache.get(key) as CacheEntry<T> | undefined;\\n    if (existing) {\\n      existing.refs += 1;\\n      return existing.value;\\n    }\\n    const value = factory();\\n    this.cache.set(key, {\\n      value,\\n      refs: 1,\\n      scope,\\n      dispose: () => dispose(value),\\n    });\\n    return value;\\n  }\\n\\n  public release(key: string): void {\\n    const entry = this.cache.get(key);\\n    if (!entry) return;\\n    entry.refs -= 1;\\n    if (entry.refs <= 0) {\\n      entry.dispose();\\n      this.cache.delete(key);\\n    }\\n  }\\n\\n  public hasCached(key: string): boolean {\\n    return this.cache.has(key);\\n  }\\n\\n  public getDiagnostics(): AssetDiagnostics {\\n    let totalRefs = 0;\\n    const loadedKeys: string[] = [];\\n    for (const [key, entry] of this.cache.entries()) {\\n      totalRefs += entry.refs;\\n      loadedKeys.push(key);\\n    }\\n    return {\\n      cachedResources: this.cache.size,\\n      totalRefs,\\n      lastLoadDurationMs: this.lastLoadDurationMs,\\n      loadedKeys,\\n    };\\n  }\\n\\n  /**\\n   * Stage A (Boot): Shared radial glow sprite for thrusters, muzzle flashes, and shockwaves.\\n   */\\n  public acquireGlowSprite(): THREE.CanvasTexture {\\n    return this.acquire<THREE.CanvasTexture>(\\n      \'shared:glowSprite\',\\n      \'shared\',\\n      () => this.createGlowSpriteTexture(),\\n      (tex) => tex.dispose(),\\n    );\\n  }\\n\\n  public releaseGlowSprite(): void {\\n    this.release(\'shared:glowSprite\');\\n  }\\n\\n  /**\\n   * Stage B / C: Acquires shared ship hull PBR textures at the requested resolution.\\n   */\\n  public acquireHullTextures(resolution: 256 | 512 | 1024 = 512): {\\n    key: string;\\n    bundle: HullTextureBundle;\\n  } {\\n    const key = `ship:hullPbr:${resolution}`;\\n    const bundle = this.acquire<HullTextureBundle>(\\n      key,\\n      \'ship\',\\n      () => ({\\n        hullAlbedo: this.createHullAlbedoTexture(resolution),\\n        hullRoughness: this.createHullRoughnessTexture(resolution),\\n        hullBump: this.createHullBumpTexture(resolution),\\n      }),\\n      (b) => {\\n        b.hullAlbedo.dispose();\\n        b.hullRoughness.dispose();\\n        b.hullBump.dispose();\\n      },\\n    );\\n    return { key, bundle };\\n  }\\n\\n  public releaseHullTextures(key: string): void {\\n    this.release(key);\\n  }\\n\\n  /**\\n   * Stage B (Hangar): Marks ship assets ready and schedules non-blocking idle preload.\\n   */\\n  public preloadShipInBackground(shipId: ShipId, resolution: 256 | 512 | 1024 = 512): void {\\n    if (this.preloadedShips.has(shipId)) return;\\n    this.preloadedShips.add(shipId);\\n\\n    const runPreload = () => {\\n      const key = `ship:hullPbr:${resolution}`;\\n      if (!this.cache.has(key)) {\\n        // Warm cache once and keep ref=1 so hangar switching is instant\\n        this.acquireHullTextures(resolution);\\n      }\\n    };\\n\\n    if (typeof window !== \'undefined\' && \'requestIdleCallback\' in window) {\\n      (window as unknown as { requestIdleCallback: (cb: () => void) => void }).requestIdleCallback(\\n        runPreload,\\n      );\\n    } else {\\n      setTimeout(runPreload, 40);\\n    }\\n  }\\n\\n  /**\\n   * Stage C / D: Acquires mission-themed environment textures (gas giant, moon, asteroid)\\n   * keyed by theme ID and graphics resolution.\\n   */\\n  public acquireEnvironmentTextures(\\n    theme: MissionEnvironmentTheme = DEFAULT_MENU_THEME,\\n    resolution: 256 | 512 | 1024 = 512,\\n  ): { key: string; bundle: EnvironmentTextureBundle } {\\n    const key = `mission:${theme.id}:env:${resolution}`;\\n    const bundle = this.acquire<EnvironmentTextureBundle>(\\n      key,\\n      \'mission\',\\n      () => ({\\n        themeId: theme.id,\\n        resolution,\\n        gasGiantMap: this.createGasGiantTexture(theme, resolution),\\n        moonMap: this.createMoonTexture(theme, Math.max(256, resolution >> 1)),\\n        asteroidMap: this.createAsteroidTexture(theme, Math.min(256, resolution)),\\n      }),\\n      (b) => {\\n        b.gasGiantMap.dispose();\\n        b.moonMap.dispose();\\n        b.asteroidMap.dispose();\\n      },\\n    );\\n    return { key, bundle };\\n  }\\n\\n  public releaseEnvironmentTextures(key: string): void {\\n    this.release(key);\\n  }\\n\\n  /**\\n   * Stage C (Mission Preparation):\\n   * Progressive async loader for a specific campaign mission.\\n   * Loads only what the selected mission & ship need, yields between steps for responsive UI,\\n   * supports abort cancellation, tracks load duration, and recovers cleanly on error.\\n   */\\n  public async loadMissionAssets(\\n    mission: MissionDefinition,\\n    shipId: ShipId,\\n    resolution: 256 | 512 | 1024,\\n    onProgress: (stage: string, percent: number) => void,\\n    signal?: AbortSignal,\\n    options?: { simulateFailure?: boolean },\\n  ): Promise<{ envKey: string; hullKey: string; durationMs: number }> {\\n    const started = nowMs();\\n    const acquiredDuringLoad: string[] = [];\\n\\n    const checkAborted = () => {\\n      if (signal?.aborted) {\\n        for (const k of acquiredDuringLoad) {\\n          this.release(k);\\n        }\\n        throw new Error(\'ABORTED\');\\n      }\\n    };\\n\\n    try {\\n      onProgress(`Initializing ${mission.code} tactical brief (${mission.environment.sectorName})`, 12);\\n      await yieldToMainThread();\\n      checkAborted();\\n\\n      if (options?.simulateFailure) {\\n        throw new Error(\'Simulated sector telemetry asset failure\');\\n      }\\n\\n      onProgress(`Loading ${shipId.toUpperCase()} hull PBR maps (${resolution}px)`, 36);\\n      await yieldToMainThread();\\n      checkAborted();\\n      const hullRes = this.acquireHullTextures(resolution);\\n      acquiredDuringLoad.push(hullRes.key);\\n\\n      onProgress(`Synthesizing ${mission.environment.sectorName} planetary & orbital textures`, 68);\\n      await yieldToMainThread();\\n      checkAborted();\\n      const envRes = this.acquireEnvironmentTextures(mission.environment, resolution);\\n      acquiredDuringLoad.push(envRes.key);\\n      this.activeMissionEnvKeys.add(envRes.key);\\n\\n      onProgress(\'Warming weapon VFX sprites & pooled combat systems\', 90);\\n      await yieldToMainThread();\\n      checkAborted();\\n      this.acquireGlowSprite();\\n      acquiredDuringLoad.push(\'shared:glowSprite\');\\n\\n      const durationMs = Math.max(1, nowMs() - started);\\n      this.lastLoadDurationMs = durationMs;\\n\\n      onProgress(`${mission.code} flight systems ready`, 100);\\n      await yieldToMainThread();\\n      checkAborted();\\n\\n      return { envKey: envRes.key, hullKey: hullRes.key, durationMs };\\n    } catch (err) {\\n      for (const k of acquiredDuringLoad) {\\n        this.release(k);\\n        this.activeMissionEnvKeys.delete(k);\\n      }\\n      throw err;\\n    }\\n  }\\n\\n  /**\\n   * Stage E (Cleanup & Transition):\\n   * Releases mission-scoped references acquired during Stage C so unused mission textures\\n   * are disposed from GPU memory while shared assets still used by Menu/Ship remain intact.\\n   */\\n  public releaseMissionSession(envKey: string | null, hullKey: string | null): void {\\n    if (envKey) {\\n      this.release(envKey);\\n      this.activeMissionEnvKeys.delete(envKey);\\n    }\\n    if (hullKey) {\\n      this.release(hullKey);\\n    }\\n    this.releaseGlowSprite();\\n  }\\n\\n  private configureTexture(\\n    tex: THREE.CanvasTexture,\\n    isColor: boolean,\\n    repeatX = 1,\\n    repeatY = 1,\\n  ): THREE.CanvasTexture {\\n    tex.wrapS = THREE.RepeatWrapping;\\n    tex.wrapT = THREE.RepeatWrapping;\\n    tex.repeat.set(repeatX, repeatY);\\n    tex.colorSpace = isColor ? THREE.SRGBColorSpace : THREE.NoColorSpace;\\n    tex.anisotropy = this.maxAnisotropy;\\n    tex.needsUpdate = true;\\n    return tex;\\n  }\\n\\n  private createCanvas(width: number, height: number): {\\n    canvas: HTMLCanvasElement | null;\\n    ctx: CanvasRenderingContext2D | null;\\n  } {\\n    if (typeof document === \'undefined\') {\\n      return { canvas: null, ctx: null };\\n    }\\n    const canvas = document.createElement(\'canvas\');\\n    canvas.width = width;\\n    canvas.height = height;\\n    const ctx = canvas.getContext(\'2d\');\\n    return { canvas, ctx };\\n  }\\n\\n  private createTextureFromCanvas(\\n    canvas: HTMLCanvasElement | null,\\n    isColor: boolean,\\n    repeatX = 1,\\n    repeatY = 1,\\n  ): THREE.CanvasTexture {\\n    const tex = new THREE.CanvasTexture(canvas ?? undefined);\\n    return this.configureTexture(tex, isColor, repeatX, repeatY);\\n  }\\n\\n  private createHullAlbedoTexture(size: number): THREE.CanvasTexture {\\n    const { canvas, ctx } = this.createCanvas(size, size);\\n    if (!ctx) return this.createTextureFromCanvas(canvas, true, 2, 2);\\n\\n    const s = size / 512;\\n    ctx.fillStyle = \'#c8d4e3\';\\n    ctx.fillRect(0, 0, size, size);\\n\\n    for (let y = 0; y < size; y += 2) {\\n      const shade = 192 + ((Math.sin(y * 0.73) * 7 + Math.cos(y * 2.1) * 5) | 0);\\n      ctx.fillStyle = `rgb(${shade - 6}, ${shade}, ${shade + 8})`;\\n      ctx.fillRect(0, y, size, 2);\\n    }\\n\\n    const panels = [\\n      [16, 16, 224, 140, \'rgba(255,255,255,0.06)\'],\\n      [256, 16, 240, 220, \'rgba(15,23,42,0.09)\'],\\n      [16, 172, 224, 160, \'rgba(15,23,42,0.06)\'],\\n      [256, 252, 240, 244, \'rgba(255,255,255,0.05)\'],\\n      [16, 348, 224, 148, \'rgba(30,41,59,0.08)\'],\\n    ] as const;\\n\\n    for (const [x, y, w, h, fill] of panels) {\\n      ctx.fillStyle = fill;\\n      ctx.fillRect(x * s, y * s, w * s, h * s);\\n      ctx.strokeStyle = \'rgba(15, 23, 42, 0.45)\';\\n      ctx.lineWidth = Math.max(1, 2 * s);\\n      ctx.strokeRect(x * s, y * s, w * s, h * s);\\n      ctx.strokeStyle = \'rgba(226, 232, 240, 0.25)\';\\n      ctx.lineWidth = Math.max(1, s);\\n      ctx.strokeRect((x + 2) * s, (y + 2) * s, (w - 4) * s, (h - 4) * s);\\n    }\\n\\n    ctx.fillStyle = \'rgba(15, 23, 42, 0.5)\';\\n    const step = Math.max(32, Math.round(64 * s));\\n    for (let x = Math.round(28 * s); x < size; x += step) {\\n      for (let y = Math.round(28 * s); y < size; y += step) {\\n        ctx.beginPath();\\n        ctx.arc(x, y, Math.max(1, 1.8 * s), 0, Math.PI * 2);\\n        ctx.fill();\\n      }\\n    }\\n\\n    return this.createTextureFromCanvas(canvas, true, 2, 2);\\n  }\\n\\n  private createHullRoughnessTexture(size: number): THREE.CanvasTexture {\\n    const { canvas, ctx } = this.createCanvas(size, size);\\n    if (!ctx) return this.createTextureFromCanvas(canvas, false, 2, 2);\\n\\n    const s = size / 512;\\n    ctx.fillStyle = \'#585858\';\\n    ctx.fillRect(0, 0, size, size);\\n\\n    ctx.fillStyle = \'#404040\';\\n    ctx.fillRect(16 * s, 16 * s, 224 * s, 140 * s);\\n    ctx.fillStyle = \'#6c6c6c\';\\n    ctx.fillRect(256 * s, 16 * s, 240 * s, 220 * s);\\n    ctx.fillStyle = \'#4d4d4d\';\\n    ctx.fillRect(256 * s, 252 * s, 240 * s, 244 * s);\\n\\n    ctx.strokeStyle = \'#b8b8b8\';\\n    ctx.lineWidth = Math.max(1, 3 * s);\\n    ctx.strokeRect(16 * s, 16 * s, 224 * s, 140 * s);\\n    ctx.strokeRect(256 * s, 16 * s, 240 * s, 220 * s);\\n    ctx.strokeRect(16 * s, 172 * s, 224 * s, 160 * s);\\n    ctx.strokeRect(256 * s, 252 * s, 240 * s, 244 * s);\\n\\n    return this.createTextureFromCanvas(canvas, false, 2, 2);\\n  }\\n\\n  private createHullBumpTexture(size: number): THREE.CanvasTexture {\\n    const { canvas, ctx } = this.createCanvas(size, size);\\n    if (!ctx) return this.createTextureFromCanvas(canvas, false, 2, 2);\\n\\n    const s = size / 512;\\n    ctx.fillStyle = \'#808080\';\\n    ctx.fillRect(0, 0, size, size);\\n\\n    ctx.strokeStyle = \'#202020\';\\n    ctx.lineWidth = Math.max(1, 3 * s);\\n    ctx.strokeRect(16 * s, 16 * s, 224 * s, 140 * s);\\n    ctx.strokeRect(256 * s, 16 * s, 240 * s, 220 * s);\\n    ctx.strokeRect(16 * s, 172 * s, 224 * s, 160 * s);\\n    ctx.strokeRect(256 * s, 252 * s, 240 * s, 244 * s);\\n    ctx.strokeRect(16 * s, 348 * s, 224 * s, 148 * s);\\n\\n    ctx.strokeStyle = \'#383838\';\\n    ctx.lineWidth = Math.max(1, 2 * s);\\n    ctx.strokeRect(64 * s, 56 * s, 48 * s, 32 * s);\\n    ctx.strokeRect(320 * s, 310 * s, 68 * s, 42 * s);\\n\\n    return this.createTextureFromCanvas(canvas, false, 2, 2);\\n  }\\n\\n  private createGasGiantTexture(\\n    theme: MissionEnvironmentTheme,\\n    resolution: number,\\n  ): THREE.CanvasTexture {\\n    const w = resolution;\\n    const h = Math.max(128, resolution >> 1);\\n    const { canvas, ctx } = this.createCanvas(w, h);\\n    if (!ctx) return this.createTextureFromCanvas(canvas, true, 1, 1);\\n\\n    const [c0, c1, c2, c3] = theme.planetBands;\\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\\n    grad.addColorStop(0.0, c0);\\n    grad.addColorStop(0.24, c1);\\n    grad.addColorStop(0.5, c2);\\n    grad.addColorStop(0.76, c3);\\n    grad.addColorStop(1.0, c0);\\n    ctx.fillStyle = grad;\\n    ctx.fillRect(0, 0, w, h);\\n\\n    const bandCount = Math.max(28, Math.round(h / 8));\\n    for (let i = 0; i < bandCount; i++) {\\n      const y = (i / bandCount) * h;\\n      const bandH = 2 + ((i * 7) % 12) * (h / 512);\\n      const alpha = 0.08 + ((i * 13) % 10) * 0.014;\\n      ctx.fillStyle =\\n        i % 3 === 0 ? `rgba(186, 230, 253, ${alpha})` : `rgba(8, 18, 38, ${alpha * 1.4})`;\\n\\n      ctx.beginPath();\\n      ctx.moveTo(0, y);\\n      const stepX = Math.max(16, w / 32);\\n      for (let x = 0; x <= w; x += stepX) {\\n        const wave = Math.sin(x * 0.015 + i * 1.3) * 4 + Math.cos(x * 0.03 - i * 0.7) * 2.5;\\n        ctx.lineTo(x, y + wave);\\n      }\\n      ctx.lineTo(w, y + bandH);\\n      ctx.lineTo(0, y + bandH);\\n      ctx.closePath();\\n      ctx.fill();\\n    }\\n\\n    const stormR = w * 0.068;\\n    const stormGrad = ctx.createRadialGradient(w * 0.62, h * 0.44, 4, w * 0.62, h * 0.44, stormR);\\n    stormGrad.addColorStop(0, \'rgba(224, 242, 254, 0.55)\');\\n    stormGrad.addColorStop(0.45, \'rgba(56, 189, 248, 0.25)\');\\n    stormGrad.addColorStop(1, \'rgba(14, 116, 144, 0)\');\\n    ctx.save();\\n    ctx.scale(1.6, 0.72);\\n    ctx.fillStyle = stormGrad;\\n    ctx.beginPath();\\n    ctx.arc((w * 0.62) / 1.6, (h * 0.44) / 0.72, stormR, 0, Math.PI * 2);\\n    ctx.fill();\\n    ctx.restore();\\n\\n    return this.createTextureFromCanvas(canvas, true, 1, 1);\\n  }\\n\\n  private createMoonTexture(theme: MissionEnvironmentTheme, w: number): THREE.CanvasTexture {\\n    const h = Math.max(128, w >> 1);\\n    const { canvas, ctx } = this.createCanvas(w, h);\\n    if (!ctx) return this.createTextureFromCanvas(canvas, true, 1, 1);\\n\\n    ctx.fillStyle = \'#475569\';\\n    ctx.fillRect(0, 0, w, h);\\n\\n    // Subtle mission tint wash\\n    ctx.fillStyle = theme.asteroidTint;\\n    ctx.globalAlpha = 0.16;\\n    ctx.fillRect(0, 0, w, h);\\n    ctx.globalAlpha = 1;\\n\\n    for (let i = 0; i < 90; i++) {\\n      const x = (i * 97) % w;\\n      const y = (i * 53) % h;\\n      const r = 6 + ((i * 19) % 28);\\n      ctx.fillStyle = i % 2 === 0 ? \'rgba(148, 163, 184, 0.14)\' : \'rgba(15, 23, 42, 0.22)\';\\n      ctx.beginPath();\\n      ctx.arc(x, y, r, 0, Math.PI * 2);\\n      ctx.fill();\\n    }\\n\\n    for (let i = 0; i < 36; i++) {\\n      const x = (i * 131 + 29) % w;\\n      const y = 16 + ((i * 71) % Math.max(16, h - 32));\\n      const r = 4 + ((i * 11) % 16);\\n      ctx.fillStyle = \'rgba(15, 23, 42, 0.36)\';\\n      ctx.beginPath();\\n      ctx.arc(x, y, r, 0, Math.PI * 2);\\n      ctx.fill();\\n      ctx.strokeStyle = \'rgba(203, 213, 225, 0.22)\';\\n      ctx.lineWidth = 1.2;\\n      ctx.beginPath();\\n      ctx.arc(x - 1, y - 1, r, 0, Math.PI * 2);\\n      ctx.stroke();\\n    }\\n\\n    return this.createTextureFromCanvas(canvas, true, 1, 1);\\n  }\\n\\n  private createAsteroidTexture(theme: MissionEnvironmentTheme, size: number): THREE.CanvasTexture {\\n    const { canvas, ctx } = this.createCanvas(size, size);\\n    if (!ctx) return this.createTextureFromCanvas(canvas, true, 1, 1);\\n\\n    ctx.fillStyle = \'#334155\';\\n    ctx.fillRect(0, 0, size, size);\\n    ctx.fillStyle = theme.asteroidTint;\\n    ctx.globalAlpha = 0.15;\\n    ctx.fillRect(0, 0, size, size);\\n    ctx.globalAlpha = 1;\\n\\n    for (let i = 0; i < 72; i++) {\\n      const x = (i * 67) % size;\\n      const y = (i * 41) % size;\\n      const r = 4 + ((i * 13) % 18);\\n      ctx.fillStyle = i % 3 === 0 ? \'rgba(100,116,139,0.22)\' : \'rgba(15,23,42,0.28)\';\\n      ctx.beginPath();\\n      ctx.arc(x, y, r, 0, Math.PI * 2);\\n      ctx.fill();\\n    }\\n\\n    return this.createTextureFromCanvas(canvas, true, 1, 1);\\n  }\\n\\n  private createGlowSpriteTexture(): THREE.CanvasTexture {\\n    const size = 128;\\n    const { canvas, ctx } = this.createCanvas(size, size);\\n    if (!ctx) {\\n      const tex = new THREE.CanvasTexture(canvas ?? undefined);\\n      tex.colorSpace = THREE.SRGBColorSpace;\\n      return tex;\\n    }\\n    const c = size / 2;\\n    const grad = ctx.createRadialGradient(c, c, 0, c, c, c);\\n    grad.addColorStop(0.0, \'rgba(255, 255, 255, 1.0)\');\\n    grad.addColorStop(0.25, \'rgba(165, 243, 252, 0.78)\');\\n    grad.addColorStop(0.55, \'rgba(6, 182, 212, 0.28)\');\\n    grad.addColorStop(1.0, \'rgba(6, 182, 212, 0.0)\');\\n    ctx.fillStyle = grad;\\n    ctx.fillRect(0, 0, size, size);\\n    const tex = new THREE.CanvasTexture(canvas!);\\n    tex.colorSpace = THREE.SRGBColorSpace;\\n    tex.needsUpdate = true;\\n    return tex;\\n  }\\n\\n  public disposeAll(): void {\\n    for (const entry of this.cache.values()) {\\n      entry.dispose();\\n    }\\n    this.cache.clear();\\n    this.activeMissionEnvKeys.clear();\\n    this.preloadedShips.clear();\\n  }\\n}\\n\\nexport const AssetManager = new AssetManagerImpl();\\n\", \"Description\":\"Upgrade AssetManager to implement 5-stage progressive loading (Boot, Hangar, Mission Prep, Runtime, Cleanup) with reference counting, mission-scoped GPU disposal, abort handling, and diagnostics\", \"Overwrite\":true, \"TargetFile\":\"/src/engine/AssetManager.ts\", \"toolAction\":\"Upgrading AssetManager progressive loading\", \"toolSummary\":\"Upgrade AssetManager progressive loading\"}"
      original_name: "write_to_file"
