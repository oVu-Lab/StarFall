    }
    command_line: "NODE_PATH=/usr/local/share/bun-global/node_modules node -e \'\nconst { chromium } = require(\"playwright\");\n(async () => {\n  const browser = await chromium.launch({\n    headless: true,\n    args: [\"--no-sandbox\", \"--use-gl=angle\", \"--use-angle=swiftshader\"]\n  });\n  const page = await browser.newPage({ viewport: { width: 1280, height: 720 } });\n  page.setDefaultTimeout(5000);\n  page.on(\"pageerror\", e => console.log(\"[pageerror]\", e.message));\n\n  await page.addInitScript(() => {\n    window.__plEvents = [];\n    const origReq = Element.prototype.requestPointerLock;\n    Element.prototype.requestPointerLock = function(opts) {\n      window.__plEvents.push({ type: \"requestPointerLock\", tag: this.tagName, opts: opts || null });\n      try {\n        const res = origReq.apply(this, arguments);\n        if (res && typeof res.then === \"function\") {\n          res.then(\n            () => window.__plEvents.push({ type: \"resolved\", el: document.pointerLockElement?.tagName || null }),\n            (err) => window.__plEvents.push({ type: \"rejected\", name: err?.name, msg: err?.message })\n          );\n        }\n        return res;\n      } catch (err) {\n        window.__plEvents.push({ type: \"threw\", name: err?.name, msg: err?.message });\n        throw err;\n      }\n    };\n    document.addEventListener(\"pointerlockchange\", () => {\n      window.__plEvents.push({ type: \"pointerlockchange\", el: document.pointerLockElement?.tagName || null });\n    });\n    document.addEventListener(\"pointerlockerror\", () => {\n      window.__plEvents.push({ type: \"pointerlockerror\", el: document.pointerLockElement?.tagName || null });\n    });\n    window.__moves = [];\n    window.addEventListener(\"mousemove\", (e) => {\n      window.__moves.push({ mx: e.movementX, my: e.movementY, cx: e.clientX, cy: e.clientY, locked: Boolean(document.pointerLockElement) });\n    }, { capture: true });\n  });\n\n  await page.goto(\"http://localhost:3000/\", { waitUntil: \"domcontentloaded\" });\n  await page.waitForTimeout(800);\n  await page.getByRole(\"button\", { name: /Campaign Missions/i }).click();\n  await page.waitForTimeout(200);\n  await page.getByRole(\"button\", { name: /Launch M-01/i }).click();\n  await page.waitForTimeout(2500);\n\n  const pl1 = await page.evaluate(() => ({ plEl: document.pointerLockElement?.tagName || null, events: window.__plEvents, buttons: Array.from(document.querySelectorAll(\"button\")).map(b => b.innerText) }));\n  console.log(\"After Launch:\", JSON.stringify(pl1));\n\n  const lockBtn = page.getByRole(\"button\", { name: /Click to Engage/i });\n  if (await lockBtn.isVisible().catch(() => false)) {\n    await lockBtn.click();\n    await page.waitForTimeout(300);\n  } else {\n    await page.mouse.click(640, 360);\n    await page.waitForTimeout(300);\n  }\n  const pl2 = await page.evaluate(() => ({ plEl: document.pointerLockElement?.tagName || null, events: window.__plEvents }));\n  console.log(\"After Click:\", JSON.stringify(pl2));\n\n  await page.mouse.move(640, 360);\n  for (let i = 1; i <= 15; i++) {\n    await page.mouse.move(640 + i * 60, 360);\n  }\n  const moves = await page.evaluate(() => window.__moves);\n  console.log(\"Moves count:\", moves.length, \"data:\", JSON.stringify(moves));\n  await browser.close();\n  process.exit(0);\n})().catch(e => { console.error(e); process.exit(1); });\n\'"
    proposed_command_line: "NODE_PATH=/usr/local/share/bun-global/node_modules node -e \'\nconst { chromium } = require(\"playwright\");\n(async () => {\n  const browser = await chromium.launch({\n    headless: true,\n    args: [\"--no-sandbox\", \"--use-gl=angle\", \"--use-angle=swiftshader\"]\n  });\n  const page = await browser.newPage({ viewport: { width: 1280, height: 720 } });\n  page.setDefaultTimeout(5000);\n  page.on(\"pageerror\", e => console.log(\"[pageerror]\", e.message));\n\n  await page.addInitScript(() => {\n    window.__plEvents = [];\n    const origReq = Element.prototype.requestPointerLock;\n    Element.prototype.requestPointerLock = function(opts) {\n      window.__plEvents.push({ type: \"requestPointerLock\", tag: this.tagName, opts: opts || null });\n      try {\n        const res = origReq.apply(this, arguments);\n        if (res && typeof res.then === \"function\") {\n          res.then(\n            () => window.__plEvents.push({ type: \"resolved\", el: document.pointerLockElement?.tagName || null }),\n            (err) => window.__plEvents.push({ type: \"rejected\", name: err?.name, msg: err?.message })\n          );\n        }\n        return res;\n      } catch (err) {\n        window.__plEvents.push({ type: \"threw\", name: err?.name, msg: err?.message });\n        throw err;\n      }\n    };\n    document.addEventListener(\"pointerlockchange\", () => {\n      window.__plEvents.push({ type: \"pointerlockchange\", el: document.pointerLockElement?.tagName || null });\n    });\n    document.addEventListener(\"pointerlockerror\", () => {\n      window.__plEvents.push({ type: \"pointerlockerror\", el: document.pointerLockElement?.tagName || null });\n    });\n    window.__moves = [];\n    window.addEventListener(\"mousemove\", (e) => {\n      window.__moves.push({ mx: e.movementX, my: e.movementY, cx: e.clientX, cy: e.clientY, locked: Boolean(document.pointerLockElement) });\n    }, { capture: true });\n  });\n\n  await page.goto(\"http://localhost:3000/\", { waitUntil: \"domcontentloaded\" });\n  await page.waitForTimeout(800);\n  await page.getByRole(\"button\", { name: /Campaign Missions/i }).click();\n  await page.waitForTimeout(200);\n  await page.getByRole(\"button\", { name: /Launch M-01/i }).click();\n  await page.waitForTimeout(2500);\n\n  const pl1 = await page.evaluate(() => ({ plEl: document.pointerLockElement?.tagName || null, events: window.__plEvents, buttons: Array.from(document.querySelectorAll(\"button\")).map(b => b.innerText) }));\n  console.log(\"After Launch:\", JSON.stringify(pl1));\n\n  const lockBtn = page.getByRole(\"button\", { name: /Click to Engage/i });\n  if (await lockBtn.isVisible().catch(() => false)) {\n    await lockBtn.click();\n    await page.waitForTimeout(300);\n  } else {\n    await page.mouse.click(640, 360);\n    await page.waitForTimeout(300);\n  }\n  const pl2 = await page.evaluate(() => ({ plEl: document.pointerLockElement?.tagName || null, events: window.__plEvents }));\n  console.log(\"After Click:\", JSON.stringify(pl2));\n\n  await page.mouse.move(640, 360);\n  for (let i = 1; i <= 15; i++) {\n    await page.mouse.move(640 + i * 60, 360);\n  }\n  const moves = await page.evaluate(() => window.__moves);\n  console.log(\"Moves count:\", moves.length, \"data:\", JSON.stringify(moves));\n  await browser.close();\n  process.exit(0);\n})().catch(e => { console.error(e); process.exit(1); });\n\'"
