            }
            lines {
              text: "    float cassiniGap = 1.0 - smoothstep(0.61, 0.64, t) * (1.0 - smoothstep(0.68, 0.71, t));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    float edgeFade = smoothstep(0.0, 0.09, t) * (1.0 - smoothstep(0.88, 1.0, t));"
