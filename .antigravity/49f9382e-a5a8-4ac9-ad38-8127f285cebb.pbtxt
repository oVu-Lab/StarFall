    end_line: 229
    content: "        const bRatio = Math.max(0, Math.min(1, t.boostEnergy / Math.max(t.maxBoostEnergy, 1)));\n        boostBarRef.current.style.transform = `scaleX(${bRatio})`;\n        boostBarRef.current.style.backgroundColor = t.boostDepleted\n          ? \'#f59e0b\'\n          : t.isBoosting\n            ? \'#a5f3fc\'\n            : \'#22d3ee\';\n      }\n      if (boostLabelRef.current) {\n        boostLabelRef.current.textContent = t.boostDepleted\n          ? \'Recharging\'\n          : t.isBoosting\n            ? \'Afterburner Active\'\n            : \'Boost Energy\';\n      }\n\n      // 4. Persistent Virtual Mouse Steering Cursor (stays at any screen edge, zero rollback)\n      //    + 3D Cannon Boresight Reticle + Subtle Deflection Steering Vector\n      const aimPxX = t.aimScreenX * vw;\n      const aimPxY = t.aimScreenY * vh;\n      const borePxX = t.boresightScreenX * vw;\n      const borePxY = t.boresightScreenY * vh;\n      const cx = vw * 0.5;\n      const cy = vh * 0.5;\n\n      if (aimReticleRef.current) {\n        aimReticleRef.current.style.transform = `translate3d(${aimPxX.toFixed(1)}px, ${aimPxY.toFixed(1)}px, 0) translate(-50%, -50%)`;\n      }\n\n      if (boresightRef.current) {\n        const recoilScale = t.isFiring ? 1 + t.weaponCooldownRatio * 0.14 : 1;\n        boresightRef.current.style.transform = `translate3d(${borePxX.toFixed(1)}px, ${borePxY.toFixed(1)}px, 0) translate(-50%, -50%) scale(${recoilScale.toFixed(3)})`;\n      }\n\n      if (aimRingRef.current) {\n        const ringScale = 1 + t.boostIntensity * 0.24 + (t.isFiring ? 0.08 : 0);\n        aimRingRef.current.style.transform = `scale(${ringScale.toFixed(3)})`;\n        aimRingRef.current.style.opacity = String(\n          (0.24 + t.boostIntensity * 0.45 + (t.isFiring ? 0.22 : 0)).toFixed(2),\n        );\n      }\n\n      if (steerLineRef.current) {\n        const dx = aimPxX - cx;\n        const dy = aimPxY - cy;\n        const distPx = Math.hypot(dx, dy);\n        if (distPx > 14) {\n          const ux = dx / distPx;\n          const uy = dy / distPx;\n          steerLineRef.current.setAttribute(\'x1\', (cx + ux * 10).toFixed(1));\n          steerLineRef.current.setAttribute(\'y1\', (cy + uy * 10).toFixed(1));\n          steerLineRef.current.setAttribute(\'x2\', (aimPxX - ux * 18).toFixed(1));\n          steerLineRef.current.setAttribute(\'y2\', (aimPxY - uy * 18).toFixed(1));\n          steerLineRef.current.style.opacity = String(Math.min(0.42, (distPx / 260) * 0.42).toFixed(2));\n        } else {\n          steerLineRef.current.style.opacity = \'0\';\n        }\n      }\n\n      // 5. Hit Confirmation & Kill Confirmation Crosshairs + Damage Vignette\n      if (hitMarkerRef.current) {\n        const hitOp = Math.min(1, t.hitMarkerTimer / 0.14);\n        hitMarkerRef.current.style.opacity = hitOp.toFixed(2);\n      }\n      if (killMarkerRef.current) {\n        const killOp = Math.min(1, t.killMarkerTimer / 0.28);\n        killMarkerRef.current.style.opacity = killOp.toFixed(2);\n      }\n      if (damageVignetteRef.current) {\n        const dmgOp = Math.min(0.72, (t.damageFlashTimer / 0.32) * 0.72);\n        damageVignetteRef.current.style.opacity = dmgOp.toFixed(2);"
    num_lines: 797
