  planner_response {
    thinking: "**Initiating Development Phases**\n\nI\'m now starting development on Batch 2, focusing on the combat engine alongside upgraded flight, input, camera, and audio modules. My initial focus is on the EnemyAIController.ts, where I\'m implementing a full 7-state finite state machine. This will include states for patrol, acquire, pursue, engage, evade, reposition, and retreat.\n\n\n**Refining Combat Implementation**\n\nI\'ve made significant headway with the combat engine. I have added combat features to the EnemyAIController.ts, including targeting, weapon bursts, and evasion. Additionally, I\'ve begun to develop the CombatManager.ts, which will handle weapons, firing, and collision detection. I\'ve also updated game types with combat telemetry and have added input managers to control the new combat features.\n\n\n"
    message_id: "Igj_au6qEqWtz7IP_Oni2Qw"
    tool_calls {
      id: "call_3009089304264593025"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import * as THREE from \'three\';\\nimport { BOT_PERSONALITIES, resolveBotDifficultyTuning } from \'../../config/botPersonalities\';\\nimport { WEAPON_CONFIGS } from \'../../config/weapons\';\\nimport type { EnemyEntity } from \'../../types/combat\';\\nimport type { ProjectilePool } from \'./ProjectilePool\';\\n\\n// Reusable scratch vectors & quaternions (zero GC in frame loop)\\nconst _toPlayer = new THREE.Vector3();\\nconst _desiredPos = new THREE.Vector3();\\nconst _desiredDir = new THREE.Vector3();\\nconst _forward = new THREE.Vector3();\\nconst _right = new THREE.Vector3();\\nconst _up = new THREE.Vector3(0, 1, 0);\\nconst _lookMat = new THREE.Matrix4();\\nconst _targetQuat = new THREE.Quaternion();\\nconst _origin = new THREE.Vector3();\\nconst _muzzleLocal = new THREE.Vector3();\\nconst _leadPoint = new THREE.Vector3();\\nconst _fireDir = new THREE.Vector3();\\nconst _perp = new THREE.Vector3();\\nconst _localDir = new THREE.Vector3();\\nconst _invQuat = new THREE.Quaternion();\\nconst _zeroVec = new THREE.Vector3(0, 0, 0);\\n\\nexport interface EnemyAIUpdateResult {\\n  fired: boolean;\\n  fireOrigin: THREE.Vector3;\\n}\\n\\nconst _resultOrigin = new THREE.Vector3();\\n\\n/**\\n * State-based Enemy Combat Pilot AI.\\n * Drives enemy starfighters through smooth quaternion turning and velocity propulsion\\n * (never snaps or teleports) across 7 tactical states:\\n * patrol -> acquire -> pursue -> engage -> evade -> reposition -> destroyed.\\n */\\nexport class EnemyAIController {\\n  public triggerDamageReaction(\\n    enemy: EnemyEntity,\\n    playerPos: THREE.Vector3,\\n    now: number,\\n  ): void {\\n    if (!enemy.active || enemy.health.isDestroyed) return;\\n    enemy.hitFlashTimer = 0.14;\\n\\n    const personality = BOT_PERSONALITIES[enemy.personality];\\n    const tuning = resolveBotDifficultyTuning(personality, enemy.difficulty);\\n\\n    // Already evading or repositioning \342\200\224 only flip flank sign occasionally\\n    if (enemy.aiState === \'evade\') return;\\n\\n    // Deterministic-feeling probabilistic jink based on personality responsiveness\\n    const roll = Math.abs(Math.sin(now * 37.3 + enemy.position.x * 0.13));\\n    if (roll <= tuning.evadeResponsiveness) {\\n      enemy.aiState = \'evade\';\\n      enemy.aiStateTimer = personality.evadeDuration;\\n      enemy.flankSign = enemy.flankSign === 1 ? -1 : 1;\\n\\n      // Compute perpendicular jink vector away from player\'s line of fire\\n      _toPlayer.subVectors(playerPos, enemy.position).normalize();\\n      _perp.crossVectors(_toPlayer, _up);\\n      if (_perp.lengthSq() < 0.01) {\\n        _perp.set(1, 0, 0);\\n      } else {\\n        _perp.normalize();\\n      }\\n      const verticalLift = (roll - 0.35) * 0.75;\\n      enemy.evadeDir\\n        .copy(_perp)\\n        .multiplyScalar(enemy.flankSign)\\n        .addScaledVector(_up, verticalLift)\\n        .addScaledVector(_toPlayer, -0.35)\\n        .normalize();\\n    } else if (enemy.aiState === \'patrol\') {\\n      // Immediately alert if attacked while patrolling\\n      enemy.aiState = \'acquire\';\\n      enemy.aiStateTimer = tuning.reactionTime;\\n    }\\n  }\\n\\n  public updateEnemy(\\n    enemy: EnemyEntity,\\n    dt: number,\\n    now: number,\\n    playerPos: THREE.Vector3,\\n    playerVel: THREE.Vector3,\\n    playerAlive: boolean,\\n    projectiles: ProjectilePool,\\n    allEnemies: EnemyEntity[],\\n  ): EnemyAIUpdateResult {\\n    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);\\n    const out: EnemyAIUpdateResult = { fired: false, fireOrigin: _resultOrigin };\\n\\n    if (!enemy.active || enemy.health.isDestroyed) {\\n      enemy.aiState = \'destroyed\';\\n      return out;\\n    }\\n\\n    if (enemy.hitFlashTimer > 0) {\\n      enemy.hitFlashTimer = Math.max(0, enemy.hitFlashTimer - safeDt);\\n    }\\n    if (enemy.muzzleFlashTimer > 0) {\\n      enemy.muzzleFlashTimer = Math.max(0, enemy.muzzleFlashTimer - safeDt);\\n    }\\n    if (enemy.weaponCooldown > 0) {\\n      enemy.weaponCooldown = Math.max(0, enemy.weaponCooldown - safeDt);\\n    }\\n\\n    const personality = BOT_PERSONALITIES[enemy.personality];\\n    const tuning = resolveBotDifficultyTuning(personality, enemy.difficulty);\\n    const weapon = WEAPON_CONFIGS[personality.weaponId] ?? WEAPON_CONFIGS.enemy_pulse_aggressor;\\n\\n    _toPlayer.subVectors(playerPos, enemy.position);\\n    const distToPlayer = _toPlayer.length();\\n    const dirToPlayer = distToPlayer > 0.001 ? _toPlayer.divideScalar(distToPlayer) : _forward.set(0, 0, -1);\\n\\n    enemy.aiStateTimer = Math.max(0, enemy.aiStateTimer - safeDt);\\n\\n    // 1. State Machine Transitions\\n    if (!playerAlive) {\\n      enemy.aiState = \'patrol\';\\n    } else {\\n      switch (enemy.aiState) {\\n        case \'patrol\': {\\n          if (distToPlayer <= personality.detectionRange) {\\n            enemy.aiState = \'acquire\';\\n            enemy.aiStateTimer = tuning.reactionTime;\\n          }\\n          break;\\n        }\\n        case \'acquire\': {\\n          if (enemy.aiStateTimer <= 0) {\\n            enemy.aiState = distToPlayer <= personality.engageRange ? \'engage\' : \'pursue\';\\n            enemy.aiStateTimer = 2.4;\\n          }\\n          break;\\n        }\\n        case \'pursue\': {\\n          if (distToPlayer <= personality.minSafeDistance) {\\n            this.beginReposition(enemy, playerPos, personality.preferredRange);\\n          } else if (distToPlayer <= personality.engageRange) {\\n            enemy.aiState = \'engage\';\\n            enemy.aiStateTimer = 3.2;\\n          }\\n          break;\\n        }\\n        case \'engage\': {\\n          if (distToPlayer <= personality.minSafeDistance) {\\n            this.beginReposition(enemy, playerPos, personality.preferredRange);\\n          } else if (distToPlayer > personality.engageRange * 1.25) {\\n            enemy.aiState = \'pursue\';\\n            enemy.aiStateTimer = 2.5;\\n          } else if (enemy.aiStateTimer <= 0 && personality.flankAngleRad > 0.45) {\\n            // Flankers/Defenders/Aces periodically switch attack side to avoid predictable tail-chasing\\n            enemy.flankSign = enemy.flankSign === 1 ? -1 : 1;\\n            enemy.aiStateTimer = 3.6;\\n          }\\n          break;\\n        }\\n        case \'evade\': {\\n          if (enemy.aiStateTimer <= 0) {\\n            enemy.aiState = distToPlayer < personality.minSafeDistance * 1.2 ? \'reposition\' : \'pursue\';\\n            enemy.aiStateTimer = 2.0;\\n          }\\n          break;\\n        }\\n        case \'reposition\': {\\n          const distToAnchor = enemy.position.distanceTo(enemy.repositionPoint);\\n          if (enemy.aiStateTimer <= 0 || (distToPlayer > personality.preferredRange * 0.95 && distToAnchor < 38)) {\\n            enemy.aiState = \'pursue\';\\n            enemy.aiStateTimer = 2.4;\\n          }\\n          break;\\n        }\\n        case \'destroyed\':\\n          return out;\\n      }\\n    }\\n\\n    // 2. Compute Desired Flight Vector & Speed Based on Current AI State + Personality\\n    let targetSpeed = tuning.cruiseSpeed;\\n\\n    if (enemy.aiState === \'patrol\') {\\n      enemy.patrolAngle += safeDt * 0.28;\\n      _desiredPos.set(\\n        enemy.patrolAnchor.x + Math.cos(enemy.patrolAngle) * 110,\\n        enemy.patrolAnchor.y + Math.sin(enemy.patrolAngle * 1.3) * 24,\\n        enemy.patrolAnchor.z + Math.sin(enemy.patrolAngle) * 110,\\n      );\\n      _desiredDir.subVectors(_desiredPos, enemy.position).normalize();\\n      targetSpeed = tuning.cruiseSpeed * 0.72;\\n    } else if (enemy.aiState === \'acquire\') {\\n      _desiredDir.copy(dirToPlayer);\\n      targetSpeed = tuning.cruiseSpeed * 0.85;\\n    } else if (enemy.aiState === \'pursue\') {\\n      // Apply personality flank offset (Aggressor flies nearly direct; Flanker curves wide)\\n      _perp.crossVectors(dirToPlayer, _up);\\n      if (_perp.lengthSq() < 0.01) _perp.set(1, 0, 0);\\n      else _perp.normalize();\\n\\n      const flankScale = Math.sin(personality.flankAngleRad) * enemy.flankSign * THREE.MathUtils.clamp((distToPlayer - 80) / 160, 0.25, 1.0);\\n      const bobY = Math.sin(now * 0.9 + enemy.patrolAngle) * 0.16;\\n\\n      _desiredDir\\n        .copy(dirToPlayer)\\n        .addScaledVector(_perp, flankScale)\\n        .addScaledVector(_up, bobY)\\n        .normalize();\\n      targetSpeed = distToPlayer > personality.engageRange * 1.15 ? tuning.boostSpeed : tuning.cruiseSpeed;\\n    } else if (enemy.aiState === \'engage\') {\\n      // Lead target slightly while orbiting/closing according to personality\\n      const timeToHit = THREE.MathUtils.clamp(distToPlayer / Math.max(weapon.projectileSpeed, 1), 0, 1.4);\\n      _leadPoint.copy(playerPos).addScaledVector(playerVel, timeToHit * 0.72);\\n      _desiredDir.subVectors(_leadPoint, enemy.position).normalize();\\n\\n      if (personality.id === \'defender\' && distToPlayer < personality.preferredRange) {\\n        // Defender strafes laterally to hold standoff distance\\n        _perp.crossVectors(dirToPlayer, _up).normalize();\\n        _desiredDir.addScaledVector(_perp, enemy.flankSign * 0.65).normalize();\\n      } else if (personality.id === \'flanker\') {\\n        _perp.crossVectors(dirToPlayer, _up).normalize();\\n        _desiredDir.addScaledVector(_perp, enemy.flankSign * 0.35).normalize();\\n      }\\n\\n      targetSpeed =\\n        distToPlayer > personality.preferredRange\\n          ? tuning.cruiseSpeed * 1.05\\n          : tuning.cruiseSpeed * 0.82;\\n    } else if (enemy.aiState === \'evade\') {\\n      _desiredDir.copy(enemy.evadeDir);\\n      targetSpeed = tuning.boostSpeed;\\n    } else if (enemy.aiState === \'reposition\') {\\n      _desiredDir.subVectors(enemy.repositionPoint, enemy.position).normalize();\\n      targetSpeed = tuning.boostSpeed * 0.96;\\n    }\\n\\n    // 3. Soft wingman separation so enemy bots don\'t stack on top of each other\\n    for (let i = 0; i < allEnemies.length; i++) {\\n      const other = allEnemies[i];\\n      if (!other.active || other.id === enemy.id || other.health.isDestroyed) continue;\\n      const dx = enemy.position.x - other.position.x;\\n      const dy = enemy.position.y - other.position.y;\\n      const dz = enemy.position.z - other.position.z;\\n      const distSq = dx * dx + dy * dy + dz * dz;\\n      if (distSq > 0.01 && distSq < 900) {\\n        const invDist = 1 / Math.sqrt(distSq);\\n        const push = (30 - 1 / invDist) / 30;\\n        _desiredDir.x += dx * invDist * push * 0.75;\\n        _desiredDir.y += dy * invDist * push * 0.75;\\n        _desiredDir.z += dz * invDist * push * 0.75;\\n      }\\n    }\\n    if (_desiredDir.lengthSq() > 0.0001) {\\n      _desiredDir.normalize();\\n    }\\n\\n    // 4. Smooth Quaternion Turn Physics (strictly angular-rate-limited, never snaps!)\\n    _lookMat.lookAt(_zeroVec, _desiredDir, _up);\\n    _targetQuat.setFromRotationMatrix(_lookMat);\\n\\n    const maxStepAngle = tuning.turnRate * safeDt;\\n    const angleDiff = enemy.quaternion.angleTo(_targetQuat);\\n    if (angleDiff > 0.0001) {\\n      const t = Math.min(1, maxStepAngle / angleDiff);\\n      enemy.quaternion.slerp(_targetQuat, t);\\n      enemy.quaternion.normalize();\\n    }\\n\\n    // Compute natural visual bank angle based on local lateral turn direction\\n    _invQuat.copy(enemy.quaternion).invert();\\n    _localDir.copy(_desiredDir).applyQuaternion(_invQuat);\\n    const desiredBank = THREE.MathUtils.clamp(-_localDir.x * 1.1, -0.65, 0.65);\\n    enemy.visualBankAngle = THREE.MathUtils.damp(enemy.visualBankAngle, desiredBank, 5.5, safeDt);\\n\\n    // 5. Momentum-based forward propulsion along ship facing (-Z)\\n    _forward.set(0, 0, -1).applyQuaternion(enemy.quaternion).normalize();\\n    const desiredVelX = _forward.x * targetSpeed;\\n    const desiredVelY = _forward.y * targetSpeed;\\n    const desiredVelZ = _forward.z * targetSpeed;\\n    const velAlpha = 1 - Math.exp(-3.4 * safeDt);\\n    enemy.velocity.x = THREE.MathUtils.lerp(enemy.velocity.x, desiredVelX, velAlpha);\\n    enemy.velocity.y = THREE.MathUtils.lerp(enemy.velocity.y, desiredVelY, velAlpha);\\n    enemy.velocity.z = THREE.MathUtils.lerp(enemy.velocity.z, desiredVelZ, velAlpha);\\n\\n    enemy.position.addScaledVector(enemy.velocity, safeDt);\\n\\n    // 6. Tactical Burst Weapon Firing (only when aligned & inside engage envelope)\\n    if (\\n      playerAlive &&\\n      (enemy.aiState === \'engage\' || (enemy.aiState === \'pursue\' && distToPlayer < personality.engageRange * 1.05))\\n    ) {\\n      const timeToTarget = THREE.MathUtils.clamp(distToPlayer / Math.max(weapon.projectileSpeed, 1), 0, 1.3);\\n      _leadPoint.copy(playerPos).addScaledVector(playerVel, timeToTarget * 0.78);\\n      _fireDir.subVectors(_leadPoint, enemy.position).normalize();\\n\\n      const alignment = _forward.dot(_fireDir);\\n      const fireConeCos = Math.cos(THREE.MathUtils.degToRad(18));\\n\\n      // Manage burst cadence (short readable bursts with brief pauses so combat feels cinematic)\\n      enemy.burstTimer -= safeDt;\\n      if (enemy.burstTimer <= 0) {\\n        enemy.burstActive = !enemy.burstActive;\\n        enemy.burstTimer = enemy.burstActive ? 1.15 + (enemy.difficulty * 0.15) : 1.05;\\n      }\\n\\n      if (enemy.burstActive && alignment >= fireConeCos && enemy.weaponCooldown <= 0) {\\n        // Apply personality + difficulty angular dispersion\\n        const spread = tuning.aimSpreadRad + weapon.spreadRad;\\n        _right.set(1, 0, 0).applyQuaternion(enemy.quaternion);\\n        const jitterX = (Math.random() - 0.5) * 2 * spread;\\n        const jitterY = (Math.random() - 0.5) * 2 * spread;\\n        _fireDir\\n          .addScaledVector(_right, jitterX)\\n          .addScaledVector(_up, jitterY)\\n          .normalize();\\n\\n        const muzzle = weapon.muzzleOffsets[enemy.muzzleIndex % weapon.muzzleOffsets.length];\\n        enemy.muzzleIndex = (enemy.muzzleIndex + 1) % weapon.muzzleOffsets.length;\\n        _muzzleLocal.set(muzzle[0], muzzle[1], muzzle[2]).applyQuaternion(enemy.quaternion);\\n        _origin.copy(enemy.position).add(_muzzleLocal);\\n\\n        projectiles.spawn(enemy.id, \'enemy\', weapon, _origin, _fireDir, enemy.velocity);\\n        enemy.weaponCooldown = 1 / Math.max(0.5, weapon.fireRate * tuning.fireCadenceScale);\\n        enemy.muzzleFlashTimer = 0.06;\\n\\n        out.fired = true;\\n        out.fireOrigin.copy(_origin);\\n      }\\n    }\\n\\n    return out;\\n  }\\n\\n  private beginReposition(\\n    enemy: EnemyEntity,\\n    playerPos: THREE.Vector3,\\n    preferredRange: number,\\n  ): void {\\n    enemy.aiState = \'reposition\';\\n    enemy.aiStateTimer = 2.6;\\n    enemy.flankSign = enemy.flankSign === 1 ? -1 : 1;\\n\\n    _toPlayer.subVectors(enemy.position, playerPos);\\n    if (_toPlayer.lengthSq() < 0.01) {\\n      _toPlayer.set(0, 0, 1);\\n    } else {\\n      _toPlayer.normalize();\\n    }\\n\\n    _perp.crossVectors(_toPlayer, _up);\\n    if (_perp.lengthSq() < 0.01) _perp.set(1, 0, 0);\\n    else _perp.normalize();\\n\\n    enemy.repositionPoint\\n      .copy(playerPos)\\n      .addScaledVector(_toPlayer, preferredRange * 1.15)\\n      .addScaledVector(_perp, enemy.flankSign * preferredRange * 0.65)\\n      .addScaledVector(_up, (enemy.flankSign * 26));\\n  }\\n}\\n\", \"Description\":\"Implement 7-state EnemyAIController supporting Aggressor, Flanker, Defender, and Ace personalities with smooth quaternion flight and burst firing\", \"Overwrite\":true, \"TargetFile\":\"/src/engine/combat/EnemyAIController.ts\", \"toolAction\":\"Creating EnemyAIController\", \"toolSummary\":\"Create src/engine/combat/EnemyAIController.ts\"}"
      thinking_signature: "\022\362\023\n\357\023\001i\024}\023\377\206\355\374\276\026\000+\321Q\'\347\\\336\211R\243lW\335\341d\006\v4\017\262x\204\2217\364]\3206\326\247\307\032}\335\342\205|X\tl\312\311\300q\251\210<\305\271\262y\027v\366\277*\033J\366\002\364pY\234yH#\026\374\311~d\023z\207&\251V\343\220K\317\237\226\241\314=\264\016A[@n~C]\021\001\320,@4\377\032\332wE\212Oy\177\356$\255:\272`\237Dk\220\312\253H\256K\353\302\004\212\353\"[\3024\312\262\273\207*\232\321\327d\316\366 \272\342\020\230wu\377\311(U\357\001Q\003?z{^S\272?K\202aQ\366\26455\024w\356\377e!\332\001\r)XNJkqu\v\230/\251\205\324\371\"\201\3123\233\235b\2752\310#\222\316-\372u\246C([0\022\221\026DK\'\\\213lu\325\274|\237Q\276yl.>\307\324!5C\331\353\377\315\323W\371\3132\340\344\256_\f!5;H\016V\004\212\016\225E\364\263\252Tb~\331\260S\217\300\336*\373\254q?\302Q\230\351\\\374\324fF\360\232A\261;\265o\364\350Bu\3421u\321\334K\321\003\t8\212Z\v\3271\275#\346\367/\257\2476\215\331\303uFUZ\265\362\373\361\234\355\3301\'x\364\304q`\367w\372{\203\301\303\314\003\262\241N\027W\233\351\220\t`\204\330\3755!\305qhdg\364W|_#\001\347/\n\347X\324xD\304\306OOV1\250R\373\274s\031+/y3\031\017N\342\2569\033\b\201@t\021\370\301\243I\1774\215qE\265Kn\v\005\004\257\363\305#\211\031\370\275r\305A\332\364M\230\tG2S\372T\272a\322z\250\313\030\323n?\240\221N\342\342\005\312\213\367\214U\275\372#\321hn\223\276\027\035\bV\275i\nL\242\255\226\264\202s\202@\337u\303>\216)\201\213+X\234\000\017\365\202]\005\201\351X\036~\270\273&RB\372\2560>\366\255\b\024\307\205\032\016pI\274+\340\215\217^\251\baD\262O\2753\272~\352\352\332L\375\303\273\322=\335JQ\v\322\273\221\3631\314\370\' \206=\344}]\320J\204&\027\002\0165\t\032\214\204\325_qZqn\320i\232H\027\316\217L\323\036\375\023\024\203\264n\241\337\246m<\277S$\267\377Mc\220\021\247\203\325q\021\236\316\213\377\v\375_\275N>\006\265\323\264W\375\213)m\316\201\334\312=r\333 f\230\211Gt4@\020 \017r\353\241\311\\\030\257\f\312a\306\230\320\355\365\204I#\217P\333\250)h\333\037\210cGZ\216\315\307o\024\203\340N\203?\364A\364\331<;2\344\376tW\330P5\264\204\344\346G\346\\\026\ni\305\220\200\333\310;H\v\277\234\211E\3401\301\232#N8\024\230KKp\261[\203Z+\257\361\200\213N\325\004\003\363\033\276\036L\277\005\302X\244\346\302\2000\2469VV4q\305\272\276`\261S&\251\311f\355\265\207;\323p\212\\\261\002Q\036\026P\341\345\254P\374\352\317-\317\017e\273L\332Bx\315Y\211\021OnN\177\273:Bc~\001P\016\244\003o\024<4Z\367OP\022\246\r\a1L\270\000[kU\336S\330\265Es\016\f/=1z5\316\272\350\376\355a#(\357\025\244C\024\r\251\\A\374\240\207k\017\324\217\205\230\016)\255O\306\237M\320\v?\025n\027\370\005%\t\023\303\177\276l\024!\231\242f\214m\223\216I%\250lh\262\316\307\331\315\a\0266\365\367\234O\322\221p]\333\263\261\370\344K\375dt\356\300\205\206\f\243$\367\257\251\273\031s \313\361\3307\023\203;\322\342\177&\220\206\022X\023<\344\276\324\212\036\3752\251\313\220*@l\206&\313\201<\326\255 1<\v\024i5\203\307Z[\311>l\345\023q\226\224\\\234\313\277p3H/\357\b\331\206\000\321\020I\3739;ynt3\266Q&$*\271\267\272\241\320\367e\265\371V\311\334\3627\263\006S\205_&\213\342\243\317\2641\241\323Pv\216\354W@\357\203[\215\314C\214\017Ys\251J\337\313#P\0242\357\252\274% \343c\227\216\033 \336\313\353\351\316\226G\270L*\235&-:\016\017\313\224\254\005Y\312\247\313\347\230\335\246\313\035\"\222\315\274\267\361\365\347$\254\245\365\023G\355\205\241\347cg\230\372M\342\333\t<+\267\177Q\275z\337\\\345\223w\362\204\263\0330^\326\336\360S\357\271\240DR)\232%\345\364\201\247c\352c\356\374\350\354\001\322\005\034^b\332\331@\303\302<\270k\347y\211m\3447\326\302\000L`\241\375\274\270\274 \320sF\201h\210Ky\307ksW\230\001\242G\326\305\a\310$\020\331V\333M5\252[\032l\213\320\250\326\216t\345\276\232~\022UI\3664VQ\226~\244\2110I\325O\353\216iI\231\313y>9\363\310\031{w\350\224qD\270-\243J\232\022@\302\027\254\320\273\005\312&\022\210\003y\302\225\026D\fOc\310\267\310\345b\203\301\221W\261\\lT\207\333\221\275i\335\265\357fh\373-\277\355t\354J\001\212\276\341\352\033pU\242\030\337\351\247o\021\310 A\222\233\334)\337\342\247\327\342\377\232\357N\235J\375,\367\344\324\003*\334\205\236\000}\344\220\2254\0026\2121\205f\357\f#\2001\375\3341[#4\364|\333\347\324\360\v/\030\307\204V\301Y\201\271]\350\252a\236l3\332XxkQu\223%3\302Jp\r\350\025\366G\252\363\025R\233?<K~\353\247S\240-[\r\027m\226`\274\004\336\217\305\024f\210l\017E$\001\270\313N\037\361(\002\342H\225\264XjK\a\240\367\267G8\215w\344\354i}\301\254\360?\177Z\323Y\246vQ\227\177\200\2500\325\021\017\266\321\203\034\331\213\t\333\313g#\240g\220\327\355f\222i(\311\312i\334c\217+W\v\253c.`~\247\245\377\264\327>2\236\236\376D\316\032_LXN\345\344\245~!\250\247\324\t\364\275|\271\364\231V\300\371^k~\210z\362#\021.\315\234\025\342\274\273>\016G=\276{\312\306m\327\367,y\345\026\223\206\215\2516%\325\r9MB5\265g\025rK\325\343\226h\324\341R\233\244`DG\272Xo\216\335[\306\317\272P\333\024\235\274\203M\215\256\245\247x\352J<\231V \255\316\2765\277\246,s\366Q?\036\035:\313\3774w\022\366\232\"\244C\331@\365{\340\030\241\352Vj\360J\240C\022|\260 \276\351\303\310,\325:\273\240\370!FM\0014q\231&-\335\315{F{\247\235\027\252\241\337\034\321m\277K\032P\376\305\277\300{\327\311\244\333b>Vm\257\253\323\235\355\372\022`\210\366\320\256t\344y\352>\321\"6\321\250\034\305\352\202\256\v\005\345Fp\224\"3\341\360P,\354\n\"P\264z\302\alw\227\376\351c\035xOL\177\300\220\365\3173?\271]b\030\300v\335\034\017\3123\336)\224\321\347x\340\3344%\251\334O\260eQc\366L\200\022@N\220\266V\b\343}\327ye\262\332z\350\322Ydt\254$\023\305\315\255\366.\304\'\350\277\233%Z\016\322\335oV\270\266!q \217?\300\306\242\265\202@9\212\213j\312\022\274\303K[\213\310\2425\334,\246\316ypD\204\236\377?\025\267\311\331\350\f\006\237j\227z\027A\030\003A\301\352\253\025f}\t\356\245\265\330;\264X\364\016+\022X\225\nQ\203\357\276<@4\325\202\236\213\020{\201\334\231\274\263\274`\243#\356el\366\0037\251\223\266G\222\367\344\3144\024d-|\325\222;z\274;f\273e\032\355\003\203\n\246\244\003\272\261\243\a\307\366\234\325\260\327\324\030\241\344\331\232\022\3219\360+jR\262\343\210\366\0320\374\344\325\217\242\350\247e!\353\376\221\332\006\352\234F*\276\267z4]\373\343\375\313\273g\214\303vqk\311\373\220\353\320O\260\'\260\276\345q\037\f\263\243\004\244\357\375d\340T\373\001}}\210f\367\352\274\3347\313gq3\\\r\371\252\"K\354#\330\306\343\257\034\034o\255#v-\266\263\204\314\272\3348\354\034\036\225\223\213\225\220K\314\v\006\325^\032\376\345\206\257\314\227\317;\201S\246\340r\232u\350e\024\342v\025.\032*\231>\327\205`\237\356\316\215s\222\003\332;~\270J\327\017\303\334\363\324\257\265\251Q\365\360+)M2\212\a\363 \356lP\016B\210\343 \343\340\301k8-\306-\302\035\a\315\370J`T]\246\352u\036Yel\203\307~\324V\2346\250\344\327S\005\222j\301\350-&\371\277:@\336\235\034\363\034Ue\247\310-\233\000\267\t\231\035\270\264\327HO\345\367\003\363R\370\024\212\343\fo`\253\017DkC\226\206\325\377C\005$VF\246\334re0\324a\251@\375<\'`\262\361\241r\2001\234\305\262\004l\301\306X\b+\302\034\2761\374E\025\233\313\t&\\\212\026\253\217\226\204\026\017\207\2555)blU\320\212&$:gmX6f\263\211`#\317.\303`\275\221F\303_\311K\343\215\033\025\3631\177r \340\337\322\254\363\024J2\2159\233\020\360\351Y\003\240)\206\367\350\233\223z\204V+\024\n\250Fc\003O\026\325\203U\376\260\241\'\377)"
