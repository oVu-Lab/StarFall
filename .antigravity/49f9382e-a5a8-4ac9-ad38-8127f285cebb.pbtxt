    tool_calls {
      id: "call_13163534334258667066"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useEffect, useMemo, useRef } from \'react\';\\nimport { useFrame, useThree } from \'@react-three/fiber\';\\nimport * as THREE from \'three\';\\nimport { RoomEnvironment } from \'three/examples/jsm/environments/RoomEnvironment.js\';\\nimport type { GraphicsPreset } from \'../config/graphics\';\\nimport { AssetManager } from \'../engine/AssetManager\';\\nimport type { MissionEnvironmentTheme } from \'../types/mission\';\\n\\nconst NEBULA_VERTEX = /* glsl */ `\\n  varying vec3 vDir;\\n  void main() {\\n    vDir = normalize(position);\\n    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);\\n  }\\n`;\\n\\nconst NEBULA_FRAGMENT = /* glsl */ `\\n  varying vec3 vDir;\\n  uniform float uTime;\\n  uniform int uOctaves;\\n  uniform vec3 uVoidCol;\\n  uniform vec3 uMidCol;\\n  uniform vec3 uIonCol;\\n\\n  float hash(vec3 p) {\\n    p = fract(p * 0.3183099 + 0.1);\\n    p *= 17.0;\\n    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));\\n  }\\n\\n  float noise(vec3 x) {\\n    vec3 i = floor(x);\\n    vec3 f = fract(x);\\n    f = f * f * (3.0 - 2.0 * f);\\n\\n    return mix(\\n      mix(\\n        mix(hash(i + vec3(0,0,0)), hash(i + vec3(1,0,0)), f.x),\\n        mix(hash(i + vec3(0,1,0)), hash(i + vec3(1,1,0)), f.x),\\n        f.y\\n      ),\\n      mix(\\n        mix(hash(i + vec3(0,0,1)), hash(i + vec3(1,0,1)), f.x),\\n        mix(hash(i + vec3(0,1,1)), hash(i + vec3(1,1,1)), f.x),\\n        f.y\\n      ),\\n      f.z\\n    );\\n  }\\n\\n  float fbm(vec3 p) {\\n    float v = 0.0;\\n    float a = 0.52;\\n    for (int i = 0; i < 5; i++) {\\n      if (i >= uOctaves) break;\\n      v += a * noise(p);\\n      p = p * 2.04 + vec3(13.1, 7.7, 5.3);\\n      a *= 0.5;\\n    }\\n    return v;\\n  }\\n\\n  void main() {\\n    vec3 d = normalize(vDir);\\n\\n    // Galactic plane tilted softly across the sky\\n    float plane = exp(-abs(d.y * 2.4 + d.x * 0.65) * 2.2);\\n\\n    float n1 = fbm(d * 2.6 + vec3(0.0, uTime * 0.004, 0.0));\\n    float n2 = fbm(d * 5.2 - vec3(uTime * 0.003, 1.2, 2.5));\\n    float filament = smoothstep(0.42, 0.86, n1 * 0.72 + n2 * 0.38);\\n\\n    vec3 indigoDust = uMidCol * vec3(1.4, 0.85, 1.15);\\n\\n    vec3 col = uVoidCol;\\n    col = mix(col, uMidCol, smoothstep(0.28, 0.75, n1) * (0.45 + 0.55 * plane));\\n    col += indigoDust * smoothstep(0.5, 0.9, n2) * 0.36 * plane;\\n    col += uIonCol * filament * plane * 0.44;\\n\\n    // Distant blue-white sun corona glow on upper-right horizon\\n    vec3 sunDir = normalize(vec3(0.58, 0.32, -0.74));\\n    float sunDot = max(dot(d, sunDir), 0.0);\\n    col += vec3(0.42, 0.78, 1.0) * pow(sunDot, 16.0) * 0.36;\\n    col += vec3(0.95, 0.98, 1.0) * pow(sunDot, 220.0) * 1.1;\\n\\n    gl_FragColor = vec4(col, 1.0);\\n  }\\n`;\\n\\nconst ATMOSPHERE_VERTEX = /* glsl */ `\\n  varying vec3 vNormalWorld;\\n  varying vec3 vViewDir;\\n\\n  void main() {\\n    vec4 worldPos = modelMatrix * vec4(position, 1.0);\\n    vNormalWorld = normalize(mat3(modelMatrix) * normal);\\n    vViewDir = normalize(cameraPosition - worldPos.xyz);\\n    gl_Position = projectionMatrix * viewMatrix * worldPos;\\n  }\\n`;\\n\\nconst ATMOSPHERE_FRAGMENT = /* glsl */ `\\n  varying vec3 vNormalWorld;\\n  varying vec3 vViewDir;\\n  uniform vec3 uColor;\\n\\n  void main() {\\n    float rim = 1.0 - max(dot(vNormalWorld, vViewDir), 0.0);\\n    float glow = pow(rim, 3.2);\\n    gl_FragColor = vec4(uColor * 1.35, glow * 0.78);\\n  }\\n`;\\n\\nconst RING_VERTEX = /* glsl */ `\\n  varying vec2 vUv;\\n  void main() {\\n    vUv = uv;\\n    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);\\n  }\\n`;\\n\\nconst RING_FRAGMENT = /* glsl */ `\\n  varying vec2 vUv;\\n  uniform vec3 uInnerCol;\\n  uniform vec3 uOuterCol;\\n\\n  void main() {\\n    vec2 centered = vUv * 2.0 - 1.0;\\n    float r = length(centered);\\n    if (r < 0.46 || r > 0.98) discard;\\n\\n    float t = (r - 0.46) / 0.52;\\n    float bands = 0.55 + 0.45 * sin(t * 58.0) * cos(t * 21.0 + 0.6);\\n    float cassiniGap = 1.0 - smoothstep(0.61, 0.64, t) * (1.0 - smoothstep(0.68, 0.71, t));\\n    float edgeFade = smoothstep(0.0, 0.09, t) * (1.0 - smoothstep(0.88, 1.0, t));\\n\\n    vec3 col = mix(uInnerCol, uOuterCol, t);\\n    float alpha = bands * cassiniGap * edgeFade * 0.58;\\n    gl_FragColor = vec4(col, alpha);\\n  }\\n`;\\n\\nconst STAR_VERTEX = /* glsl */ `\\n  attribute float aSize;\\n  attribute float aPhase;\\n  varying vec3 vColor;\\n  varying float vTwinkle;\\n  uniform float uTime;\\n\\n  void main() {\\n    vColor = color;\\n    vTwinkle = 0.74 + 0.26 * sin(uTime * 1.8 + aPhase);\\n    vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);\\n    gl_PointSize = clamp(aSize * (340.0 / max(-mvPosition.z, 1.0)), 1.2, 6.5);\\n    gl_Position = projectionMatrix * mvPosition;\\n  }\\n`;\\n\\nconst STAR_FRAGMENT = /* glsl */ `\\n  varying vec3 vColor;\\n  varying float vTwinkle;\\n\\n  void main() {\\n    vec2 c = gl_PointCoord - 0.5;\\n    float d = length(c) * 2.0;\\n    if (d > 1.0) discard;\\n    float core = pow(1.0 - d, 2.2);\\n    gl_FragColor = vec4(vColor * (1.15 * vTwinkle), core);\\n  }\\n`;\\n\\ninterface SpaceEnvironmentProps {\\n  graphics: GraphicsPreset;\\n  theme: MissionEnvironmentTheme;\\n}\\n\\nconst _dummy = new THREE.Object3D();\\n\\nexport function SpaceEnvironment({ graphics, theme }: SpaceEnvironmentProps) {\\n  const { gl, scene, camera } = useThree();\\n  const skyboxRef = useRef<THREE.Mesh>(null);\\n  const starGroupRef = useRef<THREE.Points>(null);\\n  const gasGiantRef = useRef<THREE.Group>(null);\\n  const moonRef = useRef<THREE.Mesh>(null);\\n  const asteroidsRef = useRef<THREE.InstancedMesh>(null);\\n\\n  // Configure procedural studio RoomEnvironment IBL so metallic PBR ships catch realistic reflections\\n  useEffect(() => {\\n    AssetManager.configureRenderer(gl);\\n    const pmrem = new THREE.PMREMGenerator(gl);\\n    const envTarget = pmrem.fromScene(new RoomEnvironment(), 0.04);\\n    scene.environment = envTarget.texture;\\n    scene.background = new THREE.Color(\'#030712\');\\n\\n    return () => {\\n      scene.environment = null;\\n      envTarget.dispose();\\n      pmrem.dispose();\\n    };\\n  }, [gl, scene]);\\n\\n  // Sync mission-specific atmospheric fog color\\n  useEffect(() => {\\n    scene.fog = new THREE.FogExp2(theme.fogColor, 0.00028);\\n  }, [scene, theme.fogColor]);\\n\\n  // Stage C/D/E reference-counted mission environment textures\\n  const envTex = useMemo(\\n    () => AssetManager.acquireEnvironmentTextures(theme, graphics.textureResolution),\\n    [theme, graphics.textureResolution],\\n  );\\n\\n  useEffect(() => {\\n    return () => {\\n      AssetManager.releaseEnvironmentTextures(envTex.key);\\n    };\\n  }, [envTex.key]);\\n\\n  // Nebula skybox shader material with adaptive FBM octaves & mission palette\\n  const nebulaMat = useMemo(\\n    () =>\\n      new THREE.ShaderMaterial({\\n        uniforms: {\\n          uTime: { value: 0 },\\n          uOctaves: { value: graphics.nebulaOctaves },\\n          uVoidCol: { value: new THREE.Vector3(...theme.nebulaVoid) },\\n          uMidCol: { value: new THREE.Vector3(...theme.nebulaMid) },\\n          uIonCol: { value: new THREE.Vector3(...theme.nebulaIon) },\\n        },\\n        vertexShader: NEBULA_VERTEX,\\n        fragmentShader: NEBULA_FRAGMENT,\\n        side: THREE.BackSide,\\n        depthWrite: false,\\n      }),\\n    // eslint-disable-next-line react-hooks/exhaustive-deps\\n    [],\\n  );\\n\\n  useEffect(() => {\\n    nebulaMat.uniforms.uOctaves.value = graphics.nebulaOctaves;\\n    nebulaMat.uniforms.uVoidCol.value.set(...theme.nebulaVoid);\\n    nebulaMat.uniforms.uMidCol.value.set(...theme.nebulaMid);\\n    nebulaMat.uniforms.uIonCol.value.set(...theme.nebulaIon);\\n  }, [nebulaMat, graphics.nebulaOctaves, theme]);\\n\\n  // Planet atmosphere & ring shaders\\n  const atmosphereMat = useMemo(\\n    () =>\\n      new THREE.ShaderMaterial({\\n        uniforms: { uColor: { value: new THREE.Color(theme.atmosphereColor) } },\\n        vertexShader: ATMOSPHERE_VERTEX,\\n        fragmentShader: ATMOSPHERE_FRAGMENT,\\n        transparent: true,\\n        depthWrite: false,\\n        blending: THREE.AdditiveBlending,\\n        side: THREE.FrontSide,\\n      }),\\n    // eslint-disable-next-line react-hooks/exhaustive-deps\\n    [],\\n  );\\n\\n  useEffect(() => {\\n    atmosphereMat.uniforms.uColor.value.set(theme.atmosphereColor);\\n  }, [atmosphereMat, theme.atmosphereColor]);\\n\\n  const ringMat = useMemo(\\n    () =>\\n      new THREE.ShaderMaterial({\\n        uniforms: {\\n          uInnerCol: { value: new THREE.Color(theme.atmosphereColor).lerp(new THREE.Color(\'#94a3b8\'), 0.4) },\\n          uOuterCol: { value: new THREE.Color(theme.planetBands[1]) },\\n        },\\n        vertexShader: RING_VERTEX,\\n        fragmentShader: RING_FRAGMENT,\\n        transparent: true,\\n        depthWrite: false,\\n        side: THREE.DoubleSide,\\n      }),\\n    // eslint-disable-next-line react-hooks/exhaustive-deps\\n    [],\\n  );\\n\\n  useEffect(() => {\\n    ringMat.uniforms.uInnerCol.value\\n      .set(theme.atmosphereColor)\\n      .lerp(new THREE.Color(\'#94a3b8\'), 0.4);\\n    ringMat.uniforms.uOuterCol.value.set(theme.planetBands[1]);\\n  }, [ringMat, theme]);\\n\\n  // Procedural multi-spectral starfield\\n  const { starGeo, starMat } = useMemo(() => {\\n    const count = graphics.starCount;\\n    const positions = new Float32Array(count * 3);\\n    const colors = new Float32Array(count * 3);\\n    const sizes = new Float32Array(count);\\n    const phases = new Float32Array(count);\\n    const palette = [\\n      new THREE.Color(\'#e0f2fe\'),\\n      new THREE.Color(\'#bae6fd\'),\\n      new THREE.Color(\'#f8fafc\'),\\n      new THREE.Color(\'#93c5fd\'),\\n      new THREE.Color(\'#fef3c7\'),\\n    ];\\n\\n    let seed = 42019;\\n    const rand = () => {\\n      seed = (seed * 1664525 + 1013904223) >>> 0;\\n      return seed / 4294967296;\\n    };\\n\\n    for (let i = 0; i < count; i++) {\\n      const u = rand() * 2 - 1;\\n      const theta = rand() * Math.PI * 2;\\n      const sqrtOneMinusU2 = Math.sqrt(Math.max(0, 1 - u * u));\\n      const radius = 1400 + rand() * 1400;\\n\\n      positions[i * 3] = radius * sqrtOneMinusU2 * Math.cos(theta);\\n      positions[i * 3 + 1] = radius * u;\\n      positions[i * 3 + 2] = radius * sqrtOneMinusU2 * Math.sin(theta);\\n\\n      const col = palette[Math.floor(rand() * palette.length)];\\n      colors[i * 3] = col.r;\\n      colors[i * 3 + 1] = col.g;\\n      colors[i * 3 + 2] = col.b;\\n\\n      sizes[i] = 1.4 + Math.pow(rand(), 3.2) * 5.2;\\n      phases[i] = rand() * Math.PI * 2;\\n    }\\n\\n    const geo = new THREE.BufferGeometry();\\n    geo.setAttribute(\'position\', new THREE.BufferAttribute(positions, 3));\\n    geo.setAttribute(\'color\', new THREE.BufferAttribute(colors, 3));\\n    geo.setAttribute(\'aSize\', new THREE.BufferAttribute(sizes, 1));\\n    geo.setAttribute(\'aPhase\', new THREE.BufferAttribute(phases, 1));\\n\\n    const mat = new THREE.ShaderMaterial({\\n      uniforms: { uTime: { value: 0 } },\\n      vertexShader: STAR_VERTEX,\\n      fragmentShader: STAR_FRAGMENT,\\n      vertexColors: true,\\n      transparent: true,\\n      depthWrite: false,\\n      blending: THREE.AdditiveBlending,\\n    });\\n\\n    return { starGeo: geo, starMat: mat };\\n  }, [graphics.starCount]);\\n\\n  // Sculpted procedural asteroid geometry for InstancedMesh orbital belt\\n  const asteroidGeo = useMemo(() => {\\n    const geo = new THREE.DodecahedronGeometry(1, graphics.environmentDetail === \'low\' ? 0 : 1);\\n    const pos = geo.attributes.position;\\n    for (let i = 0; i < pos.count; i++) {\\n      const x = pos.getX(i);\\n      const y = pos.getY(i);\\n      const z = pos.getZ(i);\\n      const disp =\\n        0.82 +\\n        0.18 * Math.sin(x * 3.7 + y * 2.1) +\\n        0.14 * Math.cos(z * 4.3 - x * 2.9);\\n      pos.setXYZ(i, x * disp, y * disp * 0.86, z * disp);\\n    }\\n    geo.computeVertexNormals();\\n    return geo;\\n  }, [graphics.environmentDetail]);\\n\\n  const asteroidMat = useMemo(\\n    () =>\\n      new THREE.MeshStandardMaterial({\\n        map: envTex.bundle.asteroidMap,\\n        color: theme.asteroidTint,\\n        roughness: 0.88,\\n        metalness: 0.14,\\n      }),\\n    [envTex.bundle.asteroidMap, theme.asteroidTint],\\n  );\\n\\n  // Orbital sector beacons for crisp visual scale & spatial orientation\\n  const beacons = useMemo(() => {\\n    return [\\n      { pos: [0, 8, -140] as [number, number, number], scale: 1.0 },\\n      { pos: [145, 28, -320] as [number, number, number], scale: 1.2 },\\n      { pos: [-170, -18, -460] as [number, number, number], scale: 1.15 },\\n      { pos: [70, 52, -720] as [number, number, number], scale: 1.3 },\\n      { pos: [-240, 14, -180] as [number, number, number], scale: 1.0 },\\n      { pos: [280, -34, -110] as [number, number, number], scale: 1.1 },\\n    ];\\n  }, []);\\n\\n  // Populate instanced asteroid field with deterministic layout leaving clear flight corridor around spawn\\n  useEffect(() => {\\n    const mesh = asteroidsRef.current;\\n    if (!mesh) return;\\n\\n    let seed = 88123;\\n    const rand = () => {\\n      seed = (seed * 1664525 + 1013904223) >>> 0;\\n      return seed / 4294967296;\\n    };\\n\\n    const tint = new THREE.Color();\\n\\n    for (let i = 0; i < graphics.asteroidCount; i++) {\\n      const angle = rand() * Math.PI * 2;\\n      const dist = 75 + rand() * 820;\\n      const x = Math.cos(angle) * dist;\\n      const z = Math.sin(angle) * dist - 220;\\n      const y = (rand() - 0.5) * 260;\\n\\n      if (Math.hypot(x, y - 12, z - 40) < 62) {\\n        _dummy.position.set(x + 95, y + 35, z - 85);\\n      } else {\\n        _dummy.position.set(x, y, z);\\n      }\\n\\n      const scale = 1.6 + Math.pow(rand(), 2.2) * 16.5;\\n      _dummy.scale.set(\\n        scale * (0.85 + rand() * 0.35),\\n        scale * (0.75 + rand() * 0.35),\\n        scale * (0.85 + rand() * 0.35),\\n      );\\n      _dummy.rotation.set(rand() * Math.PI, rand() * Math.PI, rand() * Math.PI);\\n      _dummy.updateMatrix();\\n      mesh.setMatrixAt(i, _dummy.matrix);\\n\\n      const luma = 0.42 + rand() * 0.32;\\n      tint.setRGB(luma * 0.88, luma * 0.94, luma * 1.06);\\n      mesh.setColorAt(i, tint);\\n    }\\n    mesh.instanceMatrix.needsUpdate = true;\\n    if (mesh.instanceColor) mesh.instanceColor.needsUpdate = true;\\n    mesh.computeBoundingSphere();\\n  }, [graphics.asteroidCount, theme.id]);\\n\\n  useEffect(() => {\\n    return () => {\\n      starGeo.dispose();\\n      starMat.dispose();\\n    };\\n  }, [starGeo, starMat]);\\n\\n  useEffect(() => {\\n    return () => {\\n      asteroidGeo.dispose();\\n      asteroidMat.dispose();\\n    };\\n  }, [asteroidGeo, asteroidMat]);\\n\\n  useEffect(() => {\\n    return () => {\\n      nebulaMat.dispose();\\n      atmosphereMat.dispose();\\n      ringMat.dispose();\\n    };\\n  }, [nebulaMat, atmosphereMat, ringMat]);\\n\\n  useFrame((state, delta) => {\\n    const dt = Math.min(delta, 0.05);\\n    const t = state.clock.elapsedTime;\\n    nebulaMat.uniforms.uTime.value = t;\\n    starMat.uniforms.uTime.value = t;\\n\\n    if (skyboxRef.current) {\\n      skyboxRef.current.position.copy(camera.position);\\n    }\\n    if (starGroupRef.current) {\\n      starGroupRef.current.position.copy(camera.position);\\n    }\\n    if (gasGiantRef.current) {\\n      gasGiantRef.current.rotation.y += dt * 0.008;\\n    }\\n    if (moonRef.current) {\\n      moonRef.current.rotation.y += dt * 0.016;\\n    }\\n  });\\n\\n  return (\\n    <group name=\\\"space-environment\\\">\\n      {/* Solar Key Light + Deep-Space Fill + Mission-Themed Rim Backlight */}\\n      <directionalLight\\n        position={[320, 190, -260]}\\n        intensity={2.6}\\n        color={theme.keyLightColor}\\n        castShadow={graphics.shadows}\\n        shadow-mapSize={[graphics.shadowMapSize, graphics.shadowMapSize]}\\n        shadow-bias={-0.0005}\\n        shadow-normalBias={0.02}\\n      />\\n      <hemisphereLight args={[theme.hemiSkyColor, \'#090f24\', 0.85]} />\\n      <directionalLight position={[-180, -90, 220]} intensity={1.1} color={theme.rimLightColor} />\\n\\n      {/* Procedural Deep-Space Nebula Skybox */}\\n      <mesh ref={skyboxRef} frustumCulled={false} renderOrder={-100}>\\n        <sphereGeometry args={[Math.max(2200, graphics.drawDistance * 0.78), 28, 20]} />\\n        <primitive object={nebulaMat} attach=\\\"material\\\" />\\n      </mesh>\\n\\n      {/* Multi-Spectral Twinkling Starfield */}\\n      <points ref={starGroupRef} geometry={starGeo} material={starMat} frustumCulled={false} />\\n\\n      {/* Primary Cinematic Gas Giant with Rings & Atmospheric Fresnel Halo */}\\n      <group position={[-480, 130, -1350]} rotation={[0.24, 0.35, -0.28]}>\\n        <group ref={gasGiantRef}>\\n          <mesh>\\n            <sphereGeometry args={[280, graphics.planetSegments, graphics.planetSegments]} />\\n            <meshStandardMaterial\\n              map={envTex.bundle.gasGiantMap}\\n              roughness={0.82}\\n              metalness={0.06}\\n              envMapIntensity={0.4}\\n            />\\n          </mesh>\\n        </group>\\n\\n        {/* Fresnel Atmospheric Rim Shell */}\\n        {graphics.postGlowEnabled && (\\n          <mesh scale={1.045}>\\n            <sphereGeometry args={[280, graphics.planetSegments, graphics.planetSegments]} />\\n            <primitive object={atmosphereMat} attach=\\\"material\\\" />\\n          </mesh>\\n        )}\\n\\n        {/* Tilted Planetary Ring System */}\\n        <mesh rotation={[Math.PI * 0.47, 0.1, 0]}>\\n          <planeGeometry args={[1240, 1240]} />\\n          <primitive object={ringMat} attach=\\\"material\\\" />\\n        </mesh>\\n      </group>\\n\\n      {/* Secondary Scarred Rocky Moon */}\\n      <mesh ref={moonRef} position={[620, -110, -920]}>\\n        <sphereGeometry\\n          args={[\\n            92,\\n            Math.max(20, graphics.planetSegments - 12),\\n            Math.max(20, graphics.planetSegments - 12),\\n          ]}\\n        />\\n        <meshStandardMaterial\\n          map={envTex.bundle.moonMap}\\n          roughness={0.92}\\n          metalness={0.08}\\n          envMapIntensity={0.35}\\n        />\\n      </mesh>\\n\\n      {/* Distant Warm Dwarf Star Accent */}\\n      <mesh position={[1200, 560, -1700]}>\\n        <sphereGeometry args={[32, 16, 16]} />\\n        <meshBasicMaterial color={theme.keyLightColor} toneMapped={false} />\\n      </mesh>\\n\\n      {/* Instanced Asteroid Belt for Speed Parallax & Spatial Depth */}\\n      <instancedMesh\\n        key={`asteroids-${graphics.asteroidCount}-${graphics.environmentDetail}`}\\n        ref={asteroidsRef}\\n        args={[asteroidGeo, asteroidMat, graphics.asteroidCount]}\\n        frustumCulled={false}\\n      />\\n\\n      {/* Orbital Navigation Relay Beacons */}\\n      {beacons.map((b, idx) => (\\n        <group key={idx} position={b.pos} scale={b.scale}>\\n          <mesh rotation={[0, 0, Math.PI / 4]}>\\n            <torusGeometry args={[14, 0.55, 8, 24]} />\\n            <meshStandardMaterial color=\\\"#334155\\\" metalness={0.85} roughness={0.32} />\\n          </mesh>\\n          <mesh rotation={[0, 0, Math.PI / 4]}>\\n            <torusGeometry args={[12.8, 0.16, 6, 24]} />\\n            <meshStandardMaterial\\n              color={theme.beaconColor}\\n              emissive={theme.beaconColor}\\n              emissiveIntensity={graphics.postGlowEnabled ? 1.6 : 0.9}\\n              toneMapped={false}\\n            />\\n          </mesh>\\n        </group>\\n      ))}\\n    </group>\\n  );\\n}\\n\", \"Description\":\"Upgrade SpaceEnvironment to use mission-specific palettes, reference-counted AssetManager environment textures, and adaptive graphics detail/shadows/nebula octaves\", \"Overwrite\":true, \"TargetFile\":\"/src/scene/SpaceEnvironment.tsx\", \"toolAction\":\"Updating SpaceEnvironment themes and LOD\", \"toolSummary\":\"Update SpaceEnvironment themes and LOD\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_13163534334258664835"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useEffect, useMemo } from \'react\';\\nimport { useFrame } from \'@react-three/fiber\';\\nimport * as THREE from \'three\';\\nimport type { GraphicsPreset } from \'../config/graphics\';\\nimport { SHIP_CONFIGS } from \'../config/ships\';\\nimport { MAX_ENEMIES, type CombatManager } from \'../engine/combat/CombatManager\';\\nimport type { ShipConfig, ShipVisualHandle } from \'../types/game\';\\nimport { buildShipModel } from \'./shipGeometry\';\\n\\ninterface EnemyShipRendererProps {\\n  combat: CombatManager;\\n  visible: boolean;\\n  graphics: GraphicsPreset;\\n  playerPosition: THREE.Vector3;\\n}\\n\\nfunction createHostileShipConfig(base: ShipConfig): ShipConfig {\\n  return {\\n    ...base,\\n    colors: {\\n      hullPrimary: \'#1c1f2b\',\\n      hullSecondary: \'#0c0e16\',\\n      hullTrim: \'#f97316\',\\n      canopy: \'#1f0c14\',\\n      engineCore: \'#fef3c7\',\\n      engineGlow: \'#ef4444\',\\n    },\\n  };\\n}\\n\\ninterface PooledEnemySlot {\\n  root: THREE.Group;\\n  bankGroup: THREE.Group;\\n  handle: ShipVisualHandle;\\n  hitGlowSprite: THREE.Sprite;\\n  hitGlowMat: THREE.SpriteMaterial;\\n}\\n\\n/**\\n * Pooled zero-re-render renderer for active enemy combat fighters.\\n * Applies distance-based LOD culling of dynamic engine point lights and glow sprites\\n * to keep fragment shader lighting cost tightly bounded during multi-enemy dogfights.\\n */\\nexport function EnemyShipRenderer({\\n  combat,\\n  visible,\\n  graphics,\\n  playerPosition,\\n}: EnemyShipRendererProps) {\\n  const slots = useMemo<PooledEnemySlot[]>(() => {\\n    const hostileConfigs: ShipConfig[] = [\\n      createHostileShipConfig(SHIP_CONFIGS.striker),\\n      createHostileShipConfig(SHIP_CONFIGS.interceptor),\\n      createHostileShipConfig(SHIP_CONFIGS.striker),\\n      createHostileShipConfig(SHIP_CONFIGS.destroyer),\\n      createHostileShipConfig(SHIP_CONFIGS.interceptor),\\n      createHostileShipConfig(SHIP_CONFIGS.striker),\\n    ];\\n\\n    const list: PooledEnemySlot[] = [];\\n    for (let i = 0; i < MAX_ENEMIES; i++) {\\n      const root = new THREE.Group();\\n      root.visible = false;\\n      const bankGroup = new THREE.Group();\\n      const handle = buildShipModel(\\n        hostileConfigs[i % hostileConfigs.length],\\n        graphics.textureResolution,\\n      );\\n      bankGroup.add(handle.group);\\n      root.add(bankGroup);\\n\\n      const hitGlowMat = new THREE.SpriteMaterial({\\n        color: \'#fb923c\',\\n        transparent: true,\\n        opacity: 0,\\n        depthWrite: false,\\n        blending: THREE.AdditiveBlending,\\n      });\\n      const hitGlowSprite = new THREE.Sprite(hitGlowMat);\\n      hitGlowSprite.scale.set(6.5, 6.5, 1);\\n      root.add(hitGlowSprite);\\n\\n      list.push({ root, bankGroup, handle, hitGlowSprite, hitGlowMat });\\n    }\\n    return list;\\n  }, [graphics.textureResolution]);\\n\\n  useEffect(() => {\\n    return () => {\\n      for (const s of slots) {\\n        s.handle.dispose();\\n        s.hitGlowMat.dispose();\\n      }\\n    };\\n  }, [slots]);\\n\\n  useFrame((_, delta) => {\\n    const dt = Math.min(delta, 0.05);\\n    const enemies = combat.enemies;\\n    const lodDistSq = graphics.enemyLightLodDistance * graphics.enemyLightLodDistance;\\n\\n    for (let i = 0; i < slots.length; i++) {\\n      const slot = slots[i];\\n      const enemy = enemies[i];\\n\\n      if (!visible || !enemy || !enemy.active || enemy.health.isDestroyed) {\\n        slot.root.visible = false;\\n        continue;\\n      }\\n\\n      slot.root.visible = true;\\n      slot.root.position.copy(enemy.position);\\n      slot.root.quaternion.copy(enemy.quaternion);\\n      slot.bankGroup.rotation.set(0, 0, enemy.visualBankAngle);\\n\\n      // Distance-based LOD: disable dynamic PointLight & engine flare sprites on distant ships\\n      const distSq = enemy.position.distanceToSquared(playerPosition);\\n      slot.handle.setDetailLevel?.(graphics.postGlowEnabled && distSq <= lodDistSq);\\n\\n      const speedRatio = enemy.velocity.length() / 90;\\n      const boostVisual = enemy.aiState === \'evade\' || enemy.aiState === \'reposition\' ? 0.85 : 0.25;\\n      slot.handle.updateVisuals(dt, speedRatio, boostVisual, 0, 0, 0);\\n\\n      // Brief impact flare when struck by player fire\\n      if (enemy.hitFlashTimer > 0 && graphics.postGlowEnabled) {\\n        slot.hitGlowSprite.visible = true;\\n        slot.hitGlowMat.opacity = Math.min(0.85, enemy.hitFlashTimer * 6.0);\\n        const s = 5.8 + enemy.hitFlashTimer * 18;\\n        slot.hitGlowSprite.scale.set(s, s, 1);\\n      } else {\\n        slot.hitGlowSprite.visible = false;\\n        slot.hitGlowMat.opacity = 0;\\n      }\\n    }\\n  });\\n\\n  return (\\n    <group name=\\\"enemy-fleet\\\">\\n      {slots.map((slot, idx) => (\\n        <primitive key={idx} object={slot.root} />\\n      ))}\\n    </group>\\n  );\\n}\\n\", \"Description\":\"Add distance-based LOD light/effect culling and texture resolution scaling to EnemyShipRenderer\", \"Overwrite\":true, \"TargetFile\":\"/src/scene/EnemyShipRenderer.tsx\", \"toolAction\":\"Adding LOD culling to EnemyShipRenderer\", \"toolSummary\":\"Add LOD culling to EnemyShipRenderer\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_13163534334258666700"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { forwardRef, useEffect, useImperativeHandle, useMemo, useRef } from \'react\';\\nimport { useFrame } from \'@react-three/fiber\';\\nimport * as THREE from \'three\';\\nimport type { GraphicsPreset } from \'../config/graphics\';\\nimport { AssetManager } from \'../engine/AssetManager\';\\nimport type { CombatManager, VfxBurstEvent } from \'../engine/combat/CombatManager\';\\nimport { MAX_POOLED_PROJECTILES } from \'../engine/combat/ProjectilePool\';\\nimport type { FlightTelemetry } from \'../types/game\';\\n\\nexport interface CombatVFXHandle {\\n  spawnBurst: (evt: VfxBurstEvent) => void;\\n  clear: () => void;\\n}\\n\\ninterface CombatVFXProps {\\n  combat: CombatManager;\\n  telemetryRef: React.MutableRefObject<FlightTelemetry>;\\n  active: boolean;\\n  graphics: GraphicsPreset;\\n}\\n\\nconst MAX_SPARK_POOL = 320;\\nconst MAX_SHOCKWAVE_POOL = 16;\\n\\ninterface SparkParticle {\\n  active: boolean;\\n  position: THREE.Vector3;\\n  velocity: THREE.Vector3;\\n  age: number;\\n  maxAge: number;\\n  size: number;\\n  color: THREE.Color;\\n}\\n\\ninterface ShockwaveSlot {\\n  active: boolean;\\n  position: THREE.Vector3;\\n  age: number;\\n  maxAge: number;\\n  maxScale: number;\\n  isExplosion: boolean;\\n}\\n\\nconst _dummy = new THREE.Object3D();\\nconst _upVec = new THREE.Vector3(0, 1, 0);\\nconst _quat = new THREE.Quaternion();\\nconst _hiddenScale = new THREE.Vector3(0, 0, 0);\\n\\n/**\\n * Pooled high-craft combat visual effects renderer:\\n * - Instanced player & enemy plasma bolts\\n * - Quality-scaled pooled spark & debris particles\\n * - Pooled expanding shockwave & core detonation flashes\\n * Zero per-frame allocations; reports active particle count to telemetryRef.\\n */\\nexport const CombatVFX = forwardRef<CombatVFXHandle, CombatVFXProps>(\\n  function CombatVFX({ combat, telemetryRef, active, graphics }, ref) {\\n    const playerBoltsRef = useRef<THREE.InstancedMesh>(null);\\n    const enemyBoltsRef = useRef<THREE.InstancedMesh>(null);\\n    const sparksRef = useRef<THREE.InstancedMesh>(null);\\n    const shockwaveGroupRef = useRef<THREE.Group>(null);\\n\\n    const glowSpriteTex = useMemo(() => AssetManager.acquireGlowSprite(), []);\\n\\n    useEffect(() => {\\n      return () => {\\n        AssetManager.releaseGlowSprite();\\n      };\\n    }, [glowSpriteTex]);\\n\\n    const boltGeo = useMemo(() => new THREE.CylinderGeometry(0.14, 0.14, 1, 6, 1), []);\\n    const playerBoltMat = useMemo(\\n      () =>\\n        new THREE.MeshBasicMaterial({\\n          color: \'#67e8f9\',\\n          transparent: true,\\n          opacity: 0.96,\\n          blending: THREE.AdditiveBlending,\\n          depthWrite: false,\\n          toneMapped: false,\\n        }),\\n      [],\\n    );\\n    const enemyBoltMat = useMemo(\\n      () =>\\n        new THREE.MeshBasicMaterial({\\n          color: \'#fb923c\',\\n          transparent: true,\\n          opacity: 0.96,\\n          blending: THREE.AdditiveBlending,\\n          depthWrite: false,\\n          toneMapped: false,\\n        }),\\n      [],\\n    );\\n\\n    const sparkGeo = useMemo(() => new THREE.OctahedronGeometry(0.32, 0), []);\\n    const sparkMat = useMemo(\\n      () =>\\n        new THREE.MeshBasicMaterial({\\n          color: \'#ffffff\',\\n          transparent: true,\\n          opacity: 0.92,\\n          blending: THREE.AdditiveBlending,\\n          depthWrite: false,\\n          toneMapped: false,\\n        }),\\n      [],\\n    );\\n\\n    const shockSphereGeo = useMemo(() => new THREE.SphereGeometry(1, 14, 10), []);\\n    const shockRingGeo = useMemo(() => new THREE.RingGeometry(0.76, 1.0, 24), []);\\n\\n    const particles = useMemo<SparkParticle[]>(() => {\\n      const arr: SparkParticle[] = [];\\n      for (let i = 0; i < MAX_SPARK_POOL; i++) {\\n        arr.push({\\n          active: false,\\n          position: new THREE.Vector3(),\\n          velocity: new THREE.Vector3(),\\n          age: 0,\\n          maxAge: 0.5,\\n          size: 1,\\n          color: new THREE.Color(\'#22d3ee\'),\\n        });\\n      }\\n      return arr;\\n    }, []);\\n    const sparkCursor = useRef(0);\\n\\n    const shockwaves = useMemo<ShockwaveSlot[]>(() => {\\n      const arr: ShockwaveSlot[] = [];\\n      for (let i = 0; i < MAX_SHOCKWAVE_POOL; i++) {\\n        arr.push({\\n          active: false,\\n          position: new THREE.Vector3(),\\n          age: 0,\\n          maxAge: 0.6,\\n          maxScale: 16,\\n          isExplosion: true,\\n        });\\n      }\\n      return arr;\\n    }, []);\\n    const shockCursor = useRef(0);\\n\\n    const shockMeshes = useMemo(() => {\\n      return Array.from({ length: MAX_SHOCKWAVE_POOL }, () => {\\n        const group = new THREE.Group();\\n        group.visible = false;\\n\\n        const coreMat = new THREE.MeshBasicMaterial({\\n          color: \'#e0f2fe\',\\n          transparent: true,\\n          opacity: 0,\\n          blending: THREE.AdditiveBlending,\\n          depthWrite: false,\\n          toneMapped: false,\\n        });\\n        const core = new THREE.Mesh(shockSphereGeo, coreMat);\\n        group.add(core);\\n\\n        const ringMat = new THREE.MeshBasicMaterial({\\n          color: \'#38bdf8\',\\n          transparent: true,\\n          opacity: 0,\\n          side: THREE.DoubleSide,\\n          blending: THREE.AdditiveBlending,\\n          depthWrite: false,\\n          toneMapped: false,\\n        });\\n        const ring = new THREE.Mesh(shockRingGeo, ringMat);\\n        group.add(ring);\\n\\n        const flashMat = new THREE.SpriteMaterial({\\n          map: glowSpriteTex,\\n          color: \'#7dd3fc\',\\n          transparent: true,\\n          opacity: 0,\\n          blending: THREE.AdditiveBlending,\\n          depthWrite: false,\\n        });\\n        const flash = new THREE.Sprite(flashMat);\\n        group.add(flash);\\n\\n        return { group, core, coreMat, ring, ringMat, flash, flashMat };\\n      });\\n    }, [shockRingGeo, shockSphereGeo, glowSpriteTex]);\\n\\n    const graphicsRef = useRef(graphics);\\n    graphicsRef.current = graphics;\\n\\n    useEffect(() => {\\n      return () => {\\n        boltGeo.dispose();\\n        playerBoltMat.dispose();\\n        enemyBoltMat.dispose();\\n        sparkGeo.dispose();\\n        sparkMat.dispose();\\n        shockSphereGeo.dispose();\\n        shockRingGeo.dispose();\\n        for (const m of shockMeshes) {\\n          m.coreMat.dispose();\\n          m.ringMat.dispose();\\n          m.flashMat.dispose();\\n        }\\n      };\\n    }, [\\n      boltGeo,\\n      enemyBoltMat,\\n      playerBoltMat,\\n      shockMeshes,\\n      shockRingGeo,\\n      shockSphereGeo,\\n      sparkGeo,\\n      sparkMat,\\n    ]);\\n\\n    useImperativeHandle(\\n      ref,\\n      () => ({\\n        spawnBurst: (evt: VfxBurstEvent) => {\\n          const gfx = graphicsRef.current;\\n          const isExplosion = evt.kind === \'explosion\';\\n          const baseCount = isExplosion ? 32 : 9;\\n          const sparkCount = Math.max(4, Math.round(baseCount * gfx.sparkScaleFactor));\\n          const sparkPoolLimit = Math.min(MAX_SPARK_POOL, gfx.maxSparkParticles);\\n          const shockPoolLimit = Math.min(MAX_SHOCKWAVE_POOL, gfx.maxShockwaves);\\n\\n          const swIdx = shockCursor.current % shockPoolLimit;\\n          shockCursor.current += 1;\\n          const sw = shockwaves[swIdx];\\n          sw.active = true;\\n          sw.position.copy(evt.position);\\n          sw.age = 0;\\n          sw.maxAge = isExplosion ? 0.68 : 0.22;\\n          sw.maxScale = isExplosion ? 18 * evt.scale : 4.2 * evt.scale;\\n          sw.isExplosion = isExplosion;\\n\\n          const meshSlot = shockMeshes[swIdx];\\n          meshSlot.ring.rotation.set(\\n            Math.random() * Math.PI,\\n            Math.random() * Math.PI,\\n            Math.random() * Math.PI,\\n          );\\n          const accentColor =\\n            evt.kind === \'player-hit\' ? \'#fb923c\' : isExplosion ? \'#38bdf8\' : \'#22d3ee\';\\n          meshSlot.ringMat.color.set(accentColor);\\n          meshSlot.flashMat.color.set(isExplosion ? \'#f59e0b\' : accentColor);\\n          meshSlot.coreMat.color.set(isExplosion ? \'#fef3c7\' : \'#e0f2fe\');\\n\\n          for (let i = 0; i < sparkCount; i++) {\\n            const p = particles[sparkCursor.current % sparkPoolLimit];\\n            sparkCursor.current += 1;\\n            p.active = true;\\n            p.position.copy(evt.position);\\n\\n            const u = Math.random() * 2 - 1;\\n            const theta = Math.random() * Math.PI * 2;\\n            const r = Math.sqrt(Math.max(0, 1 - u * u));\\n            const speed = isExplosion\\n              ? 24 + Math.random() * 78\\n              : 14 + Math.random() * 38;\\n            p.velocity.set(r * Math.cos(theta) * speed, u * speed, r * Math.sin(theta) * speed);\\n            p.age = 0;\\n            p.maxAge = isExplosion ? 0.45 + Math.random() * 0.55 : 0.18 + Math.random() * 0.22;\\n            p.size = isExplosion ? 0.7 + Math.random() * 1.45 : 0.45 + Math.random() * 0.65;\\n\\n            if (isExplosion) {\\n              p.color.set(i % 3 === 0 ? \'#67e8f9\' : i % 2 === 0 ? \'#fb923c\' : \'#fef3c7\');\\n            } else if (evt.kind === \'player-hit\') {\\n              p.color.set(\'#fb923c\');\\n            } else {\\n              p.color.set(\'#67e8f9\');\\n            }\\n          }\\n        },\\n        clear: () => {\\n          for (let i = 0; i < particles.length; i++) particles[i].active = false;\\n          for (let i = 0; i < shockwaves.length; i++) {\\n            shockwaves[i].active = false;\\n            shockMeshes[i].group.visible = false;\\n          }\\n        },\\n      }),\\n      [particles, shockMeshes, shockwaves],\\n    );\\n\\n    useFrame((_, delta) => {\\n      const dt = Math.min(delta, 0.05);\\n      const pMesh = playerBoltsRef.current;\\n      const eMesh = enemyBoltsRef.current;\\n      const sMesh = sparksRef.current;\\n      if (!pMesh || !eMesh || !sMesh) return;\\n\\n      const gfx = graphicsRef.current;\\n\\n      // 1. Update Instanced Player & Enemy Energy Projectiles\\n      const items = combat.projectiles.items;\\n      for (let i = 0; i < MAX_POOLED_PROJECTILES; i++) {\\n        const proj = items[i];\\n        if (!active || !proj.active) {\\n          _dummy.scale.copy(_hiddenScale);\\n          _dummy.updateMatrix();\\n          pMesh.setMatrixAt(i, _dummy.matrix);\\n          eMesh.setMatrixAt(i, _dummy.matrix);\\n          continue;\\n        }\\n\\n        _quat.setFromUnitVectors(_upVec, proj.direction);\\n        _dummy.position.copy(proj.position);\\n        _dummy.quaternion.copy(_quat);\\n\\n        if (proj.isPlayerOwned) {\\n          _dummy.scale.set(proj.boltRadius * 7.5, proj.boltLength, proj.boltRadius * 7.5);\\n          _dummy.updateMatrix();\\n          pMesh.setMatrixAt(i, _dummy.matrix);\\n\\n          _dummy.scale.copy(_hiddenScale);\\n          _dummy.updateMatrix();\\n          eMesh.setMatrixAt(i, _dummy.matrix);\\n        } else {\\n          _dummy.scale.set(proj.boltRadius * 8.2, proj.boltLength, proj.boltRadius * 8.2);\\n          _dummy.updateMatrix();\\n          eMesh.setMatrixAt(i, _dummy.matrix);\\n\\n          _dummy.scale.copy(_hiddenScale);\\n          _dummy.updateMatrix();\\n          pMesh.setMatrixAt(i, _dummy.matrix);\\n        }\\n      }\\n      pMesh.instanceMatrix.needsUpdate = true;\\n      eMesh.instanceMatrix.needsUpdate = true;\\n\\n      // 2. Update Pooled Impact & Explosion Sparks\\n      let activeSparkCount = 0;\\n      for (let i = 0; i < MAX_SPARK_POOL; i++) {\\n        const p = particles[i];\\n        if (!active || !p.active) {\\n          _dummy.scale.copy(_hiddenScale);\\n          _dummy.updateMatrix();\\n          sMesh.setMatrixAt(i, _dummy.matrix);\\n          continue;\\n        }\\n\\n        p.age += dt;\\n        if (p.age >= p.maxAge) {\\n          p.active = false;\\n          _dummy.scale.copy(_hiddenScale);\\n          _dummy.updateMatrix();\\n          sMesh.setMatrixAt(i, _dummy.matrix);\\n          continue;\\n        }\\n\\n        activeSparkCount += 1;\\n        p.position.addScaledVector(p.velocity, dt);\\n        p.velocity.multiplyScalar(Math.exp(-2.2 * dt));\\n        const lifeRatio = 1 - p.age / p.maxAge;\\n        const sc = p.size * lifeRatio;\\n\\n        _dummy.position.copy(p.position);\\n        _dummy.rotation.set(p.age * 8, p.age * 6, 0);\\n        _dummy.scale.set(sc, sc * 1.8, sc);\\n        _dummy.updateMatrix();\\n        sMesh.setMatrixAt(i, _dummy.matrix);\\n        sMesh.setColorAt(i, p.color);\\n      }\\n      sMesh.instanceMatrix.needsUpdate = true;\\n      if (sMesh.instanceColor) sMesh.instanceColor.needsUpdate = true;\\n\\n      // 3. Update Pooled Shockwave & Core Flash Slots\\n      let activeShockCount = 0;\\n      for (let i = 0; i < MAX_SHOCKWAVE_POOL; i++) {\\n        const sw = shockwaves[i];\\n        const m = shockMeshes[i];\\n        if (!active || !sw.active) {\\n          m.group.visible = false;\\n          continue;\\n        }\\n\\n        sw.age += dt;\\n        if (sw.age >= sw.maxAge) {\\n          sw.active = false;\\n          m.group.visible = false;\\n          continue;\\n        }\\n\\n        activeShockCount += 1;\\n        const t = sw.age / sw.maxAge;\\n        const easeOut = 1 - Math.pow(1 - t, 3);\\n        m.group.visible = true;\\n        m.group.position.copy(sw.position);\\n\\n        const ringScale = 0.8 + easeOut * sw.maxScale;\\n        m.ring.scale.setScalar(ringScale);\\n        m.ringMat.opacity = (1 - t) * (sw.isExplosion ? 0.85 : 0.65);\\n\\n        const coreScale = sw.isExplosion\\n          ? (0.6 + easeOut * sw.maxScale * 0.42) * (1 - t * 0.35)\\n          : 0.4 + (1 - t) * 1.8;\\n        m.core.scale.setScalar(Math.max(0.01, coreScale));\\n        m.coreMat.opacity = Math.pow(1 - t, 1.8) * (sw.isExplosion ? 0.92 : 0.72);\\n\\n        m.flash.visible = gfx.postGlowEnabled;\\n        if (gfx.postGlowEnabled) {\\n          const spriteScale = sw.isExplosion\\n            ? sw.maxScale * (1.2 + easeOut * 0.9)\\n            : sw.maxScale * 1.4;\\n          m.flash.scale.setScalar(spriteScale);\\n          m.flashMat.opacity = Math.pow(1 - t, 1.4) * (sw.isExplosion ? 0.9 : 0.6);\\n        }\\n      }\\n\\n      telemetryRef.current.activeParticles = activeSparkCount + activeShockCount;\\n    });\\n\\n    return (\\n      <group name=\\\"combat-vfx\\\">\\n        <instancedMesh\\n          ref={playerBoltsRef}\\n          args={[boltGeo, playerBoltMat, MAX_POOLED_PROJECTILES]}\\n          frustumCulled={false}\\n          renderOrder={14}\\n        />\\n        <instancedMesh\\n          ref={enemyBoltsRef}\\n          args={[boltGeo, enemyBoltMat, MAX_POOLED_PROJECTILES]}\\n          frustumCulled={false}\\n          renderOrder={14}\\n        />\\n        <instancedMesh\\n          ref={sparksRef}\\n          args={[sparkGeo, sparkMat, MAX_SPARK_POOL]}\\n          frustumCulled={false}\\n          renderOrder={15}\\n        />\\n        <group ref={shockwaveGroupRef}>\\n          {shockMeshes.map((m, idx) => (\\n            <primitive key={idx} object={m.group} />\\n          ))}\\n        </group>\\n      </group>\\n    );\\n  },\\n);\\n\", \"Description\":\"Scale CombatVFX particle budgets by graphics quality, use AssetManager ref-counted glow sprite, and publish active particle telemetry\", \"Overwrite\":true, \"TargetFile\":\"/src/scene/CombatVFX.tsx\", \"toolAction\":\"Updating CombatVFX particle scaling and telemetry\", \"toolSummary\":\"Update CombatVFX particle scaling\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_13163534334258664469"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useEffect, useMemo, useRef } from \'react\';\\nimport { useFrame, useThree } from \'@react-three/fiber\';\\nimport * as THREE from \'three\';\\nimport { AudioManager } from \'../audio/AudioManager\';\\nimport type { GraphicsPreset } from \'../config/graphics\';\\nimport { SHIP_CONFIGS } from \'../config/ships\';\\nimport { AssetManager } from \'../engine/AssetManager\';\\nimport { CameraController } from \'../engine/CameraController\';\\nimport { PLAYER_ENTITY_ID, type CombatManager } from \'../engine/combat/CombatManager\';\\nimport type { FlightController } from \'../engine/FlightController\';\\nimport type { InputManager } from \'../engine/InputManager\';\\nimport type { MissionManager } from \'../engine/mission/MissionManager\';\\nimport type {\\n  FlightTelemetry,\\n  GamePhase,\\n  GameSettings,\\n  MenuSection,\\n  ShipId,\\n} from \'../types/game\';\\nimport type { MissionEnvironmentTheme } from \'../types/mission\';\\nimport { CombatVFX, type CombatVFXHandle } from \'./CombatVFX\';\\nimport { EnemyShipRenderer } from \'./EnemyShipRenderer\';\\nimport { buildShipModel } from \'./shipGeometry\';\\nimport { SpaceEnvironment } from \'./SpaceEnvironment\';\\nimport { SpeedLinesVFX } from \'./SpeedLinesVFX\';\\n\\ninterface GameSceneProps {\\n  phase: GamePhase;\\n  menuSection: MenuSection;\\n  activeShipId: ShipId;\\n  hangarShipId: ShipId;\\n  flight: FlightController;\\n  combat: CombatManager;\\n  missionManager: MissionManager;\\n  missionTheme: MissionEnvironmentTheme;\\n  input: InputManager;\\n  settingsRef: React.MutableRefObject<GameSettings>;\\n  telemetryRef: React.MutableRefObject<FlightTelemetry>;\\n  graphics: GraphicsPreset;\\n  hangarOrbitRef: React.MutableRefObject<{ yaw: number; pitch: number }>;\\n  snapCameraSignal: number;\\n  onPlayerDestroyed: () => void;\\n}\\n\\nconst _showcaseOrigin = new THREE.Vector3(0, 12, 40);\\n\\nexport function GameScene({\\n  phase,\\n  menuSection,\\n  activeShipId,\\n  hangarShipId,\\n  flight,\\n  combat,\\n  missionManager,\\n  missionTheme,\\n  input,\\n  settingsRef,\\n  telemetryRef,\\n  graphics,\\n  hangarOrbitRef,\\n  snapCameraSignal,\\n  onPlayerDestroyed,\\n}: GameSceneProps) {\\n  const { camera, gl } = useThree();\\n  const shipRootRef = useRef<THREE.Group>(null);\\n  const shipBankRef = useRef<THREE.Group>(null);\\n  const muzzleLeftRef = useRef<THREE.Sprite>(null);\\n  const muzzleRightRef = useRef<THREE.Sprite>(null);\\n  const vfxRef = useRef<CombatVFXHandle>(null);\\n  const cameraController = useMemo(() => new CameraController(), []);\\n  const glowSpriteTex = useMemo(() => AssetManager.acquireGlowSprite(), []);\\n\\n  useEffect(() => {\\n    return () => {\\n      AssetManager.releaseGlowSprite();\\n    };\\n  }, [glowSpriteTex]);\\n\\n  // Display the inspected ship while in Hangar, otherwise the active flight ship\\n  const displayedShipId = phase === \'menu\' && menuSection === \'hangar\' ? hangarShipId : activeShipId;\\n  const displayedShipConfig = SHIP_CONFIGS[displayedShipId];\\n\\n  const shipHandle = useMemo(\\n    () => buildShipModel(displayedShipConfig, graphics.textureResolution),\\n    [displayedShipConfig, graphics.textureResolution],\\n  );\\n\\n  useEffect(() => {\\n    shipHandle.setDetailLevel?.(graphics.postGlowEnabled);\\n  }, [shipHandle, graphics.postGlowEnabled]);\\n\\n  const muzzleMatLeft = useMemo(\\n    () =>\\n      new THREE.SpriteMaterial({\\n        map: glowSpriteTex,\\n        color: \'#67e8f9\',\\n        transparent: true,\\n        opacity: 0,\\n        blending: THREE.AdditiveBlending,\\n        depthWrite: false,\\n      }),\\n    [glowSpriteTex],\\n  );\\n\\n  const muzzleMatRight = useMemo(\\n    () =>\\n      new THREE.SpriteMaterial({\\n        map: glowSpriteTex,\\n        color: \'#67e8f9\',\\n        transparent: true,\\n        opacity: 0,\\n        blending: THREE.AdditiveBlending,\\n        depthWrite: false,\\n      }),\\n    [glowSpriteTex],\\n  );\\n\\n  useEffect(() => {\\n    return () => {\\n      shipHandle.dispose();\\n    };\\n  }, [shipHandle]);\\n\\n  useEffect(() => {\\n    return () => {\\n      muzzleMatLeft.dispose();\\n      muzzleMatRight.dispose();\\n    };\\n  }, [muzzleMatLeft, muzzleMatRight]);\\n\\n  // Wire CombatManager callbacks to procedural audio, pooled 3D VFX, and MissionManager\\n  useEffect(() => {\\n    combat.setCallbacks({\\n      onPlayerFire: () => {\\n        AudioManager.playPlayerLaser();\\n      },\\n      onEnemyFire: (evt) => {\\n        const dist = flight.position.distanceTo(evt.origin);\\n        AudioManager.playEnemyLaser(dist);\\n      },\\n      onDamage: (evt) => {\\n        if (evt.targetId === PLAYER_ENTITY_ID) {\\n          AudioManager.playPlayerDamage();\\n        } else {\\n          AudioManager.playImpactHit(evt.destroyed);\\n        }\\n      },\\n      onDestruction: (evt) => {\\n        const dist = flight.position.distanceTo(evt.position);\\n        AudioManager.playExplosion(dist);\\n        missionManager.handleDestruction(evt, combat);\\n        if (evt.entityId === PLAYER_ENTITY_ID) {\\n          onPlayerDestroyed();\\n        }\\n      },\\n      onVfxBurst: (evt) => {\\n        vfxRef.current?.spawnBurst(evt);\\n      },\\n    });\\n  }, [combat, flight, missionManager, onPlayerDestroyed]);\\n\\n  // Snap chase camera and clear transient VFX when starting or resetting a session\\n  useEffect(() => {\\n    vfxRef.current?.clear();\\n    if (phase === \'playing\' && camera instanceof THREE.PerspectiveCamera) {\\n      cameraController.snapToShip(flight, camera, settingsRef.current.cameraDistance);\\n    }\\n  }, [snapCameraSignal, phase, camera, cameraController, flight, settingsRef]);\\n\\n  // Sync camera draw distance when graphics settings change\\n  useEffect(() => {\\n    if (camera instanceof THREE.PerspectiveCamera) {\\n      camera.far = graphics.drawDistance;\\n      camera.updateProjectionMatrix();\\n    }\\n  }, [camera, graphics.drawDistance]);\\n\\n  const perfRef = useRef({ frames: 0, elapsed: 0 });\\n\\n  useFrame((state, delta) => {\\n    const dt = Math.min(delta, 0.05);\\n    const telemetry = telemetryRef.current;\\n    const settings = settingsRef.current;\\n\\n    // Performance metrics update (every 250ms, zero React re-renders)\\n    perfRef.current.frames += 1;\\n    perfRef.current.elapsed += delta;\\n    if (perfRef.current.elapsed >= 0.25) {\\n      const avgFrameSec = perfRef.current.elapsed / perfRef.current.frames;\\n      telemetry.fps = Math.round(1 / Math.max(avgFrameSec, 0.001));\\n      telemetry.frameTimeMs = avgFrameSec * 1000;\\n      telemetry.drawCalls = gl.info.render.calls;\\n      telemetry.triangles = gl.info.render.triangles;\\n      const diag = AssetManager.getDiagnostics();\\n      telemetry.lastAssetLoadMs = diag.lastLoadDurationMs;\\n      telemetry.cachedAssetCount = diag.cachedResources;\\n      perfRef.current.frames = 0;\\n      perfRef.current.elapsed = 0;\\n    }\\n\\n    if (phase === \'playing\') {\\n      const snapshot = input.consumeSnapshot();\\n      const playerAlive = !combat.playerHealth.isDestroyed;\\n\\n      if (playerAlive) {\\n        flight.update(dt, snapshot, settings, telemetry);\\n\\n        if (flight.getBoostJustEngaged()) {\\n          AudioManager.playBoostEngage();\\n        }\\n      }\\n\\n      // Advance chase camera first so 3D-to-HUD projections match the exact camera frame\\n      if (camera instanceof THREE.PerspectiveCamera) {\\n        cameraController.updateChase(\\n          dt,\\n          flight,\\n          camera,\\n          settings,\\n          playerAlive ? telemetry.boostIntensity : 0,\\n          state.clock.elapsedTime,\\n          combat.getCameraImpulse(),\\n        );\\n        camera.updateMatrixWorld();\\n      }\\n\\n      // Advance combat simulation (weapons, projectiles, AI, collisions, HUD projections)\\n      combat.update(\\n        dt,\\n        flight,\\n        snapshot,\\n        telemetry,\\n        camera instanceof THREE.PerspectiveCamera ? camera : undefined,\\n      );\\n\\n      // Advance mission objectives, wave triggers, and completion detection\\n      missionManager.update(dt, combat, flight.position);\\n\\n      if (shipRootRef.current) {\\n        shipRootRef.current.visible = playerAlive;\\n        shipRootRef.current.position.copy(flight.position);\\n        shipRootRef.current.quaternion.copy(flight.quaternion);\\n      }\\n      if (shipBankRef.current) {\\n        shipBankRef.current.rotation.set(0, 0, flight.visualBankAngle);\\n      }\\n\\n      if (muzzleLeftRef.current) {\\n        const ml = telemetry.muzzleFlashLeft / 0.065;\\n        muzzleLeftRef.current.visible = playerAlive && ml > 0.02;\\n        muzzleMatLeft.opacity = Math.min(1, ml * 1.15);\\n        muzzleLeftRef.current.scale.setScalar(1.3 + ml * 2.1);\\n      }\\n      if (muzzleRightRef.current) {\\n        const mr = telemetry.muzzleFlashRight / 0.065;\\n        muzzleRightRef.current.visible = playerAlive && mr > 0.02;\\n        muzzleMatRight.opacity = Math.min(1, mr * 1.15);\\n        muzzleRightRef.current.scale.setScalar(1.3 + mr * 2.1);\\n      }\\n\\n      const speedRatio = telemetry.speed / Math.max(telemetry.maxSpeed, 1);\\n      shipHandle.updateVisuals(\\n        dt,\\n        speedRatio,\\n        telemetry.boostIntensity,\\n        telemetry.yawRate,\\n        telemetry.pitchRate,\\n        telemetry.rollRate,\\n      );\\n\\n      if (playerAlive) {\\n        AudioManager.updateFlightAudio(speedRatio, telemetry.boostIntensity, telemetry.throttle);\\n      } else {\\n        AudioManager.setFlightAudioActive(false);\\n      }\\n      return;\\n    }\\n\\n    if (phase === \'paused\' || phase === \'results\') {\\n      if (shipRootRef.current) {\\n        shipRootRef.current.visible = !combat.playerHealth.isDestroyed;\\n        shipRootRef.current.position.copy(flight.position);\\n        shipRootRef.current.quaternion.copy(flight.quaternion);\\n      }\\n      shipHandle.updateVisuals(dt * 0.25, 0.2, 0, 0, 0, 0);\\n      return;\\n    }\\n\\n    // Menu, Hangar, Mission Select, or Loading showcase mode\\n    const t = state.clock.elapsedTime;\\n    const hoverY = _showcaseOrigin.y + Math.sin(t * 1.15) * 0.28;\\n\\n    if (shipRootRef.current) {\\n      shipRootRef.current.visible = true;\\n      shipRootRef.current.position.set(_showcaseOrigin.x, hoverY, _showcaseOrigin.z);\\n      shipRootRef.current.quaternion.setFromEuler(\\n        new THREE.Euler(Math.sin(t * 0.7) * 0.04, 0, Math.cos(t * 0.85) * 0.06),\\n      );\\n    }\\n    if (shipBankRef.current) {\\n      shipBankRef.current.rotation.set(0, 0, 0);\\n    }\\n    if (muzzleLeftRef.current) muzzleLeftRef.current.visible = false;\\n    if (muzzleRightRef.current) muzzleRightRef.current.visible = false;\\n\\n    shipHandle.updateVisuals(dt, 0.32, menuSection === \'hangar\' ? 0.18 : 0.12, 0, 0, 0);\\n\\n    if (camera instanceof THREE.PerspectiveCamera) {\\n      const mode = menuSection === \'hangar\' ? \'hangar\' : \'menu\';\\n      cameraController.updateShowcase(\\n        dt,\\n        _showcaseOrigin,\\n        camera,\\n        mode,\\n        mode === \'hangar\' ? hangarOrbitRef.current.yaw : 0,\\n        mode === \'hangar\' ? hangarOrbitRef.current.pitch : 0,\\n      );\\n    }\\n  });\\n\\n  const combatVisible = phase === \'playing\' || phase === \'paused\' || phase === \'results\';\\n\\n  return (\\n    <>\\n      <SpaceEnvironment graphics={graphics} theme={missionTheme} />\\n\\n      <group ref={shipRootRef} position={[0, 12, 40]}>\\n        <group ref={shipBankRef}>\\n          <primitive object={shipHandle.group} />\\n          <sprite\\n            ref={muzzleLeftRef}\\n            material={muzzleMatLeft}\\n            position={[-1.48, -0.14, -1.75]}\\n            visible={false}\\n          />\\n          <sprite\\n            ref={muzzleRightRef}\\n            material={muzzleMatRight}\\n            position={[1.48, -0.14, -1.75]}\\n            visible={false}\\n          />\\n        </group>\\n      </group>\\n\\n      <EnemyShipRenderer\\n        combat={combat}\\n        visible={combatVisible}\\n        graphics={graphics}\\n        playerPosition={flight.position}\\n      />\\n\\n      <CombatVFX\\n        ref={vfxRef}\\n        combat={combat}\\n        telemetryRef={telemetryRef}\\n        active={combatVisible}\\n        graphics={graphics}\\n      />\\n\\n      <SpeedLinesVFX\\n        flight={flight}\\n        telemetryRef={telemetryRef}\\n        count={graphics.speedLineCount}\\n        active={phase === \'playing\' && !combat.playerHealth.isDestroyed}\\n      />\\n    </>\\n  );\\n}\\n\", \"Description\":\"Integrate MissionManager, mission environment themes, adaptive graphics LOD, and asset diagnostics into GameScene\", \"Overwrite\":true, \"TargetFile\":\"/src/scene/GameScene.tsx\", \"toolAction\":\"Updating GameScene for Phase 3 missions and perf\", \"toolSummary\":\"Update GameScene for missions and perf\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_13163534334258666334"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useCallback, useState } from \'react\';\\nimport { Canvas } from \'@react-three/fiber\';\\nimport * as THREE from \'three\';\\nimport type { GraphicsPreset } from \'../config/graphics\';\\nimport type { CombatManager } from \'../engine/combat/CombatManager\';\\nimport type { FlightController } from \'../engine/FlightController\';\\nimport type { InputManager } from \'../engine/InputManager\';\\nimport type { MissionManager } from \'../engine/mission/MissionManager\';\\nimport type {\\n  FlightTelemetry,\\n  GamePhase,\\n  GameSettings,\\n  MenuSection,\\n  ShipId,\\n} from \'../types/game\';\\nimport type { MissionEnvironmentTheme } from \'../types/mission\';\\nimport { GameScene } from \'./GameScene\';\\n\\ninterface FlightCanvasProps {\\n  phase: GamePhase;\\n  menuSection: MenuSection;\\n  activeShipId: ShipId;\\n  hangarShipId: ShipId;\\n  flight: FlightController;\\n  combat: CombatManager;\\n  missionManager: MissionManager;\\n  missionTheme: MissionEnvironmentTheme;\\n  input: InputManager;\\n  settingsRef: React.MutableRefObject<GameSettings>;\\n  telemetryRef: React.MutableRefObject<FlightTelemetry>;\\n  graphics: GraphicsPreset;\\n  hangarOrbitRef: React.MutableRefObject<{ yaw: number; pitch: number }>;\\n  snapCameraSignal: number;\\n  onCanvasReady: (canvas: HTMLCanvasElement) => void;\\n  onCanvasClick: () => void;\\n  onPlayerDestroyed: () => void;\\n}\\n\\nexport function FlightCanvas({\\n  phase,\\n  menuSection,\\n  activeShipId,\\n  hangarShipId,\\n  flight,\\n  combat,\\n  missionManager,\\n  missionTheme,\\n  input,\\n  settingsRef,\\n  telemetryRef,\\n  graphics,\\n  hangarOrbitRef,\\n  snapCameraSignal,\\n  onCanvasReady,\\n  onCanvasClick,\\n  onPlayerDestroyed,\\n}: FlightCanvasProps) {\\n  const [contextLost, setContextLost] = useState(false);\\n\\n  const handleCreated = useCallback(\\n    ({ gl }: { gl: THREE.WebGLRenderer }) => {\\n      const dom = gl.domElement;\\n      onCanvasReady(dom);\\n\\n      const onLost = (e: Event) => {\\n        e.preventDefault();\\n        setContextLost(true);\\n      };\\n      const onRestored = () => {\\n        setContextLost(false);\\n      };\\n\\n      dom.addEventListener(\'webglcontextlost\', onLost, false);\\n      dom.addEventListener(\'webglcontextrestored\', onRestored, false);\\n    },\\n    [onCanvasReady],\\n  );\\n\\n  if (contextLost) {\\n    return (\\n      <div className=\\\"fixed inset-0 flex items-center justify-center bg-[#030712] text-slate-200\\\">\\n        <div className=\\\"max-w-md border border-cyan-500/30 bg-[#071124] px-8 py-6 text-center\\\">\\n          <h2 className=\\\"font-display text-xl font-semibold tracking-wider text-cyan-300\\\">\\n            Graphics Context Interrupted\\n          </h2>\\n          <p className=\\\"mt-2 text-sm text-slate-400\\\">\\n            WebGL rendering was temporarily suspended by the browser. Reload the page to restore the 3D viewport.\\n          </p>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => window.location.reload()}\\n            className=\\\"mt-5 bg-cyan-500 px-5 py-2 text-sm font-semibold text-slate-950 transition-colors hover:bg-cyan-400\\\"\\n          >\\n            Reload Simulation\\n          </button>\\n        </div>\\n      </div>\\n    );\\n  }\\n\\n  return (\\n    <div\\n      className=\\\"fixed inset-0 h-full w-full bg-[#030712]\\\"\\n      onMouseDown={(e) => {\\n        if (phase === \'playing\' && e.button === 0) {\\n          onCanvasClick();\\n        }\\n      }}\\n    >\\n      <Canvas\\n        shadows={graphics.shadows}\\n        dpr={graphics.dprCap}\\n        camera={{ fov: 62, near: 0.25, far: graphics.drawDistance, position: [0, 16, 52] }}\\n        gl={{\\n          antialias: graphics.antialias,\\n          powerPreference: \'high-performance\',\\n          toneMapping: THREE.ACESFilmicToneMapping,\\n          toneMappingExposure: 1.12,\\n          outputColorSpace: THREE.SRGBColorSpace,\\n        }}\\n        onCreated={handleCreated}\\n      >\\n        <GameScene\\n          phase={phase}\\n          menuSection={menuSection}\\n          activeShipId={activeShipId}\\n          hangarShipId={hangarShipId}\\n          flight={flight}\\n          combat={combat}\\n          missionManager={missionManager}\\n          missionTheme={missionTheme}\\n          input={input}\\n          settingsRef={settingsRef}\\n          telemetryRef={telemetryRef}\\n          graphics={graphics}\\n          hangarOrbitRef={hangarOrbitRef}\\n          snapCameraSignal={snapCameraSignal}\\n          onPlayerDestroyed={onPlayerDestroyed}\\n        />\\n      </Canvas>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Wire MissionManager, missionTheme, and resolution-scaled DPR into FlightCanvas\", \"Overwrite\":true, \"TargetFile\":\"/src/scene/FlightCanvas.tsx\", \"toolAction\":\"Updating FlightCanvas props and DPR scaling\", \"toolSummary\":\"Update FlightCanvas props and DPR\"}"
      original_name: "write_to_file"
    }
