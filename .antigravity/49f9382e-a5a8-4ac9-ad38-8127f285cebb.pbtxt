  planner_response {
    thinking: "**Connecting Game Systems**\n\nI\'m currently integrating the combat-related systems. My focus right now is on cleanly wiring the `CombatManager` with the player\'s ship and enemy rendering. I\'m updating `GameScene.tsx` to handle the player and enemy laser audio callbacks and visual effects and attach the muzzle flashes directly to the ship group.\n\n\n**Refining Audio & Visuals**\n\nI\'m now focusing on audio and visual feedback. I\'m implementing callbacks for impact hits, player damage, and explosions, and integrating the camera for accurate 3D-to-HUD projections. I\'m also ensuring the player fighter mesh is hidden when destroyed. The next step is a clean integration of the `combat` prop in `FlightCanvas.tsx` to call the `onPlayerDestroyed` callback when the player\'s hull reaches zero. I\'m also updating the DOM-ref HUD.\n\n\n"
    message_id: "Rgn_apK7FueKmtkPpa7P8QM"
    tool_calls {
      id: "call_642785314080585201"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Integrate CombatManager, EnemyShipRenderer, CombatVFX, player muzzle flash sprites, and combat audio hooks into GameScene\", \"EndLine\":196, \"Instruction\":\"Wire CombatManager into GameScene useFrame loop and render EnemyShipRenderer, CombatVFX, and wing muzzle flashes\", \"ReplacementContent\":\"import { useEffect, useMemo, useRef } from \'react\';\\nimport { useFrame, useThree } from \'@react-three/fiber\';\\nimport * as THREE from \'three\';\\nimport { AudioManager } from \'../audio/AudioManager\';\\nimport type { GraphicsPreset } from \'../config/graphics\';\\nimport { SHIP_CONFIGS } from \'../config/ships\';\\nimport { AssetManager } from \'../engine/AssetManager\';\\nimport { CameraController } from \'../engine/CameraController\';\\nimport { PLAYER_ENTITY_ID, type CombatManager } from \'../engine/combat/CombatManager\';\\nimport type { FlightController } from \'../engine/FlightController\';\\nimport type { InputManager } from \'../engine/InputManager\';\\nimport type {\\n  FlightTelemetry,\\n  GamePhase,\\n  GameSettings,\\n  MenuSection,\\n  ShipId,\\n} from \'../types/game\';\\nimport { CombatVFX, type CombatVFXHandle } from \'./CombatVFX\';\\nimport { EnemyShipRenderer } from \'./EnemyShipRenderer\';\\nimport { buildShipModel } from \'./shipGeometry\';\\nimport { SpaceEnvironment } from \'./SpaceEnvironment\';\\nimport { SpeedLinesVFX } from \'./SpeedLinesVFX\';\\n\\ninterface GameSceneProps {\\n  phase: GamePhase;\\n  menuSection: MenuSection;\\n  activeShipId: ShipId;\\n  hangarShipId: ShipId;\\n  flight: FlightController;\\n  combat: CombatManager;\\n  input: InputManager;\\n  settingsRef: React.MutableRefObject<GameSettings>;\\n  telemetryRef: React.MutableRefObject<FlightTelemetry>;\\n  graphics: GraphicsPreset;\\n  hangarOrbitRef: React.MutableRefObject<{ yaw: number; pitch: number }>;\\n  snapCameraSignal: number;\\n  onPlayerDestroyed: () => void;\\n}\\n\\nconst _showcaseOrigin = new THREE.Vector3(0, 12, 40);\\n\\nexport function GameScene({\\n  phase,\\n  menuSection,\\n  activeShipId,\\n  hangarShipId,\\n  flight,\\n  combat,\\n  input,\\n  settingsRef,\\n  telemetryRef,\\n  graphics,\\n  hangarOrbitRef,\\n  snapCameraSignal,\\n  onPlayerDestroyed,\\n}: GameSceneProps) {\\n  const { camera, gl } = useThree();\\n  const shipRootRef = useRef<THREE.Group>(null);\\n  const shipBankRef = useRef<THREE.Group>(null);\\n  const muzzleLeftRef = useRef<THREE.Sprite>(null);\\n  const muzzleRightRef = useRef<THREE.Sprite>(null);\\n  const vfxRef = useRef<CombatVFXHandle>(null);\\n  const cameraController = useMemo(() => new CameraController(), []);\\n  const textures = useMemo(() => AssetManager.getCoreTextures(), []);\\n\\n  // Display the inspected ship while in Hangar, otherwise the active flight ship\\n  const displayedShipId = phase === \'menu\' && menuSection === \'hangar\' ? hangarShipId : activeShipId;\\n  const displayedShipConfig = SHIP_CONFIGS[displayedShipId];\\n\\n  const shipHandle = useMemo(() => buildShipModel(displayedShipConfig), [displayedShipConfig]);\\n\\n  const muzzleMatLeft = useMemo(\\n    () =>\\n      new THREE.SpriteMaterial({\\n        map: textures.glowSprite,\\n        color: \'#67e8f9\',\\n        transparent: true,\\n        opacity: 0,\\n        blending: THREE.AdditiveBlending,\\n        depthWrite: false,\\n      }),\\n    [textures.glowSprite],\\n  );\\n\\n  const muzzleMatRight = useMemo(\\n    () =>\\n      new THREE.SpriteMaterial({\\n        map: textures.glowSprite,\\n        color: \'#67e8f9\',\\n        transparent: true,\\n        opacity: 0,\\n        blending: THREE.AdditiveBlending,\\n        depthWrite: false,\\n      }),\\n    [textures.glowSprite],\\n  );\\n\\n  useEffect(() => {\\n    return () => {\\n      shipHandle.dispose();\\n    };\\n  }, [shipHandle]);\\n\\n  useEffect(() => {\\n    return () => {\\n      muzzleMatLeft.dispose();\\n      muzzleMatRight.dispose();\\n    };\\n  }, [muzzleMatLeft, muzzleMatRight]);\\n\\n  // Wire CombatManager callbacks to procedural audio & pooled 3D VFX\\n  useEffect(() => {\\n    combat.setCallbacks({\\n      onPlayerFire: () => {\\n        AudioManager.playPlayerLaser();\\n      },\\n      onEnemyFire: (evt) => {\\n        const dist = flight.position.distanceTo(evt.origin);\\n        AudioManager.playEnemyLaser(dist);\\n      },\\n      onDamage: (evt) => {\\n        if (evt.targetId === PLAYER_ENTITY_ID) {\\n          AudioManager.playPlayerDamage();\\n        } else {\\n          AudioManager.playImpactHit(evt.destroyed);\\n        }\\n      },\\n      onDestruction: (evt) => {\\n        const dist = flight.position.distanceTo(evt.position);\\n        AudioManager.playExplosion(dist);\\n        if (evt.entityId === PLAYER_ENTITY_ID) {\\n          onPlayerDestroyed();\\n        }\\n      },\\n      onVfxBurst: (evt) => {\\n        vfxRef.current?.spawnBurst(evt);\\n      },\\n    });\\n  }, [combat, flight, onPlayerDestroyed]);\\n\\n  // Snap chase camera and clear transient VFX when starting or resetting a session\\n  useEffect(() => {\\n    vfxRef.current?.clear();\\n    if (phase === \'playing\' && camera instanceof THREE.PerspectiveCamera) {\\n      cameraController.snapToShip(flight, camera, settingsRef.current.cameraDistance);\\n    }\\n  }, [snapCameraSignal, phase, camera, cameraController, flight, settingsRef]);\\n\\n  // Sync camera draw distance when graphics quality changes\\n  useEffect(() => {\\n    if (camera instanceof THREE.PerspectiveCamera) {\\n      camera.far = graphics.drawDistance;\\n      camera.updateProjectionMatrix();\\n    }\\n  }, [camera, graphics.drawDistance]);\\n\\n  // Lightweight rolling FPS / frame-time accumulator (writes to mutable telemetry ref)\\n  const perfRef = useRef({ frames: 0, elapsed: 0 });\\n\\n  useFrame((state, delta) => {\\n    const dt = Math.min(delta, 0.05);\\n    const telemetry = telemetryRef.current;\\n    const settings = settingsRef.current;\\n\\n    // Performance metrics update (every 250ms, zero React re-renders)\\n    perfRef.current.frames += 1;\\n    perfRef.current.elapsed += delta;\\n    if (perfRef.current.elapsed >= 0.25) {\\n      const avgFrameSec = perfRef.current.elapsed / perfRef.current.frames;\\n      telemetry.fps = Math.round(1 / Math.max(avgFrameSec, 0.001));\\n      telemetry.frameTimeMs = avgFrameSec * 1000;\\n      telemetry.drawCalls = gl.info.render.calls;\\n      telemetry.triangles = gl.info.render.triangles;\\n      perfRef.current.frames = 0;\\n      perfRef.current.elapsed = 0;\\n    }\\n\\n    if (phase === \'playing\') {\\n      const snapshot = input.consumeSnapshot();\\n      const playerAlive = !combat.playerHealth.isDestroyed;\\n\\n      if (playerAlive) {\\n        flight.update(dt, snapshot, settings, telemetry);\\n\\n        if (flight.getBoostJustEngaged()) {\\n          AudioManager.playBoostEngage();\\n        }\\n      }\\n\\n      // Advance chase camera first so 3D-to-HUD projections match the exact camera frame\\n      if (camera instanceof THREE.PerspectiveCamera) {\\n        cameraController.updateChase(\\n          dt,\\n          flight,\\n          camera,\\n          settings,\\n          playerAlive ? telemetry.boostIntensity : 0,\\n          state.clock.elapsedTime,\\n          combat.getCameraImpulse(),\\n        );\\n        camera.updateMatrixWorld();\\n      }\\n\\n      // Advance combat simulation (weapons, projectiles, AI, collisions, HUD projections)\\n      combat.update(\\n        dt,\\n        flight,\\n        snapshot,\\n        telemetry,\\n        camera instanceof THREE.PerspectiveCamera ? camera : undefined,\\n      );\\n\\n      if (shipRootRef.current) {\\n        shipRootRef.current.visible = playerAlive;\\n        shipRootRef.current.position.copy(flight.position);\\n        shipRootRef.current.quaternion.copy(flight.quaternion);\\n      }\\n      if (shipBankRef.current) {\\n        shipBankRef.current.rotation.set(0, 0, flight.visualBankAngle);\\n      }\\n\\n      // Muzzle flash flare sprites on left/right wing cannons\\n      if (muzzleLeftRef.current) {\\n        const ml = telemetry.muzzleFlashLeft / 0.065;\\n        muzzleLeftRef.current.visible = playerAlive && ml > 0.02;\\n        muzzleMatLeft.opacity = Math.min(1, ml * 1.15);\\n        muzzleLeftRef.current.scale.setScalar(1.3 + ml * 2.1);\\n      }\\n      if (muzzleRightRef.current) {\\n        const mr = telemetry.muzzleFlashRight / 0.065;\\n        muzzleRightRef.current.visible = playerAlive && mr > 0.02;\\n        muzzleMatRight.opacity = Math.min(1, mr * 1.15);\\n        muzzleRightRef.current.scale.setScalar(1.3 + mr * 2.1);\\n      }\\n\\n      const speedRatio = telemetry.speed / Math.max(telemetry.maxSpeed, 1);\\n      shipHandle.updateVisuals(\\n        dt,\\n        speedRatio,\\n        telemetry.boostIntensity,\\n        telemetry.yawRate,\\n        telemetry.pitchRate,\\n        telemetry.rollRate,\\n      );\\n\\n      if (playerAlive) {\\n        AudioManager.updateFlightAudio(speedRatio, telemetry.boostIntensity, telemetry.throttle);\\n      } else {\\n        AudioManager.setFlightAudioActive(false);\\n      }\\n      return;\\n    }\\n\\n    if (phase === \'paused\') {\\n      if (shipRootRef.current) {\\n        shipRootRef.current.visible = !combat.playerHealth.isDestroyed;\\n        shipRootRef.current.position.copy(flight.position);\\n        shipRootRef.current.quaternion.copy(flight.quaternion);\\n      }\\n      shipHandle.updateVisuals(dt * 0.25, 0.2, 0, 0, 0, 0);\\n      return;\\n    }\\n\\n    // Menu, Hangar, or Loading showcase mode\\n    const t = state.clock.elapsedTime;\\n    const hoverY = _showcaseOrigin.y + Math.sin(t * 1.15) * 0.28;\\n\\n    if (shipRootRef.current) {\\n      shipRootRef.current.visible = true;\\n      shipRootRef.current.position.set(_showcaseOrigin.x, hoverY, _showcaseOrigin.z);\\n      shipRootRef.current.quaternion.setFromEuler(\\n        new THREE.Euler(Math.sin(t * 0.7) * 0.04, 0, Math.cos(t * 0.85) * 0.06),\\n      );\\n    }\\n    if (shipBankRef.current) {\\n      shipBankRef.current.rotation.set(0, 0, 0);\\n    }\\n    if (muzzleLeftRef.current) muzzleLeftRef.current.visible = false;\\n    if (muzzleRightRef.current) muzzleRightRef.current.visible = false;\\n\\n    shipHandle.updateVisuals(dt, 0.32, menuSection === \'hangar\' ? 0.18 : 0.12, 0, 0, 0);\\n\\n    if (camera instanceof THREE.PerspectiveCamera) {\\n      const mode = menuSection === \'hangar\' ? \'hangar\' : \'menu\';\\n      cameraController.updateShowcase(\\n        dt,\\n        _showcaseOrigin,\\n        camera,\\n        mode,\\n        mode === \'hangar\' ? hangarOrbitRef.current.yaw : 0,\\n        mode === \'hangar\' ? hangarOrbitRef.current.pitch : 0,\\n      );\\n    }\\n  });\\n\\n  const combatVisible = phase === \'playing\' || phase === \'paused\';\\n\\n  return (\\n    <>\\n      <SpaceEnvironment graphics={graphics} />\\n\\n      <group ref={shipRootRef} position={[0, 12, 40]}>\\n        <group ref={shipBankRef}>\\n          <primitive object={shipHandle.group} />\\n          <sprite\\n            ref={muzzleLeftRef}\\n            material={muzzleMatLeft}\\n            position={[-1.48, -0.14, -1.75]}\\n            visible={false}\\n          />\\n          <sprite\\n            ref={muzzleRightRef}\\n            material={muzzleMatRight}\\n            position={[1.48, -0.14, -1.75]}\\n            visible={false}\\n          />\\n        </group>\\n      </group>\\n\\n      <EnemyShipRenderer combat={combat} visible={combatVisible} />\\n\\n      <CombatVFX\\n        ref={vfxRef}\\n        combat={combat}\\n        telemetryRef={telemetryRef}\\n        active={combatVisible}\\n      />\\n\\n      <SpeedLinesVFX\\n        flight={flight}\\n        telemetryRef={telemetryRef}\\n        count={graphics.speedLineCount}\\n        active={phase === \'playing\' && !combat.playerHealth.isDestroyed}\\n      />\\n    </>\\n  );\\n}\", \"StartLine\":1, \"TargetContent\":\"import { useEffect, useMemo, useRef } from \'react\';\\nimport { useFrame, useThree } from \'@react-three/fiber\';\\nimport * as THREE from \'three\';\\nimport { AudioManager } from \'../audio/AudioManager\';\\nimport type { GraphicsPreset } from \'../config/graphics\';\\nimport { SHIP_CONFIGS } from \'../config/ships\';\\nimport { CameraController } from \'../engine/CameraController\';\\nimport type { FlightController } from \'../engine/FlightController\';\\nimport type { InputManager } from \'../engine/InputManager\';\\nimport type {\\n  FlightTelemetry,\\n  GamePhase,\\n  GameSettings,\\n  MenuSection,\\n  ShipId,\\n} from \'../types/game\';\\nimport { buildShipModel } from \'./shipGeometry\';\\nimport { SpaceEnvironment } from \'./SpaceEnvironment\';\\nimport { SpeedLinesVFX } from \'./SpeedLinesVFX\';\\n\\ninterface GameSceneProps {\\n  phase: GamePhase;\\n  menuSection: MenuSection;\\n  activeShipId: ShipId;\\n  hangarShipId: ShipId;\\n  flight: FlightController;\\n  input: InputManager;\\n  settingsRef: React.MutableRefObject<GameSettings>;\\n  telemetryRef: React.MutableRefObject<FlightTelemetry>;\\n  graphics: GraphicsPreset;\\n  hangarOrbitRef: React.MutableRefObject<{ yaw: number; pitch: number }>;\\n  snapCameraSignal: number;\\n}\\n\\nconst _showcaseOrigin = new THREE.Vector3(0, 12, 40);\\n\\nexport function GameScene({\\n  phase,\\n  menuSection,\\n  activeShipId,\\n  hangarShipId,\\n  flight,\\n  input,\\n  settingsRef,\\n  telemetryRef,\\n  graphics,\\n  hangarOrbitRef,\\n  snapCameraSignal,\\n}: GameSceneProps) {\\n  const { camera, gl } = useThree();\\n  const shipRootRef = useRef<THREE.Group>(null);\\n  const shipBankRef = useRef<THREE.Group>(null);\\n  const cameraController = useMemo(() => new CameraController(), []);\\n\\n  // Display the inspected ship while in Hangar, otherwise the active flight ship\\n  const displayedShipId = phase === \'menu\' && menuSection === \'hangar\' ? hangarShipId : activeShipId;\\n  const displayedShipConfig = SHIP_CONFIGS[displayedShipId];\\n\\n  const shipHandle = useMemo(() => buildShipModel(displayedShipConfig), [displayedShipConfig]);\\n\\n  useEffect(() => {\\n    return () => {\\n      shipHandle.dispose();\\n    };\\n  }, [shipHandle]);\\n\\n  // Snap chase camera cleanly when starting a new flight session\\n  useEffect(() => {\\n    if (phase === \'playing\' && camera instanceof THREE.PerspectiveCamera) {\\n      cameraController.snapToShip(flight, camera, settingsRef.current.cameraDistance);\\n    }\\n  }, [snapCameraSignal, phase, camera, cameraController, flight, settingsRef]);\\n\\n  // Sync camera draw distance when graphics quality changes\\n  useEffect(() => {\\n    if (camera instanceof THREE.PerspectiveCamera) {\\n      camera.far = graphics.drawDistance;\\n      camera.updateProjectionMatrix();\\n    }\\n  }, [camera, graphics.drawDistance]);\\n\\n  // Lightweight rolling FPS / frame-time accumulator (writes to mutable telemetry ref)\\n  const perfRef = useRef({ frames: 0, elapsed: 0 });\\n\\n  useFrame((state, delta) => {\\n    const dt = Math.min(delta, 0.05);\\n    const telemetry = telemetryRef.current;\\n    const settings = settingsRef.current;\\n\\n    // Performance metrics update (every 250ms, zero React re-renders)\\n    perfRef.current.frames += 1;\\n    perfRef.current.elapsed += delta;\\n    if (perfRef.current.elapsed >= 0.25) {\\n      const avgFrameSec = perfRef.current.elapsed / perfRef.current.frames;\\n      telemetry.fps = Math.round(1 / Math.max(avgFrameSec, 0.001));\\n      telemetry.frameTimeMs = avgFrameSec * 1000;\\n      telemetry.drawCalls = gl.info.render.calls;\\n      telemetry.triangles = gl.info.render.triangles;\\n      perfRef.current.frames = 0;\\n      perfRef.current.elapsed = 0;\\n    }\\n\\n    if (phase === \'playing\') {\\n      const snapshot = input.consumeSnapshot();\\n      flight.update(dt, snapshot, settings, telemetry);\\n\\n      if (flight.getBoostJustEngaged()) {\\n        AudioManager.playBoostEngage();\\n      }\\n\\n      if (shipRootRef.current) {\\n        shipRootRef.current.position.copy(flight.position);\\n        shipRootRef.current.quaternion.copy(flight.quaternion);\\n      }\\n      if (shipBankRef.current) {\\n        shipBankRef.current.rotation.set(0, 0, flight.visualBankAngle);\\n      }\\n\\n      const speedRatio = telemetry.speed / Math.max(telemetry.maxSpeed, 1);\\n      shipHandle.updateVisuals(\\n        dt,\\n        speedRatio,\\n        telemetry.boostIntensity,\\n        telemetry.yawRate,\\n        telemetry.pitchRate,\\n        telemetry.rollRate,\\n      );\\n\\n      AudioManager.updateFlightAudio(speedRatio, telemetry.boostIntensity, telemetry.throttle);\\n\\n      if (camera instanceof THREE.PerspectiveCamera) {\\n        cameraController.updateChase(\\n          dt,\\n          flight,\\n          camera,\\n          settings,\\n          telemetry.boostIntensity,\\n          state.clock.elapsedTime,\\n        );\\n      }\\n      return;\\n    }\\n\\n    if (phase === \'paused\') {\\n      // Freeze flight physics while keeping engine exhaust idling softly\\n      if (shipRootRef.current) {\\n        shipRootRef.current.position.copy(flight.position);\\n        shipRootRef.current.quaternion.copy(flight.quaternion);\\n      }\\n      shipHandle.updateVisuals(dt * 0.25, 0.2, 0, 0, 0, 0);\\n      return;\\n    }\\n\\n    // Menu, Hangar, or Loading showcase mode\\n    const t = state.clock.elapsedTime;\\n    const hoverY = _showcaseOrigin.y + Math.sin(t * 1.15) * 0.28;\\n\\n    if (shipRootRef.current) {\\n      shipRootRef.current.position.set(_showcaseOrigin.x, hoverY, _showcaseOrigin.z);\\n      shipRootRef.current.quaternion.setFromEuler(\\n        new THREE.Euler(Math.sin(t * 0.7) * 0.04, 0, Math.cos(t * 0.85) * 0.06),\\n      );\\n    }\\n    if (shipBankRef.current) {\\n      shipBankRef.current.rotation.set(0, 0, 0);\\n    }\\n\\n    shipHandle.updateVisuals(dt, 0.32, menuSection === \'hangar\' ? 0.18 : 0.12, 0, 0, 0);\\n\\n    if (camera instanceof THREE.PerspectiveCamera) {\\n      const mode = menuSection === \'hangar\' ? \'hangar\' : \'menu\';\\n      cameraController.updateShowcase(\\n        dt,\\n        _showcaseOrigin,\\n        camera,\\n        mode,\\n        mode === \'hangar\' ? hangarOrbitRef.current.yaw : 0,\\n        mode === \'hangar\' ? hangarOrbitRef.current.pitch : 0,\\n      );\\n    }\\n  });\\n\\n  return (\\n    <>\\n      <SpaceEnvironment graphics={graphics} />\\n\\n      <group ref={shipRootRef} position={[0, 12, 40]}>\\n        <group ref={shipBankRef}>\\n          <primitive object={shipHandle.group} />\\n        </group>\\n      </group>\\n\\n      <SpeedLinesVFX\\n        flight={flight}\\n        telemetryRef={telemetryRef}\\n        count={graphics.speedLineCount}\\n        active={phase === \'playing\'}\\n      />\\n    </>\\n  );\\n}\", \"TargetFile\":\"/src/scene/GameScene.tsx\", \"toolAction\":\"Updating GameScene with combat loop\", \"toolSummary\":\"Update src/scene/GameScene.tsx\"}"
      thinking_signature: "\022\237\025\n\234\025\001i\024}\023\201\027N8\320\340\334G\\TZ\251-\032\350P$h{\371|\255\244r\\\377\236\275\211\t\271T\334\270$\247\r)2\310\300;Mq\357\237$\223o\2063\232\230\t\372UL\204k\257\270y\3049&+\354\332\300^\344\315\265\233\001I\257\360s\273\306\220\266\357\004gs\022\020\341&y=\311|\310=\324\265\226\223\246L\300?\361R{SP\312\316\221\302-\207L\235\324\335 3~83\345\212\020(\372 \271\224Hf\373\314\006ee\265Ww\237R\024\022\341^Q\366\234\231\037=\276.\354\021b\255^\347\270\204t\227\b\277`\313\226D\364\223E\216\316\260\204\357\f?\312\303\t\262\016\253\265\342\255gX5\331\313p~b\325P\034\201\246g9\326 9\271\033\253\312-)m\225\227\037<E\n\036\025\347 \260\270R$\255S+\303)\371sP8\212Sz\212\314\017\362\245\352\316.\317\2143\310\302\375\216\362\336\003\261\325\a\237\261\215\225\034\360`=Ix\342x:2\314\341EH\241JC\r/\237>\373\270q\307S\036\016\307ou\203}\207X4\306\f\354\200\2759\3755:x`\021<\236K\2352,\223\027\250T\307\362\361\271\302\251K7\307\313\202Mt\002\006GH\217\224>\231\342c\251\025#gq\2632Z\001\326\001\350\211H\225\306k\266\227\311\377\246\306X+;\270\226u\240\001\353\334\004\234\220\033\377[\"\2237V\257T\245\264\001\002\227f\242\250#\247D\376y\v\316\001sQq1\342\354\233n\362\0235\001gB\017;<\346\002]\264n\333\252\266\035\003\270\201H\374\353\322\246\334o\300:\367E\232\265\354=\321\354;\220i\004p(\254\245\3777\005=\365\275\327\221\304m\234\257q\332\032\354S\021\335\321 \245\'@\322\036\003\364\001\354\3617\326\343\257\005Z*&h6\236\\^\277C\200\211\245\361\373\223\027\322\354\276\3537%\207\327\267v+\317M\2500\376 \360mIx\242\346\305\000\217\374\324\v\242\032\325\017:|\r\371L\037\017 +v\334\206\304\\\352\371\366s\373W\251\363\'\272~\364\355\270;I\246IR1\206\251Y\020(\275\377x\312\034\346\374@\260 V\263\367xAb8a\035\340\204\311\311\306\216\311+\327q)\202\360\330\300\220\313\255\331\221etI\355b\253\265\350D\353\347Ff\304$\350\311\235\332!\035\305\312\022\034]\336_\036\213\032W\304\231\t?\267\a\250\246Z\362d\365\315\273_\v\227\"\006\037\305\006X