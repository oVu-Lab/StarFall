    content: "import type { MissionDefinition } from \'../types/mission\';\n\nexport const CAMPAIGN_MISSIONS: MissionDefinition[] = [\n  {\n    id: \'mission-01\',\n    number: 1,\n    code: \'M-01\',\n    name: \'First Contact\',\n    subtitle: \'Aurelia Outer Rim\',\n    description:\n      \'Two hostile scouts have breached the outer relay corridor. Acquire targets, test your twin pulse cannons, and neutralize both bogeys.\',\n    difficulty: \'rookie\',\n    difficultyNumeric: 1,\n    parTimeSec: 65,\n    unlockRequirementId: null,\n    rewardLabel: \'Unlocks Mission 02 \342\200\224 Hostile Squadron\',\n    totalEnemyCount: 2,\n    environment: {\n      id: \'aurelia-rim\',\n      sectorName: \'Aurelia Outer Rim\',\n      nebulaVoid: [0.012, 0.024, 0.058],\n      nebulaMid: [0.032, 0.088, 0.215],\n      nebulaIon: [0.045, 0.42, 0.64],\n      fogColor: \'#040a18\',\n      keyLightColor: \'#f8fafc\',\n      hemiSkyColor: \'#38bdf8\',\n      rimLightColor: \'#0ea5e9\',\n      planetBands: [\'#071024\', \'#1e3a5f\', \'#6fa3c7\', \'#132a4f\'],\n      atmosphereColor: \'#38bdf8\',\n      asteroidTint: \'#94a3b8\',\n      beaconColor: \'#22d3ee\',\n    },\n    waves: [\n      {\n        waveNumber: 1,\n        label: \'Scout Pair\',\n        triggerDelaySec: 0,\n        enemies: [\n          {\n            callsign: \'VEX-01\',\n            shipId: \'striker\',\n            personality: \'aggressor\',\n            offset: [-55, 12, -210],\n          },\n          {\n            callsign: \'VEX-02\',\n            shipId: \'striker\',\n            personality: \'aggressor\',\n            offset: [62, -10, -245],\n          },\n        ],\n      },\n    ],\n    objectives: [\n      {\n        id: \'m1-elim\',\n        type: \'eliminate_all\',\n        label: \'Eliminate hostile scouts\',\n        targetCount: 2,\n      },\n    ],\n  },\n  {\n    id: \'mission-02\',\n    number: 2,\n    code: \'M-02\',\n    name: \'Hostile Squadron\',\n    subtitle: \'Cobalt Drift\',\n    description:\n      \'A four-ship interceptor squadron has formed a defensive screen. Break their formation as aggressors push forward while flankers and a defender cover their angles.\',\n    difficulty: \'normal\',\n    difficultyNumeric: 2,\n    parTimeSec: 95,\n    unlockRequirementId: \'mission-01\',\n    rewardLabel: \'Unlocks Mission 03 \342\200\224 Ambush\',\n    totalEnemyCount: 4,\n    environment: {\n      id: \'cobalt-drift\',\n      sectorName: \'Cobalt Drift\',\n      nebulaVoid: [0.01, 0.022, 0.068],\n      nebulaMid: [0.024, 0.115, 0.26],\n      nebulaIon: [0.06, 0.54, 0.68],\n      fogColor: \'#040c1f\',\n      keyLightColor: \'#e0f2fe\',\n      hemiSkyColor: \'#0ea5e9\',\n      rimLightColor: \'#22d3ee\',\n      planetBands: [\'#06162e\', \'#15426b\', \'#4db8d4\', \'#0d2b4a\'],\n      atmosphereColor: \'#22d3ee\',\n      asteroidTint: \'#7dd3fc\',\n      beaconColor: \'#38bdf8\',\n    },\n    waves: [\n      {\n        waveNumber: 1,\n        label: \'Crimson Flight\',\n        triggerDelaySec: 0,\n        enemies: [\n          {\n            callsign: \'KRAKEN-1\',\n            shipId: \'striker\',\n            personality: \'aggressor\',\n            offset: [-70, 18, -230],\n          },\n          {\n            callsign: \'SHARD-2\',\n            shipId: \'interceptor\',\n            personality: \'flanker\',\n            offset: [88, -14, -240],\n          },\n          {\n            callsign: \'BASTION-3\',\n            shipId: \'destroyer\',\n            personality: \'defender\',\n            offset: [0, 32, -310],\n          },\n          {\n            callsign: \'KRAKEN-4\',\n            shipId: \'striker\',\n            personality: \'aggressor\',\n            offset: [-24, -24, -285],\n          },\n        ],\n      },\n    ],\n    objectives: [\n      {\n        id: \'m2-elim\',\n        type: \'eliminate_all\',\n        label: \'Eliminate the hostile squadron\',\n        targetCount: 4,\n      },\n    ],\n  },\n  {\n    id: \'mission-03\',\n    number: 3,\n    code: \'M-03\',\n    name: \'Ambush\',\n    subtitle: \'Cryo-Belt Sector\',\n    description:\n      \'Sensors tripped too late\342\200\224five hostile fighters are closing from multiple vectors around your ship. Use boost and barrel rolls to survive the opening encirclement and clear all hostiles.\',\n    difficulty: \'veteran\',\n    difficultyNumeric: 3,\n    parTimeSec: 120,\n    unlockRequirementId: \'mission-02\',\n    rewardLabel: \'Unlocks Mission 04 \342\200\224 Ace Hunters\',\n    totalEnemyCount: 5,\n    environment: {\n      id: \'cryo-belt\',\n      sectorName: \'Cryo-Belt Sector\',\n      nebulaVoid: [0.015, 0.02, 0.062],\n      nebulaMid: [0.055, 0.085, 0.24],\n      nebulaIon: [0.12, 0.36, 0.68],\n      fogColor: \'#05091a\',\n      keyLightColor: \'#f1f5f9\',\n      hemiSkyColor: \'#60a5fa\',\n      rimLightColor: \'#38bdf8\',\n      planetBands: [\'#0c1633\', \'#233b6e\', \'#8bb4e8\', \'#15254d\'],\n      atmosphereColor: \'#60a5fa\',\n      asteroidTint: \'#cbd5e1\',\n      beaconColor: \'#67e8f9\',\n    },\n    waves: [\n      {\n        waveNumber: 1,\n        label: \'Ambush Wing\',\n        triggerDelaySec: 0,\n        enemies: [\n          {\n            callsign: \'TALON-1\',\n            shipId: \'interceptor\',\n            personality: \'flanker\',\n            offset: [-190, 26, -70],\n          },\n          {\n            callsign: \'TALON-2\',\n            shipId: \'interceptor\',\n            personality: \'flanker\',\n            offset: [195, -18, -65],\n          },\n          {\n            callsign: \'RAVEN-3\',\n            shipId: \'striker\',\n            personality: \'aggressor\',\n            offset: [0, 125, -140],\n          },\n          {\n            callsign: \'RAVEN-4\',\n            shipId: \'striker\',\n            personality: \'aggressor\',\n            offset: [-45, -35, 165],\n          },\n          {\n            callsign: \'WARDEN-5\',\n            shipId: \'destroyer\',\n            personality: \'defender\',\n            offset: [18, 12, -280],\n          },\n        ],\n      },\n    ],\n    objectives: [\n      {\n        id: \'m3-survive\',\n        type: \'survive_duration\',\n        label: \'Survive opening ambush\',\n        targetDurationSec: 20,\n      },\n      {\n        id: \'m3-elim\',\n        type: \'eliminate_all\',\n        label: \'Eliminate all ambush hostiles\',\n        targetCount: 5,\n      },\n    ],\n  },\n  {\n    id: \'mission-04\',\n    number: 4,\n    code: \'M-04\',\n    name: \'Ace Hunters\',\n    subtitle: \'Cerulean Rift\',\n    description:\n      \'Three elite mercenary pilots have entered the rift to hunt you down. Expect high-G evasion, tight lead targeting, and relentless flanking maneuvers.\',\n    difficulty: \'expert\',\n    difficultyNumeric: 4,\n    parTimeSec: 115,\n    unlockRequirementId: \'mission-03\',\n    rewardLabel: \'Unlocks Mission 05 \342\200\224 Final Stand\',\n    totalEnemyCount: 3,\n    environment: {\n      id: \'cerulean-rift\',\n      sectorName: \'Cerulean Rift\',\n      nebulaVoid: [0.018, 0.016, 0.056],\n      nebulaMid: [0.068, 0.062, 0.24],\n      nebulaIon: [0.08, 0.48, 0.72],\n      fogColor: \'#06071a\',\n      keyLightColor: \'#f8fafc\',\n      hemiSkyColor: \'#818cf8\',\n      rimLightColor: \'#22d3ee\',\n      planetBands: [\'#111136\', \'#28336b\', \'#5ea1d8\', \'#171c47\'],\n      atmosphereColor: \'#38bdf8\',\n      asteroidTint: \'#a5b4fc\',\n      beaconColor: \'#38bdf8\',\n    },\n    waves: [\n      {\n        waveNumber: 1,\n        label: \'Hunter Triad\',\n        triggerDelaySec: 0,\n        enemies: [\n          {\n            callsign: \'SPECTER-1\',\n            shipId: \'interceptor\',\n            personality: \'ace\',\n            offset: [-95, 28, -245],\n          },\n          {\n            callsign: \'PHANTOM-2\',\n            shipId: \'interceptor\',\n            personality: \'ace\',\n            offset: [95, -22, -265],\n          },\n          {\n            callsign: \'WRAITH-3\',\n            shipId: \'striker\',\n            personality: \'flanker\',\n            offset: [0, 62, -310],\n          },\n        ],\n      },\n    ],\n    objectives: [\n      {\n        id: \'m4-elim\',\n        type: \'eliminate_all\',\n        label: \'Defeat all elite hunter pilots\',\n        targetCount: 3,\n      },\n    ],\n  },\n  {\n    id: \'mission-05\',\n    number: 5,\n    code: \'M-05\',\n    name: \'Final Stand\',\n    subtitle: \'Starfall Singularity\',\n    description:\n      \'Hold the orbital line against three escalating hostile waves culminating in an engagement with the enemy commander, Ace pilot SOVEREIGN-ONE.\',\n    difficulty: \'elite\',\n    difficultyNumeric: 5,\n    parTimeSec: 175,\n    unlockRequirementId: \'mission-04\',\n    rewardLabel: \'Campaign Victory Commendation\',\n    totalEnemyCount: 9,\n    environment: {\n      id: \'starfall-singularity\',\n      sectorName: \'Starfall Singularity\',\n      nebulaVoid: [0.016, 0.014, 0.042],\n      nebulaMid: [0.075, 0.055, 0.19],\n      nebulaIon: [0.05, 0.45, 0.68],\n      fogColor: \'#050614\',\n      keyLightColor: \'#fef3c7\',\n      hemiSkyColor: \'#38bdf8\',\n      rimLightColor: \'#f59e0b\',\n      planetBands: [\'#120f29\', \'#2b2f5c\', \'#4fa3cf\', \'#141938\'],\n      atmosphereColor: \'#06b6d4\',\n      asteroidTint: \'#94a3b8\',\n      beaconColor: \'#f59e0b\',\n    },\n    waves: [\n      {\n        waveNumber: 1,\n        label: \'Vanguard Wave\',\n        triggerDelaySec: 0,\n        enemies: [\n          {\n            callsign: \'VANGUARD-1\',\n            shipId: \'striker\',\n            personality: \'aggressor\',\n            offset: [-80, 16, -240],\n          },\n          {\n            callsign: \'VANGUARD-2\',\n            shipId: \'interceptor\',\n            personality: \'flanker\',\n            offset: [85, -14, -255],\n          },\n          {\n            callsign: \'VANGUARD-3\',\n            shipId: \'s