            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "const STAR_FRAGMENT = /* glsl */ `"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  varying vec3 vColor;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
