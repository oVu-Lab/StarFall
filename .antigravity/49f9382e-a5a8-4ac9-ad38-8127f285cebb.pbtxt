              text: "        perfTextRef.current.textContent = `${t.fps} FPS \302\267 ${t.frameTimeMs.toFixed(1)} ms \302\267 ${t.drawCalls} draws \302\267 ${(t.triangles / 1000).toFixed(1)}k tris`;"
