            }
            lines {
              text: "    const curveExp = THREE.MathUtils.clamp(settings.responseCurve, 1.0, 3.5);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const ySign = settings.invertY ? -1 : 1;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (input.mouseDeltaX !== 0 || input.mouseDeltaY !== 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      let nextX = this.aimCursorX + input.mouseDeltaX * cursorScale;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      let nextY = this.aimCursorY + input.mouseDeltaY * cursorScale * ySign;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      // Smooth radial unit-circle clamp:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      // - Reticle glides smoothly around the boundary with zero snapping."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      // - No hidden overflow accumulates beyond r = 1.0, so pulling back responds immediately."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      // - Relative mouse input continues flowing uninterrupted at every physical screen edge."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      const nextMag = Math.hypot(nextX, nextY);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      if (nextMag > 1.0) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        nextX /= nextMag;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        nextY /= nextMag;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      this.aimCursorX = nextX;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      this.aimCursorY = nextY;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // Crisp arcade steering curve:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // - Tiny 3% deadzone keeps straight flight drift-free."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // - Mild 1.25 exponent gives responsive small/medium turns AND full 100% turn speed at boundary."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const cursorMag = Math.hypot(this.aimCursorX, this.aimCursorY);"
