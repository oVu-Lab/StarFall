        replacement_chunks {
          target_content: "    // Smooth camera up-vector roll tracking (responsive yet fluid on A/D rolls)\n    const upAlpha = 1 - Math.exp(-(7.8 * camSens) * safeDt);\n    this.currentUp.lerp(_up, upAlpha).normalize();\n\n    // Gently blend look target toward the expanded gimbaled aim vector so wide aiming stays well framed\n    flight.getAimDirectionWorld(_lookTarget);\n    _lookTarget.lerp(_forward, 0.58).normalize();\n    _lookTarget.multiplyScalar(32).add(flight.position).addScaledVector(_up, 0.72);\n\n    _lookMatrix.lookAt(this.currentPos, _lookTarget, this.currentUp);\n    _desiredQuat.setFromRotationMatrix(_lookMatrix);\n\n    const rotAlpha = 1 - Math.exp(-(11.5 * camSens) * safeDt);\n    this.currentQuat.slerp(_desiredQuat, rotAlpha);"
          replacement_content: "    // Smooth camera up-vector roll tracking using orthonormalized projection to prevent flip during loops\n    const upAlpha = 1 - Math.exp(-(9.2 * camSens) * safeDt);\n    this.currentUp.lerp(_up, upAlpha);\n    if (this.currentUp.lengthSq() < 0.001) {\n      this.currentUp.copy(_up);\n    } else {\n      this.currentUp.normalize();\n    }\n\n    // Look directly ahead along ship\'s true forward flight vector with crisp turn tracking\n    _lookTarget.copy(flight.position).addScaledVector(_forward, 34).addScaledVector(_up, 0.78);\n\n    _lookMatrix.lookAt(this.currentPos, _lookTarget, this.currentUp);\n    _desiredQuat.setFromRotationMatrix(_lookMatrix);\n\n    const rotAlpha = 1 - Math.exp(-(13.0 * camSens) * safeDt);\n    this.currentQuat.slerp(_desiredQuat, rotAlpha);"
          start_line: 96
          end_line: 112
        }
      }
