      arguments_json: "{\"Description\":\"Render persistent virtual mouse steering cursor, steering deflection vector, and 3D cannon boresight reticle cleanly in FlightHUD.tsx\", \"Instruction\":\"Update FlightHUD.tsx to add refs and rendering for the ship\'s 3D cannon boresight marker and subtle steering vector tether alongside the persistent virtual mouse steering cursor.\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":64, \"ReplacementContent\":\"  // Combat & aiming refs\\n  const aimReticleRef = useRef<HTMLDivElement>(null);\\n  const aimRingRef = useRef<HTMLDivElement>(null);\\n  const boresightRef = useRef<HTMLDivElement>(null);\\n  const steerLineRef = useRef<SVGLineElement>(null);\\n  const hitMarkerRef = useRef<HTMLDivElement>(null);\", \"StartLine\":58, \"TargetContent\":\"  // Combat & aiming refs\\n  const aimReticleRef = useRef<HTMLDivElement>(null);\\n  const aimRingRef = useRef<HTMLDivElement>(null);\\n  const hitMarkerRef = useRef<HTMLDivElement>(null);\"}, {\"AllowMultiple\":false, \"EndLine\":191, \"ReplacementContent\":\"      // 4. Persistent Virtual Mouse Steering Cursor (stays at any screen edge, zero rollback)\\n      //    + 3D Cannon Boresight Reticle + Subtle Deflection Steering Vector\\n      const aimPxX = t.aimScreenX * vw;\\n      const aimPxY = t.aimScreenY * vh;\\n      const borePxX = t.boresightScreenX * vw;\\n      const borePxY = t.boresightScreenY * vh;\\n      const cx = vw * 0.5;\\n      const cy = vh * 0.5;\\n\\n      if (aimReticleRef.current) {\\n        aimReticleRef.current.style.transform = `translate3d(${aimPxX.toFixed(1)}px, ${aimPxY.toFixed(1)}px, 0) translate(-50%, -50%)`;\\n      }\\n\\n      if (boresightRef.current) {\\n        const recoilScale = t.isFiring ? 1 + t.weaponCooldownRatio * 0.14 : 1;\\n        boresightRef.current.style.transform = `translate3d(${borePxX.toFixed(1)}px, ${borePxY.toFixed(1)}px, 0) translate(-50%, -50%) scale(${recoilScale.toFixed(3)})`;\\n      }\\n\\n      if (aimRingRef.current) {\\n        const ringScale = 1 + t.boostIntensity * 0.24 + (t.isFiring ? 0.08 : 0);\\n        aimRingRef.current.style.transform = `scale(${ringScale.toFixed(3)})`;\\n        aimRingRef.current.style.opacity = String(\\n          (0.24 + t.boostIntensity * 0.45 + (t.isFiring ? 0.22 : 0)).toFixed(2),\\n        );\\n      }\\n\\n      if (steerLineRef.current) {\\n        const dx = aimPxX - cx;\\n        const dy = aimPxY - cy;\\n        const distPx = Math.hypot(dx, dy);\\n        if (distPx > 14) {\\n          const ux = dx / distPx;\\n          const uy = dy / distPx;\\n          steerLineRef.current.setAttribute(\'x1\', (cx + ux * 10).toFixed(1));\\n          steerLineRef.current.setAttribute(\'y1\', (cy + uy * 10).toFixed(1));\\n          steerLineRef.current.setAttribute(\'x2\', (aimPxX - ux * 18).toFixed(1));\\n          steerLineRef.current.setAttribute(\'y2\', (aimPxY - uy * 18).toFixed(1));\\n          steerLineRef.current.style.opacity = String(Math.min(0.42, (distPx / 260) * 0.42).toFixed(2));\\n        } else {\\n          steerLineRef.current.style.opacity = \'0\';\\n        }\\n      }\", \"StartLine\":174, \"TargetContent\":\"      // 4. True 3D-Projected Forward Aiming Reticle (aligned 1:1 with ship boresight, zero snap-back)\\n      const aimPxX = t.aimScreenX * vw;\\n      const aimPxY = t.aimScreenY * vh;\\n\\n      if (aimReticleRef.current) {\\n        const recoilScale = t.isFiring ? 1 + t.weaponCooldownRatio * 0.14 : 1;\\n        aimReticleRef.current.style.transform = `translate3d(${aimPxX.toFixed(1)}px, ${aimPxY.toFixed(1)}px, 0) translate(-50%, -50%) scale(${recoilScale.toFixed(3)})`;\\n      }\\n\\n      if (aimRingRef.current) {\\n        const ringScale = 1 + t.boostIntensity * 0.28 + (t.isFiring ? 0.08 : 0);\\n        aimRingRef.current.style.transform = `scale(${ringScale.toFixed(3)})`;\\n        aimRingRef.current.style.opacity = String(\\n          (0.24 + t.boostIntensity * 0.5 + (t.isFiring ? 0.22 : 0)).toFixed(2),\\n        );\\n      }\"}, {\"AllowMultiple\":false, \"EndLine\":441, \"ReplacementContent\":\"      {/* Subtle Steering Vector Tether (Screen Center -> Persistent Virtual Mouse Cursor) */}\\n      <svg\\n        className=\\\"pointer-events-none fixed inset-0 h-full w-full\\\"\\n        aria-hidden=\\\"true\\\"\\n      >\\n        <line\\n          ref={steerLineRef}\\n          x1=\\\"0\\\"\\n          y1=\\\"0\\\"\\n          x2=\\\"0\\\"\\n          y2=\\\"0\\\"\\n          stroke=\\\"#67e8f9\\\"\\n          strokeWidth=\\\"1.25\\\"\\n          strokeDasharray=\\\"4 4\\\"\\n          style={{ opacity: 0 }}\\n        />\\n      </svg>\\n\\n      {/* Ship 3D Cannon Boresight Reticle (Convergence Point + Hit/Kill Feedback) */}\\n      <div\\n        ref={boresightRef}\\n        className=\\\"pointer-events-none fixed left-0 top-0 flex items-center justify-center\\\"\\n        style={{ willChange: \'transform\' }}\\n      >\\n        <div\\n          ref={aimRingRef}\\n          className=\\\"absolute h-14 w-14 rounded-full border border-cyan-400/45 opacity-25\\\"\\n          style={{ willChange: \'transform, opacity\' }}\\n        />\\n\\n        <svg width=\\\"34\\\" height=\\\"34\\\" viewBox=\\\"0 0 34 34\\\" className=\\\"text-cyan-300/75\\\">\\n          <line x1=\\\"17\\\" y1=\\\"3\\\" x2=\\\"17\\\" y2=\\\"9\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.4\\\" />\\n          <line x1=\\\"17\\\" y1=\\\"25\\\" x2=\\\"17\\\" y2=\\\"31\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.4\\\" />\\n          <line x1=\\\"3\\\" y1=\\\"17\\\" x2=\\\"9\\\" y2=\\\"17\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.4\\\" />\\n          <line x1=\\\"25\\\" y1=\\\"17\\\" x2=\\\"31\\\" y2=\\\"17\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.4\\\" />\\n          <circle cx=\\\"17\\\" cy=\\\"17\\\" r=\\\"1.8\\\" fill=\\\"#bae6fd\\\" />\\n        </svg>\\n\\n        {/* Hit Confirmation X */}\\n        <div\\n          ref={hitMarkerRef}\\n          className=\\\"absolute opacity-0\\\"\\n          style={{ willChange: \'opacity\' }}\\n        >\\n          <svg width=\\\"34\\\" height=\\\"34\\\" viewBox=\\\"0 0 34 34\\\" className=\\\"text-cyan-200\\\">\\n            <line x1=\\\"7\\\" y1=\\\"7\\\" x2=\\\"13\\\" y2=\\\"13\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.2\\\" />\\n            <line x1=\\\"27\\\" y1=\\\"7\\\" x2=\\\"21\\\" y2=\\\"13\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.2\\\" />\\n            <line x1=\\\"7\\\" y1=\\\"27\\\" x2=\\\"13\\\" y2=\\\"21\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.2\\\" />\\n            <line x1=\\\"27\\\" y1=\\\"27\\\" x2=\\\"21\\\" y2=\\\"21\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.2\\\" />\\n          </svg>\\n        </div>\\n\\n        {/* Kill Confirmation Burst */}\\n        <div\\n          ref={killMarkerRef}\\n          className=\\\"absolute opacity-0\\\"\\n          style={{ willChange: \'opacity\' }}\\n        >\\n          <svg width=\\\"52\\\" height=\\\"52\\\" viewBox=\\\"0 0 52 52\\\" className=\\\"text-orange-400\\\">\\n            <line x1=\\\"10\\\" y1=\\\"10\\\" x2=\\\"19\\\" y2=\\\"19\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.5\\\" />\\n            <line x1=\\\"42\\\" y1=\\\"10\\\" x2=\\\"33\\\" y2=\\\"19\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.5\\\" />\\n            <line x1=\\\"10\\\" y1=\\\"42\\\" x2=\\\"19\\\" y2=\\\"33\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.5\\\" />\\n            <line x1=\\\"42\\\" y1=\\\"42\\\" x2=\\\"33\\\" y2=\\\"33\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.5\\\" />\\n          </svg>\\n        </div>\\n      </div>\\n\\n      {/* Persistent Virtual Mouse Steering Cursor (Stays at Screen Edge for Continuous Turning) */}\\n      <div\\n        ref={aimReticleRef}\\n        data-testid=\\\"virtual-mouse-cursor\\\"\\n        className=\\\"pointer-events-none fixed left-0 top-0 flex items-center justify-center\\\"\\n        style={{ willChange: \'transform\' }}\\n      >\\n        <svg width=\\\"46\\\" height=\\\"46\\\" viewBox=\\\"0 0 46 46\\\" className=\\\"text-cyan-200/95\\\">\\n          <circle cx=\\\"23\\\" cy=\\\"23\\\" r=\\\"14\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.4\\\" strokeDasharray=\\\"7 5\\\" />\\n          <line x1=\\\"23\\\" y1=\\\"4\\\" x2=\\\"23\\\" y2=\\\"11\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.6\\\" />\\n          <line x1=\\\"23\\\" y1=\\\"35\\\" x2=\\\"23\\\" y2=\\\"42\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.6\\\" />\\n          <line x1=\\\"4\\\" y1=\\\"23\\\" x2=\\\"11\\\" y2=\\\"23\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.6\\\" />\\n          <line x1=\\\"35\\\" y1=\\\"23\\\" x2=\\\"42\\\" y2=\\\"23\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.6\\\" />\\n          <circle cx=\\\"23\\\" cy=\\\"23\\\" r=\\\"2.4\\\" fill=\\\"#e0f2fe\\\" />\\n        </svg>\\n      </div>\", \"StartLine\":393, \"TargetContent\":\"      {/* True 3D-Matched Forward Weapon Aiming Reticle */}\\n      <div\\n        ref={aimReticleRef}\\n        className=\\\"pointer-events-none fixed left-0 top-0 flex items-center justify-center\\\"\\n        style={{ willChange: \'transform\' }}\\n      >\\n        <div\\n          ref={aimRingRef}\\n          className=\\\"absolute h-16 w-16 rounded-full border border-cyan-300/60 opacity-25\\\"\\n          style={{ willChange: \'transform, opacity\' }}\\n        />\\n\\n        <svg width=\\\"46\\\" height=\\\"46\\\" viewBox=\\\"0 0 46 46\\\" className=\\\"text-cyan-300/90\\\">\\n          <line x1=\\\"23\\\" y1=\\\"3\\\" x2=\\\"23\\\" y2=\\\"12\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.5\\\" />\\n          <line x1=\\\"23\\\" y1=\\\"34\\\" x2=\\\"23\\\" y2=\\\"43\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.5\\\" />\\n          <line x1=\\\"3\\\" y1=\\\"23\\\" x2=\\\"12\\\" y2=\\\"23\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.5\\\" />\\n          <line x1=\\\"34\\\" y1=\\\"23\\\" x2=\\\"43\\\" y2=\\\"23\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.5\\\" />\\n          <circle cx=\\\"23\\\" cy=\\\"23\\\" r=\\\"2.2\\\" fill=\\\"#e0f2fe\\\" />\\n        </svg>\\n\\n        {/* Hit Confirmation X */}\\n        <div\\n          ref={hitMarkerRef}\\n          className=\\\"absolute opacity-0\\\"\\n          style={{ willChange: \'opacity\' }}\\n        >\\n          <svg width=\\\"34\\\" height=\\\"34\\\" viewBox=\\\"0 0 34 34\\\" className=\\\"text-cyan-200\\\">\\n            <line x1=\\\"7\\\" y1=\\\"7\\\" x2=\\\"13\\\" y2=\\\"13\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.2\\\" />\\n            <line x1=\\\"27\\\" y1=\\\"7\\\" x2=\\\"21\\\" y2=\\\"13\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.2\\\" />\\n            <line x1=\\\"7\\\" y1=\\\"27\\\" x2=\\\"13\\\" y2=\\\"21\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.2\\\" />\\n            <line x1=\\\"27\\\" y1=\\\"27\\\" x2=\\\"21\\\" y2=\\\"21\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.2\\\" />\\n          </svg>\\n        </div>\\n\\n        {/* Kill Confirmation Burst */}\\n        <div\\n          ref={killMarkerRef}\\n          className=\\\"absolute opacity-0\\\"\\n          style={{ willChange: \'opacity\' }}\\n        >\\n          <svg width=\\\"52\\\" height=\\\"52\\\" viewBox=\\\"0 0 52 52\\\" className=\\\"text-orange-400\\\">\\n            <line x1=\\\"10\\\" y1=\\\"10\\\" x2=\\\"19\\\" y2=\\\"19\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.5\\\" />\\n            <line x1=\\\"42\\\" y1=\\\"10\\\" x2=\\\"33\\\" y2=\\\"19\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.5\\\" />\\n            <line x1=\\\"10\\\" y1=\\\"42\\\" x2=\\\"19\\\" y2=\\\"33\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.5\\\" />\\n            <line x1=\\\"42\\\" y1=\\\"42\\\" x2=\\\"33\\\" y2=\\\"33\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2.5\\\" />\\n          </svg>\\n        </div>\\n      </div>\"}], \"TargetFile\":\"/src/components/FlightHUD.tsx\", \"toolAction\":\"Updating FlightHUD with persistent steering cursor and boresight\", \"toolSummary\":\"Update FlightHUD.tsx\"}"
