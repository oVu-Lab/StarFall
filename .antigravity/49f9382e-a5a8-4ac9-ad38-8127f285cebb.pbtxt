            arguments_json: "{\"CommandLine\":\"NODE_PATH=/usr/local/share/bun-global/node_modules node -e \'\\nconst { chromium } = require(\\\"playwright\\\");\\n(async () => {\\n  const browser = await chromium.launch({\\n    headless: true,\\n    args: [\\\"--no-sandbox\\\", \\\"--use-gl=angle\\\", \\\"--use-angle=swiftshader\\\"]\\n  });\\n  const page = await browser.newPage({ viewport: { width: 1280, height: 720 } });\\n  page.on(\\\"pageerror\\\", e => console.log(\\\"[pageerror]\\\", e.message));\\n  page.on(\\\"console\\\", m => console.log(\\\"[console]\\\", m.text()));\\n\\n  await page.goto(\\\"http://localhost:3000/\\\", { waitUntil: \\\"domcontentloaded\\\" });\\n  await page.waitForTimeout(1000);\\n  await page.getByRole(\\\"button\\\", { name: /Campaign Missions/i }).click({ force: true });\\n  await page.waitForTimeout(300);\\n  await page.getByRole(\\\"button\\\", { name: /Launch M-01/i }).click({ force: true });\\n\\n  for (let i = 0; i < 15; i++) {\\n    await page.waitForTimeout(500);\\n    const snap = await page.evaluate(() => ({\\n      text: document.body.innerText.slice(0, 300),\\n      pl: document.pointerLockElement?.tagName || null\\n    }));\\n    console.log(\\\"t=\\\" + (i * 0.5) + \\\"s:\\\", JSON.stringify(snap));\\n    if (snap.text.includes(\\\"Hull Integrity\\\") || snap.text.includes(\\\"Flight Paused\\\")) break;\\n  }\\n  await browser.close();\\n  process.exit(0);\\n})();\\n\'\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Tracing mission launch UI state in Chromium\", \"toolSummary\":\"Trace mission launch UI\"}"
