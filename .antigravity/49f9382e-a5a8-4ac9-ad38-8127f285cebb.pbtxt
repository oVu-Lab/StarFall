            }
            lines {
              text: "    if (input.keyYawLeft) this.pendingYawRad += profile.yawSpeed * 0.85 * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (input.keyYawRight) this.pendingYawRad -= profile.yawSpeed * 0.85 * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (input.keyPitchUp) this.pendingPitchRad += profile.pitchSpeed * 0.85 * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (input.keyPitchDown) this.pendingPitchRad -= profile.pitchSpeed * 0.85 * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Critically damped high-responsiveness integration consumes pending turn smoothly"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // while preserving 100% of total cumulative mouse rotation with zero snap-back."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const responseRate = 24.0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const consumeFraction = 1 - Math.exp(-responseRate * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const stepYaw = this.pendingYawRad * consumeFraction;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const stepPitch = this.pendingPitchRad * consumeFraction;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.pendingYawRad -= stepYaw;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.pendingPitchRad -= stepPitch;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Clean epsilon flush only when completely idle"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (Math.abs(this.pendingYawRad) < 1e-6) this.pendingYawRad = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (Math.abs(this.pendingPitchRad) < 1e-6) this.pendingPitchRad = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Track instantaneous smoothed angular velocity for camera turn lag & visual ship banking"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const instYawVel = stepYaw / safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const instPitchVel = stepPitch / safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const rateAlpha = 1 - Math.exp(-12.0 * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.yawVelocity = THREE.MathUtils.lerp("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
