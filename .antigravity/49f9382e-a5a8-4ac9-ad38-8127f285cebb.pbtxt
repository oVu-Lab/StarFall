      thinking_signature: "\022\355\n\n\352\n\001i\024}\023\346\310\vc\000\354u\206\2420\231\a\035\353\023Z\027\204\320\325\330\210\313]\356\207\317\307W9_*\326l]VL\315G\017\272\347Fv\303B\243\202x\300r\214=\"J\266R_\341\214\001\006\347\321\"\366Hj\024?\3175\006\311-!\246\302Xi\201\354#G\206\253]\225\247\333\006?.\273\334v_!\324~\234Yh\021\351i\236\222\346g\301c\000\032\212\323\002:\177*\236G\310\362\254eR\030y|u@\\\247\nk\177\273jkx\215$B\306\255\371r\314\210\0336\215\ta\301T+\314\vo\330\336\316\0359+\325\037}Ls\234\204UW\374\177,6W\344\221\212\345\237k\353\231\357F\375\315\263z+\300\335\220\354\313\344\224\265\262V\000\247\342\2647s\206IA\351o\036FD\244|\204j\273\342\337#\035G\"\345\367\373\260\365\351\337i\036\203\016+\321\\\355\vC\323\271\000%\311\270\241c.\375\203@an%\230\311\311\004eC\345\bh\005\223#\365\366]n\274\037W\340\251\256w\356\033\346\003z@\325\002a\250A \236\312j5A\366\340\362m|\363\375\211\313z6\375\327kh7b\256\340L\252\332WS\215b\261\264g\250h?\317\273=\000\000i\326I\365\341Fc\230\354_\344\214gE\002fk\276N\023C\032\357\257\306$\327\202\262\200\033*\253\307\226.\234?\254z\206\v\252\030\'\267ht2\334\256\331\037\\\310\247\276\351\354S!^\342~\231\250CU@\310\327(\262\367\367@\3411\225\343\237\317\021\n4\241\365I_z\n\302\361NC\331(s\222JQ\325\355c\332\331\376\357\233Z\250N\0309;\237\004\250\320.\nT\272\267\334\210\343\371\v\253\243^Ie\357\032\031\300\317\004\270QR&1\367J\335[\305\344\225[\270\376\373\260z)\271\317KT\r\b\331\036\000\200\3118\004#$m\234{H\r\302n\221Wf\360\233\337\213\213\305J\226G/\0241\253\254\212\305\214\037I8\327\344\210\377\025\317\374\300\362)\247o4\323$\346e\353:\217\331o\342\365\3530\325\220\\\326>=4z\260\337[\320\3109\321\364i\236uY\004\235&\251\322\277\326\375\026\023%t\211N\034\317\b\233\310^ \035\351w\222\242.\272\vi\361\210\022\003\200\302\243\326\204\301 \270#\313\344L\210\274<\"M~~(>nB\037\241\367\376\360\340=\261\035 \215\335\f\263\256\300B\373\360m\242\337U\272/\244\304\366\245\034|\\c/\311\364?\030\376\233\251)\336\366`\227\272\275P\000-\230\356n\360\031h\223zf.F\250~\2423\262\354\352\22432\035\032\247\264\3041\"\256\242\316\372\227\314#K\276\313\200\344\315\330\365v}\205\331\253\3506\233\006\336\3660Y\027\340e\034\342#\v\370\267\244BS\304P&Y\334G\271\v\006^\003\226\204\205\225\213\322\363\375\277\340v\ab\254<\021\305\n\356\f\253\205{\346B\366I:\353t6\326\264P\252\222\350\372\2367^\360\371\375\310\001\024-\216\245\3349\326DU\266\345\203A\t\"\377$\347\2519\375\225\251EV?\371o\271\2769\222\375\344ss3\364\200Yf\350\265\375\216$\245\v\213\n#\246\303\3669\272\312\361\352kT\263\273\251\3150\236\352LY\035\365\244\275\221\f\223\376\355\203\020\326\215\251\027\245\017\030\254\230i\r\'K\352>\370`5_n\267\235\330<\272\036\031l_\264\323\323q\362\337\217\207\213\035\037\231\234\034\202QC\254\226\252(\355Rn\370\264\353\232;\033\331\333\343FvlgB\240Y\360\373\251\025\237E\v\201\237&)\023\003\313\226M\022\f\330\356&Z\204\264\034\312\2002\321\001\345\371\326\256_\222\256_{\031\a~\322r\251g\351\004\351,\201\a\022\323\226\033\360\220\321\233\365\377W!\323KZ\235`\235\206i?b\\\344n\r^\2122\235\272\233xX\277\241K\253\200QeO\016\2046\300e\222~v\2616\237\256\340\325>M\305\346\344\320Y\000\0018\374o\005,\311\030\323\335V\234\323g\366\023k\026(\377\340\003\214\372W\251s\212\304\212\245mp\207\275\340\200\327\211\025\256\006\002\325,d\266:\361D\246\367/<\rC\335\326\3217\343_\250\211\256\273Q\315\214\201\233\242R}\201\036\255\231\322\016*\326\375\026L|\374\320xd\357tb\f\f\233\262wC(\270\242\372\211+\242>\232\307\016G\277\001j\346\214\327G|\216\036\331\370\351\236)D\216F\037%\211\275s\330\375\312\026\322~\252i\266\314i\363\030-\273\342\235v\355\303\270|h\372S\b\240\334okL\277\257\357\346\277n\315\270[\033\210\217e\307\262\'\360\vz}5\270\337Z\212\260\251U\254[(\2241\201\356<r\r0\217\213\322\017\322\273\024\213\345!\bD\203\203#\363E\037\240\275\320\217L\\~\016\r\232U\322]\3318XR\201!n=\253\315\2026\336\346\356u\255/34_\n\322\273\367B\215\304\006{\277)P\322[C\345\200=%\267*\353o\035\002s\241\304\235\312\356\267\264{\2