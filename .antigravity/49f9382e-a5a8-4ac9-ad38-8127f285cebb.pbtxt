              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export class FlightController {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  public readonly position = new THREE.Vector3(0, 12, 40);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  public readonly quaternion = new THREE.Quaternion();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  public readonly velocity = new THREE.Vector3(0, 0, -24);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Smoothed angular rates (rad/s) in ship local space"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  public yawVelocity = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  public pitchVelocity = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  public rollVelocity = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Visual banking angle layered on the ship mesh for tactile feel"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  public visualBankAngle = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  private ship: ShipConfig;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  private boostEnergy: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  private boostCooldownTimer = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  private boostLockedOut = false;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  private boostIntensity = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  private wasBoosting = false;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  private hull: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  public constructor(ship: ShipConfig) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.ship = ship;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.boostEnergy = ship.flight.maxBoostEnergy;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.hull = ship.maxHull;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  public setShipConfig(ship: ShipConfig): void {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.ship = ship;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.boostEnergy = Math.min(this.boostEnergy, ship.flight.maxBoostEnergy);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.hull = ship.maxHull;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  public reset(startPosition?: THREE.Vector3): void {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (startPosition) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.position.copy(startPosition);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.position.set(0, 12, 40);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.quaternion.identity();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.velocity.set(0, 0, -28);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.yawVelocity = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.pitchVelocity = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.rollVelocity = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.visualBankAngle = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.boostEnergy = this.ship.flight.maxBoostEnergy;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.boostCooldownTimer = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.boostLockedOut = false;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.boostIntensity = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.wasBoosting = false;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.hull = this.ship.maxHull;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  public getBoostJustEngaged(): boolean {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return this.boostJustEngaged;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  private boostJustEngaged = false;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   * Advances arcade flight simulation by delta time `dt` (seconds) and writes live telemetry."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  public update("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    dt: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    input: InputSnapshot,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    settings: GameSettings,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    telemetry: FlightTelemetry,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ): void {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const profile = this.ship.flight;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // 1. Mouse-driven Yaw & Pitch (plus optional arrow key assistance)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const sens = settings.mouseSensitivity;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const mouseScale = 0.0042 * sens;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let targetYawInput = -input.mouseDeltaX * mouseScale / safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const ySign = settings.invertY ? 1 : -1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let targetPitchInput = input.mouseDeltaY * mouseScale * ySign / safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (input.keyYawLeft) targetYawInput += profile.yawSpeed * 0.85;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (input.keyYawRight) targetYawInput -= profile.yawSpeed * 0.85;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (input.keyPitchUp) targetPitchInput += profile.pitchSpeed * 0.85;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (input.keyPitchDown) targetPitchInput -= profile.pitchSpeed * 0.85;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Clamp to max angular authority so fast mouse flicks feel aggressive yet controlled"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const maxYaw = profile.yawSpeed * (1.25 + sens * 0.35);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const maxPitch = profile.pitchSpeed * (1.25 + sens * 0.35);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    targetYawInput = THREE.MathUtils.clamp(targetYawInput, -maxYaw, maxYaw);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    targetPitchInput = THREE.MathUtils.clamp(targetPitchInput, -maxPitch, maxPitch);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Smooth response: snappy attack when mouse moves, crisp damping when released"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const mouseActive ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      Math.abs(input.mouseDeltaX) > 0.01 ||"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      Math.abs(input.mouseDeltaY) > 0.01 ||"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      input.keyYawLeft ||"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      input.keyYawRight ||"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      input.keyPitchUp ||"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      input.keyPitchDown;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const angularLambda = mouseActive ? profile.angularDamping * 1.9 : profile.angularDamping * 1.35;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const angularAlpha = 1 - Math.exp(-angularLambda * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.yawVelocity = THREE.MathUtils.lerp(this.yawVelocity, targetYawInput, angularAlpha);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.pitchVelocity = THREE.MathUtils.lerp(this.pitchVelocity, targetPitchInput, angularAlpha);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // 2. Independent Roll via A / D"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let rollDir = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (input.rollLeft) rollDir += 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (input.rollRight) rollDir -= 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const targetRollRate = rollDir * profile.rollSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const rollAlpha = 1 - Math.exp(-(profile.angularDamping * 1.25) * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.rollVelocity = THREE.MathUtils.lerp(this.rollVelocity, targetRollRate, rollAlpha);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // 3. Apply local-space quaternion rotations (zero gimbal lock in 6DOF space!)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    _qYaw.setFromAxisAngle(_AXIS_Y, this.yawVelocity * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    _qPitch.setFromAxisAngle(_AXIS_X, this.pitchVelocity * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    _qRoll.setFromAxisAngle(_AXIS_Z, this.rollVelocity * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.quaternion.multiply(_qYaw);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.quaternion.multiply(_qPitch);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.quaternion.multiply(_qRoll);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.quaternion.normalize();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Subtle visual bank when yawing without overriding deliberate A/D roll"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const targetBank = THREE.MathUtils.clamp("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      (this.yawVelocity / profile.yawSpeed) * profile.visualBankStrength,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      -0.42,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      0.42,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.visualBankAngle = THREE.MathUtils.damp(this.visualBankAngle, targetBank, 6.5, safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // 4. Boost energy management"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (this.boostLockedOut && this.boostEnergy >= 18) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.boostLockedOut = false;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const wantsBoost = input.boost && !input.backward && !this.boostLockedOut && this.boostEnergy > 0.5;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const isBoosting = wantsBoost;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.boostJustEngaged = isBoosting && !this.wasBoosting;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.wasBoosting = isBoosting;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (isBoosting) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.boostEnergy = Math.max(0, this.boostEnergy - profile.boostDrainRate * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.boostCooldownTimer = profile.boostRegenDelay;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (this.boostEnergy <= 0.1) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        this.boostEnergy = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        this.boostLockedOut = true;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (this.boostCooldownTimer > 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        this.boostCooldownTimer = Math.max(0, this.boostCooldownTimer - safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      } else if (this.boostEnergy < profile.maxBoostEnergy) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        this.boostEnergy = Math.min("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          profile.maxBoostEnergy,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          this.boostEnergy + profile.boostRegenRate * safeDt,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
