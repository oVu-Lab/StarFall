      thinking_signature: "\022\254\004\n\251\004\001i\024}\023.\353-\333G6\027\262\343\2122Xs\212\035\376_U\230\346\031\220\261\243\"~=\253F\222\250\275\372\370\"\273i\301\252\235\313;G\242\246!\3365?o\022\214\212\000fL\305\217Q ?\246\310\325\240\241L\317%\374\213M\345c\344\355\242P(\034\260P\230a\302\232\333}\215\242O\0358\241\241\232\264l\332LnO\210\234\250\303\355\300\326\3569G\177\217q[\353\0374\345-\301\324\372\273\304Q?\225\2718\257\321\024\340s\303\256,\360\213\277\322@za\326\377\260\r\320\337!(jw\230\343\345\r\217\t\037\021)\332\177J@!\273\333\006]\207\234\361\251\364\321Z\271\357\373\022\266\265\3064s6^\207\265\252j\272M|\030\\\230B\254\026\001H\211\033v\262H\255K\265\250\344D\034\204$\345\377\276l\247w\264\"\t\225\201\304L\243\001\3720\205\036\'V1\37167\2203`\326\351UL>6\266\0034\033\362\363\003\245(\210\267\227\277\3164od=\026\270UM56\241\241)[\200\322a\3058\022|\246\331\203\b\303n+\205\t\227s\276\337k\234\341\3679$@\200Y\020\356\225I\035\374\251VI%\v\027\313\204\221Mh\237\232a\270\331KE\024ea-*\346i\225\334q\r\331\204\237\323\3309\301U\366S\227~\240@\247\341\365\264s\203l\275\024\357\276\177\214-3\362\306rq\203\326\2560\316=\266\324V\252\017q\302\235\032:6\354\314\177w.\334\036\223\216+\275Y\220\233\230{(\032-\'\204\314\366\223\3678\006\357\216\245\246\357\371yg\306\233\025J\251\301\334\275+\235\242\306\203\375rl\374\316\374I\350\341\241N\321/,\305\314rI\301y\362\372W1\3029:~\343\f\304\367w\314r\230h\234\220Q\031@#EV\2647\320\037?/\307Qb\251\035\235`@b]E#\b\\\272\332\003%\322\\\247)\3433X\374]gu\302R=\350\235\244y\355\256\314\354\220\021\357\307\363\310\305j\2106b\337"
