    command_line: "npx tsx -e \'\nimport assert from \"node:assert/strict\";\nimport * as THREE from \"three\";\nimport { InputManager } from \"./src/engine/InputManager\";\nimport { FlightController, createInitialTelemetry } from \"./src/engine/FlightController\";\nimport { CameraController } from \"./src/engine/CameraController\";\nimport { SHIP_CONFIGS, DEFAULT_SETTINGS } from \"./src/config/ships\";\n\n// Minimal DOM shim to test InputManager pointer-lock & listener lifecycle directly\nconst listeners: Record<string, Set<Function>> = {};\nconst docListeners: Record<string, Set<Function>> = {};\nconst canvasEl: any = {\n  tagName: \"CANVAS\",\n  requestPointerLockCalled: 0,\n  requestPointerLock(opts?: any) {\n    assert.equal(opts, undefined, \"requestPointerLock must not pass unsupported unadjustedMovement options\");\n    this.requestPointerLockCalled++;\n    (globalThis as any).document.pointerLockElement = this;\n    for (const fn of docListeners[\"pointerlockchange\"] || []) fn();\n  },\n};\n(globalThis as any).window = {\n  addEventListener: (t: string, fn: Function) => { (listeners[t] ??= new Set()).add(fn); },\n  removeEventListener: (t: string, fn: Function) => { listeners[t]?.delete(fn); },\n};\n(globalThis as any).document = {\n  pointerLockElement: null as any,\n  addEventListener: (t: string, fn: Function) => { (docListeners[t] ??= new Set()).add(fn); },\n  removeEventListener: (t: string, fn: Function) => { docListeners[t]?.delete(fn); },\n  exitPointerLock: () => {\n    (globalThis as any).document.pointerLockElement = null;\n    for (const fn of docListeners[\"pointerlockchange\"] || []) fn();\n  },\n};\n\nconst input = new InputManager();\nlet pausedCount = 0;\nlet lockState: boolean | null = null;\nconst cb = {\n  onPauseRequested: () => { pausedCount++; },\n  onPointerLockChanged: (locked: boolean) => { lockState = locked; },\n};\n\n// 1. Duplicate attach guard\ninput.attach(cb);\ninput.attach(cb);\nassert.equal(listeners[\"mousemove\"].size, 1, \"Must prevent duplicate mousemove listeners\");\nassert.equal(listeners[\"mousedown\"].size, 1, \"Must prevent duplicate mousedown listeners\");\nassert.equal(docListeners[\"pointerlockchange\"].size, 1, \"Must prevent duplicate pointerlockchange listeners\");\n\n// 2. Ownership verification\nconst otherEl = { tagName: \"DIV\" };\ninput.setLockTarget(canvasEl);\ninput.setActive(true);\n(globalThis as any).document.pointerLockElement = otherEl;\nfor (const fn of docListeners[\"pointerlockchange\"]) fn();\nassert.equal(input.isPointerLocked(), false, \"Must reject lock owned by non-canvas element\");\n\n// 3. Request lock synchronously on canvas\ninput.requestPointerLock();\nassert.equal(canvasEl.requestPointerLockCalled, 1);\nassert.equal(input.isPointerLocked(), true);\nassert.equal(lockState, true);\n\n// 4. Continuous smooth movement + cursor-warp rollback suppression\nconst ship = SHIP_CONFIGS.interceptor;\nconst flight = new FlightController(ship);\nconst camera = new THREE.PerspectiveCamera(62, 16 / 9, 0.25, 4000);\nconst camCtrl = new CameraController();\ncamCtrl.snapToShip(flight, camera, DEFAULT_SETTINGS.cameraDistance);\nconst telemetry = createInitialTelemetry(ship);\n\nlet totalTurnDeg = 0;\nlet prevQuat = flight.quaternion.clone();\nconst emitMove = (mx: number, my: number) => {\n  for (const fn of listeners[\"mousemove\"]) fn({ movementX: mx, movementY: my });\n};\n\n// 120 frames of continuous rightward movement (+15px/frame), injecting edge cursor-warp rollback spikes (-420px, -280px)\nfor (let i = 0; i < 120; i++) {\n  emitMove(15, 0);\n  if (i === 40) emitMove(-420, 0); // viewport half-width warp spike\n  if (i === 80) emitMove(-260, 0); // smaller iframe warp spike\n  const snap = input.consumeSnapshot();\n  flight.update(1 / 60, snap, DEFAULT_SETTINGS, telemetry);\n  camCtrl.updateChase(1 / 60, flight, camera, DEFAULT_SETTINGS, 0, i / 60);\n  const stepAngle = THREE.MathUtils.radToDeg(2 * Math.acos(Math.min(1, Math.abs(prevQuat.dot(flight.quaternion)))));\n  totalTurnDeg += stepAngle;\n  prevQuat.copy(flight.quaternion);\n}\nconst diag = input.getDiagnostics();\nassert.equal(diag.warpSpikesFiltered, 2, \"Both edge cursor-warp spikes must be filtered\");\nassert.ok(totalTurnDeg > 220, `Expected continuous >220 deg turn without rollback, got ${totalTurnDeg.toFixed(1)}`);\n\n// 5. Micro-precision check (2px move)\nfor (let i = 0; i < 20; i++) flight.update(1 / 60, input.consumeSnapshot(), DEFAULT_SETTINGS, telemetry);\nconst beforeMicro = flight.quaternion.clone();\nemitMove(2, -1);\nfor (let i = 0; i < 30; i++) flight.update(1 / 60, input.consumeSnapshot(), DEFAULT_SETTINGS, telemetry);\nconst microAngle = THREE.MathUtils.radToDeg(2 * Math.acos(Math.min(1, Math.abs(beforeMicro.dot(flight.quaternion)))));\nassert.ok(microAngle > 0.15 && microAngle < 0.6, `Expected fine micro precision, got ${microAngle.toFixed(3)} deg`);\n\n// 6. Intentional smooth human reversal (+12 -> +4 -> -8 -> -40 -> -90) passes 100%\nconst spikesBefore = input.getDiagnostics().warpSpikesFiltered;\nfor (const dx of [12, 4, -8, -40, -90, -85]) {\n  emitMove(dx, 0);\n  const snap = input.consumeSnapshot();\n  assert.equal(snap.mouseDeltaX, dx, `Human reversal delta ${dx} must not be filtered`);\n}\nassert.equal(input.getDiagnostics().warpSpikesFiltered, spikesBefore);\n\n// 7. ESC releases pointer lock and pauses; detach cleans up all listeners\nfor (const fn of listeners[\"keydown\"]) fn({ code: \"Escape\", preventDefault() {} });\nassert.equal(input.isPointerLocked(), false);\nassert.equal(pausedCount, 1);\n\ninput.detach();\nassert.equal(listeners[\"mousemove\"].size, 0);\nassert.equal(listeners[\"mousedown\"].size, 0);\nassert.equal(docListeners[\"pointerlockchange\"].size, 0);\n\nconsole.log(\"ALL_UNIT_TESTS_PASSED\", { totalTurnDeg: +totalTurnDeg.toFixed(1), microAngle: +microAngle.toFixed(3), warpSpikesFiltered: diag.warpSpikesFiltered });\n\'"
    proposed_command_line: "npx tsx -e \'\nimport assert from \"node:assert/strict\";\nimport * as THREE from \"three\";\nimport { InputManager } from \"./src/engine/InputManager\";\nimport { FlightController, createInitialTelemetry } from \"./src/engine/FlightController\";\nimport { CameraController } from \"./src/engine/CameraController\";\nimport { SHIP_CONFIGS, DEFAULT_SETTINGS } from \"./src/config/ships\";\n\n// Minimal DOM shim to test InputManager pointer-lock & listener lifecycle directly\nconst listeners: Record<string, Set<Function>> = {};\nconst docListeners: Record<string, Set<Function>> = {};\nconst canvasEl: any = {\n  tagName: \"CANVAS\",\n  requestPointerLockCalled: 0,\n  requestPointerLock(opts?: any) {\n    assert.equal(opts, undefined, \"requestPointerLock must not pass unsupported unadjustedMovement options\");\n    this.requestPointerLockCalled++;\n    (globalThis as any).document.pointerLockElement = this;\n    for (const fn of docListeners[\"pointerlockchange\"] || []) fn();\n  },\n};\n(globalThis as any).window = {\n  addEventListener: (t: string, fn: Function) => { (listeners[t] ??= new Set()).add(fn); },\n  removeEventListener: (t: string, fn: Function) => { listeners[t]?.delete(fn); },\n};\n(globalThis as any).document = {\n  pointerLockElement: null as any,\n  addEventListener: (t: string, fn: Function) => { (docListeners[t] ??= new Set()).add(fn); },\n  removeEventListener: (t: string, fn: Function) => { docListeners[t]?.delete(fn); },\n  exitPointerLock: () => {\n    (globalThis as any).document.pointerLockElement = null;\n    for (const fn of docListeners[\"pointerlockchange\"] || []) fn();\n  },\n};\n\nconst input = new InputManager();\nlet pausedCount = 0;\nlet lockState: boolean | null = null;\nconst cb = {\n  onPauseRequested: () => { pausedCount++; },\n  onPointerLockChanged: (locked: boolean) => { lockState = locked; },\n};\n\n// 1. Duplicate attach guard\ninput.attach(cb);\ninput.attach(cb);\nassert.equal(listeners[\"mousemove\"].size, 1, \"Must prevent duplicate mousemove listeners\");\nassert.equal(listeners[\"mousedown\"].size, 1, \"Must prevent duplicate mousedown listeners\");\nassert.equal(docListeners[\"pointerlockchange\"].size, 1, \"Must prevent duplicate pointerlockchange listeners\");\n\n// 2. Ownership verification\nconst otherEl = { tagName: \"DIV\" };\ninput.setLockTarget(canvasEl);\ninput.setActive(true);\n(globalThis as any).document.pointerLockElement = otherEl;\nfor (const fn of docListeners[\"pointerlockchange\"]) fn();\nassert.equal(input.isPointerLocked(), false, \"Must reject lock owned by non-canvas element\");\n\n// 3. Request lock synchronously on canvas\ninput.requestPointerLock();\nassert.equal(canvasEl.requestPointerLockCalled, 1);\nassert.equal(input.isPointerLocked(), true);\nassert.equal(lockState, true);\n\n// 4. Continuous smooth movement + cursor-warp rollback suppression\nconst ship = SHIP_CONFIGS.interceptor;\nconst flight = new FlightController(ship);\nconst camera = new THREE.PerspectiveCamera(62, 16 / 9, 0.25, 4000);\nconst camCtrl = new CameraController();\ncamCtrl.snapToShip(flight, camera, DEFAULT_SETTINGS.cameraDistance);\nconst telemetry = createInitialTelemetry(ship);\n\nlet totalTurnDeg = 0;\nlet prevQuat = flight.quaternion.clone();\nconst emitMove = (mx: number, my: number) => {\n  for (const fn of listeners[\"mousemove\"]) fn({ movementX: mx, movementY: my });\n};\n\n// 120 frames of continuous rightward movement (+15px/frame), injecting edge cursor-warp rollback spikes (-420px, -280px)\nfor (let i = 0; i < 120; i++) {\n  emitMove(15, 0);\n  if (i === 40) emitMove(-420, 0); // viewport half-width warp spike\n  if (i === 80) emitMove(-260, 0); // smaller iframe warp spike\n  const snap = input.consumeSnapshot();\n  flight.update(1 / 60, snap, DEFAULT_SETTINGS, telemetry);\n  camCtrl.updateChase(1 / 60, flight, camera, DEFAULT_SETTINGS, 0, i / 60);\n  const stepAngle = THREE.MathUtils.radToDeg(2 * Math.acos(Math.min(1, Math.abs(prevQuat.dot(flight.quaternion)))));\n  totalTurnDeg += stepAngle;\n  prevQuat.copy(flight.quaternion);\n}\nconst diag = input.getDiagnostics();\nassert.equal(diag.warpSpikesFiltered, 2, \"Both edge cursor-warp spikes must be filtered\");\nassert.ok(totalTurnDeg > 220, `Expected continuous >220 deg turn without rollback, got ${totalTurnDeg.toFixed(1)}`);\n\n// 5. Micro-precision check (2px move)\nfor (let i = 0; i < 20; i++) flight.update(1 / 60, input.consumeSnapshot(), DEFAULT_SETTINGS, telemetry);\nconst beforeMicro = flight.quaternion.clone();\nemitMove(2, -1);\nfor (let i = 0; i < 30; i++) flight.update(1 / 60, input.consumeSnapshot(), DEFAULT_SETTINGS, telemetry);\nconst microAngle = THREE.MathUtils.radToDeg(2 * Math.acos(Math.min(1, Math.abs(beforeMicro.dot(flight.quaternion)))));\nassert.ok(microAngle > 0.15 && microAngle < 0.6, `Expected fine micro precision, got ${microAngle.toFixed(3)} deg`);\n\n// 6. Intentional smooth human reversal (+12 -> +4 -> -8 -> -40 -> -90) passes 100%\nconst spikesBefore = input.getDiagnostics().warpSpikesFiltered;\nfor (const dx of [12, 4, -8, -40, -90, -85]) {\n  emitMove(dx, 0);\n  const snap = input.consumeSnapshot();\n  assert.equal(snap.mouseDeltaX, dx, `Human reversal delta ${dx} must not be filtered`);\n}\nassert.equal(input.getDiagnostics().warpSpikesFiltered, spikesBefore);\n\n// 7. ESC releases pointer lock and pauses; detach cleans up all listeners\nfor (const fn of listeners[\"keydown\"]) fn({ code: \"Escape\", preventDefault() {} });\nassert.equal(input.isPointerLocked(), false);\nassert.equal(pausedCount, 1);\n\ninput.detach();\nassert.equal(listeners[\"mousemove\"].size, 0);\nassert.equal(listeners[\"mousedown\"].size, 0);\nassert.equal(docListeners[\"pointerlockchange\"].size, 0);\n\nconsole.log(\"ALL_UNIT_TESTS_PASSED\", { totalTurnDeg: +totalTurnDeg.toFixed(1), microAngle: +microAngle.toFixed(3), warpSpikesFiltered: diag.warpSpikesFiltered });\n\'"
    shell_name: "bash"
  }
}
