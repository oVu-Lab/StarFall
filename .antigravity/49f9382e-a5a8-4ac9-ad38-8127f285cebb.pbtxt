              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    vec3 col = mix(uOuterColor, uCoreColor, coreMask * (0.65 + 0.35 * uIntensity));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    float alpha = pow(axial, 1.45) * edgeSoft * pulse * (0.45 + 0.55 * uIntensity);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    gl_FragColor = vec4(col * (1.2 + uIntensity * 0.9), alpha);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
