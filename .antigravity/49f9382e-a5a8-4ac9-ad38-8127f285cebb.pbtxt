        target_content: "import { useCallback, useEffect, useMemo, useRef, useState } from \'react\';\nimport { AudioManager } from \'./audio/AudioManager\';\nimport { FlightHUD } from \'./components/FlightHUD\';\nimport { LoadingScreen } from \'./components/LoadingScreen\';\nimport { MainMenu } from \'./components/MainMenu\';\nimport { PauseOverlay } from \'./components/PauseOverlay\';\nimport { resolveEffectiveGraphics } from \'./config/graphics\';\nimport { loadSavedSettings, saveSettings, SHIP_CONFIGS } from \'./config/ships\';\nimport { AssetManager } from \'./engine/AssetManager\';\nimport { createInitialTelemetry, FlightController } from \'./engine/FlightController\';\nimport { InputManager } from \'./engine/InputManager\';\nimport { FlightCanvas } from \'./scene/FlightCanvas\';\nimport type {\n  GamePhase,\n  GameSettings,\n  LoadingProgress,\n  MenuSection,\n  ShipId,\n} from \'./types/game\';\n\nexport default function App() {\n  const [phase, setPhase] = useState<GamePhase>(\'menu\');\n  const [menuSection, setMenuSection] = useState<MenuSection>(\'main\');\n  const [activeShipId] = useState<ShipId>(\'interceptor\');\n  const [hangarShipId, setHangarShipId] = useState<ShipId>(\'interceptor\');\n  const [settings, setSettings] = useState<GameSettings>(() => loadSavedSettings());\n  const [pointerLocked, setPointerLocked] = useState(false);\n  const [hintsVisible, setHintsVisible] = useState(true);\n  const [snapCameraSignal, setSnapCameraSignal] = useState(0);\n  const [loadingProgress, setLoadingProgress] = useState<LoadingProgress>({\n    stage: \'Initializing flight systems\',\n    percent: 0,\n    shipId: \'interceptor\',\n  });\n\n  // Stable engine singletons (never recreated across UI renders)\n  const settingsRef = useRef<GameSettings>(settings);\n  const flightRef = useRef<FlightController>(new FlightController(SHIP_CONFIGS[activeShipId]));\n  const inputRef = useRef<InputManager>(new InputManager());\n  const telemetryRef = useRef(createInitialTelemetry(SHIP_CONFIGS[activeShipId]));\n  const hangarOrbitRef = useRef({ yaw: 0, pitch: 0 });\n  const phaseRef = useRef<GamePhase>(phase);\n\n  useEffect(() => {\n    phaseRef.current = phase;\n  }, [phase]);\n\n  useEffect(() => {\n    settingsRef.current = settings;\n    saveSettings(settings);\n    AudioManager.setMasterVolume(settings.masterVolume);\n  }, [settings]);\n\n  const graphics = useMemo(\n    () => resolveEffectiveGraphics(settings.graphicsQuality),\n    [settings.graphicsQuality],\n  );\n\n  // Attach global keyboard + pointer-lock input listeners once\n  useEffect(() => {\n    const input = inputRef.current;\n    input.attach({\n      onPauseRequested: () => {\n        if (phaseRef.current === \'playing\') {\n          AudioManager.playUiClick(\'pause\');\n          AudioManager.setFlightAudioActive(false);\n          input.setActive(false);\n          setPhase(\'paused\');\n        }\n      },\n      onPointerLockChanged: (locked) => {\n        setPointerLocked(locked);\n      },\n      onToggleHudHints: () => {\n        setHintsVisible((prev) => !prev);\n      },\n    });\n\n    return () => {\n      input.detach();\n      AudioManager.dispose();\n      AssetManager.disposeAll();\n    };\n  }, []);\n\n  // Keep InputManager and flight engine audio synced with current game phase\n  useEffect(() => {\n    const isPlaying = phase === \'playing\';\n    inputRef.current.setActive(isPlaying);\n    AudioManager.setFlightAudioActive(isPlaying);\n  }, [phase]);\n\n  const handleUpdateSettings = useCallback((patch: Partial<GameSettings>) => {\n    setSettings((prev) => ({ ...prev, ...patch }));\n  }, []);\n\n  const handleCanvasReady = useCallback((canvas: HTMLCanvasElement) => {\n    inputRef.current.setLockTarget(canvas);\n  }, []);\n\n  const handleRequestLock = useCallback(() => {\n    AudioManager.unlock();\n    inputRef.current.requestPointerLock();\n  }, []);\n\n  const handleStartPlay = useCallback(async () => {\n    AudioManager.unlock();\n    setPhase(\'loading\');\n    setLoadingProgress({\n      stage: \'Preparing VX-9 Vanguard flight profile\',\n      percent: 10,\n      shipId: activeShipId,\n    });\n\n    await AssetManager.prepareFlightSession((stage, percent) => {\n      setLoadingProgress({ stage, percent, shipId: activeShipId });\n    });\n\n    flightRef.current.setShipConfig(SHIP_CONFIGS[activeShipId]);\n    flightRef.current.reset();\n    telemetryRef.current = createInitialTelemetry(SHIP_CONFIGS[activeShipId]);\n    setSnapCameraSignal((s) => s + 1);\n    setPhase(\'playing\');\n    inputRef.current.setActive(true);\n    AudioManager.setFlightAudioActive(true);\n    // Request pointer lock seamlessly as player enters active flight\n    inputRef.current.requestPointerLock();\n  }, [activeShipId]);\n\n  const handlePause = useCallback(() => {\n    AudioManager.playUiClick(\'pause\');\n    inputRef.current.exitPointerLock();\n    inputRef.current.setActive(false);\n    AudioManager.setFlightAudioActive(false);\n    setPhase(\'paused\');\n  }, []);\n\n  const handleResume = useCallback(() => {\n    AudioManager.unlock();\n    setPhase(\'playing\');\n    inputRef.current.setActive(true);\n    AudioManager.setFlightAudioActive(true);\n    inputRef.current.requestPointerLock();\n  }, []);\n\n  const handleResetPosition = useCallback(() => {\n    flightRef.current.reset();\n    setSnapCameraSignal((s) => s + 1);\n    handleResume();\n  }, [handleResume]);\n\n  const handleReturnToMenu = useCallback(() => {\n    inputRef.current.exitPointerLock();\n    inputRef.current.setActive(false);\n    AudioManager.setFlightAudioActive(false);\n    setMenuSection(\'main\');\n    setPhase(\'menu\');\n  }, []);\n\n  return (\n    <main className=\"relative h-screen w-screen overflow-hidden bg-[#030712]\">\n      {/* Isolated Full-Viewport 3D WebGL Scene */}\n      <FlightCanvas\n        phase={phase}\n        menuSection={menuSection}\n        activeShipId={activeShipId}\n        hangarShipId={hangarShipId}\n        flight={flightRef.current}\n        input={inputRef.current}\n        settingsRef={settingsRef}\n        telemetryRef={telemetryRef}\n        graphics={graphics}\n        hangarOrbitRef={hangarOrbitRef}\n        snapCameraSignal={snapCameraSignal}\n        onCanvasReady={handleCanvasReady}\n        onCanvasClick={handleRequestLock}\n      />\n\n      {/* Semantic UI Overlays */}\n      {phase === \'menu\' && (\n        <MainMenu\n          section={menuSection}\n          onChangeSection={setMenuSection}\n          onPlay={handleStartPlay}\n          hangarShipId={hangarShipId}\n          onSelectHangarShip={setHangarShipId}\n          settings={settings}\n          onUpdateSettings={handleUpdateSettings}\n          hangarOrbitRef={hangarOrbitRef}\n        />\n      )}\n\n      {phase === \'loading\' && <LoadingScreen progress={loadingProgress} />}\n\n      {phase === \'playing\' && (\n        <FlightHUD\n          shipId={activeShipId}\n          telemetryRef={telemetryRef}\n          settings={settings}\n          pointerLocked={pointerLocked}\n          hintsVisible={hintsVisible}\n          onToggleHints={() => setHintsVisible((v) => !v)}\n          onRequestLock={handleRequestLock}\n          onPause={handlePause}\n        />\n      )}\n\n      {phase === \'paused\' && (\n        <PauseOverlay\n          settings={settings}\n          onUpdateSettings={handleUpdateSettings}\n          onResume={handleResume}\n          onResetPosition={handleResetPosition}\n          onReturnToMenu={handleReturnToMenu}\n        />\n      )}\n    </main>\n  );\n}"
        replacement_content: "import { useCallback, useEffect, useMemo, useRef, useState } from \'react\';\nimport { AudioManager } from \'./audio/AudioManager\';\nimport { FlightHUD } from \'./components/FlightHUD\';\nimport { LoadingScreen } from \'./components/LoadingScreen\';\nimport { MainMenu } from \'./components/MainMenu\';\nimport { PauseOverlay } from \'./components/PauseOverlay\';\nimport { resolveEffectiveGraphics } from \'./config/graphics\';\nimport { loadSavedSettings, saveSettings, SHIP_CONFIGS } from \'./config/ships\';\nimport { AssetManager } from \'./engine/AssetManager\';\nimport { CombatManager } from \'./engine/combat/CombatManager\';\nimport { createInitialTelemetry, FlightController } from \'./engine/FlightController\';\nimport { InputManager } from \'./engine/InputManager\';\nimport { FlightCanvas } from \'./scene/FlightCanvas\';\nimport type {\n  GamePhase,\n  GameSettings,\n  LoadingProgress,\n  MenuSection,\n  ShipId,\n} from \'./types/game\';\n\nexport default function App() {\n  const [phase, setPhase] = useState<GamePhase>(\'menu\');\n  const [menuSection, setMenuSection] = useState<MenuSection>(\'main\');\n  const [activeShipId] = useState<ShipId>(\'interceptor\');\n  const [hangarShipId, setHangarShipId] = useState<ShipId>(\'interceptor\');\n  const [settings, setSettings] = useState<GameSettings>(() => loadSavedSettings());\n  const [pointerLocked, setPointerLocked] = useState(false);\n  const [playerDestroyed, setPlayerDestroyed] = useState(false);\n  const [hintsVisible, setHintsVisible] = useState(true);\n  const [snapCameraSignal, setSnapCameraSignal] = useState(0);\n  const [loadingProgress, setLoadingProgress] = useState<LoadingProgress>({\n    stage: \'Initializing flight systems\',\n    percent: 0,\n    shipId: \'interceptor\',\n  });\n\n  // Stable engine singletons (never recreated across UI renders)\n  const settingsRef = useRef<GameSettings>(settings);\n  const flightRef = useRef<FlightController>(new FlightController(SHIP_CONFIGS[activeShipId]));\n  const combatRef = useRef<CombatManager>(new CombatManager(SHIP_CONFIGS[activeShipId].maxHull));\n  const inputRef = useRef<InputManager>(new InputManager());\n  const telemetryRef = useRef(createInitialTelemetry(SHIP_CONFIGS[activeShipId]));\n  const hangarOrbitRef = useRef({ yaw: 0, pitch: 0 });\n  const phaseRef = useRef<GamePhase>(phase);\n\n  useEffect(() => {\n    phaseRef.current = phase;\n  }, [phase]);\n\n  useEffect(() => {\n    settingsRef.current = settings;\n    saveSettings(settings);\n    AudioManager.setMasterVolume(settings.masterVolume);\n  }, [settings]);\n\n  const graphics = useMemo(\n    () => resolveEffectiveGraphics(settings.graphicsQuality),\n    [settings.graphicsQuality],\n  );\n\n  // Attach global keyboard + pointer-lock input listeners once\n  useEffect(() => {\n    const input = inputRef.current;\n    input.attach({\n      onPauseRequested: () => {\n        if (phaseRef.current === \'playing\' && !combatRef.current.playerHealth.isDestroyed) {\n          AudioManager.playUiClick(\'pause\');\n          AudioManager.setFlightAudioActive(false);\n          input.setActive(false);\n          setPhase(\'paused\');\n        }\n      },\n      onPointerLockChanged: (locked) => {\n        setPointerLocked(locked);\n      },\n      onToggleHudHints: () => {\n        setHintsVisible((prev) => !prev);\n      },\n    });\n\n    return () => {\n      input.detach();\n      AudioManager.dispose();\n      AssetManager.disposeAll();\n    };\n  }, []);\n\n  // Keep InputManager and flight engine audio synced with current game phase\n  useEffect(() => {\n    const isPlaying = phase === \'playing\' && !playerDestroyed;\n    inputRef.current.setActive(isPlaying);\n    AudioManager.setFlightAudioActive(isPlaying);\n  }, [phase, playerDestroyed]);\n\n  const handleUpdateSettings = useCallback((patch: Partial<GameSettings>) => {\n    setSettings((prev) => ({ ...prev, ...patch }));\n  }, []);\n\n  const handleCanvasReady = useCallback((canvas: HTMLCanvasElement) => {\n    inputRef.current.setLockTarget(canvas);\n  }, []);\n\n  const handleRequestLock = useCallback(() => {\n    AudioManager.unlock();\n    if (!inputRef.current.isPointerLocked()) {\n      inputRef.current.requestPointerLock();\n    }\n  }, []);\n\n  const handlePlayerDestroyed = useCallback(() => {\n    inputRef.current.exitPointerLock();\n    inputRef.current.setActive(false);\n    AudioManager.setFlightAudioActive(false);\n    setPlayerDestroyed(true);\n  }, []);\n\n  const startFreshCombatFlight = useCallback(() => {\n    const ship = SHIP_CONFIGS[activeShipId];\n    flightRef.current.setShipConfig(ship);\n    flightRef.current.reset();\n    combatRef.current.resetSession(ship.maxHull, flightRef.current.position);\n    telemetryRef.current = createInitialTelemetry(ship);\n    setPlayerDestroyed(false);\n    setSnapCameraSignal((s) => s + 1);\n    setPhase(\'playing\');\n    inputRef.current.setActive(true);\n    AudioManager.setFlightAudioActive(true);\n    inputRef.current.requestPointerLock();\n  }, [activeShipId]);\n\n  const handleStartPlay = useCallback(async () => {\n    AudioManager.unlock();\n    setPhase(\'loading\');\n    setLoadingProgress({\n      stage: \'Preparing VX-9 Vanguard combat systems\',\n      percent: 10,\n      shipId: activeShipId,\n    });\n\n    await AssetManager.prepareFlightSession((stage, percent) => {\n      setLoadingProgress({ stage, percent, shipId: activeShipId });\n    });\n\n    startFreshCombatFlight();\n  }, [activeShipId, startFreshCombatFlight]);\n\n  const handlePause = useCallback(() => {\n    if (playerDestroyed) return;\n    AudioManager.playUiClick(\'pause\');\n    inputRef.current.exitPointerLock();\n    inputRef.current.setActive(false);\n    AudioManager.setFlightAudioActive(false);\n    setPhase(\'paused\');\n  }, [playerDestroyed]);\n\n  const handleResume = useCallback(() => {\n    AudioManager.unlock();\n    setPhase(\'playing\');\n    inputRef.current.setActive(true);\n    AudioManager.setFlightAudioActive(true);\n    inputRef.current.requestPointerLock();\n  }, []);\n\n  const handleResetPosition = useCallback(() => {\n    startFreshCombatFlight();\n  }, [startFreshCombatFlight]);\n\n  const handleReturnToMenu = useCallback(() => {\n    inputRef.current.exitPointerLock();\n    inputRef.current.setActive(false);\n    AudioManager.setFlightAudioActive(false);\n    setPlayerDestroyed(false);\n    setMenuSection(\'main\');\n    setPhase(\'menu\');\n  }, []);\n\n  return (\n    <main className=\"relative h-screen w-screen overflow-hidden bg-[#030712]\">\n      {/* Isolated Full-Viewport 3D WebGL Scene */}\n      <FlightCanvas\n        phase={phase}\n        menuSection={menuSection}\n        activeShipId={activeShipId}\n        hangarShipId={hangarShipId}\n        flight={flightRef.current}\n        combat={combatRef.current}\n        input={inputRef.current}\n        settingsRef={settingsRef}\n        telemetryRef={telemetryRef}\n        graphics={graphics}\n        hangarOrbitRef={hangarOrbitRef}\n        snapCameraSignal={snapCameraSignal}\n        onCanvasReady={handleCanvasReady}\n        onCanvasClick={handleRequestLock}\n        onPlayerDestroyed={handlePlayerDestroyed}\n      />\n\n      {/* Semantic UI Overlays */}\n      {phase === \'menu\' && (\n        <MainMenu\n          section={menuSection}\n          onChangeSection={setMenuSection}\n          onPlay={handleStartPlay}\n          hangarShipId={hangarShipId}\n          onSelectHangarShip={setHangarShipId}\n          settings={settings}\n          onUpdateSettings={handleUpdateSettings}\n          hangarOrbitRef={hangarOrbitRef}\n        />\n      )}\n\n      {phase === \'loading\' && <LoadingScreen progress={loadingProgress} />}\n\n      {phase === \'playing\' && (\n        <FlightHUD\n          shipId={activeShipId}\n          telemetryRef={telemetryRef}\n          settings={settings}\n          pointerLocked={pointerLocked}\n          playerDestroyed={playerDestroyed}\n          hintsVisible={hintsVisible}\n          onToggleHints={() => setHintsVisible((v) => !v)}\n          onRequestLock={handleRequestLock}\n          onPause={handlePause}\n          onRelaunch={startFreshCombatFlight}\n          onReturnToMenu={handleReturnToMenu}\n        />\n      )}\n\n      {phase === \'paused\' && (\n        <PauseOverlay\n          settings={settings}\n          onUpdateSettings={handleUpdateSettings}\n          onResume={handleResume}\n          onResetPosition={handleResetPosition}\n          onReturnToMenu={handleReturnToMenu}\n        />\n      )}\n    </main>\n  );\n}"
