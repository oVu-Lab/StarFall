    result {
      result: "Task: 49f9382e-a5a8-4ac9-ad38-8127f285cebb/task-272\nStatus: RUNNING\nLast progress: never\n"
      metadata {
        key: "task_description"
        value: "NODE_PATH=/usr/local/share/bun-global/node_modules node -e \'\nconst { chromium } = require(\"playwright\");\n(async () => {\n  const browser = await chromium.launch({\n    headless: true,\n    args: [\"--no-sandbox\", \"--use-gl=angle\", \"--use-angle=swiftshader\"]\n  });\n  const page = await browser.newPage({ viewport: { width: 1280, height: 720 } });\n  await page.addInitScript(() => {\n    // Use low graphics preset in localStorage so SwiftShader runs fast\n    localStorage.setItem(\"starfall.settings.v2\", JSON.stringify({\n      graphicsQuality: \"low\", resolutionScale: 0.65, shadowQuality: \"off\",\n      particleQuality: \"low\", environmentDetail: \"low\", drawDistance: 2400,\n      antialias: false, postGlowEnabled: false\n    }));\n    window.__moves = [];\n    window.__plEvents = [];\n    document.addEventListener(\"pointerlockchange\", () => {\n      window.__plEvents.push({ type: \"plc\", el: document.pointerLockElement?.tagName || null });\n    });\n    document.addEventListener(\"pointerlockerror\", () => {\n      window.__plEvents.push({ type: \"ple\", el: document.pointerLockElement?.tagName || null });\n    });\n    window.addEventListener(\"mousemove\", (e) => {\n      window.__moves.push({ mx: e.movementX, my: e.movementY, cx: e.clientX, cy: e.clientY, l: Boolean(document.pointerLockElement) });\n    }, { capture: true });\n  });\n\n  await page.goto(\"http://localhost:3000/\", { waitUntil: \"domcontentloaded\" });\n  await page.waitForSelector(\"button\");\n  await page.getByRole(\"button\", { name: /Campaign Missions/i }).click({ force: true });\n  await page.getByRole(\"button\", { name: /Launch M-01/i }).click({ force: true });\n  await page.waitForFunction(() => document.body.innerText.includes(\"Hull Integrity\"), null, { timeout: 15000 });\n  console.log(\"PLAYING! pl:\", await page.evaluate(() => ({ el: document.pointerLockElement?.tagName || null, ev: window.__plEvents })));\n\n  await page.evaluate(() => { window.__moves = []; });\n  // Smooth 10px steps using Playwright steps option\n  await page.mouse.move(640, 360);\n  await page.mouse.move(1400, 360, { steps: 30 });\n  await page.waitForTimeout(200);\n  const res = await page.evaluate(() => ({\n    moves: window.__moves,\n    hdg: document.body.innerText.match(/HDG[^\\n]*/)?.[0] || null\n  }));\n  console.log(\"RES:\", JSON.stringify(res));\n  await browser.close();\n  process.exit(0);\n})().catch(e => { console.error(e); process.exit(1); });\n\'"
      }
      metadata {
        key: "task_id"
        value: "49f9382e-a5a8-4ac9-ad38-8127f285cebb/task-272"
