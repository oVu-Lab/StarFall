              text: "   * Computes the 3D world-space convergence point along the player\'s true forward firing ray."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const gimbalYaw = THREE.MathUtils.clamp(this.aimCursorX, -1, 1) * GIMBAL_MAX_YAW_RAD;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
