            lines {
              text: "    this.stats.wave = waveNumber;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Progressive combat roster showcasing Aggressor, Flanker, Defender, and Ace personalities"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const roster: Array<{ personality: BotPersonality; difficulty: number; offset: [number, number, number] }> ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      waveNumber === 1"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ? ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            { personality: \'aggressor\', difficulty: 1, offset: [-65, 18, -230] },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            { personality: \'flanker\', difficulty: 1, offset: [85, -14, -260] },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            { personality: \'aggressor\', difficulty: 2, offset: [12, 34, -310] },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        : waveNumber === 2"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ? ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              { personality: \'aggressor\', difficulty: 2, offset: [-80, 22, -250] },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              { personality: \'flanker\', difficulty: 2, offset: [90, -18, -240] },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              { personality: \'defender\', difficulty: 2, offset: [0, 38, -320] },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          : ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              { personality: \'aggressor\', difficulty: Math.min(5, waveNumber), offset: [-95, 20, -260] },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              { personality: \'flanker\', difficulty: Math.min(5, waveNumber), offset: [95, -15, -260] },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              { personality: \'defender\', difficulty: Math.min(5, waveNumber), offset: [-20, 44, -330] },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              { personality: \'ace\', difficulty: Math.min(5, waveNumber), offset: [35, -24, -350] },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    for (let i = 0; i < roster.length && i < MAX_ENEMIES; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const spec = roster[i];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const pCfg = BOT_PERSONALITIES[spec.personality];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const spawnPos = new THREE.Vector3("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        aroundPos.x + spec.offset[0],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        aroundPos.y + spec.offset[1],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        aroundPos.z + spec.offset[2],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const id = `enemy-${this.enemyIdCounter++}`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const callsign = CALLSIGN_POOL[(this.enemyIdCounter + i) % CALLSIGN_POOL.length];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const enemy: EnemyEntity = {"
