entY, locked: Boolean(document.pointerLockElement) });\\n    }, { capture: true });\\n  });\\n\\n  await page.goto(\\\"http://localhost:3000/\\\", { waitUntil: \\\"domcontentloaded\\\" });\\n  await page.waitForTimeout(800);\\n  await page.getByRole(\\\"button\\\", { name: /Campaign Missions/i }).click();\\n  await page.waitForTimeout(200);\\n  await page.getByRole(\\\"button\\\", { name: /Launch M-01/i }).click();\\n  await page.waitForTimeout(2500);\\n\\n  const pl1 = await page.evaluate(() => ({ plEl: document.pointerLockElement?.tagName || null, events: window.__plEvents, buttons: Array.from(document.querySelectorAll(\\\"button\\\")).map(b => b.innerText) }));\\n  console.log(\\\"After Launch:\\\", JSON.stringify(pl1));\\n\\n  const lockBtn = page.getByRole(\\\"button\\\", { name: /Click to Engage/i });\\n  if (await lockBtn.isVisible().catch(() => false)) {\\n    await lockBtn.click();\\n    await page.waitForTimeout(300);\\n  } else {\\n    await page.mouse.click(640, 360);\\n    await page.waitForTimeout(300);\\n  }\\n  const pl2 = await page.evaluate(() => ({ plEl: document.pointerLockElement?.tagName || null, events: window.__plEvents }));\\n  console.log(\\\"After Click:\\\", JSON.stringify(pl2));\\n\\n  await page.mouse.move(640, 360);\\n  for (let i = 1; i <= 15; i++) {\\n    await page.mouse.move(640 + i * 60, 360);\\n  }\\n  const moves = await page.evaluate(() => window.__moves);\\n  console.log(\\\"Moves count:\\\", moves.length, \\\"data:\\\", JSON.stringify(moves));\\n  await browser.close();\\n  process.exit(0);\\n})().catch(e => { console.error(e); process.exit(1); });\\n\'\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Running live Chromium Pointer Lock test\", \"toolSummary\":\"Run live Chromium test\"}"
            thinking_signature: "\022\302\004\n\277\004\001i\024}\023\370\241\363\204\2441\260@#R\203%\203\377\311\2134[Z\002\311o\\\247s\247\362\254\331\364Im\330\210\030\240\016\205?ygMhr\000L\275-@\254\227\271\210\302\254\2468\a\353\255\246\025av\376jg\303\332(\315\276\221\300\350\372\023\250U\242c\357\221Q\260u\264u\324UP\243\332M\371\\\205\243({j\ni\322\216\206\260\325\335\240\253\341,\317\216\225p\024Jp\350\026@*\312\366)\a|\264\257\203\325*\300\311\v\267\t\300\0360$\204F\303\222V\274\026\353<\263\313\235\240\371\265\237\006\224.\a:\224\017\231%\027\350\244I0B\251\370\353\017\246(\366S\203\203C0\270?p\350J\253f\033y\311P\\\024\f\025\342\204b\340z\302\361\376R\277!\264\217\236L\"\201\270\216\343Z\365\207y\"&76\307\027n\360g\001=\321Nf\267\237\252\245\366\322\266\341m\301<a\205 00\232\224\333`\214\227\276\357\334\307\355\1770\206\204\367NNpm\363\ti\317\200r\310d6\344\335%P\236\"}x\035\031\277\343\275)\266\263\241\032\334\304\311J\027\237\036\271c\337\301\363? \n\003\033*~\311 \240\230uO\350\v\322\265\225+\035\003\270\270\"\363\366\273\355o\317\023$\334\004\236 +f/\366I\"l\310\000\017^\343\030\274\260\034\364{k0\360\216\301(-\350J\225\303\b!\361\023|\241\'6\003\351X8b\336\322\257V]\235zm\332\203\356\3475\345h*\272\255&\313\027\247\337\374?\221Y\372m\302y\234_\217\337;\331\355\251Xl{BO\f\266\005!\324\2264\255K\311\320{\023z\350g\345\220\342gC\024n\243\236l\320\213\255\f\366\265\207\274\366\243\251cZ\326\300J\005\363\211\300c0\343\316\312<KSL%\370~X\356\243\316\303\004m\366<Upm\004\n\344<\\\352\230\025\vt\002<\t\240D\213!\253Z\255\332\315\217\231tbn{\376\247)\330\"\2147x\261\322F-\326\233\254\226\020~\217\3319\0379\345\ngA\200\254\021\340{B\226\\\253"
