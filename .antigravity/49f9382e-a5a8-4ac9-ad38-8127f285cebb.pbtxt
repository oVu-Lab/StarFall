            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    vec3 col = voidCol;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    col = mix(col, navyNebula, smoothstep(0.28, 0.75, n1) * (0.45 + 0.55 * plane));"
