            }
            lines {
              text: "    telemetry.boresightScreenY = THREE.MathUtils.clamp((1 - _projVec.y) * 0.5, 0.06, 0.94);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
