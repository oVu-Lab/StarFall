        target_content: "          <span className=\"font-mono text-xs tracking-[0.26em] text-cyan-300\">\n            ORBITAL FLIGHT PROTOTYPE\n          </span>\n        </div>\n\n        <h1 className=\"mt-3 font-display text-5xl font-bold tracking-[0.14em] text-slate-50 sm:text-6xl\">\n          STARFALL\n        </h1>\n\n        <p className=\"mt-3 max-w-md text-sm leading-relaxed text-slate-300\">\n          Six-degree-of-freedom arcade space combat. Pilot the VX-9 Vanguard across the Aurelia\n          orbital sector with full pointer-lock flight control and afterburner boost.\n        </p>\n      </div>\n\n      {/* Primary Action Stack */}\n      <div className=\"pointer-events-auto flex w-full max-w-xs flex-col gap-3\">\n        <button\n          type=\"button\"\n          onMouseEnter={() => AudioManager.playUiHover()}\n          onClick={() => {\n            AudioManager.unlock();\n            AudioManager.playUiClick(\'primary\');\n            onPlay();\n          }}\n          className=\"group flex items-center justify-between bg-cyan-500 px-6 py-3.5 text-sm font-semibold tracking-wide text-slate-950 transition-colors hover:bg-cyan-400 focus-visible:outline-2 focus-visible:outline-cyan-300\"\n        >\n          <span className=\"flex items-center gap-3\">\n            <Play className=\"h-4 w-4 fill-current\" />\n            <span>Play</span>\n          </span>\n          <span className=\"font-mono text-xs text-slate-900/80\">VX-9</span>\n        </button>\n\n        <button\n          type=\"button\"\n          onMouseEnter={() => AudioManager.playUiHover()}\n          onClick={() => {\n            AudioManager.unlock();\n            AudioManager.playUiClick(\'secondary\');\n            onChangeSection(\'hangar\');\n          }}\n          className=\"flex items-center justify-between border border-slate-700/90 bg-[#050c1d]/85 px-6 py-3 text-sm font-medium text-slate-100 transition-colors hover:border-cyan-400/70 hover:text-cyan-200 focus-visible:outline-2 focus-visible:outline-cyan-400\"\n        >\n          <span className=\"flex items-center gap-3\">\n            <Compass className=\"h-4 w-4 text-cyan-400\" />\n            <span>Hangar</span>\n          </span>\n          <span className=\"font-mono text-xs text-slate-400\">3 Ships</span>\n        </button>\n\n        <button\n          type=\"button\"\n          onMouseEnter={() => AudioManager.playUiHover()}\n          onClick={() => {\n            AudioManager.unlock();\n            AudioManager.playUiClick(\'secondary\');\n            onChangeSection(\'settings\');\n          }}\n          className=\"flex items-center justify-between border border-slate-700/90 bg-[#050c1d]/85 px-6 py-3 text-sm font-medium text-slate-100 transition-colors hover:border-cyan-400/70 hover:text-cyan-200 focus-visible:outline-2 focus-visible:outline-cyan-400\"\n        >\n          <span className=\"flex items-center gap-3\">\n            <SlidersHorizontal className=\"h-4 w-4 text-cyan-400\" />\n            <span>Settings</span>\n          </span>\n          <span className=\"font-mono text-xs text-slate-400\">Controls & Audio</span>\n        </button>\n      </div>\n\n      {/* Quiet Flight Controls Summary Footer */}\n      <div className=\"flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-400\">\n        <span>Mouse Yaw / Pitch</span>\n        <span aria-hidden=\"true\">\302\267</span>\n        <span>W / S Thrust</span>\n        <span aria-hidden=\"true\">\302\267</span>\n        <span>A / D Roll</span>\n        <span aria-hidden=\"true\">\302\267</span>\n        <span>Shift Boost</span>\n        <span aria-hidden=\"true\">\302\267</span>\n        <span>Combat Missions Coming Soon</span>\n      </div>"
        replacement_content: "          <span className=\"font-mono text-xs tracking-[0.26em] text-cyan-300\">\n            ORBITAL COMBAT PROTOTYPE\n          </span>\n        </div>\n\n        <h1 className=\"mt-3 font-display text-5xl font-bold tracking-[0.14em] text-slate-50 sm:text-6xl\">\n          STARFALL\n        </h1>\n\n        <p className=\"mt-3 max-w-md text-sm leading-relaxed text-slate-300\">\n          Six-degree-of-freedom arcade space combat. Pilot the VX-9 Vanguard with twin pulse\n          cannons, expanded mouse aiming, and hostile AI interceptor wings across the Aurelia sector.\n        </p>\n      </div>\n\n      {/* Primary Action Stack */}\n      <div className=\"pointer-events-auto flex w-full max-w-xs flex-col gap-3\">\n        <button\n          type=\"button\"\n          onMouseEnter={() => AudioManager.playUiHover()}\n          onClick={() => {\n            AudioManager.unlock();\n            AudioManager.playUiClick(\'primary\');\n            onPlay();\n          }}\n          className=\"group flex items-center justify-between bg-cyan-500 px-6 py-3.5 text-sm font-semibold tracking-wide text-slate-950 transition-colors hover:bg-cyan-400 focus-visible:outline-2 focus-visible:outline-cyan-300\"\n        >\n          <span className=\"flex items-center gap-3\">\n            <Play className=\"h-4 w-4 fill-current\" />\n            <span>Play</span>\n          </span>\n          <span className=\"font-mono text-xs text-slate-900/80\">VX-9</span>\n        </button>\n\n        <button\n          type=\"button\"\n          onMouseEnter={() => AudioManager.playUiHover()}\n          onClick={() => {\n            AudioManager.unlock();\n            AudioManager.playUiClick(\'secondary\');\n            onChangeSection(\'hangar\');\n          }}\n          className=\"flex items-center justify-between border border-slate-700/90 bg-[#050c1d]/85 px-6 py-3 text-sm font-medium text-slate-100 transition-colors hover:border-cyan-400/70 hover:text-cyan-200 focus-visible:outline-2 focus-visible:outline-cyan-400\"\n        >\n          <span className=\"flex items-center gap-3\">\n            <Compass className=\"h-4 w-4 text-cyan-400\" />\n            <span>Hangar</span>\n          </span>\n          <span className=\"font-mono text-xs text-slate-400\">3 Ships</span>\n        </button>\n\n        <button\n          type=\"button\"\n          onMouseEnter={() => AudioManager.playUiHover()}\n          onClick={() => {\n            AudioManager.unlock();\n            AudioManager.playUiClick(\'secondary\');\n            onChangeSection(\'settings\');\n          }}\n          className=\"flex items-center justify-between border border-slate-700/90 bg-[#050c1d]/85 px-6 py-3 text-sm font-medium text-slate-100 transition-colors hover:border-cyan-400/70 hover:text-cyan-200 focus-visible:outline-2 focus-visible:outline-cyan-400\"\n        >\n          <span className=\"flex items-center gap-3\">\n            <SlidersHorizontal className=\"h-4 w-4 text-cyan-400\" />\n            <span>Settings</span>\n          </span>\n          <span className=\"font-mono text-xs text-slate-400\">Controls & Audio</span>\n        </button>\n      </div>\n\n      {/* Quiet Flight Controls Summary Footer */}\n      <div className=\"flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-400\">\n        <span>Mouse Aim / Steer</span>\n        <span aria-hidden=\"true\">\302\267</span>\n        <span>LMB Fire</span>\n        <span aria-hidden=\"true\">\302\267</span>\n        <span>W / S Thrust</span>\n        <span aria-hidden=\"true\">\302\267</span>\n        <span>A / D Roll</span>\n        <span aria-hidden=\"true\">\302\267</span>\n        <span>Shift Boost</span>\n        <span aria-hidden=\"true\">\302\267</span>\n        <span>Mission Campaign Coming Soon</span>\n      </div>"
        start_line: 69
