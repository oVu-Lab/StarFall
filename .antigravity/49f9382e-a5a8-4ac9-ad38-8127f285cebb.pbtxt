  code_action {
    action_spec {
      create_file {
        instruction: "import { Volume2 } from \'lucide-react\';\nimport { AudioManager } from \'../audio/AudioManager\';\nimport { DEFAULT_SETTINGS } from \'../config/ships\';\nimport type { GameSettings, GraphicsQuality } from \'../types/game\';\n\ninterface SettingsPanelProps {\n  settings: GameSettings;\n  onUpdateSettings: (patch: Partial<GameSettings>) => void;\n  onClose: () => void;\n  closeLabel?: string;\n}\n\nconst QUALITY_OPTIONS: Array<{ value: GraphicsQuality; label: string }> = [\n  { value: \'low\', label: \'Low\' },\n  { value: \'medium\', label: \'Medium\' },\n  { value: \'high\', label: \'High\' },\n];\n\nexport function SettingsPanel({\n  settings,\n  onUpdateSettings,\n  onClose,\n  closeLabel = \'Back\',\n}: SettingsPanelProps) {\n  return (\n    <div className=\"w-full max-w-xl border border-slate-700/80 bg-[#050c1d]/94 p-6 sm:p-8\">\n      <div className=\"flex items-center justify-between border-b border-slate-800 pb-4\">\n        <div>\n          <h2 className=\"font-display text-2xl font-semibold tracking-wide text-slate-100\">\n            Flight & Audio Settings\n          </h2>\n          <p className=\"mt-0.5 text-xs text-slate-400\">\n            Changes apply immediately and are saved locally in your browser.\n          </p>\n        </div>\n        <button\n          type=\"button\"\n          onClick={() => {\n            AudioManager.playUiClick(\'secondary\');\n            onUpdateSettings({ ...DEFAULT_SETTINGS });\n          }}\n          className=\"border border-slate-700 px-3 py-1.5 text-xs font-medium text-slate-300 transition-colors hover:border-cyan-400/60 hover:text-cyan-200 whitespace-nowrap shrink-0\"\n        >\n          Reset Defaults\n        </button>\n      </div>\n\n      <div className=\"mt-6 space-y-5\">\n        {/* Mouse Sensitivity */}\n        <div>\n          <div className=\"flex items-center justify-between text-sm\">\n            <label htmlFor=\"setting-mouse-sens\" className=\"font-medium text-slate-200\">\n              Mouse Sensitivity\n            </label>\n            <span className=\"font-mono text-xs tabular-nums text-cyan-300\">\n              {settings.mouseSensitivity.toFixed(2)}x\n            </span>\n          </div>\n          <input\n            id=\"setting-mouse-sens\"\n            type=\"range\"\n            min={0.3}\n            max={2.4}\n            step={0.05}\n            value={settings.mouseSensitivity}\n            onChange={(e) => onUpdateSettings({ mouseSensitivity: parseFloat(e.target.value) })}\n            className=\"starfall-slider mt-2 w-full\"\n          />\n        </div>\n\n        {/* Camera Distance */}\n        <div>\n          <div className=\"flex items-center justify-between text-sm\">\n            <label htmlFor=\"setting-cam-dist\" className=\"font-medium text-slate-200\">\n              Chase Camera Distance\n            </label>\n            <span className=\"font-mono text-xs tabular-nums text-cyan-300\">\n              {settings.cameraDistance.toFixed(1)} m\n            </span>\n          </div>\n          <input\n            id=\"setting-cam-dist\"\n            type=\"range\"\n            min={7.2}\n            max={13.5}\n            step={0.2}\n            value={settings.cameraDistance}\n            onChange={(e) => onUpdateSettings({ cameraDistance: parseFloat(e.target.value) })}\n            className=\"starfall-slider mt-2 w-full\"\n          />\n        </div>\n\n        {/* Camera Tracking Sensitivity */}\n        <div>\n          <div className=\"flex items-center justify-between text-sm\">\n            <label htmlFor=\"setting-cam-sens\" className=\"font-medium text-slate-200\">\n              Camera Tracking Responsiveness\n            </label>\n            <span className=\"font-mono text-xs tabular-nums text-cyan-300\">\n              {settings.cameraSensitivity.toFixed(2)}x\n            </span>\n          </div>\n          <input\n            id=\"setting-cam-sens\"\n            type=\"range\"\n            min={0.6}\n            max={1.6}\n            step={0.05}\n            value={settings.cameraSensitivity}\n            onChange={(e) => onUpdateSettings({ cameraSensitivity: parseFloat(e.target.value) })}\n            className=\"starfall-slider mt-2 w-full\"\n          />\n        </div>\n\n        {/* Master Audio Volume */}\n        <div>\n          <div className=\"flex items-center justify-between text-sm\">\n            <label htmlFor=\"setting-volume\" className=\"font-medium text-slate-200\">\n              Master Audio Volume\n            </label>\n            <div className=\"flex items-center gap-3\">\n              <button\n                type=\"button\"\n                onClick={() => {\n                  AudioManager.unlock();\n                  AudioManager.playUiClick(\'primary\');\n                }}\n                className=\"flex items-center gap-1.5 text-xs text-cyan-300 transition-colors hover:text-cyan-200\"\n              >\n                <Volume2 className=\"h-3.5 w-3.5\" />\n                <span>Test Sound</span>\n              </button>\n              <span className=\"font-mono text-xs tabular-nums text-cyan-300\">\n                {Math.round(settings.masterVolume * 100)}%\n              </span>\n            </div>\n          </div>\n          <input\n            id=\"setting-volume\"\n            type=\"range\"\n            min={0}\n            max={1}\n            step={0.05}\n            value={settings.masterVolume}\n            onChange={(e) => {\n              const v = parseFloat(e.target.value);\n              onUpdateSettings({ masterVolume: v });\n              AudioManager.setMasterVolume(v);\n            }}\n            className=\"starfall-slider mt-2 w-full\"\n          />\n        </div>\n\n        {/* Toggle Rows: Invert Pitch & Performance Readout */}\n        <div className=\"grid grid-cols-1 gap-3 border-t border-slate-800/90 pt-4 sm:grid-cols-2\">\n          <label className=\"flex cursor-pointer items-center justify-between border border-slate-800 bg-[#081226] px-3.5 py-2.5 text-xs text-slate-200\">\n            <span>Invert Pitch (Y-Axis)</span>\n            <input\n              type=\"checkbox\"\n              checked={settings.invertY}\n              onChange={(e) => {\n                AudioManager.playUiClick(\'secondary\');\n                onUpdateSettings({ invertY: e.target.checked });\n              }}\n              className=\"h-4 w-4 accent-cyan-400\"\n            />\n          </label>\n\n          <label className=\"flex cursor-pointer items-center justify-between border border-slate-800 bg-[#081226] px-3.5 py-2.5 text-xs text-slate-200\">\n            <span>Show Performance Stats</span>\n            <input\n              type=\"checkbox\"\n              checked={settings.showPerfOverlay}\n              onChange={(e) => {\n                AudioManager.playUiClick(\'secondary\');\n                onUpdateSettings({ showPerfOverlay: e.target.checked });\n              }}\n              className=\"h-4 w-4 accent-cyan-400\"\n            />\n          </label>\n        </div>\n\n        {/* Graphics Quality Segmented Control */}\n        <div className=\"flex flex-wrap items-center justify-between gap-3 border-t border-slate-800/90 pt-4\">\n          <div>\n            <span className=\"text-sm font-medium text-slate-200\">Graphics Quality</span>\n            <p className=\"text-xs text-slate-400\">Scales resolution, star density, and draw distance.</p>\n          </div>\n          <div className=\"flex items-center border border-slate-700 bg-[#081226] p-1\">\n            {QUALITY_OPTIONS.map((opt) => {\n              const active = settings.graphicsQuality === opt.value;\n              return (\n                <button\n                  key={opt.value}\n                  type=\"button\"\n                  onClick={() => {\n                    AudioManager.playUiClick(\'secondary\');\n                    onUpdateSettings({ graphicsQuality: opt.value });\n                  }}\n                  className={`px-3.5 py-1.5 text-xs font-medium transition-colors whitespace-nowrap shrink-0 ${\n                    active\n                      ? \'bg-cyan-500 text-slate-950\'\n                      : \'text-slate-300 hover:text-cyan-200\'\n                  }`}\n                >\n                  {opt.label}\n                </button>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n\n      <div className=\"mt-7 flex justify-end border-t border-slate-800 pt-4\">\n        <button\n          type=\"button\"\n          onClick={() => {\n            AudioManager.playUiClick(\'primary\');\n            onClose();\n          }}\n          className=\"bg-cyan-500 px-6 py-2.5 text-sm font-semibold text-slate-950 transition-colors hover:bg-cyan-400 focus-visible:outline-2 focus-visible:outline-cyan-300 whitespace-nowrap shrink-0\"\n        >\n          {closeLabel}\n        </button>\n      </div>\n    </div>\n  );\n}\n"
