      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add mission difficulty level, priority target flag, and squad coordination timer to combat types\", \"EndLine\":201, \"Instruction\":\"Add DifficultyLevel import and extend EnemyEntity, DestructionEvent, and ProjectedEnemyMarker for campaign missions\", \"ReplacementContent\":\"export interface EnemyEntity {\\n  id: EntityId;\\n  callsign: string;\\n  shipId: ShipId;\\n  personality: BotPersonality;\\n  difficulty: number; // 1..5\\n  difficultyLevel?: \'rookie\' | \'normal\' | \'veteran\' | \'expert\' | \'elite\';\\n  isPriorityTarget?: boolean;\\n  active: boolean;\\n  position: THREE.Vector3;\\n  quaternion: THREE.Quaternion;\\n  velocity: THREE.Vector3;\\n  visualBankAngle: number;\\n  collisionRadius: number;\\n  health: HealthState;\\n  aiState: BotAIState;\\n  aiStateTimer: number;\\n  reactionTimer: number;\\n  coordinationTimer: number;\\n  weaponCooldown: number;\\n  burstTimer: number;\\n  burstActive: boolean;\\n  muzzleIndex: number;\\n  patrolAnchor: THREE.Vector3;\\n  patrolAngle: number;\\n  flankSign: 1 | -1;\\n  evadeDir: THREE.Vector3;\\n  repositionPoint: THREE.Vector3;\\n  hitFlashTimer: number;\\n  muzzleFlashTimer: number;\\n}\\n\\n/**\\n * Serializable combat event payloads structured for future host-authoritative multiplayer sync.\\n */\\nexport interface WeaponFireEvent {\\n  shooterId: EntityId;\\n  faction: Faction;\\n  weaponId: string;\\n  origin: THREE.Vector3;\\n  direction: THREE.Vector3;\\n  timestamp: number;\\n}\\n\\nexport interface DamageEvent {\\n  targetId: EntityId;\\n  attackerId: EntityId;\\n  weaponId: string;\\n  amount: number;\\n  remainingHealth: number;\\n  maxHealth: number;\\n  destroyed: boolean;\\n  hitPoint: THREE.Vector3;\\n  timestamp: number;\\n}\\n\\nexport interface DestructionEvent {\\n  entityId: EntityId;\\n  callsign?: string;\\n  isPriorityTarget?: boolean;\\n  faction: Faction;\\n  killerId: EntityId;\\n  position: THREE.Vector3;\\n  timestamp: number;\\n}\\n\\nexport interface CombatStats {\\n  kills: number;\\n  shotsFired: number;\\n  shotsHit: number;\\n  damageDealt: number;\\n  damageTaken: number;\\n  score: number;\\n  wave: number;\\n  activeEnemies: number;\\n}\\n\\n/**\\n * Pre-allocated screen-space projection record for zero-allocation HUD enemy brackets.\\n */\\nexport interface ProjectedEnemyMarker {\\n  active: boolean;\\n  entityId: EntityId;\\n  callsign: string;\\n  personalityLabel: string;\\n  aiState: BotAIState;\\n  /** Normalized viewport coords [0..1] */\\n  screenX: number;\\n  screenY: number;\\n  /** Whether inside camera frustum in front of viewer */\\n  inFront: boolean;\\n  onScreen: boolean;\\n  distance: number;\\n  healthRatio: number;\\n  isPrimaryTarget: boolean;\\n  isPriorityTarget: boolean;\\n  /** Screen-space lead pip [0..1] for primary target */\\n  leadX: number;\\n  leadY: number;\\n  leadVisible: boolean;\\n}\", \"StartLine\":106, \"TargetContent\":\"export interface EnemyEntity {\\n  id: EntityId;\\n  callsign: string;\\n  shipId: ShipId;\\n  personality: BotPersonality;\\n  difficulty: number; // 1..5\\n  active: boolean;\\n  position: THREE.Vector3;\\n  quaternion: THREE.Quaternion;\\n  velocity: THREE.Vector3;\\n  visualBankAngle: number;\\n  collisionRadius: number;\\n  health: HealthState;\\n  aiState: BotAIState;\\n  aiStateTimer: number;\\n  reactionTimer: number;\\n  weaponCooldown: number;\\n  burstTimer: number;\\n  burstActive: boolean;\\n  muzzleIndex: number;\\n  patrolAnchor: THREE.Vector3;\\n  patrolAngle: number;\\n  flankSign: 1 | -1;\\n  evadeDir: THREE.Vector3;\\n  repositionPoint: THREE.Vector3;\\n  hitFlashTimer: number;\\n  muzzleFlashTimer: number;\\n}\\n\\n/**\\n * Serializable combat event payloads structured for future host-authoritative multiplayer sync.\\n */\\nexport interface WeaponFireEvent {\\n  shooterId: EntityId;\\n  faction: Faction;\\n  weaponId: string;\\n  origin: THREE.Vector3;\\n  direction: THREE.Vector3;\\n  timestamp: number;\\n}\\n\\nexport interface DamageEvent {\\n  targetId: EntityId;\\n  attackerId: EntityId;\\n  weaponId: string;\\n  amount: number;\\n  remainingHealth: number;\\n  maxHealth: number;\\n  destroyed: boolean;\\n  hitPoint: THREE.Vector3;\\n  timestamp: number;\\n}\\n\\nexport interface DestructionEvent {\\n  entityId: EntityId;\\n  faction: Faction;\\n  killerId: EntityId;\\n  position: THREE.Vector3;\\n  timestamp: number;\\n}\\n\\nexport interface CombatStats {\\n  kills: number;\\n  shotsFired: number;\\n  shotsHit: number;\\n  damageDealt: number;\\n  damageTaken: number;\\n  score: number;\\n  wave: number;\\n  activeEnemies: number;\\n}\\n\\n/**\\n * Pre-allocated screen-space projection record for zero-allocation HUD enemy brackets.\\n */\\nexport interface ProjectedEnemyMarker {\\n  active: boolean;\\n  entityId: EntityId;\\n  callsign: string;\\n  personalityLabel: string;\\n  aiState: BotAIState;\\n  /** Normalized viewport coords [0..1] */\\n  screenX: number;\\n  screenY: number;\\n  /** Whether inside camera frustum in front of viewer */\\n  inFront: boolean;\\n  onScreen: boolean;\\n  distance: number;\\n  healthRatio: number;\\n  isPrimaryTarget: boolean;\\n  /** Screen-space lead pip [0..1] for primary target */\\n  leadX: number;\\n  leadY: number;\\n  leadVisible: boolean;\\n}\", \"TargetFile\":\"/src/types/combat.ts\", \"toolAction\":\"Updating combat types\", \"toolSummary\":\"Update combat types\"}"
