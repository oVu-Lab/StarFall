      id: "call_4254194984016236507"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Sync FlightHUD aiming boundary frame size with configurable aimBoundarySize and add subtle zero-allocation zone tint feedback on the reticle and boundary ring\", \"Instruction\":\"Update FlightHUD imports, boundary sync logic, and dynamic boundary box styling\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":8, \"ReplacementContent\":\"import { PROGRESSIVE_STEERING_CONFIG } from \'../engine/FlightController\';\\nimport type { FlightTelemetry, GameSettings, ShipId } from \'../types/game\';\", \"StartLine\":4, \"TargetContent\":\"import { VIRTUAL_AIM_CONFIG } from \'../engine/FlightController\';\\nimport type { FlightTelemetry, GameSettings, ShipId } from \'../types/game\';\"}, {\"AllowMultiple\":false, \"EndLine\":215, \"ReplacementContent\":\"      if (aimReticleRef.current) {\\n        aimReticleRef.current.style.transform = `translate3d(${aimPxX.toFixed(1)}px, ${aimPxY.toFixed(1)}px, 0) translate(-50%, -50%)`;\\n        aimReticleRef.current.dataset.steeringZone = t.steeringZone;\\n        aimReticleRef.current.dataset.sensX = t.steeringSensitivityX.toFixed(3);\\n        aimReticleRef.current.dataset.sensY = t.steeringSensitivityY.toFixed(3);\\n        aimReticleRef.current.style.color =\\n          t.steeringZone === \'acceleration\'\\n            ? \'#e0f2fe\'\\n            : t.steeringZone === \'transition\'\\n              ? \'#fcd34d\'\\n              : \'rgba(165, 243, 252, 0.95)\';\\n      }\\n\\n      if (boresightRef.current) {\\n        const recoilScale = t.isFiring ? 1 + t.weaponCooldownRatio * 0.14 : 1;\\n        boresightRef.current.style.transform = `translate3d(${borePxX.toFixed(1)}px, ${borePxY.toFixed(1)}px, 0) translate(-50%, -50%) scale(${recoilScale.toFixed(3)})`;\\n      }\\n\\n      if (aimRingRef.current) {\\n        const ringScale = 1 + t.boostIntensity * 0.24 + (t.isFiring ? 0.08 : 0);\\n        aimRingRef.current.style.transform = `scale(${ringScale.toFixed(3)})`;\\n        aimRingRef.current.style.opacity = String(\\n          (0.24 + t.boostIntensity * 0.45 + (t.isFiring ? 0.22 : 0)).toFixed(2),\\n        );\\n      }\\n\\n      if (aimBoundaryRef.current) {\\n        const deflection = Math.max(Math.abs(t.aimNormalizedX), Math.abs(t.aimNormalizedY));\\n        const edgeOp =\\n          t.steeringZone === \'acceleration\'\\n            ? 0.28 + t.steeringAccelRatio * 0.22\\n            : t.steeringZone === \'transition\'\\n              ? 0.28\\n              : deflection > 0.15\\n                ? 0.07 + Math.min(1, deflection) * 0.16\\n                : 0.06;\\n        aimBoundaryRef.current.style.opacity = edgeOp.toFixed(2);\\n        aimBoundaryRef.current.style.borderColor =\\n          t.steeringZone === \'acceleration\'\\n            ? \'rgba(125, 211, 252, 0.85)\'\\n            : t.steeringZone === \'transition\'\\n              ? \'rgba(251, 191, 36, 0.75)\'\\n              : \'rgba(103, 232, 249, 0.55)\';\\n      }\", \"StartLine\":186, \"TargetContent\":\"      if (aimReticleRef.current) {\\n        aimReticleRef.current.style.transform = `translate3d(${aimPxX.toFixed(1)}px, ${aimPxY.toFixed(1)}px, 0) translate(-50%, -50%)`;\\n      }\\n\\n      if (boresightRef.current) {\\n        const recoilScale = t.isFiring ? 1 + t.weaponCooldownRatio * 0.14 : 1;\\n        boresightRef.current.style.transform = `translate3d(${borePxX.toFixed(1)}px, ${borePxY.toFixed(1)}px, 0) translate(-50%, -50%) scale(${recoilScale.toFixed(3)})`;\\n      }\\n\\n      if (aimRingRef.current) {\\n        const ringScale = 1 + t.boostIntensity * 0.24 + (t.isFiring ? 0.08 : 0);\\n        aimRingRef.current.style.transform = `scale(${ringScale.toFixed(3)})`;\\n        aimRingRef.current.style.opacity = String(\\n          (0.24 + t.boostIntensity * 0.45 + (t.isFiring ? 0.22 : 0)).toFixed(2),\\n        );\\n      }\\n\\n      if (aimBoundaryRef.current) {\\n        const deflection = Math.hypot(t.aimNormalizedX, t.aimNormalizedY);\\n        const edgeOp = deflection > 0.15 ? 0.08 + Math.min(1, deflection) * 0.18 : 0.06;\\n        aimBoundaryRef.current.style.opacity = edgeOp.toFixed(2);\\n      }\"}, {\"AllowMultiple\":false, \"EndLine\":443, \"ReplacementContent\":\"      {/* Subtle Configurable Precision Aiming Boundary Frame */}\\n      <div\\n        ref={aimBoundaryRef}\\n        data-testid=\\\"aim-boundary-frame\\\"\\n        className=\\\"pointer-events-none fixed left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-3xl border border-cyan-300/55\\\"\\n        style={{\\n          width: `${settings.aimBoundarySize * 200}vw`,\\n          height: `${Math.min(PROGRESSIVE_STEERING_CONFIG.maxVerticalScreenOffset, settings.aimBoundarySize * PROGRESSIVE_STEERING_CONFIG.verticalScreenAspectRatio) * 200}vh`,\\n          opacity: 0.06,\\n          willChange: \'opacity, border-color\',\\n        }}\\n        aria-hidden=\\\"true\\\"\\n      />\", \"StartLine\":428, \"TargetContent\":\"      {/* Subtle Bounded Virtual Aiming Region Ring */}\\n      <div\\n        ref={aimBoundaryRef}\\n        className=\\\"pointer-events-none fixed left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full border border-cyan-300/65\\\"\\n        style={{\\n          width: `${VIRTUAL_AIM_CONFIG.maxScreenOffsetX * 200}vw`,\\n          height: `${VIRTUAL_AIM_CONFIG.maxScreenOffsetY * 200}vh`,\\n          opacity: 0.06,\\n          willChange: \'opacity\',\\n        }}\\n        aria-hidden=\\\"true\\\"\\n      />\"}, {\"AllowMultiple\":false, \"EndLine\":522, \"ReplacementContent\":\"      {/* Persistent Virtual Mouse Steering Cursor (Progressive 3-Zone Envelope) */}\\n      <div\\n        ref={aimReticleRef}\\n        data-testid=\\\"virtual-mouse-cursor\\\"\\n        className=\\\"pointer-events-none fixed left-0 top-0 flex items-center justify-center text-cyan-200/95\\\"\\n        style={{ transform: \'translate3d(50vw, 50vh, 0) translate(-50%, -50%)\', willChange: \'transform\' }}\\n      >\\n        <svg width=\\\"46\\\" height=\\\"46\\\" viewBox=\\\"0 0 46 46\\\">\", \"StartLine\":507, \"TargetContent\":\"      {/* Persistent Virtual Mouse Steering Cursor (Bounded Elliptical Combat Envelope) */}\\n      <div\\n        ref={aimReticleRef}\\n        data-testid=\\\"virtual-mouse-cursor\\\"\\n        className=\\\"pointer-events-none fixed left-0 top-0 flex items-center justify-center\\\"\\n        style={{ transform: \'translate3d(50vw, 50vh, 0) translate(-50%, -50%)\', willChange: \'transform\' }}\\n      >\\n        <svg width=\\\"46\\\" height=\\\"46\\\" viewBox=\\\"0 0 46 46\\\" className=\\\"text-cyan-200/95\\\">\"}], \"TargetFile\":\"/src/components/FlightHUD.tsx\", \"toolAction\":\"Updating FlightHUD boundary and zone feedback\", \"toolSummary\":\"Update FlightHUD for progressive steering\"}"
      original_name: "multi_replace_file_content"
    }
    tool_calls {
      id: "call_4254194984016235874"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Expose all six configurable progressive mouse steering settings and a live response curve visualizer in SettingsPanel\", \"EndLine\":208, \"Instruction\":\"Add Base Sensitivity, Boundary Sensitivity, Maximum Sensitivity, Acceleration Distance, Response Curve, Aim Boundary Size sliders and live curve preview in src/components/SettingsPanel.tsx\", \"ReplacementContent\":\"import { useMemo } from \'react\';\\nimport { Volume2 } from \'lucide-react\';\\nimport { AudioManager } from \'../audio/AudioManager\';\\nimport { getGraphicsPresetPatch } from \'../config/graphics\';\\nimport { DEFAULT_SETTINGS } from \'../config/ships\';\\nimport {\\n  evaluateProgressiveAxisSensitivity,\\n  PROGRESSIVE_STEERING_CONFIG,\\n} from \'../engine/FlightController\';\\nimport type {\\n  EffectQuality,\\n  GameSettings,\\n  GraphicsQuality,\\n  ShadowQuality,\\n} from \'../types/game\';\\n\\ninterface SettingsPanelProps {\\n  settings: GameSettings;\\n  onUpdateSettings: (patch: Partial<GameSettings>) => void;\\n  onClose: () => void;\\n  closeLabel?: string;\\n}\\n\\nconst QUALITY_OPTIONS: Array<{ value: GraphicsQuality; label: string }> = [\\n  { value: \'low\', label: \'Low\' },\\n  { value: \'medium\', label: \'Medium\' },\\n  { value: \'high\', label: \'High\' },\\n  { value: \'ultra\', label: \'Ultra\' },\\n];\\n\\nconst SHADOW_OPTIONS: Array<{ value: ShadowQuality; label: string }> = [\\n  { value: \'off\', label: \'Off\' },\\n  { value: \'low\', label: \'Low\' },\\n  { value: \'medium\', label: \'Med\' },\\n  { value: \'high\', label: \'High\' },\\n];\\n\\nconst EFFECT_OPTIONS: Array<{ value: EffectQuality; label: string }> = [\\n  { value: \'low\', label: \'Low\' },\\n  { value: \'medium\', label: \'Med\' },\\n  { value: \'high\', label: \'High\' },\\n];\\n\\nfunction SteeringCurvePreview({ settings }: { settings: GameSettings }) {\\n  const { pathD, boundaryXPos } = useMemo(() => {\\n    const W = 240;\\n    const H = 64;\\n    const padX = 8;\\n    const padY = 8;\\n    const plotW = W - padX * 2;\\n    const plotH = H - padY * 2;\\n    const B = settings.aimBoundarySize * PROGRESSIVE_STEERING_CONFIG.boundaryPixelsPerFraction;\\n    const S = settings.accelerationDistance;\\n    const maxDisp = B + S * 3.0;\\n    const maxY = Math.max(3.6, settings.maxSensitivity + 0.25);\\n\\n    const pts: string[] = [];\\n    const steps = 48;\\n    for (let i = 0; i <= steps; i++) {\\n      const frac = i / steps;\\n      const disp = frac * maxDisp;\\n      const res = evaluateProgressiveAxisSensitivity(\\n        disp,\\n        B,\\n        S,\\n        settings.boundarySensitivity,\\n        settings.maxSensitivity,\\n        settings.responseCurve,\\n      );\\n      const px = padX + frac * plotW;\\n      const py = padY + plotH - (res.targetSensitivity / maxY) * plotH;\\n      pts.push(`${i === 0 ? \'M\' : \'L\'}${px.toFixed(1)},${py.toFixed(1)}`);\\n    }\\n\\n    const bx = padX + (B / maxDisp) * plotW;\\n    return { pathD: pts.join(\' \'), boundaryXPos: bx };\\n  }, [\\n    settings.aimBoundarySize,\\n    settings.accelerationDistance,\\n    settings.boundarySensitivity,\\n    settings.maxSensitivity,\\n    settings.responseCurve,\\n  ]);\\n\\n  return (\\n    <div className=\\\"border border-slate-800 bg-[#060f21] px-2.5 py-2\\\">\\n      <div className=\\\"mb-1 flex items-center justify-between font-mono text-[10px] text-slate-400\\\">\\n        <span>RESPONSE CURVE (PRECISION \302\267 TRANSITION \302\267 ACCEL)</span>\\n        <span className=\\\"text-cyan-300\\\">f(e)=e^p/(1+e^p)</span>\\n      </div>\\n      <svg\\n        viewBox=\\\"0 0 240 64\\\"\\n        className=\\\"h-14 w-full\\\"\\n        aria-label=\\\"Progressive mouse steering response curve\\\"\\n      >\\n        {/* 1.0x reference line */}\\n        <line\\n          x1=\\\"8\\\"\\n          y1=\\\"42.7\\\"\\n          x2=\\\"232\\\"\\n          y2=\\\"42.7\\\"\\n          stroke=\\\"rgba(148,163,184,0.22)\\\"\\n          strokeDasharray=\\\"3 3\\\"\\n          strokeWidth=\\\"1\\\"\\n        />\\n        {/* Boundary B marker */}\\n        <line\\n          x1={boundaryXPos.toFixed(1)}\\n          y1=\\\"6\\\"\\n          x2={boundaryXPos.toFixed(1)}\\n          y2=\\\"58\\\"\\n          stroke=\\\"rgba(251,191,36,0.55)\\\"\\n          strokeDasharray=\\\"2 2\\\"\\n          strokeWidth=\\\"1\\\"\\n        />\\n        <path d={pathD} fill=\\\"none\\\" stroke=\\\"#38bdf8\\\" strokeWidth=\\\"2\\\" />\\n      </svg>\\n    </div>\\n  );\\n}\\n\\nexport function SettingsPanel({\\n  settings,\\n  onUpdateSettings,\\n  onClose,\\n  closeLabel = \'Back\',\\n}: SettingsPanelProps) {\\n  return (\\n    <div className=\\\"max-h-[90vh] w-full max-w-3xl overflow-y-auto border border-slate-700/80 bg-[#050c1d]/96 p-6 sm:p-7\\\">\\n      <div className=\\\"flex items-center justify-between border-b border-slate-800 pb-4\\\">\\n        <div>\\n          <h2 className=\\\"font-display text-2xl font-semibold tracking-wide text-slate-100\\\">\\n            Flight, Graphics & Audio Settings\\n          </h2>\\n          <p className=\\\"mt-0.5 text-xs text-slate-400\\\">\\n            All graphics and progressive steering parameters apply immediately and persist locally.\\n          </p>\\n        </div>\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => {\\n            AudioManager.playUiClick(\'secondary\');\\n            onUpdateSettings({ ...DEFAULT_SETTINGS });\\n          }}\\n          className=\\\"border border-slate-700 px-3 py-1.5 text-xs font-medium text-slate-300 transition-colors hover:border-cyan-400/60 hover:text-cyan-200 whitespace-nowrap shrink-0\\\"\\n        >\\n          Reset Defaults\\n        </button>\\n      </div>\\n\\n      <div className=\\\"mt-5 grid grid-cols-1 gap-6 md:grid-cols-2\\\">\\n        {/* Left Column: Progressive Mouse Steering, Camera & Audio */}\\n        <div className=\\\"space-y-3.5\\\">\\n          <h3 className=\\\"font-mono text-[11px] tracking-widest text-cyan-300\\\">\\n            PROGRESSIVE MOUSE STEERING\\n          </h3>\\n\\n          <SteeringCurvePreview settings={settings} />\\n\\n          <div>\\n            <div className=\\\"flex items-center justify-between text-xs\\\">\\n              <label htmlFor=\\\"setting-mouse-sens\\\" className=\\\"font-medium text-slate-200\\\">\\n                Base Sensitivity\\n              </label>\\n              <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                {settings.mouseSensitivity.toFixed(2)}x\\n              </span>\\n            </div>\\n            <input\\n              id=\\\"setting-mouse-sens\\\"\\n              type=\\\"range\\\"\\n              min={0.3}\\n              max={2.5}\\n              step={0.05}\\n              value={settings.mouseSensitivity}\\n              onChange={(e) => onUpdateSettings({ mouseSensitivity: parseFloat(e.target.value) })}\\n              className=\\\"starfall-slider mt-1 w-full\\\"\\n            />\\n          </div>\\n\\n          <div>\\n            <div className=\\\"flex items-center justify-between text-xs\\\">\\n              <label htmlFor=\\\"setting-boundary-sens\\\" className=\\\"font-medium text-slate-200\\\">\\n                Boundary Sensitivity\\n              </label>\\n              <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                {settings.boundarySensitivity.toFixed(2)}x\\n              </span>\\n            </div>\\n            <input\\n              id=\\\"setting-boundary-sens\\\"\\n              type=\\\"range\\\"\\n              min={0.15}\\n              max={1.0}\\n              step={0.05}\\n              value={settings.boundarySensitivity}\\n              onChange={(e) =>\\n                onUpdateSettings({ boundarySensitivity: parseFloat(e.target.value) })\\n              }\\n              className=\\\"starfall-slider mt-1 w-full\\\"\\n            />\\n          </div>\\n\\n          <div>\\n            <div className=\\\"flex items-center justify-between text-xs\\\">\\n              <label htmlFor=\\\"setting-max-sens\\\" className=\\\"font-medium text-slate-200\\\">\\n                Maximum Sensitivity\\n              </label>\\n              <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                {settings.maxSensitivity.toFixed(2)}x\\n              </span>\\n            </div>\\n            <input\\n              id=\\\"setting-max-sens\\\"\\n              type=\\\"range\\\"\\n              min={1.2}\\n              max={3.5}\\n              step={0.1}\\n              value={settings.maxSensitivity}\\n              onChange={(e) => onUpdateSettings({ maxSensitivity: parseFloat(e.target.value) })}\\n              className=\\\"starfall-slider mt-1 w-full\\\"\\n            />\\n          </div>\\n\\n          <div>\\n            <div className=\\\"flex items-center justify-between text-xs\\\">\\n              <label htmlFor=\\\"setting-accel-dist\\\" className=\\\"font-medium text-slate-200\\\">\\n                Acceleration Distance\\n              </label>\\n              <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                {Math.round(settings.accelerationDistance)} px\\n              </span>\\n            </div>\\n            <input\\n              id=\\\"setting-accel-dist\\\"\\n              type=\\\"range\\\"\\n              min={80}\\n              max={500}\\n              step={10}\\n              value={settings.accelerationDistance}\\n              onChange={(e) =>\\n                onUpdateSettings({ accelerationDistance: parseFloat(e.target.value) })\\n              }\\n              className=\\\"starfall-slider mt-1 w-full\\\"\\n            />\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-2 gap-3\\\">\\n            <div>\\n              <div className=\\\"flex items-center justify-between text-xs\\\">\\n                <label htmlFor=\\\"setting-response-curve\\\" className=\\\"font-medium text-slate-200\\\">\\n                  Response Curve\\n                </label>\\n                <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                  p={settings.responseCurve.toFixed(1)}\\n                </span>\\n              </div>\\n              <input\\n                id=\\\"setting-response-curve\\\"\\n                type=\\\"range\\\"\\n                min={1.0}\\n                max={3.5}\\n                step={0.1}\\n                value={settings.responseCurve}\\n                onChange={(e) => onUpdateSettings({ responseCurve: parseFloat(e.target.value) })}\\n                className=\\\"starfall-slider mt-1 w-full\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <div className=\\\"flex items-center justify-between text-xs\\\">\\n                <label htmlFor=\\\"setting-aim-boundary\\\" className=\\\"font-medium text-slate-200\\\">\\n                  Aim Boundary Size\\n                </label>\\n                <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                  {Math.round(settings.aimBoundarySize * 100)}%\\n                </span>\\n              </div>\\n              <input\\n                id=\\\"setting-aim-boundary\\\"\\n                type=\\\"range\\\"\\n                min={0.15}\\n                max={0.38}\\n                step={0.01}\\n                value={settings.aimBoundarySize}\\n                onChange={(e) => onUpdateSettings({ aimBoundarySize: parseFloat(e.target.value) })}\\n                className=\\\"starfall-slider mt-1 w-full\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          <h3 className=\\\"pt-1 font-mono text-[11px] tracking-widest text-cyan-300\\\">\\n            CAMERA & AUDIO\\n          </h3>\\n\\n          <div className=\\\"grid grid-cols-2 gap-3\\\">\\n            <div>\\n              <div className=\\\"flex items-center justify-between text-xs\\\">\\n                <label htmlFor=\\\"setting-cam-dist\\\" className=\\\"font-medium text-slate-200\\\">\\n                  Camera Distance\\n                </label>\\n                <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                  {settings.cameraDistance.toFixed(1)} m\\n                </span>\\n              </div>\\n              <input\\n                id=\\\"setting-cam-dist\\\"\\n                type=\\\"range\\\"\\n                min={7.2}\\n                max={13.5}\\n                step={0.2}\\n                value={settings.cameraDistance}\\n                onChange={(e) => onUpdateSettings({ cameraDistance: parseFloat(e.target.value) })}\\n                className=\\\"starfall-slider mt-1 w-full\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <div className=\\\"flex items-center justify-between text-xs\\\">\\n                <label htmlFor=\\\"setting-cam-sens\\\" className=\\\"font-medium text-slate-200\\\">\\n                  Camera Follow\\n                </label>\\n                <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                  {settings.cameraSensitivity.toFixed(2)}x\\n                </span>\\n              </div>\\n              <input\\n                id=\\\"setting-cam-sens\\\"\\n                type=\\\"range\\\"\\n                min={0.6}\\n                max={1.6}\\n                step={0.05}\\n                value={settings.cameraSensitivity}\\n                onChange={(e) =>\\n                  onUpdateSettings({ cameraSensitivity: parseFloat(e.target.value) })\\n                }\\n                className=\\\"starfall-slider mt-1 w-full\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          <div>\\n            <div className=\\\"flex items-center justify-between text-xs\\\">\\n              <label htmlFor=\\\"setting-volume\\\" className=\\\"font-medium text-slate-200\\\">\\n                Master Volume\\n              </label>\\n              <div className=\\\"flex items-center gap-2.5\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    AudioManager.unlock();\\n                    AudioManager.playUiClick(\'primary\');\\n                  }}\\n                  className=\\\"flex items-center gap-1 text-[11px] text-cyan-300 hover:text-cyan-200\\\"\\n                >\\n                  <Volume2 className=\\\"h-3 w-3\\\" />\\n                  <span>Test</span>\\n                </button>\\n                <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                  {Math.round(settings.masterVolume * 100)}%\\n                </span>\\n              </div>\\n            </div>\\n            <input\\n              id=\\\"setting-volume\\\"\\n              type=\\\"range\\\"\\n              min={0}\\n              max={1}\\n              step={0.05}\\n              value={settings.masterVolume}\\n              onChange={(e) => {\\n                const v = parseFloat(e.target.value);\\n                onUpdateSettings({ masterVolume: v });\\n                AudioManager.setMasterVolume(v);\\n              }}\\n              className=\\\"starfall-slider mt-1 w-full\\\"\\n            />\\n          </div>\\n\\n          <label className=\\\"flex cursor-pointer items-center justify-between border border-slate-800 bg-[#081226] px-3 py-2 text-xs text-slate-200\\\">\\n            <span>Invert Pitch (Y-Axis)</span>\\n            <input\\n              type=\\\"checkbox\\\"\\n              checked={settings.invertY}\\n              onChange={(e) => {\\n                AudioManager.playUiClick(\'secondary\');\\n                onUpdateSettings({ invertY: e.target.checked });\\n              }}\\n              className=\\\"h-4 w-4 accent-cyan-400\\\"\\n            />\\n          </label>\\n\\n          {/* Development-only performance monitor toggle (completely omitted in production) */}\\n          {import.meta.env.DEV && (\\n            <label className=\\\"flex cursor-pointer items-center justify-between border border-cyan-500/30 bg-[#08142b] px-3 py-2 text-xs text-cyan-200\\\">\\n              <span>Dev Performance Monitor (F3)</span>\\n              <input\\n                type=\\\"checkbox\\\"\\n                checked={settings.showPerfOverlay}\\n                onChange={(e) => {\\n                  AudioManager.playUiClick(\'secondary\');\\n                  onUpdateSettings({ showPerfOverlay: e.target.checked });\\n                }}\\n                className=\\\"h-4 w-4 accent-cyan-400\\\"\\n              />\\n            </label>\\n          )}\\n        </div>\", \"StartLine\":1, \"TargetContent\":\"import { Volume2 } from \'lucide-react\';\\nimport { AudioManager } from \'../audio/AudioManager\';\\nimport { getGraphicsPresetPatch } from \'../config/graphics\';\\nimport { DEFAULT_SETTINGS } from \'../config/ships\';\\nimport type {\\n  EffectQuality,\\n  GameSettings,\\n  GraphicsQuality,\\n  ShadowQuality,\\n} from \'../types/game\';\\n\\ninterface SettingsPanelProps {\\n  settings: GameSettings;\\n  onUpdateSettings: (patch: Partial<GameSettings>) => void;\\n  onClose: () => void;\\n  closeLabel?: string;\\n}\\n\\nconst QUALITY_OPTIONS: Array<{ value: GraphicsQuality; label: string }> = [\\n  { value: \'low\', label: \'Low\' },\\n  { value: \'medium\', label: \'Medium\' },\\n  { value: \'high\', label: \'High\' },\\n  { value: \'ultra\', label: \'Ultra\' },\\n];\\n\\nconst SHADOW_OPTIONS: Array<{ value: ShadowQuality; label: string }> = [\\n  { value: \'off\', label: \'Off\' },\\n  { value: \'low\', label: \'Low\' },\\n  { value: \'medium\', label: \'Med\' },\\n  { value: \'high\', label: \'High\' },\\n];\\n\\nconst EFFECT_OPTIONS: Array<{ value: EffectQuality; label: string }> = [\\n  { value: \'low\', label: \'Low\' },\\n  { value: \'medium\', label: \'Med\' },\\n  { value: \'high\', label: \'High\' },\\n];\\n\\nexport function SettingsPanel({\\n  settings,\\n  onUpdateSettings,\\n  onClose,\\n  closeLabel = \'Back\',\\n}: SettingsPanelProps) {\\n  return (\\n    <div className=\\\"max-h-[90vh] w-full max-w-2xl overflow-y-auto border border-slate-700/80 bg-[#050c1d]/96 p-6 sm:p-7\\\">\\n      <div className=\\\"flex items-center justify-between border-b border-slate-800 pb-4\\\">\\n        <div>\\n          <h2 className=\\\"font-display text-2xl font-semibold tracking-wide text-slate-100\\\">\\n            Flight, Graphics & Audio Settings\\n          </h2>\\n          <p className=\\\"mt-0.5 text-xs text-slate-400\\\">\\n            All graphics and flight parameters apply immediately and persist locally.\\n          </p>\\n        </div>\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => {\\n            AudioManager.playUiClick(\'secondary\');\\n            onUpdateSettings({ ...DEFAULT_SETTINGS });\\n          }}\\n          className=\\\"border border-slate-700 px-3 py-1.5 text-xs font-medium text-slate-300 transition-colors hover:border-cyan-400/60 hover:text-cyan-200 whitespace-nowrap shrink-0\\\"\\n        >\\n          Reset Defaults\\n        </button>\\n      </div>\\n\\n      <div className=\\\"mt-5 grid grid-cols-1 gap-6 md:grid-cols-2\\\">\\n        {/* Left Column: Flight & Audio Controls */}\\n        <div className=\\\"space-y-4\\\">\\n          <h3 className=\\\"font-mono text-[11px] tracking-widest text-cyan-300\\\">\\n            FLIGHT & AUDIO\\n          </h3>\\n\\n          <div>\\n            <div className=\\\"flex items-center justify-between text-xs\\\">\\n              <label htmlFor=\\\"setting-mouse-sens\\\" className=\\\"font-medium text-slate-200\\\">\\n                Mouse Sensitivity\\n              </label>\\n              <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                {settings.mouseSensitivity.toFixed(2)}x\\n              </span>\\n            </div>\\n            <input\\n              id=\\\"setting-mouse-sens\\\"\\n              type=\\\"range\\\"\\n              min={0.3}\\n              max={2.4}\\n              step={0.05}\\n              value={settings.mouseSensitivity}\\n              onChange={(e) => onUpdateSettings({ mouseSensitivity: parseFloat(e.target.value) })}\\n              className=\\\"starfall-slider mt-1.5 w-full\\\"\\n            />\\n          </div>\\n\\n          <div>\\n            <div className=\\\"flex items-center justify-between text-xs\\\">\\n              <label htmlFor=\\\"setting-cam-dist\\\" className=\\\"font-medium text-slate-200\\\">\\n                Chase Camera Distance\\n              </label>\\n              <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                {settings.cameraDistance.toFixed(1)} m\\n              </span>\\n            </div>\\n            <input\\n              id=\\\"setting-cam-dist\\\"\\n              type=\\\"range\\\"\\n              min={7.2}\\n              max={13.5}\\n              step={0.2}\\n              value={settings.cameraDistance}\\n              onChange={(e) => onUpdateSettings({ cameraDistance: parseFloat(e.target.value) })}\\n              className=\\\"starfall-slider mt-1.5 w-full\\\"\\n            />\\n          </div>\\n\\n          <div>\\n            <div className=\\\"flex items-center justify-between text-xs\\\">\\n              <label htmlFor=\\\"setting-cam-sens\\\" className=\\\"font-medium text-slate-200\\\">\\n                Camera Responsiveness\\n              </label>\\n              <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                {settings.cameraSensitivity.toFixed(2)}x\\n              </span>\\n            </div>\\n            <input\\n              id=\\\"setting-cam-sens\\\"\\n              type=\\\"range\\\"\\n              min={0.6}\\n              max={1.6}\\n              step={0.05}\\n              value={settings.cameraSensitivity}\\n              onChange={(e) => onUpdateSettings({ cameraSensitivity: parseFloat(e.target.value) })}\\n              className=\\\"starfall-slider mt-1.5 w-full\\\"\\n            />\\n          </div>\\n\\n          <div>\\n            <div className=\\\"flex items-center justify-between text-xs\\\">\\n              <label htmlFor=\\\"setting-volume\\\" className=\\\"font-medium text-slate-200\\\">\\n                Master Volume\\n              </label>\\n              <div className=\\\"flex items-center gap-2.5\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    AudioManager.unlock();\\n                    AudioManager.playUiClick(\'primary\');\\n                  }}\\n                  className=\\\"flex items-center gap-1 text-[11px] text-cyan-300 hover:text-cyan-200\\\"\\n                >\\n                  <Volume2 className=\\\"h-3 w-3\\\" />\\n                  <span>Test</span>\\n                </button>\\n                <span className=\\\"font-mono tabular-nums text-cyan-300\\\">\\n                  {Math.round(settings.masterVolume * 100)}%\\n                </span>\\n              </div>\\n            </div>\\n            <input\\n              id=\\\"setting-volume\\\"\\n              type=\\\"range\\\"\\n              min={0}\\n              max={1}\\n              step={0.05}\\n              value={settings.masterVolume}\\n              onChange={(e) => {\\n                const v = parseFloat(e.target.value);\\n                onUpdateSettings({ masterVolume: v });\\n                AudioManager.setMasterVolume(v);\\n              }}\\n              className=\\\"starfall-slider mt-1.5 w-full\\\"\\n            />\\n          </div>\\n\\n          <label className=\\\"flex cursor-pointer items-center justify-between border border-slate-800 bg-[#081226] px-3 py-2 text-xs text-slate-200\\\">\\n            <span>Invert Pitch (Y-Axis)</span>\\n            <input\\n              type=\\\"checkbox\\\"\\n              checked={settings.invertY}\\n              onChange={(e) => {\\n                AudioManager.playUiClick(\'secondary\');\\n                onUpdateSettings({ invertY: e.target.checked });\\n              }}\\n              className=\\\"h-4 w-4 accent-cyan-400\\\"\\n            />\\n          </label>\\n\\n          {/* Development-only performance monitor toggle (completely omitted in production) */}\\n          {import.meta.env.DEV && (\\n            <label className=\\\"flex cursor-pointer items-center justify-between border border-cyan-500/30 bg-[#08142b] px-3 py-2 text-xs text-cyan-200\\\">\\n              <span>Dev Performance Monitor (F3)</span>\\n              <input\\n                type=\\\"checkbox\\\"\\n                checked={settings.showPerfOverlay}\\n                onChange={(e) => {\\n                  AudioManager.playUiClick(\'secondary\');\\n                  onUpdateSettings({ showPerfOverlay: e.target.checked });\\n                }}\\n                className=\\\"h-4 w-4 accent-cyan-400\\\"\\n              />\\n            </label>\\n          )}\\n        </div>\", \"TargetFile\":\"/src/components/SettingsPanel.tsx\", \"toolAction\":\"Adding progressive steering sliders and curve preview to SettingsPanel\", \"toolSummary\":\"Add progressive steering settings UI\"}"
      original_name: "replace_file_content"
