    tool_calls {
      id: "call_3009089304264592706"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import * as THREE from \'three\';\\nimport { BOT_PERSONALITIES } from \'../../config/botPersonalities\';\\nimport { WEAPON_CONFIGS } from \'../../config/weapons\';\\nimport type {\\n  CombatStats,\\n  DamageEvent,\\n  DestructionEvent,\\n  EnemyEntity,\\n  HealthState,\\n  ProjectedEnemyMarker,\\n  WeaponConfig,\\n  WeaponFireEvent,\\n} from \'../../types/combat\';\\nimport type { BotPersonality, FlightTelemetry } from \'../../types/game\';\\nimport type { FlightController } from \'../FlightController\';\\nimport type { InputSnapshot } from \'../InputManager\';\\nimport { intersectSegmentSphere, intersectSphereSphere } from \'./CollisionSystem\';\\nimport { EnemyAIController } from \'./EnemyAIController\';\\nimport { applyDamage, createHealthState, getHealthRatio, resetHealthState } from \'./HealthSystem\';\\nimport { ProjectilePool } from \'./ProjectilePool\';\\n\\nexport const PLAYER_ENTITY_ID = \'player-1\';\\nexport const PLAYER_COLLISION_RADIUS = 3.2;\\nexport const ENEMY_COLLISION_RADIUS = 3.6;\\nexport const MAX_ENEMIES = 6;\\n\\nexport interface VfxBurstEvent {\\n  kind: \'impact\' | \'explosion\' | \'player-hit\';\\n  position: THREE.Vector3;\\n  color: string;\\n  scale: number;\\n}\\n\\nexport interface CombatCallbacks {\\n  onPlayerFire?: (evt: WeaponFireEvent) => void;\\n  onEnemyFire?: (evt: WeaponFireEvent) => void;\\n  onDamage?: (evt: DamageEvent) => void;\\n  onDestruction?: (evt: DestructionEvent) => void;\\n  onVfxBurst?: (evt: VfxBurstEvent) => void;\\n}\\n\\n// Reusable scratch math helpers (zero per-frame GC allocations)\\nconst _aimDir = new THREE.Vector3();\\nconst _aimTarget = new THREE.Vector3();\\nconst _muzzleLocal = new THREE.Vector3();\\nconst _muzzleWorld = new THREE.Vector3();\\nconst _fireDir = new THREE.Vector3();\\nconst _hitPoint = new THREE.Vector3();\\nconst _sepVec = new THREE.Vector3();\\nconst _projVec = new THREE.Vector3();\\nconst _leadWorld = new THREE.Vector3();\\nconst _rightVec = new THREE.Vector3();\\nconst _upVec = new THREE.Vector3();\\nconst _forwardVec = new THREE.Vector3();\\n\\nconst CALLSIGN_POOL = [\\n  \'VEX-01\',\\n  \'KRAKEN-2\',\\n  \'SHARD-4\',\\n  \'TALON-7\',\\n  \'RAVEN-3\',\\n  \'SPECTER-9\',\\n];\\n\\n/**\\n * Central combat simulation coordinator.\\n * Owns player weapon firing, pooled projectiles, swept collision detection,\\n * enemy AI waves, health/damage state, and multiplayer-ready event hooks.\\n */\\nexport class CombatManager {\\n  public readonly projectiles = new ProjectilePool(160);\\n  public readonly enemies: EnemyEntity[] = [];\\n  public readonly playerHealth: HealthState;\\n  public readonly stats: CombatStats = {\\n    kills: 0,\\n    shotsFired: 0,\\n    shotsHit: 0,\\n    damageDealt: 0,\\n    damageTaken: 0,\\n    score: 0,\\n    wave: 1,\\n    activeEnemies: 0,\\n  };\\n\\n  private readonly ai = new EnemyAIController();\\n  private playerWeapon: WeaponConfig = WEAPON_CONFIGS.player_pulse_twin;\\n  private playerWeaponCooldown = 0;\\n  private playerMuzzleIndex = 0;\\n  private simTime = 0;\\n  private waveRespawnTimer = 0;\\n  private enemyIdCounter = 1;\\n  private callbacks: CombatCallbacks = {};\\n\\n  // Short-lived HUD & visual feedback timers\\n  private hitMarkerTimer = 0;\\n  private killMarkerTimer = 0;\\n  private damageFlashTimer = 0;\\n  private muzzleFlashLeft = 0;\\n  private muzzleFlashRight = 0;\\n  private cameraImpulse = 0;\\n  private primaryTargetId: string | null = null;\\n\\n  public constructor(playerMaxHull: number) {\\n    this.playerHealth = createHealthState(playerMaxHull);\\n  }\\n\\n  public setCallbacks(callbacks: CombatCallbacks): void {\\n    this.callbacks = callbacks;\\n  }\\n\\n  public getWeaponConfig(): WeaponConfig {\\n    return this.playerWeapon;\\n  }\\n\\n  public getCameraImpulse(): number {\\n    return this.cameraImpulse;\\n  }\\n\\n  public resetSession(playerMaxHull: number, playerPos: THREE.Vector3): void {\\n    resetHealthState(this.playerHealth, playerMaxHull);\\n    this.projectiles.clear();\\n    this.enemies.length = 0;\\n    this.playerWeaponCooldown = 0;\\n    this.playerMuzzleIndex = 0;\\n    this.simTime = 0;\\n    this.waveRespawnTimer = 0;\\n    this.hitMarkerTimer = 0;\\n    this.killMarkerTimer = 0;\\n    this.damageFlashTimer = 0;\\n    this.muzzleFlashLeft = 0;\\n    this.muzzleFlashRight = 0;\\n    this.cameraImpulse = 0;\\n    this.primaryTargetId = null;\\n\\n    this.stats.kills = 0;\\n    this.stats.shotsFired = 0;\\n    this.stats.shotsHit = 0;\\n    this.stats.damageDealt = 0;\\n    this.stats.damageTaken = 0;\\n    this.stats.score = 0;\\n    this.stats.wave = 1;\\n    this.stats.activeEnemies = 0;\\n\\n    this.spawnWave(1, playerPos);\\n  }\\n\\n  public spawnWave(waveNumber: number, aroundPos: THREE.Vector3): void {\\n    this.enemies.length = 0;\\n    this.stats.wave = waveNumber;\\n\\n    // Progressive combat roster showcasing Aggressor, Flanker, Defender, and Ace personalities\\n    const roster: Array<{ personality: BotPersonality; difficulty: number; offset: [number, number, number] }> =\\n      waveNumber === 1\\n        ? [\\n            { personality: \'aggressor\', difficulty: 1, offset: [-65, 18, -230] },\\n            { personality: \'flanker\', difficulty: 1, offset: [85, -14, -260] },\\n            { personality: \'aggressor\', difficulty: 2, offset: [12, 34, -310] },\\n          ]\\n        : waveNumber === 2\\n          ? [\\n              { personality: \'aggressor\', difficulty: 2, offset: [-80, 22, -250] },\\n              { personality: \'flanker\', difficulty: 2, offset: [90, -18, -240] },\\n              { personality: \'defender\', difficulty: 2, offset: [0, 38, -320] },\\n            ]\\n          : [\\n              { personality: \'aggressor\', difficulty: Math.min(5, waveNumber), offset: [-95, 20, -260] },\\n              { personality: \'flanker\', difficulty: Math.min(5, waveNumber), offset: [95, -15, -260] },\\n              { personality: \'defender\', difficulty: Math.min(5, waveNumber), offset: [-20, 44, -330] },\\n              { personality: \'ace\', difficulty: Math.min(5, waveNumber), offset: [35, -24, -350] },\\n            ];\\n\\n    for (let i = 0; i < roster.length && i < MAX_ENEMIES; i++) {\\n      const spec = roster[i];\\n      const pCfg = BOT_PERSONALITIES[spec.personality];\\n      const spawnPos = new THREE.Vector3(\\n        aroundPos.x + spec.offset[0],\\n        aroundPos.y + spec.offset[1],\\n        aroundPos.z + spec.offset[2],\\n      );\\n      const id = `enemy-${this.enemyIdCounter++}`;\\n      const callsign = CALLSIGN_POOL[(this.enemyIdCounter + i) % CALLSIGN_POOL.length];\\n\\n      const enemy: EnemyEntity = {\\n        id,\\n        callsign,\\n        shipId: spec.personality === \'defender\' ? \'destroyer\' : spec.personality === \'flanker\' ? \'interceptor\' : \'striker\',\\n        personality: spec.personality,\\n        difficulty: spec.difficulty,\\n        active: true,\\n        position: spawnPos,\\n        quaternion: new THREE.Quaternion(),\\n        velocity: new THREE.Vector3(0, 0, 20),\\n        visualBankAngle: 0,\\n        collisionRadius: ENEMY_COLLISION_RADIUS,\\n        health: createHealthState(pCfg.maxHull),\\n        aiState: \'patrol\',\\n        aiStateTimer: 0.4 + i * 0.25,\\n        reactionTimer: pCfg.reactionTime,\\n        weaponCooldown: 0.8 + i * 0.3,\\n        burstTimer: 1.2,\\n        burstActive: true,\\n        muzzleIndex: 0,\\n        patrolAnchor: spawnPos.clone(),\\n        patrolAngle: i * 1.9,\\n        flankSign: i % 2 === 0 ? 1 : -1,\\n        evadeDir: new THREE.Vector3(1, 0, 0),\\n        repositionPoint: spawnPos.clone(),\\n        hitFlashTimer: 0,\\n        muzzleFlashTimer: 0,\\n      };\\n      this.enemies.push(enemy);\\n    }\\n\\n    this.stats.activeEnemies = this.enemies.length;\\n  }\\n\\n  /**\\n   * Advances complete combat loop (weapons, projectiles, AI, collisions, waves) by `dt`.\\n   */\\n  public update(\\n    dt: number,\\n    flight: FlightController,\\n    input: InputSnapshot,\\n    telemetry: FlightTelemetry,\\n    camera?: THREE.PerspectiveCamera,\\n  ): void {\\n    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);\\n    this.simTime += safeDt;\\n\\n    // Decay transient feedback timers\\n    if (this.playerWeaponCooldown > 0) {\\n      this.playerWeaponCooldown = Math.max(0, this.playerWeaponCooldown - safeDt);\\n    }\\n    if (this.hitMarkerTimer > 0) {\\n      this.hitMarkerTimer = Math.max(0, this.hitMarkerTimer - safeDt);\\n    }\\n    if (this.killMarkerTimer > 0) {\\n      this.killMarkerTimer = Math.max(0, this.killMarkerTimer - safeDt);\\n    }\\n    if (this.damageFlashTimer > 0) {\\n      this.damageFlashTimer = Math.max(0, this.damageFlashTimer - safeDt);\\n    }\\n    if (this.muzzleFlashLeft > 0) {\\n      this.muzzleFlashLeft = Math.max(0, this.muzzleFlashLeft - safeDt);\\n    }\\n    if (this.muzzleFlashRight > 0) {\\n      this.muzzleFlashRight = Math.max(0, this.muzzleFlashRight - safeDt);\\n    }\\n    if (this.cameraImpulse > 0) {\\n      this.cameraImpulse = Math.max(0, this.cameraImpulse - safeDt * 3.8);\\n    }\\n\\n    const playerAlive = !this.playerHealth.isDestroyed;\\n\\n    // 1. Player Primary Weapon Firing (exact convergence onto 3D aiming reticle ray!)\\n    let isFiring = false;\\n    if (playerAlive && input.firePrimary) {\\n      isFiring = true;\\n      if (this.playerWeaponCooldown <= 0) {\\n        this.firePlayerWeapon(flight);\\n      }\\n    }\\n\\n    // 2. Update Pooled Projectiles\\n    this.projectiles.update(safeDt);\\n\\n    // 3. Update Enemy AI Pilots\\n    let aliveEnemies = 0;\\n    for (let i = 0; i < this.enemies.length; i++) {\\n      const enemy = this.enemies[i];\\n      if (!enemy.active || enemy.health.isDestroyed) continue;\\n      aliveEnemies += 1;\\n\\n      const aiRes = this.ai.updateEnemy(\\n        enemy,\\n        safeDt,\\n        this.simTime,\\n        flight.position,\\n        flight.velocity,\\n        playerAlive,\\n        this.projectiles,\\n        this.enemies,\\n      );\\n\\n      if (aiRes.fired) {\\n        const personality = BOT_PERSONALITIES[enemy.personality];\\n        this.callbacks.onEnemyFire?.({\\n          shooterId: enemy.id,\\n          faction: \'enemy\',\\n          weaponId: personality.weaponId,\\n          origin: aiRes.fireOrigin,\\n          direction: _forwardVec.set(0, 0, -1).applyQuaternion(enemy.quaternion),\\n          timestamp: this.simTime,\\n        });\\n      }\\n    }\\n\\n    // 4. Swept Collision Detection (Projectiles vs Enemies & Player)\\n    this.resolveProjectileCollisions(flight, playerAlive);\\n\\n    // 5. Ship-to-Ship Soft Collision Avoidance & Hull Scrape\\n    if (playerAlive) {\\n      this.resolveShipCollisions(flight);\\n    }\\n\\n    // Recount surviving enemies & manage wave reinforcements\\n    aliveEnemies = 0;\\n    for (let i = 0; i < this.enemies.length; i++) {\\n      if (this.enemies[i].active && !this.enemies[i].health.isDestroyed) {\\n        aliveEnemies += 1;\\n      }\\n    }\\n    this.stats.activeEnemies = aliveEnemies;\\n\\n    if (aliveEnemies === 0 && playerAlive) {\\n      this.waveRespawnTimer += safeDt;\\n      if (this.waveRespawnTimer >= 2.6) {\\n        this.waveRespawnTimer = 0;\\n        this.spawnWave(this.stats.wave + 1, flight.position);\\n      }\\n    } else {\\n      this.waveRespawnTimer = 0;\\n    }\\n\\n    // 6. Sync Live Combat Telemetry & Screen-Space Projections (Zero Allocations)\\n    telemetry.hull = this.playerHealth.current;\\n    telemetry.maxHull = this.playerHealth.max;\\n    telemetry.playerDestroyed = this.playerHealth.isDestroyed;\\n    telemetry.isFiring = isFiring;\\n    telemetry.weaponName = this.playerWeapon.name;\\n    telemetry.weaponCooldownRatio = Math.min(\\n      1,\\n      this.playerWeaponCooldown * this.playerWeapon.fireRate,\\n    );\\n    telemetry.hitMarkerTimer = this.hitMarkerTimer;\\n    telemetry.killMarkerTimer = this.killMarkerTimer;\\n    telemetry.damageFlashTimer = this.damageFlashTimer;\\n    telemetry.muzzleFlashLeft = this.muzzleFlashLeft;\\n    telemetry.muzzleFlashRight = this.muzzleFlashRight;\\n    telemetry.combatStats.kills = this.stats.kills;\\n    telemetry.combatStats.shotsFired = this.stats.shotsFired;\\n    telemetry.combatStats.shotsHit = this.stats.shotsHit;\\n    telemetry.combatStats.damageDealt = this.stats.damageDealt;\\n    telemetry.combatStats.damageTaken = this.stats.damageTaken;\\n    telemetry.combatStats.score = this.stats.score;\\n    telemetry.combatStats.wave = this.stats.wave;\\n    telemetry.combatStats.activeEnemies = this.stats.activeEnemies;\\n\\n    if (camera) {\\n      this.projectHudTelemetry(flight, camera, telemetry);\\n    }\\n  }\\n\\n  private firePlayerWeapon(flight: FlightController): void {\\n    const weapon = this.playerWeapon;\\n    const minInterval = 1 / Math.max(0.5, weapon.fireRate);\\n    this.playerWeaponCooldown = minInterval;\\n\\n    // Alternate left & right wing cannon barrels\\n    const idx = this.playerMuzzleIndex % weapon.muzzleOffsets.length;\\n    this.playerMuzzleIndex = (this.playerMuzzleIndex + 1) % weapon.muzzleOffsets.length;\\n    const offset = weapon.muzzleOffsets[idx];\\n\\n    if (idx === 0) this.muzzleFlashLeft = 0.065;\\n    else this.muzzleFlashRight = 0.065;\\n\\n    // World origin of the active cannon barrel\\n    _muzzleLocal.set(offset[0], offset[1], offset[2]).applyQuaternion(flight.quaternion);\\n    _muzzleWorld.copy(flight.position).add(_muzzleLocal);\\n\\n    // Compute exact 3D convergence target along the player\'s true aiming ray\\n    // If a primary target is near the reticle, converge at that target\'s distance so bolts cross dead-on!\\n    let convergeDist = weapon.convergenceDistance;\\n    if (this.primaryTargetId) {\\n      const target = this.enemies.find(\\n        (e) => e.id === this.primaryTargetId && e.active && !e.health.isDestroyed,\\n      );\\n      if (target) {\\n        const d = flight.position.distanceTo(target.position);\\n        if (d > 35 && d < 520) {\\n          convergeDist = d;\\n        }\\n      }\\n    }\\n\\n    flight.getAimTargetPoint(_aimTarget, convergeDist);\\n    _fireDir.subVectors(_aimTarget, _muzzleWorld).normalize();\\n\\n    // Subtle micro-spread\\n    if (weapon.spreadRad > 0) {\\n      _rightVec.set(1, 0, 0).applyQuaternion(flight.quaternion);\\n      _upVec.set(0, 1, 0).applyQuaternion(flight.quaternion);\\n      _fireDir\\n        .addScaledVector(_rightVec, (Math.random() - 0.5) * weapon.spreadRad)\\n        .addScaledVector(_upVec, (Math.random() - 0.5) * weapon.spreadRad)\\n        .normalize();\\n    }\\n\\n    this.projectiles.spawn(\\n      PLAYER_ENTITY_ID,\\n      \'player\',\\n      weapon,\\n      _muzzleWorld,\\n      _fireDir,\\n      flight.velocity,\\n    );\\n\\n    this.stats.shotsFired += 1;\\n\\n    this.callbacks.onPlayerFire?.({\\n      shooterId: PLAYER_ENTITY_ID,\\n      faction: \'player\',\\n      weaponId: weapon.id,\\n      origin: _muzzleWorld,\\n      direction: _fireDir,\\n      timestamp: this.simTime,\\n    });\\n  }\\n\\n  private resolveProjectileCollisions(flight: FlightController, playerAlive: boolean): void {\\n    const items = this.projectiles.items;\\n\\n    for (let i = 0; i < items.length; i++) {\\n      const p = items[i];\\n      if (!p.active) continue;\\n\\n      if (p.faction === \'player\') {\\n        // Player projectile -> check active non-destroyed enemies (strictly never damages player!)\\n        for (let j = 0; j < this.enemies.length; j++) {\\n          const enemy = this.enemies[j];\\n          if (!enemy.active || enemy.health.isDestroyed) continue;\\n          if (p.ownerId === enemy.id) continue;\\n\\n          const combinedRadius = enemy.collisionRadius + p.hitRadius;\\n          if (\\n            intersectSegmentSphere(\\n              p.prevPosition,\\n              p.position,\\n              enemy.position,\\n              combinedRadius,\\n              _hitPoint,\\n            )\\n          ) {\\n            // Deactivate projectile immediately so it can NEVER apply damage twice\\n            this.projectiles.release(p);\\n\\n            const dmgRes = applyDamage(enemy.health, p.damage, p.ownerId, this.simTime);\\n            if (!dmgRes.applied) break;\\n\\n            this.stats.shotsHit += 1;\\n            this.stats.damageDealt += dmgRes.appliedAmount;\\n            this.hitMarkerTimer = 0.16;\\n\\n            this.callbacks.onDamage?.({\\n              targetId: enemy.id,\\n              attackerId: p.ownerId,\\n              weaponId: p.weaponId,\\n              amount: dmgRes.appliedAmount,\\n              remainingHealth: dmgRes.remaining,\\n              maxHealth: enemy.health.max,\\n              destroyed: dmgRes.destroyedNow,\\n              hitPoint: _hitPoint,\\n              timestamp: this.simTime,\\n            });\\n\\n            if (dmgRes.destroyedNow) {\\n              enemy.active = false;\\n              enemy.aiState = \'destroyed\';\\n              this.stats.kills += 1;\\n              this.stats.score += 100 * enemy.difficulty;\\n              this.killMarkerTimer = 0.34;\\n              this.cameraImpulse = Math.min(1, this.cameraImpulse + 0.45);\\n\\n              this.callbacks.onVfxBurst?.({\\n                kind: \'explosion\',\\n                position: enemy.position,\\n                color: \'#38bdf8\',\\n                scale: 1.35,\\n              });\\n              this.callbacks.onDestruction?.({\\n                entityId: enemy.id,\\n                faction: \'enemy\',\\n                killerId: p.ownerId,\\n                position: enemy.position,\\n                timestamp: this.simTime,\\n              });\\n            } else {\\n              this.ai.triggerDamageReaction(enemy, flight.position, this.simTime);\\n              this.callbacks.onVfxBurst?.({\\n                kind: \'impact\',\\n                position: _hitPoint,\\n                color: \'#22d3ee\',\\n                scale: 0.7,\\n              });\\n            }\\n            break;\\n          }\\n        }\\n      } else if (p.faction === \'enemy\' && playerAlive) {\\n        // Enemy projectile -> check player ship (never damages own shooter)\\n        if (p.ownerId === PLAYER_ENTITY_ID) continue;\\n\\n        const combinedRadius = PLAYER_COLLISION_RADIUS + p.hitRadius;\\n        if (\\n          intersectSegmentSphere(\\n            p.prevPosition,\\n            p.position,\\n            flight.position,\\n            combinedRadius,\\n            _hitPoint,\\n          )\\n        ) {\\n          this.projectiles.release(p);\\n\\n          const dmgRes = applyDamage(this.playerHealth, p.damage, p.ownerId, this.simTime);\\n          if (!dmgRes.applied) continue;\\n\\n          this.stats.damageTaken += dmgRes.appliedAmount;\\n          this.damageFlashTimer = 0.32;\\n          this.cameraImpulse = Math.min(1, this.cameraImpulse + 0.55);\\n\\n          this.callbacks.onVfxBurst?.({\\n            kind: \'player-hit\',\\n            position: _hitPoint,\\n            color: \'#f97316\',\\n            scale: 0.75,\\n          });\\n          this.callbacks.onDamage?.({\\n            targetId: PLAYER_ENTITY_ID,\\n            attackerId: p.ownerId,\\n            weaponId: p.weaponId,\\n            amount: dmgRes.appliedAmount,\\n            remainingHealth: dmgRes.remaining,\\n            maxHealth: this.playerHealth.max,\\n            destroyed: dmgRes.destroyedNow,\\n            hitPoint: _hitPoint,\\n            timestamp: this.simTime,\\n          });\\n\\n          if (dmgRes.destroyedNow) {\\n            this.callbacks.onVfxBurst?.({\\n              kind: \'explosion\',\\n              position: flight.position,\\n              color: \'#f97316\',\\n              scale: 1.5,\\n            });\\n            this.callbacks.onDestruction?.({\\n              entityId: PLAYER_ENTITY_ID,\\n              faction: \'player\',\\n              killerId: p.ownerId,\\n              position: flight.position,\\n              timestamp: this.simTime,\\n            });\\n          }\\n        }\\n      }\\n    }\\n  }\\n\\n  private resolveShipCollisions(flight: FlightController): void {\\n    for (let i = 0; i < this.enemies.length; i++) {\\n      const enemy = this.enemies[i];\\n      if (!enemy.active || enemy.health.isDestroyed) continue;\\n\\n      if (\\n        intersectSphereSphere(\\n          flight.position,\\n          PLAYER_COLLISION_RADIUS,\\n          enemy.position,\\n          enemy.collisionRadius,\\n        )\\n      ) {\\n        _sepVec.subVectors(flight.position, enemy.position);\\n        const dist = _sepVec.length();\\n        if (dist < 0.001) _sepVec.set(0, 1, 0);\\n        else _sepVec.divideScalar(dist);\\n\\n        const pushDist = PLAYER_COLLISION_RADIUS + enemy.collisionRadius - dist + 0.6;\\n        flight.position.addScaledVector(_sepVec, pushDist * 0.5);\\n        enemy.position.addScaledVector(_sepVec, -pushDist * 0.5);\\n\\n        // Mild hull collision impact (rate-limited by lastHitTime)\\n        if (this.simTime - this.playerHealth.lastHitTime > 0.6) {\\n          const dmgRes = applyDamage(this.playerHealth, 12, enemy.id, this.simTime);\\n          if (dmgRes.applied) {\\n            this.stats.damageTaken += dmgRes.appliedAmount;\\n            this.damageFlashTimer = 0.35;\\n            this.cameraImpulse = Math.min(1, this.cameraImpulse + 0.65);\\n          }\\n          applyDamage(enemy.health, 16, PLAYER_ENTITY_ID, this.simTime);\\n          this.ai.triggerDamageReaction(enemy, flight.position, this.simTime);\\n        }\\n      }\\n    }\\n  }\\n\\n  /**\\n   * Projects true 3D weapon aiming point, ship boresight, and all active enemy markers\\n   * into normalized [0..1] viewport coordinates so HUD matches 3D ballistics 1:1.\\n   */\\n  private projectHudTelemetry(\\n    flight: FlightController,\\n    camera: THREE.PerspectiveCamera,\\n    telemetry: FlightTelemetry,\\n  ): void {\\n    // 1. Project true 3D Aim Reticle point (guaranteed exact match to weapon convergence ray!)\\n    flight.getAimTargetPoint(_aimTarget, this.playerWeapon.convergenceDistance);\\n    _projVec.copy(_aimTarget).project(camera);\\n    telemetry.aimScreenX = THREE.MathUtils.clamp((_projVec.x + 1) * 0.5, 0.05, 0.95);\\n    telemetry.aimScreenY = THREE.MathUtils.clamp((1 - _projVec.y) * 0.5, 0.06, 0.94);\\n\\n    // 2. Project Ship Nose Boresight reference chevron\\n    _forwardVec.set(0, 0, -1).applyQuaternion(flight.quaternion);\\n    _projVec.copy(flight.position).addScaledVector(_forwardVec, 240).project(camera);\\n    telemetry.boresightScreenX = THREE.MathUtils.clamp((_projVec.x + 1) * 0.5, 0.05, 0.95);\\n    telemetry.boresightScreenY = THREE.MathUtils.clamp((1 - _projVec.y) * 0.5, 0.06, 0.94);\\n\\n    // 3. Project Active Enemy Markers & Identify Primary Target Closest to Aim Ray\\n    flight.getAimDirectionWorld(_aimDir);\\n    let bestScore = Infinity;\\n    let bestIdx = -1;\\n\\n    const markers = telemetry.enemyMarkers;\\n    for (let i = 0; i < markers.length; i++) {\\n      markers[i].active = false;\\n      markers[i].isPrimaryTarget = false;\\n      markers[i].leadVisible = false;\\n    }\\n\\n    let slotIdx = 0;\\n    for (let i = 0; i < this.enemies.length && slotIdx < markers.length; i++) {\\n      const enemy = this.enemies[i];\\n      if (!enemy.active || enemy.health.isDestroyed) continue;\\n\\n      const marker: ProjectedEnemyMarker = markers[slotIdx];\\n      const dist = flight.position.distanceTo(enemy.position);\\n\\n      _projVec.copy(enemy.position).project(camera);\\n      const inFront = _projVec.z >= -1 && _projVec.z <= 1;\\n      let sx = (_projVec.x + 1) * 0.5;\\n      let sy = (1 - _projVec.y) * 0.5;\\n\\n      // If behind camera, mirror onto viewport perimeter so off-screen arrow points accurately\\n      if (!inFront) {\\n        sx = 1 - sx;\\n        sy = 1 - sy;\\n      }\\n\\n      const onScreen = inFront && sx >= 0.04 && sx <= 0.96 && sy >= 0.05 && sy <= 0.95;\\n\\n      if (!onScreen) {\\n        const dx = sx - 0.5;\\n        const dy = sy - 0.5;\\n        const len = Math.hypot(dx, dy) || 1;\\n        const edgeScale = 0.44 / Math.max(Math.abs(dx / len), Math.abs(dy / len), 0.001);\\n        sx = THREE.MathUtils.clamp(0.5 + (dx / len) * Math.min(edgeScale, 0.46), 0.04, 0.96);\\n        sy = THREE.MathUtils.clamp(0.5 + (dy / len) * Math.min(edgeScale, 0.44), 0.06, 0.94);\\n      }\\n\\n      marker.active = true;\\n      marker.entityId = enemy.id;\\n      marker.callsign = enemy.callsign;\\n      marker.personalityLabel = BOT_PERSONALITIES[enemy.personality].label;\\n      marker.aiState = enemy.aiState;\\n      marker.screenX = sx;\\n      marker.screenY = sy;\\n      marker.inFront = inFront;\\n      marker.onScreen = onScreen;\\n      marker.distance = dist;\\n      marker.healthRatio = getHealthRatio(enemy.health);\\n\\n      // Rank best target near player\'s aiming reticle\\n      if (inFront) {\\n        const aimDist = Math.hypot(sx - telemetry.aimScreenX, sy - telemetry.aimScreenY);\\n        const weightedScore = aimDist + dist * 0.00035;\\n        if (weightedScore < bestScore) {\\n          bestScore = weightedScore;\\n          bestIdx = slotIdx;\\n        }\\n      }\\n\\n      // Compute predictive weapon lead pip for this enemy\\n      if (inFront && dist < 480) {\\n        const tHit = dist / Math.max(this.playerWeapon.projectileSpeed, 1);\\n        _leadWorld.copy(enemy.position).addScaledVector(enemy.velocity, tHit);\\n        _projVec.copy(_leadWorld).project(camera);\\n        if (_projVec.z >= -1 && _projVec.z <= 1) {\\n          marker.leadX = THREE.MathUtils.clamp((_projVec.x + 1) * 0.5, 0.04, 0.96);\\n          marker.leadY = THREE.MathUtils.clamp((1 - _projVec.y) * 0.5, 0.05, 0.95);\\n          marker.leadVisible = true;\\n        }\\n      }\\n\\n      slotIdx += 1;\\n    }\\n\\n    if (bestIdx >= 0) {\\n      markers[bestIdx].isPrimaryTarget = true;\\n      this.primaryTargetId = markers[bestIdx].entityId;\\n    } else {\\n      this.primaryTargetId = null;\\n    }\\n  }\\n}\\n\", \"Description\":\"Implement CombatManager orchestrating player weapons, pooled projectiles, swept collision detection, enemy AI waves, and 3D-to-HUD projections\", \"Overwrite\":true, \"TargetFile\":\"/src/engine/combat/CombatManager.ts\", \"toolAction\":\"Creating CombatManager\", \"toolSummary\":\"Create src/engine/combat/CombatManager.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_3009089304264592387"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Extend FlightTelemetry with expanded mouse aiming projections, weapon state, hit/damage feedback, and projected enemy target markers\", \"EndLine\":135, \"Instruction\":\"Import CombatStats and ProjectedEnemyMarker and add combat telemetry fields to FlightTelemetry\", \"ReplacementContent\":\"import type * as THREE from \'three\';\\nimport type { CombatStats, ProjectedEnemyMarker } from \'./combat\';\\n\\nexport type GamePhase = \'menu\' | \'loading\' | \'playing\' | \'paused\';\\n\\nexport type MenuSection = \'main\' | \'hangar\' | \'settings\';\\n\\nexport type ShipId = \'interceptor\' | \'striker\' | \'destroyer\';\\n\\nexport type GraphicsQuality = \'low\' | \'medium\' | \'high\';\\n\\nexport type FlightStatus =\\n  | \'STANDBY\'\\n  | \'CRUISING\'\\n  | \'ACCELERATING\'\\n  | \'BOOSTING\'\\n  | \'REVERSING\'\\n  | \'DRIFTING\'\\n  | \'BOOST DEPLETED\';\\n\\nexport interface ShipFlightProfile {\\n  /** Base forward max speed in m/s */\\n  maxSpeed: number;\\n  /** Reverse max speed in m/s */\\n  maxReverseSpeed: number;\\n  /** Forward thrust acceleration in m/s^2 */\\n  acceleration: number;\\n  /** Braking / reverse thrust acceleration in m/s^2 */\\n  deceleration: number;\\n  /** Passive velocity drag when no thrust key is pressed */\\n  passiveDrag: number;\\n  /** How quickly the velocity vector aligns with ship nose (arcade lateral grip) */\\n  lateralGrip: number;\\n  /** Boost speed multiplier applied to maxSpeed */\\n  boostMultiplier: number;\\n  /** Boost acceleration multiplier */\\n  boostAccelMultiplier: number;\\n  /** Boost energy pool (0-100) */\\n  maxBoostEnergy: number;\\n  /** Energy consumed per second while boosting */\\n  boostDrainRate: number;\\n  /** Energy regenerated per second when not boosting */\\n  boostRegenRate: number;\\n  /** Delay in seconds after stopping boost before regen begins */\\n  boostRegenDelay: number;\\n  /** Max yaw angular speed in rad/s */\\n  yawSpeed: number;\\n  /** Max pitch angular speed in rad/s */\\n  pitchSpeed: number;\\n  /** Max roll angular speed in rad/s */\\n  rollSpeed: number;\\n  /** Angular response damping (higher = snappier stop) */\\n  angularDamping: number;\\n  /** Subtle automatic visual banking induced by yaw */\\n  visualBankStrength: number;\\n}\\n\\nexport interface ShipWeaponSpec {\\n  primaryName: string;\\n  damageRating: number; // 0-100 normalized for UI comparison\\n  fireRateRating: number;\\n}\\n\\nexport interface ShipConfig {\\n  id: ShipId;\\n  callsign: string;\\n  name: string;\\n  role: string;\\n  description: string;\\n  /** Whether playable in Phase 1 */\\n  playableInPhase1: boolean;\\n  unlockNote: string;\\n  maxHull: number;\\n  /** Normalized 0-100 ratings for hangar specification bars */\\n  ratings: {\\n    speed: number;\\n    maneuverability: number;\\n    hull: number;\\n    firepower: number;\\n  };\\n  colors: {\\n    hullPrimary: string;\\n    hullSecondary: string;\\n    hullTrim: string;\\n    canopy: string;\\n    engineCore: string;\\n    engineGlow: string;\\n  };\\n  flight: ShipFlightProfile;\\n  weapons: ShipWeaponSpec;\\n}\\n\\nexport interface GameSettings {\\n  mouseSensitivity: number; // 0.3 to 2.5\\n  invertY: boolean;\\n  cameraDistance: number; // 7 to 14\\n  cameraSensitivity: number; // 0.5 to 1.8\\n  masterVolume: number; // 0 to 1\\n  graphicsQuality: GraphicsQuality;\\n  showPerfOverlay: boolean;\\n}\\n\\n/**\\n * High-frequency mutable telemetry updated every simulation frame.\\n * Read directly via refs inside HUD animation loops to guarantee zero React re-renders per frame.\\n */\\nexport interface FlightTelemetry {\\n  speed: number;\\n  signedSpeed: number;\\n  maxSpeed: number;\\n  effectiveMaxSpeed: number;\\n  throttle: number; // -1 to 1\\n  boostEnergy: number; // 0 to 100\\n  maxBoostEnergy: number;\\n  isBoosting: boolean;\\n  boostDepleted: boolean;\\n  boostIntensity: number; // 0 to 1 smoothly damped\\n  hull: number;\\n  maxHull: number;\\n  yawRate: number; // normalized -1..1\\n  pitchRate: number; // normalized -1..1\\n  rollRate: number; // normalized -1..1\\n  /** Normalized expanded aiming envelope offsets (-1..1) */\\n  aimNormalizedX: number;\\n  aimNormalizedY: number;\\n  /** Screen-space [0..1] position of true 3D weapon aiming reticle */\\n  aimScreenX: number;\\n  aimScreenY: number;\\n  /** Screen-space [0..1] position of ship boresight */\\n  boresightScreenX: number;\\n  boresightScreenY: number;\\n  headingDeg: number; // 0..359\\n  pitchDeg: number; // -90..90\\n  rollDeg: number; // -180..180\\n  altitude: number;\\n  status: FlightStatus;\\n  pointerLocked: boolean;\\n  // Combat telemetry\\n  isFiring: boolean;\\n  weaponName: string;\\n  weaponCooldownRatio: number;\\n  hitMarkerTimer: number;\\n  killMarkerTimer: number;\\n  damageFlashTimer: number;\\n  muzzleFlashLeft: number;\\n  muzzleFlashRight: number;\\n  playerDestroyed: boolean;\\n  combatStats: CombatStats;\\n  enemyMarkers: ProjectedEnemyMarker[];\\n  // Performance metrics\\n  fps: number;\\n  frameTimeMs: number;\\n  drawCalls: number;\\n  triangles: number;\\n}\", \"StartLine\":1, \"TargetContent\":\"import type * as THREE from \'three\';\\n\\nexport type GamePhase = \'menu\' | \'loading\' | \'playing\' | \'paused\';\\n\\nexport type MenuSection = \'main\' | \'hangar\' | \'settings\';\\n\\nexport type ShipId = \'interceptor\' | \'striker\' | \'destroyer\';\\n\\nexport type GraphicsQuality = \'low\' | \'medium\' | \'high\';\\n\\nexport type FlightStatus =\\n  | \'STANDBY\'\\n  | \'CRUISING\'\\n  | \'ACCELERATING\'\\n  | \'BOOSTING\'\\n  | \'REVERSING\'\\n  | \'DRIFTING\'\\n  | \'BOOST DEPLETED\';\\n\\nexport interface ShipFlightProfile {\\n  /** Base forward max speed in m/s */\\n  maxSpeed: number;\\n  /** Reverse max speed in m/s */\\n  maxReverseSpeed: number;\\n  /** Forward thrust acceleration in m/s^2 */\\n  acceleration: number;\\n  /** Braking / reverse thrust acceleration in m/s^2 */\\n  deceleration: number;\\n  /** Passive velocity drag when no thrust key is pressed */\\n  passiveDrag: number;\\n  /** How quickly the velocity vector aligns with ship nose (arcade lateral grip) */\\n  lateralGrip: number;\\n  /** Boost speed multiplier applied to maxSpeed */\\n  boostMultiplier: number;\\n  /** Boost acceleration multiplier */\\n  boostAccelMultiplier: number;\\n  /** Boost energy pool (0-100) */\\n  maxBoostEnergy: number;\\n  /** Energy consumed per second while boosting */\\n  boostDrainRate: number;\\n  /** Energy regenerated per second when not boosting */\\n  boostRegenRate: number;\\n  /** Delay in seconds after stopping boost before regen begins */\\n  boostRegenDelay: number;\\n  /** Max yaw angular speed in rad/s */\\n  yawSpeed: number;\\n  /** Max pitch angular speed in rad/s */\\n  pitchSpeed: number;\\n  /** Max roll angular speed in rad/s */\\n  rollSpeed: number;\\n  /** Angular response damping (higher = snappier stop) */\\n  angularDamping: number;\\n  /** Subtle automatic visual banking induced by yaw */\\n  visualBankStrength: number;\\n}\\n\\nexport interface ShipWeaponSpec {\\n  primaryName: string;\\n  damageRating: number; // 0-100 normalized for UI comparison\\n  fireRateRating: number;\\n}\\n\\nexport interface ShipConfig {\\n  id: ShipId;\\n  callsign: string;\\n  name: string;\\n  role: string;\\n  description: string;\\n  /** Whether playable in Phase 1 */\\n  playableInPhase1: boolean;\\n  unlockNote: string;\\n  maxHull: number;\\n  /** Normalized 0-100 ratings for hangar specification bars */\\n  ratings: {\\n    speed: number;\\n    maneuverability: number;\\n    hull: number;\\n    firepower: number;\\n  };\\n  colors: {\\n    hullPrimary: string;\\n    hullSecondary: string;\\n    hullTrim: string;\\n    canopy: string;\\n    engineCore: string;\\n    engineGlow: string;\\n  };\\n  flight: ShipFlightProfile;\\n  weapons: ShipWeaponSpec;\\n}\\n\\nexport interface GameSettings {\\n  mouseSensitivity: number; // 0.3 to 2.5\\n  invertY: boolean;\\n  cameraDistance: number; // 7 to 14\\n  cameraSensitivity: number; // 0.5 to 1.8\\n  masterVolume: number; // 0 to 1\\n  graphicsQuality: GraphicsQuality;\\n  showPerfOverlay: boolean;\\n}\\n\\n/**\\n * High-frequency mutable telemetry updated every simulation frame.\\n * Read directly via refs inside HUD animation loops to guarantee zero React re-renders per frame.\\n */\\nexport interface FlightTelemetry {\\n  speed: number;\\n  signedSpeed: number;\\n  maxSpeed: number;\\n  effectiveMaxSpeed: number;\\n  throttle: number; // -1 to 1\\n  boostEnergy: number; // 0 to 100\\n  maxBoostEnergy: number;\\n  isBoosting: boolean;\\n  boostDepleted: boolean;\\n  boostIntensity: number; // 0 to 1 smoothly damped\\n  hull: number;\\n  maxHull: number;\\n  yawRate: number; // normalized -1..1\\n  pitchRate: number; // normalized -1..1\\n  rollRate: number; // normalized -1..1\\n  headingDeg: number; // 0..359\\n  pitchDeg: number; // -90..90\\n  rollDeg: number; // -180..180\\n  altitude: number;\\n  status: FlightStatus;\\n  pointerLocked: boolean;\\n  fps: number;\\n  frameTimeMs: number;\\n  drawCalls: number;\\n  triangles: number;\\n}\", \"TargetFile\":\"/src/types/game.ts\", \"toolAction\":\"Extending FlightTelemetry types\", \"toolSummary\":\"Extend src/types/game.ts\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_3009089304264592068"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add Left Mouse Button and Spacebar primary weapon firing state to InputManager while preserving Pointer Lock steering\", \"EndLine\":208, \"Instruction\":\"Add firePrimary to InputSnapshot and handle left mouse button press/release and Spacebar in InputManager\", \"ReplacementContent\":\"export interface InputSnapshot {\\n  forward: boolean;\\n  backward: boolean;\\n  rollLeft: boolean;\\n  rollRight: boolean;\\n  boost: boolean;\\n  firePrimary: boolean;\\n  keyPitchUp: boolean;\\n  keyPitchDown: boolean;\\n  keyYawLeft: boolean;\\n  keyYawRight: boolean;\\n  mouseDeltaX: number;\\n  mouseDeltaY: number;\\n  pointerLocked: boolean;\\n}\\n\\nexport interface InputCallbacks {\\n  onPauseRequested?: () => void;\\n  onPointerLockChanged?: (locked: boolean) => void;\\n  onToggleHudHints?: () => void;\\n}\\n\\n/**\\n * Decoupled keyboard + Pointer Lock mouse input manager.\\n * Supports continuous Left Mouse Button firing and wide relative mouse deltas without React state overhead.\\n */\\nexport class InputManager {\\n  private keys = new Set<string>();\\n  private mouseDeltaX = 0;\\n  private mouseDeltaY = 0;\\n  private pointerLocked = false;\\n  private mouseFireHeld = false;\\n  private isDraggingFallback = false;\\n  private lastDragX = 0;\\n  private lastDragY = 0;\\n  private lockTarget: HTMLElement | null = null;\\n  private active = false;\\n  private callbacks: InputCallbacks = {};\\n\\n  private readonly snapshot: InputSnapshot = {\\n    forward: false,\\n    backward: false,\\n    rollLeft: false,\\n    rollRight: false,\\n    boost: false,\\n    firePrimary: false,\\n    keyPitchUp: false,\\n    keyPitchDown: false,\\n    keyYawLeft: false,\\n    keyYawRight: false,\\n    mouseDeltaX: 0,\\n    mouseDeltaY: 0,\\n    pointerLocked: false,\\n  };\\n\\n  public attach(callbacks: InputCallbacks): void {\\n    this.callbacks = callbacks;\\n    window.addEventListener(\'keydown\', this.handleKeyDown);\\n    window.addEventListener(\'keyup\', this.handleKeyUp);\\n    window.addEventListener(\'mousemove\', this.handleMouseMove);\\n    window.addEventListener(\'mousedown\', this.handleMouseDown);\\n    window.addEventListener(\'mouseup\', this.handleMouseUp);\\n    window.addEventListener(\'blur\', this.handleBlur);\\n    document.addEventListener(\'pointerlockchange\', this.handlePointerLockChange);\\n    document.addEventListener(\'pointerlockerror\', this.handlePointerLockError);\\n  }\\n\\n  public detach(): void {\\n    window.removeEventListener(\'keydown\', this.handleKeyDown);\\n    window.removeEventListener(\'keyup\', this.handleKeyUp);\\n    window.removeEventListener(\'mousemove\', this.handleMouseMove);\\n    window.removeEventListener(\'mousedown\', this.handleMouseDown);\\n    window.removeEventListener(\'mouseup\', this.handleMouseUp);\\n    window.removeEventListener(\'blur\', this.handleBlur);\\n    document.removeEventListener(\'pointerlockchange\', this.handlePointerLockChange);\\n    document.removeEventListener(\'pointerlockerror\', this.handlePointerLockError);\\n    this.keys.clear();\\n    this.mouseFireHeld = false;\\n    this.resetDeltas();\\n  }\\n\\n  public setLockTarget(el: HTMLElement | null): void {\\n    this.lockTarget = el;\\n  }\\n\\n  public setActive(isActive: boolean): void {\\n    this.active = isActive;\\n    if (!isActive) {\\n      this.keys.clear();\\n      this.mouseFireHeld = false;\\n      this.resetDeltas();\\n      this.isDraggingFallback = false;\\n    }\\n  }\\n\\n  public requestPointerLock(): void {\\n    const target = this.lockTarget ?? document.body;\\n    if (!target || typeof target.requestPointerLock !== \'function\') return;\\n    try {\\n      const maybePromise = target.requestPointerLock() as unknown as Promise<void> | undefined;\\n      if (maybePromise && typeof maybePromise.catch === \'function\') {\\n        maybePromise.catch(() => {\\n          // Graceful fallback if browser/iframe rejects pointer lock gesture\\n        });\\n      }\\n    } catch {\\n      // Ignore sandboxed pointer lock exceptions\\n    }\\n  }\\n\\n  public exitPointerLock(): void {\\n    if (document.pointerLockElement && typeof document.exitPointerLock === \'function\') {\\n      try {\\n        document.exitPointerLock();\\n      } catch {\\n        // Ignore\\n      }\\n    }\\n  }\\n\\n  public isPointerLocked(): boolean {\\n    return this.pointerLocked;\\n  }\\n\\n  /**\\n   * Reads current key/button states and consumes accumulated mouse deltas for one simulation frame.\\n   */\\n  public consumeSnapshot(): InputSnapshot {\\n    this.snapshot.forward = this.keys.has(\'KeyW\');\\n    this.snapshot.backward = this.keys.has(\'KeyS\');\\n    this.snapshot.rollLeft = this.keys.has(\'KeyA\');\\n    this.snapshot.rollRight = this.keys.has(\'KeyD\');\\n    this.snapshot.boost = this.keys.has(\'ShiftLeft\') || this.keys.has(\'ShiftRight\');\\n    this.snapshot.firePrimary = this.mouseFireHeld || this.keys.has(\'Space\');\\n    this.snapshot.keyPitchUp = this.keys.has(\'ArrowDown\');\\n    this.snapshot.keyPitchDown = this.keys.has(\'ArrowUp\');\\n    this.snapshot.keyYawLeft = this.keys.has(\'ArrowLeft\');\\n    this.snapshot.keyYawRight = this.keys.has(\'ArrowRight\');\\n    this.snapshot.mouseDeltaX = this.mouseDeltaX;\\n    this.snapshot.mouseDeltaY = this.mouseDeltaY;\\n    this.snapshot.pointerLocked = this.pointerLocked;\\n\\n    this.mouseDeltaX = 0;\\n    this.mouseDeltaY = 0;\\n    return this.snapshot;\\n  }\\n\\n  private resetDeltas(): void {\\n    this.mouseDeltaX = 0;\\n    this.mouseDeltaY = 0;\\n  }\\n\\n  private handleKeyDown = (e: KeyboardEvent): void => {\\n    if (e.code === \'Escape\') {\\n      if (this.active) {\\n        e.preventDefault();\\n        this.exitPointerLock();\\n        this.callbacks.onPauseRequested?.();\\n      }\\n      return;\\n    }\\n\\n    if (e.code === \'KeyH\' && this.active && !e.repeat) {\\n      this.callbacks.onToggleHudHints?.();\\n      return;\\n    }\\n\\n    if (!this.active) return;\\n\\n    if (\\n      e.code === \'KeyW\' ||\\n      e.code === \'KeyS\' ||\\n      e.code === \'KeyA\' ||\\n      e.code === \'KeyD\' ||\\n      e.code === \'ShiftLeft\' ||\\n      e.code === \'ShiftRight\' ||\\n      e.code === \'Space\' ||\\n      e.code === \'ArrowUp\' ||\\n      e.code === \'ArrowDown\' ||\\n      e.code === \'ArrowLeft\' ||\\n      e.code === \'ArrowRight\'\\n    ) {\\n      if (e.code === \'Space\') e.preventDefault();\\n      this.keys.add(e.code);\\n    }\\n  };\\n\\n  private handleKeyUp = (e: KeyboardEvent): void => {\\n    this.keys.delete(e.code);\\n  };\\n\\n  private handleMouseMove = (e: MouseEvent): void => {\\n    if (!this.active) return;\\n\\n    if (this.pointerLocked) {\\n      // Generous spike cap (220px) so sweeping aiming motions are never prematurely clipped\\n      const dx = Math.max(-220, Math.min(220, e.movementX));\\n      const dy = Math.max(-220, Math.min(220, e.movementY));\\n      this.mouseDeltaX += dx;\\n      this.mouseDeltaY += dy;\\n    } else if (this.isDraggingFallback) {\\n      const dx = Math.max(-160, Math.min(160, e.clientX - this.lastDragX));\\n      const dy = Math.max(-160, Math.min(160, e.clientY - this.lastDragY));\\n      this.lastDragX = e.clientX;\\n      this.lastDragY = e.clientY;\\n      this.mouseDeltaX += dx;\\n      this.mouseDeltaY += dy;\\n    }\\n  };\\n\\n  private handleMouseDown = (e: MouseEvent): void => {\\n    if (!this.active || e.button !== 0) return;\\n\\n    if (this.pointerLocked) {\\n      this.mouseFireHeld = true;\\n      return;\\n    }\\n\\n    // When unlocked, clicking directly on the canvas engages fallback steering & firing\\n    if (e.target instanceof HTMLCanvasElement) {\\n      this.mouseFireHeld = true;\\n      this.isDraggingFallback = true;\\n      this.lastDragX = e.clientX;\\n      this.lastDragY = e.clientY;\\n    }\\n  };\\n\\n  private handleMouseUp = (e: MouseEvent): void => {\\n    if (e.button === 0) {\\n      this.mouseFireHeld = false;\\n      this.isDraggingFallback = false;\\n    }\\n  };\\n\\n  private handleBlur = (): void => {\\n    this.keys.clear();\\n    this.mouseFireHeld = false;\\n    this.isDraggingFallback = false;\\n    this.resetDeltas();\\n  };\\n\\n  private handlePointerLockChange = (): void => {\\n    const wasLocked = this.pointerLocked;\\n    this.pointerLocked = Boolean(document.pointerLockElement);\\n    this.mouseFireHeld = false;\\n    this.resetDeltas();\\n    this.callbacks.onPointerLockChanged?.(this.pointerLocked);\\n\\n    if (wasLocked && !this.pointerLocked && this.active) {\\n      this.callbacks.onPauseRequested?.();\\n    }\\n  };\\n\\n  private handlePointerLockError = (): void => {\\n    this.pointerLocked = false;\\n    this.callbacks.onPointerLockChanged?.(false);\\n  };\\n}\", \"StartLine\":1, \"TargetContent\":\"export interface InputSnapshot {\\n  forward: boolean;\\n  backward: boolean;\\n  rollLeft: boolean;\\n  rollRight: boolean;\\n  boost: boolean;\\n  keyPitchUp: boolean;\\n  keyPitchDown: boolean;\\n  keyYawLeft: boolean;\\n  keyYawRight: boolean;\\n  mouseDeltaX: number;\\n  mouseDeltaY: number;\\n  pointerLocked: boolean;\\n}\\n\\nexport interface InputCallbacks {\\n  onPauseRequested?: () => void;\\n  onPointerLockChanged?: (locked: boolean) => void;\\n  onToggleHudHints?: () => void;\\n}\\n\\n/**\\n * Decoupled keyboard + Pointer Lock mouse input manager.\\n * Accumulates relative mouse movement deltas cleanly without React state overhead.\\n */\\nexport class InputManager {\\n  private keys = new Set<string>();\\n  private mouseDeltaX = 0;\\n  private mouseDeltaY = 0;\\n  private pointerLocked = false;\\n  private isDraggingFallback = false;\\n  private lastDragX = 0;\\n  private lastDragY = 0;\\n  private lockTarget: HTMLElement | null = null;\\n  private active = false;\\n  private callbacks: InputCallbacks = {};\\n\\n  private readonly snapshot: InputSnapshot = {\\n    forward: false,\\n    backward: false,\\n    rollLeft: false,\\n    rollRight: false,\\n    boost: false,\\n    keyPitchUp: false,\\n    keyPitchDown: false,\\n    keyYawLeft: false,\\n    keyYawRight: false,\\n    mouseDeltaX: 0,\\n    mouseDeltaY: 0,\\n    pointerLocked: false,\\n  };\\n\\n  public attach(callbacks: InputCallbacks): void {\\n    this.callbacks = callbacks;\\n    window.addEventListener(\'keydown\', this.handleKeyDown);\\n    window.addEventListener(\'keyup\', this.handleKeyUp);\\n    window.addEventListener(\'mousemove\', this.handleMouseMove);\\n    window.addEventListener(\'mousedown\', this.handleMouseDown);\\n    window.addEventListener(\'mouseup\', this.handleMouseUp);\\n    window.addEventListener(\'blur\', this.handleBlur);\\n    document.addEventListener(\'pointerlockchange\', this.handlePointerLockChange);\\n    document.addEventListener(\'pointerlockerror\', this.handlePointerLockError);\\n  }\\n\\n  public detach(): void {\\n    window.removeEventListener(\'keydown\', this.handleKeyDown);\\n    window.removeEventListener(\'keyup\', this.handleKeyUp);\\n    window.removeEventListener(\'mousemove\', this.handleMouseMove);\\n    window.removeEventListener(\'mousedown\', this.handleMouseDown);\\n    window.removeEventListener(\'mouseup\', this.handleMouseUp);\\n    window.removeEventListener(\'blur\', this.handleBlur);\\n    document.removeEventListener(\'pointerlockchange\', this.handlePointerLockChange);\\n    document.removeEventListener(\'pointerlockerror\', this.handlePointerLockError);\\n    this.keys.clear();\\n    this.resetDeltas();\\n  }\\n\\n  public setLockTarget(el: HTMLElement | null): void {\\n    this.lockTarget = el;\\n  }\\n\\n  public setActive(isActive: boolean): void {\\n    this.active = isActive;\\n    if (!isActive) {\\n      this.keys.clear();\\n      this.resetDeltas();\\n      this.isDraggingFallback = false;\\n    }\\n  }\\n\\n  public requestPointerLock(): void {\\n    const target = this.lockTarget ?? document.body;\\n    if (!target || typeof target.requestPointerLock !== \'function\') return;\\n    try {\\n      const maybePromise = target.requestPointerLock() as unknown as Promise<void> | undefined;\\n      if (maybePromise && typeof maybePromise.catch === \'function\') {\\n        maybePromise.catch(() => {\\n          // Graceful fallback if browser/iframe rejects pointer lock gesture\\n        });\\n      }\\n    } catch {\\n      // Ignore sandboxed pointer lock exceptions\\n    }\\n  }\\n\\n  public exitPointerLock(): void {\\n    if (document.pointerLockElement && typeof document.exitPointerLock === \'function\') {\\n      try {\\n        document.exitPointerLock();\\n      } catch {\\n        // Ignore\\n      }\\n    }\\n  }\\n\\n  public isPointerLocked(): boolean {\\n    return this.pointerLocked;\\n  }\\n\\n  /**\\n   * Reads current key states and consumes accumulated mouse deltas for one simulation frame.\\n   */\\n  public consumeSnapshot(): InputSnapshot {\\n    this.snapshot.forward = this.keys.has(\'KeyW\');\\n    this.snapshot.backward = this.keys.has(\'KeyS\');\\n    this.snapshot.rollLeft = this.keys.has(\'KeyA\');\\n    this.snapshot.rollRight = this.keys.has(\'KeyD\');\\n    this.snapshot.boost = this.keys.has(\'ShiftLeft\') || this.keys.has(\'ShiftRight\');\\n    this.snapshot.keyPitchUp = this.keys.has(\'ArrowDown\');\\n    this.snapshot.keyPitchDown = this.keys.has(\'ArrowUp\');\\n    this.snapshot.keyYawLeft = this.keys.has(\'ArrowLeft\');\\n    this.snapshot.keyYawRight = this.keys.has(\'ArrowRight\');\\n    this.snapshot.mouseDeltaX = this.mouseDeltaX;\\n    this.snapshot.mouseDeltaY = this.mouseDeltaY;\\n    this.snapshot.pointerLocked = this.pointerLocked;\\n\\n    this.mouseDeltaX = 0;\\n    this.mouseDeltaY = 0;\\n    return this.snapshot;\\n  }\\n\\n  private resetDeltas(): void {\\n    this.mouseDeltaX = 0;\\n    this.mouseDeltaY = 0;\\n  }\\n\\n  private handleKeyDown = (e: KeyboardEvent): void => {\\n    if (e.code === \'Escape\') {\\n      if (this.active) {\\n        e.preventDefault();\\n        this.exitPointerLock();\\n        this.callbacks.onPauseRequested?.();\\n      }\\n      return;\\n    }\\n\\n    if (e.code === \'KeyH\' && this.active && !e.repeat) {\\n      this.callbacks.onToggleHudHints?.();\\n      return;\\n    }\\n\\n    if (!this.active) return;\\n\\n    if (\\n      e.code === \'KeyW\' ||\\n      e.code === \'KeyS\' ||\\n      e.code === \'KeyA\' ||\\n      e.code === \'KeyD\' ||\\n      e.code === \'ShiftLeft\' ||\\n      e.code === \'ShiftRight\' ||\\n      e.code === \'ArrowUp\' ||\\n      e.code === \'ArrowDown\' ||\\n      e.code === \'ArrowLeft\' ||\\n      e.code === \'ArrowRight\'\\n    ) {\\n      this.keys.add(e.code);\\n    }\\n  };\\n\\n  private handleKeyUp = (e: KeyboardEvent): void => {\\n    this.keys.delete(e.code);\\n  };\\n\\n  private handleMouseMove = (e: MouseEvent): void => {\\n    if (!this.active) return;\\n\\n    if (this.pointerLocked) {\\n      // Clamp extreme OS spikes on pointer-lock re-entry\\n      const dx = Math.max(-120, Math.min(120, e.movementX));\\n      const dy = Math.max(-120, Math.min(120, e.movementY));\\n      this.mouseDeltaX += dx;\\n      this.mouseDeltaY += dy;\\n    } else if (this.isDraggingFallback) {\\n      const dx = Math.max(-90, Math.min(90, e.clientX - this.lastDragX));\\n      const dy = Math.max(-90, Math.min(90, e.clientY - this.lastDragY));\\n      this.lastDragX = e.clientX;\\n      this.lastDragY = e.clientY;\\n      this.mouseDeltaX += dx;\\n      this.mouseDeltaY += dy;\\n    }\\n  };\\n\\n  private handleMouseDown = (e: MouseEvent): void => {\\n    if (!this.active || e.button !== 0) return;\\n    // Only engage drag fallback if user clicked directly on canvas while unlocked\\n    if (!this.pointerLocked && e.target instanceof HTMLCanvasElement) {\\n      this.isDraggingFallback = true;\\n      this.lastDragX = e.clientX;\\n      this.lastDragY = e.clientY;\\n    }\\n  };\\n\\n  private handleMouseUp = (): void => {\\n    this.isDraggingFallback = false;\\n  };\\n\\n  private handleBlur = (): void => {\\n    this.keys.clear();\\n    this.isDraggingFallback = false;\\n    this.resetDeltas();\\n  };\\n\\n  private handlePointerLockChange = (): void => {\\n    const wasLocked = this.pointerLocked;\\n    this.pointerLocked = Boolean(document.pointerLockElement);\\n    this.resetDeltas();\\n    this.callbacks.onPointerLockChanged?.(this.pointerLocked);\\n\\n    // When the browser releases Pointer Lock via Esc during active flight, pause cleanly.\\n    if (wasLocked && !this.pointerLocked && this.active) {\\n      this.callbacks.onPauseRequested?.();\\n    }\\n  };\\n\\n  private handlePointerLockError = (): void => {\\n    this.pointerLocked = false;\\n    this.callbacks.onPointerLockChanged?.(false);\\n  };\\n}\", \"TargetFile\":\"/src/engine/InputManager.ts\", \"toolAction\":\"Updating InputManager for weapons\", \"toolSummary\":\"Update src/engine/InputManager.ts\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_3009089304264591749"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Upgrade FlightController with spacious elastic gimbaled mouse aiming envelope, non-linear micro-precision curve, and exact 3D weapon aim ray while preserving thrust/roll/boost physics\", \"EndLine\":255, \"Instruction\":\"Expand mouse aiming envelope in FlightController and initialize new combat telemetry fields in createInitialTelemetry\", \"ReplacementContent\":\"import * as THREE from \'three\';\\nimport type { ProjectedEnemyMarker } from \'../types/combat\';\\nimport type { FlightStatus, FlightTelemetry, GameSettings, ShipConfig } from \'../types/game\';\\nimport type { InputSnapshot } from \'./InputManager\';\\n\\n// Reusable scratch objects (zero per-frame GC allocations)\\nconst _AXIS_X = new THREE.Vector3(1, 0, 0);\\nconst _AXIS_Y = new THREE.Vector3(0, 1, 0);\\nconst _AXIS_Z = new THREE.Vector3(0, 0, 1);\\nconst _FORWARD_LOCAL = new THREE.Vector3(0, 0, -1);\\n\\nconst _qYaw = new THREE.Quaternion();\\nconst _qPitch = new THREE.Quaternion();\\nconst _qRoll = new THREE.Quaternion();\\nconst _qAimYaw = new THREE.Quaternion();\\nconst _qAimPitch = new THREE.Quaternion();\\nconst _forwardWorld = new THREE.Vector3();\\nconst _rightWorld = new THREE.Vector3();\\nconst _upWorld = new THREE.Vector3();\\nconst _desiredVel = new THREE.Vector3();\\nconst _euler = new THREE.Euler(0, 0, 0, \'YXZ\');\\n\\n/**\\n * Spacious gimbaled aiming envelope (off-boresight half-angles in radians).\\n * Allows sweeping aim control across ~46\302\260 horizontally and ~34\302\260 vertically\\n * while the fighter fluidly aligns its nose to the aiming vector.\\n */\\nexport const MAX_AIM_YAW_RAD = THREE.MathUtils.degToRad(23);\\nexport const MAX_AIM_PITCH_RAD = THREE.MathUtils.degToRad(17);\\n\\nfunction createEmptyEnemyMarkers(count = 6): ProjectedEnemyMarker[] {\\n  const list: ProjectedEnemyMarker[] = [];\\n  for (let i = 0; i < count; i++) {\\n    list.push({\\n      active: false,\\n      entityId: \'\',\\n      callsign: \'\',\\n      personalityLabel: \'\',\\n      aiState: \'patrol\',\\n      screenX: 0.5,\\n      screenY: 0.5,\\n      inFront: false,\\n      onScreen: false,\\n      distance: 0,\\n      healthRatio: 1,\\n      isPrimaryTarget: false,\\n      leadX: 0.5,\\n      leadY: 0.5,\\n      leadVisible: false,\\n    });\\n  }\\n  return list;\\n}\\n\\nexport function createInitialTelemetry(ship: ShipConfig): FlightTelemetry {\\n  return {\\n    speed: 0,\\n    signedSpeed: 0,\\n    maxSpeed: ship.flight.maxSpeed,\\n    effectiveMaxSpeed: ship.flight.maxSpeed,\\n    throttle: 0,\\n    boostEnergy: ship.flight.maxBoostEnergy,\\n    maxBoostEnergy: ship.flight.maxBoostEnergy,\\n    isBoosting: false,\\n    boostDepleted: false,\\n    boostIntensity: 0,\\n    hull: ship.maxHull,\\n    maxHull: ship.maxHull,\\n    yawRate: 0,\\n    pitchRate: 0,\\n    rollRate: 0,\\n    aimNormalizedX: 0,\\n    aimNormalizedY: 0,\\n    aimScreenX: 0.5,\\n    aimScreenY: 0.5,\\n    boresightScreenX: 0.5,\\n    boresightScreenY: 0.5,\\n    headingDeg: 0,\\n    pitchDeg: 0,\\n    rollDeg: 0,\\n    altitude: 0,\\n    status: \'STANDBY\',\\n    pointerLocked: false,\\n    isFiring: false,\\n    weaponName: ship.weapons.primaryName,\\n    weaponCooldownRatio: 0,\\n    hitMarkerTimer: 0,\\n    killMarkerTimer: 0,\\n    damageFlashTimer: 0,\\n    muzzleFlashLeft: 0,\\n    muzzleFlashRight: 0,\\n    playerDestroyed: false,\\n    combatStats: {\\n      kills: 0,\\n      shotsFired: 0,\\n      shotsHit: 0,\\n      damageDealt: 0,\\n      damageTaken: 0,\\n      score: 0,\\n      wave: 1,\\n      activeEnemies: 0,\\n    },\\n    enemyMarkers: createEmptyEnemyMarkers(6),\\n    fps: 60,\\n    frameTimeMs: 16.6,\\n    drawCalls: 0,\\n    triangles: 0,\\n  };\\n}\\n\\n/**\\n * Non-linear precision curve for mouse deltas:\\n * Preserves fine 1:1 micro-aiming for small movements while expanding reach on broad sweeps\\n * without simply cranking up global sensitivity.\\n */\\nfunction shapeMouseDelta(deltaPx: number): number {\\n  const abs = Math.abs(deltaPx);\\n  if (abs < 0.0001) return 0;\\n  // Precision zone (< 6px): smooth fine scale; sweeping zone: progressive acceleration\\n  const shaped = abs <= 6 ? abs * 0.85 : 5.1 + Math.pow(abs - 6, 1.18) * 1.18;\\n  return Math.sign(deltaPx) * shaped;\\n}\\n\\n/**\\n * Arcade 6DOF space flight controller.\\n * Ship coordinate system: Forward = -Z, Right = +X, Up = +Y.\\n * Uses an expanded gimbaled aiming envelope (aimYawOffset, aimPitchOffset) so the player\\n * can aim smoothly across a large field of view while the fighter chases the aim vector with zero gimbal lock.\\n */\\nexport class FlightController {\\n  public readonly position = new THREE.Vector3(0, 12, 40);\\n  public readonly quaternion = new THREE.Quaternion();\\n  public readonly velocity = new THREE.Vector3(0, 0, -24);\\n\\n  // Smoothed angular rates (rad/s) in ship local space\\n  public yawVelocity = 0;\\n  public pitchVelocity = 0;\\n  public rollVelocity = 0;\\n\\n  /**\\n   * Persistent gimbaled aiming offsets in ship local space (radians).\\n   * Positive aimYawOffset = aiming left (+Y rotation); negative = aiming right.\\n   * Positive aimPitchOffset = aiming up (+X rotation); negative = aiming down.\\n   */\\n  public aimYawOffset = 0;\\n  public aimPitchOffset = 0;\\n\\n  // Visual banking angle layered on the ship mesh for tactile feel\\n  public visualBankAngle = 0;\\n\\n  private ship: ShipConfig;\\n  private boostEnergy: number;\\n  private boostCooldownTimer = 0;\\n  private boostLockedOut = false;\\n  private boostIntensity = 0;\\n  private wasBoosting = false;\\n  private hull: number;\\n\\n  public constructor(ship: ShipConfig) {\\n    this.ship = ship;\\n    this.boostEnergy = ship.flight.maxBoostEnergy;\\n    this.hull = ship.maxHull;\\n  }\\n\\n  public setShipConfig(ship: ShipConfig): void {\\n    this.ship = ship;\\n    this.boostEnergy = Math.min(this.boostEnergy, ship.flight.maxBoostEnergy);\\n    this.hull = ship.maxHull;\\n  }\\n\\n  public reset(startPosition?: THREE.Vector3): void {\\n    if (startPosition) {\\n      this.position.copy(startPosition);\\n    } else {\\n      this.position.set(0, 12, 40);\\n    }\\n    this.quaternion.identity();\\n    this.velocity.set(0, 0, -28);\\n    this.yawVelocity = 0;\\n    this.pitchVelocity = 0;\\n    this.rollVelocity = 0;\\n    this.aimYawOffset = 0;\\n    this.aimPitchOffset = 0;\\n    this.visualBankAngle = 0;\\n    this.boostEnergy = this.ship.flight.maxBoostEnergy;\\n    this.boostCooldownTimer = 0;\\n    this.boostLockedOut = false;\\n    this.boostIntensity = 0;\\n    this.wasBoosting = false;\\n    this.hull = this.ship.maxHull;\\n  }\\n\\n  public getBoostJustEngaged(): boolean {\\n    return this.boostJustEngaged;\\n  }\\n  private boostJustEngaged = false;\\n\\n  /**\\n   * Computes the exact unit world-space firing/aiming direction combining ship attitude\\n   * with the expanded gimbaled aim offsets. Guaranteed 1:1 with HUD reticle projection.\\n   */\\n  public getAimDirectionWorld(out: THREE.Vector3): THREE.Vector3 {\\n    _qAimYaw.setFromAxisAngle(_AXIS_Y, this.aimYawOffset);\\n    _qAimPitch.setFromAxisAngle(_AXIS_X, this.aimPitchOffset);\\n    out\\n      .copy(_FORWARD_LOCAL)\\n      .applyQuaternion(_qAimPitch)\\n      .applyQuaternion(_qAimYaw)\\n      .applyQuaternion(this.quaternion)\\n      .normalize();\\n    return out;\\n  }\\n\\n  /**\\n   * Computes the 3D world-space convergence point along the player\'s true aim ray.\\n   */\\n  public getAimTargetPoint(out: THREE.Vector3, distance: number): THREE.Vector3 {\\n    this.getAimDirectionWorld(out);\\n    out.multiplyScalar(distance).add(this.position);\\n    return out;\\n  }\\n\\n  /**\\n   * Advances arcade flight simulation by delta time `dt` (seconds) and writes live telemetry.\\n   */\\n  public update(\\n    dt: number,\\n    input: InputSnapshot,\\n    settings: GameSettings,\\n    telemetry: FlightTelemetry,\\n  ): void {\\n    const profile = this.ship.flight;\\n    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);\\n\\n    // 1. Expanded Gimbaled Mouse Aiming Envelope + Precision Response Curve\\n    const sens = settings.mouseSensitivity;\\n    const baseRadPerPx = 0.0024 * sens;\\n    const ySign = settings.invertY ? 1 : -1;\\n\\n    const shapedDx = shapeMouseDelta(input.mouseDeltaX);\\n    const shapedDy = shapeMouseDelta(input.mouseDeltaY);\\n\\n    this.aimYawOffset += -shapedDx * baseRadPerPx;\\n    this.aimPitchOffset += shapedDy * baseRadPerPx * ySign;\\n\\n    // Optional arrow key steering pushes the aim envelope smoothly\\n    if (input.keyYawLeft) this.aimYawOffset += profile.yawSpeed * 0.65 * safeDt;\\n    if (input.keyYawRight) this.aimYawOffset -= profile.yawSpeed * 0.65 * safeDt;\\n    if (input.keyPitchUp) this.aimPitchOffset += profile.pitchSpeed * 0.65 * safeDt;\\n    if (input.keyPitchDown) this.aimPitchOffset -= profile.pitchSpeed * 0.65 * safeDt;\\n\\n    // Softly constrain aim offset to a spacious elliptical envelope (no harsh box clipping)\\n    const normX = this.aimYawOffset / MAX_AIM_YAW_RAD;\\n    const normY = this.aimPitchOffset / MAX_AIM_PITCH_RAD;\\n    const radial = Math.hypot(normX, normY);\\n    if (radial > 1.0) {\\n      this.aimYawOffset /= radial;\\n      this.aimPitchOffset /= radial;\\n    }\\n\\n    // 2. Smooth Chase-the-Aim-Vector Angular Authority (non-linear: ultra-precise near center, strong sweeps at rim)\\n    const absYawRatio = Math.min(1, Math.abs(this.aimYawOffset) / MAX_AIM_YAW_RAD);\\n    const absPitchRatio = Math.min(1, Math.abs(this.aimPitchOffset) / MAX_AIM_PITCH_RAD);\\n\\n    // Progressive authority curve keeps tiny corrections silky while allowing rapid full-range turns\\n    const yawCurve = 0.55 * absYawRatio + 0.72 * Math.pow(absYawRatio, 1.45);\\n    const pitchCurve = 0.55 * absPitchRatio + 0.72 * Math.pow(absPitchRatio, 1.45);\\n\\n    const targetYawVel =\\n      Math.sign(this.aimYawOffset) * yawCurve * profile.yawSpeed * 1.45;\\n    const targetPitchVel =\\n      Math.sign(this.aimPitchOffset) * pitchCurve * profile.pitchSpeed * 1.45;\\n\\n    const angularAlpha = 1 - Math.exp(-(profile.angularDamping * 1.55) * safeDt);\\n    this.yawVelocity = THREE.MathUtils.lerp(this.yawVelocity, targetYawVel, angularAlpha);\\n    this.pitchVelocity = THREE.MathUtils.lerp(this.pitchVelocity, targetPitchVel, angularAlpha);\\n\\n    // Prevent overshoot: ship rotation step eats the remaining aim offset cleanly\\n    let stepYaw = this.yawVelocity * safeDt;\\n    let stepPitch = this.pitchVelocity * safeDt;\\n\\n    if (Math.sign(stepYaw) === Math.sign(this.aimYawOffset) && Math.abs(stepYaw) > Math.abs(this.aimYawOffset)) {\\n      stepYaw = this.aimYawOffset;\\n    }\\n    if (Math.sign(stepPitch) === Math.sign(this.aimPitchOffset) && Math.abs(stepPitch) > Math.abs(this.aimPitchOffset)) {\\n      stepPitch = this.aimPitchOffset;\\n    }\\n\\n    this.aimYawOffset -= stepYaw;\\n    this.aimPitchOffset -= stepPitch;\\n\\n    // Tiny deadzone snap only when essentially centered so ship holds rock-steady aim\\n    if (Math.abs(this.aimYawOffset) < 1e-4 && Math.abs(input.mouseDeltaX) < 0.01) {\\n      this.aimYawOffset = 0;\\n    }\\n    if (Math.abs(this.aimPitchOffset) < 1e-4 && Math.abs(input.mouseDeltaY) < 0.01) {\\n      this.aimPitchOffset = 0;\\n    }\\n\\n    // 3. Independent Roll via A / D (preserves exact Phase 1 roll feel!)\\n    let rollDir = 0;\\n    if (input.rollLeft) rollDir += 1;\\n    if (input.rollRight) rollDir -= 1;\\n    const targetRollRate = rollDir * profile.rollSpeed;\\n    const rollAlpha = 1 - Math.exp(-(profile.angularDamping * 1.25) * safeDt);\\n    this.rollVelocity = THREE.MathUtils.lerp(this.rollVelocity, targetRollRate, rollAlpha);\\n    const stepRoll = this.rollVelocity * safeDt;\\n\\n    // Counter-rotate the 2D local aim offset during deliberate roll so world-space aim stays stable\\n    if (Math.abs(stepRoll) > 1e-5) {\\n      const cosR = Math.cos(-stepRoll);\\n      const sinR = Math.sin(-stepRoll);\\n      const oldYaw = this.aimYawOffset;\\n      const oldPitch = this.aimPitchOffset;\\n      this.aimYawOffset = oldYaw * cosR - oldPitch * sinR;\\n      this.aimPitchOffset = oldYaw * sinR + oldPitch * cosR;\\n    }\\n\\n    // 4. Apply Pure Local-Space Quaternion Rotations (Zero Gimbal Lock at any pitch/yaw!)\\n    _qYaw.setFromAxisAngle(_AXIS_Y, stepYaw);\\n    _qPitch.setFromAxisAngle(_AXIS_X, stepPitch);\\n    _qRoll.setFromAxisAngle(_AXIS_Z, stepRoll);\\n\\n    this.quaternion.multiply(_qYaw);\\n    this.quaternion.multiply(_qPitch);\\n    this.quaternion.multiply(_qRoll);\\n    this.quaternion.normalize();\\n\\n    // Subtle visual bank when yawing without overriding deliberate A/D roll\\n    const targetBank = THREE.MathUtils.clamp(\\n      (this.yawVelocity / profile.yawSpeed) * profile.visualBankStrength,\\n      -0.44,\\n      0.44,\\n    );\\n    this.visualBankAngle = THREE.MathUtils.damp(this.visualBankAngle, targetBank, 6.5, safeDt);\\n\\n    // 5. Boost energy management (unchanged from Phase 1)\\n    if (this.boostLockedOut && this.boostEnergy >= 18) {\\n      this.boostLockedOut = false;\\n    }\\n\\n    const wantsBoost = input.boost && !input.backward && !this.boostLockedOut && this.boostEnergy > 0.5;\\n    const isBoosting = wantsBoost;\\n    this.boostJustEngaged = isBoosting && !this.wasBoosting;\\n    this.wasBoosting = isBoosting;\\n\\n    if (isBoosting) {\\n      this.boostEnergy = Math.max(0, this.boostEnergy - profile.boostDrainRate * safeDt);\\n      this.boostCooldownTimer = profile.boostRegenDelay;\\n      if (this.boostEnergy <= 0.1) {\\n        this.boostEnergy = 0;\\n        this.boostLockedOut = true;\\n      }\\n    } else {\\n      if (this.boostCooldownTimer > 0) {\\n        this.boostCooldownTimer = Math.max(0, this.boostCooldownTimer - safeDt);\\n      } else if (this.boostEnergy < profile.maxBoostEnergy) {\\n        this.boostEnergy = Math.min(\\n          profile.maxBoostEnergy,\\n          this.boostEnergy + profile.boostRegenRate * safeDt,\\n        );\\n      }\\n    }\\n\\n    this.boostIntensity = THREE.MathUtils.damp(\\n      this.boostIntensity,\\n      isBoosting ? 1 : 0,\\n      isBoosting ? 9.0 : 5.5,\\n      safeDt,\\n    );\\n\\n    // 6. Linear thrust, controlled arcade inertia, and lateral redirection (unchanged from Phase 1)\\n    _forwardWorld.copy(_FORWARD_LOCAL).applyQuaternion(this.quaternion).normalize();\\n    _rightWorld.copy(_AXIS_X).applyQuaternion(this.quaternion).normalize();\\n    _upWorld.copy(_AXIS_Y).applyQuaternion(this.quaternion).normalize();\\n\\n    const currentForwardSpeed = this.velocity.dot(_forwardWorld);\\n    const effectiveMaxSpeed = isBoosting\\n      ? profile.maxSpeed * profile.boostMultiplier\\n      : profile.maxSpeed;\\n\\n    let nextForwardSpeed = currentForwardSpeed;\\n    let throttle = 0;\\n\\n    if (isBoosting) {\\n      throttle = 1;\\n      const boostAccel = profile.acceleration * profile.boostAccelMultiplier;\\n      nextForwardSpeed = Math.min(effectiveMaxSpeed, currentForwardSpeed + boostAccel * safeDt);\\n    } else if (input.forward && !input.backward) {\\n      throttle = 1;\\n      if (currentForwardSpeed > profile.maxSpeed) {\\n        nextForwardSpeed = THREE.MathUtils.damp(currentForwardSpeed, profile.maxSpeed, 2.2, safeDt);\\n      } else {\\n        nextForwardSpeed = Math.min(\\n          profile.maxSpeed,\\n          currentForwardSpeed + profile.acceleration * safeDt,\\n        );\\n      }\\n    } else if (input.backward && !input.forward) {\\n      throttle = -1;\\n      nextForwardSpeed = Math.max(\\n        -profile.maxReverseSpeed,\\n        currentForwardSpeed - profile.deceleration * safeDt,\\n      );\\n    } else {\\n      const dragFactor = Math.exp(-profile.passiveDrag * safeDt);\\n      nextForwardSpeed = currentForwardSpeed * dragFactor;\\n      if (Math.abs(nextForwardSpeed) < 0.15) nextForwardSpeed = 0;\\n    }\\n\\n    _desiredVel.copy(_forwardWorld).multiplyScalar(nextForwardSpeed);\\n    const gripLambda = isBoosting ? profile.lateralGrip * 1.45 : profile.lateralGrip;\\n    const gripAlpha = 1 - Math.exp(-gripLambda * safeDt);\\n    this.velocity.lerp(_desiredVel, gripAlpha);\\n\\n    const updatedForward = this.velocity.dot(_forwardWorld);\\n    this.velocity.addScaledVector(_forwardWorld, nextForwardSpeed - updatedForward);\\n\\n    this.position.addScaledVector(this.velocity, safeDt);\\n\\n    // 7. Populate live HUD telemetry (in-place mutation, zero allocations)\\n    const speedMag = this.velocity.length();\\n    const signedSpeed = this.velocity.dot(_forwardWorld);\\n\\n    _euler.setFromQuaternion(this.quaternion, \'YXZ\');\\n    let headingDeg = THREE.MathUtils.radToDeg(-_euler.y) % 360;\\n    if (headingDeg < 0) headingDeg += 360;\\n\\n    let status: FlightStatus = \'DRIFTING\';\\n    if (this.boostLockedOut && input.boost) {\\n      status = \'BOOST DEPLETED\';\\n    } else if (isBoosting) {\\n      status = \'BOOSTING\';\\n    } else if (signedSpeed < -2.5) {\\n      status = \'REVERSING\';\\n    } else if (input.forward) {\\n      status = speedMag > profile.maxSpeed * 0.9 ? \'CRUISING\' : \'ACCELERATING\';\\n    } else if (speedMag < 2) {\\n      status = \'STANDBY\';\\n    } else {\\n      status = \'DRIFTING\';\\n    }\\n\\n    telemetry.speed = speedMag;\\n    telemetry.signedSpeed = signedSpeed;\\n    telemetry.maxSpeed = profile.maxSpeed;\\n    telemetry.effectiveMaxSpeed = effectiveMaxSpeed;\\n    telemetry.throttle = throttle;\\n    telemetry.boostEnergy = this.boostEnergy;\\n    telemetry.maxBoostEnergy = profile.maxBoostEnergy;\\n    telemetry.isBoosting = isBoosting;\\n    telemetry.boostDepleted = this.boostLockedOut;\\n    telemetry.boostIntensity = this.boostIntensity;\\n    telemetry.hull = this.hull;\\n    telemetry.maxHull = this.ship.maxHull;\\n    telemetry.yawRate = THREE.MathUtils.clamp(this.yawVelocity / profile.yawSpeed, -1, 1);\\n    telemetry.pitchRate = THREE.MathUtils.clamp(this.pitchVelocity / profile.pitchSpeed, -1, 1);\\n    telemetry.rollRate = THREE.MathUtils.clamp(this.rollVelocity / profile.rollSpeed, -1, 1);\\n    telemetry.aimNormalizedX = THREE.MathUtils.clamp(-this.aimYawOffset / MAX_AIM_YAW_RAD, -1, 1);\\n    telemetry.aimNormalizedY = THREE.MathUtils.clamp(-this.aimPitchOffset / MAX_AIM_PITCH_RAD, -1, 1);\\n    telemetry.headingDeg = headingDeg;\\n    telemetry.pitchDeg = THREE.MathUtils.radToDeg(_euler.x);\\n    telemetry.rollDeg = THREE.MathUtils.radToDeg(_euler.z);\\n    telemetry.altitude = this.position.y;\\n    telemetry.status = status;\\n    telemetry.pointerLocked = input.pointerLocked;\\n  }\\n}\", \"StartLine\":1, \"TargetContent\":\"import * as THREE from \'three\';\\nimport type { FlightStatus, FlightTelemetry, GameSettings, ShipConfig } from \'../types/game\';\\nimport type { InputSnapshot } from \'./InputManager\';\\n\\n// Reusable scratch objects (zero per-frame GC allocations)\\nconst _AXIS_X = new THREE.Vector3(1, 0, 0);\\nconst _AXIS_Y = new THREE.Vector3(0, 1, 0);\\nconst _AXIS_Z = new THREE.Vector3(0, 0, 1);\\nconst _FORWARD_LOCAL = new THREE.Vector3(0, 0, -1);\\n\\nconst _qYaw = new THREE.Quaternion();\\nconst _qPitch = new THREE.Quaternion();\\nconst _qRoll = new THREE.Quaternion();\\nconst _forwardWorld = new THREE.Vector3();\\nconst _rightWorld = new THREE.Vector3();\\nconst _upWorld = new THREE.Vector3();\\nconst _desiredVel = new THREE.Vector3();\\nconst _euler = new THREE.Euler(0, 0, 0, \'YXZ\');\\n\\nexport function createInitialTelemetry(ship: ShipConfig): FlightTelemetry {\\n  return {\\n    speed: 0,\\n    signedSpeed: 0,\\n    maxSpeed: ship.flight.maxSpeed,\\n    effectiveMaxSpeed: ship.flight.maxSpeed,\\n    throttle: 0,\\n    boostEnergy: ship.flight.maxBoostEnergy,\\n    maxBoostEnergy: ship.flight.maxBoostEnergy,\\n    isBoosting: false,\\n    boostDepleted: false,\\n    boostIntensity: 0,\\n    hull: ship.maxHull,\\n    maxHull: ship.maxHull,\\n    yawRate: 0,\\n    pitchRate: 0,\\n    rollRate: 0,\\n    headingDeg: 0,\\n    pitchDeg: 0,\\n    rollDeg: 0,\\n    altitude: 0,\\n    status: \'STANDBY\',\\n    pointerLocked: false,\\n    fps: 60,\\n    frameTimeMs: 16.6,\\n    drawCalls: 0,\\n    triangles: 0,\\n  };\\n}\\n\\n/**\\n * Arcade 6DOF space flight controller.\\n * Ship coordinate system: Forward = -Z, Right = +X, Up = +Y.\\n * Completely independent of React UI and ship geometry implementation.\\n */\\nexport class FlightController {\\n  public readonly position = new THREE.Vector3(0, 12, 40);\\n  public readonly quaternion = new THREE.Quaternion();\\n  public readonly velocity = new THREE.Vector3(0, 0, -24);\\n\\n  // Smoothed angular rates (rad/s) in ship local space\\n  public yawVelocity = 0;\\n  public pitchVelocity = 0;\\n  public rollVelocity = 0;\\n\\n  // Visual banking angle layered on the ship mesh for tactile feel\\n  public visualBankAngle = 0;\\n\\n  private ship: ShipConfig;\\n  private boostEnergy: number;\\n  private boostCooldownTimer = 0;\\n  private boostLockedOut = false;\\n  private boostIntensity = 0;\\n  private wasBoosting = false;\\n  private hull: number;\\n\\n  public constructor(ship: ShipConfig) {\\n    this.ship = ship;\\n    this.boostEnergy = ship.flight.maxBoostEnergy;\\n    this.hull = ship.maxHull;\\n  }\\n\\n  public setShipConfig(ship: ShipConfig): void {\\n    this.ship = ship;\\n    this.boostEnergy = Math.min(this.boostEnergy, ship.flight.maxBoostEnergy);\\n    this.hull = ship.maxHull;\\n  }\\n\\n  public reset(startPosition?: THREE.Vector3): void {\\n    if (startPosition) {\\n      this.position.copy(startPosition);\\n    } else {\\n      this.position.set(0, 12, 40);\\n    }\\n    this.quaternion.identity();\\n    this.velocity.set(0, 0, -28);\\n    this.yawVelocity = 0;\\n    this.pitchVelocity = 0;\\n    this.rollVelocity = 0;\\n    this.visualBankAngle = 0;\\n    this.boostEnergy = this.ship.flight.maxBoostEnergy;\\n    this.boostCooldownTimer = 0;\\n    this.boostLockedOut = false;\\n    this.boostIntensity = 0;\\n    this.wasBoosting = false;\\n    this.hull = this.ship.maxHull;\\n  }\\n\\n  public getBoostJustEngaged(): boolean {\\n    return this.boostJustEngaged;\\n  }\\n  private boostJustEngaged = false;\\n\\n  /**\\n   * Advances arcade flight simulation by delta time `dt` (seconds) and writes live telemetry.\\n   */\\n  public update(\\n    dt: number,\\n    input: InputSnapshot,\\n    settings: GameSettings,\\n    telemetry: FlightTelemetry,\\n  ): void {\\n    const profile = this.ship.flight;\\n    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);\\n\\n    // 1. Mouse-driven Yaw & Pitch (plus optional arrow key assistance)\\n    const sens = settings.mouseSensitivity;\\n    const mouseScale = 0.0042 * sens;\\n\\n    let targetYawInput = -input.mouseDeltaX * mouseScale / safeDt;\\n    const ySign = settings.invertY ? 1 : -1;\\n    let targetPitchInput = input.mouseDeltaY * mouseScale * ySign / safeDt;\\n\\n    if (input.keyYawLeft) targetYawInput += profile.yawSpeed * 0.85;\\n    if (input.keyYawRight) targetYawInput -= profile.yawSpeed * 0.85;\\n    if (input.keyPitchUp) targetPitchInput += profile.pitchSpeed * 0.85;\\n    if (input.keyPitchDown) targetPitchInput -= profile.pitchSpeed * 0.85;\\n\\n    // Clamp to max angular authority so fast mouse flicks feel aggressive yet controlled\\n    const maxYaw = profile.yawSpeed * (1.25 + sens * 0.35);\\n    const maxPitch = profile.pitchSpeed * (1.25 + sens * 0.35);\\n    targetYawInput = THREE.MathUtils.clamp(targetYawInput, -maxYaw, maxYaw);\\n    targetPitchInput = THREE.MathUtils.clamp(targetPitchInput, -maxPitch, maxPitch);\\n\\n    // Smooth response: snappy attack when mouse moves, crisp damping when released\\n    const mouseActive =\\n      Math.abs(input.mouseDeltaX) > 0.01 ||\\n      Math.abs(input.mouseDeltaY) > 0.01 ||\\n      input.keyYawLeft ||\\n      input.keyYawRight ||\\n      input.keyPitchUp ||\\n      input.keyPitchDown;\\n    const angularLambda = mouseActive ? profile.angularDamping * 1.9 : profile.angularDamping * 1.35;\\n    const angularAlpha = 1 - Math.exp(-angularLambda * safeDt);\\n\\n    this.yawVelocity = THREE.MathUtils.lerp(this.yawVelocity, targetYawInput, angularAlpha);\\n    this.pitchVelocity = THREE.MathUtils.lerp(this.pitchVelocity, targetPitchInput, angularAlpha);\\n\\n    // 2. Independent Roll via A / D\\n    let rollDir = 0;\\n    if (input.rollLeft) rollDir += 1;\\n    if (input.rollRight) rollDir -= 1;\\n    const targetRollRate = rollDir * profile.rollSpeed;\\n    const rollAlpha = 1 - Math.exp(-(profile.angularDamping * 1.25) * safeDt);\\n    this.rollVelocity = THREE.MathUtils.lerp(this.rollVelocity, targetRollRate, rollAlpha);\\n\\n    // 3. Apply local-space quaternion rotations (zero gimbal lock in 6DOF space!)\\n    _qYaw.setFromAxisAngle(_AXIS_Y, this.yawVelocity * safeDt);\\n    _qPitch.setFromAxisAngle(_AXIS_X, this.pitchVelocity * safeDt);\\n    _qRoll.setFromAxisAngle(_AXIS_Z, this.rollVelocity * safeDt);\\n\\n    this.quaternion.multiply(_qYaw);\\n    this.quaternion.multiply(_qPitch);\\n    this.quaternion.multiply(_qRoll);\\n    this.quaternion.normalize();\\n\\n    // Subtle visual bank when yawing without overriding deliberate A/D roll\\n    const targetBank = THREE.MathUtils.clamp(\\n      (this.yawVelocity / profile.yawSpeed) * profile.visualBankStrength,\\n      -0.42,\\n      0.42,\\n    );\\n    this.visualBankAngle = THREE.MathUtils.damp(this.visualBankAngle, targetBank, 6.5, safeDt);\\n\\n    // 4. Boost energy management\\n    if (this.boostLockedOut && this.boostEnergy >= 18) {\\n      this.boostLockedOut = false;\\n    }\\n\\n    const wantsBoost = input.boost && !input.backward && !this.boostLockedOut && this.boostEnergy > 0.5;\\n    const isBoosting = wantsBoost;\\n    this.boostJustEngaged = isBoosting && !this.wasBoosting;\\n    this.wasBoosting = isBoosting;\\n\\n    if (isBoosting) {\\n      this.boostEnergy = Math.max(0, this.boostEnergy - profile.boostDrainRate * safeDt);\\n      this.boostCooldownTimer = profile.boostRegenDelay;\\n      if (this.boostEnergy <= 0.1) {\\n        this.boostEnergy = 0;\\n        this.boostLockedOut = true;\\n      }\\n    } else {\\n      if (this.boostCooldownTimer > 0) {\\n        this.boostCooldownTimer = Math.max(0, this.boostCooldownTimer - safeDt);\\n      } else if (this.boostEnergy < profile.maxBoostEnergy) {\\n        this.boostEnergy = Math.min(\\n          profile.maxBoostEnergy,\\n          this.boostEnergy + profile.boostRegenRate * safeDt,\\n        );\\n      }\\n    }\\n\\n    this.boostIntensity = THREE.MathUtils.damp(\\n      this.boostIntensity,\\n      isBoosting ? 1 : 0,\\n      isBoosting ? 9.0 : 5.5,\\n      safeDt,\\n    );\\n\\n    // 5. Linear thrust, controlled arcade inertia, and lateral redirection\\n    _forwardWorld.copy(_FORWARD_LOCAL).applyQuaternion(this.quaternion).normalize();\\n    _rightWorld.copy(_AXIS_X).applyQuaternion(this.quaternion).normalize();\\n    _upWorld.copy(_AXIS_Y).applyQuaternion(this.quaternion).normalize();\\n\\n    const currentForwardSpeed = this.velocity.dot(_forwardWorld);\\n    const effectiveMaxSpeed = isBoosting\\n      ? profile.maxSpeed * profile.boostMultiplier\\n      : profile.maxSpeed;\\n\\n    let nextForwardSpeed = currentForwardSpeed;\\n    let throttle = 0;\\n\\n    if (isBoosting) {\\n      throttle = 1;\\n      const boostAccel = profile.acceleration * profile.boostAccelMultiplier;\\n      nextForwardSpeed = Math.min(effectiveMaxSpeed, currentForwardSpeed + boostAccel * safeDt);\\n    } else if (input.forward && !input.backward) {\\n      throttle = 1;\\n      if (currentForwardSpeed > profile.maxSpeed) {\\n        // Smooth bleed-down after releasing boost\\n        nextForwardSpeed = THREE.MathUtils.damp(currentForwardSpeed, profile.maxSpeed, 2.2, safeDt);\\n      } else {\\n        nextForwardSpeed = Math.min(\\n          profile.maxSpeed,\\n          currentForwardSpeed + profile.acceleration * safeDt,\\n        );\\n      }\\n    } else if (input.backward && !input.forward) {\\n      throttle = -1;\\n      nextForwardSpeed = Math.max(\\n        -profile.maxReverseSpeed,\\n        currentForwardSpeed - profile.deceleration * safeDt,\\n      );\\n    } else {\\n      // Controlled space inertia: gradual drag while preserving fast glide sensation\\n      const dragFactor = Math.exp(-profile.passiveDrag * safeDt);\\n      nextForwardSpeed = currentForwardSpeed * dragFactor;\\n      if (Math.abs(nextForwardSpeed) < 0.15) nextForwardSpeed = 0;\\n    }\\n\\n    // Redirect existing velocity smoothly toward the ship\'s new facing direction\\n    // (gives tight arcade cornering with subtle, satisfying drift momentum)\\n    _desiredVel.copy(_forwardWorld).multiplyScalar(nextForwardSpeed);\\n    const gripLambda = isBoosting ? profile.lateralGrip * 1.45 : profile.lateralGrip;\\n    const gripAlpha = 1 - Math.exp(-gripLambda * safeDt);\\n    this.velocity.lerp(_desiredVel, gripAlpha);\\n\\n    // Ensure forward speed component tracks target thrust immediately without lag\\n    const updatedForward = this.velocity.dot(_forwardWorld);\\n    this.velocity.addScaledVector(_forwardWorld, nextForwardSpeed - updatedForward);\\n\\n    // Integrate world position\\n    this.position.addScaledVector(this.velocity, safeDt);\\n\\n    // 6. Populate live HUD telemetry (in-place mutation, zero allocations)\\n    const speedMag = this.velocity.length();\\n    const signedSpeed = this.velocity.dot(_forwardWorld);\\n\\n    _euler.setFromQuaternion(this.quaternion, \'YXZ\');\\n    let headingDeg = THREE.MathUtils.radToDeg(-_euler.y) % 360;\\n    if (headingDeg < 0) headingDeg += 360;\\n\\n    let status: FlightStatus = \'DRIFTING\';\\n    if (this.boostLockedOut && input.boost) {\\n      status = \'BOOST DEPLETED\';\\n    } else if (isBoosting) {\\n      status = \'BOOSTING\';\\n    } else if (signedSpeed < -2.5) {\\n      status = \'REVERSING\';\\n    } else if (input.forward) {\\n      status = speedMag > profile.maxSpeed * 0.9 ? \'CRUISING\' : \'ACCELERATING\';\\n    } else if (speedMag < 2) {\\n      status = \'STANDBY\';\\n    } else {\\n      status = \'DRIFTING\';\\n    }\\n\\n    telemetry.speed = speedMag;\\n    telemetry.signedSpeed = signedSpeed;\\n    telemetry.maxSpeed = profile.maxSpeed;\\n    telemetry.effectiveMaxSpeed = effectiveMaxSpeed;\\n    telemetry.throttle = throttle;\\n    telemetry.boostEnergy = this.boostEnergy;\\n    telemetry.maxBoostEnergy = profile.maxBoostEnergy;\\n    telemetry.isBoosting = isBoosting;\\n    telemetry.boostDepleted = this.boostLockedOut;\\n    telemetry.boostIntensity = this.boostIntensity;\\n    telemetry.hull = this.hull;\\n    telemetry.maxHull = this.ship.maxHull;\\n    telemetry.yawRate = THREE.MathUtils.clamp(this.yawVelocity / profile.yawSpeed, -1, 1);\\n    telemetry.pitchRate = THREE.MathUtils.clamp(this.pitchVelocity / profile.pitchSpeed, -1, 1);\\n    telemetry.rollRate = THREE.MathUtils.clamp(this.rollVelocity / profile.rollSpeed, -1, 1);\\n    telemetry.headingDeg = headingDeg;\\n    telemetry.pitchDeg = THREE.MathUtils.radToDeg(_euler.x);\\n    telemetry.rollDeg = THREE.MathUtils.radToDeg(_euler.z);\\n    telemetry.altitude = this.position.y;\\n    telemetry.status = status;\\n    telemetry.pointerLocked = input.pointerLocked;\\n  }\\n}\", \"TargetFile\":\"/src/engine/FlightController.ts\", \"toolAction\":\"Expanding FlightController aiming envelope\", \"toolSummary\":\"Update src/engine/FlightController.ts\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_3009089304264591430"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Keep CameraController smoothly aligned with the expanded gimbaled aiming envelope and add subtle combat shock impulse\", \"EndLine\":120, \"Instruction\":\"Update CameraController.updateChase to blend look target gently toward flight aim ray and accept optional combatImpulse\", \"ReplacementContent\":\"  public updateChase(\\n    dt: number,\\n    flight: FlightController,\\n    camera: THREE.PerspectiveCamera,\\n    settings: GameSettings,\\n    boostIntensity: number,\\n    elapsedTime: number,\\n    combatImpulse = 0,\\n  ): void {\\n    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);\\n\\n    if (!this.initialized) {\\n      this.snapToShip(flight, camera, settings.cameraDistance);\\n      return;\\n    }\\n\\n    _forward.set(0, 0, -1).applyQuaternion(flight.quaternion).normalize();\\n    _up.set(0, 1, 0).applyQuaternion(flight.quaternion).normalize();\\n    _right.set(1, 0, 0).applyQuaternion(flight.quaternion).normalize();\\n\\n    // Subtle lateral & vertical turn lag so aggressive maneuvers feel dynamic\\n    // Clamped strictly so the ship never leaves center framing.\\n    const camSens = settings.cameraSensitivity;\\n    const lagX = THREE.MathUtils.clamp(-flight.yawVelocity * 0.65 * camSens, -1.65, 1.65);\\n    const lagY = THREE.MathUtils.clamp(flight.pitchVelocity * 0.52 * camSens, -1.15, 1.15);\\n\\n    // Pull back slightly on boost to emphasize acceleration\\n    const dynamicDist = settings.cameraDistance + boostIntensity * 1.45;\\n    const heightOffset = 2.25 - boostIntensity * 0.25;\\n\\n    _offsetLocal.set(lagX, heightOffset + lagY, dynamicDist).applyQuaternion(flight.quaternion);\\n    _desiredPos.copy(flight.position).add(_offsetLocal);\\n\\n    // Smooth frame-rate-independent positional follow\\n    const posLambda = (10.5 + boostIntensity * 3.5) * THREE.MathUtils.clamp(camSens, 0.65, 1.5);\\n    const posAlpha = 1 - Math.exp(-posLambda * safeDt);\\n    this.currentPos.lerp(_desiredPos, posAlpha);\\n\\n    // Guardrail: never allow camera to drift far from ship during extreme turns\\n    const maxAllowedDist = dynamicDist + 3.2;\\n    const distFromShip = this.currentPos.distanceTo(flight.position);\\n    if (distFromShip > maxAllowedDist) {\\n      this.currentPos\\n        .sub(flight.position)\\n        .multiplyScalar(maxAllowedDist / distFromShip)\\n        .add(flight.position);\\n    }\\n\\n    // Smooth camera up-vector roll tracking (responsive yet fluid on A/D rolls)\\n    const upAlpha = 1 - Math.exp(-(7.8 * camSens) * safeDt);\\n    this.currentUp.lerp(_up, upAlpha).normalize();\\n\\n    // Gently blend look target toward the expanded gimbaled aim vector so wide aiming stays well framed\\n    flight.getAimDirectionWorld(_lookTarget);\\n    _lookTarget.lerp(_forward, 0.58).normalize();\\n    _lookTarget.multiplyScalar(32).add(flight.position).addScaledVector(_up, 0.72);\\n\\n    _lookMatrix.lookAt(this.currentPos, _lookTarget, this.currentUp);\\n    _desiredQuat.setFromRotationMatrix(_lookMatrix);\\n\\n    const rotAlpha = 1 - Math.exp(-(11.5 * camSens) * safeDt);\\n    this.currentQuat.slerp(_desiredQuat, rotAlpha);\\n\\n    // Subtle high-frequency propulsion tremor during boost + brief combat impact impulse\\n    camera.position.copy(this.currentPos);\\n    const tremor = boostIntensity * 0.042 + combatImpulse * 0.14;\\n    if (tremor > 0.004) {\\n      _shakeVec\\n        .set(\\n          Math.sin(elapsedTime * 57.0) * tremor,\\n          Math.cos(elapsedTime * 67.0) * tremor,\\n          0,\\n        )\\n        .applyQuaternion(this.currentQuat);\\n      camera.position.add(_shakeVec);\\n    }\\n\\n    camera.quaternion.copy(this.currentQuat);\\n\\n    // Dynamic boost FOV widening\\n    const targetFov = 62 + boostIntensity * 16.5;\\n    const nextFov = THREE.MathUtils.damp(this.currentFov, targetFov, 7.0, safeDt);\\n    if (Math.abs(nextFov - this.currentFov) > 0.01) {\\n      this.currentFov = nextFov;\\n      camera.fov = this.currentFov;\\n      camera.updateProjectionMatrix();\\n    }\\n  }\", \"StartLine\":42, \"TargetContent\":\"  public updateChase(\\n    dt: number,\\n    flight: FlightController,\\n    camera: THREE.PerspectiveCamera,\\n    settings: GameSettings,\\n    boostIntensity: number,\\n    elapsedTime: number,\\n  ): void {\\n    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);\\n\\n    if (!this.initialized) {\\n      this.snapToShip(flight, camera, settings.cameraDistance);\\n      return;\\n    }\\n\\n    _forward.set(0, 0, -1).applyQuaternion(flight.quaternion).normalize();\\n    _up.set(0, 1, 0).applyQuaternion(flight.quaternion).normalize();\\n    _right.set(1, 0, 0).applyQuaternion(flight.quaternion).normalize();\\n\\n    // Subtle lateral & vertical turn lag so aggressive maneuvers feel dynamic\\n    // Clamped strictly so the ship never leaves the center framing.\\n    const camSens = settings.cameraSensitivity;\\n    const lagX = THREE.MathUtils.clamp(-flight.yawVelocity * 0.72 * camSens, -1.6, 1.6);\\n    const lagY = THREE.MathUtils.clamp(flight.pitchVelocity * 0.55 * camSens, -1.1, 1.1);\\n\\n    // Pull back slightly on boost to emphasize acceleration\\n    const dynamicDist = settings.cameraDistance + boostIntensity * 1.45;\\n    const heightOffset = 2.25 - boostIntensity * 0.25;\\n\\n    _offsetLocal.set(lagX, heightOffset + lagY, dynamicDist).applyQuaternion(flight.quaternion);\\n    _desiredPos.copy(flight.position).add(_offsetLocal);\\n\\n    // Smooth frame-rate-independent positional follow\\n    const posLambda = (10.5 + boostIntensity * 3.5) * THREE.MathUtils.clamp(camSens, 0.65, 1.5);\\n    const posAlpha = 1 - Math.exp(-posLambda * safeDt);\\n    this.currentPos.lerp(_desiredPos, posAlpha);\\n\\n    // Guardrail: never allow camera to drift far from ship during extreme turns\\n    const maxAllowedDist = dynamicDist + 3.2;\\n    const distFromShip = this.currentPos.distanceTo(flight.position);\\n    if (distFromShip > maxAllowedDist) {\\n      this.currentPos\\n        .sub(flight.position)\\n        .multiplyScalar(maxAllowedDist / distFromShip)\\n        .add(flight.position);\\n    }\\n\\n    // Smooth camera up-vector roll tracking (responsive yet fluid on A/D rolls)\\n    const upAlpha = 1 - Math.exp(-(7.5 * camSens) * safeDt);\\n    this.currentUp.lerp(_up, upAlpha).normalize();\\n\\n    // Look slightly ahead of the ship nose + gentle lead into turns\\n    _lookTarget\\n      .copy(flight.position)\\n      .addScaledVector(_forward, 28)\\n      .addScaledVector(_up, 0.75 + flight.pitchVelocity * 0.5)\\n      .addScaledVector(_right, -flight.yawVelocity * 0.75);\\n\\n    _lookMatrix.lookAt(this.currentPos, _lookTarget, this.currentUp);\\n    _desiredQuat.setFromRotationMatrix(_lookMatrix);\\n\\n    const rotAlpha = 1 - Math.exp(-(11.5 * camSens) * safeDt);\\n    this.currentQuat.slerp(_desiredQuat, rotAlpha);\\n\\n    // Subtle high-frequency propulsion tremor strictly during active boost\\n    camera.position.copy(this.currentPos);\\n    if (boostIntensity > 0.02) {\\n      const amp = 0.045 * boostIntensity;\\n      _shakeVec\\n        .set(\\n          Math.sin(elapsedTime * 53.0) * amp,\\n          Math.cos(elapsedTime * 61.0) * amp,\\n          0,\\n        )\\n        .applyQuaternion(this.currentQuat);\\n      camera.position.add(_shakeVec);\\n    }\\n\\n    camera.quaternion.copy(this.currentQuat);\\n\\n    // Dynamic boost FOV widening\\n    const targetFov = 62 + boostIntensity * 16.5;\\n    const nextFov = THREE.MathUtils.damp(this.currentFov, targetFov, 7.0, safeDt);\\n    if (Math.abs(nextFov - this.currentFov) > 0.01) {\\n      this.currentFov = nextFov;\\n      camera.fov = this.currentFov;\\n      camera.updateProjectionMatrix();\\n    }\\n  }\", \"TargetFile\":\"/src/engine/CameraController.ts\", \"toolAction\":\"Updating CameraController for wide aim\", \"toolSummary\":\"Update src/engine/CameraController.ts\"}"
