  code_action {
    action_spec {
      command {
        instruction: "Update telemetry initializer, progressive steering configuration/evaluator, and FlightController steering update in src/engine/FlightController.ts"
        is_edit: true
        file {
          absolute_uri: "file:///src/engine/FlightController.ts"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "import type { FlightStatus, FlightTelemetry, GameSettings, ShipConfig } from \'../types/game\';\nimport type { InputSnapshot } from \'./InputManager\';\n\n// Reusable scratch objects (zero per-frame GC allocations)\nconst _AXIS_X = new THREE.Vector3(1, 0, 0);\nconst _AXIS_Y = new THREE.Vector3(0, 1, 0);\nconst _AXIS_Z = new THREE.Vector3(0, 0, 1);\nconst _FORWARD_LOCAL = new THREE.Vector3(0, 0, -1);\n\nconst _qYaw = new THREE.Quaternion();\nconst _qPitch = new THREE.Quaternion();\nconst _qRoll = new THREE.Quaternion();\nconst _forwardWorld = new THREE.Vector3();\nconst _rightWorld = new THREE.Vector3();\nconst _upWorld = new THREE.Vector3();\nconst _desiredVel = new THREE.Vector3();\nconst _euler = new THREE.Euler(0, 0, 0, \'YXZ\');\n\nfunction createEmptyEnemyMarkers(count = 6): ProjectedEnemyMarker[] {\n  const list: ProjectedEnemyMarker[] = [];\n  for (let i = 0; i < count; i++) {\n    list.push({\n      active: false,\n      entityId: \'\',\n      callsign: \'\',\n      personalityLabel: \'\',\n      aiState: \'patrol\',\n      screenX: 0.5,\n      screenY: 0.5,\n      inFront: false,\n      onScreen: false,\n      distance: 0,\n      healthRatio: 1,\n      isPrimaryTarget: false,\n      isPriorityTarget: false,\n      leadX: 0.5,\n      leadY: 0.5,\n      leadVisible: false,\n    });\n  }\n  return list;\n}\n\nexport function createInitialTelemetry(ship: ShipConfig): FlightTelemetry {\n  return {\n    speed: 0,\n    signedSpeed: 0,\n    maxSpeed: ship.flight.maxSpeed,\n    effectiveMaxSpeed: ship.flight.maxSpeed,\n    throttle: 0,\n    boostEnergy: ship.flight.maxBoostEnergy,\n    maxBoostEnergy: ship.flight.maxBoostEnergy,\n    isBoosting: false,\n    boostDepleted: false,\n    boostIntensity: 0,\n    hull: ship.maxHull,\n    maxHull: ship.maxHull,\n    yawRate: 0,\n    pitchRate: 0,\n    rollRate: 0,\n    aimNormalizedX: 0,\n    aimNormalizedY: 0,\n    aimScreenX: 0.5,\n    aimScreenY: 0.5,\n    boresightScreenX: 0.5,\n    boresightScreenY: 0.5,\n    headingDeg: 0,\n    pitchDeg: 0,\n    rollDeg: 0,\n    altitude: 0,\n    status: \'STANDBY\',\n    pointerLocked: false,\n    isFiring: false,\n    weaponName: ship.weapons.primaryName,\n    weaponCooldownRatio: 0,\n    hitMarkerTimer: 0,\n    killMarkerTimer: 0,\n    damageFlashTimer: 0,\n    muzzleFlashLeft: 0,\n    muzzleFlashRight: 0,\n    playerDestroyed: false,\n    combatStats: {\n      kills: 0,\n      shotsFired: 0,\n      shotsHit: 0,\n      damageDealt: 0,\n      damageTaken: 0,\n      score: 0,\n      wave: 1,\n      activeEnemies: 0,\n    },\n    enemyMarkers: createEmptyEnemyMarkers(6),\n    fps: 60,\n    frameTimeMs: 16.6,\n    drawCalls: 0,\n    triangles: 0,\n    activeProjectiles: 0,\n    activeParticles: 0,\n    activeEnemies: 0,\n    lastAssetLoadMs: 0,\n    cachedAssetCount: 0,\n  };\n}\n\n/**\n * Configurable Virtual Aiming Region (independent of physical monitor/cursor edges).\n * - Keeps the virtual aiming reticle inside a comfortable central combat envelope\n *   well clear of HUD instruments and extreme screen edges.\n * - Uses a smooth elliptical clamp so reaching or gliding along the boundary never snaps\n *   and reversing direction inward responds on the very first pixel of mouse movement.\n */\nexport interface VirtualAimConfig {\n  /** Max horizontal reticle offset from screen center (fraction of viewport width, 0..0.5) */\n  maxScreenOffsetX: number;\n  /** Max vertical reticle offset from screen center (fraction of viewport height, 0..0.5) */\n  maxScreenOffsetY: number;\n  /** Relative mouse pixels (at 1.0x sensitivity) from center to aiming boundary */\n  pixelsToBoundary: number;\n  /** Tiny center deadzone (0..1) for drift-free straight flight */\n  deadzone: number;\n  /** Steering response exponent (1.0 = linear, ~1.25 = crisp arcade precision near center) */\n  responseExponent: number;\n}\n\nexport const VIRTUAL_AIM_CONFIG: VirtualAimConfig = {\n  maxScreenOffsetX: 0.25, // Reticle stays within [25% .. 75%] of viewport width\n  maxScreenOffsetY: 0.26, // Reticle stays within [24% .. 76%] of viewport height\n  pixelsToBoundary: 210,\n  deadzone: 0.03,\n  responseExponent: 1.25,\n};\n\nconst GIMBAL_MAX_YAW_RAD = 0.24;\nconst GIMBAL_MAX_PITCH_RAD = 0.17;\n\nconst _gimbalDirLocal = new THREE.Vector3();\n\n/**\n * Arcade 6DOF space flight controller.\n * Ship coordinate system: Forward = -Z, Right = +X, Up = +Y.\n *\n * Bounded Virtual-Aim Continuous Steering:\n * - Relative Pointer Lock `movementX` / `movementY` drives a persistent virtual aiming offset\n *   `(aimCursorX, aimCursorY)` bounded smoothly inside the unit circle (`r <= 1.0`).\n * - The aiming offset NEVER auto-recenters or rolls back while flying.\n * - Holding the virtual reticle on the aiming boundary sustains full continuous 360\302\260+ yaw/pitch\n *   rotation smoothly with restored Phase 1/2 arcade responsiveness and controlled inertia.\n */\nexport class FlightController {\n  public readonly position = new THREE.Vector3(0, 12, 40);\n  public readonly quaternion = new THREE.Quaternion();\n  public readonly velocity = new THREE.Vector3(0, 0, -24);\n\n  // Smoothed angular rates (rad/s) in ship local space\n  public yawVelocity = 0;\n  public pitchVelocity = 0;\n  public rollVelocity = 0;\n\n  // Persistent virtual aim offset in normalized unit-disk steering space (hypot <= 1.0; 0,0 = center)\n  public aimCursorX = 0;\n  public aimCursorY = 0;\n\n  // Visual banking angle layered on the ship mesh for tactile feel\n  public visualBankAngle = 0;\n\n  private ship: ShipConfig;\n  private boostEnergy: number;\n  private boostCooldownTimer = 0;\n  private boostLockedOut = false;\n  private boostIntensity = 0;\n  private wasBoosting = false;\n  private hull: number;\n  private boostJustEngaged = false;\n\n  public constructor(ship: ShipConfig) {\n    this.ship = ship;\n    this.boostEnergy = ship.flight.maxBoostEnergy;\n    this.hull = ship.maxHull;\n  }\n\n  public setShipConfig(ship: ShipConfig): void {\n    this.ship = ship;\n    this.boostEnergy = Math.min(this.boostEnergy, ship.flight.maxBoostEnergy);\n    this.hull = ship.maxHull;\n  }\n\n  public centerAimCursor(): void {\n    this.aimCursorX = 0;\n    this.aimCursorY = 0;\n  }\n\n  public reset(startPosition?: THREE.Vector3): void {\n    if (startPosition) {\n      this.position.copy(startPosition);\n    } else {\n      this.position.set(0, 12, 40);\n    }\n    this.quaternion.identity();\n    this.velocity.set(0, 0, -28);\n    this.yawVelocity = 0;\n    this.pitchVelocity = 0;\n    this.rollVelocity = 0;\n    this.aimCursorX = 0;\n    this.aimCursorY = 0;\n    this.visualBankAngle = 0;\n    this.boostEnergy = this.ship.flight.maxBoostEnergy;\n    this.boostCooldownTimer = 0;\n    this.boostLockedOut = false;\n    this.boostIntensity = 0;\n    this.wasBoosting = false;\n    this.hull = this.ship.maxHull;\n  }\n\n  public getBoostJustEngaged(): boolean {\n    return this.boostJustEngaged;\n  }\n\n  /**\n   * Returns unit world-space firing direction with forward gimbal convergence\n   * toward the active bounded virtual aim offset.\n   */\n  public getAimDirectionWorld(out: THREE.Vector3): THREE.Vector3 {\n    const gimbalYaw = THREE.MathUtils.clamp(this.aimCursorX, -1, 1) * GIMBAL_MAX_YAW_RAD;\n    const gimbalPitch = THREE.MathUtils.clamp(-this.aimCursorY, -1, 1) * GIMBAL_MAX_PITCH_RAD;\n    _gimbalDirLocal.set(Math.sin(gimbalYaw), Math.sin(gimbalPitch), -1).normalize();\n    out.copy(_gimbalDirLocal).applyQuaternion(this.quaternion).normalize();\n    return out;\n  }\n\n  /**\n   * Computes the 3D world-space convergence point along the player\'s firing ray.\n   */\n  public getAimTargetPoint(out: THREE.Vector3, distance: number): THREE.Vector3 {\n    this.getAimDirectionWorld(out);\n    out.multiplyScalar(distance).add(this.position);\n    return out;\n  }\n\n  /**\n   * Advances arcade flight simulation by delta time `dt` (seconds) and writes live telemetry.\n   */\n  public update(\n    dt: number,\n    input: InputSnapshot,\n    settings: GameSettings,\n    telemetry: FlightTelemetry,\n  ): void {\n    const profile = this.ship.flight;\n    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);\n\n    // 1. Bounded Virtual-Aim Relative Mouse Steering (Zero Auto-Recenter, Smooth Elliptical Limit)\n    const cursorScale = (1 / VIRTUAL_AIM_CONFIG.pixelsToBoundary) * settings.mouseSensitivity;\n    const ySign = settings.invertY ? -1 : 1;\n\n    if (input.mouseDeltaX !== 0 || input.mouseDeltaY !== 0) {\n      let nextX = this.aimCursorX + input.mouseDeltaX * cursorScale;\n      let nextY = this.aimCursorY + input.mouseDeltaY * cursorScale * ySign;\n\n      // Smooth radial unit-circle clamp:\n      // - Reticle glides smoothly around the boundary with zero snapping.\n      // - No hidden overflow accumulates beyond r = 1.0, so pulling back responds immediately.\n      // - Relative mouse input continues flowing uninterrupted at every physical screen edge.\n      const nextMag = Math.hypot(nextX, nextY);\n      if (nextMag > 1.0) {\n        nextX /= nextMag;\n        nextY /= nextMag;\n      }\n\n      this.aimCursorX = nextX;\n      this.aimCursorY = nextY;\n    }\n\n    // Crisp arcade steering curve:\n    // - Tiny 3% deadzone keeps straight flight drift-free.\n    // - Mild 1.25 exponent gives responsive small/medium turns AND full 100% turn speed at boundary.\n    const cursorMag = Math.hypot(this.aimCursorX, this.aimCursorY);\n    let steerX = 0;\n    let steerY = 0;\n    if (cursorMag > VIRTUAL_AIM_CONFIG.deadzone) {\n      const normalized = Math.min(\n        1,\n        (cursorMag - VIRTUAL_AIM_CONFIG.deadzone) / (1 - VIRTUAL_AIM_CONFIG.deadzone),\n      );\n      const curved = Math.pow(normalized, VIRTUAL_AIM_CONFIG.responseExponent);\n      steerX = (this.aimCursorX / cursorMag) * curved;\n      steerY = (this.aimCursorY / cursorMag) * curved;\n    }\n\n    // Optional arrow-key steering blends smoothly alongside mouse steering\n    let keyYaw = 0;\n    if (input.keyYawLeft) keyYaw += 0.85;\n    if (input.keyYawRight) keyYaw -= 0.85;\n    let keyPitch = 0;\n    if (input.keyPitchUp) keyPitch += 0.85;\n    if (input.keyPitchDown) keyPitch -= 0.85;\n\n    const targetYawRate = THREE.MathUtils.clamp(-steerX + keyYaw, -1.1, 1.1) * profile.yawSpeed;\n    const targetPitchRate = THREE.MathUtils.clamp(-steerY + keyPitch, -1.1, 1.1) * profile.pitchSpeed;\n\n    // Restored snappy arcade turn response with controlled inertia (frame-rate independent)\n    const isSteering = Math.abs(targetYawRate) > 0.01 || Math.abs(targetPitchRate) > 0.01;\n    const responseLambda = profile.angularDamping * (isSteering ? 2.1 : 1.8);\n    const turnAlpha = 1 - Math.exp(-responseLambda * safeDt);\n    this.yawVelocity = THREE.MathUtils.lerp(this.yawVelocity, targetYawRate, turnAlpha);\n    this.pitchVelocity = THREE.MathUtils.lerp(this.pitchVelocity, targetPitchRate, turnAlpha);\n\n    const stepYaw = this.yawVelocity * safeDt;\n    const stepPitch = this.pitchVelocity * safeDt;"
          replacement_content: "import type {\n  FlightStatus,\n  FlightTelemetry,\n  GameSettings,\n  ShipConfig,\n  SteeringZone,\n} from \'../types/game\';\nimport type { InputSnapshot } from \'./InputManager\';\n\n// Reusable scratch objects (zero per-frame GC allocations)\nconst _AXIS_X = new THREE.Vector3(1, 0, 0);\nconst _AXIS_Y = new THREE.Vector3(0, 1, 0);\nconst _AXIS_Z = new THREE.Vector3(0, 0, 1);\nconst _FORWARD_LOCAL = new THREE.Vector3(0, 0, -1);\n\nconst _qYaw = new THREE.Quaternion();\nconst _qPitch = new THREE.Quaternion();\nconst _qRoll = new THREE.Quaternion();\nconst _forwardWorld = new THREE.Vector3();\nconst _rightWorld = new THREE.Vector3();\nconst _upWorld = new THREE.Vector3();\nconst _desiredVel = new THREE.Vector3();\nconst _euler = new THREE.Euler(0, 0, 0, \'YXZ\');\n\nfunction createEmptyEnemyMarkers(count = 6): ProjectedEnemyMarker[] {\n  const list: ProjectedEnemyMarker[] = [];\n  for (let i = 0; i < count; i++) {\n    list.push({\n      active: false,\n      entityId: \'\',\n      callsign: \'\',\n      personalityLabel: \'\',\n      aiState: \'patrol\',\n      screenX: 0.5,\n      screenY: 0.5,\n      inFront: false,\n      onScreen: false,\n      distance: 0,\n      healthRatio: 1,\n      isPrimaryTarget: false,\n      isPriorityTarget: false,\n      leadX: 0.5,\n      leadY: 0.5,\n      leadVisible: false,\n    });\n  }\n  return list;\n}\n\nexport function createInitialTelemetry(ship: ShipConfig): FlightTelemetry {\n  return {\n    speed: 0,\n    signedSpeed: 0,\n    maxSpeed: ship.flight.maxSpeed,\n    effectiveMaxSpeed: ship.flight.maxSpeed,\n    throttle: 0,\n    boostEnergy: ship.flight.maxBoostEnergy,\n    maxBoostEnergy: ship.flight.maxBoostEnergy,\n    isBoosting: false,\n    boostDepleted: false,\n    boostIntensity: 0,\n    hull: ship.maxHull,\n    maxHull: ship.maxHull,\n    yawRate: 0,\n    pitchRate: 0,\n    rollRate: 0,\n    aimNormalizedX: 0,\n    aimNormalizedY: 0,\n    aimScreenX: 0.5,\n    aimScreenY: 0.5,\n    boresightScreenX: 0.5,\n    boresightScreenY: 0.5,\n    steeringZone: \'precision\',\n    steeringSensitivityX: 1.0,\n    steeringSensitivityY: 1.0,\n    steeringAccelRatio: 0,\n    headingDeg: 0,\n    pitchDeg: 0,\n    rollDeg: 0,\n    altitude: 0,\n    status: \'STANDBY\',\n    pointerLocked: false,\n    isFiring: false,\n    weaponName: ship.weapons.primaryName,\n    weaponCooldownRatio: 0,\n    hitMarkerTimer: 0,\n    killMarkerTimer: 0,\n    damageFlashTimer: 0,\n    muzzleFlashLeft: 0,\n    muzzleFlashRight: 0,\n    playerDestroyed: false,\n    combatStats: {\n      kills: 0,\n      shotsFired: 0,\n      shotsHit: 0,\n      damageDealt: 0,\n      damageTaken: 0,\n      score: 0,\n      wave: 1,\n      activeEnemies: 0,\n    },\n    enemyMarkers: createEmptyEnemyMarkers(6),\n    fps: 60,\n    frameTimeMs: 16.6,\n    drawCalls: 0,\n    triangles: 0,\n    activeProjectiles: 0,\n    activeParticles: 0,\n    activeEnemies: 0,\n    lastAssetLoadMs: 0,\n    cachedAssetCount: 0,\n  };\n}\n\n/**\n * Progressive Three-Zone Mouse Steering Configuration.\n *\n * Independent horizontal (yaw) & vertical (pitch) displacement model:\n * - Zone 1 (Precision, |x| <= B): Normal sensitivity (1.0x) with smooth boundary approach\n *   blending over [0.80B .. 1.00B] down to `boundarySensitivity` for zero-jump C1 continuity.\n * - Zone 2 (Transition, |x| > B while sensitivity(e) < 1.0): Steering initially slows to\n *   `boundarySensitivity` then climbs smoothly via f(e) = e^p / (1 + e^p).\n * - Zone 3 (Acceleration, |x| > B while sensitivity(e) >= 1.0): Continued outward mouse motion\n *   asymptotically accelerates toward `maxSensitivity` without hitting a hard steering cutoff.\n * - Delta-time exponential recovery smoothing (tau = 0.12s) keeps transitions and return-to-precision\n *   free of sudden rotation spikes across any frame rate.\n */\nexport const PROGRESSIVE_STEERING_CONFIG = {\n  /** Virtual mouse pixels per 1.0 screen-fraction of aimBoundarySize (0.25 -> B = 200px) */\n  boundaryPixelsPerFraction: 800,\n  /** Vertical boundary pixel scale relative to horizontal boundary */\n  verticalBoundaryRatio: 0.92,\n  /** Vertical HUD visual boundary aspect multiplier relative to aimBoundarySize */\n  verticalScreenAspectRatio: 1.04,\n  /** Maximum vertical HUD boundary half-height fraction */\n  maxVerticalScreenOffset: 0.38,\n  /** Tiny center deadzone (fraction of B) for drift-free straight flight */\n  deadzone: 0.03,\n  /** Mild inner-zone shaping exponent for crisp precision near center */\n  precisionExponent: 1.15,\n  /** Fraction of B where smoothstep transition toward boundarySensitivity begins */\n  boundaryBlendStart: 0.8,\n  /** Time constant (seconds) for smooth sensitivity transitions & return to precision */\n  recoverySmoothingSec: 0.12,\n  /** Upper displacement buffer in multiples of S past B (at e=4.0, f(4)=0.941) */\n  maxExcessScales: 4.0,\n  /** Subtle visual reticle tension stretch past boundary (fraction of viewport, keeps reticle clear of HUD) */\n  overdriveReticleStretch: 0.028,\n  /** Safety angular velocity ceiling multipliers to prevent uncontrollable spin */\n  maxSafeYawMultiplier: 3.2,\n  maxSafePitchMultiplier: 3.0,\n} as const;\n\n/** Kept for compatibility with HUD & diagnostics referencing boundary bounds */\nexport const VIRTUAL_AIM_CONFIG = {\n  maxScreenOffsetX: 0.25,\n  maxScreenOffsetY: 0.26,\n  pixelsToBoundary: 200,\n  deadzone: PROGRESSIVE_STEERING_CONFIG.deadzone,\n  responseExponent: PROGRESSIVE_STEERING_CONFIG.precisionExponent,\n};\n\nexport interface AxisSteeringEvaluation {\n  targetSensitivity: number;\n  excess: number;\n  curveFactor: number;\n  zone: SteeringZone;\n}\n\n/**\n * Pure per-axis progressive steering response evaluation.\n *\n * Let x = virtual aim displacement, B = boundary, S = accelerationDistance, p = responseCurve:\n *   e = max(0, (|x| - B) / S)\n *   f(e) = e^p / (1 + e^p)\n *   sensitivity(e) = boundarySensitivity + (maxSensitivity - boundarySensitivity) * f(e)\n *\n * Inside |x| <= B: preserves 1.0x sensitivity across [0 .. 0.80B], then smoothstep-blends\n * over [0.80B .. 1.00B] down to boundarySensitivity so the derivative is 0 at |x| = B (C1 continuous).\n */\nexport function evaluateProgressiveAxisSensitivity(\n  absDisplacement: number,\n  boundary: number,\n  accelDistance: number,\n  boundarySensitivity: number,\n  maxSensitivity: number,\n  exponent: number,\n  out: AxisSteeringEvaluation = {\n    targetSensitivity: 1,\n    excess: 0,\n    curveFactor: 0,\n    zone: \'precision\',\n  },\n): AxisSteeringEvaluation {\n  const B = Math.max(20, boundary);\n  const S = Math.max(20, accelDistance);\n  const bSens = THREE.MathUtils.clamp(boundarySensitivity, 0.1, 1.5);\n  const mSens = Math.max(bSens, maxSensitivity);\n  const p = THREE.MathUtils.clamp(exponent, 0.5, 5.0);\n\n  if (absDisplacement <= B) {\n    const blendStart = B * PROGRESSIVE_STEERING_CONFIG.boundaryBlendStart;\n    if (absDisplacement <= blendStart) {\n      out.targetSensitivity = 1.0;\n    } else {\n      const t = (absDisplacement - blendStart) / (B - blendStart);\n      const smooth = t * t * (3 - 2 * t);\n      out.targetSensitivity = 1.0 + (bSens - 1.0) * smooth;\n    }\n    out.excess = 0;\n    out.curveFactor = 0;\n    out.zone = \'precision\';\n    return out;\n  }\n\n  const e = (absDisplacement - B) / S;\n  const ep = Math.pow(e, p);\n  const f = ep / (1 + ep);\n  const targetSens = bSens + (mSens - bSens) * f;\n\n  out.targetSensitivity = targetSens;\n  out.excess = e;\n  out.curveFactor = f;\n  out.zone = targetSens < 1.0 ? \'transition\' : \'acceleration\';\n  return out;\n}\n\nconst GIMBAL_MAX_YAW_RAD = 0.24;\nconst GIMBAL_MAX_PITCH_RAD = 0.17;\n\nconst _gimbalDirLocal = new THREE.Vector3();\nconst _evalX: AxisSteeringEvaluation = {\n  targetSensitivity: 1,\n  excess: 0,\n  curveFactor: 0,\n  zone: \'precision\',\n};\nconst _evalY: AxisSteeringEvaluation = {\n  targetSensitivity: 1,\n  excess: 0,\n  curveFactor: 0,\n  zone: \'precision\',\n};\n\n/**\n * Arcade 6DOF space flight controller.\n * Ship coordinate system: Forward = -Z, Right = +X, Up = +Y.\n *\n * Progressive Three-Zone Virtual-Aim Steering:\n * - Relative Pointer Lock `movementX` / `movementY` independently accumulates per-axis virtual\n *   aim displacement (`virtualAimX`, `virtualAimY`).\n * - Never auto-recenters or rolls back while flying; works continuously at physical screen edges.\n * - Precision Zone (|x| <= B), Transition Zone (slower initial boundary crossing), and\n *   Acceleration Zone (smooth asymptotic turn speedup) with 0.12s delta-time recovery smoothing.\n */\nexport class FlightController {\n  public readonly position = new THREE.Vector3(0, 12, 40);\n  public readonly quaternion = new THREE.Quaternion();\n  public readonly velocity = new THREE.Vector3(0, 0, -24);\n\n  // Smoothed angular rates (rad/s) in ship local space\n  public yawVelocity = 0;\n  public pitchVelocity = 0;\n  public rollVelocity = 0;\n\n  // Accumulated independent relative virtual aim displacement per axis (virtual pixels)\n  public virtualAimX = 0;\n  public virtualAimY = 0;\n\n  // Normalized clamped aim coordinates [-1..1] inside precision boundary (for HUD & weapon gimbal)\n  public aimCursorX = 0;\n  public aimCursorY = 0;\n\n  // Delta-time smoothed effective sensitivity multipliers per axis (recovery smoothing ~0.12s)\n  public smoothedSensX = 1.0;\n  public smoothedSensY = 1.0;\n\n  // Visual banking angle layered on the ship mesh for tactile feel\n  public visualBankAngle = 0;\n\n  private ship: ShipConfig;\n  private boostEnergy: number;\n  private boostCooldownTimer = 0;\n  private boostLockedOut = false;\n  private boostIntensity = 0;\n  private wasBoosting = false;\n  private hull: number;\n  private boostJustEngaged = false;\n\n  public constructor(ship: ShipConfig) {\n    this.ship = ship;\n    this.boostEnergy = ship.flight.maxBoostEnergy;\n    this.hull = ship.maxHull;\n  }\n\n  public setShipConfig(ship: ShipConfig): void {\n    this.ship = ship;\n    this.boostEnergy = Math.min(this.boostEnergy, ship.flight.maxBoostEnergy);\n    this.hull = ship.maxHull;\n  }\n\n  public centerAimCursor(): void {\n    this.virtualAimX = 0;\n    this.virtualAimY = 0;\n    this.aimCursorX = 0;\n    this.aimCursorY = 0;\n    this.smoothedSensX = 1.0;\n    this.smoothedSensY = 1.0;\n  }\n\n  public reset(startPosition?: THREE.Vector3): void {\n    if (startPosition) {\n      this.position.copy(startPosition);\n    } else {\n      this.position.set(0, 12, 40);\n    }\n    this.quaternion.identity();\n    this.velocity.set(0, 0, -28);\n    this.yawVelocity = 0;\n    this.pitchVelocity = 0;\n    this.rollVelocity = 0;\n    this.virtualAimX = 0;\n    this.virtualAimY = 0;\n    this.aimCursorX = 0;\n    this.aimCursorY = 0;\n    this.smoothedSensX = 1.0;\n    this.smoothedSensY = 1.0;\n    this.visualBankAngle = 0;\n    this.boostEnergy = this.ship.flight.maxBoostEnergy;\n    this.boostCooldownTimer = 0;\n    this.boostLockedOut = false;\n    this.boostIntensity = 0;\n    this.wasBoosting = false;\n    this.hull = this.ship.maxHull;\n  }\n\n  public getBoostJustEngaged(): boolean {\n    return this.boostJustEngaged;\n  }\n\n  /**\n   * Returns unit world-space firing direction with forward gimbal convergence\n   * toward the active bounded virtual aim offset.\n   */\n  public getAimDirectionWorld(out: THREE.Vector3): THREE.Vector3 {\n    const gimbalYaw = THREE.MathUtils.clamp(this.aimCursorX, -1, 1) * GIMBAL_MAX_YAW_RAD;\n    const gimbalPitch = THREE.MathUtils.clamp(-this.aimCursorY, -1, 1) * GIMBAL_MAX_PITCH_RAD;\n    _gimbalDirLocal.set(Math.sin(gimbalYaw), Math.sin(gimbalPitch), -1).normalize();\n    out.copy(_gimbalDirLocal).applyQuaternion(this.quaternion).normalize();\n    return out;\n  }\n\n  /**\n   * Computes the 3D world-space convergence point along the player\'s firing ray.\n   */\n  public getAimTargetPoint(out: THREE.Vector3, distance: number): THREE.Vector3 {\n    this.getAimDirectionWorld(out);\n    out.multiplyScalar(distance).add(this.position);\n    return out;\n  }\n\n  /**\n   * Advances arcade flight simulation by delta time `dt` (seconds) and writes live telemetry.\n   */\n  public update(\n    dt: number,\n    input: InputSnapshot,\n    settings: GameSettings,\n    telemetry: FlightTelemetry,\n  ): void {\n    const profile = this.ship.flight;\n    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);\n\n    // 1. Progressive Three-Zone Relative Mouse Steering (Independent X & Y Axes, Zero Auto-Recenter)\n    const boundarySize = THREE.MathUtils.clamp(settings.aimBoundarySize, 0.15, 0.38);\n    const boundaryX = boundarySize * PROGRESSIVE_STEERING_CONFIG.boundaryPixelsPerFraction;\n    const boundaryY = boundaryX * PROGRESSIVE_STEERING_CONFIG.verticalBoundaryRatio;\n    const accelDist = THREE.MathUtils.clamp(settings.accelerationDistance, 80, 500);\n    const baseSens = THREE.MathUtils.clamp(settings.mouseSensitivity, 0.3, 2.5);\n    const boundarySens = THREE.MathUtils.clamp(settings.boundarySensitivity, 0.15, 1.0);\n    const maxSens = Math.max(boundarySens + 0.1, THREE.MathUtils.clamp(settings.maxSensitivity, 1.2, 3.5));\n    const curveExp = THREE.MathUtils.clamp(settings.responseCurve, 1.0, 3.5);\n    const ySign = settings.invertY ? -1 : 1;\n\n    const maxDispX = boundaryX + accelDist * PROGRESSIVE_STEERING_CONFIG.maxExcessScales;\n    const maxDispY = boundaryY + accelDist * PROGRESSIVE_STEERING_CONFIG.maxExcessScales;\n\n    if (input.mouseDeltaX !== 0) {\n      this.virtualAimX = THREE.MathUtils.clamp(\n        this.virtualAimX + input.mouseDeltaX * baseSens,\n        -maxDispX,\n        maxDispX,\n      );\n    }\n    if (input.mouseDeltaY !== 0) {\n      this.virtualAimY = THREE.MathUtils.clamp(\n        this.virtualAimY + input.mouseDeltaY * baseSens * ySign,\n        -maxDispY,\n        maxDispY,\n      );\n    }\n\n    // Evaluate progressive response independently for horizontal (yaw) and vertical (pitch)\n    evaluateProgressiveAxisSensitivity(\n      Math.abs(this.virtualAimX),\n      boundaryX,\n      accelDist,\n      boundarySens,\n      maxSens,\n      curveExp,\n      _evalX,\n    );\n    evaluateProgressiveAxisSensitivity(\n      Math.abs(this.virtualAimY),\n      boundaryY,\n      accelDist,\n      boundarySens,\n      maxSens,\n      curveExp,\n      _evalY,\n    );\n\n    // Frame-rate independent recovery smoothing (~0.12s) eliminates sudden sensitivity jumps\n    const recoveryAlpha =\n      1 - Math.exp(-safeDt / PROGRESSIVE_STEERING_CONFIG.recoverySmoothingSec);\n    this.smoothedSensX = THREE.MathUtils.lerp(\n      this.smoothedSensX,\n      _evalX.targetSensitivity,\n      recoveryAlpha,\n    );\n    this.smoothedSensY = THREE.MathUtils.lerp(\n      this.smoothedSensY,\n      _evalY.targetSensitivity,\n      recoveryAlpha,\n    );\n\n    // Compute per-axis normalized precision deflection [-1..1] + progressive sensitivity multiplier\n    const deadzone = PROGRESSIVE_STEERING_CONFIG.deadzone;\n    const precExp = PROGRESSIVE_STEERING_CONFIG.precisionExponent;\n\n    const normX = THREE.MathUtils.clamp(this.virtualAimX / boundaryX, -1, 1);\n    const normY = THREE.MathUtils.clamp(this.virtualAimY / boundaryY, -1, 1);\n    this.aimCursorX = normX;\n    this.aimCursorY = normY;\n\n    let steerX = 0;\n    const absNormX = Math.abs(normX);\n    if (absNormX > deadzone) {\n      const uX = (absNormX - deadzone) / (1 - deadzone);\n      const baseSteerX = Math.sign(normX) * Math.pow(uX, precExp);\n      steerX = baseSteerX * this.smoothedSensX;\n    }\n\n    let steerY = 0;\n    const absNormY = Math.abs(normY);\n    if (absNormY > deadzone) {\n      const uY = (absNormY - deadzone) / (1 - deadzone);\n      const baseSteerY = Math.sign(normY) * Math.pow(uY, precExp);\n      steerY = baseSteerY * this.smoothedSensY;\n    }\n\n    // Optional arrow-key steering blends smoothly alongside mouse steering\n    let keyYaw = 0;\n    if (input.keyYawLeft) keyYaw += 0.85;\n    if (input.keyYawRight) keyYaw -= 0.85;\n    let keyPitch = 0;\n    if (input.keyPitchUp) keyPitch += 0.85;\n    if (input.keyPitchDown) keyPitch -= 0.85;\n\n    const targetYawRate =\n      THREE.MathUtils.clamp(\n        -steerX + keyYaw,\n        -PROGRESSIVE_STEERING_CONFIG.maxSafeYawMultiplier,\n        PROGRESSIVE_STEERING_CONFIG.maxSafeYawMultiplier,\n      ) * profile.yawSpeed;\n    const targetPitchRate =\n      THREE.MathUtils.clamp(\n        -steerY + keyPitch,\n        -PROGRESSIVE_STEERING_CONFIG.maxSafePitchMultiplier,\n        PROGRESSIVE_STEERING_CONFIG.maxSafePitchMultiplier,\n      ) * profile.pitchSpeed;\n\n    // Restored Phase 1/2 snappy arcade turn response with controlled inertia (frame-rate independent)\n    const isSteering = Math.abs(targetYawRate) > 0.01 || Math.abs(targetPitchRate) > 0.01;\n    const responseLambda = profile.angularDamping * (isSteering ? 2.1 : 1.8);\n    const turnAlpha = 1 - Math.exp(-responseLambda * safeDt);\n    this.yawVelocity = THREE.MathUtils.lerp(this.yawVelocity, targetYawRate, turnAlpha);\n    this.pitchVelocity = THREE.MathUtils.lerp(this.pitchVelocity, targetPitchRate, turnAlpha);\n\n    const stepYaw = this.yawVelocity * safeDt;\n    const stepPitch = this.pitchVelocity * safeDt;"
