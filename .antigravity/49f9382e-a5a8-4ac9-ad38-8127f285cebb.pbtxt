            lines {
              text: "  public updateChase("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    dt: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    flight: FlightController,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    camera: THREE.PerspectiveCamera,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    settings: GameSettings,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    boostIntensity: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    elapsedTime: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ): void {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (!this.initialized) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.snapToShip(flight, camera, settings.cameraDistance);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    _forward.set(0, 0, -1).applyQuaternion(flight.quaternion).normalize();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    _up.set(0, 1, 0).applyQuaternion(flight.quaternion).normalize();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    _right.set(1, 0, 0).applyQuaternion(flight.quaternion).normalize();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Subtle lateral & vertical turn lag so aggressive maneuvers feel dynamic"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Clamped strictly so the ship never leaves the center framing."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const camSens = settings.cameraSensitivity;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const lagX = THREE.MathUtils.clamp(-flight.yawVelocity * 0.72 * camSens, -1.6, 1.6);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const lagY = THREE.MathUtils.clamp(flight.pitchVelocity * 0.55 * camSens, -1.1, 1.1);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Pull back slightly on boost to emphasize acceleration"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const dynamicDist = settings.cameraDistance + boostIntensity * 1.45;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const heightOffset = 2.25 - boostIntensity * 0.25;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    _offsetLocal.set(lagX, heightOffset + lagY, dynamicDist).applyQuaternion(flight.quaternion);"
