    tool_calls {
      id: "call_15604263696875506007"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import type {\\n  EffectQuality,\\n  GameSettings,\\n  GraphicsQuality,\\n  ShadowQuality,\\n} from \'../types/game\';\\n\\nexport interface GraphicsPreset {\\n  quality: GraphicsQuality;\\n  dprCap: number;\\n  resolutionScale: number;\\n  antialias: boolean;\\n  shadows: boolean;\\n  shadowQuality: ShadowQuality;\\n  shadowMapSize: number;\\n  particleQuality: EffectQuality;\\n  maxSparkParticles: number;\\n  maxShockwaves: number;\\n  sparkScaleFactor: number;\\n  environmentDetail: EffectQuality;\\n  starCount: number;\\n  asteroidCount: number;\\n  speedLineCount: number;\\n  planetSegments: number;\\n  nebulaOctaves: number;\\n  textureResolution: 256 | 512 | 1024;\\n  drawDistance: number;\\n  postGlowEnabled: boolean;\\n  enemyLightLodDistance: number;\\n}\\n\\nexport const GRAPHICS_PRESETS: Record<GraphicsQuality, GraphicsPreset> = {\\n  low: {\\n    quality: \'low\',\\n    dprCap: 1.0,\\n    resolutionScale: 0.75,\\n    antialias: false,\\n    shadows: false,\\n    shadowQuality: \'off\',\\n    shadowMapSize: 512,\\n    particleQuality: \'low\',\\n    maxSparkParticles: 90,\\n    maxShockwaves: 6,\\n    sparkScaleFactor: 0.45,\\n    environmentDetail: \'low\',\\n    starCount: 1500,\\n    asteroidCount: 70,\\n    speedLineCount: 110,\\n    planetSegments: 28,\\n    nebulaOctaves: 2,\\n    textureResolution: 256,\\n    drawDistance: 2400,\\n    postGlowEnabled: false,\\n    enemyLightLodDistance: 120,\\n  },\\n  medium: {\\n    quality: \'medium\',\\n    dprCap: 1.35,\\n    resolutionScale: 0.9,\\n    antialias: true,\\n    shadows: true,\\n    shadowQuality: \'low\',\\n    shadowMapSize: 512,\\n    particleQuality: \'medium\',\\n    maxSparkParticles: 160,\\n    maxShockwaves: 10,\\n    sparkScaleFactor: 0.75,\\n    environmentDetail: \'medium\',\\n    starCount: 2600,\\n    asteroidCount: 135,\\n    speedLineCount: 190,\\n    planetSegments: 42,\\n    nebulaOctaves: 3,\\n    textureResolution: 512,\\n    drawDistance: 3200,\\n    postGlowEnabled: true,\\n    enemyLightLodDistance: 220,\\n  },\\n  high: {\\n    quality: \'high\',\\n    dprCap: 1.75,\\n    resolutionScale: 1.0,\\n    antialias: true,\\n    shadows: true,\\n    shadowQuality: \'medium\',\\n    shadowMapSize: 1024,\\n    particleQuality: \'high\',\\n    maxSparkParticles: 240,\\n    maxShockwaves: 14,\\n    sparkScaleFactor: 1.0,\\n    environmentDetail: \'high\',\\n    starCount: 4000,\\n    asteroidCount: 200,\\n    speedLineCount: 260,\\n    planetSegments: 56,\\n    nebulaOctaves: 4,\\n    textureResolution: 512,\\n    drawDistance: 4200,\\n    postGlowEnabled: true,\\n    enemyLightLodDistance: 300,\\n  },\\n  ultra: {\\n    quality: \'ultra\',\\n    dprCap: 2.0,\\n    resolutionScale: 1.0,\\n    antialias: true,\\n    shadows: true,\\n    shadowQuality: \'high\',\\n    shadowMapSize: 2048,\\n    particleQuality: \'high\',\\n    maxSparkParticles: 320,\\n    maxShockwaves: 16,\\n    sparkScaleFactor: 1.25,\\n    environmentDetail: \'high\',\\n    starCount: 5400,\\n    asteroidCount: 270,\\n    speedLineCount: 340,\\n    planetSegments: 72,\\n    nebulaOctaves: 5,\\n    textureResolution: 1024,\\n    drawDistance: 5200,\\n    postGlowEnabled: true,\\n    enemyLightLodDistance: 380,\\n  },\\n};\\n\\nexport function getGraphicsPresetPatch(quality: GraphicsQuality): Partial<GameSettings> {\\n  const p = GRAPHICS_PRESETS[quality] ?? GRAPHICS_PRESETS.high;\\n  return {\\n    graphicsQuality: quality,\\n    resolutionScale: p.resolutionScale,\\n    shadowQuality: p.shadowQuality,\\n    particleQuality: p.particleQuality,\\n    environmentDetail: p.environmentDetail,\\n    drawDistance: p.drawDistance,\\n    antialias: p.antialias,\\n    postGlowEnabled: p.postGlowEnabled,\\n  };\\n}\\n\\nlet cachedSoftwareGl: boolean | null = null;\\n\\n/**\\n * Detects software WebGL renderers (SwiftShader, llvmpipe, WARP) from the GPU renderer string.\\n * Scales pixel cost conservatively without altering scene identity or gameplay.\\n */\\nexport function isSoftwareWebGL(): boolean {\\n  if (cachedSoftwareGl !== null) return cachedSoftwareGl;\\n  if (typeof document === \'undefined\') {\\n    cachedSoftwareGl = false;\\n    return false;\\n  }\\n  try {\\n    const canvas = document.createElement(\'canvas\');\\n    const gl = canvas.getContext(\'webgl2\') || canvas.getContext(\'webgl\');\\n    if (!gl) {\\n      cachedSoftwareGl = true;\\n      return true;\\n    }\\n    const ext = gl.getExtension(\'WEBGL_debug_renderer_info\');\\n    const param = ext ? ext.UNMASKED_RENDERER_WEBGL : gl.RENDERER;\\n    const gpu = String(gl.getParameter(param) ?? \'\');\\n    gl.getExtension(\'WEBGL_lose_context\')?.loseContext();\\n    cachedSoftwareGl = /SwiftShader|llvmpipe|softpipe|Software|Basic Render/i.test(gpu);\\n    return cachedSoftwareGl;\\n  } catch {\\n    cachedSoftwareGl = false;\\n    return false;\\n  }\\n}\\n\\nconst SHADOW_MAP_BY_QUALITY: Record<ShadowQuality, number> = {\\n  off: 512,\\n  low: 512,\\n  medium: 1024,\\n  high: 2048,\\n};\\n\\n/**\\n * Combines the selected preset with granular user settings into an authoritative\\n * runtime rendering configuration actually consumed by Canvas, SpaceEnvironment,\\n * CombatVFX, EnemyShipRenderer, and AssetManager.\\n */\\nexport function resolveEffectiveGraphics(\\n  input: GraphicsQuality | GameSettings,\\n): GraphicsPreset {\\n  const isPresetOnly = typeof input === \'string\';\\n  const quality: GraphicsQuality = isPresetOnly ? input : input.graphicsQuality;\\n  const base = GRAPHICS_PRESETS[quality] ?? GRAPHICS_PRESETS.high;\\n\\n  if (isPresetOnly) {\\n    if (!isSoftwareWebGL()) return base;\\n    return {\\n      ...base,\\n      dprCap: 1.0,\\n      antialias: false,\\n      shadows: false,\\n      shadowQuality: \'off\',\\n    };\\n  }\\n\\n  const resScale = Math.max(0.65, Math.min(1.0, input.resolutionScale ?? base.resolutionScale));\\n  const shadowQuality = input.shadowQuality ?? base.shadowQuality;\\n  const particleQuality = input.particleQuality ?? base.particleQuality;\\n  const envDetail = input.environmentDetail ?? base.environmentDetail;\\n  const drawDistance = Math.max(2000, Math.min(5200, input.drawDistance ?? base.drawDistance));\\n\\n  const envStarCount =\\n    envDetail === \'low\' ? 1500 : envDetail === \'medium\' ? 2800 : quality === \'ultra\' ? 5400 : 4000;\\n  const envAsteroidCount =\\n    envDetail === \'low\' ? 70 : envDetail === \'medium\' ? 140 : quality === \'ultra\' ? 270 : 200;\\n  const envPlanetSegments =\\n    envDetail === \'low\' ? 28 : envDetail === \'medium\' ? 44 : quality === \'ultra\' ? 72 : 56;\\n  const envNebulaOctaves =\\n    envDetail === \'low\' ? 2 : envDetail === \'medium\' ? 3 : quality === \'ultra\' ? 5 : 4;\\n  const envTexRes: 256 | 512 | 1024 =\\n    envDetail === \'low\' ? 256 : quality === \'ultra\' ? 1024 : 512;\\n\\n  const maxSparkParticles =\\n    particleQuality === \'low\' ? 90 : particleQuality === \'medium\' ? 160 : quality === \'ultra\' ? 320 : 240;\\n  const maxShockwaves =\\n    particleQuality === \'low\' ? 6 : particleQuality === \'medium\' ? 10 : 16;\\n  const sparkScaleFactor =\\n    particleQuality === \'low\' ? 0.45 : particleQuality === \'medium\' ? 0.75 : quality === \'ultra\' ? 1.25 : 1.0;\\n  const speedLineCount =\\n    particleQuality === \'low\' ? 110 : particleQuality === \'medium\' ? 190 : quality === \'ultra\' ? 340 : 260;\\n\\n  const deviceRatio = typeof window !== \'undefined\' ? window.devicePixelRatio || 1 : 1;\\n  const computedDpr = Math.max(0.65, Math.min(base.dprCap, deviceRatio) * resScale);\\n  const software = isSoftwareWebGL();\\n\\n  return {\\n    ...base,\\n    dprCap: software ? Math.min(1.0, computedDpr) : computedDpr,\\n    resolutionScale: resScale,\\n    antialias: software ? false : Boolean(input.antialias),\\n    shadows: software ? false : shadowQuality !== \'off\',\\n    shadowQuality: software ? \'off\' : shadowQuality,\\n    shadowMapSize: SHADOW_MAP_BY_QUALITY[shadowQuality],\\n    particleQuality,\\n    maxSparkParticles,\\n    maxShockwaves,\\n    sparkScaleFactor,\\n    environmentDetail: envDetail,\\n    starCount: envStarCount,\\n    asteroidCount: envAsteroidCount,\\n    speedLineCount,\\n    planetSegments: envPlanetSegments,\\n    nebulaOctaves: envNebulaOctaves,\\n    textureResolution: envTexRes,\\n    drawDistance,\\n    postGlowEnabled: Boolean(input.postGlowEnabled),\\n    enemyLightLodDistance:\\n      envDetail === \'low\' ? 120 : envDetail === \'medium\' ? 220 : quality === \'ultra\' ? 380 : 300,\\n  };\\n}\\n\", \"Description\":\"Upgrade graphics configuration to support Low, Medium, High, and Ultra presets plus granular resolution, shadow, particle, environment, draw-distance, antialias, and glow controls\", \"Overwrite\":true, \"TargetFile\":\"/src/config/graphics.ts\", \"toolAction\":\"Updating graphics presets config\", \"toolSummary\":\"Update graphics presets config\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_15604263696875504942"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add granular graphics defaults and safe sanitization in ships config settings loader\", \"EndLine\":188, \"Instruction\":\"Update DEFAULT_SETTINGS and loadSavedSettings to include all Phase 3 graphics settings\", \"ReplacementContent\":\"export const DEFAULT_SETTINGS: GameSettings = {\\n  mouseSensitivity: 1.0,\\n  invertY: false,\\n  cameraDistance: 9.8,\\n  cameraSensitivity: 1.0,\\n  masterVolume: 0.65,\\n  graphicsQuality: \'high\',\\n  resolutionScale: 1.0,\\n  shadowQuality: \'medium\',\\n  particleQuality: \'high\',\\n  environmentDetail: \'high\',\\n  drawDistance: 4200,\\n  antialias: true,\\n  postGlowEnabled: true,\\n  showPerfOverlay: false,\\n};\\n\\nconst SETTINGS_STORAGE_KEY = \'starfall.settings.v2\';\\nconst LEGACY_SETTINGS_KEY = \'starfall.settings.v1\';\\n\\nexport function loadSavedSettings(): GameSettings {\\n  try {\\n    const raw =\\n      window.localStorage.getItem(SETTINGS_STORAGE_KEY) ??\\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY);\\n    if (!raw) return { ...DEFAULT_SETTINGS };\\n    const parsed = JSON.parse(raw) as Partial<GameSettings>;\\n    const validQuality =\\n      parsed.graphicsQuality === \'low\' ||\\n      parsed.graphicsQuality === \'medium\' ||\\n      parsed.graphicsQuality === \'high\' ||\\n      parsed.graphicsQuality === \'ultra\'\\n        ? parsed.graphicsQuality\\n        : DEFAULT_SETTINGS.graphicsQuality;\\n\\n    return {\\n      ...DEFAULT_SETTINGS,\\n      ...parsed,\\n      graphicsQuality: validQuality,\\n      resolutionScale:\\n        typeof parsed.resolutionScale === \'number\' && Number.isFinite(parsed.resolutionScale)\\n          ? Math.max(0.65, Math.min(1.0, parsed.resolutionScale))\\n          : DEFAULT_SETTINGS.resolutionScale,\\n      drawDistance:\\n        typeof parsed.drawDistance === \'number\' && Number.isFinite(parsed.drawDistance)\\n          ? Math.max(2000, Math.min(5200, parsed.drawDistance))\\n          : DEFAULT_SETTINGS.drawDistance,\\n      showPerfOverlay: import.meta.env.DEV ? Boolean(parsed.showPerfOverlay) : false,\\n    };\\n  } catch {\\n    return { ...DEFAULT_SETTINGS };\\n  }\\n}\\n\\nexport function saveSettings(settings: GameSettings): void {\\n  try {\\n    window.localStorage.setItem(SETTINGS_STORAGE_KEY, JSON.stringify(settings));\\n  } catch {\\n    // Ignore storage quota / privacy mode errors\\n  }\\n}\", \"StartLine\":155, \"TargetContent\":\"export const DEFAULT_SETTINGS: GameSettings = {\\n  mouseSensitivity: 1.0,\\n  invertY: false,\\n  cameraDistance: 9.8,\\n  cameraSensitivity: 1.0,\\n  masterVolume: 0.65,\\n  graphicsQuality: \'high\',\\n  showPerfOverlay: false,\\n};\\n\\nconst SETTINGS_STORAGE_KEY = \'starfall.settings.v1\';\\n\\nexport function loadSavedSettings(): GameSettings {\\n  try {\\n    const raw = window.localStorage.getItem(SETTINGS_STORAGE_KEY);\\n    if (!raw) return { ...DEFAULT_SETTINGS };\\n    const parsed = JSON.parse(raw) as Partial<GameSettings>;\\n    return {\\n      ...DEFAULT_SETTINGS,\\n      ...parsed,\\n    };\\n  } catch {\\n    return { ...DEFAULT_SETTINGS };\\n  }\\n}\\n\\nexport function saveSettings(settings: GameSettings): void {\\n  try {\\n    window.localStorage.setItem(SETTINGS_STORAGE_KEY, JSON.stringify(settings));\\n  } catch {\\n    // Ignore storage quota / privacy mode errors\\n  }\\n}\", \"TargetFile\":\"/src/config/ships.ts\", \"toolAction\":\"Updating settings defaults in ships config\", \"toolSummary\":\"Update settings defaults in ships config\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_15604263696875503877"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Connect bot difficulty tuning directly to the five structured campaign DifficultyProfiles\", \"EndLine\":116, \"Instruction\":\"Import DIFFICULTY_PROFILES and resolve scaled AI tuning cleanly across Rookie, Normal, Veteran, Expert, and Elite profiles\", \"ReplacementContent\":\"import { DIFFICULTY_PROFILES } from \'./difficulty\';\\nimport type { DifficultyLevel } from \'../types/mission\';\\n\\nexport interface ScaledBotTuning {\\n  cruiseSpeed: number;\\n  boostSpeed: number;\\n  turnRate: number;\\n  aimSpreadRad: number;\\n  fireCadenceScale: number;\\n  reactionTime: number;\\n  evadeResponsiveness: number;\\n  coordinationIntervalSec: number;\\n  burstPressureScale: number;\\n}\\n\\nconst NUMERIC_TO_LEVEL: Record<number, DifficultyLevel> = {\\n  1: \'rookie\',\\n  2: \'normal\',\\n  3: \'veteran\',\\n  4: \'expert\',\\n  5: \'elite\',\\n};\\n\\n/**\\n * Scales bot tactical performance cleanly using the structured campaign DifficultyProfile\\n * (reaction speed, aiming accuracy, agility, speed, firing cadence, evasion, and squad coordination)\\n * without giving enemies unfair bullet-sponge health or arbitrary damage inflation.\\n */\\nexport function resolveBotDifficultyTuning(\\n  personality: BotPersonalityConfig,\\n  difficulty: number | DifficultyLevel,\\n): ScaledBotTuning {\\n  const level: DifficultyLevel =\\n    typeof difficulty === \'string\'\\n      ? difficulty\\n      : NUMERIC_TO_LEVEL[Math.max(1, Math.min(5, Math.round(difficulty)))] ?? \'normal\';\\n  const profile = DIFFICULTY_PROFILES[level];\\n\\n  return {\\n    cruiseSpeed: personality.cruiseSpeed * profile.speedScale,\\n    boostSpeed: personality.boostSpeed * profile.speedScale,\\n    turnRate: personality.turnRate * profile.agilityScale,\\n    aimSpreadRad: Math.max(0.014, personality.aimSpreadRad * profile.aimSpreadScale),\\n    fireCadenceScale: personality.fireCadenceScale * profile.fireCadenceScale,\\n    reactionTime: Math.max(0.11, personality.reactionTime * profile.reactionTimeScale),\\n    evadeResponsiveness: Math.min(0.96, personality.evadeResponsiveness * profile.evadeScale),\\n    coordinationIntervalSec: profile.coordinationIntervalSec,\\n    burstPressureScale: profile.burstPressureScale,\\n  };\\n}\", \"StartLine\":87, \"TargetContent\":\"export interface ScaledBotTuning {\\n  cruiseSpeed: number;\\n  boostSpeed: number;\\n  turnRate: number;\\n  aimSpreadRad: number;\\n  fireCadenceScale: number;\\n  reactionTime: number;\\n  evadeResponsiveness: number;\\n}\\n\\n/**\\n * Scales bot tactical performance cleanly by difficulty (1..5)\\n * without giving enemies unfair bullet-sponge health or arbitrary damage multipliers.\\n */\\nexport function resolveBotDifficultyTuning(\\n  personality: BotPersonalityConfig,\\n  difficulty: number,\\n): ScaledBotTuning {\\n  const d = Math.max(1, Math.min(5, difficulty)) - 1; // 0..4\\n  return {\\n    cruiseSpeed: personality.cruiseSpeed * (1 + d * 0.05),\\n    boostSpeed: personality.boostSpeed * (1 + d * 0.05),\\n    turnRate: personality.turnRate * (1 + d * 0.07),\\n    aimSpreadRad: personality.aimSpreadRad * Math.max(0.45, 1 - d * 0.13),\\n    fireCadenceScale: personality.fireCadenceScale * (1 + d * 0.08),\\n    reactionTime: Math.max(0.12, personality.reactionTime * (1 - d * 0.14)),\\n    evadeResponsiveness: Math.min(0.96, personality.evadeResponsiveness + d * 0.07),\\n  };\\n}\", \"TargetFile\":\"/src/config/botPersonalities.ts\", \"toolAction\":\"Updating bot difficulty scaling\", \"toolSummary\":\"Update bot difficulty scaling\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_15604263696875506908"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Use DifficultyProfile tuning, squad coordination interval, and burst pressure in EnemyAIController\", \"EndLine\":165, \"Instruction\":\"Resolve difficultyLevel in triggerDamageReaction and updateEnemy, and drive flank coordination timer from DifficultyProfile\", \"ReplacementContent\":\"    const personality = BOT_PERSONALITIES[enemy.personality];\\n    const tuning = resolveBotDifficultyTuning(\\n      personality,\\n      enemy.difficultyLevel ?? enemy.difficulty,\\n    );\\n\\n    // Already evading or repositioning \342\200\224 only flip flank sign occasionally\\n    if (enemy.aiState === \'evade\') return;\\n\\n    // Deterministic-feeling probabilistic jink based on personality responsiveness\\n    const roll = Math.abs(Math.sin(now * 37.3 + enemy.position.x * 0.13));\\n    if (roll <= tuning.evadeResponsiveness) {\\n      enemy.aiState = \'evade\';\\n      enemy.aiStateTimer = personality.evadeDuration;\\n      enemy.flankSign = enemy.flankSign === 1 ? -1 : 1;\\n\\n      // Compute perpendicular jink vector away from player\'s line of fire\\n      _toPlayer.subVectors(playerPos, enemy.position).normalize();\\n      _perp.crossVectors(_toPlayer, _up);\\n      if (_perp.lengthSq() < 0.01) {\\n        _perp.set(1, 0, 0);\\n      } else {\\n        _perp.normalize();\\n      }\\n      const verticalLift = (roll - 0.35) * 0.75;\\n      enemy.evadeDir\\n        .copy(_perp)\\n        .multiplyScalar(enemy.flankSign)\\n        .addScaledVector(_up, verticalLift)\\n        .addScaledVector(_toPlayer, -0.35)\\n        .normalize();\\n    } else if (enemy.aiState === \'patrol\') {\\n      // Immediately alert if attacked while patrolling\\n      enemy.aiState = \'acquire\';\\n      enemy.aiStateTimer = tuning.reactionTime;\\n    }\\n  }\\n\\n  public updateEnemy(\\n    enemy: EnemyEntity,\\n    dt: number,\\n    now: number,\\n    playerPos: THREE.Vector3,\\n    playerVel: THREE.Vector3,\\n    playerAlive: boolean,\\n    projectiles: ProjectilePool,\\n    allEnemies: EnemyEntity[],\\n  ): EnemyAIUpdateResult {\\n    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);\\n    const out: EnemyAIUpdateResult = { fired: false, fireOrigin: _resultOrigin };\\n\\n    if (!enemy.active || enemy.health.isDestroyed) {\\n      enemy.aiState = \'destroyed\';\\n      return out;\\n    }\\n\\n    if (enemy.hitFlashTimer > 0) {\\n      enemy.hitFlashTimer = Math.max(0, enemy.hitFlashTimer - safeDt);\\n    }\\n    if (enemy.muzzleFlashTimer > 0) {\\n      enemy.muzzleFlashTimer = Math.max(0, enemy.muzzleFlashTimer - safeDt);\\n    }\\n    if (enemy.weaponCooldown > 0) {\\n      enemy.weaponCooldown = Math.max(0, enemy.weaponCooldown - safeDt);\\n    }\\n\\n    const personality = BOT_PERSONALITIES[enemy.personality];\\n    const tuning = resolveBotDifficultyTuning(\\n      personality,\\n      enemy.difficultyLevel ?? enemy.difficulty,\\n    );\\n    const weapon = WEAPON_CONFIGS[personality.weaponId] ?? WEAPON_CONFIGS.enemy_pulse_aggressor;\\n\\n    _toPlayer.subVectors(playerPos, enemy.position);\\n    const distToPlayer = _toPlayer.length();\\n    const dirToPlayer = distToPlayer > 0.001 ? _toPlayer.divideScalar(distToPlayer) : _forward.set(0, 0, -1);\\n\\n    enemy.aiStateTimer = Math.max(0, enemy.aiStateTimer - safeDt);\\n    enemy.coordinationTimer = Math.max(0, enemy.coordinationTimer - safeDt);\\n\\n    // Coordinated squad flank-vector shift governed by DifficultyProfile\\n    if (enemy.coordinationTimer <= 0 && (enemy.aiState === \'pursue\' || enemy.aiState === \'engage\')) {\\n      enemy.coordinationTimer = tuning.coordinationIntervalSec;\\n      if (personality.flankAngleRad >= 0.45) {\\n        enemy.flankSign = enemy.flankSign === 1 ? -1 : 1;\\n      }\\n    }\\n\\n    // 1. State Machine Transitions\\n    if (!playerAlive) {\\n      enemy.aiState = \'patrol\';\\n    } else {\\n      switch (enemy.aiState) {\\n        case \'patrol\': {\\n          if (distToPlayer <= personality.detectionRange) {\\n            enemy.aiState = \'acquire\';\\n            enemy.aiStateTimer = tuning.reactionTime;\\n          }\\n          break;\\n        }\\n        case \'acquire\': {\\n          if (enemy.aiStateTimer <= 0) {\\n            enemy.aiState = distToPlayer <= personality.engageRange ? \'engage\' : \'pursue\';\\n            enemy.aiStateTimer = 2.4;\\n          }\\n          break;\\n        }\\n        case \'pursue\': {\\n          if (distToPlayer <= personality.minSafeDistance) {\\n            this.beginReposition(enemy, playerPos, personality.preferredRange);\\n          } else if (distToPlayer <= personality.engageRange) {\\n            enemy.aiState = \'engage\';\\n            enemy.aiStateTimer = 3.2;\\n          }\\n          break;\\n        }\\n        case \'engage\': {\\n          if (distToPlayer <= personality.minSafeDistance) {\\n            this.beginReposition(enemy, playerPos, personality.preferredRange);\\n          } else if (distToPlayer > personality.engageRange * 1.25) {\\n            enemy.aiState = \'pursue\';\\n            enemy.aiStateTimer = 2.5;\\n          } else if (enemy.aiStateTimer <= 0 && personality.flankAngleRad > 0.45) {\\n            // Flankers/Defenders/Aces periodically switch attack side to avoid predictable tail-chasing\\n            enemy.flankSign = enemy.flankSign === 1 ? -1 : 1;\\n            enemy.aiStateTimer = Math.max(1.8, tuning.coordinationIntervalSec);\\n          }\\n          break;\\n        }\", \"StartLine\":47, \"TargetContent\":\"    const personality = BOT_PERSONALITIES[enemy.personality];\\n    const tuning = resolveBotDifficultyTuning(personality, enemy.difficulty);\\n\\n    // Already evading or repositioning \342\200\224 only flip flank sign occasionally\\n    if (enemy.aiState === \'evade\') return;\\n\\n    // Deterministic-feeling probabilistic jink based on personality responsiveness\\n    const roll = Math.abs(Math.sin(now * 37.3 + enemy.position.x * 0.13));\\n    if (roll <= tuning.evadeResponsiveness) {\\n      enemy.aiState = \'evade\';\\n      enemy.aiStateTimer = personality.evadeDuration;\\n      enemy.flankSign = enemy.flankSign === 1 ? -1 : 1;\\n\\n      // Compute perpendicular jink vector away from player\'s line of fire\\n      _toPlayer.subVectors(playerPos, enemy.position).normalize();\\n      _perp.crossVectors(_toPlayer, _up);\\n      if (_perp.lengthSq() < 0.01) {\\n        _perp.set(1, 0, 0);\\n      } else {\\n        _perp.normalize();\\n      }\\n      const verticalLift = (roll - 0.35) * 0.75;\\n      enemy.evadeDir\\n        .copy(_perp)\\n        .multiplyScalar(enemy.flankSign)\\n        .addScaledVector(_up, verticalLift)\\n        .addScaledVector(_toPlayer, -0.35)\\n        .normalize();\\n    } else if (enemy.aiState === \'patrol\') {\\n      // Immediately alert if attacked while patrolling\\n      enemy.aiState = \'acquire\';\\n      enemy.aiStateTimer = tuning.reactionTime;\\n    }\\n  }\\n\\n  public updateEnemy(\\n    enemy: EnemyEntity,\\n    dt: number,\\n    now: number,\\n    playerPos: THREE.Vector3,\\n    playerVel: THREE.Vector3,\\n    playerAlive: boolean,\\n    projectiles: ProjectilePool,\\n    allEnemies: EnemyEntity[],\\n  ): EnemyAIUpdateResult {\\n    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);\\n    const out: EnemyAIUpdateResult = { fired: false, fireOrigin: _resultOrigin };\\n\\n    if (!enemy.active || enemy.health.isDestroyed) {\\n      enemy.aiState = \'destroyed\';\\n      return out;\\n    }\\n\\n    if (enemy.hitFlashTimer > 0) {\\n      enemy.hitFlashTimer = Math.max(0, enemy.hitFlashTimer - safeDt);\\n    }\\n    if (enemy.muzzleFlashTimer > 0) {\\n      enemy.muzzleFlashTimer = Math.max(0, enemy.muzzleFlashTimer - safeDt);\\n    }\\n    if (enemy.weaponCooldown > 0) {\\n      enemy.weaponCooldown = Math.max(0, enemy.weaponCooldown - safeDt);\\n    }\\n\\n    const personality = BOT_PERSONALITIES[enemy.personality];\\n    const tuning = resolveBotDifficultyTuning(personality, enemy.difficulty);\\n    const weapon = WEAPON_CONFIGS[personality.weaponId] ?? WEAPON_CONFIGS.enemy_pulse_aggressor;\\n\\n    _toPlayer.subVectors(playerPos, enemy.position);\\n    const distToPlayer = _toPlayer.length();\\n    const dirToPlayer = distToPlayer > 0.001 ? _toPlayer.divideScalar(distToPlayer) : _forward.set(0, 0, -1);\\n\\n    enemy.aiStateTimer = Math.max(0, enemy.aiStateTimer - safeDt);\\n\\n    // 1. State Machine Transitions\\n    if (!playerAlive) {\\n      enemy.aiState = \'patrol\';\\n    } else {\\n      switch (enemy.aiState) {\\n        case \'patrol\': {\\n          if (distToPlayer <= personality.detectionRange) {\\n            enemy.aiState = \'acquire\';\\n            enemy.aiStateTimer = tuning.reactionTime;\\n          }\\n          break;\\n        }\\n        case \'acquire\': {\\n          if (enemy.aiStateTimer <= 0) {\\n            enemy.aiState = distToPlayer <= personality.engageRange ? \'engage\' : \'pursue\';\\n            enemy.aiStateTimer = 2.4;\\n          }\\n          break;\\n        }\\n        case \'pursue\': {\\n          if (distToPlayer <= personality.minSafeDistance) {\\n            this.beginReposition(enemy, playerPos, personality.preferredRange);\\n          } else if (distToPlayer <= personality.engageRange) {\\n            enemy.aiState = \'engage\';\\n            enemy.aiStateTimer = 3.2;\\n          }\\n          break;\\n        }\\n        case \'engage\': {\\n          if (distToPlayer <= personality.minSafeDistance) {\\n            this.beginReposition(enemy, playerPos, personality.preferredRange);\\n          } else if (distToPlayer > personality.engageRange * 1.25) {\\n            enemy.aiState = \'pursue\';\\n            enemy.aiStateTimer = 2.5;\\n          } else if (enemy.aiStateTimer <= 0 && personality.flankAngleRad > 0.45) {\\n            // Flankers/Defenders/Aces periodically switch attack side to avoid predictable tail-chasing\\n            enemy.flankSign = enemy.flankSign === 1 ? -1 : 1;\\n            enemy.aiStateTimer = 3.6;\\n          }\\n          break;\\n        }\", \"TargetFile\":\"/src/engine/combat/EnemyAIController.ts\", \"toolAction\":\"Updating EnemyAIController difficulty profiles\", \"toolSummary\":\"Update EnemyAIController difficulty profiles\"}"
