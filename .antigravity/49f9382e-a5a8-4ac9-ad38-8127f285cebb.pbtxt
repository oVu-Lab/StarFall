    action_spec {
      command {
        instruction: "Update FlightController.ts with VIRTUAL_AIM_CONFIG, smooth unit-circle elliptical boundary clamping, restored responsive turn curve and angular damping, and zero rollback continuous turning."
        is_edit: true
        file {
