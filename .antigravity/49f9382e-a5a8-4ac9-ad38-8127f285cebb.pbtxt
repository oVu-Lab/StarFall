      arguments_json: "{\"CodeContent\":\"import type * as THREE from \'three\';\\n\\nexport type GamePhase = \'menu\' | \'loading\' | \'playing\' | \'paused\';\\n\\nexport type MenuSection = \'main\' | \'hangar\' | \'settings\';\\n\\nexport type ShipId = \'interceptor\' | \'striker\' | \'destroyer\';\\n\\nexport type GraphicsQuality = \'low\' | \'medium\' | \'high\';\\n\\nexport type FlightStatus =\\n  | \'STANDBY\'\\n  | \'CRUISING\'\\n  | \'ACCELERATING\'\\n  | \'BOOSTING\'\\n  | \'REVERSING\'\\n  | \'DRIFTING\'\\n  | \'BOOST DEPLETED\';\\n\\nexport interface ShipFlightProfile {\\n  /** Base forward max speed in m/s */\\n  maxSpeed: number;\\n  /** Reverse max speed in m/s */\\n  maxReverseSpeed: number;\\n  /** Forward thrust acceleration in m/s^2 */\\n  acceleration: number;\\n  /** Braking / reverse thrust acceleration in m/s^2 */\\n  deceleration: number;\\n  /** Passive velocity drag when no thrust key is pressed */\\n  passiveDrag: number;\\n  /** How quickly the velocity vector aligns with ship nose (arcade lateral grip) */\\n  lateralGrip: number;\\n  /** Boost speed multiplier applied to maxSpeed */\\n  boostMultiplier: number;\\n  /** Boost acceleration multiplier */\\n  boostAccelMultiplier: number;\\n  /** Boost energy pool (0-100) */\\n  maxBoostEnergy: number;\\n  /** Energy consumed per second while boosting */\\n  boostDrainRate: number;\\n  /** Energy regenerated per second when not boosting */\\n  boostRegenRate: number;\\n  /** Delay in seconds after stopping boost before regen begins */\\n  boostRegenDelay: number;\\n  /** Max yaw angular speed in rad/s */\\n  yawSpeed: number;\\n  /** Max pitch angular speed in rad/s */\\n  pitchSpeed: number;\\n  /** Max roll angular speed in rad/s */\\n  rollSpeed: number;\\n  /** Angular response damping (higher = snappier stop) */\\n  angularDamping: number;\\n  /** Subtle automatic visual banking induced by yaw */\\n  visualBankStrength: number;\\n}\\n\\nexport interface ShipWeaponSpec {\\n  primaryName: string;\\n  damageRating: number; // 0-100 normalized for UI comparison\\n  fireRateRating: number;\\n}\\n\\nexport interface ShipConfig {\\n  id: ShipId;\\n  callsign: string;\\n  name: string;\\n  role: string;\\n  description: string;\\n  /** Whether playable in Phase 1 */\\n  playableInPhase1: boolean;\\n  unlockNote: string;\\n  maxHull: number;\\n  /** Normalized 0-100 ratings for hangar specification bars */\\n  ratings: {\\n    speed: number;\\n    maneuverability: number;\\n    hull: number;\\n    firepower: number;\\n  };\\n  colors: {\\n    hullPrimary: string;\\n    hullSecondary: string;\\n    hullTrim: string;\\n    canopy: string;\\n    engineCore: string;\\n    engineGlow: string;\\n  };\\n  flight: ShipFlightProfile;\\n  weapons: ShipWeaponSpec;\\n}\\n\\nexport interface GameSettings {\\n  mouseSensitivity: number; // 0.3 to 2.5\\n  invertY: boolean;\\n  cameraDistance: number; // 7 to 14\\n  cameraSensitivity: number; // 0.5 to 1.8\\n  masterVolume: number; // 0 to 1\\n  graphicsQuality: GraphicsQuality;\\n  showPerfOverlay: boolean;\\n}\\n\\n/**\\n * High-frequency mutable telemetry updated every simulation frame.\\n * Read directly via refs inside HUD animation loops to guarantee zero React re-renders per frame.\\n */\\nexport interface FlightTelemetry {\\n  speed: number;\\n  signedSpeed: number;\\n  maxSpeed: number;\\n  effectiveMaxSpeed: number;\\n  throttle: number; // -1 to 1\\n  boostEnergy: number; // 0 to 100\\n  maxBoostEnergy: number;\\n  isBoosting: boolean;\\n  boostDepleted: boolean;\\n  boostIntensity: number; // 0 to 1 smoothly damped\\n  hull: number;\\n  maxHull: number;\\n  yawRate: number; // normalized -1..1\\n  pitchRate: number; // normalized -1..1\\n  rollRate: number; // normalized -1..1\\n  headingDeg: number; // 0..359\\n  pitchDeg: number; // -90..90\\n  rollDeg: number; // -180..180\\n  altitude: number;\\n  status: FlightStatus;\\n  pointerLocked: boolean;\\n  fps: number;\\n  frameTimeMs: number;\\n  drawCalls: number;\\n  triangles: number;\\n}\\n\\nexport interface LoadingProgress {\\n  stage: string;\\n  percent: number;\\n  shipId: ShipId;\\n}\\n\\n/* --------------------------------------------------------------------------\\n * Future-Phase Architectural Contracts (Combat, AI Bots & Mission Progression)\\n * Reserved so Phases 2-5 integrate without modifying core flight systems.\\n * -------------------------------------------------------------------------- */\\n\\nexport type BotPersonality = \'aggressor\' | \'flanker\' | \'defender\' | \'ace\';\\n\\nexport type MissionRank = \'S\' | \'A\' | \'B\' | \'C\';\\n\\nexport interface MissionDefinition {\\n  id: string;\\n  index: number;\\n  title: string;\\n  sector: string;\\n  difficulty: number;\\n  enemyWaveCount: number;\\n  unlockedByDefault: boolean;\\n}\\n\\nexport interface ShipVisualHandle {\\n  group: THREE.Group;\\n  updateVisuals: (\\n    dt: number,\\n    speedRatio: number,\\n    boostIntensity: number,\\n    yawInput: number,\\n    pitchInput: number,\\n    rollInput: number,\\n  ) => void;\\n  dispose: () => void;\\n}\\n\", \"Description\":\"Define core TypeScript interfaces for flight physics, ships, settings, telemetry, and future combat/mission contracts\", \"Overwrite\":true, \"TargetFile\":\"/src/types/game.ts\", \"toolAction\":\"Creating core game types\", \"toolSummary\":\"Create src/types/game.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_10100603781198246092"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import type { GameSettings, ShipConfig, ShipId } from \'../types/game\';\\n\\nexport const SHIP_CONFIGS: Record<ShipId, ShipConfig> = {\\n  interceptor: {\\n    id: \'interceptor\',\\n    callsign: \'VX-9 VANGUARD\',\\n    name: \'Interceptor\',\\n    role: \'High-Speed Recon & Dogfighter\',\\n    description:\\n      \'Needle-profile space superiority fighter built around twin vector plasma thrusters. Unmatched acceleration, snap roll authority, and aggressive turn rate.\',\\n    playableInPhase1: true,\\n    unlockNote: \'Active Flight Prototype\',\\n    maxHull: 100,\\n    ratings: {\\n      speed: 96,\\n      maneuverability: 94,\\n      hull: 52,\\n      firepower: 68,\\n    },\\n    colors: {\\n      hullPrimary: \'#1e293b\',\\n      hullSecondary: \'#0f172a\',\\n      hullTrim: \'#38bdf8\',\\n      canopy: \'#071426\',\\n      engineCore: \'#e0f2fe\',\\n      engineGlow: \'#06b6d4\',\\n    },\\n    flight: {\\n      maxSpeed: 135,\\n      maxReverseSpeed: 42,\\n      acceleration: 95,\\n      deceleration: 120,\\n      passiveDrag: 0.72,\\n      lateralGrip: 4.8,\\n      boostMultiplier: 1.85,\\n      boostAccelMultiplier: 2.35,\\n      maxBoostEnergy: 100,\\n      boostDrainRate: 26,\\n      boostRegenRate: 18,\\n      boostRegenDelay: 0.65,\\n      yawSpeed: 2.1,\\n      pitchSpeed: 1.95,\\n      rollSpeed: 3.1,\\n      angularDamping: 7.5,\\n      visualBankStrength: 0.34,\\n    },\\n    weapons: {\\n      primaryName: \'Twin Pulse Cannons\',\\n      damageRating: 68,\\n      fireRateRating: 92,\\n    },\\n  },\\n  striker: {\\n    id: \'striker\',\\n    callsign: \'SR-4 VALKYRIE\',\\n    name: \'Striker\',\\n    role: \'Multi-Role Assault Fighter\',\\n    description:\\n      \'Balanced forward-wing strike craft engineered for sustained dogfights. Combines reliable hull plating with versatile weapon hardpoints.\',\\n    playableInPhase1: false,\\n    unlockNote: \'Coming Soon \342\200\224 Unlockable in Combat Campaign\',\\n    maxHull: 150,\\n    ratings: {\\n      speed: 78,\\n      maneuverability: 79,\\n      hull: 76,\\n      firepower: 80,\\n    },\\n    colors: {\\n      hullPrimary: \'#273549\',\\n      hullSecondary: \'#111827\',\\n      hullTrim: \'#60a5fa\',\\n      canopy: \'#0b192c\',\\n      engineCore: \'#dbeafe\',\\n      engineGlow: \'#3b82f6\',\\n    },\\n    flight: {\\n      maxSpeed: 118,\\n      maxReverseSpeed: 36,\\n      acceleration: 82,\\n      deceleration: 105,\\n      passiveDrag: 0.8,\\n      lateralGrip: 4.2,\\n      boostMultiplier: 1.72,\\n      boostAccelMultiplier: 2.1,\\n      maxBoostEnergy: 100,\\n      boostDrainRate: 28,\\n      boostRegenRate: 16,\\n      boostRegenDelay: 0.75,\\n      yawSpeed: 1.8,\\n      pitchSpeed: 1.7,\\n      rollSpeed: 2.55,\\n      angularDamping: 6.8,\\n      visualBankStrength: 0.28,\\n    },\\n    weapons: {\\n      primaryName: \'Quad Plasma Repeaters\',\\n      damageRating: 80,\\n      fireRateRating: 78,\\n    },\\n  },\\n  destroyer: {\\n    id: \'destroyer\',\\n    callsign: \'HX-12 AEGIS\',\\n    name: \'Destroyer\',\\n    role: \'Heavy Gunship & Breaker\',\\n    description:\\n      \'Armored heavy assault hull outfitted with twin rail-accelerators and triple drive cores. Built to absorb punishment and dominate fleet engagements.\',\\n    playableInPhase1: false,\\n    unlockNote: \'Coming Soon \342\200\224 Unlockable via Mission Rank Progression\',\\n    maxHull: 230,\\n    ratings: {\\n      speed: 62,\\n      maneuverability: 58,\\n      hull: 98,\\n      firepower: 96,\\n    },\\n    colors: {\\n      hullPrimary: \'#1f2937\',\\n      hullSecondary: \'#0c1220\',\\n      hullTrim: \'#0ea5e9\',\\n      canopy: \'#061322\',\\n      engineCore: \'#cffafe\',\\n      engineGlow: \'#0284c7\',\\n    },\\n    flight: {\\n      maxSpeed: 98,\\n      maxReverseSpeed: 30,\\n      acceleration: 65,\\n      deceleration: 88,\\n      passiveDrag: 0.85,\\n      lateralGrip: 3.5,\\n      boostMultiplier: 1.62,\\n      boostAccelMultiplier: 1.9,\\n      maxBoostEnergy: 100,\\n      boostDrainRate: 30,\\n      boostRegenRate: 15,\\n      boostRegenDelay: 0.85,\\n      yawSpeed: 1.4,\\n      pitchSpeed: 1.32,\\n      rollSpeed: 1.95,\\n      angularDamping: 5.8,\\n      visualBankStrength: 0.2,\\n    },\\n    weapons: {\\n      primaryName: \'Dual Heavy Rail Cannons\',\\n      damageRating: 96,\\n      fireRateRating: 58,\\n    },\\n  },\\n};\\n\\nexport const SHIP_ORDER: ShipId[] = [\'interceptor\', \'striker\', \'destroyer\'];\\n\\nexport const DEFAULT_SETTINGS: GameSettings = {\\n  mouseSensitivity: 1.0,\\n  invertY: false,\\n  cameraDistance: 9.8,\\n  cameraSensitivity: 1.0,\\n  masterVolume: 0.65,\\n  graphicsQuality: \'high\',\\n  showPerfOverlay: false,\\n};\\n\\nconst SETTINGS_STORAGE_KEY = \'starfall.settings.v1\';\\n\\nexport function loadSavedSettings(): GameSettings {\\n  try {\\n    const raw = window.localStorage.getItem(SETTINGS_STORAGE_KEY);\\n    if (!raw) return { ...DEFAULT_SETTINGS };\\n    const parsed = JSON.parse(raw) as Partial<GameSettings>;\\n    return {\\n      ...DEFAULT_SETTINGS,\\n      ...parsed,\\n    };\\n  } catch {\\n    return { ...DEFAULT_SETTINGS };\\n  }\\n}\\n\\nexport function saveSettings(settings: GameSettings): void {\\n  try {\\n    window.localStorage.setItem(SETTINGS_STORAGE_KEY, JSON.stringify(settings));\\n  } catch {\\n    // Ignore storage quota / privacy mode errors\\n  }\\n}\\n\", \"Description\":\"Create ship configuration registry for Interceptor, Striker, and Destroyer plus persisted settings helpers\", \"Overwrite\":true, \"TargetFile\":\"/src/config/ships.ts\", \"toolAction\":\"Creating ship configurations\", \"toolSummary\":\"Create src/config/ships.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_10100603781198249091"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import type { GraphicsQuality } from \'../types/game\';\\n\\nexport interface GraphicsPreset {\\n  dprCap: number;\\n  antialias: boolean;\\n  shadows: boolean;\\n  starCount: number;\\n  asteroidCount: number;\\n  speedLineCount: number;\\n  planetSegments: number;\\n  drawDistance: number;\\n}\\n\\nexport const GRAPHICS_PRESETS: Record<GraphicsQuality, GraphicsPreset> = {\\n  low: {\\n    dprCap: 1.0,\\n    antialias: false,\\n    shadows: false,\\n    starCount: 1600,\\n    asteroidCount: 80,\\n    speedLineCount: 120,\\n    planetSegments: 32,\\n    drawDistance: 2400,\\n  },\\n  medium: {\\n    dprCap: 1.5,\\n    antialias: true,\\n    shadows: false,\\n    starCount: 2800,\\n    asteroidCount: 140,\\n    speedLineCount: 200,\\n    planetSegments: 48,\\n    drawDistance: 3200,\\n  },\\n  high: {\\n    dprCap: 2.0,\\n    antialias: true,\\n    shadows: true,\\n    starCount: 4200,\\n    asteroidCount: 210,\\n    speedLineCount: 280,\\n    planetSegments: 64,\\n    drawDistance: 4200,\\n  },\\n};\\n\\nlet cachedSoftwareGl: boolean | null = null;\\n\\n/**\\n * Detects software WebGL renderers (SwiftShader, llvmpipe, WARP) from the GPU renderer string.\\n * Used strictly to scale rendering cost (DPR, antialiasing, shadows) without altering scene content.\\n */\\nexport function isSoftwareWebGL(): boolean {\\n  if (cachedSoftwareGl !== null) return cachedSoftwareGl;\\n  try {\\n    const canvas = document.createElement(\'canvas\');\\n    const gl = canvas.getContext(\'webgl2\') || canvas.getContext(\'webgl\');\\n    if (!gl) {\\n      cachedSoftwareGl = true;\\n      return true;\\n    }\\n    const ext = gl.getExtension(\'WEBGL_debug_renderer_info\');\\n    const param = ext ? ext.UNMASKED_RENDERER_WEBGL : gl.RENDERER;\\n    const gpu = String(gl.getParameter(param) ?? \'\');\\n    gl.getExtension(\'WEBGL_lose_context\')?.loseContext();\\n    cachedSoftwareGl = /SwiftShader|llvmpipe|softpipe|Software|Basic Render/i.test(gpu);\\n    return cachedSoftwareGl;\\n  } catch {\\n    cachedSoftwareGl = false;\\n    return false;\\n  }\\n}\\n\\nexport function resolveEffectiveGraphics(quality: GraphicsQuality): GraphicsPreset {\\n  const base = GRAPHICS_PRESETS[quality];\\n  if (!isSoftwareWebGL()) return base;\\n  // On software WebGL, preserve scene content & counts while capping pixel cost\\n  return {\\n    ...base,\\n    dprCap: 1.0,\\n    antialias: false,\\n    shadows: false,\\n  };\\n}\\n\", \"Description\":\"Create adaptive graphics presets and software WebGL detector\", \"Overwrite\":true, \"TargetFile\":\"/src/config/graphics.ts\", \"toolAction\":\"Creating graphics configuration\", \"toolSummary\":\"Create src/config/graphics.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_10100603781198247994"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import * as THREE from \'three\';\\n\\nexport interface ProceduralTextureBundle {\\n  hullAlbedo: THREE.CanvasTexture;\\n  hullRoughness: THREE.CanvasTexture;\\n  hullBump: THREE.CanvasTexture;\\n  gasGiantMap: THREE.CanvasTexture;\\n  moonMap: THREE.CanvasTexture;\\n  asteroidMap: THREE.CanvasTexture;\\n  glowSprite: THREE.CanvasTexture;\\n}\\n\\ninterface CacheEntry<T> {\\n  value: T;\\n  refs: number;\\n  dispose: () => void;\\n}\\n\\n/**\\n * Centralized progressive asset manager with caching, reference tracking,\\n * deterministic procedural PBR texture synthesis (zero external 404s), and disposal.\\n */\\nclass AssetManagerImpl {\\n  private cache = new Map<string, CacheEntry<unknown>>();\\n  private maxAnisotropy = 4;\\n\\n  public configureRenderer(renderer: THREE.WebGLRenderer): void {\\n    this.maxAnisotropy = Math.min(renderer.capabilities.getMaxAnisotropy(), 8);\\n  }\\n\\n  public acquire<T>(key: string, factory: () => T, dispose: (val: T) => void): T {\\n    const existing = this.cache.get(key) as CacheEntry<T> | undefined;\\n    if (existing) {\\n      existing.refs += 1;\\n      return existing.value;\\n    }\\n    const value = factory();\\n    this.cache.set(key, {\\n      value,\\n      refs: 1,\\n      dispose: () => dispose(value),\\n    });\\n    return value;\\n  }\\n\\n  public release(key: string): void {\\n    const entry = this.cache.get(key);\\n    if (!entry) return;\\n    entry.refs -= 1;\\n    if (entry.refs <= 0) {\\n      entry.dispose();\\n      this.cache.delete(key);\\n    }\\n  }\\n\\n  public getCoreTextures(): ProceduralTextureBundle {\\n    return this.acquire<ProceduralTextureBundle>(\\n      \'core-procedural-textures\',\\n      () => ({\\n        hullAlbedo: this.createHullAlbedoTexture(),\\n        hullRoughness: this.createHullRoughnessTexture(),\\n        hullBump: this.createHullBumpTexture(),\\n        gasGiantMap: this.createGasGiantTexture(),\\n        moonMap: this.createMoonTexture(),\\n        asteroidMap: this.createAsteroidTexture(),\\n        glowSprite: this.createGlowSpriteTexture(),\\n      }),\\n      (bundle) => {\\n        bundle.hullAlbedo.dispose();\\n        bundle.hullRoughness.dispose();\\n        bundle.hullBump.dispose();\\n        bundle.gasGiantMap.dispose();\\n        bundle.moonMap.dispose();\\n        bundle.asteroidMap.dispose();\\n        bundle.glowSprite.dispose();\\n      },\\n    );\\n  }\\n\\n  /**\\n   * Progressive async preparation pipeline used when transitioning from Menu -> Gameplay.\\n   * Yields between stages so the main thread stays smooth and reports accurate progress.\\n   */\\n  public async prepareFlightSession(\\n    onProgress: (stage: string, percent: number) => void,\\n  ): Promise<void> {\\n    const yieldFrame = () =>\\n      new Promise<void>((resolve) => {\\n        window.requestAnimationFrame(() => resolve());\\n      });\\n\\n    onProgress(\'Synthesizing hull PBR plating & panel maps\', 22);\\n    await yieldFrame();\\n    this.getCoreTextures();\\n\\n    onProgress(\'Calibrating orbital sector & planetary shaders\', 54);\\n    await yieldFrame();\\n    await new Promise((r) => window.setTimeout(r, 90));\\n\\n    onProgress(\'Initializing 6DOF flight telemetry & thrusters\', 82);\\n    await yieldFrame();\\n    await new Promise((r) => window.setTimeout(r, 90));\\n\\n    onProgress(\'Flight systems online\', 100);\\n    await yieldFrame();\\n  }\\n\\n  private configureTexture(\\n    tex: THREE.CanvasTexture,\\n    isColor: boolean,\\n    repeatX = 1,\\n    repeatY = 1,\\n  ): THREE.CanvasTexture {\\n    tex.wrapS = THREE.RepeatWrapping;\\n    tex.wrapT = THREE.RepeatWrapping;\\n    tex.repeat.set(repeatX, repeatY);\\n    tex.colorSpace = isColor ? THREE.SRGBColorSpace : THREE.NoColorSpace;\\n    tex.anisotropy = this.maxAnisotropy;\\n    tex.needsUpdate = true;\\n    return tex;\\n  }\\n\\n  private createHullAlbedoTexture(): THREE.CanvasTexture {\\n    const size = 512;\\n    const canvas = document.createElement(\'canvas\');\\n    canvas.width = size;\\n    canvas.height = size;\\n    const ctx = canvas.getContext(\'2d\')!;\\n\\n    ctx.fillStyle = \'#c8d4e3\';\\n    ctx.fillRect(0, 0, size, size);\\n\\n    // Subtle brushed titanium directional micro-grain\\n    for (let y = 0; y < size; y += 2) {\\n      const shade = 192 + ((Math.sin(y * 0.73) * 7 + Math.cos(y * 2.1) * 5) | 0);\\n      ctx.fillStyle = `rgb(${shade - 6}, ${shade}, ${shade + 8})`;\\n      ctx.fillRect(0, y, size, 2);\\n    }\\n\\n    // Precision armored hull plates\\n    const panels = [\\n      [16, 16, 224, 140, \'rgba(255,255,255,0.06)\'],\\n      [256, 16, 240, 220, \'rgba(15,23,42,0.09)\'],\\n      [16, 172, 224, 160, \'rgba(15,23,42,0.06)\'],\\n      [256, 252, 240, 244, \'rgba(255,255,255,0.05)\'],\\n      [16, 348, 224, 148, \'rgba(30,41,59,0.08)\'],\\n    ] as const;\\n\\n    for (const [x, y, w, h, fill] of panels) {\\n      ctx.fillStyle = fill;\\n      ctx.fillRect(x, y, w, h);\\n      ctx.strokeStyle = \'rgba(15, 23, 42, 0.45)\';\\n      ctx.lineWidth = 2;\\n      ctx.strokeRect(x, y, w, h);\\n      ctx.strokeStyle = \'rgba(226, 232, 240, 0.25)\';\\n      ctx.lineWidth = 1;\\n      ctx.strokeRect(x + 2, y + 2, w - 4, h - 4);\\n    }\\n\\n    // Subtle rivet accents along panel corners\\n    ctx.fillStyle = \'rgba(15, 23, 42, 0.5)\';\\n    for (let x = 28; x < size; x += 64) {\\n      for (let y = 28; y < size; y += 64) {\\n        ctx.beginPath();\\n        ctx.arc(x, y, 1.8, 0, Math.PI * 2);\\n        ctx.fill();\\n      }\\n    }\\n\\n    return this.configureTexture(new THREE.CanvasTexture(canvas), true, 2, 2);\\n  }\\n\\n  private createHullRoughnessTexture(): THREE.CanvasTexture {\\n    const size = 512;\\n    const canvas = document.createElement(\'canvas\');\\n    canvas.width = size;\\n    canvas.height = size;\\n    const ctx = canvas.getContext(\'2d\')!;\\n\\n    ctx.fillStyle = \'#585858\';\\n    ctx.fillRect(0, 0, size, size);\\n\\n    // Varying panel sheen for realistic light break-up\\n    ctx.fillStyle = \'#404040\';\\n    ctx.fillRect(16, 16, 224, 140);\\n    ctx.fillStyle = \'#6c6c6c\';\\n    ctx.fillRect(256, 16, 240, 220);\\n    ctx.fillStyle = \'#4d4d4d\';\\n    ctx.fillRect(256, 252, 240, 244);\\n\\n    // Matte panel seams\\n    ctx.strokeStyle = \'#b8b8b8\';\\n    ctx.lineWidth = 3;\\n    ctx.strokeRect(16, 16, 224, 140);\\n    ctx.strokeRect(256, 16, 240, 220);\\n    ctx.strokeRect(16, 172, 224, 160);\\n    ctx.strokeRect(256, 252, 240, 244);\\n\\n    return this.configureTexture(new THREE.CanvasTexture(canvas), false, 2, 2);\\n  }\\n\\n  private createHullBumpTexture(): THREE.CanvasTexture {\\n    const size = 512;\\n    const canvas = document.createElement(\'canvas\');\\n    canvas.width = size;\\n    canvas.height = size;\\n    const ctx = canvas.getContext(\'2d\')!;\\n\\n    ctx.fillStyle = \'#808080\';\\n    ctx.fillRect(0, 0, size, size);\\n\\n    ctx.strokeStyle = \'#202020\';\\n    ctx.lineWidth = 3;\\n    ctx.strokeRect(16, 16, 224, 140);\\n    ctx.strokeRect(256, 16, 240, 220);\\n    ctx.strokeRect(16, 172, 224, 160);\\n    ctx.strokeRect(256, 252, 240, 244);\\n    ctx.strokeRect(16, 348, 224, 148);\\n\\n    // Access hatches\\n    ctx.strokeStyle = \'#383838\';\\n    ctx.lineWidth = 2;\\n    ctx.strokeRect(64, 56, 48, 32);\\n    ctx.strokeRect(320, 310, 68, 42);\\n\\n    return this.configureTexture(new THREE.CanvasTexture(canvas), false, 2, 2);\\n  }\\n\\n  private createGasGiantTexture(): THREE.CanvasTexture {\\n    const w = 1024;\\n    const h = 512;\\n    const canvas = document.createElement(\'canvas\');\\n    canvas.width = w;\\n    canvas.height = h;\\n    const ctx = canvas.getContext(\'2d\')!;\\n\\n    // Deep sapphire/slate-blue & luminous pale-cyan atmospheric bands\\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\\n    grad.addColorStop(0.0, \'#071024\');\\n    grad.addColorStop(0.14, \'#102446\');\\n    grad.addColorStop(0.28, \'#1e3a5f\');\\n    grad.addColorStop(0.4, \'#38638f\');\\n    grad.addColorStop(0.5, \'#6fa3c7\');\\n    grad.addColorStop(0.6, \'#23466d\');\\n    grad.addColorStop(0.75, \'#132a4f\');\\n    grad.addColorStop(0.9, \'#0b1830\');\\n    grad.addColorStop(1.0, \'#060c1b\');\\n    ctx.fillStyle = grad;\\n    ctx.fillRect(0, 0, w, h);\\n\\n    // Swirling horizontal storm bands\\n    for (let i = 0; i < 65; i++) {\\n      const y = (i / 65) * h;\\n      const bandH = 3 + ((i * 7) % 14);\\n      const alpha = 0.08 + ((i * 13) % 10) * 0.015;\\n      const isBright = i % 3 === 0;\\n      ctx.fillStyle = isBright\\n        ? `rgba(125, 211, 252, ${alpha})`\\n        : `rgba(8, 18, 38, ${alpha * 1.4})`;\\n\\n      ctx.beginPath();\\n      ctx.moveTo(0, y);\\n      for (let x = 0; x <= w; x += 32) {\\n        const wave = Math.sin(x * 0.012 + i * 1.3) * 5 + Math.cos(x * 0.028 - i * 0.7) * 3;\\n        ctx.lineTo(x, y + wave);\\n      }\\n      ctx.lineTo(w, y + bandH);\\n      ctx.lineTo(0, y + bandH);\\n      ctx.closePath();\\n      ctx.fill();\\n    }\\n\\n    // Great cyan-indigo cyclone oval\\n    const stormGrad = ctx.createRadialGradient(w * 0.62, h * 0.44, 6, w * 0.62, h * 0.44, 68);\\n    stormGrad.addColorStop(0, \'rgba(186, 230, 253, 0.55)\');\\n    stormGrad.addColorStop(0.45, \'rgba(56, 189, 248, 0.28)\');\\n    stormGrad.addColorStop(1, \'rgba(14, 116, 144, 0)\');\\n    ctx.save();\\n    ctx.scale(1.6, 0.72);\\n    ctx.fillStyle = stormGrad;\\n    ctx.beginPath();\\n    ctx.arc((w * 0.62) / 1.6, (h * 0.44) / 0.72, 68, 0, Math.PI * 2);\\n    ctx.fill();\\n    ctx.restore();\\n\\n    return this.configureTexture(new THREE.CanvasTexture(canvas), true, 1, 1);\\n  }\\n\\n  private createMoonTexture(): THREE.CanvasTexture {\\n    const w = 512;\\n    const h = 256;\\n    const canvas = document.createElement(\'canvas\');\\n    canvas.width = w;\\n    canvas.height = h;\\n    const ctx = canvas.getContext(\'2d\')!;\\n\\n    ctx.fillStyle = \'#475569\';\\n    ctx.fillRect(0, 0, w, h);\\n\\n    // Subtle regolith blotches\\n    for (let i = 0; i < 120; i++) {\\n      const x = ((i * 97) % w);\\n      const y = ((i * 53) % h);\\n      const r = 8 + ((i * 19) % 34);\\n      const light = i % 2 === 0;\\n      ctx.fillStyle = light ? \'rgba(148, 163, 184, 0.14)\' : \'rgba(15, 23, 42, 0.22)\';\\n      ctx.beginPath();\\n      ctx.arc(x, y, r, 0, Math.PI * 2);\\n      ctx.fill();\\n    }\\n\\n    // Impact craters with bright rims\\n    for (let i = 0; i < 42; i++) {\\n      const x = ((i * 131 + 29) % w);\\n      const y = 20 + ((i * 71) % (h - 40));\\n      const r = 4 + ((i * 11) % 18);\\n      ctx.fillStyle = \'rgba(15, 23, 42, 0.36)\';\\n      ctx.beginPath();\\n      ctx.arc(x, y, r, 0, Math.PI * 2);\\n      ctx.fill();\\n      ctx.strokeStyle = \'rgba(203, 213, 225, 0.22)\';\\n      ctx.lineWidth = 1.4;\\n      ctx.beginPath();\\n      ctx.arc(x - 1, y - 1, r, 0, Math.PI * 2);\\n      ctx.stroke();\\n    }\\n\\n    return this.configureTexture(new THREE.CanvasTexture(canvas), true, 1, 1);\\n  }\\n\\n  private createAsteroidTexture(): THREE.CanvasTexture {\\n    const size = 256;\\n    const canvas = document.createElement(\'canvas\');\\n    canvas.width = size;\\n    canvas.height = size;\\n    const ctx = canvas.getContext(\'2d\')!;\\n\\n    ctx.fillStyle = \'#334155\';\\n    ctx.fillRect(0, 0, size, size);\\n\\n    for (let i = 0; i < 90; i++) {\\n      const x = (i * 67) % size;\\n      const y = (i * 41) % size;\\n      const r = 4 + ((i * 13) % 20);\\n      ctx.fillStyle = i % 3 === 0 ? \'rgba(100,116,139,0.22)\' : \'rgba(15,23,42,0.28)\';\\n      ctx.beginPath();\\n      ctx.arc(x, y, r, 0, Math.PI * 2);\\n      ctx.fill();\\n    }\\n\\n    return this.configureTexture(new THREE.CanvasTexture(canvas), true, 1, 1);\\n  }\\n\\n  private createGlowSpriteTexture(): THREE.CanvasTexture {\\n    const size = 128;\\n    const canvas = document.createElement(\'canvas\');\\n    canvas.width = size;\\n    canvas.height = size;\\n    const ctx = canvas.getContext(\'2d\')!;\\n    const c = size / 2;\\n    const grad = ctx.createRadialGradient(c, c, 0, c, c, c);\\n    grad.addColorStop(0.0, \'rgba(255, 255, 255, 1.0)\');\\n    grad.addColorStop(0.25, \'rgba(165, 243, 252, 0.78)\');\\n    grad.addColorStop(0.55, \'rgba(6, 182, 212, 0.28)\');\\n    grad.addColorStop(1.0, \'rgba(6, 182, 212, 0.0)\');\\n    ctx.fillStyle = grad;\\n    ctx.fillRect(0, 0, size, size);\\n    const tex = new THREE.CanvasTexture(canvas);\\n    tex.colorSpace = THREE.SRGBColorSpace;\\n    tex.needsUpdate = true;\\n    return tex;\\n  }\\n\\n  public disposeAll(): void {\\n    for (const entry of this.cache.values()) {\\n      entry.dispose();\\n    }\\n    this.cache.clear();\\n  }\\n}\\n\\nexport const AssetManager = new AssetManagerImpl();\\n\", \"Description\":\"Create centralized AssetManager with procedural PBR hull/planet/asteroid textures, caching, reference tracking, and async loading stages\", \"Overwrite\":true, \"TargetFile\":\"/src/engine/AssetManager.ts\", \"toolAction\":\"Creating AssetManager\", \"toolSummary\":\"Create src/engine/AssetManager.ts\"}"
