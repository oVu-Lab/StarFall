            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  /**"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   * Computes the exact unit world-space firing/aiming direction combining ship attitude"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   * with the expanded gimbaled aim offsets. Guaranteed 1:1 with HUD reticle projection."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  public getAimDirectionWorld(out: THREE.Vector3): THREE.Vector3 {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    _qAimYaw.setFromAxisAngle(_AXIS_Y, this.aimYawOffset);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    _qAimPitch.setFromAxisAngle(_AXIS_X, this.aimPitchOffset);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    out"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      .copy(_FORWARD_LOCAL)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      .applyQuaternion(_qAimPitch)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      .applyQuaternion(_qAimYaw)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      .applyQuaternion(this.quaternion)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      .normalize();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return out;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   * Computes the 3D world-space convergence point along the player\'s true aim ray."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  public getAimTargetPoint(out: THREE.Vector3, distance: number): THREE.Vector3 {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.getAimDirectionWorld(out);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    out.multiplyScalar(distance).add(this.position);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return out;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  /**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   * Advances arcade flight simulation by delta time `dt` (seconds) and writes live telemetry."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  public update("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    dt: number,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    input: InputSnapshot,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    settings: GameSettings,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    telemetry: FlightTelemetry,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  ): void {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const profile = this.ship.flight;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // 1. Mouse-driven Yaw & Pitch (plus optional arrow key assistance)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // 1. Expanded Gimbaled Mouse Aiming Envelope + Precision Response Curve"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const sens = settings.mouseSensitivity;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const mouseScale = 0.0042 * sens;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    let targetYawInput = -input.mouseDeltaX * mouseScale / safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const baseRadPerPx = 0.0024 * sens;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const ySign = settings.invertY ? 1 : -1;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    let targetPitchInput = input.mouseDeltaY * mouseScale * ySign / safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    if (input.keyYawLeft) targetYawInput += profile.yawSpeed * 0.85;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    if (input.keyYawRight) targetYawInput -= profile.yawSpeed * 0.85;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    if (input.keyPitchUp) targetPitchInput += profile.pitchSpeed * 0.85;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    if (input.keyPitchDown) targetPitchInput -= profile.pitchSpeed * 0.85;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // Clamp to max angular authority so fast mouse flicks feel aggressive yet controlled"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const maxYaw = profile.yawSpeed * (1.25 + sens * 0.35);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const maxPitch = profile.pitchSpeed * (1.25 + sens * 0.35);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    targetYawInput = THREE.MathUtils.clamp(targetYawInput, -maxYaw, maxYaw);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    targetPitchInput = THREE.MathUtils.clamp(targetPitchInput, -maxPitch, maxPitch);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // Smooth response: snappy attack when mouse moves, crisp damping when released"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const mouseActive ="
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      Math.abs(input.mouseDeltaX) > 0.01 ||"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      Math.abs(input.mouseDeltaY) > 0.01 ||"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      input.keyYawLeft ||"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      input.keyYawRight ||"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      input.keyPitchUp ||"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      input.keyPitchDown;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const angularLambda = mouseActive ? profile.angularDamping * 1.9 : profile.angularDamping * 1.35;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const angularAlpha = 1 - Math.exp(-angularLambda * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    this.yawVelocity = THREE.MathUtils.lerp(this.yawVelocity, targetYawInput, angularAlpha);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    this.pitchVelocity = THREE.MathUtils.lerp(this.pitchVelocity, targetPitchInput, angularAlpha);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // 2. Independent Roll via A / D"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const shapedDx = shapeMouseDelta(input.mouseDeltaX);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const shapedDy = shapeMouseDelta(input.mouseDeltaY);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.aimYawOffset += -shapedDx * baseRadPerPx;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.aimPitchOffset += shapedDy * baseRadPerPx * ySign;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Optional arrow key steering pushes the aim envelope smoothly"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (input.keyYawLeft) this.aimYawOffset += profile.yawSpeed * 0.65 * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (input.keyYawRight) this.aimYawOffset -= profile.yawSpeed * 0.65 * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (input.keyPitchUp) this.aimPitchOffset += profile.pitchSpeed * 0.65 * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (input.keyPitchDown) this.aimPitchOffset -= profile.pitchSpeed * 0.65 * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Softly constrain aim offset to a spacious elliptical envelope (no harsh box clipping)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const normX = this.aimYawOffset / MAX_AIM_YAW_RAD;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const normY = this.aimPitchOffset / MAX_AIM_PITCH_RAD;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const radial = Math.hypot(normX, normY);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (radial > 1.0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.aimYawOffset /= radial;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.aimPitchOffset /= radial;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // 2. Smooth Chase-the-Aim-Vector Angular Authority (non-linear: ultra-precise near center, strong sweeps at rim)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const absYawRatio = Math.min(1, Math.abs(this.aimYawOffset) / MAX_AIM_YAW_RAD);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const absPitchRatio = Math.min(1, Math.abs(this.aimPitchOffset) / MAX_AIM_PITCH_RAD);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Progressive authority curve keeps tiny corrections silky while allowing rapid full-range turns"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const yawCurve = 0.55 * absYawRatio + 0.72 * Math.pow(absYawRatio, 1.45);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const pitchCurve = 0.55 * absPitchRatio + 0.72 * Math.pow(absPitchRatio, 1.45);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const targetYawVel ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      Math.sign(this.aimYawOffset) * yawCurve * profile.yawSpeed * 1.45;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const targetPitchVel ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      Math.sign(this.aimPitchOffset) * pitchCurve * profile.pitchSpeed * 1.45;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const angularAlpha = 1 - Math.exp(-(profile.angularDamping * 1.55) * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.yawVelocity = THREE.MathUtils.lerp(this.yawVelocity, targetYawVel, angularAlpha);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.pitchVelocity = THREE.MathUtils.lerp(this.pitchVelocity, targetPitchVel, angularAlpha);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Prevent overshoot: ship rotation step eats the remaining aim offset cleanly"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let stepYaw = this.yawVelocity * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let stepPitch = this.pitchVelocity * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (Math.sign(stepYaw) === Math.sign(this.aimYawOffset) && Math.abs(stepYaw) > Math.abs(this.aimYawOffset)) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      stepYaw = this.aimYawOffset;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (Math.sign(stepPitch) === Math.sign(this.aimPitchOffset) && Math.abs(stepPitch) > Math.abs(this.aimPitchOffset)) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      stepPitch = this.aimPitchOffset;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.aimYawOffset -= stepYaw;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.aimPitchOffset -= stepPitch;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Tiny deadzone snap only when essentially centered so ship holds rock-steady aim"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (Math.abs(this.aimYawOffset) < 1e-4 && Math.abs(input.mouseDeltaX) < 0.01) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.aimYawOffset = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (Math.abs(this.aimPitchOffset) < 1e-4 && Math.abs(input.mouseDeltaY) < 0.01) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.aimPitchOffset = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // 3. Independent Roll via A / D (preserves exact Phase 1 roll feel!)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let rollDir = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (input.rollLeft) rollDir += 1;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (input.rollRight) rollDir -= 1;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const targetRollRate = rollDir * profile.rollSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const rollAlpha = 1 - Math.exp(-(profile.angularDamping * 1.25) * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    this.rollVelocity = THREE.MathUtils.lerp(this.rollVelocity, targetRollRate, rollAlpha);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    // 3. Apply local-space quaternion rotations (zero gimbal lock in 6DOF space!)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    _qYaw.setFromAxisAngle(_AXIS_Y, this.yawVelocity * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    _qPitch.setFromAxisAngle(_AXIS_X, this.pitchVelocity * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    _qRoll.setFromAxisAngle(_AXIS_Z, this.rollVelocity * safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const stepRoll = this.rollVelocity * safeDt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Counter-rotate the 2D local aim offset during deliberate roll so world-space aim stays stable"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (Math.abs(stepRoll) > 1e-5) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const cosR = Math.cos(-stepRoll);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const sinR = Math.sin(-stepRoll);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const oldYaw = this.aimYawOffset;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const oldPitch = this.aimPitchOffset;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.aimYawOffset = oldYaw * cosR - oldPitch * sinR;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.aimPitchOffset = oldYaw * sinR + oldPitch * cosR;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // 4. Apply Pure Local-Space Quaternion Rotations (Zero Gimbal Lock at any pitch/yaw!)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    _qYaw.setFromAxisAngle(_AXIS_Y, stepYaw);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    _qPitch.setFromAxisAngle(_AXIS_X, stepPitch);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    _qRoll.setFromAxisAngle(_AXIS_Z, stepRoll);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    this.quaternion.multiply(_qYaw);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    this.quaternion.multiply(_qPitch);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    this.quaternion.multiply(_qRoll);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    this.quaternion.normalize();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // Subtle visual bank when yawing without overriding deliberate A/D roll"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const targetBank = THREE.MathUtils.clamp("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      (this.yawVelocity / profile.yawSpeed) * profile.visualBankStrength,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      -0.42,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      0.42,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      -0.44,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      0.44,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    );"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    this.visualBankAngle = THREE.MathUtils.damp(this.visualBankAngle, targetBank, 6.5, safeDt);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
