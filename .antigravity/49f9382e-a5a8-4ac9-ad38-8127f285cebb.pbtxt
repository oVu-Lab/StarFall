      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add progressive mouse steering defaults and safe validation in loadSavedSettings\", \"EndLine\":210, \"Instruction\":\"Add progressive steering default values and clamp validation in src/config/ships.ts\", \"ReplacementContent\":\"export const DEFAULT_SETTINGS: GameSettings = {\\n  mouseSensitivity: 1.0,\\n  boundarySensitivity: 0.35,\\n  maxSensitivity: 2.5,\\n  accelerationDistance: 240,\\n  responseCurve: 2.0,\\n  aimBoundarySize: 0.25,\\n  invertY: false,\\n  cameraDistance: 9.8,\\n  cameraSensitivity: 1.0,\\n  masterVolume: 0.65,\\n  graphicsQuality: \'high\',\\n  resolutionScale: 1.0,\\n  shadowQuality: \'medium\',\\n  particleQuality: \'high\',\\n  environmentDetail: \'high\',\\n  drawDistance: 4200,\\n  antialias: true,\\n  postGlowEnabled: true,\\n  showPerfOverlay: false,\\n};\\n\\nconst SETTINGS_STORAGE_KEY = \'starfall.settings.v2\';\\nconst LEGACY_SETTINGS_KEY = \'starfall.settings.v1\';\\n\\nfunction clampNumber(value: unknown, min: number, max: number, fallback: number): number {\\n  return typeof value === \'number\' && Number.isFinite(value)\\n    ? Math.max(min, Math.min(max, value))\\n    : fallback;\\n}\\n\\nexport function loadSavedSettings(): GameSettings {\\n  try {\\n    const raw =\\n      window.localStorage.getItem(SETTINGS_STORAGE_KEY) ??\\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY);\\n    if (!raw) return { ...DEFAULT_SETTINGS };\\n    const parsed = JSON.parse(raw) as Partial<GameSettings>;\\n    const validQuality =\\n      parsed.graphicsQuality === \'low\' ||\\n      parsed.graphicsQuality === \'medium\' ||\\n      parsed.graphicsQuality === \'high\' ||\\n      parsed.graphicsQuality === \'ultra\'\\n        ? parsed.graphicsQuality\\n        : DEFAULT_SETTINGS.graphicsQuality;\\n\\n    const boundarySensitivity = clampNumber(\\n      parsed.boundarySensitivity,\\n      0.15,\\n      1.0,\\n      DEFAULT_SETTINGS.boundarySensitivity,\\n    );\\n    const maxSensitivity = Math.max(\\n      boundarySensitivity + 0.2,\\n      clampNumber(parsed.maxSensitivity, 1.2, 3.5, DEFAULT_SETTINGS.maxSensitivity),\\n    );\\n\\n    return {\\n      ...DEFAULT_SETTINGS,\\n      ...parsed,\\n      mouseSensitivity: clampNumber(\\n        parsed.mouseSensitivity,\\n        0.3,\\n        2.5,\\n        DEFAULT_SETTINGS.mouseSensitivity,\\n      ),\\n      boundarySensitivity,\\n      maxSensitivity,\\n      accelerationDistance: clampNumber(\\n        parsed.accelerationDistance,\\n        80,\\n        500,\\n        DEFAULT_SETTINGS.accelerationDistance,\\n      ),\\n      responseCurve: clampNumber(parsed.responseCurve, 1.0, 3.5, DEFAULT_SETTINGS.responseCurve),\\n      aimBoundarySize: clampNumber(\\n        parsed.aimBoundarySize,\\n        0.15,\\n        0.38,\\n        DEFAULT_SETTINGS.aimBoundarySize,\\n      ),\\n      graphicsQuality: validQuality,\\n      resolutionScale: clampNumber(\\n        parsed.resolutionScale,\\n        0.65,\\n        1.0,\\n        DEFAULT_SETTINGS.resolutionScale,\\n      ),\\n      drawDistance: clampNumber(parsed.drawDistance, 2000, 5200, DEFAULT_SETTINGS.drawDistance),\\n      showPerfOverlay: import.meta.env.DEV ? Boolean(parsed.showPerfOverlay) : false,\\n    };\\n  } catch {\\n    return { ...DEFAULT_SETTINGS };\\n  }\\n}\", \"StartLine\":155, \"TargetContent\":\"export const DEFAULT_SETTINGS: GameSettings = {\\n  mouseSensitivity: 1.0,\\n  invertY: false,\\n  cameraDistance: 9.8,\\n  cameraSensitivity: 1.0,\\n  masterVolume: 0.65,\\n  graphicsQuality: \'high\',\\n  resolutionScale: 1.0,\\n  shadowQuality: \'medium\',\\n  particleQuality: \'high\',\\n  environmentDetail: \'high\',\\n  drawDistance: 4200,\\n  antialias: true,\\n  postGlowEnabled: true,\\n  showPerfOverlay: false,\\n};\\n\\nconst SETTINGS_STORAGE_KEY = \'starfall.settings.v2\';\\nconst LEGACY_SETTINGS_KEY = \'starfall.settings.v1\';\\n\\nexport function loadSavedSettings(): GameSettings {\\n  try {\\n    const raw =\\n      window.localStorage.getItem(SETTINGS_STORAGE_KEY) ??\\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY);\\n    if (!raw) return { ...DEFAULT_SETTINGS };\\n    const parsed = JSON.parse(raw) as Partial<GameSettings>;\\n    const validQuality =\\n      parsed.graphicsQuality === \'low\' ||\\n      parsed.graphicsQuality === \'medium\' ||\\n      parsed.graphicsQuality === \'high\' ||\\n      parsed.graphicsQuality === \'ultra\'\\n        ? parsed.graphicsQuality\\n        : DEFAULT_SETTINGS.graphicsQuality;\\n\\n    return {\\n      ...DEFAULT_SETTINGS,\\n      ...parsed,\\n      graphicsQuality: validQuality,\\n      resolutionScale:\\n        typeof parsed.resolutionScale === \'number\' && Number.isFinite(parsed.resolutionScale)\\n          ? Math.max(0.65, Math.min(1.0, parsed.resolutionScale))\\n          : DEFAULT_SETTINGS.resolutionScale,\\n      drawDistance:\\n        typeof parsed.drawDistance === \'number\' && Number.isFinite(parsed.drawDistance)\\n          ? Math.max(2000, Math.min(5200, parsed.drawDistance))\\n          : DEFAULT_SETTINGS.drawDistance,\\n      showPerfOverlay: import.meta.env.DEV ? Boolean(parsed.showPerfOverlay) : false,\\n    };\\n  } catch {\\n    return { ...DEFAULT_SETTINGS };\\n  }\\n}\", \"TargetFile\":\"/src/config/ships.ts\", \"toolAction\":\"Adding progressive steering settings defaults\", \"toolSummary\":\"Add progressive steering defaults to ships.ts\"}"
      original_name: "replace_file_content"
    }
