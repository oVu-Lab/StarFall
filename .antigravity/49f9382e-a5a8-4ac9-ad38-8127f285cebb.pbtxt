            lines {
              text: "  private firePlayerWeapon(flight: FlightController): void {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const weapon = this.playerWeapon;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const minInterval = 1 / Math.max(0.5, weapon.fireRate);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.playerWeaponCooldown = minInterval;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Alternate left & right wing cannon barrels"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const idx = this.playerMuzzleIndex % weapon.muzzleOffsets.length;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.playerMuzzleIndex = (this.playerMuzzleIndex + 1) % weapon.muzzleOffsets.length;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const offset = weapon.muzzleOffsets[idx];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (idx === 0) this.muzzleFlashLeft = 0.065;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    else this.muzzleFlashRight = 0.065;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // World origin of the active cannon barrel"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    _muzzleLocal.set(offset[0], offset[1], offset[2]).applyQuaternion(flight.quaternion);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    _muzzleWorld.copy(flight.position).add(_muzzleLocal);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Compute exact 3D convergence target along the player\'s true aiming ray"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // If a primary target is near the reticle, converge at that target\'s distance so bolts cross dead-on!"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let convergeDist = weapon.convergenceDistance;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (this.primaryTargetId) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const target = this.enemies.find("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        (e) => e.id === this.primaryTargetId && e.active && !e.health.isDestroyed,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (target) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const d = flight.position.distanceTo(target.position);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (d > 35 && d < 520) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          convergeDist = d;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    flight.getAimTargetPoint(_aimTarget, convergeDist);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    _fireDir.subVectors(_aimTarget, _muzzleWorld).normalize();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Subtle micro-spread"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (weapon.spreadRad > 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      _rightVec.set(1, 0, 0).applyQuaternion(flight.quaternion);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      _upVec.set(0, 1, 0).applyQuaternion(flight.quaternion);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      _fireDir"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        .addScaledVector(_rightVec, (Math.random() - 0.5) * weapon.spreadRad)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        .addScaledVector(_upVec, (Math.random() - 0.5) * weapon.spreadRad)"
