        target_content: "  // Recent smoothed per-event deltas used solely to identify OS/Chromium edge cursor-warp jumps\n  private recentDeltaX = 0;\n  private recentDeltaY = 0;\n  private lastMoveTimestamp = 0;\n  private lastRawMovementX = 0;\n  private lastRawMovementY = 0;\n  private warpSpikesFiltered = 0;\n\n  private readonly snapshot: InputSnapshot = {\n    forward: false,\n    backward: false,\n    rollLeft: false,\n    rollRight: false,\n    boost: false,\n    firePrimary: false,\n    keyPitchUp: false,\n    keyPitchDown: false,\n    keyYawLeft: false,\n    keyYawRight: false,\n    mouseDeltaX: 0,\n    mouseDeltaY: 0,\n    pointerLocked: false,\n  };\n\n  public attach(callbacks: InputCallbacks): void {\n    if (this.attached) {\n      this.detach();\n    }\n    this.callbacks = callbacks;\n    window.addEventListener(\'keydown\', this.handleKeyDown);\n    window.addEventListener(\'keyup\', this.handleKeyUp);\n    window.addEventListener(\'mousemove\', this.handleMouseMove);\n    window.addEventListener(\'mousedown\', this.handleMouseDown);\n    window.addEventListener(\'mouseup\', this.handleMouseUp);\n    window.addEventListener(\'blur\', this.handleBlur);\n    document.addEventListener(\'pointerlockchange\', this.handlePointerLockChange);\n    document.addEventListener(\'pointerlockerror\', this.handlePointerLockError);\n    this.attached = true;\n  }\n\n  public detach(): void {\n    if (!this.attached) return;\n    window.removeEventListener(\'keydown\', this.handleKeyDown);\n    window.removeEventListener(\'keyup\', this.handleKeyUp);\n    window.removeEventListener(\'mousemove\', this.handleMouseMove);\n    window.removeEventListener(\'mousedown\', this.handleMouseDown);\n    window.removeEventListener(\'mouseup\', this.handleMouseUp);\n    window.removeEventListener(\'blur\', this.handleBlur);\n    document.removeEventListener(\'pointerlockchange\', this.handlePointerLockChange);\n    document.removeEventListener(\'pointerlockerror\', this.handlePointerLockError);\n    this.attached = false;\n    if (this.isLockOwned()) {\n      this.exitPointerLock();\n    }\n    this.keys.clear();\n    this.mouseFireHeld = false;\n    this.resetDeltas();\n  }\n\n  public setLockTarget(el: HTMLElement | null): void {\n    this.lockTarget = el;\n    this.pointerLocked = this.isLockOwned();\n  }\n\n  public setActive(isActive: boolean): void {\n    this.active = isActive;\n    if (!isActive) {\n      this.keys.clear();\n      this.mouseFireHeld = false;\n      this.resetDeltas();\n    }\n  }\n\n  private isLockOwned(): boolean {\n    if (typeof document === \'undefined\' || !this.lockTarget) return false;\n    return document.pointerLockElement === this.lockTarget;\n  }\n\n  /**\n   * Synchronously requests Pointer Lock on the dedicated game canvas within a user gesture.\n   * Uses standard `requestPointerLock()` directly to avoid async `NotSupportedError`\n   * rejections and spurious `pointerlockerror` events from unsupported options.\n   */\n  public requestPointerLock(): void {\n    const target = this.lockTarget;\n    if (!target || typeof target.requestPointerLock !== \'function\') return;\n    if (document.pointerLockElement === target) {\n      this.pointerLocked = true;\n      return;\n    }\n\n    try {\n      const maybePromise = target.requestPointerLock() as unknown as Promise<void> | undefined;\n      if (maybePromise && typeof maybePromise.catch === \'function\') {\n        maybePromise.catch(() => {\n          // Gracefully ignore rejected lock requests (e.g., sandboxed frame or rapid unlock)\n        });\n      }\n    } catch {\n      // Ignore sandboxed pointer lock exceptions\n    }\n  }\n\n  public exitPointerLock(): void {\n    if (typeof document !== \'undefined\' && document.pointerLockElement && typeof document.exitPointerLock === \'function\') {\n      try {\n        document.exitPointerLock();\n      } catch {\n        // Ignore\n      }\n    }\n  }\n\n  public isPointerLocked(): boolean {\n    return this.isLockOwned();\n  }\n\n  public getDiagnostics(): InputDiagnostics {\n    return {\n      pointerLocked: this.pointerLocked,\n      lockOwnedByTarget: this.isLockOwned(),\n      pointerLockElementTag:\n        typeof document !== \'undefined\' && document.pointerLockElement\n          ? document.pointerLockElement.tagName\n          : null,\n      lastMovementX: this.lastRawMovementX,\n      lastMovementY: this.lastRawMovementY,\n      accumulatedX: this.mouseDeltaX,\n      accumulatedY: this.mouseDeltaY,\n      warpSpikesFiltered: this.warpSpikesFiltered,\n    };\n  }\n\n  /**\n   * Reads current key/button states and consumes accumulated relative mouse deltas for one frame.\n   */\n  public consumeSnapshot(): InputSnapshot {\n    const lockOwned = this.isLockOwned();\n    this.pointerLocked = lockOwned;\n\n    this.snapshot.forward = this.keys.has(\'KeyW\');\n    this.snapshot.backward = this.keys.has(\'KeyS\');\n    this.snapshot.rollLeft = this.keys.has(\'KeyA\');\n    this.snapshot.rollRight = this.keys.has(\'KeyD\');\n    this.snapshot.boost = this.keys.has(\'ShiftLeft\') || this.keys.has(\'ShiftRight\');\n    this.snapshot.firePrimary = this.mouseFireHeld || this.keys.has(\'Space\');\n    this.snapshot.keyPitchUp = this.keys.has(\'ArrowDown\');\n    this.snapshot.keyPitchDown = this.keys.has(\'ArrowUp\');\n    this.snapshot.keyYawLeft = this.keys.has(\'ArrowLeft\');\n    this.snapshot.keyYawRight = this.keys.has(\'ArrowRight\');\n    this.snapshot.mouseDeltaX = lockOwned ? this.mouseDeltaX : 0;\n    this.snapshot.mouseDeltaY = lockOwned ? this.mouseDeltaY : 0;\n    this.snapshot.pointerLocked = lockOwned;\n\n    this.mouseDeltaX = 0;\n    this.mouseDeltaY = 0;\n    return this.snapshot;\n  }\n\n  private resetDeltas(): void {\n    this.mouseDeltaX = 0;\n    this.mouseDeltaY = 0;\n    this.recentDeltaX = 0;\n    this.recentDeltaY = 0;\n    this.lastMoveTimestamp = 0;\n  }\n\n  private isAnomalousWarpJump(raw: number, recent: number, recentActive: boolean): boolean {\n    const absRaw = Math.abs(raw);\n    if (absRaw === 0) return false;\n    // Physical single-event hardware guard (catches full/half-viewport cursor-warp jumps)\n    if (absRaw > 350) return true;\n    // Opposite-sign warp-to-center spike during sustained directional mouse motion\n    if (\n      recentActive &&\n      absRaw >= 90 &&\n      Math.abs(recent) >= 5 &&\n      raw * recent < 0 &&\n      absRaw > Math.abs(recent) * 3.2\n    ) {\n      return true;\n    }\n    return false;\n  }\n\n  private handleKeyDown = (e: KeyboardEvent): void => {\n    if (e.code === \'Escape\') {\n      if (this.active) {\n        e.preventDefault();\n        this.exitPointerLock();\n        if (this.active) {\n          this.callbacks.onPauseRequested?.();\n        }\n      }\n      return;\n    }\n\n    if (e.code === \'KeyH\' && this.active && !e.repeat) {\n      this.callbacks.onToggleHudHints?.();\n      return;\n    }\n\n    if (import.meta.env.DEV && e.code === \'F3\' && !e.repeat) {\n      e.preventDefault();\n      this.callbacks.onTogglePerfMonitor?.();\n      return;\n    }\n\n    if (!this.active) return;\n\n    if (\n      e.code === \'KeyW\' ||\n      e.code === \'KeyS\' ||\n      e.code === \'KeyA\' ||\n      e.code === \'KeyD\' ||\n      e.code === \'ShiftLeft\' ||\n      e.code === \'ShiftRight\' ||\n      e.code === \'Space\' ||\n      e.code === \'ArrowUp\' ||\n      e.code === \'ArrowDown\' ||\n      e.code === \'ArrowLeft\' ||\n      e.code === \'ArrowRight\'\n    ) {\n      if (e.code === \'Space\') e.preventDefault();\n      this.keys.add(e.code);\n    }\n  };\n\n  private handleKeyUp = (e: KeyboardEvent): void => {\n    this.keys.delete(e.code);\n  };\n\n  private handleMouseMove = (e: MouseEvent): void => {\n    if (!this.active || !this.isLockOwned()) return;\n\n    const rawX = Number.isFinite(e.movementX) ? e.movementX : 0;\n    const rawY = Number.isFinite(e.movementY) ? e.movementY : 0;\n    this.lastRawMovementX = rawX;\n    this.lastRawMovementY = rawY;\n\n    const now = typeof performance !== \'undefined\' ? performance.now() : Date.now();\n    const recentActive = this.lastMoveTimestamp > 0 && now - this.lastMoveTimestamp < 120;\n    if (!recentActive) {\n      this.recentDeltaX = 0;\n      this.recentDeltaY = 0;\n    }\n\n    const warpX = this.isAnomalousWarpJump(rawX, this.recentDeltaX, recentActive);\n    const warpY = this.isAnomalousWarpJump(rawY, this.recentDeltaY, recentActive);\n\n    if (warpX || warpY) {\n      this.warpSpikesFiltered += 1;\n    }\n\n    if (!warpX && rawX !== 0) {\n      this.mouseDeltaX += rawX;\n      this.recentDeltaX = this.recentDeltaX === 0 ? rawX : this.recentDeltaX * 0.55 + rawX * 0.45;\n    }\n    if (!warpY && rawY !== 0) {\n      this.mouseDeltaY += rawY;\n      this.recentDeltaY = this.recentDeltaY === 0 ? rawY : this.recentDeltaY * 0.55 + rawY * 0.45;\n    }\n\n    if (!warpX && !warpY) {\n      this.lastMoveTimestamp = now;\n    }\n  };"
