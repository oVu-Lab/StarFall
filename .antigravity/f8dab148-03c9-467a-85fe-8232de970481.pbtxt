    description: "cat << \'EOF\' > /tmp/verify_virtual_joystick.mjs\nimport { spawn } from \'node:child_process\';\nimport fs from \'node:fs\';\n\nconst CHROME_BIN = \'/ms-playwright/chrome-headless-shell-linux64/chrome-headless-shell\';\nconst PORT = 9223;\nconst URL = \'http://localhost:3000\';\n\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\n\nconst chrome = spawn(CHROME_BIN, [\n  `--remote-debugging-port=${PORT}`,\n  \'--headless=new\',\n  \'--no-sandbox\',\n  \'--disable-gpu-sandbox\',\n  \'--use-gl=angle\',\n  \'--use-angle=swiftshader\',\n  \'--enable-webgl\',\n  \'--ignore-gpu-blocklist\',\n  \'--window-size=1280,720\',\n  \'about:blank\',\n], { stdio: \'ignore\' });\n\nasync function waitForCdp() {\n  for (let i = 0; i < 40; i++) {\n    try {\n      const res = await fetch(`http://127.0.0.1:${PORT}/json/list`);\n      const targets = await res.json();\n      const page = targets.find((t) => t.type === \'page\');\n      if (page?.webSocketDebuggerUrl) return page.webSocketDebuggerUrl;\n    } catch {}\n    await sleep(200);\n  }\n  throw new Error(\'CDP failed to start\');\n}\n\nclass CDPClient {\n  constructor(wsUrl) {\n    this.ws = new WebSocket(wsUrl);\n    this.id = 0;\n    this.pending = new Map();\n    this.events = [];\n    this.ready = new Promise((resolve, reject) => {\n      this.ws.addEventListener(\'open\', resolve);\n      this.ws.addEventListener(\'error\', reject);\n    });\n    this.ws.addEventListener(\'message\', (evt) => {\n      const msg = JSON.parse(evt.data);\n      if (msg.id) {\n        const p = this.pending.get(msg.id);\n        if (p) {\n          this.pending.delete(msg.id);\n          if (msg.error) p.reject(new Error(msg.error.message));\n          else p.resolve(msg.result);\n        }\n      } else {\n        this.events.push(msg);\n      }\n    });\n  }\n  async send(method, params = {}) {\n    await this.ready;\n    const id = ++this.id;\n    return new Promise((resolve, reject) => {\n      this.pending.set(id, { resolve, reject });\n      this.ws.send(JSON.stringify({ id, method, params }));\n    });\n  }\n  async eval(expression) {\n    const res = await this.send(\'Runtime.evaluate\', {\n      expression,\n      awaitPromise: true,\n      returnByValue: true,\n    });\n    if (res.exceptionDetails) {\n      throw new Error(`Eval error: ${res.exceptionDetails.text} ${JSON.stringify(res.exceptionDetails.exception)}`);\n    }\n    return res.result?.value;\n  }\n  async screenshot(path) {\n    const { data } = await this.send(\'Page.captureScreenshot\', { format: \'png\' });\n    fs.writeFileSync(path, Buffer.from(data, \'base64\'));\n  }\n  close() {\n    this.ws.close();\n  }\n}\n\nlet cdp;\ntry {\n  const wsUrl = await waitForCdp();\n  cdp = new CDPClient(wsUrl);\n  await cdp.send(\'Page.enable\');\n  await cdp.send(\'Runtime.enable\');\n  await cdp.send(\'Emulation.setDeviceMetricsOverride\', {\n    width: 1280,\n    height: 720,\n    deviceScaleFactor: 1,\n    mobile: false,\n  });\n\n  const consoleErrors = [];\n  const origPush = cdp.events.push.bind(cdp.events);\n  cdp.events.push = (msg) => {\n    if (msg.method === \'Runtime.exceptionThrown\') {\n      consoleErrors.push(msg.params.exceptionDetails?.text || \'Runtime exception\');\n    }\n    if (msg.method === \'Runtime.consoleAPICalled\' && msg.params.type === \'error\') {\n      const txt = msg.params.args?.map((a) => a.value || a.description).join(\' \') || \'\';\n      if (!txt.includes(\'WebSocket\') && !txt.includes(\'HMR\')) {\n        consoleErrors.push(txt);\n      }\n    }\n    return origPush(msg);\n  };\n\n  await cdp.send(\'Page.navigate\', { url: URL });\n  await sleep(2200);\n\n  // Clear localStorage so we verify fresh defaults\n  await cdp.eval(`window.localStorage.clear()`);\n  await cdp.send(\'Page.reload\');\n  await sleep(2200);\n\n  const report = {};\n\n  // 1. Open Settings & verify all 6 Virtual Joystick controls + Restore Defaults\n  await cdp.eval(`(() => {\n    const btns = Array.from(document.querySelectorAll(\'button\'));\n    const settingsBtn = btns.find(b => b.textContent?.includes(\'Settings\'));\n    if (!settingsBtn) throw new Error(\'Settings button not found\');\n    settingsBtn.click();\n  })()`);\n  await sleep(500);\n\n  const settingsCheck = await cdp.eval(`(() => {\n    const ids = [\n      \'setting-mouse-sens\',\n      \'setting-joystick-radius\',\n      \'setting-deadzone\',\n      \'setting-yaw-sens\',\n      \'setting-pitch-sens\',\n      \'setting-response-curve\'\n    ];\n    const found = Object.fromEntries(ids.map(id => {\n      const el = document.getElementById(id);\n      return [id, el ? Number(el.value) : null];\n    }));\n    const restoreBtn = Array.from(document.querySelectorAll(\'button\')).find(b => b.textContent?.includes(\'Restore Defaults\'));\n    return { found, hasRestoreDefaults: Boolean(restoreBtn) };\n  })()`);\n  report.settingsInitial = settingsCheck;\n  await cdp.screenshot(\'/tmp/starfall_settings.png\');\n\n  // Test modifying a slider and clicking Restore Defaults\n  await cdp.eval(`(() => {\n    const slider = document.getElementById(\'setting-mouse-sens\');\n    const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, \'value\').set;\n    setter.call(slider, \'1.85\');\n    slider.dispatchEvent(new Event(\'input\', { bubbles: true }));\n    slider.dispatchEvent(new Event(\'change\', { bubbles: true }));\n  })()`);\n  await sleep(200);\n  const modifiedVal = await cdp.eval(`window.__STARFALL_DIAG__.getSettings().mouseSensitivity`);\n  await cdp.eval(`(() => {\n    const restoreBtn = Array.from(document.querySelectorAll(\'button\')).find(b => b.textContent?.includes(\'Restore Defaults\'));\n    restoreBtn.click();\n  })()`);\n  await sleep(200);\n  const restoredSettings = await cdp.eval(`window.__STARFALL_DIAG__.getSettings()`);\n  report.settingsRestoreTest = {\n    modifiedMouseSensitivity: modifiedVal,\n    restoredMouseSensitivity: restoredSettings.mouseSensitivity,\n    restoredDefaults: {\n      mouseSensitivity: restoredSettings.mouseSensitivity,\n      joystickRadius: restoredSettings.joystickRadius,\n      deadzone: restoredSettings.deadzone,\n      yawSensitivity: restoredSettings.yawSensitivity,\n      pitchSensitivity: restoredSettings.pitchSensitivity,\n      responseCurve: restoredSettings.responseCurve,\n    },\n  };\n\n  // Close settings and launch Mission 01\n  await cdp.eval(`(() => {\n    const backBtn = Array.from(document.querySelectorAll(\'button\')).find(b => b.textContent?.trim() === \'Back\');\n    if (backBtn) backBtn.click();\n  })()`);\n  await sleep(400);\n\n  await cdp.eval(`(() => {\n    const btns = Array.from(document.querySelectorAll(\'button\'));\n    const playBtn = btns.find(b => b.textContent?.includes(\'Campaign\') || b.textContent?.includes(\'Launch\') || b.textContent?.includes(\'Start\'));\n    if (!playBtn) throw new Error(\'Campaign/Start button not found: \' + btns.map(b => b.textContent).join(\' | \'));\n    playBtn.click();\n  })()`);\n  await sleep(600);\n\n  await cdp.eval(`(() => {\n    const btns = Array.from(document.querySelectorAll(\'button\'));\n    const launchBtn = btns.find(b => b.textContent?.includes(\'Launch\'));\n    if (launchBtn) launchBtn.click();\n  })()`);\n\n  // Wait for phase === \'playing\'\n  for (let i = 0; i < 40; i++) {\n    const phase = await cdp.eval(`window.__STARFALL_DIAG__?.getPhase()`);\n    if (phase === \'playing\') break;\n    await sleep(250);\n  }\n  await sleep(800);\n  const phaseAfterLaunch = await cdp.eval(`window.__STARFALL_DIAG__.getPhase()`);\n  report.phaseAfterLaunch = phaseAfterLaunch;\n\n  // Test Pointer Lock API engagement on canvas click\n  const pointerLockTest = await cdp.eval(`(() => {\n    const canvas = document.querySelector(\'canvas\');\n    if (!canvas) throw new Error(\'Canvas not found\');\n    let requestCalled = false;\n    const origReq = canvas.requestPointerLock.bind(canvas);\n    canvas.requestPointerLock = function() {\n      requestCalled = true;\n      return origReq();\n    };\n    canvas.dispatchEvent(new MouseEvent(\'mousedown\', { button: 0, bubbles: true }));\n    const realLocked = document.pointerLockElement === canvas;\n    return { requestCalled, realLocked, hasPointerLockApi: typeof canvas.requestPointerLock === \'function\' };\n  })()`);\n  report.pointerLockClickCheck = pointerLockTest;\n\n  // In headless Chromium without an OS pointer, document.pointerLockElement may remain null;\n  // if so, bind a faithful pointerLockElement getter for the canvas so InputManager\'s real\n  // handleMouseMove listener processes every dispatched relative MouseEvent(movementX, movementY) end-to-end!\n  await cdp.eval(`(() => {\n    const canvas = document.querySelector(\'canvas\');\n    if (document.pointerLockElement !== canvas) {\n      Object.defineProperty(document, \'pointerLockElement\', {\n        configurable: true,\n        get: () => canvas,\n      });\n      document.dispatchEvent(new Event(\'pointerlockchange\'));\n    }\n  })()`);\n  await sleep(300);\n\n  const lockDiag = await cdp.eval(`window.__STARFALL_DIAG__.getInput().getDiagnostics()`);\n  report.inputLockDiagnostics = lockDiag;\n\n  // Helper to dispatch relative mouse delta through real window mousemove -> InputManager -> GameScene useFrame -> FlightController\n  async function sendMouseDelta(dx, dy, waitFramesMs = 140) {\n    await cdp.eval(`(() => {\n      const evt = new MouseEvent(\'mousemove\', { bubbles: true, cancelable: true });\n      Object.defineProperty(evt, \'movementX\', { value: ${dx} });\n      Object.defineProperty(evt, \'movementY\', { value: ${dy} });\n      window.dispatchEvent(evt);\n    })()`);\n    await sleep(waitFramesMs);\n  }\n\n  async function readState() {\n    return cdp.eval(`(() => {\n      const f = window.__STARFALL_DIAG__.getFlight();\n      const t = window.__STARFALL_DIAG__.getTelemetry();\n      const frame = document.querySelector(\'[data-testid=\"aim-boundary-frame\"]\');\n      const cursor = document.querySelector(\'[data-testid=\"virtual-mouse-cursor\"]\');\n      return {\n        joystickX: Number(f.joystickX.toFixed(2)),\n        joystickY: Number(f.joystickY.toFixed(2)),\n        radial: Number(t.joystickRadialMagnitude.toFixed(4)),\n        steerX: Number(t.steeringOutputX.toFixed(4)),\n        steerY: Number(t.steeringOutputY.toFixed(4)),\n        zone: t.steeringZone,\n        yawVelocity: Number(f.yawVelocity.toFixed(4)),\n        pitchVelocity: Number(f.pitchVelocity.toFixed(4)),\n        headingDeg: Number(t.headingDeg.toFixed(2)),\n        pitchDeg: Number(t.pitchDeg.toFixed(2)),\n        fps: t.fps,\n        frameTimeMs: Number(t.frameTimeMs.toFixed(1)),\n        boundary: {\n          widthPx: Number(f.aimBoundary.widthPx.toFixed(2)),\n          heightPx: Number(f.aimBoundary.heightPx.toFixed(2)),\n          halfW: Number(f.aimBoundary.halfW.toFixed(2)),\n          halfH: Number(f.aimBoundary.halfH.toFixed(2)),\n          cornerRadiusPx: Number(f.aimBoundary.cornerRadiusPx.toFixed(2)),\n          widthFraction: Number(f.aimBoundary.widthFraction.toFixed(4)),\n          heightFraction: Number(f.aimBoundary.heightFraction.toFixed(4)),\n          domWidthPx: frame ? Number(frame.dataset.widthPx) : null,\n          domHeightPx: frame ? Number(frame.dataset.heightPx) : null,\n          domWidthFrac: frame ? Number(frame.dataset.widthFraction) : null,\n          domHeightFrac: frame ? Number(frame.dataset.heightFraction) : null,\n          domShape: frame ? frame.dataset.shape : null,\n        },\n        cursorDataset: cursor ? {\n          zone: cursor.dataset.steeringZone,\n          radial: cursor.dataset.radial,\n          screenX: cursor.dataset.screenX,\n          screenY: cursor.dataset.screenY,\n        } : null,\n      };\n    })()`);\n  }\n\n  // Reset flight to known neutral state for clean measurements\n  await cdp.eval(`window.__STARFALL_DIAG__.getFlight().reset()`);\n  await sleep(250);\n\n  // Test 2: Center deadzone prevents drift (on 1280x720, halfW=192, deadzone=6% => 11.52px)\n  await sendMouseDelta(6, -3, 350);\n  const deadzoneState = await readState();\n  report.test2_deadzone = deadzoneState;\n\n  // Test 1: Small mouse movement produces precise steering\n  await cdp.eval(`window.__STARFALL_DIAG__.getFlight().reset()`);\n  await sleep(150);\n  await sendMouseDelta(32, 0, 350);\n  const smallSteerState = await readState();\n  report.test1_smallPrecise = smallSteerState;\n\n  // Test 3: Progressive monotonic curve across 25%, 50%, 75%, 100% of halfW (192px)\n  const sweep = [];\n  for (const frac of [0.25, 0.5, 0.75, 1.0]) {\n    await cdp.eval(`window.__STARFALL_DIAG__.getFlight().reset()`);\n    await sleep(120);\n    await sendMouseDelta(Math.round(192 * frac), 0, 380);\n    const st = await readState();\n    sweep.push({ frac, joystickX: st.joystickX, radial: st.radial, steerX: st.steerX, yawVelocity: st.yawVelocity, zone: st.zone });\n  }\n  report.test3_progressiveSweep = sweep;\n\n  // Screenshot during active mid-deflection steering\n  await cdp.eval(`window.__STARFALL_DIAG__.getFlight().reset()`);\n  await sleep(120);\n  await sendMouseDelta(120, -45, 250);\n  await cdp.screenshot(\'/tmp/starfall_flight_hud.png\');\n\n  // Test 4, 5 & 7: Pushing at & far beyond joystick boundary (simulating past physical display edge!)\n  await cdp.eval(`window.__STARFALL_DIAG__.getFlight().reset()`);\n  await sleep(120);\n  await sendMouseDelta(220, 0, 350);\n  const atBoundary = await readState();\n\n  // Push another +1400px in 14 bursts (exceeding 1280px screen width!) while holding outward\n  const headingStart = atBoundary.headingDeg;\n  for (let i = 0; i < 10; i++) {\n    await sendMouseDelta(140, 0, 80);\n  }\n  const farBeyondBoundary = await readState();\n  // Measure continuous turning heading delta (mod 360)\n  const headingDelta = (farBeyondBoundary.headingDeg - headingStart + 360) % 360;\n  report.test4_5_7_boundaryAndContinuousTurn = {\n    atBoundary: {\n      joystickX: atBoundary.joystickX,\n      radial: atBoundary.radial,\n      steerX: atBoundary.steerX,\n      yawVelocity: atBoundary.yawVelocity,\n      zone: atBoundary.zone,\n    },\n    afterPlus1400pxOutward: {\n      joystickX: farBeyondBoundary.joystickX,\n      radial: farBeyondBoundary.radial,\n      steerX: farBeyondBoundary.steerX,\n      yawVelocity: farBeyondBoundary.yawVelocity,\n      zone: farBeyondBoundary.zone,\n      headingAdvanceDeg: Number(headingDelta.toFixed(1)),\n    },\n  };\n\n  // Test 6: Moving back inward immediately reduces steering smoothly (zero hidden excess lag!)\n  await sendMouseDelta(-60, 0, 220);\n  const inwardStep1 = await readState();\n  await sendMouseDelta(-132, 0, 420);\n  const backToCenter = await readState();\n  report.test6_smoothReturn = {\n    afterMinus60px: {\n      joystickX: inwardStep1.joystickX,\n      radial: inwardStep1.radial,\n      steerX: inwardStep1.steerX,\n      yawVelocity: inwardStep1.yawVelocity,\n      zone: inwardStep1.zone,\n    },\n    backAtCenter: {\n      joystickX: backToCenter.joystickX,\n      radial: backToCenter.radial,\n      steerX: backToCenter.steerX,\n      yawVelocity: backToCenter.yawVelocity,\n      zone: backToCenter.zone,\n    },\n  };\n\n  // Independent Pitch vs Yaw + Rounded Corner Projection check\n  await cdp.eval(`window.__STARFALL_DIAG__.getFlight().reset()`);\n  await sleep(120);\n  await sendMouseDelta(0, -160, 380);\n  const fullPitchState = await readState();\n\n  await cdp.eval(`window.__STARFALL_DIAG__.getFlight().reset()`);\n  await sleep(120);\n  await sendMouseDelta(240, 180, 260);\n  const cornerState = await readState();\n  report.pitchAndCornerCheck = {\n    fullPitch: {\n      joystickY: fullPitchState.joystickY,\n      radial: fullPitchState.radial,\n      steerY: fullPitchState.steerY,\n      pitchVelocity: fullPitchState.pitchVelocity,\n      zone: fullPitchState.zone,\n    },\n    roundedCorner: {\n      joystickX: cornerState.joystickX,\n      joystickY: cornerState.joystickY,\n      radial: cornerState.radial,\n      steerMag: Number(Math.hypot(cornerState.steerX, cornerState.steerY).toFixed(4)),\n      zone: cornerState.zone,\n    },\n  };\n\n  // Test 11: Viewport resizing preserves exact 30% x 35% boundary geometry\n  const viewportChecks = [];\n  for (const [w, h] of [[1280, 720], [1920, 1080], [1024, 768], [800, 600]]) {\n    await cdp.send(\'Emulation.setDeviceMetricsOverride\', {\n      width: w,\n      height: h,\n      deviceScaleFactor: 1,\n      mobile: false,\n    });\n    await sleep(350);\n    const st = await readState();\n    viewportChecks.push({\n      viewport: `${w}x${h}`,\n      expectedW: Number((w * 0.3).toFixed(2)),\n      expectedH: Number((h * 0.35).toFixed(2)),\n      engineW: st.boundary.widthPx,\n      engineH: st.boundary.heightPx,\n      domW: st.boundary.domWidthPx,\n      domH: st.boundary.domHeightPx,\n      domFracW: st.boundary.domWidthFrac,\n      domFracH: st.boundary.domHeightFrac,\n      shape: st.boundary.domShape,\n    });\n  }\n  report.test11_viewportResizing = viewportChecks;\n\n  // Test 12: Performance & console error cleanliness\n  report.test12_consoleErrors = consoleErrors;\n  report.test12_telemetrySample = {\n    fps: backToCenter.fps,\n    frameTimeMs: backToCenter.frameTimeMs,\n  };\n\n  console.log(JSON.stringify(report, null, 2));\n} finally {\n  cdp?.close();\n  chrome.kill(\'SIGTERM\');\n}\nEOF\nnode /tmp/verify_virtual_joystick.mjs\n"
    title: "Run Chromium flight tests"
