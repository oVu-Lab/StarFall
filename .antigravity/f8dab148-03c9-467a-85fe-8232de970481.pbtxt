            }
            lines {
              text: "  baseWidthFraction: number = STEERING_CONFIG.aimBoundaryWidth,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  baseHeightFraction: number = STEERING_CONFIG.aimBoundaryHeight,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  cornerRadiusRatio: number = STEERING_CONFIG.aimBoundaryCornerRadius,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  out: RoundedRectBoundary = createRoundedRectBoundary(),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "): RoundedRectBoundary {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const vw = Math.max(1, Number.isFinite(viewportWidth) ? viewportWidth : 1280);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const vh = Math.max(1, Number.isFinite(viewportHeight) ? viewportHeight : 720);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const radiusScale = THREE.MathUtils.clamp("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    joystickRadius,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    STEERING_BOUNDS.joystickRadius.min,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    STEERING_BOUNDS.joystickRadius.max,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const wf = THREE.MathUtils.clamp("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    widthFraction,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    baseWidthFraction * radiusScale,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    STEERING_BOUNDS.aimBoundaryWidth.min,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    STEERING_BOUNDS.aimBoundaryWidth.max,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  );"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const hf = THREE.MathUtils.clamp("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    heightFraction,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    baseHeightFraction * radiusScale,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    STEERING_BOUNDS.aimBoundaryHeight.min,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
