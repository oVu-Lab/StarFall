            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * Integrates relative mouse delta onto an unconstrained virtual axis coordinate."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * - Inside the rounded-rectangle boundary (excessPx == 0): pure 1:1 relative displacement."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * - Pushing outward beyond the boundary: continuous with zero hard mouse input cutoff."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " *   Past `softOutwardCompressionStart * S` (where f(e) > 0.94), applies smooth soft compression"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " *   so indefinite mouse movement stays responsive without accumulating runaway unwind lag."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * - Pulling inward from overdrive excess: smoothly accelerates excess retraction back to the"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " *   boundary edge while applying any remaining inward travel 1:1 inside the precision zone."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "function accumulateAxisDisplacement("
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  rawCoord: number,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  clampedCoord: number,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  excessPx: number,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  stepPx: number,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  accelDist: number,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Controlled angular acceleration + frame-rate-independent damping step."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - Smoothly tracks requested angular velocity with crisp responsiveness and low latency."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - Caps maximum angular acceleration per frame so abrupt full-stick slams accelerate smoothly"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   without snapping jerk, while small corrections remain immediate and un-clipped."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - Applies extra stopping damping when decelerating toward zero or reversing direction so"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " *   returning the virtual joystick toward center settles cleanly without excessive inertia."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "function stepAngularVelocity("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  current: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  target: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  maxAccel: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  dampingRate: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  dt: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): number {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  if (stepPx === 0) return rawCoord;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  if (excessPx <= 1e-4) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    return rawCoord + stepPx;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  const movingOutward = stepPx * rawCoord > 0;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  if (movingOutward) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const excessRatio = excessPx / accelDist;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const compressStart = STEERING_CONFIG.softOutwardCompressionStart;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    if (excessRatio <= compressStart) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      return rawCoord + stepPx;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const softScale = 1 / (1 + (excessRatio - compressStart) * 0.35);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    return rawCoord + stepPx * softScale;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  // Pulling back inward while outside the boundary: smooth excess unwind without sticking"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  const excessRatio = excessPx / accelDist;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  const inwardGain = 1 + Math.min(2.2, excessRatio * STEERING_CONFIG.inwardExcessReturnFactor);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  const inwardMag = Math.abs(stepPx);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  const neededToReachBoundary = excessPx / inwardGain;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  if (inwardMag <= neededToReachBoundary) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    return rawCoord + stepPx * inwardGain;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  const remainingInward = inwardMag - neededToReachBoundary;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  return clampedCoord + Math.sign(stepPx) * remainingInward;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * Arcade 6DOF space flight controller."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  const isStoppingOrReversing ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    Math.abs(target) < Math.abs(current) || target * current < 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const effectiveLambda = isStoppingOrReversing"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ? dampingRate * STEERING_CONFIG.stoppingDampingBoost"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    : dampingRate;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const alpha = 1 - Math.exp(-effectiveLambda * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const desiredNext = current + (target - current) * alpha;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const maxStep = maxAccel * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const delta = THREE.MathUtils.clamp(desiredNext - current, -maxStep, maxStep);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const next = current + delta;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Cleanly settle tiny sub-threshold residual drift when target is zero"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (target === 0 && Math.abs(next) < 1e-4) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return next;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Arcade 6DOF space flight controller using a Virtual Joystick mouse model."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Ship coordinate system: Forward = -Z, Right = +X, Up = +Y."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Decoupled Steering Pipeline:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * 1. Relative Pointer Lock deltas from InputManager accumulate unconstrained virtual aim"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " *    displacement `(virtualAimX, virtualAimY)` in game-viewport pixel space."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * 2. `AimBoundary` clamps the virtual reticle strictly inside the centered 40% x 45%"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
