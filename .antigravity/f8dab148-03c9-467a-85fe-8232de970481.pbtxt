            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  const dyCorner = Math.max(0, absClampedY - innerHalfH);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  const axisBoundaryX ="
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    dyCorner > 0"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      ? innerHalfW + Math.sqrt(Math.max(0, r * r - dyCorner * dyCorner))"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      : halfW;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
