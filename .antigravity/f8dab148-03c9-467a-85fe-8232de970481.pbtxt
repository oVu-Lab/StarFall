      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"/**\\n * Centralized configuration for STARFALL\'s Virtual Joystick mouse flight control.\\n *\\n * Calibrated STARFALL Virtual Joystick Profile:\\n * - Centered rounded-rectangle aiming boundary:\\n *     - Base Width:  30% of viewport width  (half-extent = 0.150 * W)\\n *     - Base Height: 35% of viewport height (half-extent = 0.175 * H)\\n *     - Corner Radius: 30% of min(halfW, halfH)\\n * - Strictly separated parameters:\\n *     1. Mouse Sensitivity      \342\200\224 physical mouse movement to virtual joystick travel\\n *     2. Joystick Radius        \342\200\224 uniform scale of the 30% x 35% rounded-rectangle boundary\\n *     3. Deadzone               \342\200\224 drift-free center radial deadzone (fraction of joystick radius)\\n *     4. Precision Sensitivity  \342\200\224 gentle inner-region shaping blended smoothly to 1.0 at the edge\\n *     5. Maximum Steering Input \342\200\224 capped normalized output at/beyond the joystick boundary\\n *     6. Response Curve         \342\200\224 conservative smooth radial exponent (no harsh quadratic knee)\\n *     7. Yaw Rate               \342\200\224 horizontal steering rate multiplier (independent of pitch)\\n *     8. Pitch Rate             \342\200\224 vertical steering rate multiplier (independent of yaw)\\n *     9. Angular Acceleration   \342\200\224 controlled max angular acceleration ceiling (rad/s^2)\\n *    10. Angular Damping        \342\200\224 crisp frame-rate-independent tracking & stopping rate (1/s)\\n */\\nexport const STEERING_CONFIG = {\\n  /** Base centered rounded-rectangle aim boundary width as a fraction of viewport width (30%) */\\n  aimBoundaryWidth: 0.3,\\n  /** Base centered rounded-rectangle aim boundary height as a fraction of viewport height (35%) */\\n  aimBoundaryHeight: 0.35,\\n  /** Rounded-rectangle corner radius as a fraction of min(halfW, halfH) */\\n  aimBoundaryCornerRadius: 0.3,\\n\\n  /** Physical mouse movement to virtual joystick displacement multiplier */\\n  mouseSensitivity: 1.0,\\n  /** Scale factor applied to the base 30% x 35% boundary (1.0 = exact 30% x 35%) */\\n  joystickRadius: 1.0,\\n  /** Center radial deadzone as a fraction of the joystick radius (6%) */\\n  deadzone: 0.06,\\n  /** Gentle center-region precision factor (blends smoothly to 1.0 at joystick boundary) */\\n  precisionSensitivity: 0.85,\\n  /** Maximum normalized steering output reached at or beyond the joystick radius */\\n  maxSteeringInput: 1.0,\\n  /** Conservative smooth radial response curve exponent */\\n  responseCurve: 1.35,\\n\\n  /** Independent horizontal yaw steering multiplier */\\n  yawRate: 1.0,\\n  /** Independent vertical pitch steering multiplier (balanced for widescreen vertical travel) */\\n  pitchRate: 0.9,\\n\\n  /** Controlled angular acceleration ceiling (rad/s^2 for reference Interceptor hull) */\\n  angularAcceleration: 18.0,\\n  /** Controlled angular damping / target tracking rate (1/s for reference Interceptor hull) */\\n  angularDamping: 14.0,\\n  /** Extra damping multiplier when decelerating toward center or reversing turn direction */\\n  stoppingDampingBoost: 1.25,\\n\\n  /** Reference viewport height (px) for consistent physical mouse feel across resolutions */\\n  referenceViewportHeight: 720,\\n\\n  /** Safety angular velocity ceilings (multiples of base ship yawSpeed / pitchSpeed) */\\n  maxSafeYawMultiplier: 2.0,\\n  maxSafePitchMultiplier: 2.0,\\n} as const;\\n\\nexport const STEERING_BOUNDS = {\\n  aimBoundaryWidth: { min: 0.16, max: 0.6 },\\n  aimBoundaryHeight: { min: 0.18, max: 0.65 },\\n  aimBoundaryCornerRadius: { min: 0.05, max: 0.9 },\\n  mouseSensitivity: { min: 0.3, max: 2.5 },\\n  joystickRadius: { min: 0.65, max: 1.5 },\\n  deadzone: { min: 0.0, max: 0.2 },\\n  precisionSensitivity: { min: 0.4, max: 1.2 },\\n  maxSteeringInput: { min: 0.5, max: 1.25 },\\n  responseCurve: { min: 1.0, max: 2.4 },\\n  yawSensitivity: { min: 0.4, max: 1.8 },\\n  pitchSensitivity: { min: 0.4, max: 1.8 },\\n} as const;\\n\", \"Description\":\"Replace legacy 3-zone steering config with clean Virtual Joystick configuration and bounds\", \"Overwrite\":true, \"TargetFile\":\"/src/config/steering.ts\", \"toolAction\":\"Updating steering configuration\", \"toolSummary\":\"Update steering config\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_5956037906700600031"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import * as THREE from \'three\';\\nimport { STEERING_BOUNDS, STEERING_CONFIG } from \'../config/steering\';\\nimport type { SteeringZone } from \'../types/game\';\\n\\n/**\\n * Exact viewport-relative centered rounded-rectangle boundary geometry\\n * for STARFALL\'s Virtual Joystick mouse flight control.\\n * Centered at (0, 0) in game viewport CSS pixel offset coordinates.\\n */\\nexport interface RoundedRectBoundary {\\n  viewportWidth: number;\\n  viewportHeight: number;\\n  widthFraction: number;\\n  heightFraction: number;\\n  cornerRadiusRatio: number;\\n  widthPx: number;\\n  heightPx: number;\\n  halfW: number;\\n  halfH: number;\\n  cornerRadiusPx: number;\\n  innerHalfW: number;\\n  innerHalfH: number;\\n}\\n\\n/**\\n * Result of clamping a candidate virtual joystick displacement onto the centered\\n * rounded-rectangle boundary (bounded logical displacement with C1-continuous corners).\\n */\\nexport interface RoundedRectClampResult {\\n  /** Clamped virtual joystick offset from viewport center in CSS pixels */\\n  clampedX: number;\\n  clampedY: number;\\n  /** True when the candidate displacement lay strictly inside or on the boundary */\\n  inside: boolean;\\n  /** Signed Euclidean distance to the rounded-rectangle perimeter in px (<= 0 inside, > 0 outside) */\\n  signedDistance: number;\\n  /** Clamped normalized deflection relative to halfW / halfH in [-1, 1] */\\n  normalizedX: number;\\n  normalizedY: number;\\n  /** Viewport-normalized [0..1] screen position of the virtual joystick reticle */\\n  screenX: number;\\n  screenY: number;\\n}\\n\\n/**\\n * Output of the smooth radial Virtual Joystick response evaluator.\\n */\\nexport interface VirtualJoystickEvaluation {\\n  /** Exact normalized radial displacement r in [0, 1] along the ray to the rounded-rect perimeter */\\n  radialMagnitude: number;\\n  /** Shaped steering magnitude in [0, maxSteeringInput] after deadzone and smooth response curve */\\n  steeringMagnitude: number;\\n  /** Final normalized horizontal steering output in [-maxSteeringInput, maxSteeringInput] */\\n  steerX: number;\\n  /** Final normalized vertical steering output in [-maxSteeringInput, maxSteeringInput] */\\n  steerY: number;\\n  /** Active virtual joystick region */\\n  zone: SteeringZone;\\n}\\n\\nexport function createRoundedRectBoundary(): RoundedRectBoundary {\\n  const vw = 1280;\\n  const vh = 720;\\n  const widthPx = vw * STEERING_CONFIG.aimBoundaryWidth;\\n  const heightPx = vh * STEERING_CONFIG.aimBoundaryHeight;\\n  const halfW = widthPx * 0.5;\\n  const halfH = heightPx * 0.5;\\n  const cornerRadiusPx = Math.min(halfW, halfH) * STEERING_CONFIG.aimBoundaryCornerRadius;\\n\\n  return {\\n    viewportWidth: vw,\\n    viewportHeight: vh,\\n    widthFraction: STEERING_CONFIG.aimBoundaryWidth,\\n    heightFraction: STEERING_CONFIG.aimBoundaryHeight,\\n    cornerRadiusRatio: STEERING_CONFIG.aimBoundaryCornerRadius,\\n    widthPx,\\n    heightPx,\\n    halfW,\\n    halfH,\\n    cornerRadiusPx,\\n    innerHalfW: Math.max(0, halfW - cornerRadiusPx),\\n    innerHalfH: Math.max(0, halfH - cornerRadiusPx),\\n  };\\n}\\n\\nexport function createRoundedRectClampResult(): RoundedRectClampResult {\\n  return {\\n    clampedX: 0,\\n    clampedY: 0,\\n    inside: true,\\n    signedDistance: 0,\\n    normalizedX: 0,\\n    normalizedY: 0,\\n    screenX: 0.5,\\n    screenY: 0.5,\\n  };\\n}\\n\\nexport function createVirtualJoystickEvaluation(): VirtualJoystickEvaluation {\\n  return {\\n    radialMagnitude: 0,\\n    steeringMagnitude: 0,\\n    steerX: 0,\\n    steerY: 0,\\n    zone: \'deadzone\',\\n  };\\n}\\n\\n/**\\n * Computes exact rounded-rectangle boundary dimensions for the current viewport (W x H).\\n * Base profile (joystickRadius = 1.0):\\n *   width  = 30% of viewport width  (halfW = 0.150 * W)\\n *   height = 35% of viewport height (halfH = 0.175 * H)\\n *   cornerRadius = 0.30 * min(halfW, halfH)\\n */\\nexport function computeRoundedRectBoundary(\\n  viewportWidth: number,\\n  viewportHeight: number,\\n  joystickRadius: number = STEERING_CONFIG.joystickRadius,\\n  baseWidthFraction: number = STEERING_CONFIG.aimBoundaryWidth,\\n  baseHeightFraction: number = STEERING_CONFIG.aimBoundaryHeight,\\n  cornerRadiusRatio: number = STEERING_CONFIG.aimBoundaryCornerRadius,\\n  out: RoundedRectBoundary = createRoundedRectBoundary(),\\n): RoundedRectBoundary {\\n  const vw = Math.max(1, Number.isFinite(viewportWidth) ? viewportWidth : 1280);\\n  const vh = Math.max(1, Number.isFinite(viewportHeight) ? viewportHeight : 720);\\n\\n  const radiusScale = THREE.MathUtils.clamp(\\n    joystickRadius,\\n    STEERING_BOUNDS.joystickRadius.min,\\n    STEERING_BOUNDS.joystickRadius.max,\\n  );\\n  const wf = THREE.MathUtils.clamp(\\n    baseWidthFraction * radiusScale,\\n    STEERING_BOUNDS.aimBoundaryWidth.min,\\n    STEERING_BOUNDS.aimBoundaryWidth.max,\\n  );\\n  const hf = THREE.MathUtils.clamp(\\n    baseHeightFraction * radiusScale,\\n    STEERING_BOUNDS.aimBoundaryHeight.min,\\n    STEERING_BOUNDS.aimBoundaryHeight.max,\\n  );\\n  const rRatio = THREE.MathUtils.clamp(\\n    cornerRadiusRatio,\\n    STEERING_BOUNDS.aimBoundaryCornerRadius.min,\\n    STEERING_BOUNDS.aimBoundaryCornerRadius.max,\\n  );\\n\\n  const widthPx = vw * wf;\\n  const heightPx = vh * hf;\\n  const halfW = widthPx * 0.5;\\n  const halfH = heightPx * 0.5;\\n  const cornerRadiusPx = Math.min(halfW, halfH) * rRatio;\\n\\n  out.viewportWidth = vw;\\n  out.viewportHeight = vh;\\n  out.widthFraction = wf;\\n  out.heightFraction = hf;\\n  out.cornerRadiusRatio = rRatio;\\n  out.widthPx = widthPx;\\n  out.heightPx = heightPx;\\n  out.halfW = halfW;\\n  out.halfH = halfH;\\n  out.cornerRadiusPx = cornerRadiusPx;\\n  out.innerHalfW = Math.max(0, halfW - cornerRadiusPx);\\n  out.innerHalfH = Math.max(0, halfH - cornerRadiusPx);\\n  return out;\\n}\\n\\n/**\\n * C1-continuous closest-point projection of a candidate virtual joystick displacement\\n * onto the centered rounded-rectangle boundary.\\n *\\n * - Inside the rounded rectangle: displacement is kept directly.\\n * - Outside straight edges: clamped perpendicularly to the edge so parallel sliding stays smooth.\\n * - Outside rounded corners: projected orthogonally onto the circular corner arc (zero snapping).\\n */\\nexport function clampToRoundedRect(\\n  rawX: number,\\n  rawY: number,\\n  boundary: RoundedRectBoundary,\\n  out: RoundedRectClampResult = createRoundedRectClampResult(),\\n): RoundedRectClampResult {\\n  const {\\n    halfW,\\n    halfH,\\n    cornerRadiusPx: r,\\n    innerHalfW,\\n    innerHalfH,\\n    viewportWidth,\\n    viewportHeight,\\n  } = boundary;\\n\\n  const ax = Math.abs(rawX);\\n  const ay = Math.abs(rawY);\\n  const sx = rawX < 0 ? -1 : 1;\\n  const sy = rawY < 0 ? -1 : 1;\\n\\n  const qx = ax - innerHalfW;\\n  const qy = ay - innerHalfH;\\n\\n  // Exact Euclidean rounded-rectangle signed distance field (<= 0 inside, > 0 outside)\\n  const outX = qx > 0 ? qx : 0;\\n  const outY = qy > 0 ? qy : 0;\\n  const outLen = Math.hypot(outX, outY);\\n  const inDist = Math.min(Math.max(qx, qy), 0);\\n  const sdf = outLen + inDist - r;\\n\\n  let clampedX = rawX;\\n  let clampedY = rawY;\\n  let inside = true;\\n\\n  if (sdf > 0) {\\n    inside = false;\\n    if (qx > 0 && qy > 0) {\\n      // Corner quadrant: orthogonal projection onto circular corner arc of radius r\\n      const invD = outLen > 1e-6 ? 1 / outLen : 0;\\n      clampedX = sx * (innerHalfW + qx * invD * r);\\n      clampedY = sy * (innerHalfH + qy * invD * r);\\n    } else if (qx > 0) {\\n      // Left / right straight edge\\n      clampedX = sx * halfW;\\n      clampedY = rawY;\\n    } else {\\n      // Top / bottom straight edge\\n      clampedX = rawX;\\n      clampedY = sy * halfH;\\n    }\\n  }\\n\\n  out.clampedX = clampedX;\\n  out.clampedY = clampedY;\\n  out.inside = inside;\\n  out.signedDistance = sdf;\\n  out.normalizedX = halfW > 0 ? THREE.MathUtils.clamp(clampedX / halfW, -1, 1) : 0;\\n  out.normalizedY = halfH > 0 ? THREE.MathUtils.clamp(clampedY / halfH, -1, 1) : 0;\\n  out.screenX = 0.5 + clampedX / viewportWidth;\\n  out.screenY = 0.5 + clampedY / viewportHeight;\\n  return out;\\n}\\n\\n/**\\n * Computes the exact Euclidean distance R(theta) from the center (0, 0) to the\\n * rounded-rectangle perimeter along unit direction (ux, uy).\\n * Guarantees that every point on the straight edges AND circular corners maps to r = 1.0\\n * with C1 continuity across the entire 360\302\260 perimeter.\\n */\\nexport function computeRoundedRectRayRadius(\\n  ux: number,\\n  uy: number,\\n  boundary: RoundedRectBoundary,\\n): number {\\n  const ax = Math.abs(ux);\\n  const ay = Math.abs(uy);\\n  if (ax < 1e-8 && ay < 1e-8) return Math.min(boundary.halfW, boundary.halfH);\\n\\n  const { halfW, halfH, innerHalfW, innerHalfH, cornerRadiusPx: r } = boundary;\\n  const tX = ax > 1e-8 ? halfW / ax : Number.POSITIVE_INFINITY;\\n  const tY = ay > 1e-8 ? halfH / ay : Number.POSITIVE_INFINITY;\\n  const tBox = Math.min(tX, tY);\\n\\n  const hitX = tBox * ax;\\n  const hitY = tBox * ay;\\n\\n  // Straight edge hit (top/bottom or left/right)\\n  if (hitX <= innerHalfW + 1e-6 || hitY <= innerHalfH + 1e-6) {\\n    return tBox;\\n  }\\n\\n  // Circular corner arc intersection: |t * (ax, ay) - (innerHalfW, innerHalfH)|^2 = r^2\\n  const b = ax * innerHalfW + ay * innerHalfH;\\n  const cross = ax * innerHalfH - ay * innerHalfW;\\n  const disc = r * r - cross * cross;\\n  return b + Math.sqrt(Math.max(0, disc));\\n}\\n\\n/**\\n * Pure scalar radial response curve for normalized virtual joystick magnitude r >= 0.\\n *\\n * - r <= deadzone: returns 0 (clean drift-free center).\\n * - deadzone < r < 1: strictly monotonic, C1-smooth conservative curve combining\\n *   responseCurve exponent and gentle inner precisionSensitivity shaping.\\n * - r >= 1: saturates cleanly at maxSteeringInput (zero runaway sensitivity beyond radius).\\n */\\nexport function evaluateResponseCurveScalar(\\n  radialMagnitude: number,\\n  deadzone: number = STEERING_CONFIG.deadzone,\\n  responseCurve: number = STEERING_CONFIG.responseCurve,\\n  precisionSensitivity: number = STEERING_CONFIG.precisionSensitivity,\\n  maxSteeringInput: number = STEERING_CONFIG.maxSteeringInput,\\n): number {\\n  const dz = THREE.MathUtils.clamp(\\n    deadzone,\\n    STEERING_BOUNDS.deadzone.min,\\n    STEERING_BOUNDS.deadzone.max,\\n  );\\n  const maxOut = THREE.MathUtils.clamp(\\n    maxSteeringInput,\\n    STEERING_BOUNDS.maxSteeringInput.min,\\n    STEERING_BOUNDS.maxSteeringInput.max,\\n  );\\n\\n  if (!Number.isFinite(radialMagnitude) || radialMagnitude <= dz) {\\n    return 0;\\n  }\\n  if (radialMagnitude >= 1) {\\n    return maxOut;\\n  }\\n\\n  const p = THREE.MathUtils.clamp(\\n    responseCurve,\\n    STEERING_BOUNDS.responseCurve.min,\\n    STEERING_BOUNDS.responseCurve.max,\\n  );\\n  const k = THREE.MathUtils.clamp(\\n    precisionSensitivity,\\n    STEERING_BOUNDS.precisionSensitivity.min,\\n    STEERING_BOUNDS.precisionSensitivity.max,\\n  );\\n\\n  const u = (radialMagnitude - dz) / Math.max(1e-5, 1 - dz);\\n  const smooth = u * u * (3 - 2 * u);\\n  const shaped = Math.pow(u, p) * (k + (1 - k) * smooth);\\n  return THREE.MathUtils.clamp(shaped, 0, 1) * maxOut;\\n}\\n\\n/**\\n * Evaluates a bounded virtual joystick displacement (clampedX, clampedY) against\\n * the centered rounded-rectangle boundary, producing normalized steering outputs.\\n */\\nexport function evaluateVirtualJoystick(\\n  clampedX: number,\\n  clampedY: number,\\n  boundary: RoundedRectBoundary,\\n  deadzone: number = STEERING_CONFIG.deadzone,\\n  responseCurve: number = STEERING_CONFIG.responseCurve,\\n  precisionSensitivity: number = STEERING_CONFIG.precisionSensitivity,\\n  maxSteeringInput: number = STEERING_CONFIG.maxSteeringInput,\\n  out: VirtualJoystickEvaluation = createVirtualJoystickEvaluation(),\\n): VirtualJoystickEvaluation {\\n  const dist = Math.hypot(clampedX, clampedY);\\n  if (dist <= 1e-6) {\\n    out.radialMagnitude = 0;\\n    out.steeringMagnitude = 0;\\n    out.steerX = 0;\\n    out.steerY = 0;\\n    out.zone = \'deadzone\';\\n    return out;\\n  }\\n\\n  const ux = clampedX / dist;\\n  const uy = clampedY / dist;\\n  const boundaryRadius = Math.max(1e-5, computeRoundedRectRayRadius(ux, uy, boundary));\\n  const r = THREE.MathUtils.clamp(dist / boundaryRadius, 0, 1);\\n\\n  const dz = THREE.MathUtils.clamp(\\n    deadzone,\\n    STEERING_BOUNDS.deadzone.min,\\n    STEERING_BOUNDS.deadzone.max,\\n  );\\n\\n  if (r <= dz) {\\n    out.radialMagnitude = r;\\n    out.steeringMagnitude = 0;\\n    out.steerX = 0;\\n    out.steerY = 0;\\n    out.zone = \'deadzone\';\\n    return out;\\n  }\\n\\n  const mag = evaluateResponseCurveScalar(\\n    r,\\n    dz,\\n    responseCurve,\\n    precisionSensitivity,\\n    maxSteeringInput,\\n  );\\n\\n  out.radialMagnitude = r;\\n  out.steeringMagnitude = mag;\\n  out.steerX = ux * mag;\\n  out.steerY = uy * mag;\\n  out.zone = r >= 0.985 ? \'max\' : \'active\';\\n  return out;\\n}\\n\", \"Description\":\"Implement Virtual Joystick rounded-rectangle clamping, exact ray normalization, and smooth radial response curve in AimBoundary.ts\", \"Overwrite\":true, \"TargetFile\":\"/src/engine/AimBoundary.ts\", \"toolAction\":\"Rewriting AimBoundary for Virtual Joystick\", \"toolSummary\":\"Rewrite AimBoundary module\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_5956037906700602410"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Update DEFAULT_SETTINGS and settings persistence to v6 for Virtual Joystick controls\", \"EndLine\":343, \"Instruction\":\"Replace legacy steering defaults and v5 persistence with clean Virtual Joystick defaults and v6 migration preserving user graphics, audio, camera, and invertY preferences\", \"ReplacementContent\":\"export const DEFAULT_SETTINGS: GameSettings = {\\n  mouseSensitivity: STEERING_CONFIG.mouseSensitivity,\\n  joystickRadius: STEERING_CONFIG.joystickRadius,\\n  deadzone: STEERING_CONFIG.deadzone,\\n  yawSensitivity: STEERING_CONFIG.yawRate,\\n  pitchSensitivity: STEERING_CONFIG.pitchRate,\\n  responseCurve: STEERING_CONFIG.responseCurve,\\n  invertY: false,\\n  cameraDistance: 9.8,\\n  cameraSensitivity: 1.0,\\n  masterVolume: 0.65,\\n  graphicsQuality: \'high\',\\n  resolutionScale: 1.0,\\n  shadowQuality: \'medium\',\\n  particleQuality: \'high\',\\n  environmentDetail: \'high\',\\n  drawDistance: 4200,\\n  antialias: true,\\n  postGlowEnabled: true,\\n  showPerfOverlay: false,\\n};\\n\\nconst SETTINGS_STORAGE_KEY = \'starfall.settings.v6\';\\nconst LEGACY_SETTINGS_KEY_V5 = \'starfall.settings.v5\';\\nconst LEGACY_SETTINGS_KEY_V4 = \'starfall.settings.v4\';\\nconst LEGACY_SETTINGS_KEY_V3 = \'starfall.settings.v3\';\\nconst LEGACY_SETTINGS_KEY_V2 = \'starfall.settings.v2\';\\nconst LEGACY_SETTINGS_KEY_V1 = \'starfall.settings.v1\';\\n\\nfunction clampNumber(value: unknown, min: number, max: number, fallback: number): number {\\n  return typeof value === \'number\' && Number.isFinite(value)\\n    ? Math.max(min, Math.min(max, value))\\n    : fallback;\\n}\\n\\nexport function loadSavedSettings(): GameSettings {\\n  try {\\n    const rawV6 = window.localStorage.getItem(SETTINGS_STORAGE_KEY);\\n    const raw =\\n      rawV6 ??\\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY_V5) ??\\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY_V4) ??\\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY_V3) ??\\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY_V2) ??\\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY_V1);\\n    if (!raw) return { ...DEFAULT_SETTINGS };\\n    const parsed = JSON.parse(raw) as Partial<GameSettings>;\\n    const validQuality =\\n      parsed.graphicsQuality === \'low\' ||\\n      parsed.graphicsQuality === \'medium\' ||\\n      parsed.graphicsQuality === \'high\' ||\\n      parsed.graphicsQuality === \'ultra\'\\n        ? parsed.graphicsQuality\\n        : DEFAULT_SETTINGS.graphicsQuality;\\n\\n    // When migrating from pre-v6 storage, apply the calibrated Virtual Joystick defaults\\n    // while preserving user graphics, audio, camera, and invertY preferences.\\n    const mouseSensitivity = rawV6\\n      ? clampNumber(\\n          parsed.mouseSensitivity,\\n          STEERING_BOUNDS.mouseSensitivity.min,\\n          STEERING_BOUNDS.mouseSensitivity.max,\\n          DEFAULT_SETTINGS.mouseSensitivity,\\n        )\\n      : DEFAULT_SETTINGS.mouseSensitivity;\\n\\n    const joystickRadius = rawV6\\n      ? clampNumber(\\n          parsed.joystickRadius,\\n          STEERING_BOUNDS.joystickRadius.min,\\n          STEERING_BOUNDS.joystickRadius.max,\\n          DEFAULT_SETTINGS.joystickRadius,\\n        )\\n      : DEFAULT_SETTINGS.joystickRadius;\\n\\n    const deadzone = rawV6\\n      ? clampNumber(\\n          parsed.deadzone,\\n          STEERING_BOUNDS.deadzone.min,\\n          STEERING_BOUNDS.deadzone.max,\\n          DEFAULT_SETTINGS.deadzone,\\n        )\\n      : DEFAULT_SETTINGS.deadzone;\\n\\n    const yawSensitivity = rawV6\\n      ? clampNumber(\\n          parsed.yawSensitivity,\\n          STEERING_BOUNDS.yawSensitivity.min,\\n          STEERING_BOUNDS.yawSensitivity.max,\\n          DEFAULT_SETTINGS.yawSensitivity,\\n        )\\n      : DEFAULT_SETTINGS.yawSensitivity;\\n\\n    const pitchSensitivity = rawV6\\n      ? clampNumber(\\n          parsed.pitchSensitivity,\\n          STEERING_BOUNDS.pitchSensitivity.min,\\n          STEERING_BOUNDS.pitchSensitivity.max,\\n          DEFAULT_SETTINGS.pitchSensitivity,\\n        )\\n      : DEFAULT_SETTINGS.pitchSensitivity;\\n\\n    const responseCurve = rawV6\\n      ? clampNumber(\\n          parsed.responseCurve,\\n          STEERING_BOUNDS.responseCurve.min,\\n          STEERING_BOUNDS.responseCurve.max,\\n          DEFAULT_SETTINGS.responseCurve,\\n        )\\n      : DEFAULT_SETTINGS.responseCurve;\\n\\n    return {\\n      ...DEFAULT_SETTINGS,\\n      invertY: typeof parsed.invertY === \'boolean\' ? parsed.invertY : DEFAULT_SETTINGS.invertY,\\n      cameraDistance: clampNumber(parsed.cameraDistance, 7.2, 13.5, DEFAULT_SETTINGS.cameraDistance),\\n      cameraSensitivity: clampNumber(\\n        parsed.cameraSensitivity,\\n        0.6,\\n        1.6,\\n        DEFAULT_SETTINGS.cameraSensitivity,\\n      ),\\n      masterVolume: clampNumber(parsed.masterVolume, 0, 1, DEFAULT_SETTINGS.masterVolume),\\n      mouseSensitivity,\\n      joystickRadius,\\n      deadzone,\\n      yawSensitivity,\\n      pitchSensitivity,\\n      responseCurve,\\n      graphicsQuality: validQuality,\\n      resolutionScale: clampNumber(\\n        parsed.resolutionScale,\\n        0.65,\\n        1.0,\\n        DEFAULT_SETTINGS.resolutionScale,\\n      ),\\n      shadowQuality:\\n        parsed.shadowQuality === \'off\' ||\\n        parsed.shadowQuality === \'low\' ||\\n        parsed.shadowQuality === \'medium\' ||\\n        parsed.shadowQuality === \'high\'\\n          ? parsed.shadowQuality\\n          : DEFAULT_SETTINGS.shadowQuality,\\n      particleQuality:\\n        parsed.particleQuality === \'low\' ||\\n        parsed.particleQuality === \'medium\' ||\\n        parsed.particleQuality === \'high\'\\n          ? parsed.particleQuality\\n          : DEFAULT_SETTINGS.particleQuality,\\n      environmentDetail:\\n        parsed.environmentDetail === \'low\' ||\\n        parsed.environmentDetail === \'medium\' ||\\n        parsed.