        instruction: "/**\n * Centralized configuration for STARFALL\'s Virtual Joystick mouse flight control.\n *\n * Calibrated STARFALL Virtual Joystick Profile:\n * - Centered rounded-rectangle aiming boundary:\n *     - Base Width:  30% of viewport width  (half-extent = 0.150 * W)\n *     - Base Height: 35% of viewport height (half-extent = 0.175 * H)\n *     - Corner Radius: 30% of min(halfW, halfH)\n * - Strictly separated parameters:\n *     1. Mouse Sensitivity      \342\200\224 physical mouse movement to virtual joystick travel\n *     2. Joystick Radius        \342\200\224 uniform scale of the 30% x 35% rounded-rectangle boundary\n *     3. Deadzone               \342\200\224 drift-free center radial deadzone (fraction of joystick radius)\n *     4. Precision Sensitivity  \342\200\224 gentle inner-region shaping blended smoothly to 1.0 at the edge\n *     5. Maximum Steering Input \342\200\224 capped normalized output at/beyond the joystick boundary\n *     6. Response Curve         \342\200\224 conservative smooth radial exponent (no harsh quadratic knee)\n *     7. Yaw Rate               \342\200\224 horizontal steering rate multiplier (independent of pitch)\n *     8. Pitch Rate             \342\200\224 vertical steering rate multiplier (independent of yaw)\n *     9. Angular Acceleration   \342\200\224 controlled max angular acceleration ceiling (rad/s^2)\n *    10. Angular Damping        \342\200\224 crisp frame-rate-independent tracking & stopping rate (1/s)\n */\nexport const STEERING_CONFIG = {\n  /** Base centered rounded-rectangle aim boundary width as a fraction of viewport width (30%) */\n  aimBoundaryWidth: 0.3,\n  /** Base centered rounded-rectangle aim boundary height as a fraction of viewport height (35%) */\n  aimBoundaryHeight: 0.35,\n  /** Rounded-rectangle corner radius as a fraction of min(halfW, halfH) */\n  aimBoundaryCornerRadius: 0.3,\n\n  /** Physical mouse movement to virtual joystick displacement multiplier */\n  mouseSensitivity: 1.0,\n  /** Scale factor applied to the base 30% x 35% boundary (1.0 = exact 30% x 35%) */\n  joystickRadius: 1.0,\n  /** Center radial deadzone as a fraction of the joystick radius (6%) */\n  deadzone: 0.06,\n  /** Gentle center-region precision factor (blends smoothly to 1.0 at joystick boundary) */\n  precisionSensitivity: 0.85,\n  /** Maximum normalized steering output reached at or beyond the joystick radius */\n  maxSteeringInput: 1.0,\n  /** Conservative smooth radial response curve exponent */\n  responseCurve: 1.35,\n\n  /** Independent horizontal yaw steering multiplier */\n  yawRate: 1.0,\n  /** Independent vertical pitch steering multiplier (balanced for widescreen vertical travel) */\n  pitchRate: 0.9,\n\n  /** Controlled angular acceleration ceiling (rad/s^2 for reference Interceptor hull) */\n  angularAcceleration: 18.0,\n  /** Controlled angular damping / target tracking rate (1/s for reference Interceptor hull) */\n  angularDamping: 14.0,\n  /** Extra damping multiplier when decelerating toward center or reversing turn direction */\n  stoppingDampingBoost: 1.25,\n\n  /** Reference viewport height (px) for consistent physical mouse feel across resolutions */\n  referenceViewportHeight: 720,\n\n  /** Safety angular velocity ceilings (multiples of base ship yawSpeed / pitchSpeed) */\n  maxSafeYawMultiplier: 2.0,\n  maxSafePitchMultiplier: 2.0,\n} as const;\n\nexport const STEERING_BOUNDS = {\n  aimBoundaryWidth: { min: 0.16, max: 0.6 },\n  aimBoundaryHeight: { min: 0.18, max: 0.65 },\n  aimBoundaryCornerRadius: { min: 0.05, max: 0.9 },\n  mouseSensitivity: { min: 0.3, max: 2.5 },\n  joystickRadius: { min: 0.65, max: 1.5 },\n  deadzone: { min: 0.0, max: 0.2 },\n  precisionSensitivity: { min: 0.4, max: 1.2 },\n  maxSteeringInput: { min: 0.5, max: 1.25 },\n  responseCurve: { min: 1.0, max: 2.4 },\n  yawSensitivity: { min: 0.4, max: 1.8 },\n  pitchSensitivity: { min: 0.4, max: 1.8 },\n} as const;\n"
