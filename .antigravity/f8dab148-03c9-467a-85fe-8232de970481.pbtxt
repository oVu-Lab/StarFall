ced(220, 0, 8);\n  const atBoundary = await readState();\n  const h0 = atBoundary.headingDeg;\n  for (let i = 0; i < 6; i++) {\n    await sendMouseDeltaSynced(240, 0, 2); // +1440px total outward, synced each frame!\n  }\n  const stillAtMax = await readState();\n  const headingAdvanceDeg = Number(((stillAtMax.headingDeg - h0 + 360) % 360).toFixed(1));\n\n  // Immediate inward pull: -60px (must drop from 192 -> 132 in a SINGLE frame with ZERO unwind lag!)\n  await sendMouseDeltaSynced(-60, 0, 1);\n  const inwardImmediate1Frame = await readState();\n  await cdp.waitFrames(7);\n  const inwardSettled = await readState();\n\n  // Return all the way to center (-132px -> 0) and let damping settle\n  await sendMouseDeltaSynced(-132, 0, 1);\n  const centerImmediate1Frame = await readState();\n  await cdp.waitFrames(8);\n  const centerSettled = await readState();\n\n  results.boundaryAndImmediateReturn = {\n    atBoundary,\n    afterPlus1440pxOutward: { ...stillAtMax, headingAdvanceDeg },\n    inwardImmediate1Frame,\n    inwardSettled,\n    centerImmediate1Frame,\n    centerSettled,\n  };\n\n  // 3. Independent Pitch settled check\n  await cdp.eval(`window.__STARFALL_DIAG__.getFlight().reset()`);\n  await cdp.waitFrames(2);\n  await sendMouseDeltaSynced(0, -160, 10);\n  results.settledFullPitch = await readState();\n\n  // 4. Screenshot during active flight steering\n  await cdp.eval(`window.__STARFALL_DIAG__.getFlight().reset()`);\n  await cdp.waitFrames(2);\n  await sendMouseDeltaSynced(125, -48, 4);\n  await cdp.screenshot(`${ARTIFACT_DIR}/verify_flight_hud.png`);\n\n  // 5. Screenshot at max boundary turning\n  await sendMouseDeltaSynced(120, 0, 4);\n  await cdp.screenshot(`${ARTIFACT_DIR}/verify_flight_max.png`);\n\n  results.consoleErrors = consoleErrors;\n  console.log(JSON.stringify(results, null, 2));\n} finally {\n  cdp?.close();\n  chrome.kill(\'SIGTERM\');\n}\nEOF\nnode /tmp/verify_virtual_joystick_v2.mjs\n"
