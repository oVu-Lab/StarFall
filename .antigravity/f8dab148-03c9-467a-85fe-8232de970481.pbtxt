      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Update FlightController reset and centerAimCursor calls in App.tsx to match simplified signatures\", \"Instruction\":\"Remove obsolete precisionSensitivity arguments from flightRef.current.reset and flightRef.current.centerAimCursor calls\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":247, \"ReplacementContent\":\"      flightRef.current.reset();\", \"StartLine\":244, \"TargetContent\":\"      flightRef.current.reset(undefined, settingsRef.current.precisionSensitivity);\"}, {\"AllowMultiple\":false, \"EndLine\":356, \"ReplacementContent\":\"    flightRef.current.centerAimCursor();\", \"StartLine\":353, \"TargetContent\":\"    flightRef.current.centerAimCursor(settingsRef.current.precisionSensitivity);\"}], \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Updating App flight controller calls\", \"toolSummary\":\"Update App.tsx calls\"}"
      original_name: "multi_replace_file_content"
    }
