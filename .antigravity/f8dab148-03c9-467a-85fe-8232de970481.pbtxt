        target_content: "export type SteeringZone = \'precision\' | \'transition\' | \'acceleration\';\n\nexport interface GameSettings {\n  /** Independent precision-zone sensitivity multiplier inside the rounded-rectangle boundary (0.15 to 1.50) */\n  precisionSensitivity: number;\n  /** Sensitivity multiplier immediately upon crossing the aiming boundary (0.10 to 1.00) */\n  boundarySensitivity: number;\n  /** Asymptotic maximum sensitivity multiplier in the acceleration zone (0.80 to 3.00) */\n  maxSensitivity: number;\n  /** Distance scale S (in virtual px) over which acceleration ramps outside the boundary (80 to 500) */\n  accelerationDistance: number;\n  /** Nonlinear response curve exponent p in f(e) = e^p / (1 + e^p) (1.0 to 3.5) */\n  responseCurve: number;\n  /** Aiming boundary full width as a fraction of game viewport width (default 0.40 = 40%) */\n  aimBoundaryWidth: number;\n  /** Aiming boundary full height as a fraction of game viewport height (default 0.45 = 45%) */\n  aimBoundaryHeight: number;\n  /** Rounded-rectangle corner radius as a fraction of min(halfW, halfH) (default 0.25) */\n  aimBoundaryCornerRadius: number;\n  /** Ship angular velocity smoothing time constant in seconds (default 0.08) */\n  angularSmoothing: number;\n  /** Smooth delta-time reticle & sensitivity recovery time constant in seconds (default 0.12) */\n  recoverySmoothing: number;\n  invertY: boolean;\n  cameraDistance: number; // 7.2 to 13.5\n  cameraSensitivity: number; // 0.6 to 1.6\n  masterVolume: number; // 0 to 1\n  graphicsQuality: GraphicsQuality;\n  resolutionScale: number; // 0.65 to 1.0\n  shadowQuality: ShadowQuality;\n  particleQuality: EffectQuality;\n  environmentDetail: EffectQuality;\n  drawDistance: number; // 2000 to 5200\n  antialias: boolean;\n  postGlowEnabled: boolean;\n  /** Development-only performance monitor toggle (hidden in production builds) */\n  showPerfOverlay: boolean;\n}\n\n/**\n * High-frequency mutable telemetry updated every simulation frame.\n * Read directly via refs inside HUD animation loops to guarantee zero React re-renders per frame.\n */\nexport interface FlightTelemetry {\n  speed: number;\n  signedSpeed: number;\n  maxSpeed: number;\n  effectiveMaxSpeed: number;\n  throttle: number; // -1 to 1\n  boostEnergy: number; // 0 to 100\n  maxBoostEnergy: number;\n  isBoosting: boolean;\n  boostDepleted: boolean;\n  boostIntensity: number; // 0 to 1 smoothly damped\n  hull: number;\n  maxHull: number;\n  yawRate: number; // normalized angular velocity relative to base yawSpeed\n  pitchRate: number; // normalized angular velocity relative to base pitchSpeed\n  rollRate: number; // normalized -1..1\n  /** Normalized virtual aim offset (-1..1 inside rounded-rectangle precision boundary) */\n  aimNormalizedX: number;\n  aimNormalizedY: number;\n  /** Screen-space [0..1] position of clamped virtual mouse steering reticle (strictly inside boundary) */\n  aimScreenX: number;\n  aimScreenY: number;\n  /** Live rounded-rectangle boundary geometry in game viewport CSS pixels */\n  aimBoundaryWidthPx: number;\n  aimBoundaryHeightPx: number;\n  aimBoundaryCornerRadiusPx: number;\n  /** Outward virtual displacement excess past the rounded-rectangle boundary (px) */\n  aimExcessX: number;\n  aimExcessY: number;\n  /** Screen-space [0..1] position of ship boresight */\n  boresightScreenX: number;\n  boresightScreenY: number;\n  /** Active progressive steering zone & smoothed per-axis sensitivity multipliers */\n  steeringZone: SteeringZone;\n  steeringSensitivityX: number;\n  steeringSensitivityY: number;\n  steeringAccelRatio: number; // 0..1 overdrive intensity beyond boundary\n  headingDeg: number; // 0..359\n  pitchDeg: number; // -90..90\n  rollDeg: number; // -180..180\n  altitude: number;\n  status: FlightStatus;\n  pointerLocked: boolean;"
        replacement_content: "export type SteeringZone = \'deadzone\' | \'active\' | \'max\';\n\nexport interface GameSettings {\n  /** Global physical mouse-to-virtual-joystick sensitivity multiplier (0.30 to 2.50) */\n  mouseSensitivity: number;\n  /** Virtual joystick radius scale relative to the 30% x 35% centered boundary (0.65 to 1.50) */\n  joystickRadius: number;\n  /** Normalized radial center deadzone fraction of joystick radius (0.00 to 0.20) */\n  deadzone: number;\n  /** Independent horizontal yaw steering sensitivity multiplier (0.40 to 1.80) */\n  yawSensitivity: number;\n  /** Independent vertical pitch steering sensitivity multiplier (0.40 to 1.80) */\n  pitchSensitivity: number;\n  /** Smooth radial response curve exponent (1.00 to 2.40) */\n  responseCurve: number;\n  invertY: boolean;\n  cameraDistance: number; // 7.2 to 13.5\n  cameraSensitivity: number; // 0.6 to 1.6\n  masterVolume: number; // 0 to 1\n  graphicsQuality: GraphicsQuality;\n  resolutionScale: number; // 0.65 to 1.0\n  shadowQuality: ShadowQuality;\n  particleQuality: EffectQuality;\n  environmentDetail: EffectQuality;\n  drawDistance: number; // 2000 to 5200\n  antialias: boolean;\n  postGlowEnabled: boolean;\n  /** Development-only performance monitor toggle (hidden in production builds) */\n  showPerfOverlay: boolean;\n}\n\n/**\n * High-frequency mutable telemetry updated every simulation frame.\n * Read directly via refs inside HUD animation loops to guarantee zero React re-renders per frame.\n */\nexport interface FlightTelemetry {\n  speed: number;\n  signedSpeed: number;\n  maxSpeed: number;\n  effectiveMaxSpeed: number;\n  throttle: number; // -1 to 1\n  boostEnergy: number; // 0 to 100\n  maxBoostEnergy: number;\n  isBoosting: boolean;\n  boostDepleted: boolean;\n  boostIntensity: number; // 0 to 1 smoothly damped\n  hull: number;\n  maxHull: number;\n  yawRate: number; // normalized angular velocity relative to base yawSpeed\n  pitchRate: number; // normalized angular velocity relative to base pitchSpeed\n  rollRate: number; // normalized -1..1\n  /** Normalized virtual joystick deflection (-1..1 inside rounded-rectangle boundary) */\n  aimNormalizedX: number;\n  aimNormalizedY: number;\n  /** Screen-space [0..1] position of bounded virtual joystick reticle */\n  aimScreenX: number;\n  aimScreenY: number;\n  /** Live rounded-rectangle boundary geometry in game viewport CSS pixels */\n  aimBoundaryWidthPx: number;\n  aimBoundaryHeightPx: number;\n  aimBoundaryCornerRadiusPx: number;\n  /** Normalized radial virtual joystick displacement r in [0..1] along its ray to the boundary */\n  joystickRadialMagnitude: number;\n  /** Shaped normalized steering target outputs after deadzone & response curve (-1..1) */\n  steeringOutputX: number;\n  steeringOutputY: number;\n  /** Screen-space [0..1] position of ship boresight */\n  boresightScreenX: number;\n  boresightScreenY: number;\n  /** Active virtual joystick region (\'deadzone\' | \'active\' | \'max\') */\n  steeringZone: SteeringZone;\n  headingDeg: number; // 0..359\n  pitchDeg: number; // -90..90\n  rollDeg: number; // -180..180\n  altitude: number;\n  status: FlightStatus;\n  pointerLocked: boolean;"
