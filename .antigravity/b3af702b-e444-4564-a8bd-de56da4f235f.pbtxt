  code_action {
    action_spec {
      command {
        instruction: "Ensure boundaryScale and fraction arguments safely default if non-finite so NaN can never propagate into boundary geometry"
        is_edit: true
        file {
          absolute_uri: "file:///src/engine/AimBoundary.ts"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "  const vw = Math.max(1, viewportWidth);\n  const vh = Math.max(1, viewportHeight);\n  const scale = Math.max(0.5, Math.min(2.0, boundaryScale));\n\n  const widthFraction = Math.min(0.85, Math.max(0.1, baseWidthFraction * scale));\n  const heightFraction = Math.min(0.85, Math.max(0.1, baseHeightFraction * scale));\n\n  const widthPx = vw * widthFraction;\n  const heightPx = vh * heightFraction;\n  const halfW = widthPx * 0.5;\n  const halfH = heightPx * 0.5;\n  const cornerRadiusPx = Math.min(halfW, halfH) * Math.max(0.05, Math.min(0.95, cornerRadiusFraction));"
          replacement_content: "  const vw = Number.isFinite(viewportWidth) ? Math.max(1, viewportWidth) : 1280;\n  const vh = Number.isFinite(viewportHeight) ? Math.max(1, viewportHeight) : 720;\n  const scale = Number.isFinite(boundaryScale) ? Math.max(0.5, Math.min(2.0, boundaryScale)) : 1.0;\n\n  const baseW = Number.isFinite(baseWidthFraction) ? baseWidthFraction : 0.3;\n  const baseH = Number.isFinite(baseHeightFraction) ? baseHeightFraction : 0.35;\n  const baseCorner = Number.isFinite(cornerRadiusFraction) ? cornerRadiusFraction : 0.3;\n\n  const widthFraction = Math.min(0.85, Math.max(0.1, baseW * scale));\n  const heightFraction = Math.min(0.85, Math.max(0.1, baseH * scale));\n\n  const widthPx = vw * widthFraction;\n  const heightPx = vh * heightFraction;\n  const halfW = widthPx * 0.5;\n  const halfH = heightPx * 0.5;\n  const cornerRadiusPx = Math.min(halfW, halfH) * Math.max(0.05, Math.min(0.95, baseCorner));"
          start_line: 73
          end_line: 86
        }
      }
    }
