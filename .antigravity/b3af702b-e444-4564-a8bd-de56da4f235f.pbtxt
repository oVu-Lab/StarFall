    command_line: "npx tsx -e \"\nimport * as THREE from \'three\';\nimport { InputManager } from \'./src/engine/InputManager\';\nimport { FlightController, createInitialTelemetry } from \'./src/engine/FlightController\';\nimport { CameraController } from \'./src/engine/CameraController\';\nimport { DEFAULT_SETTINGS, SHIP_CONFIGS } from \'./src/config/ships\';\nimport { STEERING_CONFIG } from \'./src/config/steering\';\n\n// Minimal DOM mock for headless Pointer Lock verification\nconst listeners: Record<string, Function[]> = {};\nconst docListeners: Record<string, Function[]> = {};\nconst canvasStub: any = {\n  tagName: \'CANVAS\',\n  requestPointerLock() {\n    (globalThis as any).document.pointerLockElement = canvasStub;\n    (docListeners[\'pointerlockchange\'] || []).forEach(fn => fn());\n  }\n};\n(globalThis as any).window = {\n  innerWidth: 1280, innerHeight: 720,\n  addEventListener: (t: string, fn: Function) => { (listeners[t] ||= []).push(fn); },\n  removeEventListener: (t: string, fn: Function) => { listeners[t] = (listeners[t] || []).filter(f => f !== fn); },\n};\n(globalThis as any).document = {\n  pointerLockElement: null,\n  exitPointerLock() {\n    (globalThis as any).document.pointerLockElement = null;\n    (docListeners[\'pointerlockchange\'] || []).forEach(fn => fn());\n  },\n  addEventListener: (t: string, fn: Function) => { (docListeners[t] ||= []).push(fn); },\n  removeEventListener: (t: string, fn: Function) => { docListeners[t] = (docListeners[t] || []).filter(f => f !== fn); },\n};\n\nfunction emitMouse(mx: number, my: number) {\n  (listeners[\'mousemove\'] || []).forEach(fn => fn({ movementX: mx, movementY: my }));\n}\n\nfunction runScenario(fps: number, durationSec: number, movePerSecX: number, moveDurationSec: number) {\n  const input = new InputManager();\n  input.attach({});\n  input.setLockTarget(canvasStub);\n  input.setActive(true);\n  canvasStub.requestPointerLock();\n\n  const ship = SHIP_CONFIGS.interceptor;\n  const flight = new FlightController(ship);\n  const telemetry = createInitialTelemetry(ship);\n  const settings = { ...DEFAULT_SETTINGS };\n\n  const dt = 1 / fps;\n  const steps = Math.round(durationSec * fps);\n  let totalYawRad = 0;\n  let peakYawSpeed = 0;\n  let peakStickX = 0;\n  let stickAfterStop = 0;\n  let stickAtEnd = 0;\n\n  for (let i = 0; i < steps; i++) {\n    const t = i * dt;\n    if (t < moveDurationSec) {\n      emitMouse(movePerSecX * dt, 0);\n    }\n    const snap = input.consumeSnapshot(dt, settings);\n    flight.update(dt, snap, settings, telemetry);\n    totalYawRad += Math.abs(flight.yawVelocity) * dt;\n    peakYawSpeed = Math.max(peakYawSpeed, Math.abs(flight.yawVelocity));\n    peakStickX = Math.max(peakStickX, Math.abs(snap.stickX));\n    if (Math.abs(t - moveDurationSec) < dt * 0.6) stickAfterStop = snap.stickX;\n    stickAtEnd = snap.stickX;\n  }\n  input.detach();\n  return { fps, totalYawDeg: +(totalYawRad * 180 / Math.PI).toFixed(2), peakYawRadS: +peakYawSpeed.toFixed(4), peakStickX: +peakStickX.toFixed(4), stickAfterStop: +stickAfterStop.toFixed(4), stickAtEnd: +stickAtEnd.toFixed(4) };\n}\n\nconsole.log(\'=== 1. SMALL PRECISE MOVEMENT (30px over 0.1s, then 1.0s settle) ===\');\nconsole.log(runScenario(60, 1.1, 300, 0.1));\n\nconsole.log(\'=== 2. FRAME RATE CONSISTENCY (300 px/s for 1.0s, then 1.5s self-center) ===\');\nfor (const fps of [30, 60, 120, 144]) {\n  console.log(runScenario(fps, 2.5, 300, 1.0));\n}\n\nconsole.log(\'=== 3. MAX DEFLECTION BOUND (1200 px/s sustained for 1.0s) ===\');\nconsole.log(runScenario(60, 1.0, 1200, 1.0));\n\nconsole.log(\'=== 4. NEON ORBIT EXACT ANALYTICAL COMPARISON (300 px/s for 1.0s, then 1.5s decay, turnRate=1.95, sens=1/300, recentre=1.6) ===\');\n{\n  let s = 0;\n  let yaw = 0;\n  const dt = 1 / 60;\n  for (let i = 0; i < 150; i++) {\n    if (i < 60) s = Math.max(-1, Math.min(1, s + (300 * dt) * (1 / 300)));\n    s *= Math.exp(-1.6 * dt);\n    yaw += Math.abs(s) * 1.95 * dt;\n  }\n  console.log({ reference: \'NEON_ORBIT_60Hz\', totalYawDeg: +(yaw * 180 / Math.PI).toFixed(2), stickAtEnd: +s.toFixed(4) });\n}\n\""
    proposed_command_line: "npx tsx -e \"\nimport * as THREE from \'three\';\nimport { InputManager } from \'./src/engine/InputManager\';\nimport { FlightController, createInitialTelemetry } from \'./src/engine/FlightController\';\nimport { CameraController } from \'./src/engine/CameraController\';\nimport { DEFAULT_SETTINGS, SHIP_CONFIGS } from \'./src/config/ships\';\nimport { STEERING_CONFIG } from \'./src/config/steering\';\n\n// Minimal DOM mock for headless Pointer Lock verification\nconst listeners: Record<string, Function[]> = {};\nconst docListeners: Record<string, Function[]> = {};\nconst canvasStub: any = {\n  tagName: \'CANVAS\',\n  requestPointerLock() {\n    (globalThis as any).document.pointerLockElement = canvasStub;\n    (docListeners[\'pointerlockchange\'] || []).forEach(fn => fn());\n  }\n};\n(globalThis as any).window = {\n  innerWidth: 1280, innerHeight: 720,\n  addEventListener: (t: string, fn: Function) => { (listeners[t] ||= []).push(fn); },\n  removeEventListener: (t: string, fn: Function) => { listeners[t] = (listeners[t] || []).filter(f => f !== fn); },\n};\n(globalThis as any).document = {\n  pointerLockElement: null,\n  exitPointerLock() {\n    (globalThis as any).document.pointerLockElement = null;\n    (docListeners[\'pointerlockchange\'] || []).forEach(fn => fn());\n  },\n  addEventListener: (t: string, fn: Function) => { (docListeners[t] ||= []).push(fn); },\n  removeEventListener: (t: string, fn: Function) => { docListeners[t] = (docListeners[t] || []).filter(f => f !== fn); },\n};\n\nfunction emitMouse(mx: number, my: number) {\n  (listeners[\'mousemove\'] || []).forEach(fn => fn({ movementX: mx, movementY: my }));\n}\n\nfunction runScenario(fps: number, durationSec: number, movePerSecX: number, moveDurationSec: number) {\n  const input = new InputManager();\n  input.attach({});\n  input.setLockTarget(canvasStub);\n  input.setActive(true);\n  canvasStub.requestPointerLock();\n\n  const ship = SHIP_CONFIGS.interceptor;\n  const flight = new FlightController(ship);\n  const telemetry = createInitialTelemetry(ship);\n  const settings = { ...DEFAULT_SETTINGS };\n\n  const dt = 1 / fps;\n  const steps = Math.round(durationSec * fps);\n  let totalYawRad = 0;\n  let peakYawSpeed = 0;\n  let peakStickX = 0;\n  let stickAfterStop = 0;\n  let stickAtEnd = 0;\n\n  for (let i = 0; i < steps; i++) {\n    const t = i * dt;\n    if (t < moveDurationSec) {\n      emitMouse(movePerSecX * dt, 0);\n    }\n    const snap = input.consumeSnapshot(dt, settings);\n    flight.update(dt, snap, settings, telemetry);\n    totalYawRad += Math.abs(flight.yawVelocity) * dt;\n    peakYawSpeed = Math.max(peakYawSpeed, Math.abs(flight.yawVelocity));\n    peakStickX = Math.max(peakStickX, Math.abs(snap.stickX));\n    if (Math.abs(t - moveDurationSec) < dt * 0.6) stickAfterStop = snap.stickX;\n    stickAtEnd = snap.stickX;\n  }\n  input.detach();\n  return { fps, totalYawDeg: +(totalYawRad * 180 / Math.PI).toFixed(2), peakYawRadS: +peakYawSpeed.toFixed(4), peakStickX: +peakStickX.toFixed(4), stickAfterStop: +stickAfterStop.toFixed(4), stickAtEnd: +stickAtEnd.toFixed(4) };\n}\n\nconsole.log(\'=== 1. SMALL PRECISE MOVEMENT (30px over 0.1s, then 1.0s settle) ===\');\nconsole.log(runScenario(60, 1.1, 300, 0.1));\n\nconsole.log(\'=== 2. FRAME RATE CONSISTENCY (300 px/s for 1.0s, then 1.5s self-center) ===\');\nfor (const fps of [30, 60, 120, 144]) {\n  console.log(runScenario(fps, 2.5, 300, 1.0));\n}\n\nconsole.log(\'=== 3. MAX DEFLECTION BOUND (1200 px/s sustained for 1.0s) ===\');\nconsole.log(runScenario(60, 1.0, 1200, 1.0));\n\nconsole.log(\'=== 4. NEON ORBIT EXACT ANALYTICAL COMPARISON (300 px/s for 1.0s, then 1.5s decay, turnRate=1.95, sens=1/300, recentre=1.6) ===\');\n{\n  let s = 0;\n  let yaw = 0;\n  const dt = 1 / 60;\n  for (let i = 0; i < 150; i++) {\n    if (i < 60) s = Math.max(-1, Math.min(1, s + (300 * dt) * (1 / 300)));\n    s *= Math.exp(-1.6 * dt);\n    yaw += Math.abs(s) * 1.95 * dt;\n  }\n  console.log({ reference: \'NEON_ORBIT_60Hz\', totalYawDeg: +(yaw * 180 / Math.PI).toFixed(2), stickAtEnd: +s.toFixed(4) });\n}\n\""
    shell_name: "bash"
  }
}
