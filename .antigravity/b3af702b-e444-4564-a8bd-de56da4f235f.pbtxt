    combined_output {
      full: "<truncated 23 bytes>\n\t    const pitch = bound(controls.pitch, -1, 1)   394\t    const yaw = bound(controls.yaw, -1, 1)   395\t    const bank = bound(controls.roll, -1, 1)   396\t   397\t    // Right-multiplying rotates in the body frame, which is what a stick does.   398\t    // Signs: +Y yaws the nose left and +Z rolls left, so both are negated.   399\t    _euler.set(pitch * turn, -yaw * turn, -bank * roll, \'YXZ\')   400\t    _dq.setFromEuler(_euler)   401\t    this.quaternion.multiply(_dq).normalize()   402\t  }   403\t   404\t  private applyThrottle(controls: Controls, dt: number): void {   405\t    // Same guard as deflection, and for the same reason: a `NaN` throttle   406\t    // reaches `speed`, and `speed` reaches `position`, which never comes back.   407\t    // Zero is the safe reading of \"not a number\" \342\200\224 the ship coasts down rather   408\t    // than inheriting a command nobody sent.   409\t    this.throttle = bound(controls.throttle, 0, 1)   410\t    const target = this.throttle * this.spec.maxSpeed   411\t    const delta = target - this.speed   412\t    const step = this.spec.accel * dt   413\t    this.speed += Math.abs(delta) <= step ? delta : Math.sign(delta) * step   414\t  }   415\t   416\t  private applyDash(controls: Controls, dt: number, audio: Audio): void {   417\t    const q = this.spec.quirk   418\t    if (q.kind !== \'dash\') return   419\t   420\t    if (this.dashCooldown > 0) this.dashCooldown = Math.max(0, this.dashCooldown - dt)   421\t    if (this.dashTimer > 0) this.dashTimer = Math.max(0, this.dashTimer - dt)   422\t   423\t    if (controls.dash && this.dashCooldown <= 0 && this.dashTimer <= 0) {   424\t      this.dashTimer = q.duration   425\t      this.dashCooldown = q.cooldown   426\t      this.forward(_forward)   427\t      this.velocity.addScaledVector(_forward, q.impulse)   428\t      audio.dash()   429\t    }   430\t  }   431\t   432\t  /** Records how far outside the patrol zone the ship is, once per step. */   433\t  private measureBoundary(): void {   434\t    const dist = this.position.length()   435\t    if (dist <= ARENA_RADIUS || dist < 1e-3) {   436\t      this.boundaryDepth = 0   437\t      return   438\t    }   439\t    this.boundaryDepth = Math.min(1, (dist - ARENA_RADIUS) / (ARENA_HARD_LIMIT - ARENA_RADIUS))   440\t    _outNormal.copy(this.position).multiplyScalar(1 / dist)   441\t  }   442\t   443\t  private integrate(dt: number): void {   444\t    this.forward(_forward)   445\t    _desired.copy(_forward).multiplyScalar(this.speed)   446\t   447\t    if (this.boundaryDepth > 0) {   448\t      // The flight computer refuses to thrust further out of the patrol zone.   449\t      //   450\t      // This has to be a veto, not a force. `velocity` chases nose \303\227 maxSpeed at   451\t      // rate `grip`, so the engine asserts up to grip \303\227 maxSpeed of outward   452\t      // acceleration \342\200\224 and it asserts the *most* exactly when velocity is zero.   453\t      // Any purely additive counter-force therefore has a depth where the two   454\t      // cancel and the ship hangs motionless against the wall, nose out, engine   455\t      // roaring, going nowhere. Raising the force only moves that depth.   456\t      // Ramped over only ~20 units so it is effectively a step: any gentler   457\t      // ramp just relocates the equilibrium instead of removing it. Note this   458\t      // vetoes the *radial* component only \342\200\224 a ship crossing the line at an   459\t      // angle keeps its full tangential speed and skims the boundary, which is   460\t      // why this reads as a ceiling on outward progress rather than a wall.   461\t      const outward = _desired.dot(_outNormal)   462\t      if (outward > 0) {   463\t        const veto = Math.min(1, this.boundaryDepth * 40)   464\t        _desired.addScaledVector(_outNormal, -outward * veto)   465\t      }   466\t    }   467\t   468\t    // A dash would be erased instantly at normal grip, so loosen it mid-dash   469\t    // and let the extra velocity bleed off naturally afterwards.   470\t    const grip = this.dashTimer > 0 ? this.spec.grip * 0.12 : this.spec.grip   471\t    this.velocity.lerp(_desired, 1 - Math.exp(-grip * dt))   472\t    this.position.addScaledVector(this.velocity, dt)   473\t  }   474\t   475\t  /**   476\t   * The inward tether, plus the hard backstop.   477\t   *   478\t   * With outward thrust already vetoed in `integrate`, this only has to be   479\t   * enough to walk the ship home \342\200\224 it is not fighting the engine. Scaled to the   480\t   * hull\'s own authority so every airframe feels the same at the same depth.   481\t   */   482\t  private applyBoundary(dt: number): void {   483\t    const d = this.boundaryDepth   484\t    if (d <= 0) return   485\t   486\t    // The constant term matters: a pull that scales purely with depth vanishes   487\t    // at the line, so a drifting ship converges on it asymptotically and never   488\t    // quite crosses \342\200\224 leaving the warning banner lit forever a few units out.   489\t    const authority = this.spec.grip * this.spec.maxSpeed   490\t    this.velocity.addScaledVector(_outNormal, -authority * (0.06 + 0.5 * d + d * d) * dt)   491\t   492\t    const dist = this.position.length()   493\t    if (dist > ARENA_HARD_LIMIT) {   494\t      this.position.multiplyScalar(ARENA_HARD_LIMIT / dist)   495\t      const outward = this.velocity.dot(_outNormal)   496\t      // Reflect rather than cancel, so touching the limit visibly kicks back.   497\t      if (outward > 0) this.velocity.addScaledVector(_outNormal, -outward * 1.6)   498\t    }   499\t  }   500\t   501\t  private applyHazards(hazards: Hazard[]): void {   502\t    for (const hazard of hazards) {   503\t      _toShip.subVectors(this.position, hazard.center)   504\t      const dist = _toShip.length()   505\t      const minDist = hazard.radius + this.radius   506\t      if (dist >= minDist || dist < 1e-3) continue   507\t   508\t      _normal.copy(_toShip).multiplyScalar(1 / dist)   509\t      this.position.copy(hazard.center).addScaledVector(_normal, minDist)   510\t   511\t      const closing = this.velocity.dot(_normal)   512\t      if (closing < 0) {   513\t        // Kill the inward component and bounce back a little.   514\t        this.velocity.addScaledVector(_normal, -closing * 1.5)   515\t        const impact = Math.abs(closing)   516\t        // The arena\'s doing; who is credited for it is the match\'s rule.   517\t        this.takeDamage(Math.min(55, 4 + impact * 0.1), FACTION_ENVIRONMENT)   518\t        this.onCollide?.(this, impact)   519\t      }   520\t    }   521\t  }   522\t   523\t  /**   524\t   * Radiant damage from the star.   525\t   *   526\t   * Credited to the burning ship\'s *own* team, unlike a station scrape, which   527\t   * is credited to the opposition. Sear damage ticks for as long as a hull   528\t   * stays in the light, so crediting it to the player would count every tick   529\t   * as a shot landed and quietly destroy the accuracy stat. Baiting a hostile   530\t   * into the sun still clears it from the roster and still pays the bounty \342\200\224   531\t   * it just is not recorded as marksmanship.   532\t   */   533\t  private applySolarSear(dt: number): void {   534\t    this.solarExposure = solarExposureAt(this.position)   535\t   536\t    // A materialising ship cannot steer, so burning one is a spawn killed for   537\t    // free rather than a pilot error.   538\t    if (this.solarExposure <= 0 || this.warpTimer > 0) {   539\t      this.searTimer = 0   540\t      return   541\t    }   542\t   543\t    this.searTimer += dt   544\t    if (this.searTimer < SEAR_TICK) return   545\t   546\t    const elapsed = this.searTimer   547\t    this.searTimer = 0   548\t    // Squared, so the outer edge is a warning you can back out of and the   549\t    // core is unsurvivable rather than the whole zone being uniformly bad.   550\t    const rate = SEAR_DPS * this.solarExposure * this.solarExposure   551\t    this.takeDamage(rate * elapsed, this.faction)   552\t  }   553\t   554\t  private applyQuirks(controls: Controls, dt: number): void {   555\t    const q = this.spec.quirk   556\t   557\t    if (q.kind === \'heat\') {   558\t      if (this.heatLocked > 0) {   559\t        this.heatLocked = Math.max(0, this.heatLocked - dt)   560\t        // Vent faster during lockout so the penalty has a visible payoff."
    }
