            lines {
              text: "    syncViewportSize();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const ro = typeof ResizeObserver !== \'undefined\' && root ? new ResizeObserver(syncViewportSize) : null;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (ro && root) ro.observe(root);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    window.addEventListener(\'resize\', syncViewportSize);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
