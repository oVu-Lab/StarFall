\":{\"hdg\":null,\"yawVel\":null}}BOOST_AND_STEER: {\"headingDeg\":null,\"pitchDeg\":null,\"yawVel\":null,\"pitchVel\":null,\"speed\":null,\"boostEnergy\":98.7,\"isBoosting\":true,\"aimScreenX\":null,\"aimScreenY\":null,\"steeringZone\":\"active\",\"fps\":1,\"warpFiltered\":2}CONSOLE_ERRORS: [\"Uncaught\"]USED_LOCK_SHIM: false"
