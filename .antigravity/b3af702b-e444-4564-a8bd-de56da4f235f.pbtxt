      full: "[T1 px=5] frame1Vel=-0.034 rad/s | endVel=-0.095 | settledIn=8f (133ms) | finalYaw=0.91deg (expected 0.92deg) | finalVel=0[T1 px=10] frame1Vel=-0.068 rad/s | endVel=-0.189 | settledIn=10f (167ms) | finalYaw=1.83deg (expected 1.83deg) | finalVel=0[T1 px=50] frame1Vel=-0.338 rad/s | endVel=-0.947 | settledIn=14f (233ms) | finalYaw=9.16deg (expected 9.17deg) | finalVel=0[T1 px=150] frame1Vel=-1.013 rad/s | endVel=-2.835 | settledIn=16f (267ms) | finalYaw=27.48deg (expected 27.50deg) | finalVel=0[T2 30FPS] 200px/0.5s -> steadyRate=1.280 rad/s | totalTurn=36.665deg | finalVel=0[T2 60FPS] 200px/0.5s -> steadyRate=1.280 rad/s | totalTurn=36.664deg | finalVel=0[T2 120FPS] 200px/0.5s -> steadyRate=1.280 rad/s | totalTurn=36.665deg | finalVel=0[T2 144FPS] 200px/0.5s -> steadyRate=1.280 rad/s | totalTurn=36.665deg | finalVel=0[T2 spread] max FPS difference = 0.0011 deg[T3 flick] peak=2.835 rad/s (cap=2.835) | settled=267ms | finalVel=0[T4 scale=0.65 1280x720] yaw=22.5813deg pitch=16.1159deg boundary=250x164px[T4 scale=1 1280x720] yaw=22.5813deg pitch=16.1159deg boundary=384x252px[T4 scale=1.5 1280x720] yaw=22.5813deg pitch=16.1159deg boundary=576x378px[T4 scale=1 2560x1440] yaw=22.5813deg pitch=16.1159deg boundary=768x504px[T5 boost+turn] speed=234.1 m/s (cruise=135, boostMax=249.8) | boostEnergy=74.0% | camFov=78.4 | camAngleLag=3.80deg(node:5662) [THREE_CJS_DEPRECATED] DeprecationWarning: `require(\"three\")` is deprecated and will be removed.Replace `const THREE = require(\"three\")` with `import * as THREE from \"three\"`.(Use `node --trace-deprecation ...` to show where the warning was created)"
    }
    command_line: "npx tsx -e \"\nimport * as THREE from \'three\';\nimport { FlightController, createInitialTelemetry } from \'./src/engine/FlightController\';\nimport { CameraController } from \'./src/engine/CameraController\';\nimport { SHIP_CONFIGS, DEFAULT_SETTINGS } from \'./src/config/ships\';\nimport { STEERING_CONFIG } from \'./src/config/steering\';\nimport type { InputSnapshot } from \'./src/engine/InputManager\';\n\nconst ship = SHIP_CONFIGS.interceptor;\nfunction makeInput(overrides: Partial<InputSnapshot> = {}): InputSnapshot {\n  return {\n    forward: false, backward: false, rollLeft: false, rollRight: false,\n    boost: false, firePrimary: false,\n    keyPitchUp: false, keyPitchDown: false, keyYawLeft: false, keyYawRight: false,\n    mouseDeltaX: 0, mouseDeltaY: 0, pointerLocked: true,\n    ...overrides,\n  };\n}\n\nfunction getHeadingDeg(q: THREE.Quaternion): number {\n  const e = new THREE.Euler(0, 0, 0, \'YXZ\').setFromQuaternion(q, \'YXZ\');\n  return THREE.MathUtils.radToDeg(-e.y);\n}\nfunction getPitchDeg(q: THREE.Quaternion): number {\n  const e = new THREE.Euler(0, 0, 0, \'YXZ\').setFromQuaternion(q, \'YXZ\');\n  return THREE.MathUtils.radToDeg(e.x);\n}\n\n// Test 1: Small vs medium vs large mouse travel (60 FPS)\nfor (const px of [5, 10, 50, 150]) {\n  const f = new FlightController(ship);\n  const t = createInitialTelemetry(ship);\n  f.reset();\n  const frames = 10;\n  const perFrame = px / frames;\n  let frame1YawVel = 0;\n  for (let i = 0; i < frames; i++) {\n    f.update(1/60, makeInput({ mouseDeltaX: perFrame }), DEFAULT_SETTINGS, t);\n    if (i === 0) frame1YawVel = f.yawVelocity;\n  }\n  const yawAtStop = f.yawVelocity;\n  let settleFrames = 0;\n  for (let i = 0; i < 30; i++) {\n    f.update(1/60, makeInput(), DEFAULT_SETTINGS, t);\n    if (f.yawVelocity !== 0) settleFrames = i + 1;\n  }\n  const hdg = getHeadingDeg(f.quaternion);\n  const expectedDeg = THREE.MathUtils.radToDeg(px * STEERING_CONFIG.baseRadiansPerPixel);\n  console.log(\\`[T1 px=\\${px}] frame1Vel=\\${frame1YawVel.toFixed(3)} rad/s | endVel=\\${yawAtStop.toFixed(3)} | settledIn=\\${settleFrames}f (\\${(settleFrames/60*1000).toFixed(0)}ms) | finalYaw=\\${hdg.toFixed(2)}deg (expected \\${expectedDeg.toFixed(2)}deg) | finalVel=\\${f.yawVelocity}\\`);\n}\n\n// Test 2: Frame-rate consistency (30, 60, 120, 144 FPS) for 200px sweep over 0.5s + 0.3s settle\nconst fpsResults: number[] = [];\nfor (const fps of [30, 60, 120, 144]) {\n  const f = new FlightController(ship);\n  const t = createInitialTelemetry(ship);\n  f.reset();\n  const dt = 1 / fps;\n  const moveFrames = Math.round(0.5 * fps);\n  const perFrame = 200 / moveFrames;\n  for (let i = 0; i < moveFrames; i++) {\n    f.update(dt, makeInput({ mouseDeltaX: perFrame }), DEFAULT_SETTINGS, t);\n  }\n  const steadyRate = Math.abs(f.yawVelocity);\n  for (let i = 0; i < Math.round(0.4 * fps); i++) {\n    f.update(dt, makeInput(), DEFAULT_SETTINGS, t);\n  }\n  const hdg = getHeadingDeg(f.quaternion);\n  fpsResults.push(hdg);\n  console.log(\\`[T2 \\${fps}FPS] 200px/0.5s -> steadyRate=\\${steadyRate.toFixed(3)} rad/s | totalTurn=\\${hdg.toFixed(3)}deg | finalVel=\\${f.yawVelocity}\\`);\n}\nconst maxFpsDiff = Math.max(...fpsResults) - Math.min(...fpsResults);\nconsole.log(\\`[T2 spread] max FPS difference = \\${maxFpsDiff.toFixed(4)} deg\\`);\n\n// Test 3: Fast flick ceiling check (500px in 1 frame)\n{\n  const f = new FlightController(ship);\n  const t = createInitialTelemetry(ship);\n  f.reset();\n  f.update(1/60, makeInput({ mouseDeltaX: 500 }), DEFAULT_SETTINGS, t);\n  const peak = Math.abs(f.yawVelocity);\n  const maxAllowed = ship.flight.yawSpeed * STEERING_CONFIG.maxTurnRateMultiplier;\n  let zeroAfterMs = 0;\n  for (let i = 1; i <= 30; i++) {\n    f.update(1/60, makeInput(), DEFAULT_SETTINGS, t);\n    if (f.yawVelocity !== 0) zeroAfterMs = i * (1000/60);\n  }\n  console.log(\\`[T3 flick] peak=\\${peak.toFixed(3)} rad/s (cap=\\${maxAllowed.toFixed(3)}) | settled=\\${zeroAfterMs.toFixed(0)}ms | finalVel=\\${f.yawVelocity}\\`);\n}\n\n// Test 4: Boundary size & resolution decoupling\nfor (const [scale, vw, vh] of [[0.65, 1280, 720], [1.0, 1280, 720], [1.5, 1280, 720], [1.0, 2560, 1440]] as const) {\n  const f = new FlightController(ship);\n  const t = createInitialTelemetry(ship);\n  f.reset();\n  const s = { ...DEFAULT_SETTINGS, aimBoundaryScale: scale };\n  for (let i = 0; i < 15; i++) f.update(1/60, makeInput({ mouseDeltaX: 8, mouseDeltaY: -6 }), s, t, vw, vh);\n  for (let i = 0; i < 25; i++) f.update(1/60, makeInput(), s, t, vw, vh);\n  console.log(\\`[T4 scale=\\${scale} \\${vw}x\\${vh}] yaw=\\${getHeadingDeg(f.quaternion).toFixed(4)}deg pitch=\\${getPitchDeg(f.quaternion).toFixed(4)}deg boundary=\\${t.aimBoundaryWidthPx.toFixed(0)}x\\${t.aimBoundaryHeightPx.toFixed(0)}px\\`);\n}\n\n// Test 5: Independent Yaw/Pitch + InvertY + Camera follow + Boost\n{\n  const f = new FlightController(ship);\n  const cam = new THREE.PerspectiveCamera(62, 16/9, 0.25, 4200);\n  const cc = new CameraController();\n  const t = createInitialTelemetry(ship);\n  f.reset();\n  cc.snapToShip(f, cam, DEFAULT_SETTINGS.cameraDistance);\n\n  // Boost + turn right\n  for (let i = 0; i < 60; i++) {\n    f.update(1/60, makeInput({ forward: true, boost: true, mouseDeltaX: 6 }), DEFAULT_SETTINGS, t);\n    cc.updateChase(1/60, f, cam, DEFAULT_SETTINGS, t.boostIntensity, i/60);\n  }\n  const shipFwd = new THREE.Vector3(0, 0, -1).applyQuaternion(f.quaternion);\n  const camFwd = new THREE.Vector3(0, 0, -1).applyQuaternion(cam.quaternion);\n  const camLagDeg = THREE.MathUtils.radToDeg(shipFwd.angleTo(camFwd));\n  console.log(\\`[T5 boost+turn] speed=\\${t.speed.toFixed(1)} m/s (cruise=\\${ship.flight.maxSpeed}, boostMax=\\${(ship.flight.maxSpeed*ship.flight.boostMultiplier).toFixed(1)}) | boostEnergy=\\${t.boostEnergy.toFixed(1)}% | camFov=\\${cam.fov.toFixed(1)} | camAngleLag=\\${camLagDeg.toFixed(2)}deg\\`);\n}\n\""
    proposed_command_line: "npx tsx -e \"\nimport * as THREE from \'three\';\nimport { FlightController, createInitialTelemetry } from \'./src/engine/FlightController\';\nimport { CameraController } from \'./src/engine/CameraController\';\nimport { SHIP_CONFIGS, DEFAULT_SETTINGS } from \'./src/config/ships\';\nimport { STEERING_CONFIG } from \'./src/config/steering\';\nimport type { InputSnapshot } from \'./src/engine/InputManager\';\n\nconst ship = SHIP_CONFIGS.interceptor;\nfunction makeInput(overrides: Partial<InputSnapshot> = {}): InputSnapshot {\n  return {\n    forward: false, backward: false, rollLeft: false, rollRight: false,\n    boost: false, firePrimary: false,\n    keyPitchUp: false, keyPitchDown: false, keyYawLeft: false, keyYawRight: false,\n    mouseDeltaX: 0, mouseDeltaY: 0, pointerLocked: true,\n    ...overrides,\n  };\n}\n\nfunction getHeadingDeg(q: THREE.Quaternion): number {\n  const e = new THREE.Euler(0, 0, 0, \'YXZ\').setFromQuaternion(q, \'YXZ\');\n  return THREE.MathUtils.radToDeg(-e.y);\n}\nfunction getPitchDeg(q: THREE.Quaternion): number {\n  const e = new THREE.Euler(0, 0, 0, \'YXZ\').setFromQuaternion(q, \'YXZ\');\n  return THREE.MathUtils.radToDeg(e.x);\n}\n\n// Test 1: Small vs medium vs large mouse travel (60 FPS)\nfor (const px of [5, 10, 50, 150]) {\n  const f = new FlightController(ship);\n  const t = createInitialTelemetry(ship);\n  f.reset();\n  const frames = 10;\n  const perFrame = px / frames;\n  let frame1YawVel = 0;\n  for (let i = 0; i < frames; i++) {\n    f.update(1/60, makeInput({ mouseDeltaX: perFrame }), DEFAULT_SETTINGS, t);\n    if (i === 0) frame1YawVel = f.yawVelocity;\n  }\n  const yawAtStop = f.yawVelocity;\n  let settleFrames = 0;\n  for (let i = 0; i < 30; i++) {\n    f.update(1/60, makeInput(), DEFAULT_SETTINGS, t);\n    if (f.yawVelocity !== 0) settleFrames = i + 1;\n  }\n  const hdg = getHeadingDeg(f.quaternion);\n  const expectedDeg = THREE.MathUtils.radToDeg(px * STEERING_CONFIG.baseRadiansPerPixel);\n  console.log(\\`[T1 px=\\${px}] frame1Vel=\\${frame1YawVel.toFixed(3)} rad/s | endVel=\\${yawAtStop.toFixed(3)} | settledIn=\\${settleFrames}f (\\${(settleFrames/60*1000).toFixed(0)}ms) | finalYaw=\\${hdg.toFixed(2)}deg (expected \\${expectedDeg.toFixed(2)}deg) | finalVel=\\${f.yawVelocity}\\`);\n}\n\n// Test 2: Frame-rate consistency (30, 60, 120, 144 FPS) for 200px sweep over 0.5s + 0.3s settle\nconst fpsResults: number[] = [];\nfor (const fps of [30, 60, 120, 144]) {\n  const f = new FlightController(ship);\n  const t = createInitialTelemetry(ship);\n  f.reset();\n  const dt = 1 / fps;\n  const moveFrames = Math.round(0.5 * fps);\n  const perFrame = 200 / moveFrames;\n  for (let i = 0; i < moveFrames; i++) {\n    f.update(dt, makeInput({ mouseDeltaX: perFrame }), DEFAULT_SETTINGS, t);\n  }\n  const steadyRate = Math.abs(f.yawVelocity);\n  for (let i = 0; i < Math.round(0.4 * fps); i++) {\n    f.update(dt, makeInput(), DEFAULT_SETTINGS, t);\n  }\n  const hdg = getHeadingDeg(f.quaternion);\n  fpsResults.push(hdg);\n  console.log(\\`[T2 \\${fps}FPS] 200px/0.5s -> steadyRate=\\${steadyRate.toFixed(3)} rad/s | totalTurn=\\${hdg.toFixed(3)}deg | finalVel=\\${f.yawVelocity}\\`);\n}\nconst maxFpsDiff = Math.max(...fpsResults) - Math.min(...fpsResults);\nconsole.log(\\`[T2 spread] max FPS difference = \\${maxFpsDiff.toFixed(4)} deg\\`);\n\n// Test 3: Fast flick ceiling check (500px in 1 frame)\n{\n  const f = new FlightController(ship);\n  const t = createInitialTelemetry(ship);\n  f.reset();\n  f.update(1/60, makeInput({ mouseDeltaX: 500 }), DEFAULT_SETTINGS, t);\n  const peak = Math.abs(f.yawVelocity);\n  const maxAllowed = ship.flight.yawSpeed * STEERING_CONFIG.maxTurnRateMultiplier;\n  let zeroAfterMs = 0;\n  for (let i = 1; i <= 30; i++) {\n    f.update(1/60, makeInput(), DEFAULT_SETTINGS, t);\n    if (f.yawVelocity !== 0) zeroAfterMs = i * (1000/60);\n  }\n  console.log(\\`[T3 flick] peak=\\${peak.toFixed(3)} rad/s (cap=\\${maxAllowed.toFixed(3)}) | settled=\\${zeroAfterMs.toFixed(0)}ms | finalVel=\\${f.yawVelocity}\\`);\n}\n\n// Test 4: Boundary size & resolution decoupling\nfor (const [scale, vw, vh] of [[0.65, 1280, 720], [1.0, 1280, 720], [1.5, 1280, 720], [1.0, 2560, 1440]] as const) {\n  const f = new FlightController(ship);\n  const t = createInitialTelemetry(ship);\n  f.reset();\n  const s = { ...DEFAULT_SETTINGS, aimBoundaryScale: scale };\n  for (let i = 0; i < 15; i++) f.update(1/60, makeInput({ mouseDeltaX: 8, mouseDeltaY: -6 }), s, t, vw, vh);\n  for (let i = 0; i < 25; i++) f.update(1/60, makeInput(), s, t, vw, vh);\n  console.log(\\`[T4 scale=\\${scale} \\${vw}x\\${vh}] yaw=\\${getHeadingDeg(f.quaternion).toFixed(4)}deg pitch=\\${getPitchDeg(f.quaternion).toFixed(4)}deg boundary=\\${t.aimBoundaryWidthPx.toFixed(0)}x\\${t.aimBoundaryHeightPx.toFixed(0)}px\\`);\n}\n\n// Test 5: Independent Yaw/Pitch + InvertY + Camera follow + Boost\n{\n  const f = new FlightController(ship);\n  const cam = new THREE.PerspectiveCamera(62, 16/9, 0.25, 4200);\n  const cc = new CameraController();\n  const t = createInitialTelemetry(ship);\n  f.reset();\n  cc.snapToShip(f, cam, DEFAULT_SETTINGS.cameraDistance);\n\n  // Boost + turn right\n  for (let i = 0; i < 60; i++) {\n    f.update(1/60, makeInput({ forward: true, boost: true, mouseDeltaX: 6 }), DEFAULT_SETTINGS, t);\n    cc.updateChase(1/60, f, cam, DEFAULT_SETTINGS, t.boostIntensity, i/60);\n  }\n  const shipFwd = new THREE.Vector3(0, 0, -1).applyQuaternion(f.quaternion);\n  const camFwd = new THREE.Vector3(0, 0, -1).applyQuaternion(cam.quaternion);\n  const camLagDeg = THREE.MathUtils.radToDeg(shipFwd.angleTo(camFwd));\n  console.log(\\`[T5 boost+turn] speed=\\${t.speed.toFixed(1)} m/s (cruise=\\${ship.flight.maxSpeed}, boostMax=\\${(ship.flight.maxSpeed*ship.flight.boostMultiplier).toFixed(1)}) | boostEnergy=\\${t.boostEnergy.toFixed(1)}% | camFov=\\${cam.fov.toFixed(1)} | camAngleLag=\\${camLagDeg.toFixed(2)}deg\\`);\n}\n\""
