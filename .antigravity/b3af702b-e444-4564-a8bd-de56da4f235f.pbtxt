    combined_output {
      full: "<truncated 23 bytes>\nipant holding faction 1 would evaluate    63\t   * `faction === FACTION_PLAYER` as false for its own ship and hear its own    64\t   * guns at the remote pitch \342\200\224 precisely the failure that moving `laser` off    65\t   * factions was meant to prevent. Fixing the API and leaving the call site    66\t   * comparing against a constant just moved the coupling down a level.    67\t   */    68\t  localFaction: Faction    69\t}    70\t    71\texport const LOCAL_FORWARD = new THREE.Vector3(0, 0, -1)    72\t    73\t/** Seconds a ship spends materialising, during which it cannot be shot. */    74\tconst WARP_DURATION = 0.85    75\t    76\t/** Hull damage per second at full solar exposure. */    77\tconst SEAR_DPS = 30    78\t/**    79\t * Burn is banked and spent in discrete ticks rather than applied every frame,    80\t * so the damage flash, the hull thump and the camera shake fire at a readable    81\t * rate instead of sixty times a second.    82\t */    83\tconst SEAR_TICK = 0.4    84\t    85\t// Module-level scratch. Ship.step runs for every ship every frame.    86\tconst _euler = new THREE.Euler()    87\tconst _dq = new THREE.Quaternion()    88\tconst _desired = new THREE.Vector3()    89\tconst _forward = new THREE.Vector3()    90\tconst _muzzle = new THREE.Vector3()    91\tconst _toShip = new THREE.Vector3()    92\tconst _normal = new THREE.Vector3()    93\tconst _outNormal = new THREE.Vector3()    94\tconst _aim = new THREE.Vector3()    95\tconst _jitter = new THREE.Vector3()    96\tconst _shotDirection = new THREE.Vector3()    97\tconst _fanAxis = new THREE.Vector3()    98\tconst _localUp = new THREE.Vector3(0, 1, 0)    99\t   100\texport class Ship implements BoltTarget {   101\t  readonly spec: ShipSpec   102\t  readonly faction: Faction   103\t  readonly visual: ShipVisual   104\t  readonly accent: THREE.Color   105\t   106\t  readonly position = new THREE.Vector3()   107\t  readonly quaternion = new THREE.Quaternion()   108\t  readonly velocity = new THREE.Vector3()   109\t   110\t  /**   111\t   * The transform as it was at the start of the current simulation step.   112\t   *   113\t   * The sim advances in fixed 1/60 ticks while the display refreshes at   114\t   * whatever rate it likes, so a render almost never lands on a tick boundary.   115\t   * `syncVisual` blends these toward the live transform to place the hull where   116\t   * it was *between* the two ticks either side of the frame. Without it a   117\t   * 144 Hz display would show the same pose two frames running and a 30 Hz one   118\t   * would skip a pose entirely \342\200\224 both read as judder on a ship crossing the   119\t   * screen at several hundred units a second.   120\t   */   121\t  readonly prevPosition = new THREE.Vector3()   122\t  readonly prevQuaternion = new THREE.Quaternion()   123\t   124\t  hull: number   125\t  /** Current airspeed along the nose. */   126\t  speed = 0   127\t  /** Commanded throttle, smoothed into `speed` by `spec.accel`. */   128\t  throttle = 0.55   129\t  alive = true   130\t   131\t  /** Counts down while materialising. */   132\t  warpTimer = WARP_DURATION   133\t  /** Damage flash, 1 \342\206\222 0. */   134\t  flash = 0   135\t  /** Seconds since last damage taken. */   136\t  sinceHit = 99   137\t   138\t  /* Quirk state \342\200\224 only the fields matching `spec.quirk.kind` are used. */   139\t  heat = 0   140\t  /** Seconds of forced gun silence remaining after an overheat. */   141\t  heatLocked = 0   142\t  /** Seconds of dash remaining. */   143\t  dashTimer = 0   144\t  /** Seconds until dash is available again. */   145\t  dashCooldown = 0   146\t   147\t  fireTimer = 0   148\t  shotsFired = 0   149\t   150\t  /**   151\t   * Seconds of Overdrive remaining; zero when the guns are running stock.   152\t   *   153\t   * Lives on `Ship` rather than on the player specifically because everything   154\t   * else about the guns already does, and a buff that only existed on one of   155\t   * two ship classes would be the first thing in this file to make the player   156\t   * and an AI structurally different. Nothing sets it on an enemy today \342\200\224 see   157\t   * the note in `world/pickups.ts` \342\200\224 but the flight model does not need to know   158\t   * that.   159\t   */   160\t  overdriveTimer = 0   161\t   162\t  /** Seconds of Shield remaining. While this is up, damage is refused. */   163\t  shieldTimer = 0   164\t   165\t  /** 0 inside the patrol zone, 1 at the hard limit. Refreshed once per step. */   166\t  private boundaryDepth = 0   167\t   168\t  /** 0 clear of the star, 1 at the full burn rate. Refreshed once per step. */   169\t  solarExposure = 0   170\t  /** Seconds of burn banked since the last sear tick. */   171\t  private searTimer = 0   172\t   173\t  /**   174\t   * `from` is the faction the fatal hit was blamed on, and it is here because a   175\t   * bounty now has to find a *seat*.   176\t   *   177\t   * With one human it did not: whoever fired the last shot, the kill and the   178\t   * bounty went to the only scoreline there was, so the callback did not need to   179\t   * say who. With a roster it does \342\200\224 and the honest cases are the ones where the   180\t   * answer is nobody. Sear is self-attributed, so a hostile that flies into the   181\t   * star reports the AI faction here and no seat matches it. See `creditKill` in   182\t   * `roster.ts` for what happens then; it is not the same answer `onDamaged`   183\t   * gives, deliberately.   184\t   */   185\t  onDeath?: (ship: Ship, from: Faction) => void   186\t  onDamaged?: (ship: Ship, amount: number, from: Faction) => void   187\t  /** Fired instead of `onDamaged` when a Shield ate the hit. */   188\t  onShielded?: (ship: Ship, amount: number) => void   189\t  /** Fired when the hull scrapes a station. */   190\t  onCollide?: (ship: Ship, speed: number) => void   191\t   192\t  private readonly baseEmissive: THREE.Color   193\t  private readonly flashEmissive = new THREE.Color(0xff5566)   194\t   195\t  /**   196\t   * Gun spread draws from here rather than `Math.random`, so a run replays.   197\t   * Defaults to an unseeded stream for bare ships built by a test or a harness;   198\t   * `createGame` always passes a substream of the run seed.   199\t   */   200\t  private readonly rng: Rng   201\t   202\t  constructor(spec: ShipSpec, faction: Faction, rng: Rng = unseededRng()) {   203\t    this.spec = spec   204\t    this.faction = faction   205\t    this.rng = rng   206\t    this.hull = spec.maxHull   207\t    this.visual = buildShip(spec)   208\t    this.accent = new THREE.Color(spec.accent)   209\t    this.baseEmissive = this.visual.hullMat.emissive.clone()   210\t  }   211\t   212\t  get radius(): number {   213\t    return this.spec.radius   214\t  }   215\t   216\t  /** False while materialising or phase-dashing \342\200\224 bolts pass straight through. */   217\t  get targetable(): boolean {   218\t    return this.alive && this.warpTimer <= 0 && this.dashTimer <= 0   219\t  }   220\t   221\t  get overdriven(): boolean {   222\t    return this.overdriveTimer > 0   223\t  }   224\t   225\t  get shielded(): boolean {   226\t    return this.shieldTimer > 0   227\t  }   228\t   229\t  get hullFraction(): number {   230\t    return Math.max(0, this.hull / this.spec.maxHull)   231\t  }   232\t   233\t  /** Outside the patrol zone, where the boundary is actively pushing back. */   234\t  get outOfBounds(): boolean {   235\t    return this.position.lengthSq() > ARENA_RADIUS * ARENA_RADIUS   236\t  }   237\t   238\t  /** Metres past the patrol line, for the HUD warning. */   239\t  get boundaryOvershoot(): number {   240\t    return Math.max(0, this.position.length() - ARENA_RADIUS)   241\t  }   242\t   243\t  get speedFraction(): number {   244\t    return Math.max(0, Math.min(1, this.speed / this.spec.maxSpeed))   245\t  }   246\t   247\t  /** 0..1 for the HUD quirk gauge. Meaning depends on the hull. */   248\t  get quirkValue(): number {   249\t    const q = this.spec.quirk   250\t    switch (q.kind) {   251\t      case \'heat\':   252\t        return Math.min(1, this.heat / q.max)   253\t      case \'regen\':   254\t        return Math.min(1, this.sinceHit / q.delay)   255\t      case \'dash\':   256\t        return 1 - Math.min(1, this.dashCooldown / q.cooldown)   257\t    }   258\t  }   259\t   260\t  /** True when the gauge is a warning rather than a readiness bar. */"
    }
    command_line: "nl -ba /tmp/neon-orbit/src/game/ship.ts | sed -n \'1,260p\'"
    proposed_command_line: "nl -ba /tmp/neon-orbit/src/game/ship.ts | sed -n \'1,260p\'"
