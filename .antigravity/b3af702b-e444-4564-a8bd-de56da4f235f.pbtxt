      full: "   340\t  /* ------------------------------------------------------------------------ */   341\t  /* Simulation                                                               */   342\t  /* ------------------------------------------------------------------------ */   343\t   344\t  step(controls: Controls, dt: number, ctx: ShipContext): void {   345\t    if (!this.alive) return   346\t   347\t    // Taken before anything moves: this is the pose the next render interpolates   348\t    // away from.   349\t    this.prevPosition.copy(this.position)   350\t    this.prevQuaternion.copy(this.quaternion)   351\t   352\t    if (this.warpTimer > 0) this.warpTimer = Math.max(0, this.warpTimer - dt)   353\t    this.sinceHit += dt   354\t    this.flash = Math.max(0, this.flash - dt * 3.5)   355\t    if (this.fireTimer > 0) this.fireTimer -= dt   356\t    if (this.overdriveTimer > 0) this.overdriveTimer = Math.max(0, this.overdriveTimer - dt)   357\t    if (this.shieldTimer > 0) this.shieldTimer = Math.max(0, this.shieldTimer - dt)   358\t   359\t    this.applyRotation(controls, dt)   360\t    this.applyThrottle(controls, dt)   361\t    this.applyDash(controls, dt, ctx.audio)   362\t    this.measureBoundary()   363\t    this.integrate(dt)   364\t    this.applyBoundary(dt)   365\t    this.applyHazards(ctx.hazards)   366\t    this.applySolarSear(dt)   367\t    this.applyQuirks(controls, dt)   368\t   369\t    if (controls.fire) this.tryFire(ctx, controls.aim, controls.spread)   370\t  }   371\t   372\t  private applyRotation(controls: Controls, dt: number): void {   373\t    const turn = this.spec.turnRate * dt   374\t    const roll = this.spec.rollRate * dt   375\t   376\t    /*   377\t     * Deflection is clamped here rather than trusted from the producer.   378\t     *   379\t     * Every producer today already stays in range \342\200\224 the AI clamps in   380\t     * `ai.ts`, the device clamps in `input.ts`, and roll there is built from   381\t     * two keys so it can only be -1, 0 or 1 \342\200\224 so this changes no run that   382\t     * exists. It is not redundant, it is a relocation: the bound moves from   383\t     * \"every caller is well behaved\" to \"the airframe cannot be asked to   384\t     * exceed itself\", and `Controls` is now the shape a stranger\'s browser   385\t     * will send. Unclamped, a `pitch` of 1000 is a thousand times the turn   386\t     * rate the whole three-airframe balance rests on.   387\t     *   388\t     * Value bounds belong here because they are free and inert. *Rate* bounds   389\t     * do not: throttle\'s ramp is a device-side integration the AI legitimately   390\t     * bypasses, so enforcing it host-side is a real behaviour decision and   391\t     * lives with the rest of input validation. See `PLANS/NEON_ORBIT_PHASE_B.md`.   392\t     */   393\t    const pitch = bound(controls.pitch, -1, 1)   394\t    const yaw = bound(controls.yaw, -1, 1)   395\t    const bank = bound(controls.roll, -1, 1)   396\t   397\t    // Right-multiplying rotates in the body frame, which is what a stick does.   398\t    // Signs: +Y yaws the nose left and +Z rolls left, so both are negated.   399\t    _euler.set(pitch * turn, -yaw * turn, -bank * roll, \'YXZ\')   400\t    _dq.setFromEuler(_euler)   401\t    this.quaternion.multiply(_dq).normalize()   402\t  }   403\t   404\t  private applyThrottle(controls: Controls, dt: number): void {   405\t    // Same guard as deflection, and for the same reason: a `NaN` throttle"
    }
