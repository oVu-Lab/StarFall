    command_line: "node --input-type=module -e \"\nimport { spawn } from \'node:child_process\';\n\nconst CHROME = \'/ms-playwright/chrome-headless-shell-linux64/chrome-headless-shell\';\nconst PORT = 9226;\nconst chrome = spawn(CHROME, [\n  \'--headless\',\n  \'--no-sandbox\',\n  \'--disable-gpu-sandbox\',\n  \'--use-gl=angle\',\n  \'--use-angle=swiftshader\',\n  \'--enable-webgl\',\n  \'--ignore-gpu-blocklist\',\n  \'--window-size=1280,720\',\n  \\`--remote-debugging-port=\\${PORT}\\`,\n  \'about:blank\',\n], { stdio: [\'ignore\', \'pipe\', \'pipe\'] });\n\nasync function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }\n\nasync function waitForCdp() {\n  for (let i = 0; i < 40; i++) {\n    try {\n      const res = await fetch(\\`http://127.0.0.1:\\${PORT}/json/list\\`);\n      if (res.ok) {\n        const list = await res.json();\n        const page = list.find(t => t.type === \'page\');\n        if (page) return page.webSocketDebuggerUrl;\n      }\n    } catch {}\n    await sleep(150);\n  }\n  throw new Error(\'CDP did not become ready\');\n}\n\nclass CdpClient {\n  constructor(url) {\n    this.ws = new WebSocket(url);\n    this.id = 0;\n    this.pending = new Map();\n    this.events = [];\n    this.ready = new Promise((res, rej) => {\n      this.ws.addEventListener(\'open\', res);\n      this.ws.addEventListener(\'error\', rej);\n    });\n    this.ws.addEventListener(\'message\', (ev) => {\n      const msg = JSON.parse(ev.data.toString());\n      if (msg.id && this.pending.has(msg.id)) {\n        const { res, rej } = this.pending.get(msg.id);\n        this.pending.delete(msg.id);\n        if (msg.error) rej(new Error(msg.error.message));\n        else res(msg.result);\n      } else if (msg.method) {\n        this.events.push(msg);\n      }\n    });\n  }\n  send(method, params = {}) {\n    const id = ++this.id;\n    return new Promise((res, rej) => {\n      this.pending.set(id, { res, rej });\n      this.ws.send(JSON.stringify({ id, method, params }));\n    });\n  }\n  async eval(expression) {\n    const r = await this.send(\'Runtime.evaluate\', { expression, returnByValue: true, awaitPromise: true });\n    if (r.exceptionDetails) {\n      throw new Error(\'Eval exception: \' + JSON.stringify(r.exceptionDetails));\n    }\n    return r.result.value;\n  }\n  close() { this.ws.close(); }\n}\n\nlet cdp;\ntry {\n  const wsUrl = await waitForCdp();\n  cdp = new CdpClient(wsUrl);\n  await cdp.ready;\n\n  await cdp.send(\'Page.enable\');\n  await cdp.send(\'Runtime.enable\');\n  await cdp.send(\'Emulation.setDeviceMetricsOverride\', { width: 1280, height: 720, deviceScaleFactor: 1, mobile: false });\n\n  await cdp.send(\'Page.navigate\', { url: \'http://localhost:3000/\' });\n\n  for (let i = 0; i < 60; i++) {\n    if (await cdp.eval(\'Boolean(window.__STARFALL_DIAG__ && document.querySelector(\\\"canvas\\\"))\')) break;\n    await sleep(200);\n  }\n\n  // Open Settings, switch graphics to Low for smooth SwiftShader frame pacing, close Settings\n  await cdp.eval(\\`Array.from(document.querySelectorAll(\'button\')).find(b => /settings/i.test(b.textContent || \'\'))?.click()\\`);\n  await sleep(300);\n  await cdp.eval(\\`Array.from(document.querySelectorAll(\'button\')).find(b => b.textContent?.trim() === \'Low\')?.click()\\`);\n  await sleep(200);\n  await cdp.eval(\\`Array.from(document.querySelectorAll(\'button\')).find(b => /back|return|close|done/i.test(b.textContent || \'\'))?.click()\\`);\n  await sleep(350);\n\n  // Launch Mission 01\n  await cdp.eval(\\`Array.from(document.querySelectorAll(\'button\')).find(b => /campaign missions/i.test(b.textContent || \'\'))?.click()\\`);\n  await sleep(400);\n  await cdp.eval(\\`Array.from(document.querySelectorAll(\'button\')).find(b => /launch/i.test(b.textContent || \'\'))?.click()\\`);\n\n  let phase = \'\';\n  for (let i = 0; i < 60; i++) {\n    phase = await cdp.eval(\'window.__STARFALL_DIAG__.getPhase()\');\n    if (phase === \'playing\') break;\n    await sleep(200);\n  }\n  console.log(\'PHASE:\', phase);\n  if (phase !== \'playing\') throw new Error(\'Failed to enter playing phase\');\n\n  async function waitFrames(n) {\n    await cdp.eval(\\`new Promise(resolve => {\n      let left = \\${n};\n      function step() {\n        if (--left <= 0) resolve(true);\n        else requestAnimationFrame(step);\n      }\n      requestAnimationFrame(step);\n    })\\`);\n  }\n\n  await waitFrames(4);\n\n  // Engage native Pointer Lock via real CDP click on canvas center\n  await cdp.send(\'Input.dispatchMouseEvent\', { type: \'mousePressed\', x: 640, y: 360, button: \'left\', clickCount: 1 });\n  await sleep(40);\n  await cdp.send(\'Input.dispatchMouseEvent\', { type: \'mouseReleased\', x: 640, y: 360, button: \'left\', clickCount: 1 });\n  await waitFrames(3);\n\n  console.log(\'NATIVE_POINTER_LOCK:\', JSON.stringify(await cdp.eval(\'window.__STARFALL_DIAG__.getInput().getDiagnostics()\')));\n  console.log(\'AIM_BOUNDARY:\', JSON.stringify(await cdp.eval(\\`(() => {\n    const el = document.querySelector(\'[data-testid=\\\"aim-boundary-frame\\\"]\');\n    return el ? { ...el.dataset } : null;\n  })()\\`)));\n\n  async function readState() {\n    return cdp.eval(\\`(() => {\n      const f = window.__STARFALL_DIAG__.getFlight();\n      const t = window.__STARFALL_DIAG__.getTelemetry();\n      return {\n        hdg: Number(t.headingDeg.toFixed(2)),\n        pitch: Number(t.pitchDeg.toFixed(2)),\n        yawVel: Number(f.yawVelocity.toFixed(4)),\n        pitchVel: Number(f.pitchVelocity.toFixed(4)),\n        speed: Number(t.speed.toFixed(1)),\n        boost: Number(t.boostEnergy.toFixed(1)),\n        isBoosting: t.isBoosting,\n        reticleX: Number(t.aimScreenX.toFixed(4)),\n        reticleY: Number(t.aimScreenY.toFixed(4)),\n        zone: t.steeringZone,\n        fps: t.fps,\n      };\n    })()\\`);\n  }\n\n  async function moveOverFrames(dxPerFrame, dyPerFrame, frames) {\n    for (let i = 0; i < frames; i++) {\n      await cdp.eval(\\`window.dispatchEvent(new MouseEvent(\'mousemove\', { movementX: \\${dxPerFrame}, movementY: \\${dyPerFrame}, bubbles: true }))\\`);\n      await waitFrames(1);\n    }\n  }\n\n  // TEST 1: Small precise movement (12px right, 6px up over 3 frames) + zero drift after stop\n  await cdp.eval(\'window.__STARFALL_DIAG__.getFlight().reset()\');\n  await waitFrames(2);\n  await moveOverFrames(4, -2, 3);\n  const t1Active = await readState();\n  await waitFrames(8);\n  const t1Stopped = await readState();\n  await waitFrames(5);\n  const t1Drift = await readState();\n  console.log(\'TEST1_SMALL:\', JSON.stringify({ active: t1Active, stopped: t1Stopped, afterWait: t1Drift }));\n\n  // TEST 2: Larger continuous sweep (1600px right > 1280px screen width)\n  await cdp.eval(\'window.__STARFALL_DIAG__.getFlight().reset()\');\n  await waitFrames(2);\n  let maxYawVel = 0;\n  let totalYawDeg = 0;\n  let prevHdg = (await readState()).hdg;\n  for (let i = 0; i < 20; i++) {\n    await cdp.eval(\\`window.dispatchEvent(new MouseEvent(\'mousemove\', { movementX: 80, movementY: 0, bubbles: true }))\\`);\n    await waitFrames(1);\n    const st = await readState();\n    if (Math.abs(st.yawVel) > maxYawVel) maxYawVel = Math.abs(st.yawVel);\n    let d = st.hdg - prevHdg;\n    if (d < -180) d += 360;\n    if (d > 180) d -= 360;\n    totalYawDeg += d;\n    prevHdg = st.hdg;\n  }\n  await waitFrames(10);\n  const t2Stopped = await readState();\n  await waitFrames(6);\n  const t2Drift = await readState();\n  console.log(\'TEST2_LARGE_SWEEP:\', JSON.stringify({\n    pxTotal: 1600,\n    totalYawDeg: Number(totalYawDeg.toFixed(1)),\n    maxYawVel: Number(maxYawVel.toFixed(3)),\n    stoppedYawVel: t2Stopped.yawVel,\n    driftDeg: Number(Math.abs(t2Drift.hdg - t2Stopped.hdg).toFixed(3)),\n    stoppedReticle: [t2Stopped.reticleX, t2Stopped.reticleY],\n    stoppedZone: t2Stopped.zone,\n  }));\n\n  // TEST 3: Quick reversal / target tracking (Right 120px then Left 120px)\n  await cdp.eval(\'window.__STARFALL_DIAG__.getFlight().reset()\');\n  await waitFrames(2);\n  await moveOverFrames(30, 0, 4);\n  const t3Right = await readState();\n  await moveOverFrames(-30, 0, 4);\n  const t3Left = await readState();\n  await waitFrames(10);\n  const t3Stop = await readState();\n  console.log(\'TEST3_REVERSE:\', JSON.stringify({\n    afterRight: { hdg: t3Right.hdg, yawVel: t3Right.yawVel },\n    afterLeft: { hdg: t3Left.hdg, yawVel: t3Left.yawVel },\n    settled: { hdg: t3Stop.hdg, yawVel: t3Stop.yawVel },\n  }));\n\n  // TEST 4: Boost + Steering together\n  await cdp.eval(\'window.__STARFALL_DIAG__.getFlight().reset()\');\n  await waitFrames(2);\n  await cdp.send(\'Input.dispatchKeyEvent\', { type: \'keyDown\', code: \'KeyW\', key: \'w\' });\n  await cdp.send(\'Input.dispatchKeyEvent\', { type: \'keyDown\', code: \'ShiftLeft\', key: \'Shift\' });\n  await moveOverFrames(18, -10, 12);\n  const t4Boost = await readState();\n  await cdp.send(\'Input.dispatchKeyEvent\', { type: \'keyUp\', code: \'ShiftLeft\', key: \'Shift\' });\n  await cdp.send(\'Input.dispatchKeyEvent\', { type: \'keyUp\', code: \'KeyW\', key: \'w\' });\n  console.log(\'TEST4_BOOST_STEER:\', JSON.stringify(t4Boost));\n\n  const errors = cdp.events\n    .filter(e => e.method === \'Runtime.exceptionThrown\' || (e.method === \'Runtime.consoleAPICalled\' && e.params.type === \'error\'))\n    .map(e => e.method === \'Runtime.exceptionThrown\'\n      ? (e.params.exceptionDetails?.exception?.description || e.params.exceptionDetails?.text)\n      : e.params.args?.map(a => a.value || a.description).join(\' \'));\n  console.log(\'CONSOLE_ERRORS:\', JSON.stringify(errors));\n} finally {\n  if (cdp) cdp.close();\n  chrome.kill(\'SIGKILL\');\n}\n\""
