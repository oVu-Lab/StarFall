      full: "   511\t    const isRecord = recordRun(result)   512\t    screens.moveTo(\'debrief\')   513\t    hud.setLockPrompt(false)   514\t    // These are full-length tracks rather than stings, so they loop like any   515\t    // other screen music. Nobody reads a debrief for a minute and a quarter.   516\t    audio.setMusic(result.won ? \'victory\' : \'defeat\')   517\t    debrief.show(result, isRecord, Math.max(previous, result.score))   518\t    const code = new URLSearchParams(window.location.search).get(\'join\')   519\t    if (code) {   520\t      checkPotClaim(code)   521\t      if (activePotRoom) {   522\t        debrief.potNotice(\'Pot match \302\267 disconnecting forfeits the pot.\')   523\t        const claim = storedPotClaim(code)   524\t        if (endpoint && claim) void potClaimStatus(endpoint, code, claim.seat, claim.token)   525\t          .then(status => {   526\t            if (status.kind === \'winner\' && status.amountMsat !== null && debrief.visible) {   527\t              debrief.potNotice(`Claimable: ${(status.amountMsat / 1000).toLocaleString()} sats ` +   528\t                \'(gross pot less the fee reserve). Disconnecting forfeits the pot.\')   529\t            }   530\t          }).catch(() => {})   531\t      }   532\t    }   533\t  }   534\t   535\t  /* ---- Global keys and pointer lock ------------------------------------- */   536\t   537\t  // Straight to the flow: it knows which screen it is allowed to act from, so there is   538\t  // no screen test to duplicate here and get out of step with it.   539\t  input.onKey(\'Escape\', () => screens.togglePause())   540\t  input.onKey(\'KeyP\', () => screens.togglePause())   541\t  input.onKey(\'KeyM\', () => audio.toggleMute())   542\t  input.onKey(\'Tab\', () => {   543\t    if (screens.screen === \'flight\') game.cycleTarget()   544\t  })   545\t  input.onKey(\'KeyT\', () => {   546\t    if (screens.screen === \'flight\') game.cycleTarget()   547\t  })   548\t  input.onKey(\'KeyI\', () => {   549\t    input.invertPitch = !input.invertPitch   550\t  })   551\t   552\t  // Losing pointer lock mid-fight (usually Escape) should pause, not silently   553\t  // strand the player with a dead mouse.   554\t  input.onPointerLockLost(() => screens.enterPause())   555\t   556\t  canvas.addEventListener(\'click\', () => {   557\t    audio.resume()   558\t    if (screens.screen === \'flight\' && !input.pointerLocked) input.requestPointerLock()   559\t  })   560\t   561\t  /* ---- Dev console hook -------------------------------------------------- */   562\t   563\t  // Built and installed by `src/core/dev-hook.ts`, which a headless run can execute.   564\t  // The version that lived here read a bare `screen` after the screen state moved out,   565\t  // which compiles against the DOM global \342\200\224 so the hook reported the browser\'s `Screen`   566\t  // object rather than any of the four values the README documents.   567\t  if (import.meta.env.DEV) {   568\t    installDevHook(window, createDevHook({ screens, game, input, start: startRun }))   569\t  }   570\t   571\t  /* ---- Loop ------------------------------------------------------------- */   572\t   573\t  const clock = new THREE.Clock()   574\t  const stepClock = createStepClock(STEP, MAX_FRAME)   575\t  let splashCleared = false   576\t   577\t  /**   578\t   * The intent handed to the simulation each tick, one slot per seat.   579\t   *   580\t   * Reused rather than rebuilt, because this runs sixty times a second and the   581\t   * simulation copies what it is handed rather than retaining it. One slot today:   582\t   * this machine drives one seat, and the remaining slots are what a host fills   583\t   * from arriving packets and a client leaves to the host.   584\t   */   585\t  const intents: Controls[] = [pilot.advance(input.state, STEP)]   586\t   587\t  function frame() {   588\t    const { ticks, frameSeconds, alpha } = stepClock.advance(clock.getDelta())   589\t   590\t    if (screens.screen === \'hangar\') {   591\t      // The hangar has no simulation to keep honest \342\200\224 it is a turntable and a   592\t      // set of cards \342\200\224 so it runs straight off the frame.   593\t      environment.update(frameSeconds, stage.camera)   594\t      hangar.update(frameSeconds)   595\t      // Waiting peers still repeat HELLO to recover lost roster / launch frames.   596\t      for (let i = 0; i < ticks; i++) joining?.tick(intents[0])   597\t    } else {   598\t      for (let i = 0; i < ticks; i++) {   599\t        // Sampled per tick, not per frame: the virtual stick self-centres over   600\t        // time, so decaying it once per frame would make it recentre faster on   601\t        // a faster display.   602\t        input.update(STEP)   603\t        // Reading the device and running the simulation are two steps now, and   604\t        // this is the seam multiplayer opens: a host would send these controls   605\t        // as well as flying on them, and a client would fly on controls that   606\t        // arrived rather than ones it produced. The simulation is handed one   607\t        // intent per seat and never asks which of those a device produced.   608\t        intents[0] = pilot.advance(input.state, STEP)   609\t        stepSession(mode, hosting, joining, game, intents)   610\t        // With no network session, a networked game waits for RETRY or PLAY SOLO.   611\t      }   612\t      game.render(alpha, frameSeconds)   613\t    }   614\t   615\t    stage.render()   616\t   617\t    // Only drop the splash once a real frame is on screen, so the reveal never   618\t    // shows a black canvas mid-shader-compile.   619\t    if (!splashCleared) {   620\t      splashCleared = true   621\t      splash.classList.add(\'done\')   622\t      window.setTimeout(() => splash.remove(), 600)   623\t      openHangar()   624\t    }   625\t   626\t    requestAnimationFrame(frame)   627\t  }   628\t   629\t  requestAnimationFrame(frame)   630\t   631\t  window.addEventListener(\'beforeunload\', () => {   632\t    hosting?.stop()   633\t    joining?.stop()   634\t    lobby?.close()   635\t    game.dispose()   636\t    hangar.dispose()   637\t    pause.dispose()   638\t    debrief.dispose()   639\t    potClaimPanel.dispose()   640\t    hud.dispose()   641\t    input.dispose()   642\t    audio.dispose()   643\t    environment.dispose()   644\t    stage.dispose()   645\t  })   646\t}   647\t   648\ttry {   649\t  boot()   650\t} catch (error) {   651\t  console.error(error)   652\t  const overlay = document.getElementById(\'overlay\')   653\t  if (overlay) {   654\t    overlay.innerHTML = `   655\t      <div id=\"boot\"><div class=\"stack\">   656\t        <h1 class=\"title glow-magenta\">WEBGL UNAVAILABLE</h1>   657\t        <div class=\"hint\">${error instanceof Error ? error.message : \'Unknown error\'}</div>   658\t      </div></div>`   659\t  }   660\t}"
    }
