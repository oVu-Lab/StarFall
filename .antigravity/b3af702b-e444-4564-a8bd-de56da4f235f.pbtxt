      full: "SETTINGS: {\"mouseSensitivity\":1,\"yawSensitivity\":1,\"pitchSensitivity\":1,\"aimBoundaryScale\":1}ACTIVE_PHASE: playingAIM_BOUNDARY_DOM: {\"testid\":\"aim-boundary-frame\",\"shape\":\"rounded-rect\",\"viewportWidth\":\"1280.0\",\"viewportHeight\":\"720.0\",\"widthPx\":\"384.00\",\"heightPx\":\"252.00\",\"cornerRadiusPx\":\"37.80\",\"widthFraction\":\"0.3000\",\"heightFraction\":\"0.3500\",\"aimBoundaryScale\":\"1.000\"}POINTER_LOCK_NATIVE: {\"pointerLocked\":true,\"lockOwnedByTarget\":true,\"pointerLockElementTag\":\"CANVAS\",\"lastMovementX\":-640,\"lastMovementY\":-360,\"accumulatedX\":0,\"accumulatedY\":0,\"warpSpikesFiltered\":2}BASELINE: {\"headingDeg\":0,\"pitchDeg\":0,\"yawVel\":0,\"pitchVel\":0,\"speed\":23.4,\"boostEnergy\":100,\"isBoosting\":false,\"aimScreenX\":0.5,\"aimScreenY\":0.5,\"steeringZone\":\"deadzone\",\"fps\":1,\"warpFiltered\":2}SMALL_ACTIVE: {\"headingDeg\":0,\"pitchDeg\":0,\"yawVel\":0,\"pitchVel\":0,\"speed\":23.4,\"boostEnergy\":100,\"isBoosting\":false,\"aimScreenX\":0.5,\"aimScreenY\":0.5,\"steeringZone\":\"deadzone\",\"fps\":1,\"warpFiltered\":2}SMALL_STOPPED: {\"headingDeg\":0,\"pitchDeg\":0,\"yawVel\":0,\"pitchVel\":0,\"speed\":23.4,\"boostEnergy\":100,\"isBoosting\":false,\"aimScreenX\":0.5,\"aimScreenY\":0.5,\"steeringZone\":\"deadzone\",\"fps\":1,\"warpFiltered\":2}SMALL_DRIFT_CHECK: {\"headingDeg\":0,\"pitchDeg\":0,\"yawVel\":0,\"pitchVel\":0,\"speed\":23.4,\"boostEnergy\":100,\"isBoosting\":false,\"aimScreenX\":0.5,\"aimScreenY\":0.5,\"steeringZone\":\"deadzone\",\"fps\":1,\"warpFiltered\":2}LARGE_SWEEP: {\"totalPxDispatched\":1800,\"totalYawDeg\":36.9,\"maxYawVelRadSec\":2.835,\"stoppedYawVel\":-2.0729,\"driftYawDeltaDeg\":0,\"stoppedReticle\":[0.6097,0.5]}REVERSE_TRACK: {\"afterRight\":{\"hdg\":0,\"yawVel\":0},\"duringLeft\":{\"hdg\":0,\"yawVel\":0},\"afterStop\":{\"hdg\":0,\"yawVel\":0}}BOOST_AND_STEER: {\"headingDeg\":21.97,\"pitchDeg\":18.14,\"yawVel\":-0.3882,\"pitchVel\":0.2717,\"speed\":110.3,\"boostEnergy\":90.3,\"isBoosting\":true,\"aimScreenX\":0.5205,\"aimScreenY\":0.4819,\"steeringZone\":\"active\",\"fps\":3,\"warpFiltered\":2}CONSOLE_ERRORS: []"
