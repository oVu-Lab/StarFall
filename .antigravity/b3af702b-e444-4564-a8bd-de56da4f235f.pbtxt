            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Direct Arcade 6-DoF space flight controller."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Ship coordinate system: Forward = -Z, Right = +X, Up = +Y."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Direct Arcade Mouse Steering Pipeline:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * 1. Relative Pointer Lock deltas (`mouseDeltaX`, `mouseDeltaY`) from InputManager convert"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *    directly into requested angular rates via one centralized constant (`baseRadiansPerPixel`)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *    plus global `mouseSensitivity` and independent `yawSensitivity` / `pitchSensitivity`."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * 2. A single-stage exponential velocity filter (`angularSmoothing`) smooths discrete mouse"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *    polling ticks with minimal latency, guarantees frame-rate-independent total rotation per"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *    pixel, clamps cleanly to controlled ship max angular speeds, and stops with zero drift."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * 3. The centered 30% x 35% rounded-rectangle aim boundary is purely visual/framing for HUD"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " *    reticle feedback and NEVER alters steering sensitivity or interrupts continuous turning."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "export class FlightController {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  public readonly position = new THREE.Vector3(0, 12, 40);"
