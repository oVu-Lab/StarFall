            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "function stepAngularVelocity("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  current: number,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
