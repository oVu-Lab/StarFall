    combined_output {
      full: "=== src/core/loop.ts ===/** * The fixed-step clock. * * Turns a stream of irregular frame times into a whole number of simulation * ticks plus the leftover, which is what lets the simulation run at a rate the * display cannot influence. * * This lives in its own module rather than inline in the render loop for one * reason: inline, it was the only load-bearing part of the fixed step that no * test could reach. `main.ts` never runs headless, so a bug here \342\200\224 dropping owed * time, or letting the accumulator run away on a slow frame \342\200\224 would have been * invisible to `npm run check` while breaking the exact property the fixed step * exists to provide. */export interface FrameBudget {  /** Whole simulation ticks this frame owes. */  ticks: number  /**   * Real seconds this frame gets for presentation, after clamping. Particles,   * camera follow and world spin run on this rather than on the tick, so they   * stay smooth on a display faster than the tick rate.   */  frameSeconds: number  /**   * How far past the last tick the frame lands, 0..1. The blend factor for   * interpolating everything drawn between two ticks.   */  alpha: number}export interface StepClock {  /** Feed a frame\'s elapsed real time and get back what to run. */  advance(elapsedSeconds: number): FrameBudget}/** * @param step          seconds of simulation per tick * @param maxFrame      longest frame accepted, in seconds. Time beyond this is *                      discarded rather than queued: a frame that arrives late *                      enough would otherwise owe more simulation than the next *                      frame has time to run, making the next frame later *                      still. Dropping the excess loses a moment; queueing it *                      loses the session. */export function createStepClock(step: number, maxFrame: number): StepClock {  let accumulator = 0  return {    advance(elapsedSeconds) {      const frameSeconds = Math.min(Math.max(0, elapsedSeconds), maxFrame)      accumulator += frameSeconds      // `floor` and a single subtraction rather than a while-loop: the      // remainder has to survive into the next frame, and a loop that      // decremented past zero would quietly discard it.      const ticks = Math.floor(accumulator / step)      accumulator -= ticks * step      return { ticks, frameSeconds, alpha: accumulator / step }    },  }}=== src/game/game.ts input/controls usage ===45-  TIMED_WARN_AT,46-  type PickupKind,47-} from \'../world/pickups\'48-import { EnemyPilot } from \'./ai\'49-import { BLAST_RADIUS, createBfg, SPOOL_THROTTLE_CAP, type Bfg } from \'./bfg\'50-import { createBolts, FACTION_AI, FACTION_ENVIRONMENT, FACTION_PLAYER, type Bolts, type Faction } from \'./bolts\'51-import { createShipCollisions } from \'./ship-collisions\'52-import { FEED_RING, NOBODY, THE_ARENA, type KillEvent, type LockRef, type SeatState, type ShipState, type SquadronState, type WorldSnapshot } from \'../net/snapshot\'53:import { createChaseCamera, type ChaseCamera } from \'./chase\'54-import { createFx, type Fx } from \'./fx\'55-import type { Hud, HudContact, HudTarget } from \'./hud\'56-import {57-  accuracyOf,58-  createSeats,59-  creditDamage,60-  creditHit,61-  creditKill,--68-  type SeatPhase,69-} from \'./roster\'70-import { Ship, type Controls, type ShipContext } from \'./ship\'71-72-/**73- * Seconds of simulation per tick.74- *75- * Fixed, and owned here rather than taken from the frame, because the flight76: * model integrates per step: with a variable delta the same stick input covers77- * different ground on a 30 Hz laptop and a 144 Hz desktop, and a hull\'s turn78- * rate \342\200\224 the balance lever the whole three-airframe design rests on \342\200\224 stops79- * being one number. It is also the precondition for a run replaying: a replay80- * can reproduce a list of inputs, but it can never reproduce a list of frame81- * times.82- *83- * 60 Hz matches the rate the flight model was tuned at and the rate84- * `scripts/simcheck.ts` has always asserted against.85- */86-export const STEP = 1 / 6087-88-/**89- * What a participant\'s hull is worth to whoever downs it, as a multiple of the90- * bounty the same airframe carries when the squadron flies it.91- *92- * A number, not a mechanism, and it is here so that it is one number: a human93: * on the stick is harder to hit than the scripted pilot, and the match should94- * pay for it. Two is a first guess and a balance lever, not a finding.95- */96-export const PARTICIPANT_BOUNTY_MULT = 297-98-/**99- * Place every line by score, equal scores sharing a place, and mark the winners:100- * the seats placed first and still flying. Eliminated seats place after every101- * flying one whatever their score \342\200\224 a seat that is not in the arena when it is--496-  const weapons = createWeaponPresentation(audio)497-  let presentingWeapons = false498-  const fx: Fx = createFx()499-  scene.add(bolts.mesh, weapons.mesh, fx.group)500-501-  /**502-   * One BFG per seat, created in `start`. Player-only in the original sense:503-   * humans have it, the squadron does not. Each seat carries its own two504:   * charges so a second stick is not sharing the first one\'s magazine.505-   */506-  let bfgs: Bfg[] = []507-  let chargeTimer = 0508-  /**509-   * True while a BFG blast is applying damage, so a sphere that catches three510-   * hulls counts as one accuracy hit rather than three.511-   */512-  let resolvingBlast = false513-  let resolvingCollision = false514-515:  const chase: ChaseCamera = createChaseCamera(camera)516-517-  // The listener, rewritten by `start` to whichever seat this machine presents.518-  // Initialised to seat 0\'s faction rather than left undefined so a `Ship`519-  // constructed before any match \342\200\224 nothing does today \342\200\224 still has a coherent520-  // context.521-  const ctx: ShipContext = {522-    hazards: environment.hazards,523-    audio,--737-    return best738-  }739-740-  /**741-   * The seat a hit is credited to, or nobody.742-   *743-   * A bolt names its author, and that is the credit. Damage the arena inflicts744-   * \342\200\224 a mine, a scrape \342\200\224 arrives as `FACTION_ENVIRONMENT`, and goes to the seat745:   * that last landed a hit on the victim: a hostile chased onto a mine still746:   * scores for the chaser, which the README sells as a tactic. In a match of747-   * one seat, the arena\'s damage to a hostile is that seat\'s \342\200\224 exactly what the748-   * old \"blame the other side\" produced there \342\200\224 so the single-player scoreline749-   * is unchanged bit for bit. With more seats and no last hitter it is nobody\'s.750-   * The star names the victim\'s own faction and is never a hit for anyone.751-   */752-  function hitCredit(from: Faction, victim: Ship): Participant | null {753-    if (from === FACTION_ENVIRONMENT) return lastHitter.get(victim) ?? soleSeat()754-    return seatOf(seats, from) ?? null--886-    }887-888-    ship.onDeath = (self, from) => {889-      const scorer = bountyGoesTo(from, self)890-      const award = scorer ? creditKill(scorer, self.spec.bounty) : 0891-      fx.explode(self.position, self.accent, self.spec.id === \'drone\' ? 1.5 : 1.1)892-      audio.explosion(self.spec.id === \'drone\')893-      const watcher = local()894:      chase.shake(watcher && self.position.distanceTo(watcher.ship.position) < 420 ? 0.8 : 0.25)895-      recordKill(scorer, from, null, self.spec.id, award)896-    }897-898-    scene.add(ship.visual.group)899-    const pilot = new EnemyPilot(ship, subRng(runSeed, STREAM.pilot + index))900-    pilotIds.set(pilot, index)901-    pilots.push(pilot)902-    refreshTargets()--944-      rebuildAvoidList()"
