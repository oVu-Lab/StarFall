    exit_code: 0
    blocking: true
    wait_ms_before_async: 5000
    combined_output {
      full: "/** * NEON ORBIT \342\200\224 entry point. * * Owns the single render loop and the screen state machine. Everything * expensive (renderer, post-processing chain, planet, stations) is built once * at boot and shared between the hangar and the dogfight, so choosing a ship * and launching never costs a load. */import \'./style.css\'import * as THREE from \'three\'import { createAudio } from \'./core/audio\'import { createDevHook, installDevHook } from \'./core/dev-hook\'import { createInput } from \'./core/input\'import { createStepClock } from \'./core/loop\'import { bestFor, lastShip, recordRun, rememberShip, type RunResult } from \'./core/scores\'import { createStage } from \'./core/stage\'import { createPilot } from \'./game/controls\'import { createGame, STEP } from \'./game/game\'import { createHud } from \'./game/hud\'import type { Controls } from \'./game/ship\'import type { ShipId } from \'./ships/specs\'import { joinMatch, modeFromLocation, openLobby, startHosting, type Hosting, type Joining, type Lobby } from \'./net/browser\'import { LINK_GRACE_MS } from \'./net/link\'import { stepSession } from \'./net/frame\'import type { LobbyState } from \'./net/session\'import { cancelPotSeat, createServerRoom, joinServer, potClaimStatus, potPayment, serverJoinLink, serverPotEnabled, serverUrl,  type PotPaymentStatus } from \'./net/server\'import { createHangar } from \'./ui/hangar\'import { createWing } from \'./ui/wing\'import { createDebriefPanel, createPausePanel } from \'./ui/panels\'import { createPotClaimPanel } from \'./ui/pot-claim\'import { potLaunchAction } from \'./ui/pot-launch\'import { createScreens } from \'./ui/screens\'import { buildEnvironment } from \'./world/environment\'/** * Longest frame the simulation will accept, so a tab-switch cannot teleport * ships through each other. * * With a fixed step this also bounds catch-up work: at most `MAX_FRAME / STEP` * ticks run for any one frame. Without the clamp, a frame that arrives late * enough queues more simulation than the next frame has time to run, which * makes the next frame later still \342\200\224 the loop never catches up and the game * grinds to a halt instead of simply dropping the lost time. */const MAX_FRAME = 1 / 5function boot() {  const canvas = document.getElementById(\'scene\') as HTMLCanvasElement | null  const overlay = document.getElementById(\'overlay\')  if (!canvas || !overlay) throw new Error(\'Missing #scene canvas or #overlay root\')  /* ---- Boot splash ------------------------------------------------------- */  const splash = document.createElement(\'div\')  splash.id = \'boot\'  splash.innerHTML = `    <div class=\"stack\">      <h1 class=\"title glow-cyan\">NEON ORBIT</h1>      <div class=\"bar\"><i></i></div>      <div class=\"hint\">Building the arena</div>    </div>`  overlay.append(splash)  /* ---- Core systems ----------------------------------------------------- */  const stage = createStage(canvas)  const environment = buildEnvironment()  stage.scene.add(environment.group)  const input = createInput(canvas, () => screens.screen === \'flight\')  const pilot = createPilot()  const audio = createAudio()  const hud = createHud(overlay)  let pendingResult: RunResult | null = null  // `?host` or `?join=CODE` on the URL. Solo is the shipped game and takes none  // of the branches below; see `net/browser.ts`. `mode` is reassigned to solo  // when a join fails and the player chooses to fly alone, which is what makes  // the frame loop step the simulation again.  let mode = modeFromLocation(window.location.search)  const endpoint = serverUrl(window.location.search)  const requestedPot = Number(new URLSearchParams(window.location.search).get(\'pot\'))  const potBuyInSats = mode.kind === \'host\' && endpoint && Number.isInteger(requestedPot) &&    requestedPot >= 10 && requestedPot <= 1000 ? requestedPot : undefined  let potAvailable = false  let activePotRoom = false  let potPoll: number | null = null  let hosting: Hosting | null = null  let joining: Joining | null = null  let lobby: Lobby | null = null  let joinAttempt = 0  let serverCanLaunch = false  let serverResume: { endpoint: string; code: string; token: string } | null = null  /** The one line of network status on screen, in either mode. */  const netPanel = document.createElement(\'div\')  netPanel.id = \'net\'  netPanel.style.cssText =    \'position:fixed;top:12px;left:50%;transform:translateX(-50%);z-index:50;display:none;\' +    \'font:13px/1.5 monospace;color:#6be6ff;background:rgba(0,0,0,.6);padding:8px 12px;\' +    \'border:1px solid #6be6ff66;max-width:90vw;text-align:center;pointer-events:auto\'  overlay.append(netPanel)  function netStatus(html: string) {    netPanel.style.display = \'block\'    netPanel.innerHTML = html  }  /* ---- Screens ---------------------------------------------------------- */  const hangar = createHangar({    parent: overlay,    scene: stage.scene,    camera: stage.camera,    audio,    onLaunch: (id) => startRun(id),    onHost: endpoint ? (seats, buyInSats) => {      const url = new URL(window.location.href)      url.searchParams.delete(\'join\')      url.searchParams.delete(\'p2p\')      url.searchParams.set(\'host\', String(seats))      if (buyInSats === undefined) url.searchParams.delete(\'pot\')      else url.searchParams.set(\'pot\', String(buyInSats))      window.location.assign(url.toString())    } : undefined,    onSelect: (id) => {      lobby?.wing.setShip(id)      joining?.selectShip?.(id)    },  })  if (endpoint) void serverPotEnabled(endpoint).then(enabled => {    potAvailable = enabled    hangar.potOptions(enabled && mode.kind === \'solo\')  })  function storedPotClaim(code: string): { seat: number; token: string } | undefined {    if (!endpoint) return undefined    try {      const raw = localStorage.getItem(`neonorbit:pot:${endpoint}:${code}`)      if (!raw) return undefined      const claim = JSON.parse(raw) as { seat: number; token: string }      if (!Number.isInteger(claim.seat) || claim.seat < 0 || claim.seat > 3 ||          !/^[A-Za-z0-9_-]{43}$/.test(claim.token)) return undefined      return claim    } catch { return undefined }  }  function clearPotPoll() {    if (potPoll !== null) { window.clearInterval(potPoll); potPoll = null }  }  const wing = createWing(hangar.root.querySelector(\'.stage\')!, () => {    const code = new URLSearchParams(window.location.search).get(\'join\')    const claim = code ? storedPotClaim(code) : undefined    if (endpoint && code && claim) {      void cancelPotSeat(endpoint, code, claim.seat, claim.token)        .then(() => checkPotClaim(code))"
    }
    command_line: "cat /tmp/neon-orbit/src/main.ts | head -n 160"
    proposed_command_line: "cat /tmp/neon-orbit/src/main.ts | head -n 160"
    shell_name: "bash"
  }
