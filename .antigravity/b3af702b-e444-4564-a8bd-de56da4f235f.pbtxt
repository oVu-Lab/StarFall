            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Eliminate sub-epsilon floating-point residual when centered"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (Math.abs(this.stickX) < 1e-5) this.stickX = 0;"
