        use_fast_apply: true
        replacement_chunks {
          target_content: "import {\n  clampToRoundedRect,\n  computeRoundedRectBoundary,\n  createRoundedRectBoundary,\n  createRoundedRectClampResult,\n  createVirtualJoystickEvaluation,\n  evaluateVirtualJoystick,\n  type RoundedRectBoundary,\n  type RoundedRectClampResult,\n  type VirtualJoystickEvaluation,\n} from \'./AimBoundary\';\nimport type { InputSnapshot } from \'./InputManager\';\n\nexport { evaluateResponseCurveScalar, evaluateVirtualJoystick } from \'./AimBoundary\';\nexport type {\n  RoundedRectBoundary,\n  RoundedRectClampResult,\n  VirtualJoystickEvaluation,\n} from \'./AimBoundary\';\n\n// Reusable scratch objects (zero per-frame GC allocations)\nconst _AXIS_X = new THREE.Vector3(1, 0, 0);\nconst _AXIS_Y = new THREE.Vector3(0, 1, 0);\nconst _AXIS_Z = new THREE.Vector3(0, 0, 1);\nconst _FORWARD_LOCAL = new THREE.Vector3(0, 0, -1);\n\nconst _qYaw = new THREE.Quaternion();\nconst _qPitch = new THREE.Quaternion();\nconst _qRoll = new THREE.Quaternion();\nconst _forwardWorld = new THREE.Vector3();\nconst _rightWorld = new THREE.Vector3();\nconst _upWorld = new THREE.Vector3();\nconst _desiredVel = new THREE.Vector3();\nconst _euler = new THREE.Euler(0, 0, 0, \'YXZ\');\n\nfunction createEmptyEnemyMarkers(count = 6): ProjectedEnemyMarker[] {\n  const list: ProjectedEnemyMarker[] = [];\n  for (let i = 0; i < count; i++) {\n    list.push({\n      active: false,\n      entityId: \'\',\n      callsign: \'\',\n      personalityLabel: \'\',\n      aiState: \'patrol\',\n      screenX: 0.5,\n      screenY: 0.5,\n      inFront: false,\n      onScreen: false,\n      distance: 0,\n      healthRatio: 1,\n      isPrimaryTarget: false,\n      isPriorityTarget: false,\n      leadX: 0.5,\n      leadY: 0.5,\n      leadVisible: false,\n    });\n  }\n  return list;\n}\n\nexport function createInitialTelemetry(ship: ShipConfig): FlightTelemetry {\n  const initWidthPx = 1280 * STEERING_CONFIG.aimBoundaryWidth;\n  const initHeightPx = 720 * STEERING_CONFIG.aimBoundaryHeight;\n  const initCornerPx =\n    Math.min(initWidthPx * 0.5, initHeightPx * 0.5) * STEERING_CONFIG.aimBoundaryCornerRadius;\n\n  return {\n    speed: 0,\n    signedSpeed: 0,\n    maxSpeed: ship.flight.maxSpeed,\n    effectiveMaxSpeed: ship.flight.maxSpeed,\n    throttle: 0,\n    boostEnergy: ship.flight.maxBoostEnergy,\n    maxBoostEnergy: ship.flight.maxBoostEnergy,\n    isBoosting: false,\n    boostDepleted: false,\n    boostIntensity: 0,\n    hull: ship.maxHull,\n    maxHull: ship.maxHull,\n    yawRate: 0,\n    pitchRate: 0,\n    rollRate: 0,\n    aimNormalizedX: 0,\n    aimNormalizedY: 0,\n    aimScreenX: 0.5,\n    aimScreenY: 0.5,\n    aimBoundaryWidthPx: initWidthPx,\n    aimBoundaryHeightPx: initHeightPx,\n    aimBoundaryCornerRadiusPx: initCornerPx,\n    joystickRadialMagnitude: 0,\n    steeringOutputX: 0,\n    steeringOutputY: 0,\n    boresightScreenX: 0.5,\n    boresightScreenY: 0.5,\n    steeringZone: \'deadzone\',\n    headingDeg: 0,\n    pitchDeg: 0,\n    rollDeg: 0,\n    altitude: 0,\n    status: \'STANDBY\',\n    pointerLocked: false,\n    isFiring: false,\n    weaponName: ship.weapons.primaryName,\n    weaponCooldownRatio: 0,\n    hitMarkerTimer: 0,\n    killMarkerTimer: 0,\n    damageFlashTimer: 0,\n    muzzleFlashLeft: 0,\n    muzzleFlashRight: 0,\n    playerDestroyed: false,\n    combatStats: {\n      kills: 0,\n      shotsFired: 0,\n      shotsHit: 0,\n      damageDealt: 0,\n      damageTaken: 0,\n      score: 0,\n      wave: 1,\n      activeEnemies: 0,\n    },\n    enemyMarkers: createEmptyEnemyMarkers(6),\n    fps: 60,\n    frameTimeMs: 16.6,\n    drawCalls: 0,\n    triangles: 0,\n    activeProjectiles: 0,\n    activeParticles: 0,\n    activeEnemies: 0,\n    lastAssetLoadMs: 0,\n    cachedAssetCount: 0,\n  };\n}\n\nconst GIMBAL_MAX_YAW_RAD = 0.22;\nconst GIMBAL_MAX_PITCH_RAD = 0.16;\nconst _gimbalDirLocal = new THREE.Vector3();\n\n/**\n * Controlled angular acceleration + frame-rate-independent damping step.\n * - Smoothly tracks requested angular velocity with crisp responsiveness and low latency.\n * - Caps maximum angular acceleration per frame so abrupt full-stick slams accelerate smoothly\n *   without snapping jerk, while small corrections remain immediate and un-clipped.\n * - Applies extra stopping damping when decelerating toward zero or reversing direction so\n *   returning the virtual joystick toward center settles cleanly without excessive inertia.\n */\nfunction stepAngularVelocity(\n  current: number,\n  target: number,\n  maxAccel: number,\n  dampingRate: number,\n  dt: number,\n): number {\n  const isStoppingOrReversing =\n    Math.abs(target) < Math.abs(current) || target * current < 0;\n  const effectiveLambda = isStoppingOrReversing\n    ? dampingRate * STEERING_CONFIG.stoppingDampingBoost\n    : dampingRate;\n  const alpha = 1 - Math.exp(-effectiveLambda * dt);\n  const desiredNext = current + (target - current) * alpha;\n\n  const maxStep = maxAccel * dt;\n  const delta = THREE.MathUtils.clamp(desiredNext - current, -maxStep, maxStep);\n  const next = current + delta;\n\n  // Cleanly settle tiny sub-threshold residual drift when target is zero\n  if (target === 0 && Math.abs(next) < 1e-4) {\n    return 0;\n  }\n  return next;\n}\n\n/**\n * Arcade 6DOF space flight controller using a Virtual Joystick mouse model.\n * Ship coordinate system: Forward = -Z, Right = +X, Up = +Y.\n *\n * Virtual Joystick Pipeline:\n * 1. Relative Pointer Lock deltas from InputManager displace the logical virtual joystick\n *    vector `(joystickX, joystickY)` scaled by `mouseSensitivity` and normalized for viewport size.\n * 2. `clampToRoundedRect` keeps `(joystickX, joystickY)` strictly bounded on the centered\n *    rounded-rectangle boundary (30% W x 35% H default, scaled by `joystickRadius`), allowing\n *    indefinite physical mouse travel without runaway sensitivity or unwind lag.\n * 3. `evaluateVirtualJoystick` computes exact radial magnitude `r in [0, 1]`, applies center\n *    deadzone and the conservative smooth radial response curve, and outputs normalized\n *    `(steerX, steerY)` targets.\n * 4. Independent yaw and pitch sensitivities convert normalized targets into desired ship\n *    angular velocities, tracked via controlled angular acceleration and damping.\n */\nexport class FlightController {\n  public readonly position = new THREE.Vector3(0, 12, 40);\n  public readonly quaternion = new THREE.Quaternion();\n  public readonly velocity = new THREE.Vector3(0, 0, -24);\n\n  // Controlled angular velocities (rad/s) in ship local space\n  public yawVelocity = 0;\n  public pitchVelocity = 0;\n  public rollVelocity = 0;\n\n  // Bounded virtual joystick displacement in viewport CSS pixels (centered at 0, 0)\n  public joystickX = 0;\n  public joystickY = 0;\n\n  // Normalized joystick deflection [-1..1] relative to boundary half-extents (for HUD & gimbal)\n  public aimCursorX = 0;\n  public aimCursorY = 0;\n\n  // Visual banking angle layered on the ship mesh for tactile feel\n  public visualBankAngle = 0;\n\n  // Live viewport-relative rounded-rectangle boundary, clamp, and response state (zero per-frame allocs)\n  public readonly aimBoundary: RoundedRectBoundary = createRoundedRectBoundary();\n  public readonly aimClamp: RoundedRectClampResult = createRoundedRectClampResult();\n  public readonly joystickEval: VirtualJoystickEvaluation = createVirtualJoystickEvaluation();\n\n  private lastViewportWidth = 0;\n  private lastViewportHeight = 0;\n\n  private ship: ShipConfig;\n  private boostEnergy: number;\n  private boostCooldownTimer = 0;\n  private boostLockedOut = false;\n  private boostIntensity = 0;\n  private wasBoosting = false;\n  private hull: number;\n  private boostJustEngaged = false;\n\n  public constructor(ship: ShipConfig) {\n    this.ship = ship;\n    this.boostEnergy = ship.flight.maxBoostEnergy;\n    this.hull = ship.maxHull;\n  }\n\n  public setShipConfig(ship: ShipConfig): void {\n    this.ship = ship;\n    this.boostEnergy = Math.min(this.boostEnergy, ship.flight.maxBoostEnergy);\n    this.hull = ship.maxHull;\n  }\n\n  public centerAimCursor(): void {\n    this.joystickX = 0;\n    this.joystickY = 0;\n    this.aimCursorX = 0;\n    this.aimCursorY = 0;\n    clampToRoundedRect(0, 0, this.aimBoundary, this.aimClamp);\n    evaluateVirtualJoystick(\n      0,\n      0,\n      this.aimBoundary,\n      STEERING_CONFIG.deadzone,\n      STEERING_CONFIG.responseCurve,\n      STEERING_CONFIG.precisionSensitivity,\n      STEERING_CONFIG.maxSteeringInput,\n      this.joystickEval,\n    );\n  }\n\n  public reset(startPosition?: THREE.Vector3): void {\n    if (startPosition) {\n      this.position.copy(startPosition);\n    } else {\n      this.position.set(0, 12, 40);\n    }\n    this.quaternion.identity();\n    this.velocity.set(0, 0, -28);\n    this.yawVelocity = 0;\n    this.pitchVelocity = 0;\n    this.rollVelocity = 0;\n    this.centerAimCursor();\n    this.visualBankAngle = 0;\n    this.boostEnergy = this.ship.flight.maxBoostEnergy;\n    this.boostCooldownTimer = 0;\n    this.boostLockedOut = false;\n    this.boostIntensity = 0;\n    this.wasBoosting = false;\n    this.hull = this.ship.maxHull;\n  }\n\n  public getBoostJustEngaged(): boolean {\n    return this.boostJustEngaged;\n  }\n\n  /**\n   * Returns unit world-space firing direction with subtle forward gimbal convergence\n   * toward the active bounded virtual joystick offset.\n   */\n  public getAimDirectionWorld(out: THREE.Vector3): THREE.Vector3 {\n    const gimbalYaw = THREE.MathUtils.clamp(this.aimCursorX, -1, 1) * GIMBAL_MAX_YAW_RAD;\n    const gimbalPitch = THREE.MathUtils.clamp(-this.aimCursorY, -1, 1) * GIMBAL_MAX_PITCH_RAD;\n    _gimbalDirLocal.set(Math.sin(gimbalYaw), Math.sin(gimbalPitch), -1).normalize();\n    out.copy(_gimbalDirLocal).applyQuaternion(this.quaternion).normalize();\n    return out;\n  }\n\n  /**\n   * Computes the 3D world-space convergence point along the player\'s firing ray.\n   */\n  public getAimTargetPoint(out: THREE.Vector3, distance: number): THREE.Vector3 {\n    this.getAimDirectionWorld(out);\n    out.multiplyScalar(distance).add(this.position);\n    return out;\n  }\n\n  /**\n   * Advances arcade flight simulation by delta time `dt` (seconds) and writes live telemetry.\n   * Uses live game viewport dimensions (viewportWidth x viewportHeight) for joystick boundary geometry.\n   */\n  public update(\n    dt: number,\n    input: InputSnapshot,\n    settings: GameSettings,\n    telemetry: FlightTelemetry,\n    viewportWidth = typeof window !== \'undefined\' ? window.innerWidth : 1280,\n    viewportHeight = typeof window !== \'undefined\' ? window.innerHeight : 720,\n  ): void {\n    const profile = this.ship.flight;\n    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);\n    const vw = Math.max(1, viewportWidth);\n    const vh = Math.max(1, viewportHeight);\n\n    // Preserve proportional virtual joystick position seamlessly across viewport resizes\n    if (this.lastViewportWidth > 0 && this.lastViewportHeight > 0) {\n      if (vw !== this.lastViewportWidth) {\n        this.joystickX *= vw / this.lastViewportWidth;\n      }\n      if (vh !== this.lastViewportHeight) {\n        this.joystickY *= vh / this.lastViewportHeight;\n      }\n    }\n    this.lastViewportWidth = vw;\n    this.lastViewportHeight = vh;\n\n    // 1. Recompute viewport-relative rounded-rectangle joystick boundary (30% W x 35% H base)\n    computeRoundedRectBoundary(\n      vw,\n      vh,\n      settings.joystickRadius,\n      STEERING_CONFIG.aimBoundaryWidth,\n      STEERING_CONFIG.aimBoundaryHeight,\n      STEERING_CONFIG.aimBoundaryCornerRadius,\n      this.aimBoundary,\n    );\n\n    // 2. Integrate relative Pointer Lock deltas onto the bounded virtual joystick vector.\n    //    Resolution-normalized against 720p reference height so physical mouse travel feels\n    //    consistent across different viewport sizes.\n    const mouseSens = THREE.MathUtils.clamp(\n      settings.mouseSensitivity,\n      STEERING_BOUNDS.mouseSensitivity.min,\n      STEERING_BOUNDS.mouseSensitivity.max,\n    );\n    const resScale = THREE.MathUtils.clamp(\n      vh / STEERING_CONFIG.referenceViewportHeight,\n      0.5,\n      2.5,\n    );\n    const inputScale = mouseSens * resScale;\n    const ySign = settings.invertY ? -1 : 1;\n\n    const candidateX = this.joystickX + input.mouseDeltaX * inputScale;\n    const candidateY = this.joystickY + input.mouseDeltaY * ySign * inputScale;\n\n    // 3. Clamp logical virtual joystick strictly onto the rounded-rectangle boundary.\n    //    Physical mouse can continue moving indefinitely via Pointer Lock, while logical\n    //    displacement remains bounded so output holds cleanly at max without unwind lag.\n    clampToRoundedRect(candidateX, candidateY, this.aimBoundary, this.aimClamp);\n    this.joystickX = this.aimClamp.clampedX;\n    this.joystickY = this.aimClamp.clampedY;\n    this.aimCursorX = this.aimClamp.normalizedX;\n    this.aimCursorY = this.aimClamp.normalizedY;\n\n    // 4. Evaluate smooth radial virtual joystick response (deadzone + conservative curve + max cap)\n    evaluateVirtualJoystick(\n      this.joystickX,\n      this.joystickY,\n      this.aimBoundary,\n      settings.deadzone,\n      settings.responseCurve,\n      STEERING_CONFIG.precisionSensitivity,\n      STEERING_CONFIG.maxSteeringInput,\n      this.joystickEval,\n    );\n\n    // 5. Convert normalized joystick targets into independent yaw & pitch angular velocity targets\n    const yawSens = THREE.MathUtils.clamp(\n      settings.yawSensitivity,\n      STEERING_BOUNDS.yawSensitivity.min,\n      STEERING_BOUNDS.yawSensitivity.max,\n    );\n    const pitchSens = THREE.MathUtils.clamp(\n      settings.pitchSensitivity,\n      STEERING_BOUNDS.pitchSensitivity.min,\n      STEERING_BOUNDS.pitchSensitivity.max,\n    );\n\n    // Optional arrow-key steering blends cleanly alongside mouse virtual joystick\n    let keyYaw = 0;\n    if (input.keyYawLeft) keyYaw += 0.85;\n    if (input.keyYawRight) keyYaw -= 0.85;\n    let keyPitch = 0;\n    if (input.keyPitchUp) keyPitch += 0.85;\n    if (input.keyPitchDown) keyPitch -= 0.85;\n\n    const targetYawRate =\n      THREE.MathUtils.clamp(\n        -this.joystickEval.steerX * yawSens + keyYaw,\n        -STEERING_CONFIG.maxSafeYawMultiplier,\n        STEERING_CONFIG.maxSafeYawMultiplier,\n      ) * profile.yawSpeed;\n\n    const targetPitchRate =\n      THREE.MathUtils.clamp(\n        -this.joystickEval.steerY * pitchSens + keyPitch,\n        -STEERING_CONFIG.maxSafePitchMultiplier,\n        STEERING_CONFIG.maxSafePitchMultiplier,\n      ) * profile.pitchSpeed;\n\n    // Controlled angular acceleration & damping (scaled proportionally by hull maneuverability)\n    const shipAgility = profile.angularDamping / 7.5;\n    const maxAngularAccel = STEERING_CONFIG.angularAcceleration * shipAgility;\n    const dampingRate = STEERING_CONFIG.angularDamping * shipAgility;\n\n    this.yawVelocity = stepAngularVelocity(\n      this.yawVelocity,\n      targetYawRate,\n      maxAngularAccel,\n      dampingRate,\n      safeDt,\n    );\n    this.pitchVelocity = stepAngularVelocity(\n      this.pitchVelocity,\n      targetPitchRate,\n      maxAngularAccel,\n      dampingRate,\n      safeDt,\n    );\n\n    const stepYaw = this.yawVelocity * safeDt;\n    const stepPitch = this.pitchVelocity * safeDt;\n\n    // 6. Independent Roll via A / D (exact Phase 1 roll feel preserved)\n    let rollDir = 0;\n    if (input.rollLeft) rollDir += 1;\n    if (input.rollRight) rollDir -= 1;\n    const targetRollRate = rollDir * profile.rollSpeed;\n    const rollAlpha = 1 - Math.exp(-(profile.angularDamping * 1.25) * safeDt);\n    this.rollVelocity = THREE.MathUtils.lerp(this.rollVelocity, targetRollRate, rollAlpha);\n    const stepRoll = this.rollVelocity * safeDt;"
          replacement_content: "import {\n  clampToRoundedRect,\n  computeRoundedRectBoundary,\n  createRoundedRectBoundary,\n  createRoundedRectClampResult,\n  type RoundedRectBoundary,\n  type RoundedRectClampResult,\n} from \'./AimBoundary\';\nimport type { InputSnapshot } from \'./InputManager\';\n\nexport type { RoundedRectBoundary, RoundedRectClampResult } from \'./AimBoundary\';\n\n// Reusable scratch objects (zero per-frame GC allocations)\nconst _AXIS_X = new THREE.Vector3(1, 0, 0);\nconst _AXIS_Y = new THREE.Vector3(0, 1, 0);\nconst _AXIS_Z = new THREE.Vector3(0, 0, 1);\nconst _FORWARD_LOCAL = new THREE.Vector3(0, 0, -1);\n\nconst _qYaw = new THREE.Quaternion();\nconst _qPitch = new THREE.Quaternion();\nconst _qRoll = new THREE.Quaternion();\nconst _forwardWorld = new THREE.Vector3();\nconst _rightWorld = new THREE.Vector3();\nconst _upWorld = new THREE.Vector3();\nconst _desiredVel = new THREE.Vector3();\nconst _euler = new THREE.Euler(0, 0, 0, \'YXZ\');\n\nfunction createEmptyEnemyMarkers(count = 6): ProjectedEnemyMarker[] {\n  const list: ProjectedEnemyMarker[] = [];\n  for (let i = 0; i < count; i++) {\n    list.push({\n      active: false,\n      entityId: \'\',\n      callsign: \'\',\n      personalityLabel: \'\',\n      aiState: \'patrol\',\n      screenX: 0.5,\n      screenY: 0.5,\n      inFront: false,\n      onScreen: false,\n      distance: 0,\n      healthRatio: 1,\n      isPrimaryTarget: false,\n      isPriorityTarget: false,\n      leadX: 0.5,\n      leadY: 0.5,\n      leadVisible: false,\n    });\n  }\n  return list;\n}\n\nexport function createInitialTelemetry(ship: ShipConfig): FlightTelemetry {\n  const initWidthPx = 1280 * STEERING_CONFIG.aimBoundaryWidth;\n  const initHeightPx = 720 * STEERING_CONFIG.aimBoundaryHeight;\n  const initCornerPx =\n    Math.min(initWidthPx * 0.5, initHeightPx * 0.5) * STEERING_CONFIG.aimBoundaryCornerRadius;\n\n  return {\n    speed: 0,\n    signedSpeed: 0,\n    maxSpeed: ship.flight.maxSpeed,\n    effectiveMaxSpeed: ship.flight.maxSpeed,\n    throttle: 0,\n    boostEnergy: ship.flight.maxBoostEnergy,\n    maxBoostEnergy: ship.flight.maxBoostEnergy,\n    isBoosting: false,\n    boostDepleted: false,\n    boostIntensity: 0,\n    hull: ship.maxHull,\n    maxHull: ship.maxHull,\n    yawRate: 0,\n    pitchRate: 0,\n    rollRate: 0,\n    aimNormalizedX: 0,\n    aimNormalizedY: 0,\n    aimScreenX: 0.5,\n    aimScreenY: 0.5,\n    aimBoundaryWidthPx: initWidthPx,\n    aimBoundaryHeightPx: initHeightPx,\n    aimBoundaryCornerRadiusPx: initCornerPx,\n    joystickRadialMagnitude: 0,\n    steeringOutputX: 0,\n    steeringOutputY: 0,\n    boresightScreenX: 0.5,\n    boresightScreenY: 0.5,\n    steeringZone: \'deadzone\',\n    headingDeg: 0,\n    pitchDeg: 0,\n    rollDeg: 0,\n    altitude: 0,\n    status: \'STANDBY\',\n    pointerLocked: false,\n    isFiring: false,\n    weaponName: ship.weapons.primaryName,\n    weaponCooldownRatio: 0,\n    hitMarkerTimer: 0,\n    killMarkerTimer: 0,\n    damageFlashTimer: 0,\n    muzzleFlashLeft: 0,\n    muzzleFlashRight: 0,\n    playerDestroyed: false,\n    combatStats: {\n      kills: 0,\n      shotsFired: 0,\n      shotsHit: 0,\n      damageDealt: 0,\n      damageTaken: 0,\n      score: 0,\n      wave: 1,\n      activeEnemies: 0,\n    },\n    enemyMarkers: createEmptyEnemyMarkers(6),\n    fps: 60,\n    frameTimeMs: 16.6,\n    drawCalls: 0,\n    triangles: 0,\n    activeProjectiles: 0,\n    activeParticles: 0,\n    activeEnemies: 0,\n    lastAssetLoadMs: 0,\n    cachedAssetCount: 0,\n  };\n}\n\n/**\n * Direct Arcade 6-DoF space flight controller.\n * Ship coordinate system: Forward = -Z, Right = +X, Up = +Y.\n *\n * Direct Arcade Mouse Steering Pipeline:\n * 1. Relative Pointer Lock deltas (`mouseDeltaX`, `mouseDeltaY`) from InputManager convert\n *    directly into requested angular rates via one centralized constant (`baseRadiansPerPixel`)\n *    plus global `mouseSensitivity` and independent `yawSensitivity` / `pitchSensitivity`.\n * 2. A single-stage exponential velocity filter (`angularSmoothing`) smooths discrete mouse\n *    polling ticks with minimal latency, guarantees frame-rate-independent total rotation per\n *    pixel, clamps cleanly to controlled ship max angular speeds, and stops with zero drift.\n * 3. The centered 30% x 35% rounded-rectangle aim boundary is purely visual/framing for HUD\n *    reticle feedback and NEVER alters steering sensitivity or interrupts continuous turning.\n */\nexport class FlightController {\n  public readonly position = new THREE.Vector3(0, 12, 40);\n  public readonly quaternion = new THREE.Quaternion();\n  public readonly velocity = new THREE.Vector3(0, 0, -24);\n\n  // Controlled angular velocities (rad/s) in ship local space\n  public yawVelocity = 0;\n  public pitchVelocity = 0;\n  public rollVelocity = 0;\n\n  // Normalized visual turn-lead reticle offset [-1..1] inside centered rounded-rect boundary\n  public aimCursorX = 0;\n  public aimCursorY = 0;\n\n  // Visual banking angle layered on the ship mesh for tactile feel\n  public visualBankAngle = 0;\n\n  // Live viewport-relative rounded-rectangle boundary and clamped reticle state (zero allocs)\n  public readonly aimBoundary: RoundedRectBoundary = createRoundedRectBoundary();\n  public readonly aimClamp: RoundedRectClampResult = createRoundedRectClampResult();\n\n  private ship: ShipConfig;\n  private boostEnergy: number;\n  private boostCooldownTimer = 0;\n  private boostLockedOut = false;\n  private boostIntensity = 0;\n  private wasBoosting = false;\n  private hull: number;\n  private boostJustEngaged = false;\n\n  public constructor(ship: ShipConfig) {\n    this.ship = ship;\n    this.boostEnergy = ship.flight.maxBoostEnergy;\n    this.hull = ship.maxHull;\n  }\n\n  public setShipConfig(ship: ShipConfig): void {\n    this.ship = ship;\n    this.boostEnergy = Math.min(this.boostEnergy, ship.flight.maxBoostEnergy);\n    this.hull = ship.maxHull;\n  }\n\n  public centerAimCursor(): void {\n    this.yawVelocity = 0;\n    this.pitchVelocity = 0;\n    this.aimCursorX = 0;\n    this.aimCursorY = 0;\n    clampToRoundedRect(0, 0, this.aimBoundary, this.aimClamp);\n  }\n\n  public reset(startPosition?: THREE.Vector3): void {\n    if (startPosition) {\n      this.position.copy(startPosition);\n    } else {\n      this.position.set(0, 12, 40);\n    }\n    this.quaternion.identity();\n    this.velocity.set(0, 0, -28);\n    this.yawVelocity = 0;\n    this.pitchVelocity = 0;\n    this.rollVelocity = 0;\n    this.centerAimCursor();\n    this.visualBankAngle = 0;\n    this.boostEnergy = this.ship.flight.maxBoostEnergy;\n    this.boostCooldownTimer = 0;\n    this.boostLockedOut = false;\n    this.boostIntensity = 0;\n    this.wasBoosting = false;\n    this.hull = this.ship.maxHull;\n  }\n\n  public getBoostJustEngaged(): boolean {\n    return this.boostJustEngaged;\n  }\n\n  /**\n   * Returns exact unit world-space forward firing direction aligned with ship boresight.\n   */\n  public getAimDirectionWorld(out: THREE.Vector3): THREE.Vector3 {\n    out.copy(_FORWARD_LOCAL).applyQuaternion(this.quaternion).normalize();\n    return out;\n  }\n\n  /**\n   * Computes the 3D world-space convergence point along the player\'s forward firing ray.\n   */\n  public getAimTargetPoint(out: THREE.Vector3, distance: number): THREE.Vector3 {\n    this.getAimDirectionWorld(out);\n    out.multiplyScalar(distance).add(this.position);\n    return out;\n  }\n\n  /**\n   * Advances arcade flight simulation by delta time `dt` (seconds) and writes live telemetry.\n   */\n  public update(\n    dt: number,\n    input: InputSnapshot,\n    settings: GameSettings,\n    telemetry: FlightTelemetry,\n    viewportWidth = typeof window !== \'undefined\' ? window.innerWidth : 1280,\n    viewportHeight = typeof window !== \'undefined\' ? window.innerHeight : 720,\n  ): void {\n    const profile = this.ship.flight;\n    const safeDt = Math.min(Math.max(dt, 0.0001), 0.05);\n    const vw = Math.max(1, viewportWidth);\n    const vh = Math.max(1, viewportHeight);\n\n    // 1. Update centered 30% x 35% rounded-rectangle aiming frame geometry (purely visual)\n    computeRoundedRectBoundary(\n      vw,\n      vh,\n      settings.aimBoundaryScale,\n      STEERING_CONFIG.aimBoundaryWidth,\n      STEERING_CONFIG.aimBoundaryHeight,\n      STEERING_CONFIG.aimBoundaryCornerRadius,\n      this.aimBoundary,\n    );\n\n    // 2. Direct relative mouse steering -> requested angular velocities (rad/s)\n    //    Single centralized base scale + user global/axis sensitivities.\n    //    Zero deadzone, zero nonlinear acceleration curve, zero boundary sensitivity coupling.\n    const mouseSens = THREE.MathUtils.clamp(\n      settings.mouseSensitivity,\n      STEERING_BOUNDS.mouseSensitivity.min,\n      STEERING_BOUNDS.mouseSensitivity.max,\n    );\n    const yawSens = THREE.MathUtils.clamp(\n      settings.yawSensitivity,\n      STEERING_BOUNDS.yawSensitivity.min,\n      STEERING_BOUNDS.yawSensitivity.max,\n    );\n    const pitchSens = THREE.MathUtils.clamp(\n      settings.pitchSensitivity,\n      STEERING_BOUNDS.pitchSensitivity.min,\n      STEERING_BOUNDS.pitchSensitivity.max,\n    );\n    const ySign = settings.invertY ? -1 : 1;\n\n    const mouseYawRate =\n      -(input.mouseDeltaX / safeDt) * STEERING_CONFIG.baseRadiansPerPixel * mouseSens * yawSens;\n    const mousePitchRate =\n      -((input.mouseDeltaY * ySign) / safeDt) *\n      STEERING_CONFIG.baseRadiansPerPixel *\n      mouseSens *\n      pitchSens;\n\n    // Optional arrow-key steering blends cleanly alongside direct mouse steering\n    let keyYaw = 0;\n    if (input.keyYawLeft) keyYaw += 0.85;\n    if (input.keyYawRight) keyYaw -= 0.85;\n    let keyPitch = 0;\n    if (input.keyPitchUp) keyPitch += 0.85;\n    if (input.keyPitchDown) keyPitch -= 0.85;\n\n    const targetYawRate = mouseYawRate + keyYaw * profile.yawSpeed;\n    const targetPitchRate = mousePitchRate + keyPitch * profile.pitchSpeed;\n\n    // 3. Controlled max angular velocity ceiling + single-stage frame-rate-independent smoothing.\n    //    Exact angle conservation across frame rates (30/60/120/144 FPS) and crisp zero-drift stop.\n    const maxYawRate = profile.yawSpeed * STEERING_CONFIG.maxTurnRateMultiplier;\n    const maxPitchRate = profile.pitchSpeed * STEERING_CONFIG.maxTurnRateMultiplier;\n    const shipAgility = profile.angularDamping / 7.5;\n    const smoothingLambda = STEERING_CONFIG.angularSmoothing * shipAgility;\n    const steerAlpha = 1 - Math.exp(-smoothingLambda * safeDt);\n\n    this.yawVelocity = THREE.MathUtils.clamp(\n      this.yawVelocity + (targetYawRate - this.yawVelocity) * steerAlpha,\n      -maxYawRate,\n      maxYawRate,\n    );\n    this.pitchVelocity = THREE.MathUtils.clamp(\n      this.pitchVelocity + (targetPitchRate - this.pitchVelocity) * steerAlpha,\n      -maxPitchRate,\n      maxPitchRate,\n    );\n\n    if (targetYawRate === 0 && Math.abs(this.yawVelocity) < 0.002) {\n      this.yawVelocity = 0;\n    }\n    if (targetPitchRate === 0 && Math.abs(this.pitchVelocity) < 0.002) {\n      this.pitchVelocity = 0;\n    }\n\n    // 4. Visual turn-lead reticle clamped strictly inside the centered 30% x 35% rounded-rect\n    const normSteerX = THREE.MathUtils.clamp(-this.yawVelocity / maxYawRate, -1, 1);\n    const normSteerY = THREE.MathUtils.clamp(-this.pitchVelocity / maxPitchRate, -1, 1);\n    clampToRoundedRect(\n      normSteerX * this.aimBoundary.halfW,\n      normSteerY * this.aimBoundary.halfH,\n      this.aimBoundary,\n      this.aimClamp,\n    );\n    this.aimCursorX = this.aimClamp.normalizedX;\n    this.aimCursorY = this.aimClamp.normalizedY;\n\n    const stepYaw = this.yawVelocity * safeDt;\n    const stepPitch = this.pitchVelocity * safeDt;\n\n    // 5. Independent Roll via A / D (exact Phase 1 roll feel preserved)\n    let rollDir = 0;\n    if (input.rollLeft) rollDir += 1;\n    if (input.rollRight) rollDir -= 1;\n    const targetRollRate = rollDir * profile.rollSpeed;\n    const rollAlpha = 1 - Math.exp(-(profile.angularDamping * 1.25) * safeDt);\n    this.rollVelocity = THREE.MathUtils.lerp(this.rollVelocity, targetRollRate, rollAlpha);\n    const stepRoll = this.rollVelocity * safeDt;"
