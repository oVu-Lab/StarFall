  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * Pure geometry helper for STARFALL\'s centered rounded-rectangle aiming region.\n *\n * Default region:\n * - Width:         30% of viewport width  (halfW = 0.150 * W)\n * - Height:        35% of viewport height (halfH = 0.175 * H)\n * - Corner radius: 30% of min(halfW, halfH)\n * - Position:      Centered on the viewport\n *\n * Strictly decoupled from steering sensitivity: boundary dimensions only define\n * the visual aiming frame and bounded reticle coordinates.\n */\n\nexport interface RoundedRectBoundary {\n  viewportWidth: number;\n  viewportHeight: number;\n  widthFraction: number;\n  heightFraction: number;\n  widthPx: number;\n  heightPx: number;\n  halfW: number;\n  halfH: number;\n  cornerRadiusPx: number;\n  innerHalfW: number;\n  innerHalfH: number;\n}\n\nexport interface RoundedRectClampResult {\n  clampedX: number;\n  clampedY: number;\n  normalizedX: number;\n  normalizedY: number;\n  screenX: number;\n  screenY: number;\n  clamped: boolean;\n}\n\nexport function createRoundedRectBoundary(): RoundedRectBoundary {\n  return {\n    viewportWidth: 1280,\n    viewportHeight: 720,\n    widthFraction: 0.3,\n    heightFraction: 0.35,\n    widthPx: 384,\n    heightPx: 252,\n    halfW: 192,\n    halfH: 126,\n    cornerRadiusPx: 37.8,\n    innerHalfW: 154.2,\n    innerHalfH: 88.2,\n  };\n}\n\nexport function createRoundedRectClampResult(): RoundedRectClampResult {\n  return {\n    clampedX: 0,\n    clampedY: 0,\n    normalizedX: 0,\n    normalizedY: 0,\n    screenX: 0.5,\n    screenY: 0.5,\n    clamped: false,\n  };\n}\n\n/**\n * Computes centered rounded-rectangle boundary dimensions in viewport CSS pixels\n * without heap allocations.\n */\nexport function computeRoundedRectBoundary(\n  viewportWidth: number,\n  viewportHeight: number,\n  boundaryScale: number,\n  baseWidthFraction: number,\n  baseHeightFraction: number,\n  cornerRadiusFraction: number,\n  out: RoundedRectBoundary,\n): RoundedRectBoundary {\n  const vw = Math.max(1, viewportWidth);\n  const vh = Math.max(1, viewportHeight);\n  const scale = Math.max(0.5, Math.min(2.0, boundaryScale));\n\n  const widthFraction = Math.min(0.85, Math.max(0.1, baseWidthFraction * scale));\n  const heightFraction = Math.min(0.85, Math.max(0.1, baseHeightFraction * scale));\n\n  const widthPx = vw * widthFraction;\n  const heightPx = vh * heightFraction;\n  const halfW = widthPx * 0.5;\n  const halfH = heightPx * 0.5;\n  const cornerRadiusPx = Math.min(halfW, halfH) * Math.max(0.05, Math.min(0.95, cornerRadiusFraction));\n\n  out.viewportWidth = vw;\n  out.viewportHeight = vh;\n  out.widthFraction = widthFraction;\n  out.heightFraction = heightFraction;\n  out.widthPx = widthPx;\n  out.heightPx = heightPx;\n  out.halfW = halfW;\n  out.halfH = halfH;\n  out.cornerRadiusPx = cornerRadiusPx;\n  out.innerHalfW = Math.max(0, halfW - cornerRadiusPx);\n  out.innerHalfH = Math.max(0, halfH - cornerRadiusPx);\n  return out;\n}\n\n/**\n * Clamps an offset (dx, dy) in viewport CSS pixels relative to screen center\n * cleanly inside the rounded-rectangle aiming boundary.\n */\nexport function clampToRoundedRect(\n  dx: number,\n  dy: number,\n  boundary: RoundedRectBoundary,\n  out: RoundedRectClampResult,\n): RoundedRectClampResult {\n  const halfW = Math.max(1, boundary.halfW);\n  const halfH = Math.max(1, boundary.halfH);\n  const r = boundary.cornerRadiusPx;\n  const innerW = boundary.innerHalfW;\n  const innerH = boundary.innerHalfH;\n\n  let cx = Math.max(-halfW, Math.min(halfW, dx));\n  let cy = Math.max(-halfH, Math.min(halfH, dy));\n  let clamped = cx !== dx || cy !== dy;\n\n  // Enforce rounded corner arcs when inside corner quadrants\n  const ax = Math.abs(cx);\n  const ay = Math.abs(cy);\n  if (r > 0 && ax > innerW && ay > innerH) {\n    const qx = ax - innerW;\n    const qy = ay - innerH;\n    const dist = Math.hypot(qx, qy);\n    if (dist > r) {\n      const s = r / dist;\n      cx = Math.sign(cx) * (innerW + qx * s);\n      cy = Math.sign(cy) * (innerH + qy * s);\n      clamped = true;\n    }\n  }\n\n  out.clampedX = cx;\n  out.clampedY = cy;\n  out.normalizedX = cx / halfW;\n  out.normalizedY = cy / halfH;\n  out.screenX = 0.5 + cx / Math.max(1, boundary.viewportWidth);\n  out.screenY = 0.5 + cy / Math.max(1, boundary.viewportHeight);\n  out.clamped = clamped;\n  return out;\n}\n"
        path {
          absolute_uri: "file:///src/engine/AimBoundary.ts"
        }
        overwrite: true
      }
    }
