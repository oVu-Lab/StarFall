        use_fast_apply: true
        replacement_chunks {
          target_content: "import { SHIP_CONFIGS } from \'../config/ships\';\nimport { STEERING_CONFIG } from \'../config/steering\';\nimport { computeRoundedRectBoundary, createRoundedRectBoundary } from \'../engine/AimBoundary\';\nimport { MAX_ENEMIES } from \'../engine/combat/CombatManager\';\nimport type { FlightTelemetry, GameSettings, ShipId } from \'../types/game\';\nimport type { MissionHudSnapshot } from \'../types/mission\';"
          replacement_content: "import { SHIP_CONFIGS } from \'../config/ships\';\nimport { VISUAL_STICK_HUD } from \'../config/steering\';\nimport { MAX_ENEMIES } from \'../engine/combat/CombatManager\';\nimport type { FlightTelemetry, GameSettings, ShipId } from \'../types/game\';\nimport type { MissionHudSnapshot } from \'../types/mission\';"
          start_line: 3
          end_line: 10
        }
        replacement_chunks {
          target_content: "  // Combat & aiming refs\n  const aimReticleRef = useRef<HTMLDivElement>(null);\n  const aimRingRef = useRef<HTMLDivElement>(null);\n  const aimBoundarySvgRef = useRef<SVGSVGElement>(null);\n  const cornerPathRefs = useRef<Array<SVGPathElement | null>>([null, null, null, null]);\n  const deadzoneRectRef = useRef<SVGRectElement>(null);\n  const lastBoundaryKeyRef = useRef(\'\');\n  const boundaryScratchRef = useRef(createRoundedRectBoundary());\n  const boresightRef = useRef<HTMLDivElement>(null);\n  const steerLineRef = useRef<SVGLineElement>(null);"
          replacement_content: "  // Combat & aiming refs\n  const aimReticleRef = useRef<HTMLDivElement>(null);\n  const aimRingRef = useRef<HTMLDivElement>(null);\n  const stickRingSvgRef = useRef<SVGSVGElement>(null);\n  const stickOuterCircleRef = useRef<SVGCircleElement>(null);\n  const stickDeadzoneCircleRef = useRef<SVGCircleElement>(null);\n  const lastRingKeyRef = useRef(\'\');\n  const boresightRef = useRef<HTMLDivElement>(null);\n  const steerLineRef = useRef<SVGLineElement>(null);"
          start_line: 65
          end_line: 78
        }
        replacement_chunks {
          target_content: "      // 4. Bounded Virtual Joystick Reticle (30% x 35% rounded-rectangle boundary)\n      //    + 3D Cannon Boresight Reticle + Radial Steering Vector Tether\n      const aimPxX = t.aimScreenX * vw;\n      const aimPxY = t.aimScreenY * vh;\n      const borePxX = t.boresightScreenX * vw;\n      const borePxY = t.boresightScreenY * vh;\n      const cx = vw * 0.5;\n      const cy = vh * 0.5;\n\n      if (aimReticleRef.current) {\n        const reticleScale =\n          t.steeringZone === \'max\'\n            ? 1.08\n            : t.steeringZone === \'deadzone\'\n              ? 0.94\n              : 1.0;\n        aimReticleRef.current.style.transform = `translate3d(${aimPxX.toFixed(1)}px, ${aimPxY.toFixed(1)}px, 0) translate(-50%, -50%) scale(${reticleScale.toFixed(3)})`;\n        aimReticleRef.current.dataset.steeringZone = t.steeringZone;\n        aimReticleRef.current.dataset.radial = t.joystickRadialMagnitude.toFixed(4);\n        aimReticleRef.current.dataset.steerX = t.steeringOutputX.toFixed(4);\n        aimReticleRef.current.dataset.steerY = t.steeringOutputY.toFixed(4);\n        aimReticleRef.current.dataset.screenX = t.aimScreenX.toFixed(4);\n        aimReticleRef.current.dataset.screenY = t.aimScreenY.toFixed(4);\n        aimReticleRef.current.style.color =\n          t.steeringZone === \'max\'\n            ? \'#e0f2fe\'\n            : t.steeringZone === \'deadzone\'\n              ? \'rgba(148, 163, 184, 0.85)\'\n              : \'rgba(165, 243, 252, 0.95)\';\n      }\n\n      if (boresightRef.current) {\n        const recoilScale = t.isFiring ? 1 + t.weaponCooldownRatio * 0.14 : 1;\n        boresightRef.current.style.transform = `translate3d(${borePxX.toFixed(1)}px, ${borePxY.toFixed(1)}px, 0) translate(-50%, -50%) scale(${recoilScale.toFixed(3)})`;\n      }\n\n      if (aimRingRef.current) {\n        const ringScale = 1 + t.boostIntensity * 0.24 + (t.isFiring ? 0.08 : 0);\n        aimRingRef.current.style.transform = `scale(${ringScale.toFixed(3)})`;\n        aimRingRef.current.style.opacity = String(\n          (0.24 + t.boostIntensity * 0.45 + (t.isFiring ? 0.22 : 0)).toFixed(2),\n        );\n      }\n\n      // Subtle sci-fi rounded-rectangle corner markings (30% x 35% base viewport geometry scaled by joystickRadius)\n      if (aimBoundarySvgRef.current) {\n        const b = computeRoundedRectBoundary(\n          vw,\n          vh,\n          s.joystickRadius,\n          STEERING_CONFIG.aimBoundaryWidth,\n          STEERING_CONFIG.aimBoundaryHeight,\n          STEERING_CONFIG.aimBoundaryCornerRadius,\n          boundaryScratchRef.current,\n        );\n        const key = `${vw.toFixed(1)}:${vh.toFixed(1)}:${b.widthPx.toFixed(1)}:${b.heightPx.toFixed(1)}:${b.cornerRadiusPx.toFixed(1)}:${s.deadzone.toFixed(3)}`;\n        if (key !== lastBoundaryKeyRef.current) {\n          lastBoundaryKeyRef.current = key;\n          const x0 = cx - b.halfW;\n          const x1 = cx + b.halfW;\n          const y0 = cy - b.halfH;\n          const y1 = cy + b.halfH;\n          const r = b.cornerRadiusPx;\n          const arm = Math.max(8, Math.min(18, Math.min(b.innerHalfW, b.innerHalfH) * 0.24));\n\n          const paths = [\n            // Top-left rounded corner bracket\n            `M ${x0.toFixed(1)} ${(y0 + r + arm).toFixed(1)} L ${x0.toFixed(1)} ${(y0 + r).toFixed(1)} A ${r.toFixed(1)} ${r.toFixed(1)} 0 0 1 ${(x0 + r).toFixed(1)} ${y0.toFixed(1)} L ${(x0 + r + arm).toFixed(1)} ${y0.toFixed(1)}`,\n            // Top-right rounded corner bracket\n            `M ${(x1 - r - arm).toFixed(1)} ${y0.toFixed(1)} L ${(x1 - r).toFixed(1)} ${y0.toFixed(1)} A ${r.toFixed(1)} ${r.toFixed(1)} 0 0 1 ${x1.toFixed(1)} ${(y0 + r).toFixed(1)} L ${x1.toFixed(1)} ${(y0 + r + arm).toFixed(1)}`,\n            // Bottom-right rounded corner bracket\n            `M ${x1.toFixed(1)} ${(y1 - r - arm).toFixed(1)} L ${x1.toFixed(1)} ${(y1 - r).toFixed(1)} A ${r.toFixed(1)} ${r.toFixed(1)} 0 0 1 ${(x1 - r).toFixed(1)} ${y1.toFixed(1)} L ${(x1 - r - arm).toFixed(1)} ${y1.toFixed(1)}`,\n            // Bottom-left rounded corner bracket\n            `M ${(x0 + r + arm).toFixed(1)} ${y1.toFixed(1)} L ${(x0 + r).toFixed(1)} ${y1.toFixed(1)} A ${r.toFixed(1)} ${r.toFixed(1)} 0 0 1 ${x0.toFixed(1)} ${(y1 - r).toFixed(1)} L ${x0.toFixed(1)} ${(y1 - r - arm).toFixed(1)}`,\n          ];\n\n          for (let i = 0; i < 4; i++) {\n            cornerPathRefs.current[i]?.setAttribute(\'d\', paths[i]);\n          }\n\n          if (deadzoneRectRef.current) {\n            if (s.deadzone > 0.005) {\n              const dzW = b.widthPx * s.deadzone;\n              const dzH = b.heightPx * s.deadzone;\n              const dzR = b.cornerRadiusPx * s.deadzone;\n              deadzoneRectRef.current.setAttribute(\'x\', (cx - dzW * 0.5).toFixed(1));\n              deadzoneRectRef.current.setAttribute(\'y\', (cy - dzH * 0.5).toFixed(1));\n              deadzoneRectRef.current.setAttribute(\'width\', dzW.toFixed(1));\n              deadzoneRectRef.current.setAttribute(\'height\', dzH.toFixed(1));\n              deadzoneRectRef.current.setAttribute(\'rx\', dzR.toFixed(1));\n              deadzoneRectRef.current.setAttribute(\'ry\', dzR.toFixed(1));\n              deadzoneRectRef.current.style.visibility = \'visible\';\n            } else {\n              deadzoneRectRef.current.style.visibility = \'hidden\';\n            }\n          }\n\n          aimBoundarySvgRef.current.dataset.shape = \'rounded-rect\';\n          aimBoundarySvgRef.current.dataset.viewportWidth = vw.toFixed(1);\n          aimBoundarySvgRef.current.dataset.viewportHeight = vh.toFixed(1);\n          aimBoundarySvgRef.current.dataset.widthPx = b.widthPx.toFixed(2);\n          aimBoundarySvgRef.current.dataset.heightPx = b.heightPx.toFixed(2);\n          aimBoundarySvgRef.current.dataset.cornerRadiusPx = b.cornerRadiusPx.toFixed(2);\n          aimBoundarySvgRef.current.dataset.widthFraction = b.widthFraction.toFixed(4);\n          aimBoundarySvgRef.current.dataset.heightFraction = b.heightFraction.toFixed(4);\n          aimBoundarySvgRef.current.dataset.joystickRadius = s.joystickRadius.toFixed(3);\n          aimBoundarySvgRef.current.dataset.deadzone = s.deadzone.toFixed(3);\n        }\n\n        const rMag = t.joystickRadialMagnitude;\n        const edgeOp =\n          t.steeringZone === \'max\'\n            ? 0.42\n            : t.steeringZone === \'active\'\n              ? 0.12 + rMag * 0.24\n              : 0.1;\n        aimBoundarySvgRef.current.style.opacity = edgeOp.toFixed(2);\n        aimBoundarySvgRef.current.style.color =\n          t.steeringZone === \'max\'\n            ? \'rgba(186, 230, 253, 0.95)\'\n            : \'rgba(103, 232, 249, 0.78)\';\n      }\n\n      if (steerLineRef.current) {\n        const dx = aimPxX - cx;\n        const dy = aimPxY - cy;\n        const distPx = Math.hypot(dx, dy);\n        if (t.steeringZone !== \'deadzone\' && distPx > 12) {\n          const ux = dx / distPx;\n          const uy = dy / distPx;\n          steerLineRef.current.setAttribute(\'x1\', (cx + ux * 10).toFixed(1));\n          steerLineRef.current.setAttribute(\'y1\', (cy + uy * 10).toFixed(1));\n          steerLineRef.current.setAttribute(\'x2\', (aimPxX - ux * 18).toFixed(1));\n          steerLineRef.current.setAttribute(\'y2\', (aimPxY - uy * 18).toFixed(1));\n          steerLineRef.current.style.opacity = String(\n            Math.min(0.46, 0.12 + t.joystickRadialMagnitude * 0.34).toFixed(2),\n          );\n        } else {\n          steerLineRef.current.style.opacity = \'0\';\n        }\n      }"
          replacement_content: "      // 4. 3D Cannon Boresight Reticle + Decoupled Visual Virtual-Stick Indicator\n      //    Internal stick deflection lives in normalized [-maxStickDeflection, +maxStickDeflection];\n      //    visual ring radius is purely cosmetic and never constrains steering math.\n      const borePxX = t.boresightScreenX * vw;\n      const borePxY = t.boresightScreenY * vh;\n      const cx = vw * 0.5;\n      const cy = vh * 0.5;\n\n      const visualRingRadius = Math.max(\n        VISUAL_STICK_HUD.minRingRadiusPx,\n        Math.min(\n          VISUAL_STICK_HUD.maxRingRadiusPx,\n          Math.min(vw, vh) * VISUAL_STICK_HUD.ringRadiusFraction,\n        ),\n      );\n      const maxDefl = Math.max(0.1, s.maxStickDeflection);\n      let normVisX = t.aimNormalizedX / maxDefl;\n      let normVisY = t.aimNormalizedY / maxDefl;\n      const visLen = Math.hypot(normVisX, normVisY);\n      if (visLen > 1) {\n        normVisX /= visLen;\n        normVisY /= visLen;\n      }\n      const aimPxX = cx + normVisX * visualRingRadius;\n      const aimPxY = cy + normVisY * visualRingRadius;\n\n      if (aimReticleRef.current) {\n        const reticleScale =\n          t.steeringZone === \'max\'\n            ? 1.12\n            : t.steeringZone === \'deadzone\'\n              ? 0.85\n              : 1.0;\n        const pipOpacity =\n          t.steeringZone === \'deadzone\' ? 0.35 : Math.min(0.95, 0.45 + t.stickMagnitude * 0.5);\n        aimReticleRef.current.style.transform = `translate3d(${aimPxX.toFixed(1)}px, ${aimPxY.toFixed(1)}px, 0) translate(-50%, -50%) scale(${reticleScale.toFixed(3)})`;\n        aimReticleRef.current.style.opacity = pipOpacity.toFixed(2);\n        aimReticleRef.current.dataset.steeringZone = t.steeringZone;\n        aimReticleRef.current.dataset.stickX = t.aimNormalizedX.toFixed(4);\n        aimReticleRef.current.dataset.stickY = t.aimNormalizedY.toFixed(4);\n        aimReticleRef.current.dataset.stickMagnitude = t.stickMagnitude.toFixed(4);\n        aimReticleRef.current.dataset.steerX = t.steeringOutputX.toFixed(4);\n        aimReticleRef.current.dataset.steerY = t.steeringOutputY.toFixed(4);\n        aimReticleRef.current.style.color =\n          t.steeringZone === \'max\'\n            ? \'#e0f2fe\'\n            : t.steeringZone === \'deadzone\'\n              ? \'rgba(148, 163, 184, 0.7)\'\n              : \'rgba(165, 243, 252, 0.95)\';\n      }\n\n      if (boresightRef.current) {\n        const recoilScale = t.isFiring ? 1 + t.weaponCooldownRatio * 0.14 : 1;\n        boresightRef.current.style.transform = `translate3d(${borePxX.toFixed(1)}px, ${borePxY.toFixed(1)}px, 0) translate(-50%, -50%) scale(${recoilScale.toFixed(3)})`;\n      }\n\n      if (aimRingRef.current) {\n        const ringScale = 1 + t.boostIntensity * 0.24 + (t.isFiring ? 0.08 : 0);\n        aimRingRef.current.style.transform = `scale(${ringScale.toFixed(3)})`;\n        aimRingRef.current.style.opacity = String(\n          (0.24 + t.boostIntensity * 0.45 + (t.isFiring ? 0.22 : 0)).toFixed(2),\n        );\n      }\n\n      // Subtle centered circular virtual-stick visual ring (cosmetic reference only)\n      if (stickRingSvgRef.current) {\n        const key = `${vw.toFixed(1)}:${vh.toFixed(1)}:${visualRingRadius.toFixed(1)}:${s.deadzone.toFixed(3)}`;\n        if (key !== lastRingKeyRef.current) {\n          lastRingKeyRef.current = key;\n          if (stickOuterCircleRef.current) {\n            stickOuterCircleRef.current.setAttribute(\'cx\', cx.toFixed(1));\n            stickOuterCircleRef.current.setAttribute(\'cy\', cy.toFixed(1));\n            stickOuterCircleRef.current.setAttribute(\'r\', visualRingRadius.toFixed(1));\n          }\n          if (stickDeadzoneCircleRef.current) {\n            if (s.deadzone > 0.005) {\n              stickDeadzoneCircleRef.current.setAttribute(\'cx\', cx.toFixed(1));\n              stickDeadzoneCircleRef.current.setAttribute(\'cy\', cy.toFixed(1));\n              stickDeadzoneCircleRef.current.setAttribute(\n                \'r\',\n                (visualRingRadius * s.deadzone).toFixed(1),\n              );\n              stickDeadzoneCircleRef.current.style.visibility = \'visible\';\n            } else {\n              stickDeadzoneCircleRef.current.style.visibility = \'hidden\';\n            }\n          }\n          stickRingSvgRef.current.dataset.ringRadiusPx = visualRingRadius.toFixed(1);\n          stickRingSvgRef.current.dataset.deadzone = s.deadzone.toFixed(3);\n        }\n\n        const ringOp =\n          t.steeringZone === \'max\'\n            ? 0.34\n            : t.steeringZone === \'active\'\n              ? 0.08 + t.stickMagnitude * 0.2\n              : 0.06;\n        stickRingSvgRef.current.style.opacity = ringOp.toFixed(2);\n      }\n\n      if (steerLineRef.current) {\n        const dx = aimPxX - cx;\n        const dy = aimPxY - cy;\n        const distPx = Math.hypot(dx, dy);\n        if (t.steeringZone !== \'deadzone\' && distPx > 8) {\n          const ux = dx / distPx;\n          const uy = dy / distPx;\n          steerLineRef.current.setAttribute(\'x1\', (cx + ux * 6).toFixed(1));\n          steerLineRef.current.setAttribute(\'y1\', (cy + uy * 6).toFixed(1));\n          steerLineRef.current.setAttribute(\'x2\', (aimPxX - ux * 10).toFixed(1));\n          steerLineRef.current.setAttribute(\'y2\', (aimPxY - uy * 10).toFixed(1));\n          steerLineRef.current.style.opacity = String(\n            Math.min(0.45, 0.12 + t.stickMagnitude * 0.32).toFixed(2),\n          );\n        } else {\n          steerLineRef.current.style.opacity = \'0\';\n        }\n      }"
          start_line: 213
          end_line: 355
        }
        replacement_chunks {
          target_content: "      {/* Subtle Sci-Fi Rounded-Rectangle Virtual Joystick Boundary (30% x 35% Base Viewport) */}\n      <svg\n        ref={aimBoundarySvgRef}\n        data-testid=\"aim-boundary-frame\"\n        className=\"pointer-events-none fixed inset-0 h-full w-full text-cyan-300/75\"\n        style={{ opacity: 0.1, willChange: \'opacity, color\' }}\n        aria-hidden=\"true\"\n      >\n        {[0, 1, 2, 3].map((idx) => (\n          <path\n            key={idx}\n            ref={(el) => {\n              cornerPathRefs.current[idx] = el;\n            }}\n            fill=\"none\"\n            stroke=\"currentColor\"\n            strokeWidth=\"1.5\"\n            strokeLinecap=\"round\"\n          />\n        ))}\n        <rect\n          ref={deadzoneRectRef}\n          fill=\"none\"\n          stroke=\"currentColor\"\n          strokeOpacity=\"0.4\"\n          strokeWidth=\"1\"\n          strokeDasharray=\"2 3\"\n          style={{ visibility: \'hidden\' }}\n        />\n      </svg>\n\n      {/* Subtle Steering Vector Tether (Screen Center -> Persistent Virtual Mouse Cursor) */}\n      <svg\n        className=\"pointer-events-none fixed inset-0 h-full w-full\"\n        aria-hidden=\"true\"\n      >\n        <line\n          ref={steerLineRef}\n          x1=\"0\"\n          y1=\"0\"\n          x2=\"0\"\n          y2=\"0\"\n          stroke=\"#67e8f9\"\n          strokeWidth=\"1.25\"\n          strokeDasharray=\"4 4\"\n          style={{ opacity: 0 }}\n        />\n      </svg>\n\n      {/* Ship 3D Cannon Boresight Reticle (Convergence Point + Hit/Kill Feedback) */}\n      <div\n        ref={boresightRef}\n        className=\"pointer-events-none fixed left-0 top-0 flex items-center justify-center\"\n        style={{ transform: \'translate3d(50vw, 50vh, 0) translate(-50%, -50%)\', willChange: \'transform\' }}\n      >\n        <div\n          ref={aimRingRef}\n          className=\"absolute h-14 w-14 rounded-full border border-cyan-400/45 opacity-25\"\n          style={{ willChange: \'transform, opacity\' }}\n        />\n\n        <svg width=\"34\" height=\"34\" viewBox=\"0 0 34 34\" className=\"text-cyan-300/75\">\n          <line x1=\"17\" y1=\"3\" x2=\"17\" y2=\"9\" stroke=\"currentColor\" strokeWidth=\"1.4\" />\n          <line x1=\"17\" y1=\"25\" x2=\"17\" y2=\"31\" stroke=\"currentColor\" strokeWidth=\"1.4\" />\n          <line x1=\"3\" y1=\"17\" x2=\"9\" y2=\"17\" stroke=\"currentColor\" strokeWidth=\"1.4\" />\n          <line x1=\"25\" y1=\"17\" x2=\"31\" y2=\"17\" stroke=\"currentColor\" strokeWidth=\"1.4\" />\n          <circle cx=\"17\" cy=\"17\" r=\"1.8\" fill=\"#bae6fd\" />\n        </svg>\n\n        {/* Hit Confirmation X */}\n        <div\n          ref={hitMarkerRef}\n          className=\"absolute opacity-0\"\n          style={{ willChange: \'opacity\' }}\n        >\n          <svg width=\"34\" height=\"34\" viewBox=\"0 0 34 34\" className=\"text-cyan-200\">\n            <line x1=\"7\" y1=\"7\" x2=\"13\" y2=\"13\" stroke=\"currentColor\" strokeWidth=\"2.2\" />\n            <line x1=\"27\" y1=\"7\" x2=\"21\" y2=\"13\" stroke=\"currentColor\" strokeWidth=\"2.2\" />\n            <line x1=\"7\" y1=\"27\" x2=\"13\" y2=\"21\" stroke=\"currentColor\" strokeWidth=\"2.2\" />\n            <line x1=\"27\" y1=\"27\" x2=\"21\" y2=\"21\" stroke=\"currentColor\" strokeWidth=\"2.2\" />\n          </svg>\n        </div>\n\n        {/* Kill Confirmation Burst */}\n        <div\n          ref={killMarkerRef}\n          className=\"absolute opacity-0\"\n          style={{ willChange: \'opacity\' }}\n        >\n          <svg width=\"52\" height=\"52\" viewBox=\"0 0 52 52\" className=\"text-orange-400\">\n            <line x1=\"10\" y1=\"10\" x2=\"19\" y2=\"19\" stroke=\"currentColor\" strokeWidth=\"2.5\" />\n            <line x1=\"42\" y1=\"10\" x2=\"33\" y2=\"19\" stroke=\"currentColor\" strokeWidth=\"2.5\" />\n            <line x1=\"10\" y1=\"42\" x2=\"19\" y2=\"33\" stroke=\"currentColor\" strokeWidth=\"2.5\" />\n            <line x1=\"42\" y1=\"42\" x2=\"33\" y2=\"33\" stroke=\"currentColor\" strokeWidth=\"2.5\" />\n          </svg>\n        </div>\n      </div>\n\n      {/* Persistent Virtual Mouse Steering Cursor (Progressive 3-Zone Envelope) */}\n      <div\n        ref={aimReticleRef}\n        data-testid=\"virtual-mouse-cursor\"\n        className=\"pointer-events-none fixed left-0 top-0 flex items-center justify-center text-cyan-200/95\"\n        style={{ transform: \'translate3d(50vw, 50vh, 0) translate(-50%, -50%)\', willChange: \'transform\' }}\n      >\n        <svg width=\"46\" height=\"46\" viewBox=\"0 0 46 46\">\n          <circle cx=\"23\" cy=\"23\" r=\"14\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.4\" strokeDasharray=\"7 5\" />\n          <line x1=\"23\" y1=\"4\" x2=\"23\" y2=\"11\" stroke=\"currentColor\" strokeWidth=\"1.6\" />\n          <line x1=\"23\" y1=\"35\" x2=\"23\" y2=\"42\" stroke=\"currentColor\" strokeWidth=\"1.6\" />\n          <line x1=\"4\" y1=\"23\" x2=\"11\" y2=\"23\" stroke=\"currentColor\" strokeWidth=\"1.6\" />\n          <line x1=\"35\" y1=\"23\" x2=\"42\" y2=\"23\" stroke=\"currentColor\" strokeWidth=\"1.6\" />\n          <circle cx=\"23\" cy=\"23\" r=\"2.4\" fill=\"#e0f2fe\" />\n        </svg>\n      </div>"
          replacement_content: "      {/* Subtle Centered Circular Virtual-Stick Visual Ring (purely cosmetic, decoupled from stick math) */}\n      <svg\n        ref={stickRingSvgRef}\n        data-testid=\"virtual-stick-ring\"\n        className=\"pointer-events-none fixed inset-0 h-full w-full text-cyan-300/75\"\n        style={{ opacity: 0.06, willChange: \'opacity\' }}\n        aria-hidden=\"true\"\n      >\n        <circle\n          ref={stickOuterCircleRef}\n          cx=\"50%\"\n          cy=\"50%\"\n          r=\"90\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          strokeWidth=\"1.2\"\n          strokeDasharray=\"6 8\"\n        />\n        <circle\n          ref={stickDeadzoneCircleRef}\n          cx=\"50%\"\n          cy=\"50%\"\n          r=\"0\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          strokeOpacity=\"0.45\"\n          strokeWidth=\"1\"\n          strokeDasharray=\"2 3\"\n          style={{ visibility: \'hidden\' }}\n        />\n      </svg>\n\n      {/* Subtle Virtual-Stick Deflection Tether (Screen Center -> Self-Centering Stick Pip) */}\n      <svg\n        className=\"pointer-events-none fixed inset-0 h-full w-full\"\n        aria-hidden=\"true\"\n      >\n        <line\n          ref={steerLineRef}\n          x1=\"0\"\n          y1=\"0\"\n          x2=\"0\"\n          y2=\"0\"\n          stroke=\"#67e8f9\"\n          strokeWidth=\"1.25\"\n          strokeDasharray=\"3 4\"\n          style={{ opacity: 0 }}\n        />\n      </svg>\n\n      {/* Ship 3D Cannon Boresight Reticle (Exact Firing Line + Hit/Kill Feedback) */}\n      <div\n        ref={boresightRef}\n        className=\"pointer-events-none fixed left-0 top-0 flex items-center justify-center\"\n        style={{ transform: \'translate3d(50vw, 50vh, 0) translate(-50%, -50%)\', willChange: \'transform\' }}\n      >\n        <div\n          ref={aimRingRef}\n          className=\"absolute h-14 w-14 rounded-full border border-cyan-400/45 opacity-25\"\n          style={{ willChange: \'transform, opacity\' }}\n        />\n\n        <svg width=\"34\" height=\"34\" viewBox=\"0 0 34 34\" className=\"text-cyan-300/85\">\n          <line x1=\"17\" y1=\"3\" x2=\"17\" y2=\"9\" stroke=\"currentColor\" strokeWidth=\"1.5\" />\n          <line x1=\"17\" y1=\"25\" x2=\"17\" y2=\"31\" stroke=\"currentColor\" strokeWidth=\"1.5\" />\n          <line x1=\"3\" y1=\"17\" x2=\"9\" y2=\"17\" stroke=\"currentColor\" strokeWidth=\"1.5\" />\n          <line x1=\"25\" y1=\"17\" x2=\"31\" y2=\"17\" stroke=\"currentColor\" strokeWidth=\"1.5\" />\n          <circle cx=\"17\" cy=\"17\" r=\"1.9\" fill=\"#bae6fd\" />\n        </svg>\n\n        {/* Hit Confirmation X */}\n        <div\n          ref={hitMarkerRef}\n          className=\"absolute opacity-0\"\n          style={{ willChange: \'opacity\' }}\n        >\n          <svg width=\"34\" height=\"34\" viewBox=\"0 0 34 34\" className=\"text-cyan-200\">\n            <line x1=\"7\" y1=\"7\" x2=\"13\" y2=\"13\" stroke=\"currentColor\" strokeWidth=\"2.2\" />\n            <line x1=\"27\" y1=\"7\" x2=\"21\" y2=\"13\" stroke=\"currentColor\" strokeWidth=\"2.2\" />\n            <line x1=\"7\" y1=\"27\" x2=\"13\" y2=\"21\" stroke=\"currentColor\" strokeWidth=\"2.2\" />\n            <line x1=\"27\" y1=\"27\" x2=\"21\" y2=\"21\" stroke=\"currentColor\" strokeWidth=\"2.2\" />\n          </svg>\n        </div>\n\n        {/* Kill Confirmation Burst */}\n        <div\n          ref={killMarkerRef}\n          className=\"absolute opacity-0\"\n          style={{ willChange: \'opacity\' }}\n        >\n          <svg width=\"52\" height=\"52\" viewBox=\"0 0 52 52\" className=\"text-orange-400\">\n            <line x1=\"10\" y1=\"10\" x2=\"19\" y2=\"19\" stroke=\"currentColor\" strokeWidth=\"2.5\" />\n            <line x1=\"42\" y1=\"10\" x2=\"33\" y2=\"19\" stroke=\"currentColor\" strokeWidth=\"2.5\" />\n            <line x1=\"10\" y1=\"42\" x2=\"19\" y2=\"33\" stroke=\"currentColor\" strokeWidth=\"2.5\" />\n            <line x1=\"42\" y1=\"42\" x2=\"33\" y2=\"33\" stroke=\"currentColor\" strokeWidth=\"2.5\" />\n          </svg>\n        </div>\n      </div>\n\n      {/* Self-Centering Virtual Stick Deflection Pip */}\n      <div\n        ref={aimReticleRef}\n        data-testid=\"virtual-mouse-cursor\"\n        className=\"pointer-events-none fixed left-0 top-0 flex items-center justify-center text-cyan-200/95\"\n        style={{\n          transform: \'translate3d(50vw, 50vh, 0) translate(-50%, -50%)\',\n          opacity: 0.35,\n          willChange: \'transform, opacity\',\n        }}\n      >\n        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\">\n          <circle cx=\"12\" cy=\"12\" r=\"8\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.4\" />\n          <circle cx=\"12\" cy=\"12\" r=\"2.2\" fill=\"#e0f2fe\" />\n        </svg>\n      </div>"
