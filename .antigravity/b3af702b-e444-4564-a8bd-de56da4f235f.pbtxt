    combined_output {
      full: "<truncated 23 bytes>\nship coasts down rather   408\t    // than inheriting a command nobody sent.   409\t    this.throttle = bound(controls.throttle, 0, 1)   410\t    const target = this.throttle * this.spec.maxSpeed   411\t    const delta = target - this.speed   412\t    const step = this.spec.accel * dt   413\t    this.speed += Math.abs(delta) <= step ? delta : Math.sign(delta) * step   414\t  }   415\t=== main.ts render loop ===   350\t    let serverReady = false   351\t    let lobbyState: LobbyState | null = null   352\t    let launcherSeat: number | undefined   353\t    let potRoom: { buyInSats: number; paidSeats: number[] } | null = null   354\t    activePotRoom = false   355\t    let potStatus: PotPaymentStatus | undefined   356\t    let potClaim = storedPotClaim(code)   357\t    const renderPot = () => {   358\t      if (potRoom) void wing.potStatus(potRoom.buyInSats, potRoom.paidSeats,   359\t        lobbyState?.seat ?? potClaim?.seat ?? -1, potStatus)   360\t    }   361\t    const refreshPot = async (create: boolean) => {   362\t      if (!endpoint || !potClaim || !current()) return   363\t      try {   364\t        const status = await potPayment(endpoint, code, potClaim.seat, potClaim.token, create)   365\t        if (!current()) return   366\t        potStatus = status   367\t        renderPot()   368\t        if (status.state === \'completed\' || status.state === \'failed\' || status.state === \'expired\') clearPotPoll()   369\t      } catch (error) {   370\t        if (current()) wing.status(`Payment status unavailable: ${error instanceof Error ? error.message : error}`)   371\t      }   372\t    }   373\t    const updateAction = () => {   374\t      if (endpoint && potRoom) {   375\t        const humanSeats = lobbyState?.seats.flatMap((seat, i) => seat.pilot === \'human\' ? [i] : []) ?? []   376\t        const action = potLaunchAction(serverCanLaunch, humanSeats, potRoom.paidSeats)   377\t        hangar.action(action.label, action.disabled)   378\t      } else if (endpoint) hangar.action(serverCanLaunch ? serverReady ? \'LAUNCH\' : \'WAITING FOR PLAYER\' : \'WAITING FOR HOST\',   379\t        !serverCanLaunch || !serverReady)   380\t      else hangar.action(\'WAITING FOR HOST\', true)   381\t    }   382\t    rememberShip(ship)   383\t    game.abandon()   384\t    screens.moveTo(\'hangar\')   385\t    hud.hide()   386\t    input.releasePointerLock()   387\t    hangar.action(asServerHost ? \'LAUNCH\' : \'JOIN WING\')   388\t    hangar.open(ship)   389\t    hangar.action(\'CONNECTING\342\200\246\', true)   390\t    pause.hide()   391\t    debrief.hide()   392\t    pilot.reset()   393\t    audio.setMusic(\'hangar\')   394\t    netPanel.style.display = \'none\'   395\t    wing.show(code, asServerHost, endpoint ? serverJoinLink(code, endpoint) : undefined, !!endpoint)   396\t    wing.status(endpoint ? \'Connecting to server\342\200\246\' : \'Looking for the host\342\200\246\')   397\t    const handlers = {   398\t      active: current,   399\t      status: (stage: string) => { if (current()) wing.status(stage) },   400\t      onLobby: (state: LobbyState) => {   401\t        if (!current()) return   402\t        lobbyState = state   403\t        wing.update(state, endpoint ? serverCanLaunch : undefined, launcherSeat)   404\t        serverReady = state.seats.filter(seat => seat.pilot === \'human\').length >= 2   405\t        renderPot()   406\t        updateAction()   407\t        if (endpoint) netPanel.style.display = \'none\'   408\t      },   409\t      onServerError: () => {   410\t        if (current()) updateAction()   411\t      },   412\t      onServerRole: (canLaunch: boolean, lead: number) => {   413\t        if (!current()) return   414\t        serverCanLaunch = canLaunch   415\t        launcherSeat = lead   416\t        if (lobbyState) wing.update(lobbyState, canLaunch, lead)   417\t        updateAction()   418\t      },   419\t      onPotRoom: (pot: { buyInSats: number; paidSeats: number[] }) => {   420\t        if (!current()) return   421\t        potRoom = pot   422\t        activePotRoom = true   423\t        renderPot()   424\t        updateAction()   425\t        if (potClaim && potPoll === null && ![\'completed\', \'failed\', \'expired\'].includes(potStatus?.state ?? \'\')) {   426\t          void refreshPot(false)   427\t          potPoll = window.setInterval(() => { void refreshPot(false) }, 3000)   428\t        }   429\t      },   430\t      onPotClaim: (claim: { seat: number; buyInSats: number; paymentId: string; token: string }) => {   431\t        if (!current() || !endpoint) return   432\t        const nextClaim = { seat: claim.seat, token: claim.token }   433\t        try {   434\t          const key = `neonorbit:pot:${endpoint}:${code}`   435\t          const value = JSON.stringify(nextClaim)   436\t          localStorage.setItem(key, value)   437\t          if (localStorage.getItem(key) !== value) throw new Error(\'claim was not saved\')   438\t        } catch {   439\t          potClaim = undefined   440\t          potStatus = { paymentId: claim.paymentId, state: \'storage-unavailable\', invoice: null }   441\t          renderPot()   442\t          return   443\t        }   444\t        potClaim = nextClaim   445\t        void refreshPot(true)   446\t        if (potPoll === null) potPoll = window.setInterval(() => { void refreshPot(false) }, 3000)   447\t      },   448\t      onServerResumeToken: (token: string) => {   449\t        if (current() && endpoint) serverResume = { endpoint, code, token }   450\t      },   451\t      onWelcome: (seat: number) => {   452\t        if (!current()) return   453\t        wing.hide()   454\t        hangar.close()   455\t        audio.setMusic(\'combat\')   456\t        netPanel.style.display = \'none\'   457\t        screens.moveTo(\'flight\')   458\t        hud.callout(`SEAT ${seat + 1}`, \'#6be6ff\', 1.5)   459\t        input.requestPointerLock()   460\t      },   461\t      onRefused: (reason: \'version\' | \'full\') => {   462\t        if (!current()) return   463\t        offerRetry(code, \'COULD NOT JOIN\',   464\t          reason === \'version\' ? \'game versions differ \342\200\224 reload both pages\' : \'the host has no seat free\',   465\t          reason === \'full\' ? \'A disconnected seat frees when the host notices the drop.\' : \'\')   466\t      },   467\t      onLink: (link: { state: \'up\' | \'down\' | \'degraded\'; reason: string; route: string }) => {   468\t        if (!current()) return   469\t        const route = link.route ? `<div style=\"opacity:.7\">route ${link.route}</div>` : \'\'   470\t        if (link.state === \'degraded\') {   471\t          netStatus(   472\t            `LINK LOST <b>${code}</b><div style=\"color:#ffb547\">${link.reason} \342\200\224 waiting up to ${LINK_GRACE_MS / 1000} s for it to recover</div>${route}`,   473\t          )   474\t        } else if (link.state === \'up\') {   475\t          if ((joining?.client.seat ?? -1) >= 0) netPanel.style.display = \'none\'   476\t          else netStatus(`JOINING <b>${code}</b><div>connected \342\200\224 waiting for room status</div>`)   477\t        } else {   478\t          const note = endpoint && serverResume?.code === code   479\t            ? \'Your seat is held briefly. Select RETRY to reclaim it.\'   480\t            : link.route ? `route was ${link.route}` : \'\'   481\t          offerRetry(code, \'CONNECTION LOST\', link.reason, note)   482\t        }   483\t      },   484\t    }   485\t    const connect = endpoint ? joinServer(game, endpoint, code, ship, handlers, resumeToken, potClaim)   486\t      : joinMatch(game, code, ship, handlers)   487\t    connect   488\t      .then((j) => {   489\t        if (current()) joining = j   490\t        else j.stop()   491\t      })   492\t      .catch((error) => {   493\t        if (!current()) return   494\t        console.error(error)   495\t        offerRetry(code, \'COULD NOT JOIN\', error instanceof Error ? error.message : String(error))   496\t        checkPotClaim(code)   497\t      })   498\t  }   499\t   500\t  const screens = createScreens({   501\t    pause: () => game.pause(),   502\t    resume: () => game.resume(),   503\t    showPanel: () => pause.show(input.invertPitch, audio.muted),   504\t    hidePanel: () => pause.hide(),   505\t    grabPointer: () => input.requestPointerLock(),   506\t  })   507\t   508\t  function finishRun(result: RunResult) {   509\t    pendingResult = result   510\t    const previous = bestFor(result.ship)?.score ?? 0"
    }
