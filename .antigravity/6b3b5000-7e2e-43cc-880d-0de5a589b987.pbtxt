      arguments_json: "{\"CommandLine\":\"NODE_PATH=/usr/local/share/bun-global/node_modules node -e \'\\nconst { chromium } = require(\\\"playwright\\\");\\n\\n(async () => {\\n  const browser = await chromium.launch({\\n    headless: true,\\n    args: [\\\"--use-gl=angle\\\", \\\"--use-angle=swiftshader\\\", \\\"--enable-webgl\\\", \\\"--ignore-gpu-blocklist\\\"]\\n  });\\n  const context = await browser.newContext({ viewport: { width: 1280, height: 720 } });\\n  const page = await context.newPage();\\n\\n  const errors = [];\\n  page.on(\\\"pageerror\\\", (e) => errors.push(\\\"PAGEERROR: \\\" + e.message));\\n  page.on(\\\"console\\\", (msg) => {\\n    if (msg.type() === \\\"error\\\") errors.push(\\\"CONSOLE_ERROR: \\\" + msg.text());\\n  });\\n\\n  await page.goto(\\\"http://localhost:3000/\\\", { waitUntil: \\\"networkidle\\\" });\\n  await page.waitForTimeout(1000);\\n\\n  // Clear localStorage to verify clean v5 default loading\\n  await page.evaluate(() => localStorage.clear());\\n  await page.reload({ waitUntil: \\\"networkidle\\\" });\\n  await page.waitForTimeout(1000);\\n\\n  // 1. Open Settings and verify calibrated defaults & capture screenshot\\n  const settingsBtn = page.getByRole(\\\"button\\\", { name: /settings/i });\\n  await settingsBtn.click();\\n  await page.waitForTimeout(500);\\n\\n  const defaultSettings = await page.evaluate(() => window.__STARFALL_DIAG__.getSettings());\\n  console.log(\\\"=== INITIAL DEFAULT SETTINGS ===\\\");\\n  console.log(JSON.stringify({\\n    aimBoundaryWidth: defaultSettings.aimBoundaryWidth,\\n    aimBoundaryHeight: defaultSettings.aimBoundaryHeight,\\n    aimBoundaryCornerRadius: defaultSettings.aimBoundaryCornerRadius,\\n    precisionSensitivity: defaultSettings.precisionSensitivity,\\n    boundarySensitivity: defaultSettings.boundarySensitivity,\\n    maxSensitivity: defaultSettings.maxSensitivity,\\n    accelerationDistance: defaultSettings.accelerationDistance,\\n    responseCurve: defaultSettings.responseCurve,\\n    angularSmoothing: defaultSettings.angularSmoothing,\\n    recoverySmoothing: defaultSettings.recoverySmoothing,\\n  }, null, 2));\\n\\n  await page.screenshot({ path: \\\"/tmp/starfall_calib_settings.png\\\" });\\n\\n  // Close settings -> Launch Mission 01\\n  await page.getByRole(\\\"button\\\", { name: /back/i }).click();\\n  await page.waitForTimeout(300);\\n  await page.getByRole(\\\"button\\\", { name: /play|campaign|launch|missions/i }).first().click();\\n  await page.waitForTimeout(500);\\n  // Click launch mission button\\n  const launchBtn = page.getByRole(\\\"button\\\", { name: /launch/i }).first();\\n  if (await launchBtn.isVisible()) {\\n    await launchBtn.click();\\n  }\\n\\n  // Wait until phase === \\\"playing\\\"\\n  await page.waitForFunction(() => window.__STARFALL_DIAG__?.getPhase() === \\\"playing\\\", { timeout: 15000 });\\n  await page.waitForTimeout(600);\\n\\n  // Mock pointerLockElement to the canvas so headless Chromium processes MouseEvent movementX/Y through real InputManager\\n  const lockSetup = await page.evaluate(() => {\\n    const canvas = document.querySelector(\\\"canvas\\\");\\n    Object.defineProperty(document, \\\"pointerLockElement\\\", {\\n      configurable: true,\\n      get: () => canvas,\\n    });\\n    document.dispatchEvent(new Event(\\\"pointerlockchange\\\"));\\n    return {\\n      canvasW: canvas ? canvas.clientWidth : 0,\\n      canvasH: canvas ? canvas.clientHeight : 0,\\n      locked: window.__STARFALL_DIAG__.getInput().isPointerLocked(),\\n    };\\n  });\\n  console.log(\\\"=== POINTER LOCK VERIFICATION ===\\\");\\n  console.log(JSON.stringify(lockSetup));\\n\\n  // Helper: reset aim + velocity, apply real mousemove displacement, step real rAF frames, measure steady-state angular velocity\\n  const measureDisplacement = async (dx, dy, settleMs = 450) => {\\n    await page.evaluate(() => {\\n      const f = window.__STARFALL_DIAG__.getFlight();\\n      const s = window.__STARFALL_DIAG__.getSettings();\\n      f.centerAimCursor(s.precisionSensitivity);\\n      f.yawVelocity = 0;\\n      f.pitchVelocity = 0;\\n      f.rollVelocity = 0;\\n    });\\n    // Dispatch real MouseEvents in realistic increments (<= 40px per event)\\n    await page.evaluate(({ dx, dy }) => {\\n      const steps = Math.max(1, Math.ceil(Math.max(Math.abs(dx), Math.abs(dy)) / 40));\\n      const sx = dx / steps;\\n      const sy = dy / steps;\\n      for (let i = 0; i < steps; i++) {\\n        const ev = new MouseEvent(\\\"mousemove\\\", { bubbles: true, cancelable: true });\\n        Object.defineProperty(ev, \\\"movementX\\\", { value: sx });\\n        Object.defineProperty(ev, \\\"movementY\\\", { value: sy });\\n        window.dispatchEvent(ev);\\n      }\\n    }, { dx, dy });\\n\\n    await page.waitForTimeout(settleMs);\\n\\n    return await page.evaluate(() => {\\n      const f = window.__STARFALL_DIAG__.getFlight();\\n      const t = window.__STARFALL_DIAG__.getTelemetry();\\n      const RAD2DEG = 180 / Math.PI;\\n      return {\\n        virtualX: Number(f.virtualAimX.toFixed(1)),\\n        virtualY: Number(f.virtualAimY.toFixed(1)),\\n        clampedX: Number(f.aimClamp.clampedX.toFixed(1)),\\n        clampedY: Number(f.aimClamp.clampedY.toFixed(1)),\\n        excessX: Number(f.aimClamp.excessX.toFixed(1)),\\n        excessY: Number(f.aimClamp.excessY.toFixed(1)),\\n        inside: f.aimClamp.inside,\\n        zone: t.steeringZone,\\n        sensX: Number(t.steeringSensitivityX.toFixed(3)),\\n        sensY: Number(t.steeringSensitivityY.toFixed(3)),\\n        yawRadS: Number(f.yawVelocity.toFixed(3)),\\n        yawDegS: Number((Math.abs(f.yawVelocity) * RAD2DEG).toFixed(2)),\\n        pitchRadS: Number(f.pitchVelocity.toFixed(3)),\\n        pitchDegS: Number((Math.abs(f.pitchVelocity) * RAD2DEG).toFixed(2)),\\n        screenX: Number(t.aimScreenX.toFixed(4)),\\n        screenY: Number(t.aimScreenY.toFixed(4)),\\n        boundW: Number(t.aimBoundaryWidthPx.toFixed(1)),\\n        boundH: Number(t.aimBoundaryHeightPx.toFixed(1)),\\n      };\\n    });\\n  };\\n\\n  console.log(\\\"\\\\n=== TEST A: HORIZONTAL DISPLACEMENT SWEEP (1280x720, halfW = 256px) ===\\\");\\n  for (const dx of [15, 30, 50, 80, 128, 180, 220, 250, 256, 286, 350, 496, 736, 1200]) {\\n    const r = await measureDisplacement(dx, 0, 500);\\n    console.log(`dx=${String(dx).padStart(4)}px | clamped=${String(r.clampedX).padStart(5)}px | excess=${String(r.excessX).padStart(5)}px | zone=${r.zone.padEnd(12)} | sensX=${r.sensX.toFixed(3)} | yaw=${String(r.yawDegS).padStart(6)} deg/s (${r.yawRadS} rad/s)`);\\n  }\\n\\n  console.log(\\\"\\\\n=== TEST B: VERTICAL DISPLACEMENT SWEEP (1280x720, halfH = 162px) ===\\\");\\n  for (const dy of [15, 30, 50, 81, 120, 158, 162, 200, 402, 642]) {\\n    const r = await measureDisplacement(0, dy, 500);\\n    console.log(`dy=${String(dy).padStart(4)}px | clamped=${String(r.clampedY).padStart(5)}px | excess=${String(r.excessY).padStart(5)}px | zone=${r.zone.padEnd(12)} | sensY=${r.sensY.toFixed(3)} | pitch=${String(r.pitchDegS).padStart(6)} deg/s (${r.pitchRadS} rad/s)`);\\n  }\\n\\n  console.log(\\\"\\\\n=== TEST C: DIAGONAL CORNER PROJECTION & SCREEN EDGE CONTINUITY ===\\\");\\n  const cornerRes = await measureDisplacement(420, 320, 450);\\n  console.log(\\\"Diagonal (420, 320):\\\", JSON.stringify(cornerRes));\\n  // Capture live flight HUD screenshot at precision offset (110, -55)\\n  await measureDisplacement(110, -55, 300);\\n  await page.screenshot({ path: \\\"/tmp/starfall_calib_flight.png\\\" });\\n\\n  console.log(\\\"\\\\n=== TEST D: PARAMETER INDEPENDENCE AUDIT ===\\\");\\n  const indep = await page.evaluate(() => {\\n    const f = window.__STARFALL_DIAG__.getFlight();\\n    const t = window.__STARFALL_DIAG__.getTelemetry();\\n    const base = { ...window.__STARFALL_DIAG__.getSettings() };\\n\\n    const runSim = (settingsPatch, dx, frames = 90) => {\\n      const s = { ...base, ...settingsPatch };\\n      f.centerAimCursor(s.precisionSensitivity);\\n      f.yawVelocity = 0;\\n      f.pitchVelocity = 0;\\n      const snap = {\\n        forward: false, backward: false, rollLeft: false, rollRight: false, boost: false,\\n        firePrimary: false, keyPitchUp: false, keyPitchDown: false, keyYawLeft: false, keyYawRight: false,\\n        mouseDeltaX: dx, mouseDeltaY: 0, pointerLocked: true\\n      };\\n      f.update(1 / 60, snap, s, t, 1280, 720);\\n      snap.mouseDeltaX = 0;\\n      for (let i = 1; i < frames; i++) {\\n        f.update(1 / 60, snap, s, t, 1280, 720);\\n      }\\n      return {\\n        clampedX: Number(f.aimClamp.clampedX.toFixed(4)),\\n        excessX: Number(f.aimClamp.excessX.toFixed(4)),\\n        sensX: Number(t.steeringSensitivityX.toFixed(4)),\\n        yawDegS: Number((Math.abs(f.yawVelocity) * 180 / Math.PI).toFixed(3)),\\n        zone: t.steeringZone,\\n      };\\n    };\\n\\n    // 1. Inside precision zone (dx=128px): change beyond-boundary params wildly -> precision MUST NOT CHANGE\\n    const pBaseline = runSim({}, 128);\\n    const pDiffMax = runSim({ maxSensitivity: 3.0, boundarySensitivity: 0.15, responseCurve: 3.5, accelerationDistance: 100 }, 128);\\n\\n    // 2. Inside precision zone (dx=240px, near edge!): change beyond-boundary params -> precision MUST NOT CHANGE\\n    const pEdgeBase = runSim({}, 240);\\n    const pEdgeDiff = runSim({ maxSensitivity: 3.0, boundarySensitivity: 0.15, responseCurve: 3.5 }, 240);\\n\\n    // 3. Change precisionSensitivity -> clampedX (reticle pos) and Zone C excess/sens MUST NOT CHANGE\\n    const cBase = runSim({ precisionSensitivity: 0.50 }, 496);\\n    const cLowPrec = runSim({ precisionSensitivity: 0.25 }, 496);\\n    const rBase = runSim({ precisionSensitivity: 0.50 }, 128);\\n    const rHighPrec = runSim({ precisionSensitivity: 0.90 }, 128);\\n\\n    return {\\n      precision128_unchangedByBeyondBoundary: pBaseline.yawDegS === pDiffMax.yawDegS && pBaseline.sensX === pDiffMax.sensX,\\n      pBaseline, pDiffMax,\\n      precision240Edge_unchangedByBeyondBoundary: pEdgeBase.yawDegS === pEdgeDiff.yawDegS && pEdgeBase.sensX === pEdgeDiff.sensX,\\n      pEdgeBase, pEdgeDiff,\\n      reticlePos128_unchangedByPrecisionSens: rBase.clampedX === rHighPrec.clampedX,\\n      rBase, rHighPrec,\\n      zoneC496_unchangedByPrecisionSens: cBase.sensX === cLowPrec.sensX && cBase.excessX === cLowPrec.excessX,\\n      cBase, cLowPrec,\\n    };\\n  });\\n  console.log(JSON.stringify(indep, null, 2));\\n\\n  console.log(\\\"\\\\n=== TEST E: TIME-CONSTANT VERIFICATION (ANGULAR SMOOTHING 0.08s & RETICLE RECOVERY 0.12s) ===\\\");\\n  const timing = await page.evaluate(() => {\\n    const f = window.__STARFALL_DIAG__.getFlight();\\n    const t = window.__STARFALL_DIAG__.getTelemetry();\\n    const s = { ...window.__STARFALL_DIAG__.getSettings() };\\n    const dt = 1 / 120; // 120Hz high-res measurement\\n\\n    // E1: Angular smoothing step response (0 -> 128px inside precision zone)\\n    f.centerAimCursor(s.precisionSensitivity);\\n    f.yawVelocity = 0;\\n    const snap = {\\n      forward: false, backward: false, rollLeft: false, rollRight: false, boost: false,\\n      firePrimary: false, keyPitchUp: false, keyPitchDown: false, keyYawLeft: false, keyYawRight: false,\\n      mouseDeltaX: 128, mouseDeltaY: 0, pointerLocked: true\\n    };\\n    const samples = [];\\n    for (let i = 0; i < 120; i++) {\\n      f.update(dt, snap, s, t, 1280, 720);\\n      snap.mouseDeltaX = 0;\\n      samples.push({ time: (i + 1) * dt, yaw: Math.abs(f.yawVelocity) });\\n    }\\n    const steadyYaw = samples[samples.length - 1].yaw;\\n    const tau63Sample = samples.find((x) => x.yaw >= steadyYaw * 0.6321);\\n\\n    // E2: Reticle recovery time constant (Zone C overdrive 600px -> back inside precision zone 100px)\\n    f.centerAimCursor(s.precisionSensitivity);\\n    f.virtualAimX = 600;\\n    for (let i = 0; i < 120; i++) {\\n      f.update(dt, snap, s, t, 1280, 720);\\n    }\\n    const startSens = f.smoothedSensX;\\n    // Jump back inside precision zone\\n    f.virtualAimX = 100;\\n    const recSamples = [];\\n    for (let i = 0; i < 120; i++) {\\n      f.update(dt, snap, s, t, 1280, 720);\\n      recSamples.push({ time: (i + 1) * dt, sens: f.smoothedSensX });\\n    }\\n    const targetSens = s.precisionSensitivity;\\n    const rec63Target = startSens - (startSens - targetSens) * 0.6321;\\n    const recTauSample = recSamples.find((x) => x.sens <= rec63Target);\\n\\n    return {\\n      steadyYawDegS: Number((steadyYaw * 180 / Math.PI).toFixed(2)),\\n      measuredAngularTauSec: tau63Sample ? Number(tau63Sample.time.toFixed(4)) : null,\\n      configuredAngularSmoothingSec: s.angularSmoothing,\\n      startOverdriveSens: Number(startSens.toFixed(3)),\\n      targetPrecisionSens: targetSens,\\n      measuredRecoveryTauSec: recTauSample ? Number(recTauSample.time.toFixed(4)) : null,\\n      configuredRecoverySec: s.recoverySmoothing,\\n    };\\n  });\\n  console.log(JSON.stringify(timing, null, 2));\\n\\n  console.log(\\\"\\\\n=== TEST F: FINE TARGET-TRACKING MICRO-CORRECTION SEQUENCE ===\\\");\\n  const tracking = await page.evaluate(() => {\\n    const f = window.__STARFALL_DIAG__.getFlight();\\n    const t = window.__STARFALL_DIAG__.getTelemetry();\\n    const s = { ...window.__STARFALL_DIAG__.getSettings() };\\n    const dt = 1 / 60;\\n    f.centerAimCursor(s.precisionSensitivity);\\n    f.reset(undefined, s.precisionSensitivity);\\n    const snap = {\\n      forward: true, backward: false, rollLeft: false, rollRight: false, boost: false,\\n      firePrimary: false, keyPitchUp: false, keyPitchDown: false, keyYawLeft: false, keyYawRight: false,\\n      mouseDeltaX: 0, mouseDeltaY: 0, pointerLocked: true\\n    };\\n    // Simulate small wrist micro-correction: +25px for 0.3s, then -25px back to center for 0.3s\\n    snap.mouseDeltaX = 25;\\n    let maxYawDegS = 0;\\n    let totalYawDeg = 0;\\n    for (let i = 0; i < 18; i++) {\\n      f.update(dt, snap, s, t, 1280, 720);\\n      snap.mouseDeltaX = 0;\\n      const yawDegS = Math.abs(f.yawVelocity) * 180 / Math.PI;\\n      if (yawDegS > maxYawDegS) maxYawDegS = yawDegS;\\n      totalYawDeg += yawDegS * dt;\\n    }\\n    // Pull back to center (-25px) and measure residual drift over next 0.25s\\n    snap.mouseDeltaX = -25;\\n    let stopDriftDeg = 0;\\n    let finalYawDegS = 0;\\n    for (let i = 0; i < 15; i++) {\\n      f.update(dt, snap, s, t, 1280, 720);\\n      snap.mouseDeltaX = 0;\\n      const yawDegS = Math.abs(f.yawVelocity) * 180 / Math.PI;\\n      stopDriftDeg += yawDegS * dt;\\n      finalYawDegS = yawDegS;\\n    }\\n    return {\\n      microNudgePx: 25,\\n      holdDurationSec: 0.30,\\n      peakYawDegS: Number(maxYawDegS.toFixed(2)),\\n      totalRotationDeg: Number(totalYawDeg.toFixed(2)),\\n      stopOvershootDriftDeg: Number(stopDriftDeg.toFixed(2)),\\n      residualYawAfter250msDegS: Number(finalYawDegS.toFixed(3)),\\n    };\\n  });\\n  console.log(JSON.stringify(tracking, null, 2));\\n\\n  console.log(\\\"\\\\n=== CONSOLE / PAGE ERRORS ===\\\");\\n  console.log(errors.length === 0 ? \\\"ZERO ERRORS\\\" : errors.join(\\\"\\\\n\\\"));\\n\\n  await browser.close();\\n})().catch((e) => {\\n  console.error(e);\\n  process.exit(1);\\n});\\n\'\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Running live browser calibration tests\", \"toolSummary\":\"Run browser calibration suite\"}"
      thinking_signature: "\022\336\003\n\333\003\001i\024}\023\034:\277\'\373\243\226\245\242\314\263-\241\t\246%\331,\033\273\344\314\036\342\327rZ.\254R\006\a\tj\256\035\344\221o\251\220($6|\256\272\275\315\373\226 \235\245\306\300\3573\340\004\t\351\2533\202/<\313~\314\3030 \210\3042av%\256\363X\006\330\375O;M\222\351\006\376|Z^\210Uoq\200\246\327wn\221\035\240\216\321\357y\250:\364\237\363\230\b\372\300\223^\251\245\2141\362V}\346\275$\372\277V/\254\315\027\024\334\342>\256hHs\257\306oy\226o\366\224\234(\305\214t\177\034\351C\330\354\261:\201\364\3768\217\030:\342\257\025\320%\213\300*\263\321\221+:7\206R6\375\300\212\372 \345i=\343-\263\320B\311\333\222>\031\310\224\206\177;\204\002\225x\376]<\303\223]\222\266lj\231xeH\205\025\265\312\305\266\023N:\331D]\252=\2416\020Zgu\340W\272\312\301\222z[\247\033\244\264\206\337\347\335\304\271R\305G\225\235\340\364\222\325\305<\232yT\310\307i\"\327\277\317\352\a\016I\020{\317+NgoS\201^\303\000I\241\021W\272\216\361\201\f]\004H\201p\265\027C\027ZK\026W\353\256>6\024\306\344\251@\305A\234\254\307\344\235\217\035\375\002X\036l|\372NSoT/\004\327\210)\031\b\272\345\0329l\311\245\b%\035\341dF/\t\352d\371\244\037$\354\275?\317/F\006tw\272rs\312hKP\201\202\244\tq!^\345\351\206\361D\227\331_\205\273\217\034\201\210n\354dbw\033\264\210\206\230\354\263\307\227\305\316a\267\371\265\236\230\315D\316gb\006\022\242a)\222\376\026n\244\026\336\3311\016\177\355\246\340"
