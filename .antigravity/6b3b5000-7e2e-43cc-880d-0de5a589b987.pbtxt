      thinking_signature: "\022\350\022\n\345\022\001i\024}\023\354w\273\242\2460\306g\006[\036\320J\314\227\027@\rg\322\323\212\377`\365\301\222\364\207\375\376\\s\177\226}\022\205\021\253\235\207\214*(\227\370ia@hr\230\216\322\021\206bC\206\005\3265\210\256\367\024\315\030\266\273T\206\226\240Y\327\301@m\022\023\277p\371,u\356j\346\227\305\a\322\002\376\215}~~S\257!\366o\331+\224z\370\374\216\'K1a\v\022\216@\332U\271\252\340\323;\235\3430\2709\020\217\232;\030q.<wC\235S\021v\b\016Y\350^G`\364\354\225p7a\372\364Z\210\302\332\3060\024\r\341>\213\032\360\331\322S\237\3174\346\350\b\373B\005\274\031\271\213\243\2053U\373g\371qq+D\316L\204\263PY\224\351[%o\347!w\3240:^+Y\355\274\317@m\203\177\210\267\b\370\r\322\364\017\024\r\005\250e\253X\354\257e\335`\267E\354\240\226\345\016\363\306\302\271\343C\302\205e\317%\266\377\024\335\367\177(W\377L\312rZ\304 Z\261\3468\234\353\312\337>\274\275\264\363\330\314\266\230p\205Q87\2559\352\v\203\022\267b\a\356\201\0063:\325/>x\333\2476\351\326\373O\364\310\363(\316\264\2051~RNj\335U\256D \366o@\0263,\361[N\361\226\203mX-\025\263\366\252\230\004\312\217>\315E\324\345\225\256\253b\2275\254Xi=\320\211\031\304\036B\267Ja\030\205\343\357k\000\365\037@\272\233tI\377\310L\230\rI\200s\217\337\231\033/\213\264\246\346Lm\255`\306\034\344q(F\355\"I\211d\274\232w\026\221X<\005\354\370\364\033\350\307i\242\306\005m}T\251D\366\234\305\270X\257\220\020 \365\232\004V\177h[\341\027\213\230\314z#\263^\324\335\276+\255\347\a\357\375\371\361\214,\222m\252\232\331dR3\326\320\315\b\3256\223\220\034P\225\205\277\240\223\276\r\347.\243X@7\310\274\216<t\020\355)8\025c\203$4\367eu\260O\347\311\266\313\260\022\277\360Oi\005I\261\302\024\346@n\307t\202\365F(\203\300\355N(\377\377ah\314g\2028\241\270\v)\023\363\025\210T\311d9r\275u^\230\333}\243\240\317\247\250\fR\333\305\342t\031\231&<F\177%\022\342\365\232w4\363`\241\354\363\314\371\312G\\\\P\234urA\341a\315\325\002\255\210\365m\243\362\360j\302\r\312\2270\345\264;\367Z\367\207\367\006\232\271&7\327}\364\20