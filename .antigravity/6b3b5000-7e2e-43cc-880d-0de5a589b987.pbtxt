    replacement_infos {
      original_chunk {
        target_content: "    // 2. Accumulate unconstrained relative mouse displacement (zero hard input cutoff)\n    const baseSens = THREE.MathUtils.clamp(\n      settings.mouseSensitivity,\n      STEERING_BOUNDS.mouseSensitivity.min,\n      STEERING_BOUNDS.mouseSensitivity.max,\n    );\n    const accelDist = THREE.MathUtils.clamp(\n      settings.accelerationDistance,\n      STEERING_BOUNDS.accelerationDistance.min,\n      STEERING_BOUNDS.accelerationDistance.max,\n    );\n    const boundarySens = THREE.MathUtils.clamp(\n      settings.boundarySensitivity,\n      STEERING_BOUNDS.boundarySensitivity.min,\n      STEERING_BOUNDS.boundarySensitivity.max,\n    );\n    const maxSens = Math.max(\n      boundarySens + 0.1,\n      THREE.MathUtils.clamp(\n        settings.maxSensitivity,\n        STEERING_BOUNDS.maxSensitivity.min,\n        STEERING_BOUNDS.maxSensitivity.max,\n      ),\n    );\n    const curveExp = THREE.MathUtils.clamp(\n      settings.responseCurve,\n      STEERING_BOUNDS.responseCurve.min,\n      STEERING_BOUNDS.responseCurve.max,\n    );\n    const recoverySec = THREE.MathUtils.clamp(\n      settings.recoverySmoothing,\n      STEERING_BOUNDS.recoverySmoothing.min,\n      STEERING_BOUNDS.recoverySmoothing.max,\n    );\n    const ySign = settings.invertY ? -1 : 1;\n\n    if (input.mouseDeltaX !== 0) {\n      this.virtualAimX = accumulateAxisDisplacement(\n        this.virtualAimX,\n        this.aimClamp.clampedX,\n        this.aimClamp.excessX,\n        input.mouseDeltaX * baseSens,\n        accelDist,\n      );\n    }\n    if (input.mouseDeltaY !== 0) {\n      this.virtualAimY = accumulateAxisDisplacement(\n        this.virtualAimY,\n        this.aimClamp.clampedY,\n        this.aimClamp.excessY,\n        input.mouseDeltaY * baseSens * ySign,\n        accelDist,\n      );\n    }\n\n    // 3. Clamp virtual reticle strictly onto the rounded-rectangle boundary while preserving excess\n    clampToRoundedRect(this.virtualAimX, this.virtualAimY, this.aimBoundary, this.aimClamp);\n    this.aimCursorX = this.aimClamp.normalizedX;\n    this.aimCursorY = this.aimClamp.normalizedY;\n\n    // 4. Evaluate progressive sensitivity independently for horizontal (yaw) and vertical (pitch)\n    evaluateProgressiveAxisSensitivity(\n      Math.abs(this.aimClamp.clampedX),\n      this.aimClamp.axisBoundaryX,\n      this.aimClamp.excessX,\n      accelDist,\n      STEERING_CONFIG.normalSensitivity,\n      boundarySens,\n      maxSens,\n      curveExp,\n      _evalX,\n    );\n    evaluateProgressiveAxisSensitivity(\n      Math.abs(this.aimClamp.clampedY),\n      this.aimClamp.axisBoundaryY,\n      this.aimClamp.excessY,\n      accelDist,\n      STEERING_CONFIG.normalSensitivity,\n      boundarySens,\n      maxSens,\n      curveExp,\n      _evalY,\n    );\n\n    // Frame-rate independent smooth recovery (~0.12s) eliminates sudden sensitivity jumps\n    const recoveryAlpha = 1 - Math.exp(-safeDt / recoverySec);\n    this.smoothedSensX = THREE.MathUtils.lerp(\n      this.smoothedSensX,\n      _evalX.targetSensitivity,\n      recoveryAlpha,\n    );\n    this.smoothedSensY = THREE.MathUtils.lerp(\n      this.smoothedSensY,\n      _evalY.targetSensitivity,\n      recoveryAlpha,\n    );"
        replacement_content: "    // 2. Accumulate unconstrained 1:1 relative mouse displacement (zero duplicated sensitivity multiplier)\n    //    Reticle travel and boundary reach depend strictly on raw relative mouse pixels and Aim Boundary Size.\n    const precisionSens = THREE.MathUtils.clamp(\n      settings.precisionSensitivity,\n      STEERING_BOUNDS.precisionSensitivity.min,\n      STEERING_BOUNDS.precisionSensitivity.max,\n    );\n    const accelDist = THREE.MathUtils.clamp(\n      settings.accelerationDistance,\n      STEERING_BOUNDS.accelerationDistance.min,\n      STEERING_BOUNDS.accelerationDistance.max,\n    );\n    const boundarySens = THREE.MathUtils.clamp(\n      settings.boundarySensitivity,\n      STEERING_BOUNDS.boundarySensitivity.min,\n      STEERING_BOUNDS.boundarySensitivity.max,\n    );\n    const maxSens = Math.max(\n      boundarySens + 0.1,\n      THREE.MathUtils.clamp(\n        settings.maxSensitivity,\n        STEERING_BOUNDS.maxSensitivity.min,\n        STEERING_BOUNDS.maxSensitivity.max,\n      ),\n    );\n    const curveExp = THREE.MathUtils.clamp(\n      settings.responseCurve,\n      STEERING_BOUNDS.responseCurve.min,\n      STEERING_BOUNDS.responseCurve.max,\n    );\n    const angularSmoothSec = THREE.MathUtils.clamp(\n      settings.angularSmoothing,\n      STEERING_BOUNDS.angularSmoothing.min,\n      STEERING_BOUNDS.angularSmoothing.max,\n    );\n    const recoverySec = THREE.MathUtils.clamp(\n      settings.recoverySmoothing,\n      STEERING_BOUNDS.recoverySmoothing.min,\n      STEERING_BOUNDS.recoverySmoothing.max,\n    );\n    const ySign = settings.invertY ? -1 : 1;\n\n    if (input.mouseDeltaX !== 0) {\n      this.virtualAimX = accumulateAxisDisplacement(\n        this.virtualAimX,\n        this.aimClamp.clampedX,\n        this.aimClamp.excessX,\n        input.mouseDeltaX,\n        accelDist,\n      );\n    }\n    if (input.mouseDeltaY !== 0) {\n      this.virtualAimY = accumulateAxisDisplacement(\n        this.virtualAimY,\n        this.aimClamp.clampedY,\n        this.aimClamp.excessY,\n        input.mouseDeltaY * ySign,\n        accelDist,\n      );\n    }\n\n    // 3. Clamp virtual reticle strictly onto the rounded-rectangle boundary while preserving excess\n    clampToRoundedRect(this.virtualAimX, this.virtualAimY, this.aimBoundary, this.aimClamp);\n    this.aimCursorX = this.aimClamp.normalizedX;\n    this.aimCursorY = this.aimClamp.normalizedY;\n\n    // 4. Evaluate progressive sensitivity independently for horizontal (yaw) and vertical (pitch)\n    evaluateProgressiveAxisSensitivity(\n      Math.abs(this.aimClamp.clampedX),\n      this.aimClamp.axisBoundaryX,\n      this.aimClamp.excessX,\n      accelDist,\n      precisionSens,\n      boundarySens,\n      maxSens,\n      curveExp,\n      _evalX,\n    );\n    evaluateProgressiveAxisSensitivity(\n      Math.abs(this.aimClamp.clampedY),\n      this.aimClamp.axisBoundaryY,\n      this.aimClamp.excessY,\n      accelDist,\n      precisionSens,\n      boundarySens,\n      maxSens,\n      curveExp,\n      _evalY,\n    );\n\n    // Frame-rate independent reticle/sensitivity recovery (~0.12s) eliminates abrupt zone jumps\n    const recoveryAlpha = 1 - Math.exp(-safeDt / recoverySec);\n    this.smoothedSensX = THREE.MathUtils.lerp(\n      this.smoothedSensX,\n      _evalX.targetSensitivity,\n      recoveryAlpha,\n    );\n    this.smoothedSensY = THREE.MathUtils.lerp(\n      this.smoothedSensY,\n      _evalY.targetSensitivity,\n      recoveryAlpha,\n    );"
        start_line: 373
        end_line: 469
      }
      num_matches: 1
    }
    replacement_infos {
      original_chunk {
        target_content: "    // Preserved Phase 1 snappy arcade turn response with controlled inertia (frame-rate independent)\n    const isSteering = Math.abs(targetYawRate) > 0.01 || Math.abs(targetPitchRate) > 0.01;\n    const responseLambda = profile.angularDamping * (isSteering ? 2.1 : 1.8);\n    const turnAlpha = 1 - Math.exp(-responseLambda * safeDt);\n    this.yawVelocity = THREE.MathUtils.lerp(this.yawVelocity, targetYawRate, turnAlpha);\n    this.pitchVelocity = THREE.MathUtils.lerp(this.pitchVelocity, targetPitchRate, turnAlpha);\n\n    const stepYaw = this.yawVelocity * safeDt;\n    const stepPitch = this.pitchVelocity * safeDt;"
        replacement_content: "    // Independent frame-rate-independent angular smoothing (0.08s default for Interceptor,\n    // scaled proportionally by ship inertia so heavier hulls retain tactile weight)\n    const shipInertiaRatio = 7.5 / Math.max(profile.angularDamping, 1);\n    const effectiveAngularTau = angularSmoothSec * shipInertiaRatio;\n    const turnAlpha = 1 - Math.exp(-safeDt / effectiveAngularTau);\n    this.yawVelocity = THREE.MathUtils.lerp(this.yawVelocity, targetYawRate, turnAlpha);\n    this.pitchVelocity = THREE.MathUtils.lerp(this.pitchVelocity, targetPitchRate, turnAlpha);\n\n    const stepYaw = this.yawVelocity * safeDt;\n    const stepPitch = this.pitchVelocity * safeDt;"
        start_line: 510
        end_line: 520
      }
      num_matches: 1
    }
    description: "Remove duplicated mouseSensitivity pixel multiplier, wire independent precisionSensitivity, and implement 0.08s angularSmoothing in FlightController"
    diff_stats {
