  view_file {
    absolute_path_uri: "file:///src/components/SettingsPanel.tsx"
    end_line: 620
    content: "import { useMemo } from \'react\';\nimport { Volume2 } from \'lucide-react\';\nimport { AudioManager } from \'../audio/AudioManager\';\nimport { getGraphicsPresetPatch } from \'../config/graphics\';\nimport { DEFAULT_SETTINGS } from \'../config/ships\';\nimport { STEERING_BOUNDS, STEERING_CONFIG } from \'../config/steering\';\nimport { evaluateProgressiveAxisSensitivity } from \'../engine/AimBoundary\';\nimport type {\n  EffectQuality,\n  GameSettings,\n  GraphicsQuality,\n  ShadowQuality,\n} from \'../types/game\';\n\ninterface SettingsPanelProps {\n  settings: GameSettings;\n  onUpdateSettings: (patch: Partial<GameSettings>) => void;\n  onClose: () => void;\n  closeLabel?: string;\n}\n\nconst QUALITY_OPTIONS: Array<{ value: GraphicsQuality; label: string }> = [\n  { value: \'low\', label: \'Low\' },\n  { value: \'medium\', label: \'Medium\' },\n  { value: \'high\', label: \'High\' },\n  { value: \'ultra\', label: \'Ultra\' },\n];\n\nconst SHADOW_OPTIONS: Array<{ value: ShadowQuality; label: string }> = [\n  { value: \'off\', label: \'Off\' },\n  { value: \'low\', label: \'Low\' },\n  { value: \'medium\', label: \'Med\' },\n  { value: \'high\', label: \'High\' },\n];\n\nconst EFFECT_OPTIONS: Array<{ value: EffectQuality; label: string }> = [\n  { value: \'low\', label: \'Low\' },\n  { value: \'medium\', label: \'Med\' },\n  { value: \'high\', label: \'High\' },\n];\n\nfunction SteeringCurvePreview({ settings }: { settings: GameSettings }) {\n  const { pathD, boundaryXPos, refOneY } = useMemo(() => {\n    const W = 240;\n    const H = 64;\n    const padX = 8;\n    const padY = 8;\n    const plotW = W - padX * 2;\n    const plotH = H - padY * 2;\n    // Preview representative horizontal half-extent for a 1280px reference viewport\n    const B = 1280 * settings.aimBoundaryWidth * 0.5;\n    const S = settings.accelerationDistance;\n    const maxDisp = B + S * 3.0;\n    const maxY = Math.max(3.6, settings.maxSensitivity + 0.25);\n\n    const pts: string[] = [];\n    const steps = 48;\n    for (let i = 0; i <= steps; i++) {\n      const frac = i / steps;\n      const disp = frac * maxDisp;\n      const clampedCoord = Math.min(disp, B);\n      const excessPx = Math.max(0, disp - B);\n      const res = evaluateProgressiveAxisSensitivity(\n        clampedCoord,\n        B,\n        excessPx,\n        S,\n        STEERING_CONFIG.normalSensitivity,\n        settings.boundarySensitivity,\n        settings.maxSensitivity,\n        settings.responseCurve,\n      );\n      const px = padX + frac * plotW;\n      const py = padY + plotH - (res.targetSensitivity / maxY) * plotH;\n      pts.push(`${i === 0 ? \'M\' : \'L\'}${px.toFixed(1)},${py.toFixed(1)}`);\n    }\n\n    const bx = padX + (B / maxDisp) * plotW;\n    const oneY = padY + plotH - (1.0 / maxY) * plotH;\n    return { pathD: pts.join(\' \'), boundaryXPos: bx, refOneY: oneY };\n  }, [\n    settings.aimBoundaryWidth,\n    settings.accelerationDistance,\n    settings.boundarySensitivity,\n    settings.maxSensitivity,\n    settings.responseCurve,\n  ]);\n\n  return (\n    <div className=\"border border-slate-800 bg-[#060f21] px-2.5 py-2\">\n      <div className=\"mb-1 flex items-center justify-between font-mono text-[10px] text-slate-400\">\n        <span>RESPONSE CURVE (PRECISION \302\267 TRANSITION \302\267 ACCEL)</span>\n        <span className=\"text-cyan-300\">f(e)=e^p/(1+e^p)</span>\n      </div>\n      <svg\n        viewBox=\"0 0 240 64\"\n        className=\"h-14 w-full\"\n        aria-label=\"Progressive mouse steering response curve\"\n      >\n        {/* 1.0x reference line */}\n        <line\n          x1=\"8\"\n          y1={refOneY.toFixed(1)}\n          x2=\"232\"\n          y2={refOneY.toFixed(1)}\n          stroke=\"rgba(148,163,184,0.22)\"\n          strokeDasharray=\"3 3\"\n          strokeWidth=\"1\"\n        />\n        {/* Boundary B marker */}\n        <line\n          x1={boundaryXPos.toFixed(1)}\n          y1=\"6\"\n          x2={boundaryXPos.toFixed(1)}\n          y2=\"58\"\n          stroke=\"rgba(251,191,36,0.55)\"\n          strokeDasharray=\"2 2\"\n          strokeWidth=\"1\"\n        />\n        <path d={pathD} fill=\"none\" stroke=\"#38bdf8\" strokeWidth=\"2\" />\n      </svg>\n    </div>\n  );\n}\n\nexport function SettingsPanel({\n  settings,\n  onUpdateSettings,\n  onClose,\n  closeLabel = \'Back\',\n}: SettingsPanelProps) {\n  return (\n    <div className=\"max-h-[90vh] w-full max-w-3xl overflow-y-auto border border-slate-700/80 bg-[#050c1d]/96 p-6 sm:p-7\">\n      <div className=\"flex items-center justify-between border-b border-slate-800 pb-4\">\n        <div>\n          <h2 className=\"font-display text-2xl font-semibold tracking-wide text-slate-100\">\n            Flight, Graphics & Audio Settings\n          </h2>\n          <p className=\"mt-0.5 text-xs text-slate-400\">\n            All graphics and progressive steering parameters apply immediately and persist locally.\n          </p>\n        </div>\n        <button\n          type=\"button\"\n          onClick={() => {\n            AudioManager.playUiClick(\'secondary\');\n            onUpdateSettings({ ...DEFAULT_SETTINGS });\n          }}\n          className=\"border border-slate-700 px-3 py-1.5 text-xs font-medium text-slate-300 transition-colors hover:border-cyan-400/60 hover:text-cyan-200 whitespace-nowrap shrink-0\"\n        >\n          Reset Defaults\n        </button>\n      </div>\n\n      <div className=\"mt-5 grid grid-cols-1 gap-6 md:grid-cols-2\">\n        {/* Left Column: Progressive Mouse Steering, Camera & Audio */}\n        <div className=\"space-y-3.5\">\n          <h3 className=\"font-mono text-[11px] tracking-widest text-cyan-300\">\n            PROGRESSIVE MOUSE STEERING\n          </h3>\n\n          <SteeringCurvePreview settings={settings} />\n\n          <div>\n            <div className=\"flex items-center justify-between text-xs\">\n              <label htmlFor=\"setting-mouse-sens\" className=\"font-medium text-slate-200\">\n                Base Sensitivity\n              </label>\n              <span className=\"font-mono tabular-nums text-cyan-300\">\n                {settings.mouseSensitivity.toFixed(2)}x\n              </span>\n            </div>\n            <input\n              id=\"setting-mouse-sens\"\n              type=\"range\"\n              min={0.3}\n              max={2.5}\n              step={0.05}\n              value={settings.mouseSensitivity}\n              onChange={(e) => onUpdateSettings({ mouseSensitivity: parseFloat(e.target.value) })}\n              className=\"starfall-slider mt-1 w-full\"\n            />\n          </div>\n\n          <div>\n            <div className=\"flex items-center justify-between text-xs\">\n              <label htmlFor=\"setting-boundary-sens\" className=\"font-medium text-slate-200\">\n                Boundary Sensitivity\n              </label>\n              <span className=\"font-mono tabular-nums text-cyan-300\">\n                {settings.boundarySensitivity.toFixed(2)}x\n              </span>\n            </div>\n            <input\n              id=\"setting-boundary-sens\"\n              type=\"range\"\n              min={0.15}\n              max={1.0}\n              step={0.05}\n              value={settings.boundarySensitivity}\n              onChange={(e) =>\n                onUpdateSettings({ boundarySensitivity: parseFloat(e.target.value) })\n              }\n              className=\"starfall-slider mt-1 w-full\"\n            />\n          </div>\n\n          <div>\n            <div className=\"flex items-center justify-between text-xs\">\n              <label htmlFor=\"setting-max-sens\" className=\"font-medium text-slate-200\">\n                Maximum Sensitivity\n              </label>\n              <span className=\"font-mono tabular-nums text-cyan-300\">\n                {settings.maxSensitivity.toFixed(2)}x\n              </span>\n            </div>\n            <input\n              id=\"setting-max-sens\"\n              type=\"range\"\n              min={1.2}\n              max={3.5}\n              step={0.1}\n              value={settings.maxSensitivity}\n              onChange={(e) => onUpdateSettings({ maxSensitivity: parseFloat(e.target.value) })}\n              className=\"starfall-slider mt-1 w-full\"\n            />\n          </div>\n\n          <div>\n            <div className=\"flex items-center justify-between text-xs\">\n              <label htmlFor=\"setting-accel-dist\" className=\"font-medium text-slate-200\">\n                Acceleration Distance\n              </label>\n              <span className=\"font-mono tabular-nums text-cyan-300\">\n                {Math.round(settings.accelerationDistance)} px\n              </span>\n            </div>\n            <input\n              id=\"setting-accel-dist\"\n              type=\"range\"\n              min={80}\n              max={500}\n              step={10}\n              value={settings.accelerationDistance}\n              onChange={(e) =>\n                onUpdateSettings({ accelerationDistance: parseFloat(e.target.value) })\n              }\n              className=\"starfall-slider mt-1 w-full\"\n            />\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-3\">\n            <div>\n              <div className=\"flex items-center justify-between text-xs\">\n                <label htmlFor=\"setting-response-curve\" className=\"font-medium text-slate-200\">\n                  Response Curve\n                </label>\n                <span className=\"font-mono tabular-nums text-cyan-300\">\n                  p={settings.responseCurve.toFixed(1)}\n                </span>\n              </div>\n              <input\n                id=\"setting-response-curve\"\n                type=\"range\"\n                min={1.0}\n                max={3.5}\n                step={0.1}\n                value={settings.responseCurve}\n                onChange={(e) => onUpdateSettings({ responseCurve: parseFloat(e.target.value) })}\n                className=\"starfall-slider mt-1 w-full\"\n              />\n            </div>\n\n            <div>\n              <div className=\"flex items-center justify-between text-xs\">\n                <label htmlFor=\"setting-aim-boundary\" className=\"font-medium text-slate-200\">\n                  Aim Boundary\n                </label>\n                <span className=\"font-mono tabular-nums text-cyan-300\">\n                  {Math.round(settings.aimBoundaryWidth * 100)}% \303\227 {Math.round(settings.aimBoundaryHeight * 100)}%\n                </span>\n              </div>\n              <input\n                id=\"setting-aim-boundary\"\n                type=\"range\"\n                min={STEERING_BOUNDS.aimBoundaryWidth.min}\n                max={STEERING_BOUNDS.aimBoundaryWidth.max}\n                step={0.01}\n                value={settings.aimBoundaryWidth}\n                onChange={(e) => {\n                  const w = parseFloat(e.target.value);\n                  const h = Math.min(\n                    STEERING_BOUNDS.aimBoundaryHeight.max,\n                    Math.max(\n                      STEERING_BOUNDS.aimBoundaryHeight.min,\n                      Number(\n                        (\n                          w *\n                          (STEERING_CONFIG.aimBoundaryHeight / STEERING_CONFIG.aimBoundaryWidth)\n                        ).toFixed(2),\n                      ),\n                    ),\n                  );\n                  onUpdateSettings({ aimBoundaryWidth: w, aimBoundaryHeight: h });\n                }}\n                className=\"starfall-slider mt-1 w-full\"\n              />\n            </div>\n          </div>\n\n          <h3 className=\"pt-1 font-mono text-[11px] tracking-widest text-cyan-300\">\n            CAMERA & AUDIO\n          </h3>\n\n          <div className=\"grid grid-cols-2 gap-3\">\n            <div>\n              <div className=\"flex items-center justify-between text-xs\">\n                <label htmlFor=\"setting-cam-dist\" className=\"font-medium text-slate-200\">\n                  Camera Distance\n                </label>\n                <span className=\"font-mono tabular-nums text-cyan-300\">\n                  {settings.cameraDistance.toFixed(1)} m\n                </span>\n              </div>\n              <input\n                id=\"setting-cam-dist\"\n                type=\"range\"\n                min={7.2}\n                max={13.5}\n                step={0.2}\n                value={settings.cameraDistance}\n                onChange={(e) => onUpdateSettings({ cameraDistance: parseFloat(e.target.value) })}\n                className=\"starfall-slider mt-1 w-full\"\n              />\n            </div>\n\n            <div>\n              <div className=\"flex items-center justify-between text-xs\">\n                <label htmlFor=\"setting-cam-sens\" className=\"font-medium text-slate-200\">\n                  Camera Follow\n                </label>\n                <span className=\"font-mono tabular-nums text-cyan-300\">\n                  {settings.cameraSensitivity.toFixed(2)}x\n                </span>\n              </div>\n              <input\n                id=\"setting-cam-sens\"\n                type=\"range\"\n                min={0.6}\n                max={1.6}\n                step={0.05}\n                value={settings.cameraSensitivity}\n                onChange={(e) =>\n                  onUpdateSettings({ cameraSensitivity: parseFloat(e.target.value) })\n                }\n                className=\"starfall-slider mt-1 w-full\"\n              />\n            </div>\n          </div>\n\n          <div>\n            <div className=\"flex items-center justify-between text-xs\">\n              <label htmlFor=\"setting-volume\" className=\"font-medium text-slate-200\">\n                Master Volume\n              </label>\n              <div className=\"flex items-center gap-2.5\">\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    AudioManager.unlock();\n                    AudioManager.playUiClick(\'primary\');\n                  }}\n                  className=\"flex items-center gap-1 text-[11px] text-cyan-300 hover:text-cyan-200\"\n                >\n                  <Volume2 className=\"h-3 w-3\" />\n                  <span>Test</span>\n                </button>\n                <span className=\"font-mono tabular-nums text-cyan-300\">\n                  {Math.round(settings.masterVolume * 100)}%\n                </span>\n              </div>\n            </div>\n            <input\n              id=\"setting-volume\"\n              type=\"range\"\n              min={0}\n              max={1}\n              step={0.05}\n              value={settings.masterVolume}\n              onChange={(e) => {\n                const v = parseFloat(e.target.value);\n                onUpdateSettings({ masterVolume: v });\n                AudioManager.setMasterVolume(v);\n              }}\n              className=\"starfall-slider mt-1 w-full\"\n            />\n          </div>\n\n          <label className=\"flex cursor-pointer items-center justify-between border border-slate-800 bg-[#081226] px-3 py-2 text-xs text-slate-200\">\n            <span>Invert Pitch (Y-Axis)</span>\n            <input\n              type=\"checkbox\"\n              checked={settings.invertY}\n              onChange={(e) => {\n                AudioManager.playUiClick(\'secondary\');\n                onUpdateSettings({ invertY: e.target.checked });\n              }}\n              className=\"h-4 w-4 accent-cyan-400\"\n            />\n          </label>\n\n          {/* Development-only performance monitor toggle (completely omitted in production) */}\n          {import.meta.env.DEV && (\n            <label className=\"flex cursor-pointer items-center justify-between border border-cyan-500/30 bg-[#08142b] px-3 py-2 text-xs text-cyan-200\">\n              <span>Dev Performance Monitor (F3)</span>\n              <input\n                type=\"checkbox\"\n                checked={settings.showPerfOverlay}\n                onChange={(e) => {\n                  AudioManager.playUiClick(\'secondary\');\n                  onUpdateSettings({ showPerfOverlay: e.target.checked });\n                }}\n                className=\"h-4 w-4 accent-cyan-400\"\n              />\n            </label>\n          )}\n        </div>\n\n        {/* Right Column: Adaptive Graphics Presets & Granular Controls */}\n        <div className=\"space-y-4\">\n          <h3 className=\"font-mono text-[11px] tracking-widest text-cyan-300\">\n            GRAPHICS & PERFORMANCE\n          </h3>\n\n          {/* Overall Quality Preset */}\n          <div>\n            <span className=\"text-xs font-medium text-slate-200\">Quality Preset</span>\n            <div className=\"mt-1.5 grid grid-cols-4 border border-slate-700 bg-[#081226] p-1\">\n              {QUALITY_OPTIONS.map((opt) => {\n                const active = settings.graphicsQuality === opt.value;\n                return (\n                  <button\n                    key={opt.value}\n                    type=\"button\"\n                    onClick={() => {\n                      AudioManager.playUiClick(\'secondary\');\n                      onUpdateSettings(getGraphicsPresetPatch(opt.value));\n                    }}\n                    className={`py-1.5 text-xs font-medium transition-colors ${\n                      active ? \'bg-cyan-500 text-slate-950\' : \'text-slate-300 hover:text-cyan-200\'\n                    }`}\n                  >\n                    {opt.label}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Resolution Scale */}\n          <div>\n            <div className=\"flex items-center justify-between text-xs\">\n              <label htmlFor=\"setting-res-scale\" className=\"font-medium text-slate-200\">\n                Resolution Scale\n              </label>\n              <span className=\"font-mono tabular-nums text-cyan-300\">\n                {Math.round(settings.resolutionScale * 100)}%\n              </span>\n            </div>\n            <input\n              id=\"setting-res-scale\"\n              type=\"range\"\n              min={0.65}\n              max={1.0}\n              step={0.05}\n              value={settings.resolutionScale}\n              onChange={(e) => onUpdateSettings({ resolutionScale: parseFloat(e.target.value) })}\n              className=\"starfall-slider mt-1.5 w-full\"\n            />\n          </div>\n\n          {/* Shadow Quality */}\n          <div className=\"flex items-center justify-between gap-2\">\n            <span className=\"text-xs font-medium text-slate-200\">Shadows</span>\n            <div className=\"flex border border-slate-700 bg-[#081226] p-0.5\">\n              {SHADOW_OPTIONS.map((opt) => (\n                <button\n                  key={opt.value}\n                  type=\"button\"\n                  onClick={() => {\n                    AudioManager.playUiClick(\'secondary\');\n                    onUpdateSettings({ shadowQuality: opt.value });\n                  }}\n                  className={`px-2.5 py-1 text-[11px] font-medium transition-colors ${\n                    settings.shadowQuality === opt.value\n                      ? \'bg-cyan-500 text-slate-950\'\n                      : \'text-slate-300 hover:text-cyan-200\'\n                  }`}\n                >\n                  {opt.label}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Particle / Effect Quality */}\n          <div className=\"flex items-center justify-between gap-2\">\n            <span className=\"text-xs font-medium text-slate-200\">Particle & VFX</span>\n            <div className=\"flex border border-slate-700 bg-[#081226] p-0.5\">\n              {EFFECT_OPTIONS.map((opt) => (\n                <button\n                  key={opt.value}\n                  type=\"button\"\n                  onClick={() => {\n                    AudioManager.playUiClick(\'secondary\');\n                    onUpdateSettings({ particleQuality: opt.value });\n                  }}\n                  className={`px-2.5 py-1 text-[11px] font-medium transition-colors ${\n                    settings.particleQuality === opt.value\n                      ? \'bg-cyan-500 text-slate-950\'\n                      : \'text-slate-300 hover:text-cyan-200\'\n                  }`}\n                >\n                  {opt.label}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Environment Detail */}\n          <div className=\"flex items-center justify-between gap-2\">\n            <span className=\"text-xs font-medium text-slate-200\">Environment Detail</span>\n            <div className=\"flex border border-slate-700 bg-[#081226] p-0.5\">\n              {EFFECT_OPTIONS.map((opt) => (\n                <button\n                  key={opt.value}\n                  type=\"button\"\n                  onClick={() => {\n                    AudioManager.playUiClick(\'secondary\');\n                    onUpdateSettings({ environmentDetail: opt.value });\n                  }}\n                  className={`px-2.5 py-1 text-[11px] font-medium transition-colors ${\n                    settings.environmentDetail === opt.value\n                      ? \'bg-cyan-500 text-slate-950\'\n                      : \'text-slate-300 hover:text-cyan-200\'\n                  }`}\n                >\n                  {opt.label}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Draw Distance */}\n          <div>\n            <div className=\"flex items-center justify-between text-xs\">\n              <label htmlFor=\"setting-draw-dist\" className=\"font-medium text-slate-200\">\n                Draw Distance\n              </label>\n              <span className=\"font-mono tabular-nums text-cyan-300\">\n                {Math.round(settings.drawDistance)} m\n              </span>\n            </div>\n            <input\n              id=\"setting-draw-dist\"\n              type=\"range\"\n              min={2000}\n              max={5200}\n              step={200}\n              value={settings.drawDistance}\n              onChange={(e) => onUpdateSettings({ drawDistance: parseFloat(e.target.value) })}\n              className=\"starfall-slider mt-1.5 w-full\"\n            />\n          </div>\n\n          {/* Anti-Aliasing & Glow Toggles */}\n          <div className=\"grid grid-cols-2 gap-2\">\n            <label className=\"flex cursor-pointer items-center justify-between border border-slate-800 bg-[#081226] px-2.5 py-2 text-[11px] text-slate-200\">\n              <span>Anti-Aliasing</span>\n              <input\n                type=\"checkbox\"\n                checked={settings.antialias}\n                onChange={(e) => {\n                  AudioManager.playUiClick(\'secondary\');\n                  onUpdateSettings({ antialias: e.target.checked });\n                }}\n                className=\"h-3.5 w-3.5 accent-cyan-400\"\n              />\n            </label>\n            <label className=\"flex cursor-pointer items-center justify-between border border-slate-800 bg-[#081226] px-2.5 py-2 text-[11px] text-slate-200\">\n              <span>Atmosphere Glow</span>\n              <input\n                type=\"checkbox\"\n                checked={settings.postGlowEnabled}\n                onChange={(e) => {\n                  AudioManager.playUiClick(\'secondary\');\n                  onUpdateSettings({ postGlowEnabled: e.target.checked });\n                }}\n                className=\"h-3.5 w-3.5 accent-cyan-400\"\n              />\n            </label>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"mt-6 flex justify-end border-t border-slate-800 pt-4\">\n        <button\n          type=\"button\"\n          onClick={() => {\n            AudioManager.playUiClick(\'primary\');\n            onClose();\n          }}\n          className=\"bg-cyan-500 px-6 py-2.5 text-sm font-semibold text-slate-950 transition-colors hover:bg-cyan-400 focus-visible:outline-2 focus-visible:outline-cyan-300 whitespace-nowrap shrink-0\"\n        >\n          {closeLabel}\n        </button>\n      </div>\n    </div>\n  );\n}\n"
    num_lines: 621
    num_bytes: 23521
    line_range_bytes: 23521
  }
}
