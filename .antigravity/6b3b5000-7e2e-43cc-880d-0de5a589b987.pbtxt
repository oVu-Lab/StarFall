            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // 2. Accumulate unconstrained relative mouse displacement (zero hard input cutoff)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const baseSens = THREE.MathUtils.clamp("
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
