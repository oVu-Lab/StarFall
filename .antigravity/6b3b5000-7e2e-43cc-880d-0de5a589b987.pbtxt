      command {
        instruction: "Update evaluateProgressiveAxisSensitivity in src/engine/AimBoundary.ts so precision zone strictly returns precisionSensitivity with zero coupling to beyond-boundary acceleration"
        is_edit: true
        file {
          absolute_uri: "file:///src/engine/AimBoundary.ts"
