    description: "NODE_PATH=/usr/local/share/bun-global/node_modules node -e \'\nconst { chromium } = require(\"playwright\");\n\n(async () => {\n  const browser = await chromium.launch({\n    headless: true,\n    args: [\"--use-gl=angle\", \"--use-angle=swiftshader\", \"--enable-webgl\", \"--ignore-gpu-blocklist\"]\n  });\n  const context = await browser.newContext({ viewport: { width: 1280, height: 720 } });\n  const page = await context.newPage();\n\n  const errors = [];\n  page.on(\"pageerror\", (e) => errors.push(\"PAGEERROR: \" + e.message));\n  page.on(\"console\", (msg) => {\n    if (msg.type() === \"error\") errors.push(\"CONSOLE_ERROR: \" + msg.text());\n  });\n\n  await page.goto(\"http://localhost:3000/\", { waitUntil: \"networkidle\" });\n  await page.waitForTimeout(1000);\n\n  // Clear localStorage to verify clean v5 default loading\n  await page.evaluate(() => localStorage.clear());\n  await page.reload({ waitUntil: \"networkidle\" });\n  await page.waitForTimeout(1000);\n\n  // 1. Open Settings and verify calibrated defaults & capture screenshot\n  const settingsBtn = page.getByRole(\"button\", { name: /settings/i });\n  await settingsBtn.click();\n  await page.waitForTimeout(500);\n\n  const defaultSettings = await page.evaluate(() => window.__STARFALL_DIAG__.getSettings());\n  console.log(\"=== INITIAL DEFAULT SETTINGS ===\");\n  console.log(JSON.stringify({\n    aimBoundaryWidth: defaultSettings.aimBoundaryWidth,\n    aimBoundaryHeight: defaultSettings.aimBoundaryHeight,\n    aimBoundaryCornerRadius: defaultSettings.aimBoundaryCornerRadius,\n    precisionSensitivity: defaultSettings.precisionSensitivity,\n    boundarySensitivity: defaultSettings.boundarySensitivity,\n    maxSensitivity: defaultSettings.maxSensitivity,\n    accelerationDistance: defaultSettings.accelerationDistance,\n    responseCurve: defaultSettings.responseCurve,\n    angularSmoothing: defaultSettings.angularSmoothing,\n    recoverySmoothing: defaultSettings.recoverySmoothing,\n  }, null, 2));\n\n  await page.screenshot({ path: \"/tmp/starfall_calib_settings.png\" });\n\n  // Close settings -> Launch Mission 01\n  await page.getByRole(\"button\", { name: /back/i }).click();\n  await page.waitForTimeout(300);\n  await page.getByRole(\"button\", { name: /play|campaign|launch|missions/i }).first().click();\n  await page.waitForTimeout(500);\n  // Click launch mission button\n  const launchBtn = page.getByRole(\"button\", { name: /launch/i }).first();\n  if (await launchBtn.isVisible()) {\n    await launchBtn.click();\n  }\n\n  // Wait until phase === \"playing\"\n  await page.waitForFunction(() => window.__STARFALL_DIAG__?.getPhase() === \"playing\", { timeout: 15000 });\n  await page.waitForTimeout(600);\n\n  // Mock pointerLockElement to the canvas so headless Chromium processes MouseEvent movementX/Y through real InputManager\n  const lockSetup = await page.evaluate(() => {\n    const canvas = document.querySelector(\"canvas\");\n    Object.defineProperty(document, \"pointerLockElement\", {\n      configurable: true,\n      get: () => canvas,\n    });\n    document.dispatchEvent(new Event(\"pointerlockchange\"));\n    return {\n      canvasW: canvas ? canvas.clientWidth : 0,\n      canvasH: canvas ? canvas.clientHeight : 0,\n      locked: window.__STARFALL_DIAG__.getInput().isPointerLocked(),\n    };\n  });\n  console.log(\"=== POINTER LOCK VERIFICATION ===\");\n  console.log(JSON.stringify(lockSetup));\n\n  // Helper: reset aim + velocity, apply real mousemove displacement, step real rAF frames, measure steady-state angular velocity\n  const measureDisplacement = async (dx, dy, settleMs = 450) => {\n    await page.evaluate(() => {\n      const f = window.__STARFALL_DIAG__.getFlight();\n      const s = window.__STARFALL_DIAG__.getSettings();\n      f.centerAimCursor(s.precisionSensitivity);\n      f.yawVelocity = 0;\n      f.pitchVelocity = 0;\n      f.rollVelocity = 0;\n    });\n    // Dispatch real MouseEvents in realistic increments (<= 40px per event)\n    await page.evaluate(({ dx, dy }) => {\n      const steps = Math.max(1, Math.ceil(Math.max(Math.abs(dx), Math.abs(dy)) / 40));\n      const sx = dx / steps;\n      const sy = dy / steps;\n      for (let i = 0; i < steps; i++) {\n        const ev = new MouseEvent(\"mousemove\", { bubbles: true, cancelable: true });\n        Object.defineProperty(ev, \"movementX\", { value: sx });\n        Object.defineProperty(ev, \"movementY\", { value: sy });\n        window.dispatchEvent(ev);\n      }\n    }, { dx, dy });\n\n    await page.waitForTimeout(settleMs);\n\n    return await page.evaluate(() => {\n      const f = window.__STARFALL_DIAG__.getFlight();\n      const t = window.__STARFALL_DIAG__.getTelemetry();\n      const RAD2DEG = 180 / Math.PI;\n      return {\n        virtualX: Number(f.virtualAimX.toFixed(1)),\n        virtualY: Number(f.virtualAimY.toFixed(1)),\n        clampedX: Number(f.aimClamp.clampedX.toFixed(1)),\n        clampedY: Number(f.aimClamp.clampedY.toFixed(1)),\n        excessX: Number(f.aimClamp.excessX.toFixed(1)),\n        excessY: Number(f.aimClamp.excessY.toFixed(1)),\n        inside: f.aimClamp.inside,\n        zone: t.steeringZone,\n        sensX: Number(t.steeringSensitivityX.toFixed(3)),\n        sensY: Number(t.steeringSensitivityY.toFixed(3)),\n        yawRadS: Number(f.yawVelocity.toFixed(3)),\n        yawDegS: Number((Math.abs(f.yawVelocity) * RAD2DEG).toFixed(2)),\n        pitchRadS: Number(f.pitchVelocity.toFixed(3)),\n        pitchDegS: Number((Math.abs(f.pitchVelocity) * RAD2DEG).toFixed(2)),\n        screenX: Number(t.aimScreenX.toFixed(4)),\n        screenY: Number(t.aimScreenY.toFixed(4)),\n        boundW: Number(t.aimBoundaryWidthPx.toFixed(1)),\n        boundH: Number(t.aimBoundaryHeightPx.toFixed(1)),\n      };\n    });\n  };\n\n  console.log(\"\\n=== TEST A: HORIZONTAL DISPLACEMENT SWEEP (1280x720, halfW = 256px) ===\");\n  for (const dx of [15, 30, 50, 80, 128, 180, 220, 250, 256, 286, 350, 496, 736, 1200])