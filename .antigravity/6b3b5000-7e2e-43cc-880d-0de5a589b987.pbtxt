            name: "run_command"
            arguments_json: "{\"CommandLine\":\"NODE_PATH=/usr/local/share/bun-global/node_modules node -e \'\\nconst { chromium } = require(\\\"playwright\\\");\\n\\n(async () => {\\n  const browser = await chromium.launch({\\n    headless: true,\\n    args: [\\\"--use-gl=angle\\\", \\\"--use-angle=swiftshader\\\", \\\"--enable-webgl\\\", \\\"--ignore-gpu-blocklist\\\"]\\n  });\\n  const context = await browser.newContext({ viewport: { width: 1280, height: 720 } });\\n  const page = await context.newPage();\\n\\n  const errors = [];\\n  page.on(\\\"pageerror\\\", (e) => errors.push(\\\"PAGEERROR: \\\" + e.message));\\n  page.on(\\\"console\\\", (msg) => {\\n    if (msg.type() === \\\"error\\\") errors.push(\\\"CONSOLE_ERROR: \\\" + msg.text());\\n  });\\n\\n  await page.goto(\\\"http://localhost:3000/\\\", { waitUntil: \\\"networkidle\\\" });\\n  await page.evaluate(() => localStorage.clear());\\n  await page.reload({ waitUntil: \\\"networkidle\\\" });\\n  await page.waitForTimeout(600);\\n\\n  // 1. Verify SettingsPanel sliders, labels, values, and viewport fit\\n  await page.getByRole(\\\"button\\\", { name: /settings/i }).click();\\n  await page.waitForTimeout(300);\\n\\n  const settingsAudit = await page.evaluate(() => {\\n    const ids = [\\n      \\\"setting-precision-sens\\\",\\n      \\\"setting-boundary-sens\\\",\\n      \\\"setting-max-sens\\\",\\n      \\\"setting-accel-dist\\\",\\n      \\\"setting-response-curve\\\",\\n      \\\"setting-aim-boundary\\\",\\n      \\\"setting-angular-smooth\\\",\\n      \\\"setting-reticle-recovery\\\",\\n    ];\\n    const controls = ids.map((id) => {\\n      const el = document.getElementById(id);\\n      return {\\n        id,\\n        exists: Boolean(el),\\n        value: el ? el.value : null,\\n        min: el ? el.min : null,\\n        max: el ? el.max : null,\\n      };\\n    });\\n    const panel = document.querySelector(\\\".max-h-\\\\\\\\[90vh\\\\\\\\]\\\");\\n    const rect = panel ? panel.getBoundingClientRect() : null;\\n    return {\\n      controls,\\n      panelFitsHorizontally: rect ? rect.left >= 0 && rect.right <= 1280 : false,\\n      panelHeight: rect ? Math.round(rect.height) : 0,\\n      scrollHeight: panel ? panel.scrollHeight : 0,\\n    };\\n  });\\n  console.log(\\\"=== SETTINGS UI AUDIT ===\\\");\\n  console.log(JSON.stringify(settingsAudit, null, 2));\\n\\n  // Verify live slider update persists to settings & localStorage v5\\n  await page.locator(\\\"#setting-precision-sens\\\").fill(\\\"0.45\\\");\\n  await page.locator(\\\"#setting-precision-sens\\\").dispatchEvent(\\\"input\\\");\\n  await page.waitForTimeout(150);\\n  await page.getByRole(\\\"button\\\", { name: /reset defaults/i }).click();\\n  await page.waitForTimeout(150);\\n  const afterReset = await page.evaluate(() => {\\n    const raw = localStorage.getItem(\\\"starfall.settings.v5\\\");\\n    return { v5Stored: Boolean(raw), precisionSensitivity: window.__STARFALL_DIAG__.getSettings().precisionSensitivity };\\n  });\\n  console.log(\\\"=== RESET & PERSISTENCE CHECK ===\\\");\\n  console.log(JSON.stringify(afterReset));\\n\\n  // 2. Launch Mission 01 and test realistic continuous swipe + return to center + live combat firing\\n  await page.getByRole(\\\"button\\\", { name: /return to menu/i }).click();\\n  await page.waitForTimeout(200);\\n  await page.getByRole(\\\"button\\\", { name: /campaign missions/i }).click();\\n  await page.waitForTimeout(250);\\n  await page.getByRole(\\\"button\\\", { name: /launch/i }).first().click();\\n  await page.waitForFunction(() => window.__STARFALL_DIAG__?.getPhase() === \\\"playing\\\", { timeout: 15000 });\\n  await page.waitForTimeout(400);\\n\\n  await page.evaluate(() => {\\n    const canvas = document.querySelector(\\\"canvas\\\");\\n    Object.defineProperty(document, \\\"pointerLockElement\\\", { configurable: true, get: () => canvas });\\n    document.dispatchEvent(new Event(\\\"pointerlockchange\\\"));\\n  });\\n\\n  const swipeTest = await page.evaluate(() => {\\n    const f = window.__STARFALL_DIAG__.getFlight();\\n    const inp = window.__STARFALL_DIAG__.getInput();\\n    const t = window.__STARFALL_DIAG__.getTelemetry();\\n    const s = { ...window.__STARFALL_DIAG__.getSettings() };\\n    const dt = 1 / 60;\\n    const RAD2DEG = 180 / Math.PI;\\n\\n    // Continuous smooth swipe from 0 -> 540px over 0.6s (15px/frame for 36 frames), then hold 0.2s, then swipe back -480px over 0.4s\\n    f.reset(undefined, s.precisionSensitivity);\\n    const trace = [];\\n    for (let frame = 1; frame <= 72; frame++) {\\n      let mx = 0;\\n      if (frame <= 36) mx = 15; // outward swipe across precision -> transition -> acceleration\\n      else if (frame <= 48) mx = 0; // sustained hard turn hold\\n      else mx = -20; // pull back inward into precision zone\\n\\n      if (mx !== 0) {\\n        const ev = new MouseEvent(\\\"mousemove\\\", { bubbles: true, cancelable: true });\\n        Object.defineProperty(ev, \\\"movementX\\\", { value: mx });\\n        Object.defineProperty(ev, \\\"movementY\\\", { value: 0 });\\n        window.dispatchEvent(ev);\\n      }\\n      f.update(dt, inp.consumeSnapshot(), s, t, 1280, 720);\\n      if (frame % 6 === 0) {\\n        trace.push({\\n          tSec: Number((frame * dt).toFixed(2)),\\n          clampedX: Number(f.aimClamp.clampedX.toFixed(1)),\\n          excessX: Number(f.aimClamp.excessX.toFixed(1)),\\n          zone: t.steeringZone,\\n          sensX: Number(t.steeringSensitivityX.toFixed(3)),\\n          yawDegS: Number((Math.abs(f.yawVelocity) * RAD2DEG).toFixed(1)),\\n        });\\n      }\\n    }\\n    return trace;\\n  });\\n\\n  console.log(\\\"\\\\n=== CONTINUOUS SWIPE OUT -> HOLD -> RETURN TRACE ===\\\");\\n  for (const row of swipeTest) {\\n    console.log(`t=${row.tSec.toFixed(2)}s | clampedX=${String(row.clampedX).padStart(5)}px | excess=${String(row.excessX).padStart(5)}px | zone=${row.zone.padEnd(12)} | sensX=${row.sensX.toFixed(3)} | yaw=${String(row.yawDegS).padStart(5)} deg/s`);\\n  }\\n\\n  console.log(\\\"\\\\n=== ERRORS ===\\\");\\n  console.log(errors.length === 0 ? \\\"ZERO ERRORS\\\" : errors.join(\\\"\\\\n\\\"));\\n\\n  await browser.close();\\n})().catch((e) => {\\n  console.error(e);\\n  process.exit(1);\\n});\\n\'\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Running Settings UI and continuous swipe verification\", \"toolSummary\":\"Verify Settings UI and swipe trace\"}"
