      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Update DEFAULT_SETTINGS and settings storage migration to v5 for calibrated steering defaults\", \"EndLine\":305, \"Instruction\":\"Update DEFAULT_SETTINGS and loadSavedSettings in src/config/ships.ts\", \"ReplacementContent\":\"export const DEFAULT_SETTINGS: GameSettings = {\\n  precisionSensitivity: STEERING_CONFIG.precisionSensitivity,\\n  boundarySensitivity: STEERING_CONFIG.boundarySensitivity,\\n  maxSensitivity: STEERING_CONFIG.maxSensitivity,\\n  accelerationDistance: STEERING_CONFIG.accelerationDistance,\\n  responseCurve: STEERING_CONFIG.responseCurveExponent,\\n  aimBoundaryWidth: STEERING_CONFIG.aimBoundaryWidth,\\n  aimBoundaryHeight: STEERING_CONFIG.aimBoundaryHeight,\\n  aimBoundaryCornerRadius: STEERING_CONFIG.aimBoundaryCornerRadius,\\n  angularSmoothing: STEERING_CONFIG.angularSmoothingSec,\\n  recoverySmoothing: STEERING_CONFIG.recoverySmoothingSec,\\n  invertY: false,\\n  cameraDistance: 9.8,\\n  cameraSensitivity: 1.0,\\n  masterVolume: 0.65,\\n  graphicsQuality: \'high\',\\n  resolutionScale: 1.0,\\n  shadowQuality: \'medium\',\\n  particleQuality: \'high\',\\n  environmentDetail: \'high\',\\n  drawDistance: 4200,\\n  antialias: true,\\n  postGlowEnabled: true,\\n  showPerfOverlay: false,\\n};\\n\\nconst SETTINGS_STORAGE_KEY = \'starfall.settings.v5\';\\nconst LEGACY_SETTINGS_KEY_V4 = \'starfall.settings.v4\';\\nconst LEGACY_SETTINGS_KEY_V3 = \'starfall.settings.v3\';\\nconst LEGACY_SETTINGS_KEY_V2 = \'starfall.settings.v2\';\\nconst LEGACY_SETTINGS_KEY_V1 = \'starfall.settings.v1\';\\n\\nfunction clampNumber(value: unknown, min: number, max: number, fallback: number): number {\\n  return typeof value === \'number\' && Number.isFinite(value)\\n    ? Math.max(min, Math.min(max, value))\\n    : fallback;\\n}\\n\\nexport function loadSavedSettings(): GameSettings {\\n  try {\\n    const rawV5 = window.localStorage.getItem(SETTINGS_STORAGE_KEY);\\n    const raw =\\n      rawV5 ??\\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY_V4) ??\\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY_V3) ??\\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY_V2) ??\\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY_V1);\\n    if (!raw) return { ...DEFAULT_SETTINGS };\\n    const parsed = JSON.parse(raw) as Partial<GameSettings>;\\n    const validQuality =\\n      parsed.graphicsQuality === \'low\' ||\\n      parsed.graphicsQuality === \'medium\' ||\\n      parsed.graphicsQuality === \'high\' ||\\n      parsed.graphicsQuality === \'ultra\'\\n        ? parsed.graphicsQuality\\n        : DEFAULT_SETTINGS.graphicsQuality;\\n\\n    // When migrating from pre-v5 storage, apply the calibrated flight steering profile\\n    // while preserving user graphics, audio, camera, and invertY preferences.\\n    const precisionSensitivity = rawV5\\n      ? clampNumber(\\n          parsed.precisionSensitivity,\\n          STEERING_BOUNDS.precisionSensitivity.min,\\n          STEERING_BOUNDS.precisionSensitivity.max,\\n          DEFAULT_SETTINGS.precisionSensitivity,\\n        )\\n      : DEFAULT_SETTINGS.precisionSensitivity;\\n\\n    const boundarySensitivity = rawV5\\n      ? clampNumber(\\n          parsed.boundarySensitivity,\\n          STEERING_BOUNDS.boundarySensitivity.min,\\n          STEERING_BOUNDS.boundarySensitivity.max,\\n          DEFAULT_SETTINGS.boundarySensitivity,\\n        )\\n      : DEFAULT_SETTINGS.boundarySensitivity;\\n\\n    const maxSensitivity = rawV5\\n      ? Math.max(\\n          boundarySensitivity + 0.1,\\n          clampNumber(\\n            parsed.maxSensitivity,\\n            STEERING_BOUNDS.maxSensitivity.min,\\n            STEERING_BOUNDS.maxSensitivity.max,\\n            DEFAULT_SETTINGS.maxSensitivity,\\n          ),\\n        )\\n      : DEFAULT_SETTINGS.maxSensitivity;\\n\\n    const accelerationDistance = rawV5\\n      ? clampNumber(\\n          parsed.accelerationDistance,\\n          STEERING_BOUNDS.accelerationDistance.min,\\n          STEERING_BOUNDS.accelerationDistance.max,\\n          DEFAULT_SETTINGS.accelerationDistance,\\n        )\\n      : DEFAULT_SETTINGS.accelerationDistance;\\n\\n    const responseCurve = rawV5\\n      ? clampNumber(\\n          parsed.responseCurve,\\n          STEERING_BOUNDS.responseCurve.min,\\n          STEERING_BOUNDS.responseCurve.max,\\n          DEFAULT_SETTINGS.responseCurve,\\n        )\\n      : DEFAULT_SETTINGS.responseCurve;\\n\\n    const aimBoundaryWidth = rawV5\\n      ? clampNumber(\\n          parsed.aimBoundaryWidth,\\n          STEERING_BOUNDS.aimBoundaryWidth.min,\\n          STEERING_BOUNDS.aimBoundaryWidth.max,\\n          DEFAULT_SETTINGS.aimBoundaryWidth,\\n        )\\n      : DEFAULT_SETTINGS.aimBoundaryWidth;\\n\\n    const aimBoundaryHeight = rawV5\\n      ? clampNumber(\\n          parsed.aimBoundaryHeight,\\n          STEERING_BOUNDS.aimBoundaryHeight.min,\\n          STEERING_BOUNDS.aimBoundaryHeight.max,\\n          DEFAULT_SETTINGS.aimBoundaryHeight,\\n        )\\n      : DEFAULT_SETTINGS.aimBoundaryHeight;\\n\\n    const aimBoundaryCornerRadius = rawV5\\n      ? clampNumber(\\n          parsed.aimBoundaryCornerRadius,\\n          STEERING_BOUNDS.aimBoundaryCornerRadius.min,\\n          STEERING_BOUNDS.aimBoundaryCornerRadius.max,\\n          DEFAULT_SETTINGS.aimBoundaryCornerRadius,\\n        )\\n      : DEFAULT_SETTINGS.aimBoundaryCornerRadius;\\n\\n    const angularSmoothing = rawV5\\n      ? clampNumber(\\n          parsed.angularSmoothing,\\n          STEERING_BOUNDS.angularSmoothing.min,\\n          STEERING_BOUNDS.angularSmoothing.max,\\n          DEFAULT_SETTINGS.angularSmoothing,\\n        )\\n      : DEFAULT_SETTINGS.angularSmoothing;\\n\\n    const recoverySmoothing = rawV5\\n      ? clampNumber(\\n          parsed.recoverySmoothing,\\n          STEERING_BOUNDS.recoverySmoothing.min,\\n          STEERING_BOUNDS.recoverySmoothing.max,\\n          DEFAULT_SETTINGS.recoverySmoothing,\\n        )\\n      : DEFAULT_SETTINGS.recoverySmoothing;\\n\\n    return {\\n      ...DEFAULT_SETTINGS,\\n      ...parsed,\\n      precisionSensitivity,\\n      boundarySensitivity,\\n      maxSensitivity,\\n      accelerationDistance,\\n      responseCurve,\\n      aimBoundaryWidth,\\n      aimBoundaryHeight,\\n      aimBoundaryCornerRadius,\\n      angularSmoothing,\\n      recoverySmoothing,\\n      graphicsQuality: validQuality,\\n      resolutionScale: clampNumber(\\n        parsed.resolutionScale,\\n        0.65,\\n        1.0,\\n        DEFAULT_SETTINGS.resolutionScale,\\n      ),\\n      drawDistance: clampNumber(parsed.drawDistance, 2000, 5200, DEFAULT_SETTINGS.drawDistance),\\n      showPerfOverlay: import.meta.env.DEV ? Boolean(parsed.showPerfOverlay) : false,\\n    };\\n  } catch {\\n    return { ...DEFAULT_SETTINGS };\\n  }\\n}\", \"StartLine\":156, \"TargetContent\":\"export const DEFAULT_SETTINGS: GameSettings = {\\n  mouseSensitivity: STEERING_CONFIG.normalSensitivity,\\n  boundarySensitivity: STEERING_CONFIG.boundarySensitivity,\\n  maxSensitivity: STEERING_CONFIG.maxSensitivity,\\n  accelerationDistance: STEERING_CONFIG.accelerationDistance,\\n  responseCurve: STEERING_CONFIG.responseCurveExponent,\\n  aimBoundaryWidth: STEERING_CONFIG.aimBoundaryWidth,\\n  aimBoundaryHeight: STEERING_CONFIG.aimBoundaryHeight,\\n  aimBoundaryCornerRadius: STEERING_CONFIG.aimBoundaryCornerRadius,\\n  recoverySmoothing: STEERING_CONFIG.recoverySmoothingSec,\\n  invertY: false,\\n  cameraDistance: 9.8,\\n  cameraSensitivity: 1.0,\\n  masterVolume: 0.65,\\n  graphicsQuality: \'high\',\\n  resolutionScale: 1.0,\\n  shadowQuality: \'medium\',\\n  particleQuality: \'high\',\\n  environmentDetail: \'high\',\\n  drawDistance: 4200,\\n  antialias: true,\\n  postGlowEnabled: true,\\n  showPerfOverlay: false,\\n};\\n\\nconst SETTINGS_STORAGE_KEY = \'starfall.settings.v4\';\\nconst LEGACY_SETTINGS_KEY_V3 = \'starfall.settings.v3\';\\nconst LEGACY_SETTINGS_KEY_V2 = \'starfall.settings.v2\';\\nconst LEGACY_SETTINGS_KEY_V1 = \'starfall.settings.v1\';\\n\\nfunction clampNumber(value: unknown, min: number, max: number, fallback: number): number {\\n  return typeof value === \'number\' && Number.isFinite(value)\\n    ? Math.max(min, Math.min(max, value))\\n    : fallback;\\n}\\n\\nexport function loadSavedSettings(): GameSettings {\\n  try {\\n    const rawV4 = window.localStorage.getItem(SETTINGS_STORAGE_KEY);\\n    const raw =\\n      rawV4 ??\\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY_V3) ??\\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY_V2) ??\\n      window.localStorage.getItem(LEGACY_SETTINGS_KEY_V1);\\n    if (!raw) return { ...DEFAULT_SETTINGS };\\n    const parsed = JSON.parse(raw) as Partial<GameSettings>;\\n    const validQuality =\\n      parsed.graphicsQuality === \'low\' ||\\n      parsed.graphicsQuality === \'medium\' ||\\n      parsed.graphicsQuality === \'high\' ||\\n      parsed.graphicsQuality === \'ultra\'\\n        ? parsed.graphicsQuality\\n        : DEFAULT_SETTINGS.graphicsQuality;\\n\\n    const boundarySensitivity = clampNumber(\\n      parsed.boundarySensitivity,\\n      STEERING_BOUNDS.boundarySensitivity.min,\\n      STEERING_BOUNDS.boundarySensitivity.max,\\n      DEFAULT_SETTINGS.boundarySensitivity,\\n    );\\n    const maxSensitivity = Math.max(\\n      boundarySensitivity + 0.2,\\n      clampNumber(\\n        parsed.maxSensitivity,\\n        STEERING_BOUNDS.maxSensitivity.min,\\n        STEERING_BOUNDS.maxSensitivity.max,\\n        DEFAULT_SETTINGS.maxSensitivity,\\n      ),\\n    );\\n\\n    // When migrating from v1/v2/v3, apply the confirmed 40% x 45% rounded-rectangle boundary defaults\\n    const aimBoundaryWidth = rawV4\\n      ? clampNumber(\\n          parsed.aimBoundaryWidth,\\n          STEERING_BOUNDS.aimBoundaryWidth.min,\\n          STEERING_BOUNDS.aimBoundaryWidth.max,\\n          DEFAULT_SETTINGS.aimBoundaryWidth,\\n        )\\n      : DEFAULT_SETTINGS.aimBoundaryWidth;\\n\\n    const aimBoundaryHeight = rawV4\\n      ? clampNumber(\\n          parsed.aimBoundaryHeight,\\n          STEERING_BOUNDS.aimBoundaryHeight.min,\\n          STEERING_BOUNDS.aimBoundaryHeight.max,\\n          DEFAULT_SETTINGS.aimBoundaryHeight,\\n        )\\n      : DEFAULT_SETTINGS.aimBoundaryHeight;\\n\\n    const aimBoundaryCornerRadius = rawV4\\n      ? clampNumber(\\n          parsed.aimBoundaryCornerRadius,\\n          STEERING_BOUNDS.aimBoundaryCornerRadius.min,\\n          STEERING_BOUNDS.aimBoundaryCornerRadius.max,\\n          DEFAULT_SETTINGS.aimBoundaryCornerRadius,\\n        )\\n      : DEFAULT_SETTINGS.aimBoundaryCornerRadius;\\n\\n    const recoverySmoothing = rawV4\\n      ? clampNumber(\\n          parsed.recoverySmoothing,\\n          STEERING_BOUNDS.recoverySmoothing.min,\\n          STEERING_BOUNDS.recoverySmoothing.max,\\n          DEFAULT_SETTINGS.recoverySmoothing,\\n        )\\n      : DEFAULT_SETTINGS.recoverySmoothing;\\n\\n    return {\\n      ...DEFAULT_SETTINGS,\\n      ...parsed,\\n      mouseSensitivity: clampNumber(\\n        parsed.mouseSensitivity,\\n        STEERING_BOUNDS.mouseSensitivity.min,\\n        STEERING_BOUNDS.mouseSensitivity.max,\\n        DEFAULT_SETTINGS.mouseSensitivity,\\n      ),\\n      boundarySensitivity,\\n      maxSensitivity,\\n      accelerationDistance: clampNumber(\\n        parsed.accelerationDistance,\\n        STEERING_BOUNDS.accelerationDistance.min,\\n        STEERING_BOUNDS.accelerationDistance.max,\\n        DEFAULT_SETTINGS.accelerationDistance,\\n      ),\\n      responseCurve: clampNumber(\\n        parsed.responseCurve,\\n        STEERING_BOUNDS.responseCurve.min,\\n        STEERING_BOUNDS.responseCurve.max,\\n        DEFAULT_SETTINGS.responseCurve,\\n      ),\\n      aimBoundaryWidth,\\n      aimBoundaryHeight,\\n      aimBoundaryCornerRadius,\\n      recoverySmoothing,\\n      graphicsQuality: validQuality,\\n      resolutionScale: clampNumber(\\n        parsed.resolutionScale,\\n        0.65,\\n        1.0,\\n        DEFAULT_SETTINGS.resolutionScale,\\n      ),\\n      drawDistance: clampNumber(parsed.drawDistance, 2000, 5200, DEFAULT_SETTINGS.drawDistance),\\n      showPerfOverlay: import.meta.env.DEV ? Boolean(parsed.showPerfOverlay) : false,\\n    };\\n  } catch {\\n    return { ...DEFAULT_SETTINGS };\\n  }\\n}\", \"TargetFile\":\"/src/config/ships.ts\", \"toolAction\":\"Updating default settings and storage migration\", \"toolSummary\":\"Update config/ships.ts\"}"
      original_name: "replace_file_content"
