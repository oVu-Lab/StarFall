    command_line: "NODE_PATH=/usr/local/share/bun-global/node_modules node -e \'\nconst { chromium } = require(\"playwright\");\n\n(async () => {\n  const browser = await chromium.launch({\n    headless: true,\n    args: [\"--use-gl=angle\", \"--use-angle=swiftshader\", \"--enable-webgl\", \"--ignore-gpu-blocklist\"]\n  });\n  const context = await browser.newContext({ viewport: { width: 1280, height: 720 } });\n  const page = await context.newPage();\n\n  const errors = [];\n  page.on(\"pageerror\", (e) => errors.push(\"PAGEERROR: \" + e.message));\n  page.on(\"console\", (msg) => {\n    if (msg.type() === \"error\") errors.push(\"CONSOLE_ERROR: \" + msg.text());\n  });\n\n  await page.goto(\"http://localhost:3000/\", { waitUntil: \"networkidle\" });\n  await page.evaluate(() => localStorage.clear());\n  await page.reload({ waitUntil: \"networkidle\" });\n  await page.waitForTimeout(800);\n\n  // 1. Open Settings and verify calibrated defaults\n  await page.getByRole(\"button\", { name: /settings/i }).click();\n  await page.waitForTimeout(400);\n  await page.screenshot({ path: \"/tmp/starfall_calib_settings.png\" });\n\n  // Return to Menu -> Campaign Missions -> Launch\n  await page.getByRole(\"button\", { name: /return to menu/i }).click();\n  await page.waitForTimeout(250);\n  await page.getByRole(\"button\", { name: /campaign missions/i }).click();\n  await page.waitForTimeout(350);\n  await page.getByRole(\"button\", { name: /launch/i }).first().click();\n\n  await page.waitForFunction(() => window.__STARFALL_DIAG__?.getPhase() === \"playing\", { timeout: 15000 });\n  await page.waitForTimeout(500);\n\n  // Engage simulated Pointer Lock on the WebGL canvas for real InputManager mousemove dispatch\n  const lockSetup = await page.evaluate(() => {\n    const canvas = document.querySelector(\"canvas\");\n    Object.defineProperty(document, \"pointerLockElement\", {\n      configurable: true,\n      get: () => canvas,\n    });\n    document.dispatchEvent(new Event(\"pointerlockchange\"));\n    return {\n      canvasW: canvas ? canvas.clientWidth : 0,\n      canvasH: canvas ? canvas.clientHeight : 0,\n      locked: window.__STARFALL_DIAG__.getInput().isPointerLocked(),\n    };\n  });\n  console.log(\"=== POINTER LOCK VERIFICATION ===\");\n  console.log(JSON.stringify(lockSetup));\n\n  // Verify live rAF mousemove -> InputManager -> FlightController -> FlightHUD pipeline\n  await page.evaluate(() => {\n    const f = window.__STARFALL_DIAG__.getFlight();\n    const s = window.__STARFALL_DIAG__.getSettings();\n    f.centerAimCursor(s.precisionSensitivity);\n    f.yawVelocity = 0;\n    f.pitchVelocity = 0;\n    const ev = new MouseEvent(\"mousemove\", { bubbles: true, cancelable: true });\n    Object.defineProperty(ev, \"movementX\", { value: 110 });\n    Object.defineProperty(ev, \"movementY\", { value: -55 });\n    window.dispatchEvent(ev);\n  });\n  await page.waitForTimeout(600);\n  const liveFrameCheck = await page.evaluate(() => {\n    const f = window.__STARFALL_DIAG__.getFlight();\n    const t = window.__STARFALL_DIAG__.getTelemetry();\n    const ret = document.querySelector(\"[data-testid=\\\"virtual-mouse-cursor\\\"]\");\n    const bnd = document.querySelector(\"[data-testid=\\\"aim-boundary-frame\\\"]\");\n    return {\n      virtualX: Number(f.virtualAimX.toFixed(1)),\n      virtualY: Number(f.virtualAimY.toFixed(1)),\n      clampedX: Number(f.aimClamp.clampedX.toFixed(1)),\n      clampedY: Number(f.aimClamp.clampedY.toFixed(1)),\n      zone: t.steeringZone,\n      sensX: Number(t.steeringSensitivityX.toFixed(3)),\n      yawDegS: Number((Math.abs(f.yawVelocity) * 180 / Math.PI).toFixed(2)),\n      pitchDegS: Number((Math.abs(f.pitchVelocity) * 180 / Math.PI).toFixed(2)),\n      hudReticleDataset: ret ? { ...ret.dataset } : null,\n      hudBoundaryDataset: bnd ? { ...bnd.dataset } : null,\n    };\n  });\n  console.log(\"\\n=== LIVE rAF MOUSE-TO-HUD PIPELINE CHECK (dx=+110px, dy=-55px) ===\");\n  console.log(JSON.stringify(liveFrameCheck, null, 2));\n  await page.screenshot({ path: \"/tmp/starfall_calib_flight.png\" });\n\n  // Deterministic 60 FPS sweep using real InputManager + FlightController inside the live browser page\n  const sweep = await page.evaluate(() => {\n    const f = window.__STARFALL_DIAG__.getFlight();\n    const inp = window.__STARFALL_DIAG__.getInput();\n    const t = window.__STARFALL_DIAG__.getTelemetry();\n    const s = { ...window.__STARFALL_DIAG__.getSettings() };\n    const RAD2DEG = 180 / Math.PI;\n\n    const runCase = (dx, dy, settingsOverride = {}, frames = 60, dt = 1 / 60) => {\n      const cfg = { ...s, ...settingsOverride };\n      f.centerAimCursor(cfg.precisionSensitivity);\n      f.yawVelocity = 0;\n      f.pitchVelocity = 0;\n      f.rollVelocity = 0;\n\n      // Feed real mousemove events in realistic 40px packets through InputManager\n      const steps = Math.max(1, Math.ceil(Math.max(Math.abs(dx), Math.abs(dy)) / 40));\n      for (let i = 0; i < steps; i++) {\n        const ev = new MouseEvent(\"mousemove\", { bubbles: true, cancelable: true });\n        Object.defineProperty(ev, \"movementX\", { value: dx / steps });\n        Object.defineProperty(ev, \"movementY\", { value: dy / steps });\n        window.dispatchEvent(ev);\n      }\n\n      for (let k = 0; k < frames; k++) {\n        const snap = inp.consumeSnapshot();\n        f.update(dt, snap, cfg, t, 1280, 720);\n      }\n\n      return {\n        dx, dy,\n        clampedX: Number(f.aimClamp.clampedX.toFixed(1)),\n        clampedY: Number(f.aimClamp.clampedY.toFixed(1)),\n        excessX: Number(f.aimClamp.excessX.toFixed(1)),\n        excessY: Number(f.aimClamp.excessY.toFixed(1)),\n        inside: f.aimClamp.inside,\n        zone: t.steeringZone,\n        sensX: Number(t.steeringSensitivityX.toFixed(3)),\n        sensY: Number(t.steeringSensitivityY.toFixed(3)),\n        yawRadS: Number(Math.abs(f.yawVelocity).toFixed(3)),\n        yawDegS: Number((Math.abs(f.yawVelocity) * RAD2DEG).toFixed(2)),\n        pitchRadS: Number(Math.abs(f.pitchVelocity).toFixed(3)),\n        pitchDegS: Number((Math.abs(f.pitchVelocity) * RAD2DEG).toFixed(2)),\n      };\n    };\n\n    const horiz = [15, 30, 50, 80, 128, 180, 220, 250, 256, 286, 350, 496, 736, 1200].map((dx) => runCase(dx, 0));\n    const vert = [15, 30, 50, 81, 120, 158, 162, 200, 402, 642].map((dy) => runCase(0, dy));\n    const corner = runCase(420, 320);\n\n    // Parameter independence checks\n    const pBase128 = runCase(128, 0);\n    const pDiffBeyond128 = runCase(128, 0, { maxSensitivity: 3.0, boundarySensitivity: 0.15, responseCurve: 3.5, accelerationDistance: 100 });\n    const pBase250 = runCase(250, 0);\n    const pDiffBeyond250 = runCase(250, 0, { maxSensitivity: 3.0, boundarySensitivity: 0.15, responseCurve: 3.5, accelerationDistance: 100 });\n    const pPrecLow128 = runCase(128, 0, { precisionSensitivity: 0.30 });\n    const pPrecHigh128 = runCase(128, 0, { precisionSensitivity: 0.80 });\n    const zBase496 = runCase(496, 0, { precisionSensitivity: 0.50 });\n    const zLowPrec496 = runCase(496, 0, { precisionSensitivity: 0.25 });\n\n    // Time constant measurements (120Hz)\n    const dt120 = 1 / 120;\n    f.centerAimCursor(s.precisionSensitivity);\n    f.yawVelocity = 0;\n    const evStep = new MouseEvent(\"mousemove\", { bubbles: true, cancelable: true });\n    Object.defineProperty(evStep, \"movementX\", { value: 128 });\n    Object.defineProperty(evStep, \"movementY\", { value: 0 });\n    window.dispatchEvent(evStep);\n    const angSamples = [];\n    for (let i = 0; i < 120; i++) {\n      f.update(dt120, inp.consumeSnapshot(), s, t, 1280, 720);\n      angSamples.push({ time: (i + 1) * dt120, yaw: Math.abs(f.yawVelocity) });\n    }\n    const steadyYaw = angSamples[angSamples.length - 1].yaw;\n    const angTau63 = angSamples.find((x) => x.yaw >= steadyYaw * 0.6321);\n\n    // Reticle recovery (Zone C overdrive 600px -> back inside precision zone 100px)\n    f.centerAimCursor(s.precisionSensitivity);\n    f.virtualAimX = 600;\n    for (let i = 0; i < 120; i++) {\n      f.update(dt120, inp.consumeSnapshot(), s, t, 1280, 720);\n    }\n    const startOverdriveSens = f.smoothedSensX;\n    f.virtualAimX = 100;\n    const recSamples = [];\n    for (let i = 0; i < 120; i++) {\n      f.update(dt120, inp.consumeSnapshot(), s, t, 1280, 720);\n      recSamples.push({ time: (i + 1) * dt120, sens: f.smoothedSensX });\n    }\n    const rec63Target = startOverdriveSens - (startOverdriveSens - s.precisionSensitivity) * 0.6321;\n    const recTau63 = recSamples.find((x) => x.sens <= rec63Target);\n\n    // Micro-correction overshoot check (+25px for 0.30s, then -25px back to center for 0.25s)\n    f.reset(undefined, s.precisionSensitivity);\n    const evMicro = new MouseEvent(\"mousemove\", { bubbles: true, cancelable: true });\n    Object.defineProperty(evMicro, \"movementX\", { value: 25 });\n    Object.defineProperty(evMicro, \"movementY\", { value: 0 });\n    window.dispatchEvent(evMicro);\n    let peakYawDegS = 0;\n    let totalTurnDeg = 0;\n    for (let i = 0; i < 18; i++) {\n      f.update(1 / 60, inp.consumeSnapshot(), s, t, 1280, 720);\n      const yd = Math.abs(f.yawVelocity) * RAD2DEG;\n      if (yd > peakYawDegS) peakYawDegS = yd;\n      totalTurnDeg += yd * (1 / 60);\n    }\n    const evBack = new MouseEvent(\"mousemove\", { bubbles: true, cancelable: true });\n    Object.defineProperty(evBack, \"movementX\", { value: -25 });\n    Object.defineProperty(evBack, \"movementY\", { value: 0 });\n    window.dispatchEvent(evBack);\n    let stopDriftDeg = 0;\n    let residualYaw = 0;\n    for (let i = 0; i < 15; i++) {\n      f.update(1 / 60, inp.consumeSnapshot(), s, t, 1280, 720);\n      const yd = Math.abs(f.yawVelocity) * RAD2DEG;\n      stopDriftDeg += yd * (1 / 60);\n      residualYaw = yd;\n    }\n\n    return {\n      horiz, vert, corner,\n      independence: {\n        prec128Unchanged: pBase128.yawDegS === pDiffBeyond128.yawDegS && pBase128.sensX === pDiffBeyond128.sensX,\n        prec250EdgeUnchanged: pBase250.yawDegS === pDiffBeyond250.yawDegS && pBase250.sensX === pDiffBeyond250.sensX,\n        reticlePosUnchangedByPrecSens: pPrecLow128.clampedX === pPrecHigh128.clampedX,\n        zoneCUnchangedByPrecSens: zBase496.sensX === zLowPrec496.sensX && zBase496.excessX === zLowPrec496.excessX,\n        pPrecLow128_yawDegS: pPrecLow128.yawDegS,\n        pPrecHigh128_yawDegS: pPrecHigh128.yawDegS,\n        zBase496_sensX: zBase496.sensX,\n        zLowPrec496_sensX: zLowPrec496.sensX,\n      },\n      timing: {\n        angularTauSec: angTau63 ? Number(angTau63.time.toFixed(4)) : null,\n        configuredAngularSec: s.angularSmoothing,\n        recoveryTauSec: recTau63 ? Number(recTau63.time.toFixed(4)) : null,\n        configuredRecoverySec: s.recoverySmoothing,\n      },\n      microCorrection: {\n        nudgePx: 25,\n        peakYawDegS: Number(peakYawDegS.toFixed(2)),\n        totalTurnDeg: Number(totalTurnDeg.toFixed(2)),\n        stopDriftDeg: Number(stopDriftDeg.toFixed(2)),\n        residualYawAfter250msDegS: Number(residualYaw.toFixed(3)),\n      }\n    };\n  });\n\n  console.log(\"\\n=== HORIZONTAL SWEEP (1280x720, halfW = 256px) ===\");\n  for (const r of sweep.horiz) {\n    console.log(`dx=${String(r.dx).padStart(4)}px | clamped=${String(r.clampedX).padStart(5)}px | excess=${String(r.excessX).padStart(5)}px | zone=${r.zone.padEnd(12)} | sensX=${r.sensX.toFixed(3)} | yaw=${String(r.yawDegS).padStart(6)} deg/s (${r.yawRadS.toFixed(3)} rad/s)`);\n  }\n\n  console.log(\"\\n=== VERTICAL SWEEP (1280x720, halfH = 162px) ===\");\n  for (const r of sweep.vert) {\n    console.log(`dy=${String(r.dy).padStart(4)}px | clamped=${String(r.clampedY).padStart(5)}px | excess=${String(r.excessY).padStart(5)}px | zone=${r.zone.padEnd(12)} | sensY=${r.sensY.toFixed(3)} | pitch=${String(r.pitchDegS).padStart(6)} deg/s (${r.pitchRadS.toFixed(3)} rad/s)`);\n  }\n\n  console.log(\"\\n=== CORNER PROJECTION ===\");\n  console.log(JSON.stringify(sweep.corner));\n\n  console.log(\"\\n=== PARAMETER INDEPENDENCE ===\");\n  console.log(JSON.stringify(sweep.independence, null, 2));\n\n  console.log(\"\\n=== TIME CONSTANTS ===\");\n  console.log(JSON.stringify(sweep.timing, null, 2));\n\n  console.log(\"\\n=== MICRO-CORRECTION TRACKING ===\");\n  console.log(JSON.stringify(sweep.microCorrection, null, 2));\n\n  console.log(\"\\n=== CONSOLE / PAGE ERRORS ===\");\n  console.log(errors.length === 0 ? \"ZERO ERRORS\" : errors.join(\"\\n\"));\n\n  await browser.close();\n})().catch((e) => {\n  console.error(e);\n  process.exit(1);\n});\n\'"
    proposed_command_line: "NODE_PATH=/usr/local/share/bun-global/node_modules node -e \'\nconst { chromium } = require(\"playwright\");\n\n(async () => {\n  const browser = await chromium.launch({\n    headless: true,\n    args: [\"--use-gl=angle\", \"--use-angle=swiftshader\", \"--enable-webgl\", \"--ignore-gpu-blocklist\"]\n  });\n  const context = await browser.newContext({ viewport: { width: 1280, height: 720 } });\n  const page = await context.newPage();\n\n  const errors = [];\n  page.on(\"pageerror\", (e) => errors.push(\"PAGEERROR: \" + e.message));\n  page.on(\"console\", (msg) => {\n    if (msg.type() === \"error\") errors.push(\"CONSOLE_ERROR: \" + msg.text());\n  });\n\n  await page.goto(\"http://localhost:3000/\", { waitUntil: \"networkidle\" });\n  await page.evaluate(() => localStorage.clear());\n  await page.reload({ waitUntil: \"networkidle\" });\n  await page.waitForTimeout(800);\n\n  // 1. Open Settings and verify calibrated defaults\n  await page.getByRole(\"button\", { name: /settings/i }).click();\n  await page.waitForTimeout(400);\n  await page.screenshot({ path: \"/tmp/starfall_calib_settings.png\" });\n\n  // Return to Menu -> Campaign Missions -> Launch\n  await page.getByRole(\"button\", { name: /return to menu/i }).click();\n  await page.waitForTimeout(250);\n  await page.getByRole(\"button\", { name: /campaign missions/i }).click();\n  await page.waitForTimeout(350);\n  await page.getByRole(\"button\", { name: /launch/i }).first().click();\n\n  await page.waitForFunction(() => window.__STARFALL_DIAG__?.getPhase() === \"playing\", { timeout: 15000 });\n  await page.waitForTimeout(500);\n\n  // Engage simulated Pointer Lock on the WebGL canvas for real InputManager mousemove dispatch\n  const lockSetup = await page.evaluate(() => {\n    const canvas = document.querySelector(\"canvas\");\n    Object.defineProperty(document, \"pointerLockElement\", {\n      configurable: true,\n      get: () => canvas,\n    });\n    document.dispatchEvent(new Event(\"pointerlockchange\"));\n    return {\n      canvasW: canvas ? canvas.clientWidth : 0,\n      canvasH: canvas ? canvas.clientHeight : 0,\n      locked: window.__STARFALL_DIAG__.getInput().isPointerLocked(),\n    };\n  });\n  console.log(\"=== POINTER LOCK VERIFICATION ===\");\n  console.log(JSON.stringify(lockSetup));\n\n  // Verify live rAF mousemove -> InputManager -> FlightController -> FlightHUD pipeline\n  await page.evaluate(() => {\n    const f = window.__STARFALL_DIAG__.getFlight();\n    const s = window.__STARFALL_DIAG__.getSettings();\n    f.centerAimCursor(s.precisionSensitivity);\n    f.yawVelocity = 0;\n    f.pitchVelocity = 0;\n    const ev = new MouseEvent(\"mousemove\", { bubbles: true, cancelable: true });\n    Object.defineProperty(ev, \"movementX\", { value: 110 });\n    Object.defineProperty(ev, \"movementY\", { value: -55 });\n    window.dispatchEvent(ev);\n  });\n  await page.waitForTimeout(600);\n  const liveFrameCheck = await page.evaluate(() => {\n    const f = window.__STARFALL_DIAG__.getFlight();\n    const t = window.__STARFALL_DIAG__.getTelemetry();\n    const ret = document.querySelector(\"[data-testid=\\\"virtual-mouse-cursor\\\"]\");\n    const bnd = document.querySelector(\"[data-testid=\\\"aim-boundary-frame\\\"]\");\n    return {\n      virtualX: Number(f.virtualAimX.toFixed(1)),\n      virtualY: Number(f.virtualAimY.toFixed(1)),\n      clampedX: Number(f.aimClamp.clampedX.toFixed(1)),\n      clampedY: Number(f.aimClamp.clampedY.toFixed(1)),\n      zone: t.steeringZone,\n      sensX: Number(t.steeringSensitivityX.toFixed(3)),\n      yawDegS: Number((Math.abs(f.yawVelocity) * 180 / Math.PI).toFixed(2)),\n      pitchDegS: Number((Math.abs(f.pitchVelocity) * 180 / Math.PI).toFixed(2)),\n      hudReticleDataset: ret ? { ...ret.dataset } : null,\n      hudBoundaryDataset: bnd ? { ...bnd.dataset } : null,\n    };\n  });\n  console.log(\"\\n=== LIVE rAF MOUSE-TO-HUD PIPELINE CHECK (dx=+110px, dy=-55px) ===\");\n  console.log(JSO