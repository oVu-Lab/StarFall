            }
            lines {
              text: "    const curveExp = THREE.MathUtils.clamp("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      settings.responseCurve,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
