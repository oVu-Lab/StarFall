        replacement_content: "export interface GameSettings {\n  /** Independent precision-zone sensitivity multiplier inside the rounded-rectangle boundary (0.15 to 1.50) */\n  precisionSensitivity: number;\n  /** Sensitivity multiplier immediately upon crossing the aiming boundary (0.10 to 1.00) */\n  boundarySensitivity: number;\n  /** Asymptotic maximum sensitivity multiplier in the acceleration zone (0.80 to 3.00) */\n  maxSensitivity: number;\n  /** Distance scale S (in virtual px) over which acceleration ramps outside the boundary (80 to 500) */\n  accelerationDistance: number;\n  /** Nonlinear response curve exponent p in f(e) = e^p / (1 + e^p) (1.0 to 3.5) */\n  responseCurve: number;\n  /** Aiming boundary full width as a fraction of game viewport width (default 0.40 = 40%) */\n  aimBoundaryWidth: number;\n  /** Aiming boundary full height as a fraction of game viewport height (default 0.45 = 45%) */\n  aimBoundaryHeight: number;\n  /** Rounded-rectangle corner radius as a fraction of min(halfW, halfH) (default 0.25) */\n  aimBoundaryCornerRadius: number;\n  /** Ship angular velocity smoothing time constant in seconds (default 0.08) */\n  angularSmoothing: number;\n  /** Smooth delta-time reticle & sensitivity recovery time constant in seconds (default 0.12) */\n  recoverySmoothing: number;\n  invertY: boolean;"
        start_line: 99
        end_line: 120
