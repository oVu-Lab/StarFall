        replacement_chunks {
          target_content: "  // Delta-time smoothed effective sensitivity multipliers per axis (recovery smoothing ~0.12s)\n  public smoothedSensX: number = STEERING_CONFIG.normalSensitivity;\n  public smoothedSensY: number = STEERING_CONFIG.normalSensitivity;\n\n  // Visual banking angle layered on the ship mesh for tactile feel\n  public visualBankAngle = 0;\n\n  // Live viewport-relative rounded-rectangle boundary & clamp state (zero per-frame allocations)\n  public readonly aimBoundary: RoundedRectBoundary = createRoundedRectBoundary();\n  public readonly aimClamp: RoundedRectClampResult = createRoundedRectClampResult();\n\n  private lastViewportWidth = 0;\n  private lastViewportHeight = 0;\n\n  private ship: ShipConfig;\n  private boostEnergy: number;\n  private boostCooldownTimer = 0;\n  private boostLockedOut = false;\n  private boostIntensity = 0;\n  private wasBoosting = false;\n  private hull: number;\n  private boostJustEngaged = false;\n\n  public constructor(ship: ShipConfig) {\n    this.ship = ship;\n    this.boostEnergy = ship.flight.maxBoostEnergy;\n    this.hull = ship.maxHull;\n  }\n\n  public setShipConfig(ship: ShipConfig): void {\n    this.ship = ship;\n    this.boostEnergy = Math.min(this.boostEnergy, ship.flight.maxBoostEnergy);\n    this.hull = ship.maxHull;\n  }\n\n  public centerAimCursor(): void {\n    this.virtualAimX = 0;\n    this.virtualAimY = 0;\n    this.aimCursorX = 0;\n    this.aimCursorY = 0;\n    this.smoothedSensX = STEERING_CONFIG.normalSensitivity;\n    this.smoothedSensY = STEERING_CONFIG.normalSensitivity;\n    clampToRoundedRect(0, 0, this.aimBoundary, this.aimClamp);\n  }\n\n  public reset(startPosition?: THREE.Vector3): void {\n    if (startPosition) {\n      this.position.copy(startPosition);\n    } else {\n      this.position.set(0, 12, 40);\n    }\n    this.quaternion.identity();\n    this.velocity.set(0, 0, -28);\n    this.yawVelocity = 0;\n    this.pitchVelocity = 0;\n    this.rollVelocity = 0;\n    this.virtualAimX = 0;\n    this.virtualAimY = 0;\n    this.aimCursorX = 0;\n    this.aimCursorY = 0;\n    this.smoothedSensX = STEERING_CONFIG.normalSensitivity;\n    this.smoothedSensY = STEERING_CONFIG.normalSensitivity;\n    clampToRoundedRect(0, 0, this.aimBoundary, this.aimClamp);"
          replacement_content: "  // Delta-time smoothed effective sensitivity multipliers per axis (reticle recovery ~0.12s)\n  public smoothedSensX: number = STEERING_CONFIG.precisionSensitivity;\n  public smoothedSensY: number = STEERING_CONFIG.precisionSensitivity;\n\n  // Visual banking angle layered on the ship mesh for tactile feel\n  public visualBankAngle = 0;\n\n  // Live viewport-relative rounded-rectangle boundary & clamp state (zero per-frame allocations)\n  public readonly aimBoundary: RoundedRectBoundary = createRoundedRectBoundary();\n  public readonly aimClamp: RoundedRectClampResult = createRoundedRectClampResult();\n\n  private lastViewportWidth = 0;\n  private lastViewportHeight = 0;\n\n  private ship: ShipConfig;\n  private boostEnergy: number;\n  private boostCooldownTimer = 0;\n  private boostLockedOut = false;\n  private boostIntensity = 0;\n  private wasBoosting = false;\n  private hull: number;\n  private boostJustEngaged = false;\n\n  public constructor(ship: ShipConfig) {\n    this.ship = ship;\n    this.boostEnergy = ship.flight.maxBoostEnergy;\n    this.hull = ship.maxHull;\n  }\n\n  public setShipConfig(ship: ShipConfig): void {\n    this.ship = ship;\n    this.boostEnergy = Math.min(this.boostEnergy, ship.flight.maxBoostEnergy);\n    this.hull = ship.maxHull;\n  }\n\n  public centerAimCursor(precisionSensitivity: number = STEERING_CONFIG.precisionSensitivity): void {\n    const pSens = THREE.MathUtils.clamp(\n      precisionSensitivity,\n      STEERING_BOUNDS.precisionSensitivity.min,\n      STEERING_BOUNDS.precisionSensitivity.max,\n    );\n    this.virtualAimX = 0;\n    this.virtualAimY = 0;\n    this.aimCursorX = 0;\n    this.aimCursorY = 0;\n    this.smoothedSensX = pSens;\n    this.smoothedSensY = pSens;\n    clampToRoundedRect(0, 0, this.aimBoundary, this.aimClamp);\n  }\n\n  public reset(\n    startPosition?: THREE.Vector3,\n    precisionSensitivity: number = STEERING_CONFIG.precisionSensitivity,\n  ): void {\n    const pSens = THREE.MathUtils.clamp(\n      precisionSensitivity,\n      STEERING_BOUNDS.precisionSensitivity.min,\n      STEERING_BOUNDS.precisionSensitivity.max,\n    );\n    if (startPosition) {\n      this.position.copy(startPosition);\n    } else {\n      this.position.set(0, 12, 40);\n    }\n    this.quaternion.identity();\n    this.velocity.set(0, 0, -28);\n    this.yawVelocity = 0;\n    this.pitchVelocity = 0;\n    this.rollVelocity = 0;\n    this.virtualAimX = 0;\n    this.virtualAimY = 0;\n    this.aimCursorX = 0;\n    this.aimCursorY = 0;\n    this.smoothedSensX = pSens;\n    this.smoothedSensY = pSens;\n    clampToRoundedRect(0, 0, this.aimBoundary, this.aimClamp);"
          start_line: 234
