xcess=   30px | zone=transition   | sensX=0.323 | yaw= 38.89 deg/s (0.679 rad/s)dx= 350px | clamped=  256px | excess=   94px | zone=transition   | sensX=0.500 | yaw=  60.1 deg/s (1.049 rad/s)dx= 496px | clamped=  256px | excess=  240px | zone=acceleration | sensX=1.050 | yaw=126.29 deg/s (2.204 rad/s)dx= 736px | clamped=  256px | excess=  480px | zone=acceleration | sensX=1.500 | yaw= 180.4 deg/s (3.149 rad/s)dx=1200px | clamped=  256px | excess=  944px | zone=acceleration | sensX=1.709 | yaw=205.52 deg/s (3.587 rad/s)=== VERTICAL SWEEP (1280x720, halfH = 162px) ===dy=  15px | clamped=   15px | excess=    0px | zone=precision    | sensY=0.500 | pitch=  1.82 deg/s (0.032 rad/s)dy=  30px | clamped=   30px | excess=    0px | zone=precision    | sensY=0.500 | pitch=  5.65 deg/s (0.099 rad/s)dy=  50px | clamped=   50px | excess=    0px | zone=precision    | sensY=0.500 | pitch= 11.75 deg/s (0.205 rad/s)dy=  81px | clamped=   81px | excess=    0px | zone=precision    | sensY=0.500 | pitch= 22.58 deg/s (0.394 rad/s)dy= 120px | clamped=  120px | excess=    0px | zone=precision    | sensY=0.500 | pitch= 37.87 deg/s (0.661 rad/s)dy= 158px | clamped=  158px | excess=    0px | zone=precision    | sensY=0.500 | pitch= 54.09 deg/s (0.944 rad/s)dy= 162px | clamped=  162px | excess=    0px | zone=precision    | sensY=0.500 | pitch= 55.86 deg/s (0.975 rad/s)dy= 200px | clamped=  162px | excess=   38px | zone=transition   | sensY=0.337 | pitch= 37.63 deg/s (0.657 rad/s)dy= 402px | clamped=  162px | excess=  240px | zone=acceleration | sensY=1.050 | pitch=117.27 deg/s (2.047 rad/s)dy= 642px | clamped=  162px | excess=  480px | zone=acceleration | sensY=1.500 | pitch=167.52 deg/s (2.924 rad/s)=== CORNER PROJECTION ==={\"dx\":420,\"dy\":320,\"clampedX\":244.6,\"clampedY\":149.7,\"excessX\":175.4,\"excessY\":170.3,\"inside\":false,\"zone\":\"acceleration\",\"sensX\":0.822,\"sensY\":0.802,\"yawRadS\":1.628,\"yawDegS\":93.26,\"pitchRadS\":1.413,\"pitchDegS\":80.94}=== PARAMETER INDEPENDENCE ==={  \"prec128Unchanged\": true,  \"prec250EdgeUnchanged\": true,  \"reticlePosUnchangedByPrecSens\": true,  \"zoneCUnchangedByPrecSens\": true,  \"pPrecLow128_yawDegS\": 14.59,  \"pPrecHigh128_yawDegS\": 38.91,  \"zBase496_sensX\": 1.05,  \"zLowPrec496_sensX\": 1.05}=== TIME CONSTANTS ==={  \"angularTauSec\": 0.0833,  \"configuredAngularSec\": 0.08,  \"recoveryTauSec\": 0.125,  \"configuredRecoverySec\": 0.12}=== MICRO-CORRECTION TRACKING ==={  \"nudgePx\": 25,  \"peakYawDegS\": 2.11,  \"totalTurnDeg\": 0.5,  \"stopDriftDeg\": 0.14,  \"residualYawAfter250msDegS\": 0.093}=== CONSOLE / PAGE ERRORS ===ZERO ERRORS"
