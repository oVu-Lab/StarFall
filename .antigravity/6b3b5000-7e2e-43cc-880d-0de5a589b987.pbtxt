    replacement_infos {
      original_chunk {
        target_content: "/**\n * Pure per-axis progressive steering sensitivity evaluation.\n *\n * Inside the boundary (excessPx == 0):\n *   - Core precision region [0 .. boundaryBlendStart * axisBoundary]: flat normalSensitivity (1.0x).\n *   - Boundary approach [boundaryBlendStart * axisBoundary .. axisBoundary]: C1 smoothstep easing\n *     down to boundarySensitivity (0.35x) so there is zero sensitivity jump when crossing the edge.\n *\n * Beyond the boundary (excessPx > 0):\n *   e = excessPx / accelDistance\n *   f(e) = e^p / (1 + e^p)\n *   sensitivity(e) = boundarySensitivity + (maxSensitivity - boundarySensitivity) * f(e)\n *   - Zone B (transition): sensitivity < normalSensitivity (slower initial boundary crossing)\n *   - Zone C (acceleration): sensitivity >= normalSensitivity (progressive turn acceleration)\n */\nexport function evaluateProgressiveAxisSensitivity(\n  absCoordPx: number,\n  axisBoundaryPx: number,\n  excessPx: number,\n  accelDistancePx: number,\n  normalSensitivity: number,\n  boundarySensitivity: number,\n  maxSensitivity: number,\n  exponent: number,\n  out: AxisSteeringEvaluation = {\n    targetSensitivity: 1,\n    excess: 0,\n    curveFactor: 0,\n    zone: \'precision\',\n  },\n): AxisSteeringEvaluation {\n  const B = Math.max(10, axisBoundaryPx);\n  const S = Math.max(20, accelDistancePx);\n  const nSens = THREE.MathUtils.clamp(normalSensitivity, 0.5, 2.0);\n  const bSens = THREE.MathUtils.clamp(boundarySensitivity, 0.1, nSens);\n  const mSens = Math.max(nSens, maxSensitivity);\n  const p = THREE.MathUtils.clamp(exponent, 0.5, 5.0);\n\n  if (excessPx <= 1e-4) {\n    const blendStart = B * STEERING_CONFIG.boundaryBlendStart;\n    if (absCoordPx <= blendStart) {\n      out.targetSensitivity = nSens;\n    } else {\n      const t = THREE.MathUtils.clamp((absCoordPx - blendStart) / Math.max(1, B - blendStart), 0, 1);\n      const smooth = t * t * (3 - 2 * t);\n      out.targetSensitivity = nSens + (bSens - nSens) * smooth;\n    }\n    out.excess = 0;\n    out.curveFactor = 0;\n    out.zone = \'precision\';\n    return out;\n  }\n\n  const e = excessPx / S;\n  const ep = Math.pow(e, p);\n  const f = ep / (1 + ep);\n  const targetSens = bSens + (mSens - bSens) * f;\n\n  out.targetSensitivity = targetSens;\n  out.excess = e;\n  out.curveFactor = f;\n  out.zone = targetSens < nSens ? \'transition\' : \'acceleration\';\n  return out;\n}"
        replacement_content: "/**\n * Pure per-axis progressive steering sensitivity evaluation with strict parameter independence.\n *\n * Inside the rounded-rectangle boundary (excessPx == 0):\n *   - Zone A (precision): strictly equal to `precisionSensitivity` (0.50x default).\n *   - Beyond-boundary parameters (`boundarySensitivity`, `maxSensitivity`, `accelDistancePx`,\n *     `exponent`) NEVER affect precision-zone sensitivity.\n *\n * Beyond the boundary (excessPx > 0):\n *   e = excessPx / accelDistancePx\n *   f(e) = e^p / (1 + e^p)\n *   sensitivity(e) = boundarySensitivity + (maxSensitivity - boundarySensitivity) * f(e)\n *   - Zone B (transition): initial boundary crossing cushion (sensitivity < precisionSensitivity)\n *   - Zone C (acceleration): progressive overdrive turn acceleration up to maxSensitivity\n */\nexport function evaluateProgressiveAxisSensitivity(\n  _absCoordPx: number,\n  _axisBoundaryPx: number,\n  excessPx: number,\n  accelDistancePx: number,\n  precisionSensitivity: number,\n  boundarySensitivity: number,\n  maxSensitivity: number,\n  exponent: number,\n  out: AxisSteeringEvaluation = {\n    targetSensitivity: STEERING_CONFIG.precisionSensitivity,\n    excess: 0,\n    curveFactor: 0,\n    zone: \'precision\',\n  },\n): AxisSteeringEvaluation {\n  const S = Math.max(20, accelDistancePx);\n  const pSens = THREE.MathUtils.clamp(\n    precisionSensitivity,\n    STEERING_BOUNDS.precisionSensitivity.min,\n    STEERING_BOUNDS.precisionSensitivity.max,\n  );\n  const bSens = THREE.MathUtils.clamp(\n    boundarySensitivity,\n    STEERING_BOUNDS.boundarySensitivity.min,\n    STEERING_BOUNDS.boundarySensitivity.max,\n  );\n  const mSens = Math.max(\n    bSens + 0.1,\n    THREE.MathUtils.clamp(\n      maxSensitivity,\n      STEERING_BOUNDS.maxSensitivity.min,\n      STEERING_BOUNDS.maxSensitivity.max,\n    ),\n  );\n  const p = THREE.MathUtils.clamp(\n    exponent,\n    STEERING_BOUNDS.responseCurve.min,\n    STEERING_BOUNDS.responseCurve.max,\n  );\n\n  if (excessPx <= 1e-4) {\n    out.targetSensitivity = pSens;\n    out.excess = 0;\n    out.curveFactor = 0;\n    out.zone = \'precision\';\n    return out;\n  }\n\n  const e = excessPx / S;\n  const ep = Math.pow(e, p);\n  const f = ep / (1 + ep);\n  const targetSens = bSens + (mSens - bSens) * f;\n\n  out.targetSensitivity = targetSens;\n  out.excess = e;\n  out.curveFactor = f;\n  out.zone = targetSens < pSens ? \'transition\' : \'acceleration\';\n  return out;\n}"
