  view_file {
    absolute_path_uri: "file:///src/engine/threeCompat.js"
    end_line: 59
    content: "export * from \'three-real\';\nimport { Timer } from \'three-real\';\n\n/**\n * Drop-in THREE.Clock replacement backed by THREE.Timer (Three.js r183+).\n * Used via Vite alias so @react-three/fiber\'s internal `new THREE.Clock()` runs on\n * THREE.Timer instead of instantiating the deprecated THREE.Clock module.\n */\nexport class Clock {\n  constructor(autoStart = true) {\n    this.autoStart = autoStart;\n    this.startTime = 0;\n    this.oldTime = 0;\n    this.elapsedTime = 0;\n    this.running = false;\n    this._timer = new Timer();\n  }\n\n  start() {\n    this._timer.reset();\n    if (typeof document !== \'undefined\') {\n      this._timer.connect(document);\n    }\n    const now = performance.now();\n    this.startTime = now;\n    this.oldTime = now;\n    this.elapsedTime = 0;\n    this.running = true;\n  }\n\n  stop() {\n    this.getElapsedTime();\n    this._timer.disconnect();\n    this.running = false;\n    this.autoStart = false;\n  }\n\n  getElapsedTime() {\n    this.getDelta();\n    return this.elapsedTime;\n  }\n\n  getDelta() {\n    if (this.autoStart && !this.running) {\n      this.start();\n      return 0;\n    }\n\n    if (this.running) {\n      this._timer.update();\n      const diff = this._timer.getDelta();\n      this.oldTime = performance.now();\n      this.elapsedTime += diff;\n      return diff;\n    }\n\n    return 0;\n  }\n}\n"
    num_lines: 60
    num_bytes: 1309
    line_range_bytes: 1309
  }
}
